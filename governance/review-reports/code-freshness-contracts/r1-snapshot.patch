+PURE_STDLIB_ALLOWLIST = frozenset({
+    "abc", "collections", "dataclasses", "datetime", "decimal", "enum", "fractions", "functools",
+    "hashlib", "itertools", "json", "math", "re", "string", "types", "typing", "unicodedata",
