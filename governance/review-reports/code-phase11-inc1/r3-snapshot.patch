+    assert expected in output
+
+
+@pytest.mark.parametrize("addition", [
+    'addopts = "-p no:randomly"',
+    'addopts = "-p pytester"',  # pytest 內建外掛,版本由 requirements-dev 釘住
+    'addopts = "--junitprefix=ci"',  # 合法設定;驗證器自己把前綴清掉,不能誤判沒收集到
+])
+def test_a_plugin_named_no_colon_is_allowed(repo, addition):
