+        monkeypatch.setenv("PYTHONUSERBASE", str(base))
+        monkeypatch.setattr(sys, "executable", str(python))
+
+    code, output = verify(repo)
+
+    assert code == 1 and NODE_PAUSE in output  # 外掛若被載入,失敗會被改成通過
