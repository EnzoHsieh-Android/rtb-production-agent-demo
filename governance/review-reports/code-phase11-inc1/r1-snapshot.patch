+    assert _touches(_imported_modules(VERIFIER, strings=True), "rtb") == []
+    assert _touches(_imported_modules(Path(__file__)), "rtb") == []
+    assert "lumos" not in VERIFIER.read_text(encoding="utf-8")
+    for path in sorted((ROOT / "src" / "rtb").rglob("*.py")):
