+    assert len(history) == before.seq + 1
+    assert history[-1].proposal.risk_summary == "B"  # 寫進去的是接手者的結果
+    check.close()
+    assert len(decide_a.calls) + len(decide_b.calls) == 2  # 照實:接手的情況錢花了兩次
