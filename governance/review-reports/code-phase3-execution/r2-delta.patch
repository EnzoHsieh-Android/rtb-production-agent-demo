diff --git a/tests/test_migration_failure_closes_the_connection.py b/tests/test_migration_failure_closes_the_connection.py
new file mode 100644
index 0000000..376446e
--- /dev/null
+++ b/tests/test_migration_failure_closes_the_connection.py
@@ -0,0 +1,44 @@
+"""三支「連線後補欄位」的資料庫模組:補欄位失敗時都要關掉剛開的連線,寫法一致。
+
+收件口每個請求都會新開一個收件表物件,補欄位失敗(例如等鎖逾時)若不關連線,
+每個失敗的請求就漏一條連線;另外兩支是長活物件,但同一件事用同一種寫法。
+"""
+
+import sqlite3
+
+import pytest
+
+from rtb.analyzer import task_store
+from rtb.dsp import store as dsp_store
+from rtb.executor import inbox_store
+
+CASES = [
+    (dsp_store, "CampaignStore", "_migrate_columns"),
+    (task_store, "TaskStore", "_migrate_evidence_payload_column"),
+    (inbox_store, "InboxStore", "_migrate_columns"),
+]
+
+
+@pytest.mark.parametrize(("module", "cls", "migrate"), CASES, ids=[c[1] for c in CASES])
+def test_a_failed_column_migration_closes_the_new_connection(tmp_path, monkeypatch,
+                                                              module, cls, migrate):
+    opened = []
+    real_connect = module.connect
+
+    def recording_connect(*args, **kwargs):
+        conn = real_connect(*args, **kwargs)
+        opened.append(conn)
+        return conn
+
+    def fail(_self):
+        raise RuntimeError("補欄位失敗")
+
+    monkeypatch.setattr(module, "connect", recording_connect)
+    monkeypatch.setattr(getattr(module, cls), migrate, fail)
+
+    with pytest.raises(RuntimeError):
+        getattr(module, cls)(tmp_path / "x.db")
+
+    assert len(opened) == 1  # 前置:真的開過一條連線
+    with pytest.raises(sqlite3.ProgrammingError):  # 已關閉的連線不能再用
+        opened[0].execute("SELECT 1")
