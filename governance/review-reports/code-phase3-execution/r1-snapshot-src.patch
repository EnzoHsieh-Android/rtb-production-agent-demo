+        if view.version > written:  # 之後有人又改了:只證明我們的寫入套用過一次
+            return self.dsp.operation_version(row.key) == written
+        return False
+
+    def _verification_timeout(self, row: AttemptRow) -> None:
+        try:
+            with self.store.transaction() as tx:
