+# ---- 處理一筆 ----
+class Result(StrEnum):
+    IDLE = "idle"  # 沒有可處理的提案
+    DEFERRED = "deferred"  # 這一輪什麼都沒寫,提案留在待處理(或已被取代)
+    EXPIRED = "expired"
+    BLOCKED = "blocked"
+    HANDED_OFF_TO_EXISTING = "handed_off_to_existing"  # 鍵已存在,由既有那筆嘗試負責
+    EXECUTED = "executed"  # 開了一筆嘗試並送出
+
