+    target: AttemptState
+    code: OutcomeCode | None = None
+    halt: bool = False  # 記完之後這一輪以系統錯誤結束
+    capability_expired: bool = False  # DSP 明確沒寫:記成結果不明後重跑檢查、重簽重送
