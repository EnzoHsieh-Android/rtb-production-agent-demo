+    first = h.submit()
+    h.dsp.answers.append(WriteAnswer(403, "capability_scope_mismatch"))
+    h.process()
+    key = key_of(first)
+    with h.store.transaction() as tx:
+        seq = attempt_store.latest(tx, key).seq
+        attempt_store.resolve(tx, key, seq, A.FAILED, "operator decided", h.clock())
