+            return EXIT_HALTED
+        try:
+            result = executor.process_one()
+        except (ExecutorHalted, InboxBusy) as halted:  # 出事就停,讓人注意到;重啟時會做恢復
+            sys.stderr.write(f"停機:{halted}\n")
