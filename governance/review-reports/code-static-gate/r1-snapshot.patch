+
+ROOT = Path(__file__).resolve().parents[1]
+ANALYZERS = {"ruff", "mypy", "pyright", "bandit", "pylint", "flake8", "pytype", "pyre"}
+CI_FILE = ROOT / ".github" / "workflows" / "ci.yml"
+
+
+def configured_analyzers() -> set[str]:
+    pyproject = tomllib.loads((ROOT / "pyproject.toml").read_text(encoding="utf-8"))
+    return ANALYZERS & set(pyproject.get("tool", {}))
+
+
+def ci_run_commands() -> list[str]:
+    """只取 CI 裡真正會執行的指令(run: 那一行),不看步驟名稱或註解,免得字面上出現就算數。"""
+    lines = CI_FILE.read_text(encoding="utf-8").splitlines()
+    return [
+        line.split("run:", 1)[1].strip()
+        for line in lines
+        if line.strip().startswith(("run:", "- run:"))
+    ]
+
+
+def lint_commands() -> str:
+    declared = json.loads((ROOT / ".lumos" / "lint.json").read_text(encoding="utf-8"))
+    return "\n".join(command for commands in declared.values() for command in commands)
+
+
+def test_the_expected_analyzers_are_actually_configured():
+    assert {"ruff", "mypy"} <= configured_analyzers()  # 守衛的守衛:設定沒了,這條檢查就沒意義
+
+
+def test_every_configured_analyzer_is_executed_by_the_ci_workflow():
+    commands = ci_run_commands()
+
+    for tool in configured_analyzers():
+        executed = any(f"-m {tool}" in command for command in commands)
+        assert executed, f"{tool} 有設定,但 CI 沒有執行它"
+
+
+def test_every_configured_analyzer_is_also_wired_into_lumos_before_push():
+    commands = lint_commands()
+
+    for tool in configured_analyzers():
+        wired = tool in commands or f"{tool}_sarif" in commands
+        assert wired, f"{tool} 沒有接進 lumos 的 lint 宣告"
+
+
+def test_the_ci_workflow_runs_on_every_push_and_actually_runs_the_test_suite():
+    triggers = [line.strip() for line in CI_FILE.read_text(encoding="utf-8").splitlines()]
+
+    assert "push:" in triggers
+    assert any("-m pytest" in command for command in ci_run_commands())
+
+
+def test_the_lumos_lint_declaration_still_contains_a_command_writing_sarif():
+    declared = json.loads((ROOT / ".lumos" / "lint.json").read_text(encoding="utf-8"))
+
+    assert declared["py"] and all("{LINT_SARIF_OUT}" in command for command in declared["py"])
