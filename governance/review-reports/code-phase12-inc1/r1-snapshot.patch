+    text: str
+    node: str | None = None
+    edge: tuple[str, str] | None = None
+
+
+def _at(node: str, text: str) -> Place:
+    return Place(text, node=node)
+
+
+def _on(source: str, target: str, text: str) -> Place:
+    return Place(text, edge=(source, target))
