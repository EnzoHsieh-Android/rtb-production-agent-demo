+    order, leftovers, pids = [], [], []
+
+    def make(code):
+        def run(world):
+            leftovers.extend(p for p in pids if _alive(p))
+            order.append(code)
+            process = world.start(Role.INBOX, ["--db", str(world.dir / "inbox.db")])
+            pids.append(process.pid)
+            return f"{code} ok"
