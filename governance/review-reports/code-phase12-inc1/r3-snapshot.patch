+    for server in (dsp, inbox):
+        threading.Thread(target=server.serve_forever, args=(0.02,), daemon=True).start()
+    try:
+        yield (f"http://127.0.0.1:{dsp.server_address[1]}",
+               f"http://127.0.0.1:{inbox.server_address[1]}")
