+                           revenue=5.0)
+    dsp_store.seed_campaign("c2", budget=100)
+    dsp_store.seed_metrics("c2", "1h", impressions=500, clicks=12, conversions=1, spend=100.0,
+                           revenue=5.0)
+    dsp_store.close()
+    dsp = DspServer(tmp_path / "dsp.db", fault_injection=False, hang_seconds=0.2,
+                    delay_seconds=0.0)
