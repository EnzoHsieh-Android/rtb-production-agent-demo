+    assert flow.OUTCOMES[(TaskState, "HANDED_OFF")].edge == ("i_check", "x_pending")
+    assert flow.OUTCOMES[(LifecycleKind, "HANDED_OFF")].node == "x_done"
+    from rtb.executor.inbox_store import Disposition
