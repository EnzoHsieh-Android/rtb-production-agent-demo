+        raise ScenarioFailed(f"兩個分析工作者同時搶:進入付費呼叫 {paid} 次、寫了 {rows} 列")
+    world.start_executor(FaultRequest(Role.EXECUTOR, crash_point="after_receiving"))
+    world.start_analyzer()
