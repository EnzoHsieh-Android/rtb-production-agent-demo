+def _approve_when_asked(tmp_path, demo, stop):
+    """扮伺服器:讀展示狀態裡的確認請求,在伺服器行程內簽發並寫進 F7 的執行端暫存資料庫。"""
+    from rtb.capabilitykit import APPROVAL_KEY_ENV
