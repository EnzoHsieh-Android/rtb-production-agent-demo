+
+def _history_after_first_step(db: Path, *, advance: bool = True) -> int:
+    """(先推一步:收到工作 → 蒐集資料,這一步不呼叫任何介面、不花錢)回這件工作寫了幾列。"""
+    store = TaskStore(db)
+    try:
+        if advance:
+            flow.advance(store, "t1", _no_evidence, _no_decision, _no_submit, _now())
