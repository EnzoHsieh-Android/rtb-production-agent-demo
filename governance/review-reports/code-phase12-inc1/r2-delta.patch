+        began = time.monotonic()
+        runner.run(argv, max_rounds=1, out=io.StringIO(), err=io.StringIO())  # 送件
+        elapsed = time.monotonic() - began
+    finally:
+        listener.close()
+    assert elapsed < 3, elapsed
