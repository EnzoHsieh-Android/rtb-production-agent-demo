+        for tenant in ("a", "b"):  # 算進每一個租戶:改預算以新預算全額,暫停 0
+            assert used(store, NOW, tenant) == 150 + 70
+        assert used(store, NOW + AGGREGATE_WINDOW + timedelta(seconds=1), "a") == 150  # 已驗證出窗
+        assert unresolved.key != pause.key != verified.key
+    finally:
