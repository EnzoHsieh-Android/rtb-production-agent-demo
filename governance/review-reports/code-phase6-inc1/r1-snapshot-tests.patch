+# ---- [S330] ----
+def test_a_budget_increase_reserves_its_amount_with_the_first_attempt(h):
+    limit(h, 1000)
+    prop = h.submit()  # 100 -> 150
+
+    assert h.process().kind is Result.EXECUTED
+    assert first_row(h, prop) == [(TENANT, 50)]
+    assert stops(h) == []
