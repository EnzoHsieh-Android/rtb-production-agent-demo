+    加總在程式裡用整數累加:門檻與金額都可以到整數上限,資料庫的整數加總會溢位。"""
+    conn = _conn(tx)
+    rows = conn.execute(
+        "SELECT f.tenant, f.reserved_amount, f.action, f.proposal_json FROM attempts v "
+        "JOIN attempts f ON f.key = v.key AND f.seq = 1 "
+        "WHERE v.state = ? AND v.written_at > ?",
