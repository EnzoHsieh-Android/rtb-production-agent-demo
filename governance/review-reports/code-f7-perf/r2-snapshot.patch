+# ---- 代碼審第 1 輪 s1:退回路徑握鎖內的工作量不超過原算法 ----
+def _vm_steps(conn, function):
+    """函式執行期間 SQLite 虛擬機跑了幾步(每 100 步記一次):握鎖內工作量的確定性量法。"""
+    steps = [0]
+
+    def tick():
+        steps[0] += 1
+        return 0
+
+    conn.set_progress_handler(tick, 100)
+    try:
+        value = function()
+    finally:
+        conn.set_progress_handler(None, 100)
+    return value, steps[0]
+
