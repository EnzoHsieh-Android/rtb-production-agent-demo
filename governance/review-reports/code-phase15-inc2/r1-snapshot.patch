+         "clause_count"),
+        (_s([*RAISE_BAND_2, {"condition": "raise_pct", "threshold": "raise_pct:band_3"}]),
+         "duplicate_condition"),
+        (_s(direction="up"), "unknown_direction"), (_s(direction=None), "unknown_direction"),
+        (_s(note="字" * 81), rc.BAD_NOTE), (_s(note="😀" * 61), rc.BAD_NOTE),
