+        {"clauses": [{"condition": c, "threshold": t} for c, t in r.key],
+         "direction": r.direction, "support": r.support, "counterexample": r.counter,
+         "confidence_note": "照表抄"} for r in top]}, ensure_ascii=False, separators=(",", ":"))
