+    payload: MappingProxyType[str, PayloadValue]
+    """讀到的原始欄位(例如現況的 budget/status、指標的 impressions/spend),決策要用實際數字
+    判斷時讀這裡;`content_hash` 只用來判斷「有沒有變」,不是給決策讀的。"""
 
     def __post_init__(self) -> None:
