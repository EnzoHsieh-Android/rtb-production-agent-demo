+# ---- 鎖:同一時間只准一個錄製或判定寫批次清單(代碼審 r1 正確性 5、資安 F2) ----
+def _lock_owner(path: Path) -> tuple[int | None, str]:
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+        return int(data["pid"]), f"pid {int(data['pid'])}、{data['what']}、{data['since']}"
+    except (OSError, ValueError, KeyError, TypeError):
+        return None, "讀不懂"
+
+
+@contextmanager
+def _locked(root: Path, what: str) -> Iterator[None]:
+    """在入庫目錄建排他鎖檔(O_CREAT|O_EXCL),包住「讀清單 → 檢查 → 記呼叫中 → 送出 → 記結果」或整個
+    判定;已有鎖就拒絕。正常結束或例外都放掉自己的鎖;行程被硬殺留下的鎖用 --abandon 明確清。"""
+    root.mkdir(parents=True, exist_ok=True)
+    path = root / r.LOCK_NAME
+    token = json.dumps({"pid": os.getpid(), "what": what, "since": _now()}, ensure_ascii=False)
+    try:
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
+    except FileExistsError as busy:
+        raise Refused(f"另一個錄製或判定正在進行(鎖檔 {path}:{_lock_owner(path)[1]});"
+                      "確定沒有行程在跑,用 --abandon 清掉並記錄") from busy
+    with os.fdopen(fd, "w", encoding="utf-8") as handle:
+        handle.write(token)
+    try:
+        yield
+    finally:
+        with suppress(OSError):
+            if path.read_text(encoding="utf-8") == token:
+                path.unlink()
+
+
+def _alive(pid: int) -> bool:
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    return True
+
+
+def _abandon(args: argparse.Namespace, io: _Io) -> int:
+    """明確處理中斷留下的東西,並記錄:鎖檔的主人已不在就清掉;帶 --demo-id 時把那次停在「呼叫中」的
+    嘗試判成呼叫失敗(記原因與時間)。鎖的主人還活著就拒絕。"""
+    path = io.root / r.LOCK_NAME
+    notes = []
+    if path.exists():
+        pid, owner = _lock_owner(path)
+        if pid is not None and _alive(pid):
+            raise Refused(f"鎖檔的主人還在執行({owner}):不清")
+        path.unlink()
+        notes.append(f"清掉殘留鎖檔({owner})")
+    if args.demo_id is not None:
+        with _locked(io.root, f"abandon {args.demo_id}"):
+            manifest = _load(io.root)
+            attempt = next((a for a in (manifest.attempts if manifest else ())
+                            if a.demo_id == args.demo_id), None)
+            if manifest is None or attempt is None or attempt.status != r.CALLING:
+                raise Refused(f"批次清單裡 {args.demo_id} 不是「呼叫中」:沒有要判成呼叫失敗的")
+            try:
+                files = r.file_hashes(Path(attempt.staging_dir))
+            except r.Unhashable:
+                files = ()
+            reason = f"中斷:{_now()} 以 --abandon 判成呼叫失敗" + (
+                f"({notes[0]})" if notes else "")
+            _save(io.root, _with(manifest, replace(
+                attempt, finished_at=_now(), status=r.FAILED, files=files,
+                problems=(*attempt.problems, reason))))
+            notes.append(f"{args.demo_id} 判成呼叫失敗;同種子下一次用 "
+                         f"{r.demo_id_of(attempt.seed, attempt.sequence + 1)}")
+    print("\n".join(notes or ["沒有要處理的鎖檔或嘗試"]), file=io.out)
+    return EXIT_OK
