+    assert f"| {SEED} | 窮舉前 n | 2 |" in comparison
+    assert f"| {SEED} | AI | 2 | 2/2/0 |" in comparison
+    section = text[text.index("## AI 清單與窮舉前 K 的重疊"):text.index("## 逐條")]
