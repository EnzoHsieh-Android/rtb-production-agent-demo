+        raise Refused(f"種子 {seed} 已有入庫錄製:每種子只准第一次成功錄製入庫,換批要換評估版本")
+    pending = [a.demo_id for a in r.attempts_of(manifest, seed) if a.status == r.PENDING]
+    if pending:
+        raise Refused(f"種子 {seed} 有成功但還沒驗收的錄製 {pending}:先用 --check-in 驗收入庫")
+    wanted = r.next_sequence(manifest, seed)
+    if sequence != wanted:
+        raise Refused(f"種子 {seed} 下一次要用序號 {wanted}({r.demo_id_of(seed, wanted)});"
+                      "序號逐次加一、不重用")
+    return manifest
+
+
+def _gate_ready(config: rmm.GateConfig, io: _Io) -> None:
+    """閘道預檢:判成即時、登入預檢過了才准記嘗試;否則拒絕,沒有送出、沒有用掉序號。"""
+    try:
+        check = (rmm.check_gate(config, notify=io.notify) if io.opener is None
+                 else rmm.check_gate(config, notify=io.notify, open_gate=io.opener))
+    except ValueError as refused:  # 閘道拒絕、不認得的模型
+        raise Refused(f"閘道拒絕:{refused}") from refused
+    for notice in check.notices:
+        io.notify(notice)
+    if check.mode != "live" or check.login_problem is not None:
+        why = check.mode if check.login_problem is None else check.login_problem
+        raise Refused(f"閘道預檢沒過({why}):沒有送出,也沒有用掉序號")
+
+
+def _record(args: argparse.Namespace, io: _Io) -> int:
+    """即時錄製一個種子:預檢全過才記嘗試、送出一次、記結果。"""
+    seed, sequence = _attempt_for(args.demo_id)
+    if args.batch_id is None or r.batch_seed(args.batch_id) != seed:
+        raise Refused(f"即時錄製要帶這個種子的批次編號 {r.BATCH_SHAPE}:{args.batch_id!r}")
+    if not r.live_recording_requested(io.environ):
+        raise Refused("即時錄製要使用者在環境明確設 RTB_MODEL_LIVE=1 與 RTB_MODEL_RECORD=1;"
+                      "缺錄製不會自動改走即時")
+    folder = _fresh(args.recordings_dir)
+    manifest = _manifest_for(seed, sequence, io.root)
+    prepared = prepare(seed)
+    gate = p.gate_problem(prepared.prompt_bytes)
+    if gate is not None:
+        raise Refused(f"拒跑:{gate}")
+    config = rmm.GateConfig(io.environ, args.demo_id, args.ledger, folder, args.batch_id)
+    _gate_ready(config, io)
+    model = r.model_of(io.environ)
+    started = r.Attempt(seed, sequence, args.demo_id, args.batch_id, model,
+                        r.expected_key(p.SYSTEM_PROMPT, prepared.table, model), _now(), None,
+                        None, None, 0, r.CALLING)
+    _save(io.root, _with(manifest, started))  # 先記再送:行程中斷也不會重用這個序號
+    done = run(prepared, gate_ask(config, io.notify, io.opener), model=model)
+    ok = done.reply.ok and done.reply.mode == "live"
+    finished = replace(started, finished_at=_now(), outcome=done.reply.outcome,
+                       recording_key=done.reply.key, list_nanousd=done.reply.list_nanousd,
+                       status=r.PENDING if ok else r.FAILED,
+                       problems=() if ok else (done.reply.problem or done.reply.outcome,))
+    _save(io.root, _with(_load(io.root) or manifest, finished))
+    lines = [f"種子 {seed} 第 {sequence} 次({args.demo_id}):結果 {done.reply.outcome},"
+             f"狀態 {finished.status};估算花費(原價)"
+             f"{done.reply.list_nanousd / 10**9:.6f} 美元"]
+    if ok:
+        lines.append(f"下一步:--check-in --demo-id {args.demo_id} --recordings-dir {folder}")
+    else:
+        lines.append(f"呼叫失敗不入庫、不算撤除判斷;重錄用 {r.demo_id_of(seed, sequence + 1)}"
+                     "(新批次目錄)")
+    print("\n".join(lines), file=io.out)
+    return EXIT_OK if ok else EXIT_FAILED
+
+
+def _pending_attempt(args: argparse.Namespace, root: Path) -> tuple[r.Manifest, r.Attempt]:
+    manifest = _load(root)
+    attempt = next((a for a in (manifest.attempts if manifest else ())
+                    if a.demo_id == args.demo_id), None)
+    if manifest is None or attempt is None:
+        raise Refused(f"批次清單沒有 {args.demo_id} 這次嘗試(要先用即時錄製記下)")
+    if attempt.status != r.PENDING:
+        raise Refused(f"{args.demo_id} 的狀態是{attempt.status}:"
+                      "只有結果 ok、待驗收的嘗試能驗收入庫")
+    if args.check_in and r.checked_in(manifest, attempt.seed) is not None:
+        raise Refused(f"種子 {attempt.seed} 已有入庫錄製:每種子只准第一次成功錄製入庫")
+    return manifest, attempt
+
+
+def _check_in(args: argparse.Namespace, io: _Io) -> int:
+    """驗收一次嘗試的錄製目錄(只重播);`--check-in` 且過了就搬進入庫目錄。"""
+    seed, _ = _attempt_for(args.demo_id)
+    staging = args.recordings_dir
+    if staging is None:
+        raise Refused("驗收要帶這次嘗試的 --recordings-dir")
+    manifest, attempt = _pending_attempt(args, io.root)
+    prepared = prepare(seed)
+    expected = r.expected_key(p.SYSTEM_PROMPT, prepared.table, attempt.model)
+    problems = r.batch_problems(staging, attempt, expected)
+    done = _replay(prepared, staging, attempt, args, io)
+    if done.verification is None:
+        problems.append(f"重播沒有讀到可用的錄製({done.reply.outcome})")
+    target = io.root / str(seed)
+    if args.check_in and target.exists():
+        problems.append(f"入庫目錄 {_shown(target)} 已經存在")
+    lines = [f"種子 {seed}({args.demo_id})驗收:{'沒過' if problems else '通過'}",
+             *(f"- {problem}" for problem in problems)]
+    if done.verification is not None:
+        ver = done.verification
+        lines.append(f"- AI 有效 {ver.n} 條、無效提交 {ver.invalid_count} 筆、核對失敗 "
+                     f"{ver.mismatches} 筆")
+    if args.check_in and problems:
+        _save(io.root, _with(manifest, replace(attempt, status=r.REJECTED,
+                                               problems=tuple(problems))))
+        lines.append("沒有入庫;這次記成驗收沒過,同種子用下一個序號重錄")
+    elif args.check_in:
+        target.mkdir(parents=True)
+        for path in sorted(staging.iterdir()):
+            shutil.copyfile(path, target / path.name)
+        _save(io.root, _with(manifest, replace(attempt, status=r.CHECKED_IN)))
+        lines.append(f"已入庫:{_shown(target)};重產報告後一起提交")
+    print("\n".join(lines), file=io.out)
+    return EXIT_FAILED if problems else EXIT_OK
+
+
+def command(argv: list[str] | None = None, *, out: TextIO | None = None,
+             err: TextIO | None = None, environ: Mapping[str, str] | None = None,
+             root: Path | None = None, opener: rmm.GateOpener | None = None) -> int:
+    """命令列本體。root(入庫目錄)與 opener(即時錄製用的閘道)只給測試換;產品碼用預設。"""
+    args = _parse(argv)
+    io = _Io(out or sys.stdout, err or sys.stderr, os.environ if environ is None else environ,
+             root or r.default_root(), opener)
+    try:
+        if args.baseline_only and any((args.verify, args.check_in, args.demo_id, args.batch_id,
+                                       args.recordings_dir, args.ledger)):
+            raise Refused("--baseline-only 不接其他參數")
+        if args.check_in and args.verify:
+            raise Refused("--check-in 已含驗收,不要再帶 --verify")
+        if args.demo_id is None:
+            if args.check_in or args.batch_id is not None:
+                raise Refused("--check-in 與 --batch-id 要跟 --demo-id 一起用")
+            return _report_all(args, io)
+        if args.verify or args.check_in:
+            if args.batch_id is not None:
+                raise Refused("驗收只准重播:不要帶 --batch-id")
+            return _check_in(args, io)
+        return _record(args, io)
+    except (Refused, PromptRefused) as refused:
+        print(f"拒絕開始:{refused}", file=io.err)
+        return EXIT_REFUSED
+
+
+def main(argv: list[str] | None = None) -> None:
+    raise SystemExit(command(argv))
+
+
+if __name__ == "__main__":
+    main()
