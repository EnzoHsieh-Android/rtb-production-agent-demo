+def _tampered_batches_are_refused(tmp_path, root, prepared, staging):
+    """驗收(不入庫)的幾種沒過:多一份別的鍵、呼叫者被改、目錄裡有別的檔。清單不動。"""
+    before = (root / rr.MANIFEST_NAME).read_text(encoding="utf-8")
+    [original] = staging.iterdir()
+    extra = tmp_path / "tamper-extra"
+    shutil.copytree(staging, extra)
+    data = json.loads(original.read_text(encoding="utf-8"))
+    other_key = rr.expected_key(rp.SYSTEM_PROMPT, prepared[15001].table + "\n")
+    (extra / f"{other_key}.json").write_text(json.dumps({**data, "key": other_key}),
+                                             encoding="utf-8")
+    relabeled = tmp_path / "tamper-caller"
+    shutil.copytree(staging, relabeled)
+    (relabeled / original.name).write_text(json.dumps({**data, "caller": "eval_candidate"}),
+                                           encoding="utf-8")
+    stray = tmp_path / "tamper-stray"
+    shutil.copytree(staging, stray)
+    (stray / "notes.txt").write_text("x", encoding="utf-8")
+    for folder, needle in ((extra, "錄製鍵集合"), (relabeled, "呼叫者 eval_candidate"),
+                           (stray, "不是錄製檔")):
+        code, out, _ = check_in(tmp_path, root, 15001, 2, folder, flag="--verify")
+        assert code == rme.EXIT_FAILED and needle in out, out
+    assert (root / rr.MANIFEST_NAME).read_text(encoding="utf-8") == before
+    # 入庫時驗收沒過:記成驗收沒過、不搬;同種子之後用下一個序號重錄
+    code, out, _ = check_in(tmp_path, root, 15001, 2, relabeled)
+    assert code == rme.EXIT_FAILED and "驗收沒過" in out and not (root / "15001").exists()
+    rejected = attempt(root, 15001, 2)
+    assert rejected.status == rr.REJECTED and rejected.problems
+    (root / rr.MANIFEST_NAME).write_text(before, encoding="utf-8")  # 還原,接著走正常入庫
+
+
+def _manifest_rules_are_machine_checked(tmp_path, root, env):
+    """清單被手改:換評估版本、序號跳號、入庫的不是第一次成功的,驗收都抓得到。"""
+    text = (root / rr.MANIFEST_NAME).read_text(encoding="utf-8")
+    data = json.loads(text)
+    cases = []
+    cases.append(({**data, "eval_version": "phase15-rule-mining-v2"}, "評估版本"))
+    skipped = json.loads(text)
+    skipped["attempts"][2] = {**skipped["attempts"][2], "sequence": 2,
+                              "demo_id": demo(15002, 2)}
+    cases.append((skipped, "序號要從 1 起"))
+    second_ok = json.loads(text)
+    second_ok["attempts"][0] = {**second_ok["attempts"][0], "outcome": "ok",
+                                "status": rr.PENDING}
+    cases.append((second_ok, "入庫的不是第一次成功的錄製"))
+    for tampered, needle in cases:
+        (root / rr.MANIFEST_NAME).write_text(json.dumps(tampered, ensure_ascii=False),
+                                             encoding="utf-8")
+        code, out, _ = cli(["--verify", "--ledger", str(tmp_path / "ci.sqlite")], root, env)
+        assert code == rme.EXIT_FAILED and needle in out, needle
+    (root / rr.MANIFEST_NAME).write_text(text, encoding="utf-8")
