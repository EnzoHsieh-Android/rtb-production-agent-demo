+def wilson_lower(successes: int, n: int, z: float = Z_95) -> float:
+    """比例的 95% Wilson 信賴下界。"""
+    if n <= 0 or not 0 <= successes <= n:
+        raise ValueError("樣本數要大於零,成功數要在 0 到樣本數之間")
+    p = successes / n
+    denominator = 1 + z * z / n
+    center = p + z * z / (2 * n)
+    margin = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n))
+    return (center - margin) / denominator
