+PROVENANCE = scoring.HiddenSetProvenance(
+    version="v1", sha256="a" * 64, sampling_source="正式決策紀錄依格抽樣",
+    labeling_source="兩位標註員各自標、不一致再裁", candidate_version="cand-1",
+    candidate_predates_disclosure=True)
