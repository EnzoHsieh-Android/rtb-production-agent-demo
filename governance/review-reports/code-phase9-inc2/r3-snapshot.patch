--- a/src/rtb/sqlitekit.py
+++ b/src/rtb/sqlitekit.py
@@ -99,20 +99,25 @@ def read_snapshot(conn: sqlite3.Connection) -> Iterator[None]:
     """唯讀交易:進入時定下快照,離開時結束(不論有沒有例外)。"""
