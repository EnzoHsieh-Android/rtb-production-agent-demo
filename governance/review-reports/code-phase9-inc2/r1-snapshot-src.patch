+@dataclass(frozen=True)
+class Sample:
+    name: str
+    labels: tuple[Label, ...]
+    value: float | None
+    count: int
+    status: Status = Status.OK
+    numerator: int | None = None
+    exemplars: tuple[str, ...] = ()
+    tenant_by_lookup: int = 0  # 其中幾份的租戶是用查詢當下的租戶設定反查的
+    note: str | None = None
+
+    @property
+    def base(self) -> str:
+        """延遲的四個統計量(名稱後綴 .p50 等)共用同一組宣告。"""
+        return self.name.split(".", 1)[0]
