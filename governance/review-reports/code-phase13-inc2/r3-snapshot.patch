+def test_a_busy_renewal_skips_the_step_without_failing_the_task(store, monkeypatch):
+    """[S1152] 續租條件不符或等鎖逾時:續租回呼丟 RenewalSkipped,流程層在通用例外之前接住,這一步
+    不寫、放掉租約、不呼叫模型,工作不轉失敗。"""
