+                                                             "ai")), TaskState.NO_ACTION),
+        (flow.AiOutcome(flow.NoAction(), InvestigationRecord(
+            "fallback", 1, "no_action", "rule", fallback="off_menu")), TaskState.NO_ACTION),
+    ]
