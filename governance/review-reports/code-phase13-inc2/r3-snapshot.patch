+def test_every_model_round_is_committed_with_its_step(store, tmp_path):
+    """[S1110] 回蒐集證據、已提案、不提案、退回規則四種轉換,調查紀錄都跟狀態列同一個交易、同序號
+    寫;提交輸給接手者時連紀錄一起沒寫。"""
