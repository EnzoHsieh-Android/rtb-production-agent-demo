+        assert rows[-1][0] == rows[-2][0] + 1  # 放掉的是新收據那一列,不是舊的
+        assert second.latest("t1").state is TaskState.ANALYZING  # 這一步沒寫
+        assert second.acquire_lease("t1", "w9", NOW) is not None  # 真的放掉了,別人拿得到
+    finally:
