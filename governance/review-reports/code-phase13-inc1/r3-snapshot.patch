+def model_client_modules():
+    """模型用戶端的每一支模組:src/rtb/ 底下檔名以 model 開頭的(實作當下列舉,不寫死)。"""
+    return frozenset(f"rtb.{path.stem}" for path in RTB.glob("model*.py"))
