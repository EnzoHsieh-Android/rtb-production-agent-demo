+def tenants_file(tmp_path):
+    path = tmp_path / "tenants.json"
+    path.write_text(json.dumps({"tenants": {
+        "acme": {"campaigns": ["c1", "c2"], "max_budget": 1000, "aggregate_limit": 500},
+        "beta": {"campaigns": ["c3"], "max_budget": 1000, "aggregate_limit": 500}}}),
+        encoding="utf-8")
+    path.chmod(0o600)
+    return path
