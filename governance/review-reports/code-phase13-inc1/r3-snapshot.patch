+def _narrate(world, outcome, text=None, source="recorded", *, record=True):
+    """直接經分析端資料庫模組寫一次領取與結果(說明命令列本身在 tests/analyzer/test_narrate.py)。"""
+    from rtb.analyzer.task_store import NarrativeOutcome
