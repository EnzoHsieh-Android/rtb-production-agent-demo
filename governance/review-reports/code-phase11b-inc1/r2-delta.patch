 # 一筆預留連同它的結算與核銷;WHERE 由呼叫端接上(欄位固定,參數用佔位)
 CALLS_SELECT = (
     "SELECT r.id, r.reserved_at, r.month, r.demo_id, r.batch_id, r.caller, r.model, r.backend, "
