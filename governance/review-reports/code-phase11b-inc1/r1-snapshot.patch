+        failure_rate=0.01) == model_candidate.MODEL_LIMITS
+    slow = [_batch_row(f"s{n}", latency_ms=100.0 if n < 90 else 4_000.0) for n in range(100)]
+    failing = [_batch_row(f"f{n}", cell=WorthCell.ANOMALY,
