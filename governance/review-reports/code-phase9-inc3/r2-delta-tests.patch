+    tied = base + timedelta(seconds=100)
+    times = [base + timedelta(seconds=n) for n in range(OPERATION_PAGE - 1)]
+    times += [tied, tied, base + timedelta(seconds=200)]  # 第 50、51 筆同時間
+    conn = sqlite3.connect(world.dsp_db)
