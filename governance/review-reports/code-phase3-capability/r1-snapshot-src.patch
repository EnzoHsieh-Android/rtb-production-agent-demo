+
+
+class CapabilityExpired(CapabilityError):
+    """憑證不在有效時間窗內。"""
+
+
+class CapabilityScopeMismatch(CapabilityError):
+    """請求(廣告、動作、冪等鍵、租戶、新預算、預期版本)與聲明不符。"""
