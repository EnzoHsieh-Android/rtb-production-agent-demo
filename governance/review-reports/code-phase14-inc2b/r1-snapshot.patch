+# 1 小時基本資料裡 A 與 C 要逐欄相同的欄位(原始值,不經收據捨入)
+COMPARED_STATE = ("id", "status", "version")
+COMPARED_METRICS = ("impressions", "clicks", "conversions", "spend", "revenue")
+
+
+class Step(StrEnum):
+    A = "A"
+    B = "B"
