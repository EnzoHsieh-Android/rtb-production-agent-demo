+"""廣告指標的確定性計算:CTR、CVR、ROAS、Pacing。
+
+純函式,不碰資料庫、網路或模型(由 ruff 的禁用匯入規則機械檢查),也不使用 LLM。
+每個指標的結果是「有值」或「沒有值加原因」,絕不把「不知道」悄悄變成 0:
+- NO_DENOMINATOR:分母為零(例如沒有曝光),是正常的零,不是壞表現。
+- MISSING_DATA:輸入缺漏,我們不知道。
+- INVALID_DATA:輸入不合理(負數、非有限數、點擊比曝光多),不能信。
+判斷優先順序:不合理 > 缺漏 > 分母為零。
+"""
+
+import math
+from dataclasses import dataclass
+
+NO_DENOMINATOR = "no_denominator"
+MISSING_DATA = "missing_data"
+INVALID_DATA = "invalid_data"
+
+
+@dataclass(frozen=True)
+class MetricResult:
+    """沒有實作 < > 等比較:誤把空值當數字比大小會直接報 TypeError,而不是默默判成 0。"""
+
+    value: float | None
+    reason: str | None = None
+
+    @property
+    def is_known(self) -> bool:
+        return self.value is not None
+
+    def below(self, threshold: float) -> bool | None:
+        """低於門檻嗎?不知道就回 None(證據不足),絕不回 True 或 False。"""
+        _check_threshold(threshold)
+        return None if self.value is None else self.value < threshold
+
+    def at_least(self, threshold: float) -> bool | None:
+        _check_threshold(threshold)
+        return None if self.value is None else self.value >= threshold
+
+
+def _unknown(reason: str) -> MetricResult:
+    return MetricResult(value=None, reason=reason)
+
+
+def _check_threshold(threshold: object) -> None:
+    if not _is_number(threshold) or not math.isfinite(threshold):
+        raise ValueError("門檻必須是有限的數字")
+
+
+def _is_number(value: object) -> bool:
+    return isinstance(value, int | float) and not isinstance(value, bool)
+
+
+def _is_valid_amount(value: object) -> bool:
+    return _is_number(value) and math.isfinite(value) and value >= 0
+
+
+def _classify(*inputs: object) -> str | None:
+    """回傳輸入的問題類別;None 代表全部有效。不合理優先於缺漏。"""
+    present = [v for v in inputs if v is not None]
+    if any(not _is_valid_amount(v) for v in present):
+        return INVALID_DATA
+    if len(present) < len(inputs):
+        return MISSING_DATA
+    return None
+
+
+def _ratio(numerator: float, denominator: float) -> MetricResult:
+    if denominator == 0:
+        return _unknown(NO_DENOMINATOR)
+    return MetricResult(value=numerator / denominator)
+
+
+def ctr(clicks: int | None, impressions: int | None) -> MetricResult:
+    """點擊率 = 點擊 / 曝光。"""
+    problem = _classify(clicks, impressions)
+    if problem is None and clicks > impressions:
+        problem = INVALID_DATA  # 點擊不可能比曝光多
+    return _unknown(problem) if problem else _ratio(clicks, impressions)
+
+
+def cvr(conversions: int | None, clicks: int | None) -> MetricResult:
+    """轉換率 = 轉換 / 點擊。"""
+    problem = _classify(conversions, clicks)
+    return _unknown(problem) if problem else _ratio(conversions, clicks)
+
+
+def roas(revenue: float | None, spend: float | None) -> MetricResult:
+    """廣告投資報酬率 = 營收 / 花費。"""
+    problem = _classify(revenue, spend)
+    return _unknown(problem) if problem else _ratio(revenue, spend)
+
+
+def pacing(
+    spend: float | None, budget: float | None, elapsed_fraction: float | None
+) -> MetricResult:
+    """預算花費進度 = 實際花費 / 到目前為止預期該花的金額(預算 x 已過去的時間比例)。
+
+    elapsed_fraction 必須在 0 到 1 之間。1.0 代表剛好符合預期,小於 1 是落後,大於 1 是超前。
+    """
+    problem = _classify(spend, budget, elapsed_fraction)
+    if problem is None and elapsed_fraction > 1:
+        problem = INVALID_DATA
+    if problem:
+        return _unknown(problem)
+    return _ratio(spend, budget * elapsed_fraction)
