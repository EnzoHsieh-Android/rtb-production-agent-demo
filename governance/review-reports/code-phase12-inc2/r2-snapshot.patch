+_FAILED = frozenset({BasisCode.RATIO_OVER, BasisCode.CAP_OVER, BasisCode.TOTAL_OVER})
+
+
+_FAILURE_TEXT = {"dsp_unavailable": "讀不到平台", "table_full": "全表未結案已滿",
+                 "no_report": "處理的人沒回報"}
+
+
+def lifecycle(kind: str, *, deliveries: int | None, reason: str | None,
