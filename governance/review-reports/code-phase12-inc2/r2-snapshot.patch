+.flow-toolbar {
+  display: flex;
+  gap: var(--space-4);
+  align-items: center;
+  justify-content: space-between;
+  margin-top: var(--space-4);
+  color: var(--muted);
+  font-size: var(--font-sm);
+}
+.flow-toolbar p { margin: 0; }
+.flow-legend { display: flex; flex-wrap: wrap; gap: var(--space-3); }
+
+.flow-scroll, .decision-scroll, .table-scroll {
+  max-width: 100%;
+  overflow-x: auto;
+  scrollbar-color: var(--border-strong) transparent;
+}
+
+.flow-scroll {
+  margin-top: var(--space-2);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  background: var(--surface-soft);
+}
+.flow-canvas { width: max-content; }
+.flow-lanes {
+  position: sticky;
+  left: 0;
+  z-index: 2;
+  display: grid;
+  grid-template-rows: repeat(5, 140px);
+  width: 72px;
+  height: 800px;
+  margin-bottom: -800px;
+  padding-top: 50px;
+  pointer-events: none;
+}
+.flow-lane {
+  height: 136px;
+  padding: 0.7rem 0.35rem;
+  background: var(--surface);
+  box-shadow: inset -1px 0 var(--border-strong), 8px 0 16px rgb(0 0 0 / 15%);
+  color: var(--text);
+  font-size: 12px;
+  font-weight: 750;
+}
+
+.flow-graph {
+  display: block;
+  width: auto;
+  max-width: none;
+  height: auto;
+}
+.lane-band rect { fill: color-mix(in srgb, var(--accent) 8%, var(--surface)); }
+
+.flow-edge path { fill: none; stroke: var(--accent); stroke-width: 2.5; }
+.flow-edge rect { fill: var(--surface-soft); }
+.flow-edge text { fill: var(--accent-strong); font-size: 12px; font-weight: 750; text-anchor: middle; }
+.arrow-head { fill: var(--accent); }
+
+.flow-branch path { fill: none; stroke: var(--faint); stroke-width: 1.5; stroke-dasharray: 4 4; }
+.flow-branch rect { fill: var(--surface); stroke: var(--border-strong); stroke-dasharray: 4 3; }
+.flow-branch text { fill: var(--muted); font-size: 12px; text-anchor: middle; }
+
+.flow-node rect, .flow-node polygon { fill: var(--owner-fill); stroke: var(--owner-stroke); stroke-width: 2; }
+.flow-node text { fill: var(--text); text-anchor: middle; }
+.node-label { font-size: 12px; font-weight: 760; }
+.node-owner { font-size: 12px; font-weight: 800; text-anchor: start !important; }
+.node-state, .group-detail { font-size: 12px; font-weight: 700; }
+.decision-badge { fill: var(--accent-strong) !important; font-size: 12px; font-weight: 850; text-anchor: start !important; }
+
+.flow-node.owner-code { --owner-fill: #dceeff; --owner-stroke: #25567a; --owner-text: #173e5c; }
+.flow-node.owner-ai { --owner-fill: #efe1ff; --owner-stroke: #74428e; --owner-text: #4c2464; }
+.flow-node.owner-human { --owner-fill: #fff0d6; --owner-stroke: #85551e; --owner-text: #5f390b; }
+.flow-node.owner-external { --owner-fill: #ddf4e6; --owner-stroke: #28664c; --owner-text: #164531; }
+.flow-node text { fill: var(--owner-text); }
+.flow-node.owner-ai rect { stroke-dasharray: 6 2; }
+.flow-node.owner-human rect { stroke-width: 3; }
+.flow-node.owner-external rect { stroke-dasharray: 2 3; }
+.flow-node.is-group rect { stroke-width: 3; }
+.flow-return path { fill: none; stroke: var(--text); stroke-width: 2; stroke-dasharray: 6 4; }
+.flow-return text { fill: var(--text); font-size: 12px; font-weight: 800; text-anchor: middle; }
+.flow-legend span[class^="legend-"] { padding: 0.2rem 0.45rem; border: 2px solid; border-radius: 0.35rem; font-weight: 800; }
+.legend-code { background: #dceeff; color: #173e5c; border-color: #25567a; border-style: solid !important; }
+.legend-ai { background: #efe1ff; color: #4c2464; border-color: #74428e; border-style: dashed !important; }
+.legend-human { background: #fff0d6; color: #5f390b; border-color: #85551e; border-style: double !important; border-width: 3px !important; }
+.legend-external { background: #ddf4e6; color: #164531; border-color: #28664c; border-style: dotted !important; }
+@media (prefers-color-scheme: dark) {
+  .flow-node.owner-code { --owner-fill: #193a50; --owner-stroke: #93ccee; --owner-text: #ecf8ff; }
+  .flow-node.owner-ai { --owner-fill: #39254b; --owner-stroke: #d5a4f0; --owner-text: #f8eeff; }
+  .flow-node.owner-human { --owner-fill: #493614; --owner-stroke: #f1c875; --owner-text: #fff6df; }
+  .flow-node.owner-external { --owner-fill: #173a2b; --owner-stroke: #89d0ac; --owner-text: #e8fff1; }
+  .legend-code { background: #193a50; color: #ecf8ff; border-color: #93ccee; }
+  .legend-ai { background: #39254b; color: #f8eeff; border-color: #d5a4f0; }
+  .legend-human { background: #493614; color: #fff6df; border-color: #f1c875; }
+  .legend-external { background: #173a2b; color: #e8fff1; border-color: #89d0ac; }
+}
+@media print {
+  .flow-node rect { print-color-adjust: exact; }
+  .flow-legend span[class^="legend-"] { print-color-adjust: exact; }
+}
+
+.flow-node.is-visited rect, .flow-node.is-visited polygon { stroke-width: 2.5; }
+.flow-node.is-current rect, .flow-node.is-current polygon {
+  stroke: var(--current);
+  stroke-width: 4;
+  animation: current-pulse 1.8s ease-in-out infinite;
+}
+.flow-node.is-future { opacity: 0.85; }
+
+@keyframes current-pulse {
+  50% { stroke-width: 6; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  .flow-node.is-current rect, .flow-node.is-current polygon { animation: none; }
+}
+
+.decision-heading { display: flex; align-items: baseline; gap: var(--space-3); margin-top: var(--space-4); }
+.decision-heading h3, .decision-heading p { margin-bottom: var(--space-2); }
+.decision-heading p { color: var(--muted); font-size: var(--font-sm); }
+.decision-trail { display: flex; gap: var(--space-2); min-width: max-content; margin: 0; padding: 0 0 var(--space-2); list-style: none; }
+
+.decision-card {
+  display: grid;
+  grid-template-columns: auto 1fr;
+  gap: var(--space-2);
+  width: 16.5rem;
+  padding: var(--space-3);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  background: var(--surface-raised);
+}
+.decision-card.is-latest { border-color: var(--current); box-shadow: inset 0 0 0 1px var(--current); }
+.decision-number { color: var(--faint); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: var(--font-sm); }
+.decision-card p { margin-bottom: 0.2rem; }
+.decision-node { color: var(--muted); font-size: var(--font-xs); }
+.decision-outcome { font-weight: 780; }
+.decision-branch { color: var(--accent-strong); font-size: var(--font-sm); }
+.decision-reason { min-height: 2.7rem; color: var(--muted); font-size: var(--font-sm); overflow-wrap: anywhere; }
+.decision-card time { color: var(--faint); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: var(--font-xs); }
+.just-now { margin-left: 0.25rem; color: var(--current); font-weight: 850; }
+
+.report-scenarios { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
+.report-scenario { min-width: 0; }
+.report .focus-panel { height: 100%; }
+.report .focus-heading { flex-wrap: wrap; }
+.report .flow-toolbar { font-size: var(--font-xs); }
+.report .decision-scroll { overflow: visible; }
+.report .decision-trail { min-width: 0; flex-wrap: wrap; }
+.report .decision-card { width: min(100%, 15rem); }
+.report .decision-reason { display: block; min-height: 0; overflow: visible; }
+
+.approval {
+  margin-top: var(--space-5);
+  padding: var(--space-4);
+  border: 1px solid var(--current);
+  border-radius: var(--radius-lg);
+  background: var(--surface);
+}
+.approval-page { max-width: 50rem; }
+.approval-page-heading { margin-bottom: var(--space-4); }
+.approval-page .approval { margin-top: 0; }
+.back-link { margin-top: var(--space-3); }
+.confirmations { display: grid; gap: var(--space-2); margin: var(--space-3) 0; }
+.confirmations label { display: flex; gap: var(--space-2); align-items: start; padding: var(--space-2); border-radius: var(--radius-sm); background: var(--surface-soft); }
+.confirmations input { width: 1.2rem; height: 1.2rem; margin-top: 0.2rem; }
+
+.secondary { margin-top: var(--space-6); }
+.detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
+.detail-card { min-width: 0; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
+.detail-card > summary { padding: 0.9rem 1rem; cursor: pointer; font-weight: 680; }
+.detail-card > div { padding: 0 var(--space-3) var(--space-3); border-top: 1px solid var(--border); }
+.detail-card:nth-last-child(-n + 3) { grid-column: 1 / -1; }
+
+.timeline, .definition-list { margin: 0; padding: 0; list-style: none; }
+.timeline li { position: relative; padding: var(--space-3) 0 var(--space-3) 1.1rem; border-left: 1px solid var(--border-strong); }
+.timeline li::before { position: absolute; top: 1.45rem; left: -0.25rem; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--accent); content: ""; }
+.timeline time { display: block; color: var(--faint); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: var(--font-xs); }
+.timeline p { margin: 0; color: var(--muted); }
+.definition-list li { padding: var(--space-2) 0; }
+.definition-list p { margin: var(--space-1) 0 0; color: var(--muted); }
+code, .raw-line { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
+code { color: var(--accent-strong); }
+.raw-line { margin: var(--space-2) 0 0; padding: var(--space-2); border-radius: var(--radius-sm); background: var(--surface-soft); overflow-wrap: anywhere; }
+
+table { width: 100%; min-width: 38rem; border-collapse: collapse; }
+th, td { padding: 0.65rem; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
+th { color: var(--muted); font-size: var(--font-xs); }
+.number { text-align: right; font-variant-numeric: tabular-nums; }
+.numbers { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: var(--space-2); }
+.numbers > div { padding: var(--space-2); border: 1px solid var(--border); border-radius: var(--radius-sm); }
+.model-note { margin-top: var(--space-3); padding: var(--space-3); border-left: 3px solid var(--current); background: var(--current-soft); }
+.model-note p:last-child { margin-bottom: 0; }
+.model-warning { color: var(--current); font-weight: 780; }
+.empty, .comparison-note { color: var(--muted); }
+.limits-list { color: var(--danger); }
+
+@media (max-width: 64rem) {
+  main { width: min(100% - 2rem, 86rem); padding-top: var(--space-5); }
+  .hero { grid-template-columns: 1fr; }
+  .hero-action { grid-column: 1; }
+  .current-progress { grid-template-columns: auto auto minmax(0, 1fr); padding-inline: 1rem; }
+  .progress-scenario, .progress-node, .progress-decision { grid-column: 2 / -1; }
+  .scenario-link { grid-template-columns: 3rem minmax(9rem, 1fr) auto; }
+  .scenario-result { grid-column: 2 / -1; grid-row: 2; white-space: normal; }
+  .report-scenarios { grid-template-columns: 1fr; }
+}
+
+@media (max-width: 38rem) {
+  main { width: calc(100% - 1rem); padding-top: var(--space-4); }
+  h1 { font-size: 2.35rem; }
+  .summary-strip { grid-template-columns: 1fr 1fr; }
+  .summary-strip > div:nth-child(3) { border-left: 0; border-top: 1px solid var(--border); }
+  .summary-strip > div:nth-child(4) { border-top: 1px solid var(--border); }
+  .current-progress { position: static; grid-template-columns: auto auto 1fr; font-size: var(--font-xs); }
+  .progress-scenario, .progress-node, .progress-decision { grid-column: 2 / -1; }
+  .section-heading, .focus-heading, .flow-toolbar { align-items: start; flex-direction: column; }
+  .scenario-row { grid-template-columns: 1fr auto; }
+  .scenario-link { grid-template-columns: 2.5rem 1fr; gap: 0.35rem var(--space-2); padding-inline: var(--space-2); }
+  .scenario-result { grid-column: 2; grid-row: auto; }
+  .scenario-link .status { grid-column: 2; }
+  .focus-panel { padding: var(--space-2); }
+  .detail-grid { grid-template-columns: 1fr; }
+  .detail-card:nth-last-child(-n + 3) { grid-column: auto; }
+}
+
+/* 正式流程的第一層：角色責任，第二層才是情境路徑。 */
+.system-map { margin: 0 0 var(--space-6); }
+.role-map {
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: 0.7rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.role-card {
+  position: relative;
+  min-width: 0;
+  padding: 1.1rem;
+  border: 1px solid var(--border-strong);
+  border-radius: var(--radius);
+  background: var(--surface);
+}
+.role-card:not(:last-child)::after {
+  position: absolute;
+  top: 1.4rem;
+  right: -0.8rem;
+  z-index: 1;
+  color: var(--accent-strong);
+  font-size: 1.1rem;
+  content: "→";
+}
+.role-number { color: var(--accent-strong); font: 800 0.8rem ui-monospace, monospace; }
+.role-card h3 { margin: 0.5rem 0; font-size: 1.15rem; }
+.role-card p { min-height: 3.3rem; margin-bottom: 0.6rem; color: var(--muted); font-size: var(--font-sm); }
+.role-card strong { display: block; min-height: 3rem; font-size: var(--font-sm); }
+.role-card details { margin-top: 0.8rem; border-top: 1px solid var(--border); padding-top: 0.65rem; }
+.role-card summary { color: var(--accent-strong); cursor: pointer; font-size: var(--font-sm); }
+.role-card details ol { max-height: 15rem; margin: 0.75rem 0 0; padding-left: 1.3rem; overflow-y: auto; }
+.role-card details li { margin: 0.35rem 0; color: var(--muted); font-size: var(--font-sm); overflow-wrap: anywhere; }
+.map-note { margin: 1rem 0 0; padding: 0.75rem 1rem; border-left: 3px solid var(--accent); background: var(--accent-soft); }
+
+.scenario-link { grid-template-columns: 3rem minmax(10rem, 0.8fr) minmax(11rem, 1fr) minmax(14rem, 1.4fr) auto; }
+.scenario-pivot { color: var(--accent-strong); font-size: var(--font-sm); overflow-wrap: anywhere; }
+.scenario-result { white-space: normal; overflow-wrap: anywhere; }
+.flow-scroll { overflow-x: auto; overflow-y: hidden; }
+.flow-edge rect { fill: var(--surface); stroke: var(--border-strong); }
+.flow-node.kind-decision:not(.owner-ai) rect { stroke-dasharray: none; }
+.decision-trail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); min-width: 0; }
+.decision-card { width: auto; min-width: 0; }
+.decision-reason { display: block; min-height: 0; overflow: visible; }
+.decision-other { color: var(--muted); font-size: var(--font-xs); overflow-wrap: anywhere; }
+.report-scenarios { grid-template-columns: 1fr; }
+.report .decision-trail { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.report .decision-card { width: auto; }
+
+@media (max-width: 76rem) {
+  .role-map { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .role-card:nth-child(3)::after { content: none; }
+  .scenario-link { grid-template-columns: 3rem minmax(10rem, 1fr) minmax(12rem, 1fr) auto; }
+  .scenario-result { grid-column: 2 / -1; grid-row: 2; }
+  .report .decision-trail { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 48rem) {
+  .role-map { grid-template-columns: 1fr; }
+  .role-card { padding: 0.9rem 1rem; }
+  .role-card p, .role-card strong { min-height: 0; }
+  .role-card::after { content: none !important; }
+  .scenario-link { grid-template-columns: 2.5rem minmax(0, 1fr) auto; }
+  .scenario-pivot, .scenario-result { grid-column: 2 / -1; grid-row: auto; }
+  .scenario-link .status { grid-column: 3; grid-row: 1; }
+  .decision-trail, .report .decision-trail { grid-template-columns: 1fr; }
+}
+.approval-context { padding: 0.8rem 1rem; border-left: 3px solid var(--current); background: var(--current-soft); color: var(--text); }
+
+.change-summary { margin: 0.9rem 0; padding: 0.9rem 1rem; border: 2px solid var(--accent); border-radius: var(--radius); background: var(--accent-soft); }
+.change-summary p, .scenario-intent p { margin: 0.35rem 0 0; }
+.scenario-intent { margin-bottom: 0.9rem; padding: 0.7rem 1rem; border-left: 3px solid var(--border-strong); }
+.queue-note { margin: 0.75rem 0 0; font-weight: 800; color: var(--accent-strong); }
+.ai-boundary { color: var(--text); font-weight: 750; }
+.flow-handoff rect { fill: var(--surface); stroke: var(--accent-strong); stroke-width: 2; }
+.flow-handoff text { fill: var(--accent-strong); text-anchor: middle; font-weight: 900; font-size: 15px; }
+.flow-node.is-visited:not(.owner-ai):not(.owner-external) rect,
+.flow-node.is-current:not(.owner-ai):not(.owner-external) rect { stroke-dasharray: none; }
+.fault-marker { fill: #a72c49 !important; font-weight: 900; font-size: 18px; }
+.fault-note { margin: 0.6rem 0; padding: 0.5rem 0.7rem; border-left: 4px solid #a72c49; background: #ffe6eb; color: #a72c49; font-weight: 800; }
+.fault-note.is-empty { border-color: var(--border-strong); background: var(--surface-soft); color: var(--muted); }
+.result-evidence { margin: 0.5rem 0; padding: 0.65rem 1rem; background: var(--surface-soft); overflow-wrap: anywhere; }
+.result-evidence p { margin: 0.2rem 0 0; font-size: var(--font-sm); }
+.decision-basis { margin: 0.6rem 0; padding: 0.55rem; background: var(--surface-soft); border-radius: var(--radius-sm); }
+.decision-basis ul { margin: 0.35rem 0 0; padding-left: 1.1rem; }
+.decision-basis li span, .decision-basis li strong { display: block; margin: 0.15rem 0; }
+.decision-operation { overflow-wrap: anywhere; font-size: var(--font-xs); }
+.ai-node-card { margin-top: 0.8rem; padding: 0.8rem 1rem; border-left: 4px solid #74428e; background: var(--surface-soft); }
+.ai-node-card p { margin: 0.25rem 0; font-weight: 750; }
+.ai-node-card blockquote { margin: 0.4rem 0 0; overflow-wrap: anywhere; }
+.alternate-map { margin-top: 0.8rem; padding: 0.8rem; border: 1px dashed var(--border-strong); border-radius: var(--radius); }
+.alternate-map h3 { margin: 0 0 0.3rem; }
+.alternate-map p { margin: 0 0 0.6rem; color: var(--muted); font-size: var(--font-sm); }
+.branch-route { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin: 0.45rem 0; opacity: 0.76; }
+.branch-source, .branch-step { padding: 0.25rem 0.45rem; border: 1.5px dashed var(--border-strong); border-radius: 0.35rem; background: var(--surface); font-size: var(--font-sm); }
+.branch-source { border-style: solid; opacity: 1; }
+.branch-connector { color: var(--muted); border-bottom: 2px dashed var(--border-strong); padding-inline: 0.3rem; }
+@media (prefers-color-scheme: dark) {
+  .fault-note { background: #3c1d25; color: #ff9cae; }
+  .fault-marker { fill: #ff9cae !important; }
+}
+
+@media print {
+  .flow-scroll, .report .flow-scroll { overflow: visible; }
+  .role-card, .decision-card, .focus-panel { break-inside: avoid; }
+}
+
+/* Report presentation. Data and original diagrams remain intact. */
+.sample-notice { display:flex; align-items:flex-start; gap:14px; padding:12px 16px; margin:0; border:1px solid #465641; border-radius:10px; color:#becbb7; background:#20291e; font-size:12px; line-height:1.8; }
+.sample-notice strong { flex-shrink:0; color:#d6e7c9; font-size:11px; letter-spacing:.06em; }
+.report-nav { display:flex; gap:8px; margin:-12px 0 28px; padding-bottom:16px; border-bottom:1px solid var(--border); }
+.report-nav a { color:var(--muted); padding:7px 14px; border:1px solid transparent; border-radius:7px; text-decoration:none; font-size:12px; }
+.report-nav a:hover { background:var(--surface); color:var(--accent); border-color:var(--border); }
+.reference-note { color:var(--muted); font-size:12px; padding-top:14px; }
+.diagram-controls button:disabled { opacity:.3; cursor:default; }
+.report .glossary { display:grid; grid-template-columns:145px minmax(0,1fr); gap:0 20px; margin:12px 0 0; }
+.report .glossary dt,.report .glossary dd { padding:12px 0; border-bottom:1px solid var(--border); font-size:12px; line-height:1.8; }
+.report .glossary dt { color:var(--text); font-weight:500; }
+.report .glossary dd { color:var(--muted); font-weight:400; }
+.secondary .detail-card:has(.glossary) { grid-column:1 / -1; }
+.secondary .detail-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
+@media(max-width:760px) { .secondary .detail-grid { grid-template-columns:1fr; } }
+.report-scenario>.detail-card p { font-size:11px; color:var(--muted); overflow-wrap:anywhere; }
+.report-disclosure .scenario-intent { margin:16px; }
+.report-disclosure summary:hover { background:#ffffff05; }
+.report .limits-list { color:var(--muted); padding-left:20px; font-size:12px; line-height:1.9; }
+@media(max-width:600px) { .sample-notice { display:block; } .sample-notice strong { display:block; margin-bottom:4px; } .report .glossary { grid-template-columns:1fr; } .report .glossary dt { border:0; padding-bottom:0; } .report .glossary dd { padding-top:4px; } .diagram-actions { flex-wrap:wrap; } .diagram-controls { margin-left:auto; } }
+@media(prefers-reduced-motion:reduce) { .scenario-row { transition:none; } }
