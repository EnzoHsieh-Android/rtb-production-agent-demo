+def _fallback_result(scenario: Scenario) -> str:
+    """沒有結果摘要時照狀態寫,不拿情境說明或最後一步頂替成結果(代碼審 r1 p4)。"""
+    if scenario.status is ScenarioStatus.PENDING:
