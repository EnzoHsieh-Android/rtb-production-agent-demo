+def _before(world: World, campaign: str, writes: Sequence[DspWrite], key: str | None) -> int | None:
+    """「之前」是被追蹤那一把鍵寫入前的平台預算:那筆寫入的前一筆寫入的新預算,沒有前一筆就是造資料時
