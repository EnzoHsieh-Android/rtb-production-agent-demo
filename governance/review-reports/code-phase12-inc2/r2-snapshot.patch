+def test_many_decisions_are_summarised_and_each_edge_is_drawn_once() -> None:
+    """[代碼審 r1 p8] 幾千筆判斷(F7):走過的邊依(起點, 終點)只畫一次,沒走的分支只列一次,判斷卡依
+    節點與分支彙總並標筆數;頁面不會隨筆數長大。"""
+    loop = (_step("x_pick", ("x_pick", "x_precheck")),
