+def test_hanging_up_or_signalling_twice_still_leaves_no_child_processes(tmp_path, signals):
+    """[代碼審 r2 v2/s1] 關掉終端機(SIGHUP)、收尾中再按一次 Ctrl-C 或再送 SIGTERM:收尾照樣做完,
