+def test_a_trigger_after_a_confirmation_timeout_is_refused_until_the_demo_ends(running, service):
+    """[S1061] 確認逾時之後、自動查核跑完之前:觸發一律拒;確認頁與送出確認說明已逾時。"""
+    service.driver_factory = _factory(gate := Gate())
+    try:
