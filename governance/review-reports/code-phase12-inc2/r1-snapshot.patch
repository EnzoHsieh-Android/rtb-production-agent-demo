+        after = "(這次沒有記錄)" if change.after is None else _budget(change.after)
+        detail = f"預算從 {before} 改成 {after}（平台預算單位）；已寫入廣告平台。"
+    return (
+        '<div class="change-summary"><strong>最後改了什麼</strong>'
