+    operations = _plain_lines(dsp.operations)
+    return (
+        '<div class="table-scroll"><table><thead><tr><th>廣告編號</th>'
+        "<th>預算（元）</th><th>資料版本</th><th>目前狀態</th></tr></thead>"
+        f"<tbody>{rows}</tbody></table></div>{operations}"
+    )
