+    ScenarioRun,
+    StateReader,
+)
+
+MODEL_MODE_REASON = "目前分析端沒有模型入口,這次沒有呼叫模型"
+KNOWN_LIMITS = (
+    "這次只用本機模擬的廣告平台,沒有連到正式平台。",
