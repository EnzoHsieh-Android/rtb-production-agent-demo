+    CurrentStep,
+    Decision,
+    DecisionBasis,
+    DecisionKind,
+    DemoState,
+    Disposition,
+    DspCampaign,
+    DspState,
+    InjectedFault,
+    ModelMode,
+    NodeKind,
+    Scenario,
