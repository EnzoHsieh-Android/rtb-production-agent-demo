     ("metrics", "impressions", 1.5), ("metrics", "clicks", 2 ** 63), ("metrics", "spend", "2.0"),
     ("metrics", "revenue", True),
 ])
 def test_a_malformed_trusted_field_fails_the_whole_fetch(rigged, endpoint, field, value):
