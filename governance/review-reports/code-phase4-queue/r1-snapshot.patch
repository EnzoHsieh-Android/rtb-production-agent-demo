 def _expiry(value: object) -> str:
     """轉進嘗試中必帶:這次送出所帶憑證的到期時間。對帳不再拿它當證明(改用 DSP 端作廢,
     見 Phase 3 計劃增量 4),保留給人工處置時參考。"""
     if not isinstance(value, datetime):
         raise IncompleteRow("轉進嘗試中要帶這次送出所帶憑證的到期時間")
     return _iso(value)
