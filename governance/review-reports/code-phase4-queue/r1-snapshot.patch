     store.accept(proposal, lambda: inbox_store.utc_now().replace(
         year=2026, month=9, day=22, hour=12, minute=5))
 
     assert ("old",) in conn.execute("SELECT task_id FROM proposals").fetchall()
     conn.close()
     store.close()
