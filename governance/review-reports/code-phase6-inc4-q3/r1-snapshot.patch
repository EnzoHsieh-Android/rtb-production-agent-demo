+                              ("u.at < ?", None if until is None else attempt_store.iso(until))):
+            if value is not None:
+                where.append(clause)
+                params.append(value)
+        join = ("" if campaign_id is None else
+                "JOIN write_stops w ON w.task_id = u.task_id AND w.revision = u.revision "
+                "AND w.content_hash = u.content_hash AND w.kind = u.stage")
+        return int(self._conn.execute(
+            f"SELECT count(*) FROM approval_uses u {join} WHERE {' AND '.join(where)}",  # noqa: S608 - 只拼接固定條件
+            params).fetchone()[0])
+
     def stop_count(
         self, tx: attempt_store.ExecutorTransaction, kind: StopKind, *, tenant: str | None = None,
         campaign_id: str | None = None, since: datetime | None = None,
         until: datetime | None = None,
     ) -> int:
         """停下紀錄計數(Phase 6 增量 4 可觀測查詢用);時間範圍包含起點、不包含終點。"""
         self._own(tx)
         sql, params = stop_count_query(kind, tenant=tenant, campaign_id=campaign_id,
                                        since=since, until=until)
         return int(self._conn.execute(sql, params).fetchone()[0])
