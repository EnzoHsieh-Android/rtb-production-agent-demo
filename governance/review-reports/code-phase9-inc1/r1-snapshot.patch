+
+事件表跟收件表同一個交易寫、不隨收件表清除;每一支會寫收件表那一列的方法寫一列(續租除外)。
+"""
+
+import ast
+import sqlite3
+from datetime import timedelta
+from pathlib import Path
+
+import pytest
+
+from rtb import PROGRAM_VERSION
