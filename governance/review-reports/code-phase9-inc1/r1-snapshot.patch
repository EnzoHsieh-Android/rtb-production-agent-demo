 def immediate_transaction(conn: sqlite3.Connection) -> Iterator[None]:
     """寫入交易:進入時 BEGIN IMMEDIATE(鎖不到丟 DatabaseBusy),正常結束就提交,任何例外都回滾。"""
     begin_immediate(conn)
