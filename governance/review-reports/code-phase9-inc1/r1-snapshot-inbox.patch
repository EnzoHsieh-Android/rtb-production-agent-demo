+        issuer = attempt_store._READ_TRANSACTION_ISSUER  # 私有憑證:只給這個唯讀交易入口用
+        tx = attempt_store.ReadTransaction(self._conn, issuer)
+        try:
+            with read_snapshot(self._conn):
+                yield tx
+        finally:
+            tx.close()
