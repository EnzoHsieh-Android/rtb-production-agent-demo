+@pytest.fixture(scope="module")
+def ran(tmp_path_factory):
+    """F1:AI 第 1 輪選查詢、第 2 輪判值得加;F2:沒有錄製,退回程式規則。"""
+    root = tmp_path_factory.mktemp("ai-page")
