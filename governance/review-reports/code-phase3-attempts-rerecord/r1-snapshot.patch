+    before = all_rows(store)
+
+    for target, code in [(A.IN_FLIGHT, None), (A.COMMITTED_UNVERIFIED, None),
+                         (A.FAILED, C.NOT_HAPPENED)]:
+        with pytest.raises(HistoryFull):
+            step(store, key, target, code)
+    with pytest.raises(HistoryFull):
+        timeout(store, key)
+    assert all_rows(store) == before
+
