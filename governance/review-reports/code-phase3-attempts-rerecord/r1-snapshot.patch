+    assert first[:4] == ("t1", 1, "update_budget", 3)
+    assert first[5] == "c1"
+    assert '"evidence_refs"' in first[4] and '"decision_expires_at"' in first[4]
+    with store.transaction() as conn:
+        assert attempt_store.snapshot(conn, row.key) == prop
