+        key = start_in(store, state, campaign_id=f"r-{state.value}")
+        before = all_rows(store)
+        with pytest.raises(IllegalAttemptTransition):
+            _resolve(store, key, outcome, "checked the dsp by hand")
+        assert all_rows(store) == before
