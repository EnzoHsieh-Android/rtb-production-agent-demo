def load_test_profile(repo_root, cfg=None):
    """讀 <repo>/.lumos/config.json 的 test_profile(預設 csharp-xunit;向後相容)。
    支援欄位級 inline 覆蓋(exts/scaffold_ext/method_regex)當逃生口。
    cfg 給了(dict)就不讀磁碟——dispatch-lens v1.2 用 base 版設定(_json_at_ref)呼叫;None=舊路徑。"""
    import json
    prof = dict(TEST_PROFILES["csharp-xunit"])
    if cfg is None:
        cfg_path = Path(repo_root) / ".lumos" / "config.json"
        if not cfg_path.exists():
            return prof
        try:
            cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
        except Exception as e:
            print(f"⚠ .lumos/config.json 解析失敗,用 csharp-xunit 預設: {e}", file=sys.stderr)
            return prof
    if not isinstance(cfg, dict):
        return prof
    name = cfg.get("test_profile") or "csharp-xunit"   # null/空字串 → 預設(F8)
    if name in TEST_PROFILES:
        prof = dict(TEST_PROFILES[name])
    elif name != "csharp-xunit":
        print(f"⚠ 未知 test_profile '{name}'(有: {', '.join(TEST_PROFILES)}),用 csharp-xunit",
              file=sys.stderr)
    ov = cfg.get("test")
    if ov is not None and not isinstance(ov, dict):   # F1:test 非 dict → 忽略不 crash
        print(f"⚠ config.json 的 test 欄位應為物件,忽略(收到 {type(ov).__name__})", file=sys.stderr)
        ov = None
    if isinstance(ov, dict):
        if "exts" in ov:
            raw = ov["exts"]
            raw = [raw] if isinstance(raw, str) else raw   # F1:字串容錯為單元素
            if isinstance(raw, list):
                prof["exts"] = {e if e.startswith(".") else "." + e for e in raw}
            else:
                print("⚠ test.exts 應為陣列,忽略", file=sys.stderr)
        if isinstance(ov.get("scaffold_ext"), str):
            prof["scaffold_ext"] = ov["scaffold_ext"]
        if "method_regex" in ov:
            rx, err = _safe_user_regex(ov["method_regex"])   # F2:編譯 + ReDoS 探針
            if rx is not None:
                prof["method_re"] = rx
            else:
                print(f"⚠ test.method_regex 不採用({err}),沿用 profile 內建", file=sys.stderr)
    return prof


def load_platforms(repo_root, cfg=None):
    """讀 .lumos/config.json 的多根多 profile 設定(多平台合約測試綁定)。
    回 {multiplatform: bool, default_platform: str, platforms: {plat: {profile: dict, root: Path}}}。
    - 無 config / 無 `platforms` 鍵 → legacy:multiplatform False、單一條目(key=test_profile 或
      csharp-xunit、root=repo_root、profile 走 load_test_profile 含 inline 覆蓋)。此 multiplatform
      信號(而非「dict 是否為空」)決定 resolve_test_refs 要不要做前綴切分(審計 r4 + opus 辯方拍板)。
    - 有 `platforms` 鍵 → multiplatform True:每平台 profile 名 → profile dict、
      root=(repo_root/root_str).resolve()(不存在大聲警告、不擋);default_platform 依 D1 規則。
    設定錯誤(缺 default_platform 且平台 >1 / default 指向不存在鍵 / profile 名未知)→ raise ValueError。"""
    import json
    cfg_path = Path(repo_root) / ".lumos" / "config.json"
    _given = cfg
    cfg = _given if isinstance(_given, dict) else {}
    if _given is None and cfg_path.exists():
        try:
            cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
        except Exception as e:
            print(f"提醒:.lumos/config.json 讀不了({e}),先用預設的單一設定跑", file=sys.stderr)
            cfg = {}
    plats = cfg.get("platforms")
    if not isinstance(plats, dict) or not plats:
        # legacy:單一條目(root=repo_root,profile 沿用 load_test_profile 的 inline 覆蓋支援)
        name = cfg.get("test_profile") or "csharp-xunit"
        if name not in TEST_PROFILES:
            name = "csharp-xunit"
        _tcfg = cfg.get("test") if isinstance(cfg.get("test"), dict) else {}
        return {"multiplatform": False, "default_platform": name,
                "platforms": {name: {"profile": load_test_profile(repo_root, cfg=_given if isinstance(_given, dict) else None), "root": repo_root,
                                     # ★profile 名要留著★(2026-09-09 [F] 折入):"profile" 存的是攤開的 profile dict,
                                     # 「這個平台用的是哪一支測試工具」的名字原本在這裡被丟掉,而合約測試閘要拿它
                                     # 去查該工具「跑過的證據」長什麼樣。多平台分支同樣補一份。
                                     "profile_name": name,
                                     "run_cmd": _tcfg.get("run_cmd")}}}
    out = {}
    for plat, spec in plats.items():
        if not isinstance(spec, dict):
            raise ValueError(f"設定檔 platforms['{plat}'] 要是一個物件,現在是 {type(spec).__name__}")
        pname = spec.get("profile")
        if pname not in TEST_PROFILES:
            raise ValueError(f"設定檔 platforms['{plat}'].profile 填了 '{pname}',工具不認得(可用: {', '.join(TEST_PROFILES)})")
        root_str = spec.get("root", ".")
        root = (repo_root / root_str).resolve()   # 明寫基底 repo_root(非 cwd),見 D1
        if not root.exists():
            print(f"⚠ 平台 '{plat}' 的 root 不存在: {root}(該平台 discover 將掃不到測試)", file=sys.stderr)
        out[plat] = {"profile": dict(TEST_PROFILES[pname]), "root": root, "profile_name": pname,
                     "run_cmd": spec.get("run_cmd")}   # guard kill 用;缺=None
    default = cfg.get("default_platform")
    if default is None:
        if len(out) == 1:
            default = next(iter(out))
        else:
            raise ValueError(f"設定了 {len(out)} 個平台,但沒說預設是哪個(default_platform)"
                             f"(無前綴 [test:X] 不知歸屬);請加 default_platform")
    elif default not in out:
        raise ValueError(f"預設平台 '{default}' 不在平台清單裡(有的是: {', '.join(out)})")
    return {"multiplatform": True, "default_platform": default, "platforms": out}


def _safe_user_regex(pattern):
    """編譯使用者提供的 regex,並用【靜態】啟發式擋常見巢狀量詞 ReDoS。
    關鍵:**絕不執行**該 regex 來探測 — 在 CPython 裡 catastrophic regex 持有 GIL,
    用 thread/probe 探測反而會把整個 process 卡死(GIL 餓死主執行緒)。故只做模式檢查。
    非窮舉(擋不到 alternation 型),擋得到 (a+)+ / (a*)+ / (a+)* 這類經典款。
    回傳 (compiled, None) 或 (None, 原因)。"""
    if not isinstance(pattern, str):
        return None, "非字串"
    # 巢狀量詞:帶量詞的群組整體又被量詞修飾(經典 catastrophic backtracking)
    if re.search(r"\([^()]*[+*][^()]*\)\s*[+*?]", pattern) or \
       re.search(r"\([^()]*\)\s*[+*]\s*[+*]", pattern):
        return None, "疑似巢狀量詞 ReDoS(如 (a+)+);請改寫或用 profile 內建"
    try:
        return re.compile(pattern, re.S), None
    except re.error as e:
        return None, f"無效: {e}"


def invariant_test_refs(inv_text):
    """從 ★INVARIANT★ 文字抽 [test:A,B] 綁定的可執行測試名(可多個,逗號分隔)。無綁定回 []。
    回**原始字串**(含任何 平台: 前綴)——供 tag 重建/顯示;平台解析走 resolve_test_refs。"""
    out = []
    for m in TEST_REF_RE.findall(inv_text):
        out.extend(t.strip() for t in m.split(",") if t.strip())
    return out


def resolve_test_refs(inv_text, platforms, default_platform):
    """把 [test:...] 解析為 [(platform, method_name)]。沿用 invariant_test_refs 的逗號切分。
    - platforms 非空(多平台):每段含 ':' → 前綴須為已定義 platform 鍵(C#/Kotlin 名不含冒號,
      故含冒號即視為 平台:名;前綴未定義 → raise ValueError,不誤當方法名);無 ':' → 歸 default_platform。
    - platforms 空(legacy,由呼叫端在 multiplatform=False 時傳 {}):**不切分**,整串(含任何冒號)
      配 default_platform → 後續走單一 method set 比對(含冒號的假想 ref 走 dangling 而非報錯)。"""
    out = []
    for seg in invariant_test_refs(inv_text):
        if platforms and ":" in seg:
            plat, name = seg.split(":", 1)
            plat, name = plat.strip(), name.strip()
            if plat not in platforms:
                raise ValueError(
                    f"[test:{seg}] 的平台前綴 '{plat}' 未定義於 platforms"
                    f"({', '.join(platforms)});不猜,免得綁錯平台")
            out.append((plat, name))
        else:
            out.append((default_platform, seg))
    return out


def invariant_audit_refs(inv_text):
    """從 ★INVARIANT★ 文字抽 [audit:模型/日期] 留痕(通常一條)。無=回 []。"""
    return [m.strip() for m in AUDIT_REF_RE.findall(inv_text) if m.strip()]


def strip_test_refs(inv_text):
    """回傳 (去掉 [test:..]/[audit:..] 標記的乾淨宣稱文字, 綁定測試名 list)。"""
    return INV_TAG_RE.sub("", inv_text).strip(), invariant_test_refs(inv_text)


# ── 可逆性軸(獨立於 ★INVARIANT★ 合約軸;走平行函式,不碰 extract_contracts/INV_TAG_RE)──
CHECKPOINT_RE = re.compile(r"^KEY:\s*(?:\([^)]*\)\s*)?★CHECKPOINT★\s*(.*)")
IRREVERSIBLE_RE = re.compile(r"^KEY:\s*(?:\([^)]*\)\s*)?★IRREVERSIBLE★\s*(.*)")
ROLLBACK_REF_RE = re.compile(r"\[rollback:\s*([^\]]+)\]")
GUARD_REF_RE = re.compile(r"\[guard:\s*([^\]]+)\]")  # 可逆性軸,平行於 ROLLBACK_REF_RE

# ── regen 重生來源軸(M1 from-scratch 守衛;Check J,獨立於合約軸/可逆性軸)──
# 設計:Projects/from-scratch重生守衛_計劃(design-loop 3 輪,golden: governance/golden/fromscratch-m1)。
# [src:路徑(:行號)]=Tier A 現 code 可驗;[git:sha]=Tier B 變更事件;推測:/佚失: 前綴=Tier C/佚失。
SRC_REF_RE = re.compile(r"\[src:\s*([^\]]+?)(?::(\d+(?:-\d+)?))?\s*\]")
GIT_REF_RE = re.compile(r"\[git:\s*([0-9a-fA-F]{7,40})\s*\]")
# 疊放釘死:緊跟 summary 前綴(KEY:推測:/DECISION:佚失:);行中出現不算標記(防歧義)。只掃 summary。
REGEN_PREFIX_RE = re.compile(r"^(?:KEY|DECISION):\s*(推測|佚失):")


def reversibility_rollback_ref(text):
    m = ROLLBACK_REF_RE.search(text)
    return m.group(1).strip() if m else None


def reversibility_guard_ref(text):
    m = GUARD_REF_RE.search(text)
    return m.group(1).strip() if m else None


IRREVERSIBLE_HINT_PATTERNS = [
    re.compile(r"\bprod[._\-/]|production\b", re.I),
    re.compile(r"smtplib|sendmail|send_mail\b|\.send_message\b", re.I),
    re.compile(r"requests\.post\b|httpx\.post\b", re.I),
    re.compile(r"boto3\.(client|resource)\s*\(", re.I),
    re.compile(r"\bstripe\.\b|\btwilio\.\b|\bsendgrid\.\b", re.I),
    re.compile(r"\bDROP\s+TABLE\b|\bDELETE\s+FROM\b", re.I),
    re.compile(r"external_api\b|ext_api\b", re.I),
]


def _scan_diff_for_irreversible_hints(cwd):
    """掃 git diff --staged(優先)或 HEAD~1..HEAD,回傳疑似不可逆 +行摘要列表。
    非 git repo 或無 diff → 回傳 []。跳過測試檔與純注解行。
    cwd=str(env.vault) 即可:git diff 無 pathspec 時範圍為全 repo,cwd 子目錄不縮小範圍。"""
    import subprocess  # lazy import,與 L339/L2298 等先例一致
    _SKIP_EXT = {".md", ".txt", ".rst"}
    _TEST_PAT = re.compile(r"(test_|_test\.|\.spec\.|/tests?/)", re.I)

    # ★取差異內容的呼叫一律關掉外部驅動器★(2026-09-18 代碼審 r3 資安終審,單源
    # [[Projects/收工點名問版本控制_計劃]]):被打開的資料夾可以放一份未提交、未追蹤的屬性檔,
    # 把某支檔指到一個★攻擊者自己命名★的差異驅動器,再用那個名字設定要執行的指令。
    # 鍵名是他取的,所以「列舉危險設定」原理上擋不住——三輪三種修法都被打穿。
    # 這兩個旗標關掉的是整類機制,不管設定裡寫什麼名字。
    # ★範圍靠實測畫★:只取檔名/統計/狀態的呼叫不觸發,所以那些不強制帶;取內容的才要。
    # t_lumos_content_diffs_all_disable_external_drivers 會掃全檔釘住這條性質。
    for cmd in (["git", "diff", "--no-ext-diff", "--no-textconv", "--staged"],
                ["git", "diff", "--no-ext-diff", "--no-textconv", "HEAD~1..HEAD"]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, errors="replace", cwd=cwd)
        except FileNotFoundError:
            return []
        if r.returncode != 0 or not r.stdout.strip():
            continue
        diff_text = r.stdout
        break
    else:
        return []

    cur_file = ""
    hits = []
    for line in diff_text.splitlines():
        if line.startswith("+++ b/"):
            cur_file = line[6:]
        if line.startswith("+++") or line.startswith("---"):
            continue
        if not line.startswith("+"):
            continue
        ext = Path(cur_file).suffix if cur_file else ""
        if ext in _SKIP_EXT:
            continue
        if cur_file and _TEST_PAT.search(cur_file):
            continue
        code_line = line[1:].strip()
        if code_line.startswith(("#", "//", "--", "/*", "*")):
            continue
        for pat in IRREVERSIBLE_HINT_PATTERNS:
            if pat.search(code_line):
                hits.append(f"{Path(cur_file).name}: {code_line[:80]}")
                break
    return hits[:8]


def extract_reversibility(note):
    """從 summary KEY 行抽 (marker, 去 [rollback:]/[guard:] 的乾淨文字, rollback_ref, guard_ref)。"""
    summ = note.fields.get("summary")
    out = []
    if isinstance(summ, str):
        for raw in summ.split("\n"):
            line = raw.strip()
            for marker, rx in (("★CHECKPOINT★", CHECKPOINT_RE), ("★IRREVERSIBLE★", IRREVERSIBLE_RE)):
                m = rx.match(line)
                if m:
                    body = m.group(1)
                    clean_body = ROLLBACK_REF_RE.sub("", GUARD_REF_RE.sub("", body)).strip()
                    out.append((marker, clean_body,
                                reversibility_rollback_ref(body), reversibility_guard_ref(body)))
    return out


def _rollback_resolved(note, ref):
    """[rollback:decisions] 視為已解析 ⟺ 本節點 decisions[] 有 ≥1 條非空 rollback。"""
    if not ref or ref.strip().lower() != "decisions":
        return False
    return any(str(d.get("rollback", "")).strip() for d in parse_decisions(note.fm_lines))


def _guard_resolved(note, ref):
    """[guard:decisions] 視為已解析 ⟺ 本節點 decisions[] 有 ≥1 條非空 guard。"""
    if not ref or ref.strip().lower() != "decisions":
        return False
    return any(str(d.get("guard", "")).strip() for d in parse_decisions(note.fm_lines))


def build_code_haystack(repo_root):
    """讀 repo 內所有 code 檔串成大字串,供 ★INVARIANT★ 綁定的測試名做存在性檢查。
    (閉環外接觸:doctor 不執行測試,只驗證『載重宣稱認領的證據真的存在於程式碼』)"""
    import os
    parts = []
    for dp, dirs, files in os.walk(repo_root):
        dirs[:] = [d for d in dirs if d not in CODE_SKIP_DIRS]
        for f in files:
            if Path(f).suffix.lower() in CODE_EXTS_T:
                try:
                    parts.append((Path(dp) / f).read_text(encoding="utf-8", errors="ignore"))
                except Exception:
                    pass
    return "\n".join(parts)


def discover_test_methods(repo_root, profile=None):
    """掃 repo 內測試檔,回傳「真實測試方法名」集合(被測試框架註解標註者)。
    測試棧 profile 決定掃哪些副檔名 + 用哪條方法 regex(預設 csharp-xunit;P5 語言可插拔)。
    Check T 用此集合驗證 ★INVARIANT★ 綁定的是『可執行證據』而非散文裡的字面巧合(B6 審計)。"""
    import os, fnmatch
    profile = profile or load_test_profile(repo_root)
    exts, mre = profile["exts"], profile["method_re"]
    must = profile.get("file_must_match")   # 選填:只認內容含此 marker 的檔(如 Maestro ^appId:)
    fname_globs = profile.get("file_name_match")   # 選填:basename fnmatch 檔名錨(python:test_*.py)
    strip = profile.get("comment_strip", "c-style")  # 預設 c-style 向後相容;python="none"
    methods = set()
    for dp, dirs, files in os.walk(repo_root):
        dirs[:] = [d for d in dirs if d not in CODE_SKIP_DIRS]
        for f in files:
            if Path(f).suffix.lower() in exts:
                # 檔名錨:ext 檢查後、讀檔前套(CheckT-Python-profile_計劃 std F4)
                if fname_globs and not any(fnmatch.fnmatch(f, g) for g in fname_globs):
                    continue
                try:
                    txt = (Path(dp) / f).read_text(encoding="utf-8", errors="ignore")
                except Exception:
                    continue
                # file_must_match:讀檔後、去註解前先過濾(如 .yaml 一堆,只認真 Maestro flow;
                # 濾掉 CI yaml 的 name: 被誤收)。現有 profile 無此鍵→.get() 回 None→不過濾。
                if must is not None and not must.search(txt):
                    continue
                # 去註解(語言感知,2026-07-25 根因修):c-style 剝 // 與 /*..*/(行尾註解會打斷
                # 「註解串→方法簽章」連續比對,真測試被誤判偽證據)。★python 走 "none" 不剝★——
                # Python 無 C 式註解,剝了反被中文註解/字串字面裡的 /*..*/ 配對誤吃大段內容
                # (實測 test_lumos.py 260→94);被註解的 # def 不在行首,PYTHON_TEST_RE 行首錨排除。
                if strip in ("c-style", "c-style+strings"):
                    txt = re.sub(r"//[^\n]*", "", txt)
                    txt = re.sub(r"/\*.*?\*/", "", txt, flags=re.S)
                # ★"c-style+strings" 多剝字串字面★(2026-09-12 Java 補棧代碼審 r1):字串內容清空但保留
                # 引號本身,所以「字串裡剛好寫著方法簽章」不會被當成真的測試方法。單行內比對(不跨換行),
                # 跨行的 Java text block 不在此列——那是已知邊界,寫在 JAVA_TEST_RE 的註解裡。
                if strip == "c-style+strings":
                    txt = re.sub(r'"(?:\\.|[^"\\\n])*"', '""', txt)
                    txt = re.sub(r"'(?:\\.|[^'\\\n])*'", "''", txt)
                for m in mre.finditer(txt):
                    methods.add(m.group(1).strip("`"))  # Kotlin 反引號測試名去引號
    return methods


def cmd_contracts(env, rel=None):
    """合約登記簿: ★INVARIANT★(改=breaking) / ★DEBT★(可改)。
    動某模組前先查它的硬合約 — Obsidian 做不到(子字串不在它的 graph 裡)。
    ★INVARIANT★ 顯示綁定的測試(可執行證據);未綁=⚠(doctor Check T 會擋)。"""
    targets = [rel] if rel else sorted(env.notes)
    n_inv = n_debt = 0
    for r in targets:
        inv, debt = extract_contracts(env.notes[r])
        if not inv and not debt:
            continue
        print(f"# {r}")
        for x in inv:
            clean, refs = strip_test_refs(x)
            print(f"  ★INVARIANT★ {clean}")
            print(f"      ↳ 綁的測試: {', '.join(refs)}" if refs else "      ↳ 提醒:沒綁測試,沒有可執行的證據")
            n_inv += 1
        for x in debt:
            print(f"  ★DEBT★ {x}")
            n_debt += 1
    if n_inv == 0 and n_debt == 0:
        print("(這篇沒有登記任何「動了會壞」的合約)" if rel else "(整個圖譜都沒有登記合約——要標的話在 KEY 行前面加 ★INVARIANT★ 或 ★DEBT★)")
    else:
        print(f"\n合約 {n_inv} 條(改了就是破壞性變更) | 技術債 {n_debt} 條(可以改)")
    return 0


KNOWN_TYPES = {"system", "verification", "issue", "project", "moc"}
# SYMBOL_NAMES 的定義已上移到 SYMBOL_RE 旁(單一來源,見那裡的說明)。
# ★2026-09-15 放寬:認得連字號★——原本 ^([A-Z]{2,}): 只吃連續大寫,
# 含連字號的前綴整行躲過檢查(打成 PRIOR-ARTT: 也沒人唸)。
SYMBOLISH_RE = re.compile(r"^([A-Z][A-Z-]*[A-Z]):")   # 像「符號宣告」的行→ 抓 typo


def _git_commit_exists(repo_root, sha):
    """[git:sha] Tier B 驗證:git cat-file -e sha^{commit}。非 git repo/物件缺 → False。"""
    import subprocess
    try:
        r = subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"], cwd=str(repo_root),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return r.returncode == 0
    except OSError:
        return False


def _git_is_shallow(repo_root):
    import subprocess
    try:
        r = subprocess.run(["git", "rev-parse", "--is-shallow-repository"], cwd=str(repo_root),
                           capture_output=True, text=True, errors="replace")
        return r.returncode == 0 and r.stdout.strip() == "true"
    except OSError:
        return False


def check_regen_provenance(note, repo_root):
    """Check J(regen 重生來源守衛)共用檢查器——cmd_lint 與 run_doctor 同呼叫同一函式(防兩入口
    規則漂移)。只對 frontmatter 帶 regen 的節點生效;非 regen 節點回三空。只掃 summary 行。
    回 (errs, warns, gov_events),兩入口映射(spec 映射表,照抄不猜):
      errs → lint errs 計 rc1 / doctor warn(hard) 計 issues
      warns → lint 顯示不計 rc / doctor warn_soft(J-d 提醒與 shallow 降級兩入口皆非阻擋)
      gov_events → 僅 doctor --ci 落 _append_governance_log;lint 高頻一律不落帳(防治理帳灌水)
    註:本函式為 regen 節點對 lint「node-local 不掃 repo」原則的 opt-in 例外(檔案+git 存取)。
    設計:Projects/from-scratch重生守衛_計劃;golden: governance/golden/fromscratch-m1。"""
    errs, warns, gov = [], [], []
    regen = note.fields.get("regen")
    if not (isinstance(regen, str) and regen.strip()):
        return errs, warns, gov
    summ = note.fields.get("summary")
    summ = summ if isinstance(summ, str) else ""
    shallow = None  # 惰性判定(每節點至多一次 rev-parse)
    untagged_keys = 0
    has_git_ptr = "[git:" in summ  # presence-guard:整節點無 [git: 子串即不 spawn
    for raw in summ.split("\n"):
        line = raw.strip()
        if not line:
            continue
        has_src = SRC_REF_RE.search(line)
        has_git = GIT_REF_RE.search(line)
        prefix_m = REGEN_PREFIX_RE.match(line)
        # 不對稱接線:推測/佚失 不得承載合約/不可逆(raw 行獨立偵測——INVARIANT_RE 對此形態
        # 整行不 match,靠它=該行對 Check T/contracts 隱形,比擋下更毒;四組合皆觸發)
        if prefix_m and ("★INVARIANT★" in line or "★IRREVERSIBLE★" in line):
            errs.append(f"『{prefix_m.group(1)}:』行不得承載 ★INVARIANT★/★IRREVERSIBLE★"
                        f"(合約不能建在推測上;補 [src:]/[git:] 或走 signoff 升級):{line[:48]}")
            continue
        # J-a:regen ★INVARIANT★ 需 [src:]/[git:] 意圖證據(與 Check T 的 [test:] 疊加——
        # [test:] 只證行為現在成立,不證意圖是合約;拒絕發明合約)
        if INVARIANT_RE.match(line) and not (has_src or has_git):
            errs.append(f"regen 節點的 ★INVARIANT★ 缺 [src:]/[git:] 意圖證據"
                        f"(J-a 拒絕發明合約):{line[:48]}")
        # J-b:DECISION 行需證據指針或顯式標 推測:/佚失:(重建的 why 必須標來源或標推測)
        if line.startswith("DECISION:") and not (has_src or has_git or prefix_m):
            errs.append(f"regen 節點的 DECISION 行無證據指針且未標 推測:/佚失:(J-b):{line[:48]}")
        # J-d:無 tier 標記的 KEY 行計數(唯讀提醒,不寫回任何欄位)
        if line.startswith("KEY:") and not (has_src or has_git or prefix_m):
            untagged_keys += 1
        # J-c:[src:] substring gate(直走 _validate_repo_ref,不經 top_dirs 靜默過濾)
        for m in SRC_REF_RE.finditer(line):
            path, lno = m.group(1).strip(), (m.group(2) or "")
            status, _ = _validate_repo_ref(repo_root, path, lno)
            if status == "missing":
                errs.append(f"[src:{path}] 目標不存在(J-c dangling=幻覺證據)")
            elif status == "line_out_of_range":
                errs.append(f"[src:{path}:{lno}] 行號越界(J-c)")
        # J-c:[git:sha](presence-guard 後才 spawn;shallow 降級=顯性+僅 doctor --ci 留痕,不得靜默)
        if has_git_ptr:
            for m in GIT_REF_RE.finditer(line):
                sha = m.group(1)
                if _git_commit_exists(repo_root, sha):
                    continue
                if shallow is None:
                    shallow = _git_is_shallow(repo_root)
                if shallow:
                    warns.append(f"[git:{sha[:12]}] Tier B 驗證跳過(shallow clone,本地無該物件;"
                                 f"非擋——full clone 下會重驗)")
                    gov.append({"gate": "check-j", "kind": "shallow-skip", "hard": False,
                                "nodes": [note.stem]})
                else:
                    errs.append(f"[git:{sha[:12]}] commit 不存在(J-c dangling=幻覺證據)")
    if untagged_keys:
        warns.append(f"{untagged_keys} 條 KEY 行無 tier 標記([src:]/[git:]/推測:/佚失:)"
                     f"——J-d 提醒:prose 級誠實機械驗不了,建議補標或過對抗審")
    return errs, warns, gov


def cmd_drift_history(env, every=60, limit=0, as_json=False):
    """★讓每份圖譜自己量規律,而不是相信別人在別份圖譜上的結論★(Enzo 2026-08-12 裁定)。

    沿 git 歷史取樣重放 Check Y 的核心邏輯:每個取樣點用 `git grep` 對當時的 code
    比對當時圖譜提到的符號,輸出「幽靈符號」時間序列。不需 checkout、不動工作區。

    為什麼需要它:本工具的三道守衛(U/N/Y)有兩道靠形狀/詞表啟發式,★換一份圖譜或語言棧
    可能靜默失效★。與其宣稱通用,不如給每個專案一把尺自己量:
      - 曲線一直是 0 → 這個專案沒有這型 drift(或形狀規則沒對上 → 先調 symbol_profile)
      - 曲線長期非 0 且同一批符號反覆出現 → ★規律成立,值得開檢查★
    LandmarkMember 首跑實測:GetOrdersForRedeemAsync / ListAvailableAsync 兩條
    ★橫跨 77 天、11 個取樣點都在★,期間圖譜從 21 篇長到 30 篇也沒被修掉。

    ★方法論警示(踩過)★:首版取樣腳本因 git 對非 ASCII 檔名加引號跳脫,`.md` 尾綴比對
    把 25/30 個節點濾掉,結論從「2% 持續三個月」變成「0% 完全沒問題」。故本實作固定
    帶 `-c core.quotePath=off`——★表面形狀的假設沒說清楚,會錯得無聲無息★。"""
    import json as _json, subprocess as _sp, tempfile as _tf, os as _os
    repo_root = None
    for _p in env.vault.parents:      # 同 doctor Check C 的推導:docs/ 的上一層即 repo root
        if _p.name == "docs":
            repo_root = _p.parent
            break
    if repo_root is None:
        print("擋下:這項要專案同時有程式碼和 docs/<名稱>-knowledge 圖譜才能對照,這裡沒有這種佈局", file=sys.stderr)
        return 2
    prof, neg = load_symbol_profile(repo_root)
    sym_re = re.compile(prof["shape_re"])
    ext_re = re.compile(r"\.(aspx|html|cs|js|vue|sql|ps1|yml|json|md|kt|py)$", re.I)
    sufs, dot_ok = tuple(prof.get("suffixes") or ()), prof.get("dotted_ok", True)
    code_globs = ["*" + e for e in prof.get("code_exts", (".cs",))]

    def _shaped(s):
        if "/" in s or " " in s or ext_re.search(s):
            return False
        if any(c.isdigit() for c in s) or s.isupper():
            return False
        if not sym_re.match(s):
            return False
        if sufs and any(s.endswith(x) for x in sufs):
            return True
        return dot_ok and "." in s

    def _git(*a):
        return _sp.run(["git", "-c", "core.quotePath=off", *a], cwd=repo_root,
                       capture_output=True, text=True, errors="replace").stdout

    vault_rel = _os.path.relpath(env.vault, repo_root).replace(_os.sep, "/")
    sys_rel = f"{vault_rel}/Systems"
    # ★不可只取「動過圖譜的 commit」★(2026-08-12 被自己的測試打出來的設計缺陷):
    # drift 的誕生機制正是「只改 code、沒改圖譜」的 commit——若只在圖譜 commit 取樣,
    # 就系統性錯過 drift 出生的那一刻,只有等下一次剛好有人動圖譜才看得到。
    # 這個盲點跟它要量的問題是同一個形狀,測試翻紅才發現。故改成掃全部 commit,
    # 圖譜還不存在的取樣點由下方 ls-tree 空清單自然略過。
    log = _git("log", "--format=%H %ad", "--date=short", "--reverse").splitlines()
    if not log:
        print("(圖譜在 git 歷史中沒有紀錄,無法重放)")
        return 0
    picks = [l.split() for i, l in enumerate(log) if i % max(1, every) == 0]
    if limit:
        picks = picks[-limit:]
    rows = []
    for sha, date in picks:
        files = [f for f in _git("ls-tree", "-r", "--name-only", sha, sys_rel).splitlines()
                 if f.endswith(".md")]
        if not files:
            continue
        cands = set()
        for f in files:
            for ln in _git("show", f"{sha}:{f}").splitlines():
                if any(k in ln for k in neg):
                    continue
                for m in INLINE_CODE_RE.finditer(ln):
                    s = m.group(0).strip("`").strip()
                    if _shaped(s):
                        cands.add(s)
        ghosts = []
        if cands:
            tfh = _tf.NamedTemporaryFile("w", suffix=".txt", delete=False, encoding="utf-8")
            tfh.write("\n".join(sorted({c.split(".")[-1] for c in cands})) + "\n")
            tfh.close()
            out = _git("grep", "-F", "-h", "-f", tfh.name, sha, "--", *code_globs)
            _os.unlink(tfh.name)
            ghosts = sorted(c for c in cands if c.split(".")[-1] not in out)
        rows.append({"sha": sha[:9], "date": date, "notes": len(files),
                     "candidates": len(cands), "ghosts": ghosts})
    if as_json:
        print(_json.dumps(rows, ensure_ascii=False))
        return 0
    if not rows:
        print("(取樣點都沒有 Systems 節點)")
        return 0
    print(f"drift-history — {len(rows)} 個取樣點(每 {every} 個圖譜 commit 取 1)"
          f"｜symbol_profile 命中形狀={prof['shape_re']}")
    print(f"{'commit':10} {'date':11} {'節點':>4} {'候選':>5} {'幽靈':>5}  持續中的幽靈符號")
    for r in rows:
        print(f"{r['sha']:10} {r['date']:11} {r['notes']:4} {r['candidates']:5} "
              f"{len(r['ghosts']):5}  {', '.join(r['ghosts'][:4])}")
    persist = set(rows[0]["ghosts"])
    for r in rows[1:]:
        persist &= set(r["ghosts"])
    print()
    if persist:
        print(f"在全部 {len(rows)} 個取樣點都出現的幽靈符號(筆記點名但程式碼裡沒有):{', '.join(sorted(persist))}")
        print("  → 規律成立:這不是偶發,是穩態。這型 drift 值得開機械檢查(見 Check Y)。")
    elif any(r["ghosts"] for r in rows):
        print("幽靈符號有出現但非持續 → 有人在修,但沒有機制擋住它再發生。")
    else:
        print("所有取樣點都 0 幽靈 → 這個專案沒有這型 drift,"
              "或者是符號比對規則沒對上你的語言(先確認候選數不是 0)。")
    return 0


_KNOWN_FRONTMATTER_KEYS = (
    "type", "status", "tags", "summary", "created", "updated", "related", "aliases",
    "valid_under", "revalidate_when", "plan_refs", "date", "decisions", "verified_by",
    "about_code", "about_code_stamp", "self_audit", "feature", "commit",
    "decision_refs", "decision_refs_ai", "pitfall_when", "pitfall_ask", "pitfall_source",
    "signed_off", "kill_recipes", "core_refs", "regen",
    "responsibility", "lands_in",   # 2026-09-11 每支檔有家:Systems 的負責範圍、計劃的落點
    "plan_risk", "door",   # 2026-09-17 計劃風險(作者只能往嚴標 high);door 是舊寫法,讀得懂但提醒改
)
# ↑ 2026-09-06 全 repo 審視 #16。★代碼審 r1 訂正★:初版清單來源是「掃本 vault 428 篇出現過的鍵」,
#   結果漏掉 core_refs(跨專案升格參照,doctor Check C 與 impact 跨 repo 展開都在讀)與 regen(重建溯源在讀)
#   ——這兩個欄位工具確實會讀,只是本 vault 目前沒節點寫,於是掃不到、被誤報成「不認得」。
#   正解是問工具認得哪些,不是問這個 vault 長怎樣:下面 cmd_lint 另在執行期併入 LIST_KEYS/LINK_KEYS,
#   那兩份常數再新增欄位時這裡不必跟著改。
#   ★這是軟提醒不是白名單硬擋★——別的 vault 有自己的欄位(consumer 專案、core-knowledge 的
#   project/implements/domain 等),所以留 .lumos/config.json 的 extra_frontmatter_keys 可擴充。


def _lumos_config_near_vault(env):
    """從 vault 往上找 .lumos/config.json 讀成 dict;找不到、讀不了、不是物件都回 {}(lint 側的擴充口
    一律 fail-open)。extra_frontmatter_keys 與 scope 值域兩個宣告共用這一支,免得兩套搜尋規則各漂各的。"""
    import json
    try:
        # ★r1 代碼審折入★:原本寫死「vault 往上兩層」,vault 巢得更深(monorepo 的
        # repo/subdir/docs/x-knowledge)就算到 repo/subdir/.lumos,擴充口悄悄失效且不報錯。
        # 改成從 vault 往上找設定檔本身;走到版控根就停(找不到 .git 時最多五層),
        # 免得爬到家目錄撿到別的專案的設定。
        base = Path(env.vault).resolve()
        cfg = None
        for hop, cand in enumerate((base, *base.parents)):
            probe = cand / ".lumos" / "config.json"
            if probe.is_file():
                cfg = probe
                break
            if (cand / ".git").exists() or hop >= 5:
                break
        if cfg is not None:
            data = json.loads(cfg.read_text(encoding="utf-8"))
            return data if isinstance(data, dict) else {}
    except Exception:
        pass
    return {}


def _extra_fm_keys(env):
    """讀 .lumos/config.json 的 extra_frontmatter_keys(消費專案自己的合法欄位)。讀不到就空。"""
    v = _lumos_config_near_vault(env).get("extra_frontmatter_keys")
    return [x for x in v if isinstance(x, str)] if isinstance(v, list) else []


def _scope_policy(env):
    """讀 .lumos/config.json 的 scope 區塊 {"values": [...], "required": bool}。

    [工具分類 2026-09-08,plan:Projects/工具分類_計劃] scope/ 標籤家族的值域由專案自己宣告——
    工具鏈自己用九個研究方向值、消費專案用業務域切片,兩邊語意不同,所以不能在程式裡寫死一張表。
    沒宣告(絕大多數消費專案)回 None,lint 對 scope 一個字都不說,行為與 2026-08-05 收編定版時相同。"""
    sc = _lumos_config_near_vault(env).get("scope")
    if not isinstance(sc, dict):
        return None
    vals = sc.get("values")
    if not isinstance(vals, list):
        return None
    return {"values": {x for x in vals if isinstance(x, str)}, "required": bool(sc.get("required", True))}


def _levenshtein_le1(a, b):
    """只判「編輯距離 ≤1」(打錯一個字的近名候選)——不做完整距離計算,夠用且便宜。"""
    if a == b:
        return False
    la, lb = len(a), len(b)
    if abs(la - lb) > 1:
        return False
    if la == lb:
        return sum(1 for x, y in zip(a, b) if x != y) == 1
    short, long_ = (a, b) if la < lb else (b, a)
    for i in range(len(long_)):
        if long_[:i] + long_[i + 1:] == short:
            return True
    return False


def cmd_lint(env, node):
    """單檔快檢:寫完一個節點立刻自驗標籤/格式(node-local,不掃 repo → 比 doctor 快;
    例外:regen 節點的 Check J 需檔案+git 存取,opt-in、量小)。
    抓「寫入當下」最常見的錯:type/summary 缺漏、★ 標記格式錯(漏被 contracts 抓)、
    裸合約 / 未審、symbol 行 typo、frontmatter 指紋(ghost trap…)。
    與 doctor 分工:doctor 是全圖權威(跨節點完整性 + [test:] 存在性),lint 只看這一篇、
    predicts pre-push 會不會擋(error 即 doctor --ci 會擋的同類)。"""
    rel = env.find(node)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {node} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return 2
    n = env.notes[rel]
    errs = list(n.lint)          # frontmatter 指紋(ghost trap / 重複鍵 / 日期引號…)= error
    warns = []

    # ★驗證紀錄的兩個條件欄空著要出聲★(2026-09-16;Issues/lint不守驗證紀錄空回頭條件,
    # 2026-09-01 Enzo 委任裁辦)。出身:某天五篇驗證★全★把回頭條件寫進正文、欄位留空,
    # 於是掃描工具全掃不到、lint 全綠放行——鐵則四「承認風險要附回頭看的條件」被靜默架空
    # 而沒有任何機械提醒,是審查席讀出來的、不是工具抓到的。
    # ★只提醒不擋★:舊帳很多(上線當天光是排序那一篇就掛著五份空條件的驗證),擋了等於
    # 每個提交都紅;提醒的作用是讓寫的人當下看到,不是回頭清舊帳。
    # ★只對 pass 的驗證紀錄★:其他型別沒有這兩個欄位;stale/fail 本來就還在處理中,不必催。
    if n.fields.get("type") == "verification" and n.fields.get("status") == "pass":
        for _f, _what in (("valid_under", "這個結論在什麼前提下才算數"),
                          ("revalidate_when", "改到什麼時候該回頭重驗")):
            # ★用掃描端同一支 helper 判空★(2026-09-16 代碼審 r1 外家席):直接轉字串的話,
            # 一個裝著兩個空白字串的清單會變成有括號有引號的非空字串、被判成「有寫」,
            # 但掃描端逐項去空白之後拿到的是零條——兩邊口徑不一樣就等於這道提醒有洞。
            if not _conds(n.fields.get(_f)):
                warns.append(f"{_f} 是空的——沒寫「{_what}」,"
                             f"掃描工具就永遠掃不到這篇,這個結論會一直被當成還有效")

    # ★開頭欄位鍵打錯會被所有檢查靜默略過★(2026-09-06 全 repo 審視 #16):
    # 打成 valid_unde / verifed_by,lint 一句話都不說、doctor 也看不到,那個欄位等於沒寫。
    # ★只給軟提醒不升 error★:工具對未知欄位的立場是「前向相容、容忍」(消費專案與
    # core-knowledge 各有自己的欄位),升成 error 會讓別人的 vault 每次 lint 都被嘮叨。
    # 清單可用 .lumos/config.json 的 extra_frontmatter_keys 擴充。
    _known = set(_KNOWN_FRONTMATTER_KEYS) | set(LIST_KEYS) | set(LINK_KEYS) | set(_extra_fm_keys(env))
    _unknown = [k for k in n.fields.keys() if k not in _known]
    for _k in _unknown:
        _near = sorted(c for c in _known if _levenshtein_le1(_k, c))   # r1:_known 是 set,不排序的話多個等距候選每次給的建議會漂
        _hint = f"——是不是想寫 {_near[0]}?" if _near else "——工具不認得這個欄位,它不會被任何檢查讀到"
        warns.append(f"開頭欄位有個沒見過的鍵『{_k}』{_hint}(真的要用就加進 .lumos/config.json 的 extra_frontmatter_keys)")
    _pr = n.fields.get("plan_risk")
    if _pr is not None and str(_pr).strip() not in ("high", "low"):
        warns.append(f"plan_risk 只認 high / low,你寫的是 {str(_pr)!r}(規格閘會當沒寫;low 寫了也不會比機械判定更鬆)")
    if n.fields.get("door") is not None:
        _dv = str(n.fields.get("door")).strip()
        warns.append("door 是舊寫法(2026-09-17 改名),改成 plan_risk: high(舊值仍讀得懂)" + ("" if _plan_risk_norm(_dv) != "unknown" else f";而且 {_dv!r} 這個值工具不認得,會當沒寫"))

    t = n.fields.get("type")
    if not isinstance(t, str) or not t:
        errs.append("沒寫 type(這篇是功能、問題還是驗證紀錄?),工具沒辦法分類——在開頭欄位加一行 type: <類型>")
    elif t not in KNOWN_TYPES:
        errs.append(f"type『{t}』工具不認得,會被歸錯類——改成其中一個:{'/'.join(sorted(KNOWN_TYPES))}")

    summ = n.fields.get("summary")
    summ = summ if isinstance(summ, str) else ""
    if t in ("system", "issue") and not summ.strip():
        errs.append(f"{t} 筆記沒有摘要區塊(FLOW:/KEY:/DEP: 那幾行),沒人能快速看懂這篇在講什麼——補上,範本可看 lumos new 產生的骨架")

    # aliases 宣告制(2026-08-05 Enzo 裁定,cutoff 起新 system/issue 逼「判過」不逼「有值」):
    # aliases 吃 3.5 檢索權重,湊數別名主動污染排序——故 `aliases: []`=明示判過,合法;
    # 缺鍵=沒判過,擋。舊節點不回溯(created < cutoff)。
    _ALIASES_CUTOFF = "2026-08-05"
    if t in ("system", "issue"):
        _created = str(n.fields.get("created") or "")
        if _created >= _ALIASES_CUTOFF and "aliases" not in n.fields:
            errs.append("沒寫 aliases:要想過一次這件事有沒有別的叫法(症狀語/縮寫/舊名),別人換個說法才搜得到——"
                        "有就列出來,確定沒有就明確寫 aliases: [](湊數的別名比空的更糟)")

    # 值域執法(2026-08-05 標籤結構優化,Enzo 裁;cutoff 制不回溯——Landmark 實測野化:
    # status 13 值同義混用、FLAG 50+ 自由文字淪為備註欄,可篩選性歸零)
    _ENUM_CUTOFF = "2026-08-06"
    _STATUS_ENUM = {
        "system": {"doing", "done", "planned", "deferred", "rejected", "superseded", "stale"},
        "project": {"todo", "doing", "done", "superseded"},
        "issue": {"open", "doing", "resolved", "done", "wontfix"},
        "verification": {"pass", "stale", "superseded"},
        "moc": {"doing", "done"},
    }
    _PRIORITY_ENUM = {"P0", "P1", "P2", "P3"}
    _RISK_ENUM = {"金流", "對外送出", "不可逆", "守衛面"}
    _FLAG_ENUM = {"TECHNICAL", "DECISION", "ORIGIN"}
    _created_e = str(n.fields.get("created") or n.fields.get("date") or "")
    if _created_e >= _ENUM_CUTOFF:
        _st = str(n.fields.get("status") or "")
        if t in _STATUS_ENUM and _st and _st not in _STATUS_ENUM[t]:
            errs.append(f"status『{_st}』不是 {t} 允許的狀態值,篩選統計會漏掉這篇——改成其中一個:{sorted(_STATUS_ENUM[t])}"
                        "(同義詞要歸一:resolved/done 擇一、verification 用 pass)")
        for tg in (n.fields.get("tags") or []):
            if not isinstance(tg, str):
                continue
            if tg.startswith("priority/") and tg.split("/", 1)[1] not in _PRIORITY_ENUM:
                errs.append(f"priority 標籤只能是 P0 到 P3 四級,你寫的是 {tg!r}")
            if tg.startswith("risk/") and tg.split("/", 1)[1] not in _RISK_ENUM:
                errs.append(f"risk 標籤只能是 {sorted(_RISK_ENUM)} 之一,你寫的是 {tg!r}")
            if tg.startswith(("feature/", "area/")):
                warns.append(f"{tg!r}:feature/ 和 area/ 這兩種標籤已停用,新筆記改用 scope/ 開頭(舊筆記查詢仍認)")
        import re as _re_f
        _mflag = _re_f.search(r"^\s*FLAG:(\S+)", summ, _re_f.M)
        if _mflag and _mflag.group(1) not in _FLAG_ENUM:
            errs.append(f"FLAG:『{_mflag.group(1)}』不是允許的三種分類之一 {sorted(_FLAG_ENUM)}"
                        "(FLAG 是分類欄不是備註欄;想寫的說明移到 KEY: 那行)")

    # scope 值域(2026-09-08 工具分類:一篇一個主類,真橫跨才第二個)——只在專案宣告了 scope 區塊時唸,
    # 而且只 warning 不擋;★不走 created cutoff★:宣告的當下全圖已回填,之後新節點漏掛就該被唸。MOC 豁免。
    _sp = _scope_policy(env) if t != "moc" else None
    if _sp is not None:
        _scope_tags = [tg for tg in (n.fields.get("tags") or []) if isinstance(tg, str) and tg.startswith("scope/")]
        _menu = ", ".join(sorted(_sp["values"]))
        if not _scope_tags and _sp["required"]:
            warns.append("這篇沒掛 scope/ 標籤(這個專案在 .lumos/config.json 宣告了每篇要有一個主類):"
                         f"挑一個掛上——{_menu};各類的定義用 lumos query --tag scope/<值> 看同類節點就懂")
        elif len(_scope_tags) > 2:
            warns.append(f"這篇掛了 {len(_scope_tags)} 個 scope/ 標籤,規矩是一篇一個主類、真橫跨兩類才准第二個:"
                         "留下最能代表它的,其餘拿掉(lumos remove <節點> tags scope/<值>)")
        for tg in _scope_tags:
            if tg.split("/", 1)[1] not in _sp["values"]:
                warns.append(f"scope 標籤 {tg!r} 不在這個專案宣告的值域裡({_menu}):"
                             "打錯字就改成表內的值,真的要新類就先去 .lumos/config.json 的 scope.values 登記")

    # decisions 結構守衛(2026-07-29 外審實錘:id 縮排吞進 content block,parser 靜默降級、
    # doctor 全綠——「綠燈≠schema 有效」的活例。以正牌 parse_decisions 驗:
    # 壞型一(sibling 被吞)→ content 空;壞型二(entry 非 `- key:` 形)→ 整條被靜默丟棄=條數對不上)
    try:
        _fm_lines, _ = split_frontmatter((env.vault / rel).read_text(encoding="utf-8"))
    except OSError:
        _fm_lines = None
    if _fm_lines and any(re.match(r"^decisions:\s*$", _l) for _l in _fm_lines):
        _parsed = parse_decisions(_fm_lines)
        _raw_items = 0
        _in = False
        for _l in _fm_lines:
            if re.match(r"^decisions:\s*$", _l):
                _in = True
                continue
            if _in and _l.strip() and not _l.startswith(" "):
                _in = False
            if _in and re.match(r"^  -\s", _l):
                # 只認 entry 縮排層(恰 2 空格):alternatives_considered 等巢狀清單(≥4 空格)
                # 不是決策條目——2026-08-05 Landmark 回填實戰:照 ADR 規範寫巢狀清單被誤報壞損
                _raw_items += 1
        if _raw_items != len(_parsed):
            errs.append(f"decisions 格式跑掉了:寫了 {_raw_items} 條、工具只認得出 {len(_parsed)} 條,其他等於白寫"
                        "(每條要以 `- id:`/`- content:` 起頭;別手改,用 lumos decision-add 寫入)")
        for _di, _d in enumerate(_parsed):
            if not str(_d.get("content") or "").strip():
                errs.append(f"第 {_di} 條 decisions 沒有內容,通常是旁邊欄位縮排錯、被吞進上一欄了——檢查縮排或改用 lumos decision-add 重寫")

    # 狀態標籤漂移守衛:status 欄位 vs tags 的 status/*(反正規化的完整性檢查,
    # 兜住繞過 set status 同步的寫入路徑;見 Projects/狀態標籤同步守衛_計劃)
    _st = n.fields.get("status")
    if isinstance(_st, str) and _st.strip():
        for _tg in as_list(n.fields.get("tags")):
            if isinstance(_tg, str) and _tg.startswith("status/") and _tg != f"status/{_st.strip()}":
                errs.append(f"status 欄位({_st})和狀態標籤({_tg})寫的不一樣(漂移),靠標籤篩狀態會抓錯——用 lumos set <節點> status <值> 改,兩邊會自動同步")

    _regen_val = n.fields.get("regen")
    _lint_is_regen = isinstance(_regen_val, str) and bool(_regen_val.strip())

    for raw in summ.split("\n"):
        line = raw.strip()
        if not line:
            continue
        ms = SYMBOLISH_RE.match(line)
        if ms and ms.group(1) not in SYMBOL_NAMES:
            warns.append(f"非標準符號行『{ms.group(1)}:』,看起來像打錯字,這行不會被當成摘要——標準符號是 {'/'.join(sorted(SYMBOL_NAMES))}")
        for mark, rx in (("★INVARIANT★", INVARIANT_RE), ("★DEBT★", DEBT_RE)):
            if mark in line and not rx.match(line):
                # 雙報消歧 predicate(Check J):regen 節點的 KEY:推測:★INVARIANT★ 由 J 專屬訊息
                # 接手,跳過 generic 位置錯誤(同一行恰一則;非 regen 節點 generic 保留=兜底)。
                # 既有迴圈只含 INVARIANT/DEBT、無 IRREVERSIBLE → 消歧只需此分支。
                if (_lint_is_regen and REGEN_PREFIX_RE.match(line)
                        and ("★INVARIANT★" in line or "★IRREVERSIBLE★" in line)):
                    continue
                errs.append(f"{mark} 必須是 KEY 行前綴(寫成 KEY:{mark} ...),放別處工具掃合約會直接漏看:{line[:48]}")

    warns.extend(context_marker_warnings(summ))

    invs, _ = extract_contracts(n)
    for inv in invs:
        clean, refs = strip_test_refs(inv)
        if not refs:
            errs.append(f"裸 ★INVARIANT★:標成不能破壞的合約卻沒綁測試,沒人能機械驗證它——行尾加 [test:測試名](健檢會擋):{first_line(clean, 48)}")
        elif not invariant_audit_refs(inv):
            errs.append(f"★INVARIANT★ 綁了測試但未獨立審計:還沒有不知道脈絡的人確認這條是真合約、測試夠不夠格——審過後用 lumos guard audit 補 [audit:](推送會擋):{first_line(clean, 48)}")

    # Check J 單檔版(regen 重生來源守衛):共用 check_regen_provenance,映射表——
    # errs→errs(rc1)/warns→warns(顯示不計 rc)/gov_events→lint 一律不落帳(高頻)。
    if _lint_is_regen:
        j_errs, j_warns, _j_gov = check_regen_provenance(n, _repo_root_from_env(env))
        errs.extend(j_errs)
        warns.extend(j_warns)

    # Check R 單檔版:可逆性回退綁定 + 標錯型別
    for marker, rclean, ref, guard_ref in extract_reversibility(n):
        if t != "system":
            errs.append(f"{marker} 只能標在功能筆記(Systems)上,這篇是 {t!r},標了也不會被當合約檢查:{first_line(rclean, 40)}")
        elif marker == "★IRREVERSIBLE★":
            if not (_rollback_resolved(n, ref) or _guard_resolved(n, guard_ref)):
                errs.append(f"{marker} 缺實質回退:標成做了回不去,卻沒寫出事怎麼退——行尾加 [rollback:decisions] 或 [guard:decisions],並在 decisions 寫上回退/防護內容:{first_line(rclean, 40)}")
        elif not _rollback_resolved(n, ref):  # ★CHECKPOINT★;guard_ref 不讀
            warns.append(f"{marker} 建議補回退(不擋):改了難救的動作最好寫下怎麼退,行尾加 [rollback:decisions]:{first_line(rclean, 40)}")

    # ── Check U:全稱宣稱未綁測試(成因 G「過度概化」;2026-08-12 加) ──
    # 由來:2026-08-12 LandmarkMember 全 24 篇交叉審計(389 主張/59 不一致)歸因出一類最毒的 drift
    # ——★把單一模組的個別設計寫成系統通則★。實例:`背景排程總覽` 寫「服務 disabled 時也要寫心跳」
    # 像通則,實際只有一支服務這樣做,現役的 SecurityAnomalyMonitorService 直接 return 不寫;
    # 後人依樣畫葫蘆就會寫出不一致的新服務。
    # PRIOR-ART(真搜):世界對這類的成熟解是**架構適應度函數**(ArchUnit/Deptrac)——「與其把規則
    # 畫在沒人看的圖上,不如編成一違反就 fail build 的測試」。本檢查不取代那個做法,而是**提示該去做**:
    # 若真是通則,寫成適應度函數會當場告訴你有沒有例外;若寫不出來,那它本來就不是通則。
    # ★噪音實測(2026-08-12,LandmarkMember 30 篇 Systems / 261 條 KEY 行)★:
    #   單看量詞(一律/必須/所有…)→ 命中 17%,抽樣多為用詞規範/操作指示 = 會被無視的 warn;
    #   收緊成「分配式量詞 + 程式實體 + 義務語氣」三者同現 → 命中 1%(5 行),其中 3 條真陽性,
    #   含 CustTransfer/滿額贈 的「折疊守衛(通則)」(自稱通則、零 [test:],且節點自己記載
    #   2026-06-02 漏補一路到 07-21 才被使用者回報)。故採三訊號同現。
    _U_DIST = r'(所有|每個|每支|每一|各個|凡是|凡|一律)'
    _U_ENT = r'(Service|Repository|Controller|Job|服務|排程|查詢|端點|入口|呼叫點|實作|模組|節點|欄位)'
    _U_MOD = r'(必須|都要|都必須|皆須|應該|一律要|要寫|要帶|不可|禁止)'
    import re as _re_u
    for _ln in summ.splitlines():
        _s = _ln.strip()
        if not _s.startswith("KEY:"):
            continue
        if "[test:" in _s or "★DEBT★" in _s:
            continue          # 已綁證據 / 已自認技術債(不是在宣稱規則)→ 不吵
        if (_re_u.search(_U_DIST, _s) and _re_u.search(_U_ENT, _s)
                and _re_u.search(_U_MOD, _s)):
            warns.append(
                "疑似「通則」宣稱但未綁測試:這行寫得像「所有 X 都必須…」,但沒有測試證明對每個實例都成立:" + first_line(_s[4:], 46) +
                " → 真是通則就寫一支列舉所有實例的測試並 [test:] 綁上;"
                "寫不出來就八成只是某個模組的個別設計,★請改寫成限定範圍★"
                "(誤報可加 [test:] 或改寫語氣消音)")

    if not errs and not warns:
        print(f"✓ lint {rel} — 0 問題")
        return 0
    print(f"lint {rel}")
    for e in errs:
        print(f"  ✗ {e}")
    for w in warns:
        print(f"  ⚠ {w}")
    print(f"\n{len(errs)} error / {len(warns)} warning"
          + ("(error 不修,提交會被擋)" if errs else "(warning 不擋,但建議順手補)"))
    return 1 if errs else 0


SPEC_CLAUSE_RE = re.compile(r"\[S(\d+)\]")
_CLAUSE_ENUM = r"(?:(?:[A-Za-z]{1,2}|[一二三四五六七八九十]{1,3}|[甲乙丙丁戊己庚])[.、)）]\s*|[①-⑳⑴-⒇㈠-㈩ⅰ-ⅻⅠ-Ⅻ]\s*)?"   # a. / aa. / 一、/ 十一、/ 甲) / ① ㈠ ⅰ 這種短編號也是清單;★1–2 個字母/中文數字且必帶分隔符★——cf./vs. 也算編號(被當定義→沒標就擋,方向安全);三個字母以上才是詞
_CLAUSE_LEAD_RE = re.compile(r"^[\s>*#\-\d.、|+•—·)]*" + _CLAUSE_ENUM + r"(?:\[[ xX]\]\s*)?(?:\*\*)?\s*\[S(\d+)\]")   # 條款「定義行」:行首(去列表 - * + • — · 1. 1) a. 一、/標題 #/引用 >/粗體/表格 |/勾選框 [ ] 符號)就是 [SN];一行只認一條,後面的 [SN] 一律是引用
_CLAUSE_LISTLIKE_RE = re.compile(r"^\s*(?:[^\w\s]+\s*|(?:\d{1,3}|[A-Za-z]{1,2}|[一二三四五六七八九十]{1,3}|[甲乙丙丁戊己庚])[.、)）]\s*|[①-⑳⑴-⒇㈠-㈩ⅰ-ⅻⅠ-Ⅻ]\s*)*\[S(\d+)\]")   # 「像清單項卻認不得的前綴」:[SN] 前面只有符號或帶分隔符的短編號——用來判該擋還是當純引用;前面是詞或詞+冒號(規格 [S1]、注:[S1]、cf. [S1])才算散文(-b r2 兩席:冒號與任意短詞曾誤擋)
_CLAUSE_STATE_ZH = {"untagged": "未標", "manual": "靠人", "bound": "綁了", "dangling": "懸空(寫錯)",
                    "unrecognized": "懸空(設定認不到)", "mentioned": "懸空(只被提到)", "bad-name": "壞名(平台前綴未定義)",
                    "undefined": "非定義(只在範例/引用裡出現,不算條款)", "duplicate": "編號重複定義(兩行都寫 [SN])",
                    "shadowed": "定義過,又出現在認不得的清單行(第二次寫法看不懂)"}
# ★「懸空」的唯一定義★:spec-trace 的 hang 與 doctor 的 S5 都引用這一組,
# 不各自手抄(2026-09-10 代碼審抓到手抄版編了兩個不存在的字串、又漏掉兩種真的)。
_CLAUSE_HANG_STATES = ("dangling", "unrecognized", "mentioned")

_CLAUSE_GATE_SINCE = "2026-09-09T00:00:00+08:00"   # 處置閘的條款綁定步只看首筆帳在這之後的迴圈——不回溯舊迴圈(週跑回放會重跑閘,回溯=舊判定全翻)。
_SPEC_GATE_SINCE = "2026-09-18T00:00:00+08:00"     # 規格落成可驗收條件_計劃(半套):句式與回退節只看首筆帳在這之後的迴圈;綁定照驗(_CLAUSE_GATE_SINCE 管整步)
_TRIGGER_WORDS = ("若啟用", "當", "在", "若")          # 一條文法的觸發詞(長的先比);半套只認中文
_TRIGGER_STOPWORDS = ("當然", "當下", "當前", "在此", "在於", "若干", "若是")   # 句首命中就當無條件型;只准增不准刪(表列不齊是已知的,失敗是報錯不是靜默)
_CLAUSE_SEP_RE = re.compile(r"[,，]")
# 「主體 應 回應」那個「應」:前一字是這些就是複合詞(反應/效應/因應/適應/回應/對應/相應/供應/感應/響應/呼應/順應/理應/照應/接應/自應),不算
# (代碼審 v2 r1/r2:用負向 lookbehind 一次搜,跟本檔其他「排除上下文」的正則同一招;「答」「理」「自」不列——問答應於/處理應/自應 的應是真的應)
_SHALL_RE = re.compile(r"(?<![反效因適回對相供感響呼順照接])應")   # 「理應/自應」是情態(=應該)不排除(代碼審 v2 r3:「處理應在…」「系統自應…」被誤判缺應)


def _shall_index(text):
    """「主體 應 回應」那個「應」的位置;找不到回 -1。"""
    m = _SHALL_RE.search(text)
    return m.start() if m else -1
_ROLLBACK_H2_RE = re.compile(r"^##\s+回退\s*(?:[(（][^)）]*[)）])?\s*$")
_ROLLBACK_MIN_CHARS = 20


def _clause_body_of(line):
    """定義行去掉行首前綴與 [SN]、去掉尾端 [test:]/[manual:]/[keeps] 標記後的條款正文(給文法檢查用)。"""
    m = _CLAUSE_LEAD_RE.match(line)
    body = line[m.end():] if m else line
    body = INV_TAG_RE.sub("", body)
    body = MANUAL_REF_RE.sub("", body)
    body = re.sub(r"\[manual[:：][^\]]*\]|\[keeps\]", "", body)
    return _strip_inline_markup(body)[0].strip()


def _clause_grammar(body):
    """一條文法(規格落成可驗收條件_計劃 第一節):回 (合不合, 型, 原因)。
    觸發子句? 主體 應 回應;觸發詞=當/在/若啟用/若;句首命中停用詞 → 無條件型;
    句首是觸發詞但整行沒有分隔 → 格式看不懂(r5 正確性席:這種行原本兩邊都掉不進去);複合觸發拆兩條。"""
    b = body.strip()
    if not b:
        return False, "", "條款正文是空的"
    stop = any(b.startswith(w) for w in _TRIGGER_STOPWORDS)
    trig = None if stop else next((w for w in _TRIGGER_WORDS if b.startswith(w)), None)
    if trig:
        m = _CLAUSE_SEP_RE.search(b)
        if not m:
            return False, "trigger", f"觸發子句缺逗號:句首『{trig}…』被當觸發詞卻找不到「,」分隔——不是觸發請改寫或用主體開頭;是常用詞就把它加進 _TRIGGER_STOPWORDS"
        rest = b[m.end():].lstrip()
        if rest.startswith("則"):
            rest = rest[1:].lstrip()
        # 複合觸發=回應段自己又長成「觸發詞…分隔」(代碼審 r1:「當收到請求,在三秒內系統應…」的「在」是介詞,不能光看開頭字)
        # 第二個「當/若/若啟用」一律是第二個條件句(有沒有逗號都算,代碼審 r2);「在」常當介詞(「在三秒內」),
        # 只有「在…應」之間還有分隔才算條件句——回應段後面列兩件事的逗號不算(代碼審 r3)。子集從 _TRIGGER_WORDS 推,不另抄
        if not any(rest.startswith(w) for w in _TRIGGER_STOPWORDS):
            hard = tuple(w for w in _TRIGGER_WORDS if w != "在")
            idx = _shall_index(rest)
            head = rest if idx < 0 else rest[:idx]
            if any(rest.startswith(w) for w in hard) or (rest.startswith("在") and _CLAUSE_SEP_RE.search(head)):
                return False, "trigger", "複合觸發(一條只准一個觸發子句,拆成兩條)"
        if _shall_index(rest) < 0:   # 缺應也要跳複合詞(代碼審 v2 r2:「系統反應」不算有應)
            return False, "trigger", "回應段缺「應」(主體 應 回應)"
        return True, "trigger", ""
    if _shall_index(b) < 0:
        return False, "unconditional", "缺「應」(主體 應 回應)"
    return True, "unconditional", ""


def _h2_section_lines(text, h2_re):
    """某個二級節(標題行符合 h2_re)裡的可見行 [(行號, 原始行)]:到下一個 `## `/`# ` 為止(三級標題不切節、標題行本身不算);
    fence 內不算;沒有那一節回 None。回退節與實務隱患節共用(雙向門放行_計劃 S9;r4 架構對齊席:找節邏輯不准長出第三套)。
    只認 ATX 標題(代碼審 r2:自建 Setext 判定是第二套標題邏輯,還有 fence 錯配與 H1/H2 不分兩個洞)。"""
    out, found, inside = [], False, False
    for no, ln in _visible_lines(text.splitlines()):
        if ln.startswith("#"):
            if h2_re.match(ln.strip()):
                found, inside = True, True
            elif ln.startswith("## ") or ln.startswith("# "):
                inside = False
            continue
        if inside:
            out.append((no, ln))
    return out if found else None


def _rollback_section_chars(text):
    """「## 回退」節(二級標題精確,允許尾端括號;到下一個 ## 為止;fence 內不算;引用塊行不算)裡的實字數;沒有節回 None。"""
    rows = _h2_section_lines(text, _ROLLBACK_H2_RE)
    if rows is None:
        return None
    return sum(len(re.findall(r"[^\W_]", ln)) for _no, ln in rows if not ln.lstrip().startswith(">"))


def _clause_structure_verdict(P, clauses, undef):
    """條款的結構性判定(看不懂的清單寫法/零條款/重複定義/被遮蔽):有結論回 (status, lines),沒事回 None。"""
    listlike = [b for b in undef if b.get("listlike")]
    if listlike:
        return "fail", [f"{P} ✗ — {len(listlike)} 個 [SN] 看起來是條款卻用了這裡不認得的清單寫法(第 " + "、".join(str(b["line"]) for b in listlike) + " 行);看不懂的寫法不放行——條款要寫成 `- [S1] …`/`### [S1] …`/`1. [S1] …`/表格列/`- [ ] [S1] …`"]
    if not clauses:
        return "skip", [f"{P} —(計劃只在散文/標題裡提到 [SN] {len(undef)} 次,沒有條款定義行,視同 opt-in 未啟用)"]
    dups = [b for b in clauses if b["state"] == "duplicate"]
    if dups:
        return "fail", [f"{P} ✗ — 條款編號重複定義:" + "、".join(f"{b['id']}(第 {'/'.join(map(str, b['dup_lines']))} 行)" for b in dups) + ";一個編號只能定義一次,不然第二筆沒標會漏過"]
    shad = [b for b in clauses if b["state"] == "shadowed"]
    if shad:
        return "fail", [f"{P} ✗ — 條款定義過、又出現在這裡不認得的清單行:" + "、".join(f"{b['id']}(第 {'/'.join(map(str, b['dup_lines']))} 行)" for b in shad) + ";看不懂的寫法不放行"]
    return None


def _clauses_grammar_bad(clauses, lines_all):
    """逐條驗一條文法,回 [(條款列, 為什麼不合)]。"""
    bad = []
    for b in clauses:
        ln = lines_all[b["line"] - 1] if 0 < b["line"] <= len(lines_all) else ""
        okg, _kind, why = _clause_grammar(_clause_body_of(ln))
        if not okg:
            bad.append((b, why))
    return bad


def _rollback_check_lines(text, P):
    """回退節不夠就回要印的兩行;夠回 []。"""
    rb = _rollback_section_chars(text)
    if rb is not None and rb >= _ROLLBACK_MIN_CHARS:
        return []
    return [f"{P} ✗ — 有條款的計劃要有「## 回退」節且內容 ≥{_ROLLBACK_MIN_CHARS} 字含實字(" + ("沒有這一節——標題要寫成二級 `## 回退`,底線式(Setext)與其他層級不認" if rb is None else f"現在 {rb} 字;引用塊不算") + ")",
            "    寫清楚出事故要退回哪一版、怎麼退;退不回去的就是風險高,回退節要講清楚代價"]


# ── 風險低(Projects/雙向門放行_計劃;Enzo 2026-09-17 裁「做出來在模擬測試就好」,不等草稿寫的 30 份計劃)──
_PLAN_RISK_LEGACY = {"one-way": "high", "two-way": "low", "high-risk": "high", "low-risk": "low", "high": "high", "low": "low"}


def _plan_risk_norm(v):
    """計劃風險值正規化:high / low / unknown。舊帳與舊寫法(door: one-way/two-way)照讀(2026-09-17 改名:風險高→風險高、風險低→風險低)。"""
    return _PLAN_RISK_LEGACY.get(str(v or "").strip(), "unknown")


def _rec_plan_risk(d):
    """留痕/逃逸列的計劃風險:新欄位 plan_risk 優先,舊欄位 door 相容。"""
    return _plan_risk_norm(d.get("plan_risk") or d.get("door"))


def _note_plan_risk_flag(note):
    """作者自己標的計劃風險:開頭欄位 plan_risk: high(舊寫法 door: one-way 相容);只能往嚴標,low 沒意義。"""
    if note is None:
        return None
    v = note.fields.get("plan_risk")
    if v is None:
        v = note.fields.get("door")
    return _plan_risk_norm(v) if v is not None else None


_DOOR_RULE_VERSION = 1   # 門判定規則版本:PITFALL_CLASSES / 已排除行規則 / 合約行掃描任一支改了就 +1(t_door_rule_version_pin 釘住輸入指紋,改了沒 bump 會紅)
_DOOR_CLASS_ZH = {"payment": "金流", "external-send": "對外送出", "prod-irreversible": "不可逆", "self-governance": "守衛面"}   # 四類正式中文名(=lint 的 _RISK_ENUM)
_EXCL_LEAD_RE = re.compile(r"^[\s>*+•—·\-\d.、)]*")   # 已排除行的前綴:跟條款定義行同一組清單/引用符號
_EXCLUDED_RE = re.compile(r"^已排除\s*[:：]\s*([^:：]+?)\s*[:：]\s*(.*)$")
_HAZARD_H2_RE = re.compile(r"^##\s+(?:[(（]?[一二三四五六七八九十\d]+[)）.、]?\s*)?實務隱患\s*(?:[(（][^)）]*[)）])?\s*$")
_KEEPS_RE = re.compile(r"\[keeps\]")
_KEEPS_VARIANT_RE = re.compile(r"[\[［【]\s*keeps\s*[\]］】]", re.I)
_DOOR_STALE_DAYS = 30   # 健檢:風險低 doing 計劃多少天沒新留痕就提醒(不擋)
# 小改動閘(雙向門放行_計劃 S27;Enzo 2026-09-17 裁「小改動不至於要綁測試」+「行數太 low,看 AWS/Meta/學術怎麼判」):
# 全靠人驗的風險低計劃,推送時四個維度全部成立才放行。判準借即時缺陷預測(Mockus&Weiss 2000、Kamei 2013)的擴散/相對量/歷史/目的,
# 不拿絕對行數當唯一判準;數字是拍的(RETIRE-IF 在計劃),改了就 bump 版本(留痕記 small_change_rule)。
_SMALL_CHANGE_RULE_VERSION = 1
_SMALL_CHANGE = {"max_files": 5, "max_dirs": 2, "max_rel_churn": 0.2, "max_abs_lines": 300, "escape_days": 90}
# 「哪些檔不算程式改動」沿用既有單一源:簿記檔 _BOOKKEEPING_FILES/_BOOKKEEPING_DIRS + 圖譜筆記(代碼審 r1 架構席:自開正則=第二套判準會漂);
# ★不按副檔名排除★(r2 通才席 blocker:借 _PITFALL_DIFF_SKIP_EXT 會讓 .json/.html/.svg 整支量不到,前端專案的大改動 fail-open)


def _excluded_line(line):
    """「已排除:<類>:<理由>」行的★唯一★解析——判定(掃描跳不跳這行)與證明(算不算四行之一)共用同一支
    (r2 正確性/邊界席:兩邊各寫一份、只認字首,任何段落寫一行「已排除:…」就能把它洗出掃描)。
    回 None(不是已排除行)或 (類名, 理由, 合格):合格=類名是四類中文名之一且理由 ≥4 個實字;半形全形冒號都收。"""
    s = _EXCL_LEAD_RE.sub("", _strip_inline_markup(line)[0]).strip()
    m = _EXCLUDED_RE.match(s)
    if not m:
        return None
    cls, reason = m.group(1).strip("*_ "), m.group(2).strip().strip("*_ ").strip()   # 粗體寫法 `- **已排除:金流:** 理由` 的星號不進理由(全面實測抓到理由被記成「** 純本機…」)
    return cls, reason, (cls in _DOOR_CLASS_ZH.values() and len(re.findall(r"[^\W_]", reason)) >= 4)


def _door_exclusions(text):
    """實務隱患節裡合格的已排除行:回 ({類: 理由}, {合格行的行號});同類多行取第一行;引用塊行不算。"""
    found, linenos = {}, set()
    for no, ln in _h2_section_lines(text, _HAZARD_H2_RE) or []:
        if ln.lstrip().startswith(">"):   # 引用塊=引來的話,不是本計劃的宣稱(跟回退節「引用塊不算實字」同一條;代碼審 r1 F2)
            continue
        ex = _excluded_line(ln)
        if ex and ex[2]:
            found.setdefault(ex[0], ex[1])
            linenos.add(no)
    return found, linenos


def _door_linked_signals(env, note, text):
    """門判定訊號 2:計劃連到的節點(related/lands_in/正文 [[連結]])帶 ★IRREVERSIBLE★/★CHECKPOINT★ 合約行、或任何 risk/ 標籤。
    回 [(節點, 原因)] 保序去重。也是條款指紋的輸入:留痕後被連結的節點補了合約或標籤,推送閘會判留痕過期、門要重判(r4 回滾席)。"""
    out = []
    for lk in _plan_system_links(note, text=text, systems_only=False):
        n = env.notes.get(lk + ".md") or env.notes.get(lk)
        if n is None:
            continue
        whys = []
        summ = n.fields.get("summary")
        if isinstance(summ, str):
            whys += [f"★{k}★" for k in sorted({k for _s, _m, k in _contract_key_matches(summ, with_kind=True) if k in ("IRREVERSIBLE", "CHECKPOINT")})]
        whys += sorted(str(t) for t in as_list(n.fields.get("tags")) if str(t).startswith("risk/"))
        if whys:
            out.append((lk, "、".join(whys)))
    return out


def _door_judge(env, note, text):
    """門怎麼判(機械;★預設單向,雙向要證明★):回 {door, signals, missing, exclusions, linked}。
    硬風險高(任一命中):①四類關鍵字表命中——掃全文可見行,只跳過實務隱患節內合格的已排除行 ②連到的節點帶不可逆/檢查點合約或 risk/ 標籤
    ③自帶 risk/ 標籤 ④開頭欄位 door: one-way。都沒命中、且四類各有一行合格已排除 → 風險低;缺哪一類列出來。door: two-way 沒有意義。
    ★這四行通常是 AI 自己寫的=自我認證(Enzo 裁不補人簽),唯一糾錯是逃逸帳與撤除條件★。"""
    exclusions, skip = _door_exclusions(text)
    signals = []
    for no, ln in _visible_lines(text.splitlines()):
        if no in skip:
            continue
        vis = _strip_inline_markup(ln)[0]
        for cls, pats in _PITFALL_COMPILED.items():
            for rx in pats:
                m = rx.search(vis)
                if m:
                    signals.append(f"關鍵字「{m.group(0)}」(第 {no} 行,{_DOOR_CLASS_ZH[cls]})")
                    break
    linked = _door_linked_signals(env, note, text)
    signals += [f"連到 {lk}({why})" for lk, why in linked]
    if note is not None:
        signals += [f"自帶標籤 {t}" for t in as_list(note.fields.get("tags")) if str(t).startswith("risk/")]
        if _note_plan_risk_flag(note) == "high":
            signals.append("開頭欄位 plan_risk: high(作者自己標)")
    missing = [z for z in _DOOR_CLASS_ZH.values() if z not in exclusions]
    return {"door": "high" if (signals or missing) else "low", "signals": signals, "missing": missing,
            "exclusions": exclusions, "linked": linked}


def _door_rule_fingerprint():
    """門判定規則的輸入指紋(四類關鍵字表、已排除行規則、實務隱患節標題、合約行掃描、四類中文名):改了任一支要 bump _DOOR_RULE_VERSION。"""
    import hashlib
    import json as _j
    parts = [_j.dumps(PITFALL_CLASSES, ensure_ascii=False, sort_keys=True), _EXCLUDED_RE.pattern, _EXCL_LEAD_RE.pattern, _HAZARD_H2_RE.pattern,
             IRREVERSIBLE_RE.pattern, CHECKPOINT_RE.pattern, _j.dumps(_DOOR_CLASS_ZH, ensure_ascii=False, sort_keys=True)]
    return hashlib.sha256("\n".join(parts).encode("utf-8")).hexdigest()


def _clause_block_sha(text, rows_b, linked, exclusions=None):
    """條款區塊指紋(留痕綁的是它,不是整檔——r3 邊界席:整檔會被 updated: 這種維護弄成過期):
    每條 [S] 定義行剝行內程式碼、去 [keeps]、壓空白,按編號排序;再加門判定訊號 2 的輸入(連結節點+原因)與四行已排除理由。
    ★它不是門的全部輸入★(代碼審 r1 F1 blocker:正文事後塞金流敘述、條款不動,指紋照樣相同)——推送前另外用 _door_judge 把門整個重判一次,指紋只管「條款與理由有沒有被改」。"""
    import hashlib
    lines_all = text.splitlines()
    parts = []
    for b in sorted((b for b in rows_b if b.get("defined")), key=lambda b: int(b["id"][1:])):
        seg = lines_all[b["line"] - 1] if 0 < b["line"] <= len(lines_all) else ""
        parts.append(b["id"] + "|" + re.sub(r"\s+", "", _KEEPS_RE.sub("", _strip_inline_markup(seg)[0])))
    parts += [f"link|{lk}|{why}" for lk, why in linked]
    for k, v in sorted((exclusions or {}).items()):   # 壓空白算在 f-string 外面:3.12 前 f-string 運算式不准有反斜線(全套在系統 3.9 上翻紅抓到)
        parts.append("excl|" + k + "|" + re.sub(r"\s+", "", v))
    return hashlib.sha256("\n".join(parts).encode("utf-8")).hexdigest()


def _clause_check_twoway(P, clauses):
    """風險低加嚴(不派審):測試不存在/懸空擋、兩條綁同一支擋;[manual:] 收(推送時全靠人的計劃走小改動閘)。回要印的行;沒事回 []。"""
    # [manual:] 收(Enzo 2026-09-17 裁「小改動不至於要綁測試」):全靠人的計劃推送時走小改動閘(_small_change_check)
    hang = [b for b in clauses if b["state"] in _CLAUSE_HANG_STATES or b["state"] == "bad-name"]
    if hang:
        return [f"{P} ✗ — 風險低的測試要真的存在:" + "、".join(f"{b['id']} {'/'.join(map(str, b['refs']))}({_CLAUSE_STATE_ZH.get(b['state'], b['state'])})" for b in hang),
                "    先把測試寫出來(現在紅沒關係),或把門升成單向"]
    seen, dup = {}, []
    for b in clauses:
        for nm in b["refs"]:
            if nm in seen and seen[nm] != b["id"]:
                dup.append(f"{nm}({seen[nm]} 與 {b['id']})")
            seen.setdefault(nm, b["id"])
    if dup:
        return [f"{P} ✗ — 風險低每條條款的測試名要互不相同(重複:" + "、".join(dup) + ")",
                "    一支測試證一條條款;十條全綁同一支也能「全部存在」,所以擋"]
    return []


def _spec_gate_keeps_rows(text, clauses):
    """回 (標了 [keeps] 的條款 id 集合, 疑似變體([Keeps]/全形括號)的條款 id 清單)——變體一律當沒標。"""
    lines_all = text.splitlines()
    keeps, variant = set(), []
    for b in clauses:
        seg = lines_all[b["line"] - 1] if 0 < b["line"] <= len(lines_all) else ""
        if _KEEPS_RE.search(seg):
            keeps.add(b["id"])
        elif _KEEPS_VARIANT_RE.search(seg):
            variant.append(b["id"])
    return keeps, variant


def _plan_first_commit(rr, plan_repo_rel):
    """計劃檔第一次進 git 歷史的提交(r4:frontmatter 的 created 用 lumos set 就能改,不可信);沒進歷史回 None。"""
    try:
        r = subprocess.run(["git", "-C", str(rr), "-c", "core.quotePath=false", "log", "--diff-filter=A", "--format=%H", "--", plan_repo_rel],
                           capture_output=True, text=True, errors="replace")
    except OSError:
        return None
    shas = r.stdout.split() if r.returncode == 0 else []
    return shas[-1] if shas else None


def _test_exists_before(rr, commit, name):
    """計劃建立前的樹(那個提交的上一個)裡整字找得到這個測試名;沒有上一個提交=樹是空的=不存在。"""
    try:
        r = subprocess.run(["git", "-C", str(rr), "rev-parse", "-q", "--verify", commit + "^"], capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            return False
        g = subprocess.run(["git", "-C", str(rr), "grep", "-q", "-w", "-e", name, r.stdout.strip(), "--"], capture_output=True, text=True, errors="replace")
        return g.returncode == 0
    except OSError:
        return False


def _spec_gate_twoway_static(text, clauses, names, rr, plan_repo_rel):
    """風險低的靜態條件(跑測試之前):至少一條沒標 keeps;標 keeps 的測試在計劃建立前就存在(計劃沒進歷史=驗不了,擋)。回 (要印的行, 擋不擋)。"""
    P = "[spec-gate] 風險低:"
    keeps, variant = _spec_gate_keeps_rows(text, clauses)
    out = []
    if variant:
        out.append(f"{P} 看到疑似 keeps 變體({'、'.join(variant)}):只認半形小寫 [keeps],這幾條當新行為(測試要紅)")
    if not [b for b in clauses if b["id"] not in keeps]:
        out.append(f"{P} ✗ — 全部條款都標 [keeps],至少一條要是新行為(沒標 keeps 的測試現在是紅的、或靠人驗的 [manual:]);全標 keeps 等於什麼都沒驗")
        return out, True
    if not names or all(not names.get(b["id"]) for b in clauses):
        out.append(f"{P} 全部條款都靠人驗(一支測試都沒有):放行後推送時走小改動閘——碰 ≤{_SMALL_CHANGE['max_files']} 檔/≤{_SMALL_CHANGE['max_dirs']} 目錄且都在計劃落點內、每檔改動 ≤{int(_SMALL_CHANGE['max_rel_churn'] * 100)}% 或 ≤{_SMALL_CHANGE['max_abs_lines']} 行、落點沒風險標籤也不是裁判檔、近 {_SMALL_CHANGE['escape_days']} 天沒逃逸、不是修 bug")
    if keeps:
        first = _plan_first_commit(rr, plan_repo_rel)
        if first is None:
            out.append(f"{P} ✗ — 標了 [keeps] 的條款要驗「測試在計劃建立前就存在」,但這份計劃還沒進 git 歷史,驗不了;先提交計劃再跑")
            return out, True
        bad = [f"{b['id']} {nm}" for b in clauses if b["id"] in keeps for nm in names.get(b["id"], []) if not _test_exists_before(rr, first, nm)]
        if bad:
            out.append(f"{P} ✗ — 這幾條標了 [keeps] 但測試在計劃建立前的提交樹裡不存在:{'、'.join(bad)}(keeps 只給既有的綠測試;新測試就別標)")
            return out, True
    return out, False


def _spec_gate_twoway_run_verdict(clauses, keeps, verdicts):
    """風險低的放行條件(跑完之後):沒標 keeps 的每一條各自紅(綠=沒做卻說做了、弱證據≠紅);標 keeps 的要綠。回沒過的清單。"""
    fails = []
    for b in clauses:
        if b["state"] == "manual":
            continue   # 靠人驗的沒有紅綠可判
        v = verdicts.get(b["id"])
        if v is None:
            fails.append(f"{b['id']}:沒跑到(綁的測試沒排進去)")
            continue
        verdict, why, method = v
        if b["id"] in keeps:
            if verdict != "green":
                fails.append(f"{b['id']} {method}:標了 keeps 卻不是綠的({'紅' if verdict == 'red' else why})——既有行為已經壞了,先修")
        elif verdict == "green":
            fails.append(f"{b['id']} {method}:綠——沒標 keeps 的是新行為,測試現在就該紅;真的是既有行為就標 [keeps]")
        elif verdict != "red":
            fails.append(f"{b['id']} {method}:{why}——弱證據不算紅")
    return fails


def _spec_gate_record(env, rel, judged, text, rows_b, clauses, names, keeps, counts):
    """規格閘留痕:走審查帳同一支寫入口(_jsonl_append_verified+vault 寫入鎖),kind=spec-gate(讀側的輪次判定要略過它——S16)。
    帶門、四行已排除理由(風險低)或命中訊號(風險高)、全部測試名、條款區塊指紋、門判定規則版本、條款數/紅數/keeps 數。回寫成沒有。"""
    import datetime as _dt
    import secrets as _sec
    tests = sorted({m for b in clauses for m in names.get(b["id"], [])})
    rec = {"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"), "kind": "spec-gate", "token": "SPEC-" + _sec.token_hex(4),
           "loop": _loop_id_for_plan(rel), "plan": rel, "plan_risk": judged["door"], "door_rule": _DOOR_RULE_VERSION,
           "clause_sha": _clause_block_sha(text, rows_b, judged["linked"], judged["exclusions"]), "tests": tests,
           "n_clauses": len(clauses), "n_red": counts.get("red", 0), "n_keeps": len(keeps),
           "n_manual": sum(1 for b in clauses if b["state"] == "manual"), "manual_only": not tests,
           "small_change_rule": _SMALL_CHANGE_RULE_VERSION if not tests else None}
    if judged["door"] == "low":
        rec["exclusions"] = judged["exclusions"]
    else:
        rec["signals"] = judged["signals"][:8]
    try:
        with _vault_write_lock(env.vault):
            return _jsonl_append_verified(env.vault.parent / ".canary-log.jsonl", rec, "token", rec["token"]) == 0
    except OSError as e:
        print(f"[spec-gate] 留痕寫不進審查帳({e}),這次沒留痕", file=sys.stderr)
        return False


def _spec_gate_print_door(judged):
    if judged["door"] == "low":
        print("[spec-gate] 計劃風險: 低(硬訊號都沒命中;四類已排除:" + "、".join(f"{k}={v[:12]}" for k, v in judged["exclusions"].items()) + ")")
        return
    why = judged["signals"][:6]
    if judged["missing"]:
        why.append("實務隱患節缺已排除行:" + "、".join(judged["missing"]))
    print("[spec-gate] 計劃風險: 高(" + ";".join(why) + ("" if len(judged["signals"]) <= 6 else f";另 {len(judged['signals']) - 6} 個訊號") + ")")
    print("    風險高=還原提交之後外面還要人收拾(金流、對外送出、資料不可逆、守衛面)或沒證明不用,照走設計審;要當風險低:硬訊號一個都不能命中,且「## 實務隱患」節裡四類各一行 `已排除:<類>:<理由≥4 字>`")


def _clause_check(text, rows_b, grammar=True, tag="disposal", door=None):
    """規格閘與處置閘第五步共用的條款檢查器(規格落成可驗收條件_計劃 S9):
    回 (status, lines)。status ∈ ok/fail;lines 是要印的「[tag] 條款綁定: …」行。
    綁定的判定原封沿用處置閘第五步既有語意(沒標的擋、懸空只提醒不擋、看不懂的清單寫法擋、重複定義擋);
    grammar=True 才驗句式與回退節(呼叫端按首筆帳是否早於 _SPEC_GATE_SINCE 決定——檢查器不管不回溯)。
    door="low" 加嚴:不收 manual、測試要存在、名字互不相同、不要求回退節(雙向門放行_計劃 S3/S18/S19);處置閘呼叫時 door=None(=風險高語意)。"""
    P = f"[{tag}] 條款綁定:"
    clauses = [b for b in rows_b if b["state"] != "undefined"]
    undef = [b for b in rows_b if b["state"] == "undefined"]
    early = _clause_structure_verdict(P, clauses, undef)
    if early:
        return early
    lines_all = text.splitlines()
    out = []
    if grammar:
        bad = _clauses_grammar_bad(clauses, lines_all)
        if bad:
            out.append(f"{P} ✗ — {len(bad)} 條格式看不懂(不算條款):" + "、".join(f"{b['id']}(第 {b['line']} 行:{why})" for b, why in bad))
            out.append("    一條文法:觸發子句?(當/在/若啟用/若 … ,)主體 應 回應;一條一個觸發;句首是停用詞(當然/在此…)就當無條件型")
            return "fail", out
    unt = [b for b in clauses if b["state"] == "untagged"]
    summ = _clause_summary(clauses)
    hang = sum(summ[_st] for _st in _CLAUSE_HANG_STATES) + summ["bad-name"]
    tail_u = f";另有 {len(undef)} 個 id 只在範例/引用裡出現,不算條款" if undef else ""
    if unt:
        out.append(f"{P} ✗ — {len(unt)}/{len(clauses)} 條驗收條款沒標:" + "、".join(f"{b['id']}(第 {b['line']} 行)" for b in unt) + tail_u)
        out.append("    每條要嘛在那一行綁 [test:測試名],要嘛寫 [manual:一句怎麼驗];沒有測試可掛也得講清楚靠人怎麼驗")
        fw = [b for b in unt if re.search(r"\[manual：", lines_all[b["line"] - 1] if 0 < b["line"] <= len(lines_all) else "")]
        if fw:
            out.append("    看到 `[manual：` 用了全形冒號(" + "、".join(b["id"] for b in fw) + "),改成半形 `[manual:` 才認得")
        return "fail", out
    if door == "low":
        tw = _clause_check_twoway(P, clauses)
        if tw:
            return "fail", out + tw
    if grammar and door != "low":
        rb_lines = _rollback_check_lines(text, P)
        if rb_lines:
            return "fail", out + rb_lines
    out.append(f"{P} ✓ — {len(clauses)} 條全標(綁了 {summ['bound']}/靠人 {summ['manual']}"
               + (f";懸空 {hang} 只提醒不擋,spec-trace 會唸" if hang else "") + (";句式與回退節已驗" if grammar else ";句式未驗(首筆帳早於句式閘上線,不回溯)") + tail_u + ")")
    return "ok", out

_SECURITY_SEAT_SINCE = "2026-09-12T00:00:00+08:00"   # 處置閘「資安席」一步只看首筆帳在這之後的迴圈——不回溯,理由同上一行(Projects/代碼審資安席_計劃 [S3])。
# 設隔日不設當日(同 _SEV_WRITESIDE_CUTOFF 的理由:合入當天白天用舊碼寫的帳,日粒度切不開先後);比對走 _loop_ts_key 換算 UTC(r1 單reviewer:字串比日期會依記帳機器時區判不同)。


def clause_bindings(text, split, default, methods_for, hay_for):
    """計劃正文的 [SN] 條款 × 同一行的 [test:]/[manual:](條款綁測試算進度 [S1];唯讀、純函式)。
    定義行=該 id 第一次出現在行首的那一行(去 - * # > 數字. | 粗體符號),從沒在行首出現過的 id=非定義(undefined,不算條款)——
    「見 [S2]」這種行內引用不算定義;★反引號/圍欄裡的內容不看,未閉合反引號之後不信;HTML 註解不特別處理(裡面的 [SN] 走認不得→擋)★(r2 單reviewer blocker:同一行「真條款 + `[S9] 範例`」曾讓閘 FAIL)。
    配對範圍=同一行、定義的 [SN] 之後到行尾(一行一條;後面再出現的 [SN] 是引用,不切段)
    (r1 通才席:SPEC_CLAUSE_RE/TEST_REF_RE 都是全文正則沒有行邊界,不同實作者會各自猜)。
    狀態七種(r1 接手席/通才席:四態不是三態、懸空要分「寫錯」與「設定認不到」,後者不進量測分母):
      untagged 未標 / manual 靠人 / bound 綁了(全部 ref 都是真測試)/ dangling 寫錯(方法集合與檔案都沒有)/
      unrecognized 設定認不到(檔裡有 `def 名(` 但 test.method_regex 不收,例:class 內的 test_…)/
      mentioned 只被提到(檔裡有這個字串但不是 def)/ bad-name 平台前綴未定義(resolve 拒絕,不猜)。
    分類沿用 _classify_one(不開第二套引擎;r1 簡化席開碼確認),只在它答 fake/dangling 時多做一步分辨。
    同一行同時有 [test:] 與 [manual:] → 以 [test:] 為準(靠人只在沒測試時成立)。回 list[dict] 依 id 排序。"""
    defined, fallback, dup, listlike_extra = {}, {}, {}, {}
    # ★哪些字看得見=沿用全檔唯一那兩份實作★:_visible_lines(行層級:fence、跨行註解)+ _strip_inline_markup(行內:註解、反引號 span、未閉合反引號之後不信)。
    for no, raw in _visible_lines(text.split("\n"), keep_fenced=False):
        line, truncated = _strip_inline_markup(raw)
        ms = list(SPEC_CLAUSE_RE.finditer(line))
        if truncated:
            # 未閉合反引號截掉的那一段裡若有 [SN] → 認不得就擋,不放行(-b r2/r3 兩席三次:`[S1]、`x [S2]、- [S1] 甲 `x [S2] 都曾讓條款消失)
            seen = {int(m.group(1)) for m in ms}
            for m in SPEC_CLAUSE_RE.finditer(raw):
                if int(m.group(1)) not in seen:
                    listlike_extra.setdefault(int(m.group(1)), []).append(no)
        if not ms:
            continue
        lead = _CLAUSE_LEAD_RE.match(line)
        if lead is not None:
            cid = int(lead.group(1))
            seg = line[ms[0].end():]          # 一行一條:這一行 [SN] 之後全部是它的(後面再出現的 [SN] 是引用,不切段)
            if cid in defined:
                dup.setdefault(cid, []).append(no)   # 同編號在兩行都寫成定義 → 重複(r3 外家席:第二筆沒標會漏過)
            else:
                defined[cid] = (no, seg)
            for m in ms[1:]:
                fallback.setdefault(int(m.group(1)), (no, "", False))          # 定義行後面的 [SN]=引用,絕不像清單
        else:
            for i, m in enumerate(ms):
                cid = int(m.group(1))
                # 「像清單項卻認不得的前綴」只看這一行★第一個★ [SN](後面的是引用);-b r1 自踩:曾拿整行去判,把「詳見 [S2]」判成像清單
                ll = i == 0 and bool(_CLAUSE_LISTLIKE_RE.match(line))
                if ll:
                    listlike_extra.setdefault(cid, []).append(no)   # 不管這個編號有沒有在別處合法定義,都要擋(-b r2 外家席:被既有定義遮掉而放行)
                fallback.setdefault(cid, (no, line[m.end():], ll))
    out = []
    for cid in sorted(set(defined) | set(fallback) | set(listlike_extra)):
        if cid not in defined:   # 只在範例/引用/行內出現過、從沒在行首定義 → 不是條款(r1 單reviewer blocker:純示範文字曾讓閘 FAIL)
            no, seg, listlike = fallback.get(cid) or (listlike_extra[cid][0], "", True)
            out.append({"id": f"S{cid}", "line": no, "refs": [], "manual": [], "defined": False, "state": "undefined",
                        "listlike": listlike or cid in listlike_extra, "listlike_lines": listlike_extra.get(cid, [])})
            continue
        if cid in listlike_extra:   # 合法定義過,卻又出現在像清單的認不得的行(或反引號前綴的行)→ 自己的狀態,擋(-b r3 架構席:別跟真重複共用一個名)
            out.append({"id": f"S{cid}", "line": defined[cid][0], "refs": [], "manual": [], "defined": True, "state": "shadowed",
                        "dup_lines": [defined[cid][0]] + listlike_extra[cid]})
            continue
        if cid in dup:
            out.append({"id": f"S{cid}", "line": defined[cid][0], "refs": [], "manual": [], "defined": True, "state": "duplicate",
                        "dup_lines": [defined[cid][0]] + dup[cid]})
            continue
        no, seg = defined[cid]
        refs = invariant_test_refs(seg)
        manual = [x.strip() for x in MANUAL_REF_RE.findall(seg)
                  if len(x.strip()) >= _MANUAL_MIN_CHARS and re.search(r"[^\W_]", x)]   # ≥4 字且至少一個實字(四個標點不算「講了怎麼驗」)
        row = {"id": f"S{cid}", "line": no, "refs": refs, "manual": manual, "defined": True}
        if not refs:
            row["state"] = "manual" if manual else "untagged"   # [manual: ] 空的或太短=沒講怎麼驗=未標(外家席 major 2)
            out.append(row)
            continue
        if _classify_one(seg, split, default, methods_for, hay_for) == "real":
            row["state"] = "bound"
            out.append(row)
            continue
        # 不是全真:逐 ref 分辨(只看不真的那幾個;取最壞:壞名 > 寫錯 > 設定認不到 > 只被提到)
        try:
            pairs = resolve_test_refs(seg, split, default)
        except ValueError:
            row["state"] = "bad-name"
            out.append(row)
            continue
        worst = 0
        for pl, n in pairs:
            if n in methods_for(pl):
                continue
            hay = hay_for(pl) or ""
            if re.search(r"^\s*def\s+" + re.escape(n) + r"\s*\(", hay, re.M):
                worst = max(worst, 1)          # unrecognized
            elif n in hay:
                pass                           # mentioned(最輕,worst 預設 0)
            else:
                worst = max(worst, 2)          # dangling
        row["state"] = {0: "mentioned", 1: "unrecognized", 2: "dangling"}[worst]
        out.append(row)
    return out


def _clause_bindings_for(env, text, root=None):
    """cmd_spec_trace / cmd_handoff / 處置閘共用:用 vault 反推的 repo 根建平台索引(★不用 cwd★,同 gov --stats 教訓),
    回 (rows, err)。索引建不起來(設定壞)回 ([], 一句原因),呼叫端印出來、不炸查詢。"""
    try:
        # 顯式 root(呼叫端已照 --repo 覆蓋規則算好)贏,env 反推只是預設——跟 _loop_status_disposal 其餘四步同一條優先序
        # (r1 架構席/單reviewer 都抓到我寫反了:git-less 部署副本裡 .git 不在,反推會落錯根)
        rr = Path(root) if root else _vault_repo_root(env)
        _, split, default, methods_for, hay_for = _platform_test_index(rr)
        return clause_bindings(text, split, default, methods_for, hay_for), None
    except (ValueError, OSError) as e:
        return [], f"{e.__class__.__name__}: {e}"


def _clause_summary(rows):
    c = {k: 0 for k in _CLAUSE_STATE_ZH}   # 含 undefined 桶;呼叫端多半先濾掉再算
    for r in rows:
        c[r["state"]] += 1
    return c


def _regress_sources(env, plan_rel):
    """相依回歸(規格落成可驗收條件_計劃 S15-S17;Enzo 2026-09-17 裁):計劃 lands_in 與 DEP/related 裡的 Systems 節點(一跳),
    抓它們合約行(★INVARIANT★/★CHECKPOINT★/★IRREVERSIBLE★)綁的 [test:] → 機器產的回歸條款,作者不能挑。
    回 (bound[(節點, 合約摘要, refs 文字)], unbound[(節點, 合約摘要)])。"""
    note = env.notes.get(plan_rel)
    if note is None:
        return [], []
    bound, unbound = [], []
    for lk in _plan_system_links(note):
        n = env.notes.get(lk + ".md") or env.notes.get(lk)
        sm = n.fields.get("summary") if n is not None else None
        if not isinstance(sm, str):
            continue
        for reftext in _contract_texts(sm):
            clean, refs = strip_test_refs(reftext)
            snippet = clean[:40] + ("…" if len(clean) > 40 else "")
            (bound if refs else unbound).append((lk, snippet, reftext) if refs else (lk, snippet))
    return bound, unbound


def _plan_system_links(note, text=None, systems_only=True):
    """計劃連到的節點(lands_in + related + DEP 行的 [[連結]];給了 text 再加正文全部 [[連結]]),去重、保序。
    ★全檔唯一的「計劃連到誰」★:相依回歸(預設:只 Systems、不掃正文)、門判定訊號 2 與推送前「誰的落點被碰到」
    (text 給正文、systems_only=False 收全部節點)都走這裡——代碼審 r1 架構席:別再開第二支平行函式,兩套算法會各自漂。"""
    # 字串/清單都收(代碼審 r1);[[…]]/別名/錨點/引號一律交給既有 link_target(代碼審 r2/r3:別自己再刻一份剝括號)
    links = [link_target(x) for x in as_list(note.fields.get("lands_in")) + as_list(note.fields.get("related"))] if note is not None else []
    summ = note.fields.get("summary") if note is not None else None
    if isinstance(summ, str):
        for ln in summ.split("\n"):
            if ln.strip().startswith("DEP:"):
                links += re.findall(r"\[\[([^\]|#]+)", ln)
    if text:   # 正文只看可見行、剝行內程式碼(代碼審 r2:圍欄裡示範語法的 [[連結]] 不是真連結,會把合格的風險低打成風險高)
        for _no, ln in _visible_lines(text.splitlines()):
            links += [link_target(m) for m in WIKILINK_RE.findall(_strip_inline_markup(ln)[0])]
    out, seen = [], set()
    for lk in links:
        lk = str(lk).strip()
        if lk and (lk.startswith("Systems/") or not systems_only) and lk not in seen:
            seen.add(lk)
            out.append(lk)
    return out


def _contract_texts(summary):
    """摘要區塊裡的合約行(★INVARIANT★/★CHECKPOINT★/★IRREVERSIBLE★)正文,含 [test:] 標記。"""
    return [m.group(1).strip() for _s, m in _contract_key_matches(summary)]


def _loop_first_ts_key(env, loop_id):
    """審查帳裡這條迴圈的首筆帳(UTC 可比的鍵);沒有帳回 None。"""
    ledger = env.vault.parent / ".canary-log.jsonl"
    best = None
    if ledger.exists():
        for ln in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            if not isinstance(d, dict) or nfc(str(d.get("loop", ""))) != nfc(loop_id) or not d.get("ts"):
                continue
            k = _loop_ts_key(str(d["ts"]))
            if k is not None and (best is None or k < best):
                best = k
    return best


def _spec_gate_clause_part(env, text, rel, rr, door=None):
    """①②:句式(按首筆帳決定驗不驗)+綁定+回退節(風險高);有結論回 (rc, rows),要繼續跑回 (None, rows)。door 傳給檢查器(風險低加嚴、零條款擋)。"""
    loop_id = _loop_id_for_plan(rel)
    first = _loop_first_ts_key(env, loop_id) if loop_id else None
    grammar = first is None or first >= _loop_ts_key(_SPEC_GATE_SINCE)
    if not grammar:
        print(f"[spec-gate] 句式: —(迴圈「{loop_id}」首筆帳早於 {_SPEC_GATE_SINCE[:10]},不回溯;綁定照驗)")
    if not SPEC_CLAUSE_RE.search(text):
        if door == "low":
            print("[spec-gate] 條款綁定: ✗ — 風險低零條款一律擋(空集合會放行一份什麼都沒驗的計劃);寫成 `- [S1] 當…,主體應… [test:測試名]`")
            return 1, []
        print("[spec-gate] 條款綁定: —(計劃無 [SN] 條款,沒有東西可驗;寫成 `- [S1] 當…,主體應… [test:測試名]` 才進閘)")
        return 0, []
    rows_b, err = _clause_bindings_for(env, text, root=rr)
    if err:
        print(f"[spec-gate] 條款綁定: ✗ — 測試索引建不起來({err}),驗不了≠通過")
        return 1, []
    status, lines = _clause_check(text, rows_b, grammar=grammar, tag="spec-gate", door=door)
    for ln in lines:
        print(ln)
    if status == "fail":
        return 1, rows_b
    if status == "skip":
        return 0, rows_b
    return None, rows_b


def _spec_gate_load(env, node):
    """找計劃檔、讀文字;回 (Path, text, vault 相對路徑) 或 (None, 錯誤訊息, None)。"""
    rel = env.find(node)   # 跟 spec-trace 與其他吃節點名的指令同一條路(代碼審 r1:短名叫不到、退回手拼漏了 Projects/)
    if not rel:
        _node_not_found(env, node)
        return None, "", None
    p = env.vault / rel
    try:
        text = p.read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError) as e:
        print(f"擋下:計劃讀不成文字({e.__class__.__name__}):\n    {p}", file=sys.stderr)
        return None, "", None
    return p, text, rel


def _spec_gate_verdict(n, skipped, verdict, detail):
    """一支測試的規格閘判定:回 (red|green|weak, 為什麼)。支數 N 先於退出碼看。"""
    if n is not None and n >= 2:
        return "weak", f"篩選匹配到 {n} 支,測試名要唯一(換更長、不互為子字串的名字)"
    if n == 1 and skipped:
        return "weak", "弱證據:那一支被跳過(skipped/xfail)"
    if verdict in ("no-cmd", "unproven") or n == 0:
        return "weak", "弱證據:一支都沒跑到(匯入錯、檔名錯、環境缺?)"
    if n is None:
        return ("red" if verdict == "red" else "green"), "這棧還讀不出支數,只印有沒有跑過"
    if verdict == "red":
        return "red", detail
    return "green", ""


def _spec_gate_items(text, clauses, split, default):
    """綁了測試的條款 → _run_bound_tests 的 items[(條款 id, 平台, 方法, real)]。"""
    lines_all = text.splitlines()
    items = []
    for b in clauses:
        if b["state"] != "bound":
            continue
        seg = lines_all[b["line"] - 1] if 0 < b["line"] <= len(lines_all) else ""
        items += [(b["id"], plat, method, "real") for plat, method in resolve_test_refs(seg, split, default)]
    return items


def _spec_gate_runnable(items, plats):
    """能不能跑:沒東西/指令不能鎖單支都印一行略過,回 False。"""
    if not items:
        print("[spec-gate] 跑: —(沒有綁 [test:] 的條款,沒東西可跑)")
        return False
    nocmd = [pl for pl in {i[1] for i in items} if "{method}" not in str((plats.get(pl) or {}).get("run_cmd") or "")]
    if nocmd:
        print(f"[spec-gate] 跑: —(略過:平台 {'/'.join(sorted(nocmd))} 的測試指令不能只跑一支;在 .lumos/config.json 的 test.run_cmd 加上 {{method}} 佔位符,例如 `python3 -m pytest -k {{method}}`)")
        return False
    return True


def _spec_gate_run_clauses(rr, plats, items, per_prof):
    """把條款綁的測試跑一次;回 {條款 id: (verdict, why, method)}。一條多支測試時,任一非綠就蓋過綠。"""
    tails = {}
    results, rerr = _run_bound_tests(rr, items, tails=tails)
    if results is None:
        print(f"[spec-gate] 跑: —(略過:{rerr})")
        return {}
    verdicts = {}
    for node_id, plat, method, verdict, detail, _secs in results:
        n, skipped = _ran_count(per_prof(plat), tails.get((node_id, plat, method), ""))
        v, why = _spec_gate_verdict(n, skipped, verdict, detail)
        prev = verdicts.get(node_id)
        if prev is None or (prev[0] == "green" and v != "green"):
            verdicts[node_id] = (v, why, method)
    for cid in sorted(verdicts, key=lambda x: int(x[1:])):
        v, why, method = verdicts[cid]
        mark = {"red": "紅", "green": "綠", "weak": "弱證據"}[v]
        print(f"[spec-gate] 跑: {cid} {mark}({method}" + (f";{why}" if why and v != "red" else "") + ")")
    return verdicts


def _spec_gate_regress(env, rel, rr, split, default, methods_for, per_prof, no_run):
    """⑤ 相依回歸(S15-S17):連到的 Systems 節點的合約測試,機器產 [R] 條款;全綠才過。回 (沒過的清單, 綠的支數, 來源節點數)。"""
    rb, ru = _regress_sources(env, rel)
    for lk, snip in ru:
        print(f"[spec-gate] 相依回歸: ⚠ {lk} 的合約「{snip}」沒綁測試,驗不了回歸(那篇的債,不擋)")
    if not rb:
        return [], 0, 0
    ritems, rmap, fails = [], {}, []
    for i, (lk, snip, reftext) in enumerate(rb, 1):
        rid = f"R{i}"
        print(f"[spec-gate] 相依回歸: [{rid}] 當本計劃落地,{lk} 的「{snip}」應維持 ← {' '.join(invariant_test_refs(reftext))}")
        for plat, method in resolve_test_refs(reftext, split, default):
            ritems.append((rid, plat, method, "real" if method in methods_for(plat) else "dangling"))
            rmap[(rid, plat, method)] = lk
    ok = 0
    if ritems and not no_run:
        rtails = {}
        rres, rerr = _run_bound_tests(rr, ritems, tails=rtails)
        if rres is None:
            fails.append(f"相依回歸跑不起來:{rerr}")
        else:
            for rid, plat, method, verdict, detail, _secs in rres:
                n, skipped = _ran_count(per_prof(plat), rtails.get((rid, plat, method), ""))
                v, why = _spec_gate_verdict(n, skipped, verdict, detail)
                lk = rmap.get((rid, plat, method), "?")
                if v == "green":
                    ok += 1
                elif v == "red":
                    fails.append(f"{rid} {lk}/{method}:紅({str(detail)[:80]})——既有行為回歸,或環境壞")
                else:
                    fails.append(f"{rid} {lk}/{method}:{why}——驗不了≠過")
    return fails, ok, len({x[0] for x in rb})


def _spec_gate_front(env, node, no_run):
    """規格閘前半(⓪門 ①句式 ②綁定 + 風險低靜態條件 + 平台索引):有結論回 rc(int),要繼續跑回一組材料。"""
    p, text, rel = _spec_gate_load(env, node)
    if p is None:   # 找不到/讀不動:_spec_gate_load 自己已印原因
        return 2
    rr = _vault_repo_root(env)
    judged = _door_judge(env, env.notes.get(rel), text)
    _spec_gate_print_door(judged)
    door = judged["door"]
    rc, rows_b = _spec_gate_clause_part(env, text, rel, rr, door=door)
    if rc is not None:
        return rc
    clauses = [b for b in rows_b if b["state"] != "undefined"]
    prep = _spec_gate_prepare(rr, text, clauses)
    if prep is None:
        return 1 if door == "low" else 0
    keeps = _spec_gate_twoway_gate(p, rr, text, clauses, prep[4]) if door == "low" else set()
    if keeps is None:
        return 1
    if no_run:
        if door == "low":
            print("[spec-gate] 跑: —(--no-run;風險低要跑過測試才放行、才留痕)")
        return 0
    return p, text, rel, rr, judged, rows_b, clauses, keeps, prep


def _spec_gate_prepare(rr, text, clauses):
    """平台測試索引 + 每條條款綁的測試名;設定讀不動印一句回 None。"""
    try:
        _, split, default, methods_for, _hay = _platform_test_index(rr)
        plats = load_platforms(rr)["platforms"]
    except (ValueError, OSError) as e:
        print(f"[spec-gate] 跑: —(平台設定讀不動:{e};略過)")
        return None
    lines_all = text.splitlines()
    names = {b["id"]: [m for _pl, m in resolve_test_refs(lines_all[b["line"] - 1] if 0 < b["line"] <= len(lines_all) else "", split, default)] for b in clauses}
    return split, default, methods_for, plats, names


def _spec_gate_twoway_gate(p, rr, text, clauses, names):
    """風險低的靜態條件(跑之前):印結果;過了回 keeps 集合,擋下回 None。"""
    try:
        prel = str(p.resolve().relative_to(rr.resolve())).replace(os.sep, "/")
    except ValueError:
        prel = str(p)
    tw_lines, tw_block = _spec_gate_twoway_static(text, clauses, names, rr, prel)
    for ln in tw_lines:
        print(ln)
    if tw_block:
        return None
    return _spec_gate_keeps_rows(text, clauses)[0]


def _spec_gate_print_regress(reg_fail, reg_ok, reg_nodes):
    """相依回歸結果印出;有沒過的回 False。"""
    if reg_fail:
        print(f"[spec-gate] 相依回歸: ✗ — {len(reg_fail)} 支沒過(相依功能的合約測試要全綠才算驗收):")
        for x in reg_fail:
            print(f"    • {x}")
        print("    先修回歸再進審;真的要改那條合約,先在那篇節點改合約行與測試(綁測試加審計)")
        return False
    if reg_nodes:
        print(f"[spec-gate] 相依回歸: ✓ — {reg_ok} 支全綠(來自 {reg_nodes} 個節點)")
    return True


def _spec_gate_print_twoway(clauses, keeps, verdicts):
    """風險低計劃放行條件(跑之後)印出;沒過回 False。"""
    fails = _spec_gate_twoway_run_verdict(clauses, keeps, verdicts)
    if not fails:
        return True
    print(f"[spec-gate] 風險低: ✗ — {len(fails)} 條沒過放行條件(沒標 keeps 的每一條各自紅、標 keeps 的綠、弱證據不算):")
    for x in fails:
        print(f"    • {x}")
    return False


def cmd_spec_gate(env, node, no_run=False):
    """規格閘:⓪門(單向/雙向,機械判)①句式 ②綁定+回退節 ③把綁的測試真跑一次 ④相依回歸(全綠才過)⑤匯總+留痕。
    風險高(半套語意):紅綠只印不擋,接著走 lumos loop next。風險低(雙向門放行_計劃):至少一條新行為、每條沒標 keeps 的各自紅、
    keeps 的既存且綠、弱證據不算 → PASS(風險低):直接實作、不派審;留痕 kind=spec-gate 進審查帳(推送閘讀它)。
    判定走跟處置閘第五步同一支 _clause_check;句式與回退節只對首筆帳晚於 _SPEC_GATE_SINCE 的迴圈驗。rc:擋下 1;其餘 0。"""
    front = _spec_gate_front(env, node, no_run)
    if isinstance(front, int):
        return front
    _p, text, rel, rr, judged, rows_b, clauses, keeps, (split, default, methods_for, plats, names) = front
    door = judged["door"]
    def per_prof(plat):
        return (plats.get(plat) or {}).get("profile_name")
    items = _spec_gate_items(text, clauses, split, default)
    verdicts = {}
    if _spec_gate_runnable(items, plats):
        verdicts = _spec_gate_run_clauses(rr, plats, items, per_prof)
    counts = {k: sum(1 for v in verdicts.values() if v[0] == k) for k in ("red", "green", "weak")}
    reg_fail, reg_ok, reg_nodes = _spec_gate_regress(env, rel, rr, split, default, methods_for, per_prof, no_run)
    if not _spec_gate_print_regress(reg_fail, reg_ok, reg_nodes):
        return 1
    if door == "low" and not _spec_gate_print_twoway(clauses, keeps, verdicts):
        return 1
    summ = _clause_summary(clauses)
    print(f"[spec-gate] 匯總: 條款 {len(clauses)}/綁了 {summ['bound']}/靠人 {summ['manual']}/紅 {counts['red']}/綠 {counts['green']}/弱證據 {counts['weak']}/相依回歸 {reg_ok} 支綠" + (f"/keeps {len(keeps)}" if keeps else ""))
    if door == "low":
        print("[spec-gate] PASS(風險低):直接實作,不派審。條款的測試做綠了才推得上去(推送閘會跑留痕裡的每一支;改了條款要重跑這裡)")
    else:
        print("    紅=新行為還沒做、綠=既有行為或已做完,兩種都合法;風險高只印不擋。接著走:\n    lumos loop next")
    _spec_gate_record(env, rel, judged, text, rows_b, clauses, names, keeps, counts)
    note = " ".join(f"{cid}={verdicts[cid][0]}" for cid in sorted(verdicts, key=lambda x: int(x[1:]))) or "no-run"
    _append_governance_log(env.vault, [{"gate": "spec-gate", "kind": "spec-gate-run", "hard": False, "nodes": [rel],
                                        "note": f"door={door} clauses={len(clauses)} bound={summ['bound']} red={counts['red']} green={counts['green']} weak={counts['weak']} regress={reg_ok} {note}"}])
    return 0


def _spec_gate_latest_records(env):
    """審查帳裡每條迴圈最後一筆 kind=spec-gate 留痕 {loop: rec}(append 序)。"""
    import json as _j
    path = env.vault.parent / ".canary-log.jsonl"
    latest = {}
    if not path.exists():
        return latest
    for ln in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if not ln.strip():
            continue
        try:
            d = _j.loads(ln)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("kind") == "spec-gate" and d.get("loop"):
            latest[nfc(str(d["loop"]))] = d
    return latest


def _spec_gate_push_candidates(env, rr, vrel, touched):
    """推送前要查哪些計劃:範圍碰到的計劃檔,加上 lands_in/related/正文連結指向「被碰到的 Systems 節點或被改程式檔的家」的 doing 計劃。"""
    plans = {t[len(vrel) + 1:] for t in touched if t.startswith(vrel + "/Projects/") and t.endswith(".md")}
    systems = {t[len(vrel) + 1:-3] for t in touched if t.startswith(vrel + "/Systems/") and t.endswith(".md")}
    code = [t for t in touched if not t.startswith(vrel + "/")]
    if code:   # 實作提交常只動程式檔不動筆記(編排者實測 E2):被改的檔的家也算被碰到——家對照表走唯一算法 _impact_home_map(代碼審 r2 架構席:自己掃 about_code 會漏掉 status 過濾與路徑正規化)
        homes, _own = _impact_home_map(env)
        for f in code:
            for srel in homes.get(_nodehome_key(f), []):
                systems.add(srel[:-3] if srel.endswith(".md") else srel)
    if systems:   # 落點被碰到:lands_in/related/正文連結任一指向被改的 Systems 節點(跟門判定訊號 2 同一份連結來源)
        for prel, n in env.notes.items():
            if not prel.startswith("Projects/") or str(n.fields.get("status")) != "doing":
                continue
            try:
                ptxt = (env.vault / prel).read_text(encoding="utf-8-sig")
            except (OSError, UnicodeDecodeError):
                ptxt = ""
            if set(_plan_system_links(n, text=ptxt, systems_only=False)) & systems:
                plans.add(prel)
    return plans


def _head_is_shebang(head):
    """檔案開頭那段 bytes 的第一行是不是 #!(每支檔有家與 _is_code_file 共用這一支——代碼審 r2 架構席:別各寫一份)。"""
    return bool(head) and head[:200].split(b"\n", 1)[0].startswith(b"#!")


def _is_code_file(rr, path, base=None):
    """「需要有家的程式檔」判定(每支檔有家同一套):副檔名在清單裡=是;沒副檔名要看首行是不是 #!(.gitignore/Makefile 這種不是)。
    磁碟上沒有(這次被刪)就從範圍起點 base 讀;兩邊都讀不到★保守當程式檔★(代碼審 r2 通才席 blocker:刪掉 hook 本身被判成沒程式檔 → light 漏派審)。
    豁免層也同一套(代碼審 r3 通才席):排除 glob(docs/*、node_modules、bin…)、測試檔、.lumos/config 的 ignore——這些每支檔有家不要求有家,這裡也不算程式檔。"""
    import fnmatch as _fn
    if any(_fn.fnmatch(path, g) for g in _NODEHOME_EXCLUDE_GLOBS) or _nodehome_is_test(path):
        return False
    try:
        if _cochange_excluded(path, _nodehome_config(rr)["ignore"]):
            return False
    except Exception:
        pass
    kind = _nodehome_code_kind(path)
    if kind == "ext":
        return True
    if kind != "shebang?":
        return False
    try:
        with open(Path(rr) / path, "rb") as f:
            return _head_is_shebang(f.read(200))
    except OSError:
        pass
    if base:
        try:
            g = subprocess.run(["git", "-C", str(rr), "show", f"{base}:{path}"], capture_output=True, errors=None)
            if g.returncode == 0:
                return _head_is_shebang(g.stdout[:200])
        except OSError:
            pass
    return True


def _sc_changed_files(rr, git_range, vrel):
    """小改動閘的改動清單 [(新路徑, 新增, 刪除, 二進位, 舊路徑)];算不出回 (None, 原因)。
    用 -z:改名印成 la\tld\t\0舊\0新\0 各自完整欄位(r3 架構席:repo 慣例是 -z + 欄位,不自刻正則解 {a => b};r2 通才席:純改名的大檔不算重寫)。
    帳本/卷證/筆記不算程式改動;★從程式目錄搬進卷證目錄的不豁免★(r3 通才席:路徑前綴是內容無關的過濾器,搬進去就能躲掉四維度)。"""
    try:
        r = subprocess.run(["git", "-C", str(rr), "-c", "core.quotePath=false", "diff", "--numstat", "-z", git_range, "--"], capture_output=True, text=True, errors="replace")
    except OSError as e:
        return None, f"算不出改動量({e})"
    if r.returncode != 0:
        return None, f"範圍 {git_range} 算不出來"
    def _bk(x):
        return x in _BOOKKEEPING_FILES or x.startswith(_BOOKKEEPING_DIRS) or (vrel and x.startswith(vrel + "/"))
    files, toks, i = [], r.stdout.split("\0"), 0
    while i < len(toks):
        t = toks[i]
        i += 1
        if not t.strip():
            continue
        parts = t.split("\t")
        if len(parts) == 3 and parts[2]:
            la, ld, path, old = parts[0], parts[1], parts[2], parts[2]
        elif len(parts) in (2, 3) and i + 1 < len(toks):   # 改名:第三欄空,下兩個欄位是舊路徑、新路徑
            la, ld = parts[0], parts[1]
            old, path = toks[i], toks[i + 1]
            i += 2
        else:
            continue
        path, old = nfc(path.strip()), nfc(old.strip())
        if _bk(path) and _bk(old):
            continue
        binary = not (la.isdigit() and ld.isdigit())   # numstat 對二進位檔印 -\t-:算不出量(r1 通才席:記成 0 會讓相對量恆過)
        files.append((path, int(la) if la.isdigit() else 0, int(ld) if ld.isdigit() else 0, binary, old))
    return files, None


def _sc_diffusion(env, rr, files, links, base=None):
    """擴散:檔數/目錄數上限、每支都在計劃落點(lands_in/related 節點的 about_code)內。"""
    C, bad = _SMALL_CHANGE, []
    code = [f for f in files if _is_code_file(rr, f[0], base)]   # 擴散與落點只算需要有家的程式檔;文件/圖/資料只在相對量那一維度算(2026-09-18:README+圖把目錄數撐破)
    dirs = {str(Path(f[0]).parent) for f in code}
    if len(code) > C["max_files"] or len(dirs) > C["max_dirs"]:
        bad.append(f"擴散:碰了 {len(code)} 個程式檔/{len(dirs)} 個目錄,小改動上限 {C['max_files']} 檔/{C['max_dirs']} 目錄")
    _homes, own = _impact_home_map(env)
    allowed = set()
    for lk in links:
        allowed |= own.get(lk + ".md", set()) | own.get(lk, set())
    # 落點只查「需要有家的程式檔」(每支檔有家同一套定義 _nodehome_code_kind);README/圖/JSON 這種不需要家的檔只算檔數與改動量(2026-09-18 實測:改 README 被判落點外)
    outside = [f[0] for f in code if _nodehome_key(f[0]) not in allowed]
    if outside:
        bad.append("落點外:" + "、".join(outside[:5]) + (f" 等 {len(outside)} 支" if len(outside) > 5 else "") + "(計劃 lands_in/related 那些節點的 about_code 沒列它)")
    return bad


def _sc_churn(rr, git_range, files):
    """相對量:每檔 (新增+刪除) ≤ 原本行數×比例 或 ≤ 絕對上限;二進位算不出量不當小改動;原本行數用舊路徑查 base 樹(r3 通才席)。"""
    C, bad = _SMALL_CHANGE, []
    base = _range_base(rr, git_range)   # 三點範圍要 merge-base(代碼審 r2 架構席:同檔同算法要收斂成一份)
    for path, la, ld, binary, old in files:
        if binary:
            bad.append(f"相對量:{path} 是二進位檔,算不出改動量,不當小改動")
            continue
        churn = la + ld
        if churn <= C["max_abs_lines"]:
            continue
        lt = None
        if base:
            g = subprocess.run(["git", "-C", str(rr), "show", f"{base}:{old}"], capture_output=True, text=True, errors="replace")
            lt = len(g.stdout.splitlines()) if g.returncode == 0 else 0
        if lt is None or churn > lt * C["max_rel_churn"]:
            bad.append(f"相對量:{path} 改了 {churn} 行(原本 {lt if lt is not None else '?'} 行),超過 {int(C['max_rel_churn'] * 100)}% 也超過 {C['max_abs_lines']} 行")
    return bad


def _sc_history(env, rr, files, links):
    """歷史:落點掛 risk/ 標籤、碰到裁判檔(錨點清單/scripts/hooks/)、近 N 天逃逸帳有同落點的列。"""
    C, bad = _SMALL_CHANGE, []
    for lk in links:
        hn = env.notes.get(lk + ".md") or env.notes.get(lk)
        if hn is not None and any(str(t).startswith("risk/") for t in as_list(hn.fields.get("tags"))):
            bad.append(f"歷史:落點 {lk} 掛了風險標籤,不算小改動")
    anchors = set()
    try:   # 錨點清單走既有路徑常數與解析寫法(r1 架構席)
        import json as _j
        anchors = {nfc(str(k)) for k in (_j.loads((rr / _ANCHOR_BASELINE_REL).read_text(encoding="utf-8")).get("anchors") or {})}
    except (OSError, ValueError, AttributeError):
        pass
    judge = [f[0] for f in files if f[0] in anchors or f[0].startswith("scripts/hooks/")]
    if judge:
        bad.append("歷史:碰到裁判檔(hook/錨點):" + "、".join(judge[:5]))
    import datetime as _dt
    cutoff_str = (_dt.datetime.now().astimezone() - _dt.timedelta(days=C["escape_days"])).isoformat()
    cutoff_key = _loop_ts_key(cutoff_str)
    for e in _escape_rows_for(env):
        k = _loop_ts_key(str(e.get("ts", "")))   # 換算 UTC 再比(r1 兩席);解析不動退回字串比對(r2 複核)
        too_old = (str(e.get("ts", "")) < cutoff_str) if (k is None or cutoff_key is None) else (k < cutoff_key)
        if too_old or not e.get("plan"):
            continue
        en = env.notes.get(str(e["plan"]))
        if en is not None and set(_plan_system_links(en)) & set(links):
            bad.append(f"歷史:近 {C['escape_days']} 天逃逸帳有同落點的列(迴圈 {e.get('loop')},{str(e.get('ts'))[:10]}),這個落點最近出過事")
            break
    return bad


def _small_change_check(env, rr, git_range, prel, note):
    """全靠人驗的風險低計劃的推送閘:回沒過的原因清單(空=過)。四維度各一支:擴散 _sc_diffusion、相對量 _sc_churn、歷史 _sc_history、目的(計劃連 Issues 不算小改動)。"""
    try:
        vrel = str(env.vault.resolve().relative_to(rr)).replace(os.sep, "/")
    except ValueError:
        vrel = None
    files, err = _sc_changed_files(rr, git_range, vrel)
    if files is None:
        return [err]
    if not files:
        return []
    links = _plan_system_links(note)
    base = _range_base(rr, git_range)
    bad = _sc_diffusion(env, rr, files, links, base) + _sc_churn(rr, git_range, files) + _sc_history(env, rr, files, links)
    try:
        ptxt = (env.vault / prel).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError):
        ptxt = ""
    if any(str(lk).startswith("Issues/") for lk in _plan_system_links(note, text=ptxt, systems_only=False)):
        bad.append("目的:計劃連到 Issues(修 bug),缺陷率高於新功能,不算小改動")
    return bad


def _spec_gate_push_stale(env, rr, prel, n, rec):
    """推送前先驗留痕還算不算數:讀得到、綁得到、門重判仍是雙向、條款指紋沒變。回原因或 None。"""
    try:
        text = (env.vault / prel).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError) as e:
        return f"{prel}:讀不成文字({e.__class__.__name__})"
    rows_b, err = _clause_bindings_for(env, text, root=rr)
    if err:
        return f"{prel}:測試索引建不起來({err})"
    now = _door_judge(env, n, text)   # ★門整個重判★(代碼審 r1 F1 blocker):指紋只蓋條款與理由,正文塞進關鍵字、補 risk/ 標籤、改 door 欄位都要在這裡被抓到
    if now["door"] != "low":
        return f"{prel}:留痕時風險低,現在判成風險高({';'.join(now['signals'][:3]) or '實務隱患節缺已排除行:' + '、'.join(now['missing'])})——風險低的放行不再成立,改走設計審或把訊號拿掉後重跑 lumos spec-gate {Path(prel).stem}"
    if _clause_block_sha(text, rows_b, now["linked"], now["exclusions"]) != rec.get("clause_sha"):
        return f"{prel}:風險低留痕過期(條款、測試名、已排除理由、或它連到的節點的合約/標籤變了),重跑 lumos spec-gate {Path(prel).stem}"
    return None


def _spec_gate_push_one(env, rr, prel, n, rec, idx):
    """推送前查一份風險低計劃:回 (沒過的原因或 None, 全綠時的一行)。idx=(split, default, methods_for, plats, git_range)。"""
    P = "[spec-gate 推送前]"
    stale = _spec_gate_push_stale(env, rr, prel, n, rec)
    if stale:
        return stale, None
    tests = [str(t) for t in (rec.get("tests") or [])]
    loop_id = _loop_id_for_plan(prel)
    if not tests:   # 全靠人驗:沒有測試可跑,改跑小改動閘(四維度全過才放行)
        sc = _small_change_check(env, rr, idx[4], prel, n)
        if sc:
            return f"{prel}:全靠人驗的風險低計劃,這次改動不算小改動——" + ";".join(sc) + f"(補測試、縮小改動、或升成風險高走設計審;規則版本 {_SMALL_CHANGE_RULE_VERSION})", None
        return None, f"{P} ✓ {Path(prel).stem}:全靠人驗,改動通過小改動閘(擴散/相對量/歷史/目的四維度)"
    split, default, methods_for, plats, _rng = idx
    items = [(loop_id, pl, m, "real" if m in methods_for(pl) else "dangling") for t in tests for pl, m in resolve_test_refs(f"[test:{t}]", split, default)]
    tails = {}
    results, rerr = _run_bound_tests(rr, items, tails=tails)
    if results is None:
        return f"{prel}:留痕裡的測試跑不起來({rerr})", None
    reds = []
    for node_id, pl, m, verdict, detail, _secs in results:
        nn, sk = _ran_count((plats.get(pl) or {}).get("profile_name"), tails.get((node_id, pl, m), ""))
        v, why = _spec_gate_verdict(nn, sk, verdict, detail)
        if v != "green":
            reds.append(f"{m}:{'紅' if v == 'red' else why}")
    if reds:
        try:   # 逃逸自動記:風險低計劃沒人審,推送閘擋下就是下游抓到的洞(fail-open,記不成不影響擋)
            _auto_escape(env, "push-gate", "major", f"推送閘擋下:風險低計劃 {Path(prel).stem} 的條款測試沒全綠({reds[0][:60]})",
                         [(loop_id, prel)], _git_head(rr), source="spec-gate-push")
        except Exception as _ex:
            _escape_auto_failed(env, loop_id, "push-gate", str(_ex))
        return f"{prel}:留痕裡的測試沒全綠——" + "、".join(reds), None
    return None, f"{P} ✓ {Path(prel).stem}:留痕裡的 {len(tests)} 支測試全綠({'、'.join(tests)})"


def _spec_gate_push_scan(env, rr, plans, git_range):
    """逐份查有風險低留痕的 doing 計劃;回 (沒過的原因清單, 過了的 [(計劃, 全靠人驗)]),全綠的當場印一行;平台設定讀不動印一句回 (None, [])(放行)。"""
    latest = _spec_gate_latest_records(env)
    bad, oks, idx = [], [], None
    for prel in sorted(plans):
        n = env.notes.get(prel)
        if n is None or str(n.fields.get("status")) != "doing":
            continue
        rec = latest.get(nfc(_loop_id_for_plan(prel)))
        if not rec or _rec_plan_risk(rec) != "low":
            continue
        if idx is None:
            try:
                _, split, default, methods_for, _hay = _platform_test_index(rr)
                idx = (split, default, methods_for, load_platforms(rr)["platforms"], git_range)
            except (ValueError, OSError) as e:
                print(f"[spec-gate 推送前] 平台設定讀不動({e}),放行")
                return None, []
        why, ok_line = _spec_gate_push_one(env, rr, prel, n, rec, idx)
        if why:
            bad.append(why)
        else:
            oks.append((prel, not (rec.get("tests") or [])))
            if ok_line:
                print(ok_line)
    return bad, oks


def _spec_gate_push_check(env, git_range, repo=None):
    """推送前(雙向門放行_計劃 S11-S14/S21/S23/S25):範圍碰到的計劃檔、加上連到「被碰到的 Systems 節點或被改程式檔的家」的 doing 計劃,
    有風險低留痕的 → 先把門整個重判(不再雙向擋)、條款指紋對得上才算留痕有效、留痕裡的測試全綠才准推。風險低不派審,這裡是它唯一的閘。
    rc1 擋、0 過;算不出範圍/索引 fail-open 印一句回 0(擋不了≠沒事,但推送閘不能因為工具壞而擋所有人)。"""
    P = "[spec-gate 推送前]"
    rr = Path(repo).resolve() if repo else _vault_repo_root(env)
    try:
        r = subprocess.run(["git", "-C", str(rr), "-c", "core.quotePath=false", "diff", "--name-only", git_range, "--"],
                           capture_output=True, text=True, errors="replace")
    except OSError as e:
        print(f"{P} 算不出範圍({e}),放行")
        return 0
    if r.returncode != 0:
        print(f"{P} 範圍 {git_range} 算不出來,放行")
        return 0
    try:
        vrel = str(env.vault.resolve().relative_to(rr)).replace(os.sep, "/")
    except ValueError:
        print(f"{P} 圖譜不在這個 repo 底下,放行")
        return 0
    touched = [nfc(ln.strip()) for ln in r.stdout.splitlines() if ln.strip()]
    plans = _spec_gate_push_candidates(env, rr, vrel, touched)
    if not plans:
        return 0
    bad, oks = _spec_gate_push_scan(env, rr, plans, git_range)
    if bad is None:
        return 0
    if not bad and oks and all(mo for _p, mo in oks):   # 計劃風險低+全靠人驗+小改動閘過 → 改動風險分級 light(2026-09-18 Enzo 裁;pitfalls/code-loop 都是 vault-free,只有這裡有圖譜)
        print(f"{P} 改動風險分級:light(計劃風險低且全靠人驗,小改動閘通過:{'、'.join(Path(p).stem for p, _m in oks)})——代碼審只派架構對齊席;lumos loop next <編號> --tier light")
    if bad:
        print(f"{P} ✗ — {len(bad)} 份風險低計劃沒過(風險低不派審,推送閘是它唯一的閘):")
        for x in bad:
            print(f"    • {x}")
        print("    規格閘要紅、推送閘要綠,兩頭夾住:把條款的測試做綠再推;留痕過期就重跑 lumos spec-gate <計劃>")
        return 1
    return 0


def cmd_spec_trace(env, node, as_json=False):
    """條款級追溯(RTM 輕量版):計劃 body 的 [SN] 條款 × 條款那一行綁的 [test:]/[manual:](裁決欄,2026-09-08 起)
    × 回指 Verification 的認領(舊制對照欄)。rc:有未標條款=1;全標(綁了/靠人,懸空只提醒)=0;計劃無 [SN]=0(opt-in 未啟用)。唯讀。"""
    import json
    rel = env.find(node)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {node} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return 2
    plan_stem = env.notes[rel].stem
    try:
        text = (env.vault / rel).read_text(encoding="utf-8-sig")
    except OSError as ex:
        print(f"擋下:{ex}", file=sys.stderr)
        return 2
    ids = sorted({int(m) for m in SPEC_CLAUSE_RE.findall(text)})
    if not ids:
        if as_json:
            print(json.dumps({"plan": rel, "clauses": {}, "unclaimed": [],
                              "opt_in": False}, ensure_ascii=False))
        else:
            print(f"(opt-in 未啟用) {rel} 無 [SN] 條款標記——要追溯就在規格 bullet 加 [S1]/[S2]…")
        return 0
    claims = {i: [] for i in ids}
    for vrel, n in env.notes.items():
        if not vrel.startswith("Verification/"):
            continue
        prs = n.fields.get("plan_refs")
        prs = prs if isinstance(prs, list) else ([prs] if prs else [])
        if not any(plan_stem in str(x) for x in prs):
            continue   # 沒回指本計劃的提及不算認領(防偶然文字)
        # 已知設計限制:多計劃 Verification 提及 [S1] 會同時記入兩計劃的 S1
        # (條款 ID 只有數字無計劃域)——一篇 Verification 盡量只回指一個計劃
        try:
            vtext = (env.vault / vrel).read_text(encoding="utf-8-sig")
        except OSError:
            continue
        for m in SPEC_CLAUSE_RE.findall(vtext):
            i = int(m)
            if i in claims:
                claims[i].append(vrel)
    unclaimed = [i for i in ids if not claims[i]]
    # 條款綁測試算進度 [S3](2026-09-08):★單一裁決來源=條款行綁的測試★;舊制「驗證筆記回指」欄保留印出、只當對照。
    binds, berr = _clause_bindings_for(env, text)
    bmap = {b["id"]: b for b in binds}
    untagged = [f"S{i}" for i in ids if bmap.get(f"S{i}", {}).get("state") in ("untagged", "duplicate", "shadowed")]
    summ = _clause_summary([b for b in binds if b["state"] != "undefined"])
    # 非定義=從沒在行首定義的(行內引用),或只在反引號裡出現的(遮掉後根本掃不到、不在 binds 裡)
    summ["undefined"] = sum(1 for b in binds if b["state"] == "undefined") + sum(1 for i in ids if f"S{i}" not in bmap)
    if as_json:
        print(json.dumps({"plan": rel, "clauses": {f"S{i}": claims[i] for i in ids},
                          "unclaimed": [f"S{i}" for i in unclaimed],
                          "bindings": {b["id"]: {k: b[k] for k in ("state", "refs", "manual", "line")} for b in binds},
                          "untagged": untagged, "binding_summary": summ, "binding_index_error": berr,
                          "ruling": "binding"}, ensure_ascii=False))
    else:
        if berr:
            print(f"提醒:測試索引建不起來({berr}),綁定欄全印「索引不可得」;先修 .lumos/config.json 的 test 設定", file=sys.stderr)
        for i in ids:
            b = bmap.get(f"S{i}")
            st = _CLAUSE_STATE_ZH[b["state"]] if b else ("索引不可得" if berr else "非定義(只在反引號裡出現,不算條款)")
            tail = ""
            if b and b["refs"]:
                tail = " ← " + ", ".join(b["refs"])
            elif b and b["manual"]:
                tail = " ← " + "; ".join(b["manual"])
            mark = "✓" if (b and b["state"] in ("bound", "manual")) else ("✗" if (b and b["state"] in ("untagged", "duplicate", "shadowed")) else "⚠")
            if (b and b["state"] == "undefined") or (not b and not berr):
                mark = "·"
            who = ", ".join(Path(x).stem for x in claims[i]) or "無"
            print(f"{mark} [S{i}] {st}{tail}(舊制回指:{who})")
        hang = sum(summ[_st] for _st in _CLAUSE_HANG_STATES)
        n_cl = len(ids) - summ["undefined"]
        print(f"\n{n_cl} 條款 / 未標 {len(untagged)} / 靠人 {summ['manual']} / 綁了 {summ['bound']} / 懸空 {hang}"
              f"(寫錯 {summ['dangling']}·設定認不到 {summ['unrecognized']}·只被提到 {summ['mentioned']})/ 壞名 {summ['bad-name']}"
              + (f" / 非定義 {summ['undefined']}(只在範例/引用裡出現,不算條款)" if summ["undefined"] else "")
              + f";舊制(驗證筆記回指)未認領 {len(unclaimed)}")
        if untagged:
            print("為什麼在意:未標的條款沒人能機械判它做到沒,設計審處置閘會擋。")
            print("    每條要嘛在那一行綁 [test:測試名],要嘛寫 [manual:一句怎麼驗];沒有測試可掛也得講清楚靠人怎麼驗")
    return 1 if untagged else 0


def cmd_signoff(env, node, note, by=None):
    """業務簽核留痕(validation 那半):人對業務正確性點頭 → ledger+frontmatter 戳記。
    工具只記留痕,不證明確認真的發生(同 audit/self-audit 的誠實前提)。"""
    import json
    import datetime
    import subprocess
    if not (note or "").strip():
        print("擋下:簽核一定要帶 --note 寫你確認了什麼,給以後的人看", file=sys.stderr)
        return 2
    rel = env.find(node)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {node} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return 2
    today = datetime.date.today().isoformat()
    commit = ""
    try:
        commit = subprocess.run(["git", "-C", str(env.vault.parent), "rev-parse", "--short", "HEAD"],
                                capture_output=True, text=True, errors="replace").stdout.strip()
    except OSError:
        pass
    log = env.vault.parent / ".signoff-log.jsonl"
    try:
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"ts": datetime.datetime.now().isoformat(timespec="seconds"),
                                 "node": rel, "by": by or "", "note": note,
                                 "commit": commit}, ensure_ascii=False) + "\n")
    except OSError as ex:
        print(f"擋下:簽核記錄寫不進去: {ex}", file=sys.stderr)
        return 2
    rc = cmd_set(env, rel, "signed_off", today)
    if rc != 0:
        print("⚠ ledger 已記但 frontmatter 戳記失敗(見上)", file=sys.stderr)
        return rc
    print(f"✓ signoff {rel} — {today}{('(' + by + ')') if by else ''}: {note[:60]}")
    return 0


# ★gov --stats 的 gate 全集★(2026-08-20,計劃:Projects/閘觸發帳統計_計劃)
# 為什麼要有這張表:統計若只「掃帳裡出現過的 gate」,零筆的 gate 永遠不會出現——而「哪幾道
# 閘從沒響過」正是這個功能的重點。漂移由 t_gov_stats_gate_drift 機械擋(掃全檔 gate 字面值)。
# L3(驗證腐化佇列)2026-08-22 拆出:寫帳的 hook 8/21 已撤,留在清單只是假名額(Issues/只退場不痛的機制)
_KNOWN_GATES = ("L2", "anchor-approve", "canary", "check-cascade", "check-revisit", "check-e1", "delguard", "check-e2", "check-e3", "check-lint-decl", "doctor-run",
                "check-j", "check-k", "check-r", "check-s", "check-s2", "check-s3", "check-s4",
                # 2026-09-10 節點範圍與索引守衛:條款測試名懸空 / 索引漏列 / 合約多到讀不完
                "check-s5", "check-s6", "check-s7", "ci", "code-loop", "design-loop", "kill", "signoff", "bound-tests",
                "daily-wrapper", "ledger-growth",
                # #19 S1:擋人/放行/被跳過的事件會用到這兩個閘名(code-loop 已在上面)
                "anchor", "pitfalls",
                # 2026-09-17 逃逸自動記 fail-open 失敗留痕(escape-auto-failed)與規格閘每次跑的觀測行(spec-gate-run)
                "escape-auto", "spec-gate",
                # 2026-09-11 每支檔有家:提交前/推送前的檢查、健檢三段(沒家的檔/寫了別人的檔名/管太多沒寫負責範圍)
                "nodehome-check", "check-s8", "check-s9", "check-s10",
                # 2026-09-13 新增告警閘:環境不可用自動放行、擋下新增告警,兩種事件都用這個閘名
                "lint-new",
                # 2026-09-12 推筆記認家:健檢新段(重建出來卻不管檔的節點 / 管了卻連檔名都沒提到的配對)
                "check-s11")

# 未出現清單旁的限制聲明。★單一常數★——測試比對此常數,不在測試裡複製字串
# (逐字重複的斷言等於沒斷言)。另有一條斷言釘它含哪幾個子句,防被掏空只留殼。
_STATS_ABSENT_DISCLAIMER = (
    "  未出現 ≠ 無用。本帳看不到硬擋事件(anchor verify 擋下 push 時不寫任何帳),也分不出四種\n"
    "  「沒出現」:跑了沒事／接了帳但沒被觸發／守的功能從沒被用過／本次執行根本沒載入該來源\n"
    "  (ci 帳是條件載入)。要拿這份清單談退場,先確認該閘在本帳的 gate 名單之內、且來源本次有載入。"
)


# 哪些 gate 的 nodes 欄語意不是「圖譜節點」。★為什麼要標★:anchor-approve 記的是錨點
# 檔案(ANCHOR_FILES:scripts/hooks/pre-push、scripts/test_lumos.py …),與其他 gate 的圖譜
# 節點名不同質,同欄並列會被誤讀成可互相比較。★不能用「值裡有沒有 /」偵測★——cmd_gov 的
# mapper 讀進來時已把路徑 stem 成 pre-push,偵測不到(2026-08-20 實作時測試翻紅抓到)。
_STATS_NODE_SEMANTICS = {"anchor-approve": "此來源記的是檔案路徑", "design-loop": "此來源記的是審查編號", "bound-tests": "no-config/no-pins 也記一筆,採用率看得見", "nodehome-check": "此來源記的是程式檔路徑(另有 pairs 欄記被擋的檔與節點配對)"}


def _render_gov_stats(rows, ded, loaded, since_days, cutoff, node, repo_root, escapes=None):
    """gov --stats:純數字報表 + 未出現清單。恆不影響 rc、不改既有輸出。
    repo_root=hook 事件檔所在的 repo 根,由呼叫端從 vault 反推(_vault_repo_root),必填、漏傳直接炸(r1 架構席:鄰居慣例不給預設);★不准用 cwd 的 git 根★——
    2026-09-08 實踩:測試用假 vault 時讀到真 repo 的事件檔,平行推送閘期間 hook 一直在追加,同一支測試兩次呼叫統計段就不同。
    ★三層數字不可互相冒充★:原始行(帳檔寫入)/去重列(本函式計數依據)/呈現行(預設畫面另折一層)。"""
    print()
    print("─" * 33)
    print(f"[stats] 載入源(這次實際讀了哪些帳): {', '.join(loaded) if loaded else '(無)'}")
    print(f"[stats] 窗口: 近 {since_days} 天(從 {cutoff} 起算)")
    if node:
        print(f"[stats] 提醒:已縮限到 {node} 這一篇,以下數字只看它,不是全庫")
    if not ded and not rows:
        print("  窗口內無資料")
        return
    agg = {}
    for src, bucket in ((rows, "raw"), (ded, "ded")):
        for r in src:
            a = agg.setdefault(r["gate"], {"raw": 0, "ded": 0, "nodes": set(),
                                           "commits": set(), "dates": set()})
            a[bucket] += 1
            if bucket == "ded":
                a["nodes"].update(n for n in r["nodes"] if n)
                if r["commit"]:
                    a["commits"].add(r["commit"])
                d = (r["ts"] or "")[:10]
                if len(d) == 10 and d[4] == "-":
                    a["dates"].add(d)
    print()
    print(f"  {'gate':16}{'去重後筆數':>10}{'原始行數':>10}{'不同 nodes 值數':>16}"
          f"{'不同 commit 數':>14}  {'首見日':10} {'末見日':10}")
    for g in sorted(agg):
        a = agg[g]
        nd = f"n/a" if not a["nodes"] else str(len(a["nodes"]))
        cm = "n/a" if not a["commits"] else str(len(a["commits"]))
        d1 = min(a["dates"]) if a["dates"] else "n/a"
        d2 = max(a["dates"]) if a["dates"] else "n/a"
        _sem = _STATS_NODE_SEMANTICS.get(g)
        tag = f"  ({_sem})" if (_sem and a["nodes"]) else ""
        print(f"  {g:16}{a['ded']:>10}{a['raw']:>10}{nd:>16}{cm:>14}  {d1:10} {d2:10}{tag}")
    absent = [g for g in _KNOWN_GATES if g not in agg]
    print()
    if node:
        print("  (只看單一節點時,有些帳本來就不記節點、一定是零,所以不列「哪些閘從沒出現」)")
    else:
        print(f"  這段時間完全沒觸發過的閘({len(absent)} 道):{', '.join(absent) if absent else '無'}")
        print(_STATS_ABSENT_DISCLAIMER)
    print()
    # 流程自產工作量(Issues/流程自產工作量未量測):處置帳裡標了 finding_kinds 的輪,算 code/spec/process 佔比
    fk = {"code": 0, "spec": 0, "process": 0}; fk_rounds = 0
    for r in rows:
        if r.get("gate") == "canary" and isinstance(r.get("finding_kinds"), dict):
            fk_rounds += 1
            for v in r["finding_kinds"].values():
                if v in fk: fk[v] += 1
    tot = sum(fk.values())
    if tot:
        print(f"  發現在修什麼(只算有標 --finding-kind 的 {fk_rounds} 輪,共 {tot} 條):程式缺陷 {fk['code']}({fk['code']/tot:.0%})、被審文件缺陷 {fk['spec']}({fk['spec']/tot:.0%})、流程自己要求的文件/留痕 {fk['process']}({fk['process']/tot:.0%})")
        print("  (process 佔比就是「流程自產工作量」;2026-08-22 起才有標,之前的輪沒資料)")
        print()
    # 辯方明確表態分布(2026-08-27,Systems/finding-refute):agree/evidence/concern 三態計數。
    # evidence(辯方降級的)是 2026-08-22「辯方三分類先不做」裁定重啟條件的候選池——
    # 抽驗這批有沒有「降錯、後來證明 finding 是真的」,有實例才用證據翻案。
    rv = {"agree": 0, "evidence": 0, "concern": 0}; rv_rounds = 0
    for r in rows:
        if r.get("gate") == "canary" and isinstance(r.get("refute_verdicts"), dict):
            rv_rounds += 1
            for v in r["refute_verdicts"].values():
                if v in rv: rv[v] += 1
    rvt = sum(rv.values())
    if rvt:
        print(f"  辯方怎麼表態(只算有標 --refute-verdict 的 {rv_rounds} 輪,共 {rvt} 條):同意是真的 {rv['agree']}、拿反證降級 {rv['evidence']}、只存疑無反證 {rv['concern']}")
        print("  (降級那批 evidence 是重啟條件的候選:回頭抽驗有沒有『降錯、後來證明是真的』;2026-08-27 起才有標)")
        print()
    # ── 表態閘副產品(Projects/棧別提問表態閘_計劃 S9,2026-09-09):按題目 id 彙總歷來四值;死題候選/觸發太窄候選 ──
    _dq, _rm = {}, {}
    for r in rows:
        if r.get("gate") != "code-loop":
            continue
        if r.get("kind") == "dispositions" and isinstance(r.get("dispositions"), dict):
            for _qid, _ent in r["dispositions"].items():
                if not isinstance(_ent, dict):
                    continue
                _b = _dq.setdefault(_qid, {"satisfied": 0, "na": 0, "todo": 0, "tension": 0, "auto-na": 0, "cand": 0, "cand-tension": 0})
                if _ent.get("auto"):
                    _b["auto-na"] += 1
                elif _ent.get("status") in ("satisfied", "na", "todo", "tension"):
                    _b[_ent["status"]] += 1
                # 候選張力(2026-09-09 兩席相反時端出張力):樣板帶的 hint 隨表態存進帳,這裡就是 REVISIT 的分母
                if _ent.get("hint") and not _ent.get("auto"):
                    _b["cand"] += 1
                    if _ent.get("status") == "tension":
                        _b["cand-tension"] += 1
        elif r.get("kind") == "recall-miss" and r.get("recall_miss"):
            _rm[r["recall_miss"]] = _rm.get(r["recall_miss"], 0) + 1
    if _dq or _rm:
        print("  棧別提問表態(表態閘,2026-09-09 起;每筆表態事件每題算一次,同 sha 重表態各算各的):")
        for _qid in sorted(_dq):
            _b = _dq[_qid]; _human = _b["satisfied"] + _b["na"] + _b["todo"] + _b["tension"]   # 分母含張力(r1 接手席 H4:8 na + 5 tension 不是死題)
            _tag = " ← 死題候選(人答 ≥10 次且全是不適用:題目不對或被敷衍,回頭裁刪題或加嚴)" if (_human >= 10 and _b["na"] == _human) else ""
            _cand = f"、候選題 {_b['cand']}(其中答 tension {_b['cand-tension']})" if _b["cand"] else ""
            print(f"    {_qid}:做到了 {_b['satisfied']}、不適用 {_b['na']}、待辦 {_b['todo']}、未觸發自動 {_b['auto-na']}、張力 {_b['tension']}{_cand}{_tag}")
        for _qid, _n in sorted(_rm.items()):
            print(f"    {_qid}:審查席抓到未觸發題的問題 {_n} 次" + (" ← 觸發太窄候選(修它的 when)" if _n >= 3 else "(累積 3 次列候選)"))
        print()
    # ── 審查有沒有用(審查有沒有用記帳 S3,2026-09-08):只算有 reported 欄的輪(2026-09-09 起才有) ──
    _by_round = {}
    for r in rows:
        if r.get("gate") == "canary" and r.get("loop") and r.get("round"):
            _by_round.setdefault((r["loop"], r["round"]), []).append(r)
    _ys = {k: _review_yield_round(v) for k, v in _by_round.items()}
    _ys = {k: y for k, y in _ys.items() if y["N"] is not None}
    _K = len(_ys)
    _rej = [r for r in ded if r.get("gate") == "canary" and r.get("kind") == "blocked"]   # kind=blocked 跟 anchor/code-loop「這次動作被擋」同字(r1 架構席 a3)
    if _K or escapes or _rej:   # 只有「被擋」沒有「記成」也要印(r1 f2):不然撞牆三次、一輪都沒補記=這段整個不見,正好是留 blocked 事件要防的盲點
        print("  審查有沒有用(只算有 reported 欄的 %d 輪,2026-09-09 起;人記的帳跟上面『閘的動作』那段可信度不同級,不要拿這裡的數字去算那裡的比率)" % _K)
        print("  (N 是機器從報告數的、R 是人填的;這段內部也不印比率、別自己算 Σ折/Σ報 當『審查有用率』)")
        if _K:
            _sum = lambda key: sum(y[key] for y in _ys.values() if y[key] is not None)
            _n_carrier = sum(1 for y in _ys.values() if y["has_carrier"])
            _n_r_known = sum(1 for y in _ys.values() if y["R"] is not None)
            _n_r_nonzero = sum(1 for y in _ys.values() if y["R"])
            _n_s_pos = sum(1 for y in _ys.values() if y["S"])
            print(f"    Σ席位報 {_sum('N')} → Σ存活 {_sum('M')} / Σ編排者重現不到 {_sum('R')} → Σ折 {_sum('F')} / Σ放行 {_sum('A')};存活多於席位報的輪 {_n_s_pos}(共 Σ{_sum('S')} 條)")
            print(f"    給回頭條件的兩個數:有載體的 {_n_carrier} 輪裡記了 refuted-set 的 {_n_r_known} 輪、其中非 0 的 {_n_r_nonzero} 輪;S>0 的輪 {_n_s_pos}")
            _recent = sum(1 for (lp, rd), v in _by_round.items() if (lp, rd) in _ys and any(str(x.get("ts", "")) >= cutoff for x in v))
            if _K < 5 or _recent < 3:
                print(f"    樣本太少,別下結論(K={_K},窗口內 {_recent} 輪;門檻 5/3 是暫用值)")
        if escapes is not None:
            _worst = max((e.get("severity", "minor") for e in escapes), key=lambda s: _SEV_ORDER.get(s, 0), default=None)
            print(f"    逃逸帳 {len(escapes)} 筆(審查放行後下游抓到的;最重 {_worst or '—'};歸因是人工判斷)")
        if _rej:
            _d = lambda r: str(r.get("detail", "") or r.get("note", ""))
            _rn = sum(1 for r in _rej if "report-not-normalized" in _d(r))
            _rf = sum(1 for r in _rej if "findings-over-reported" in _d(r))
            print(f"    記帳被寫側擋下 {len(_rej)} 次(報告沒正規化 {_rn} / 缺 refuted-set {len(_rej) - _rn - _rf} / findings 多於 reported {_rf});擋下後有沒有補記,對照上面 K 看")
        print()
    # 設計迴圈結案方式(工具鏈補強十件 #6):達上限卻從沒過關的審查編號 = 人裁放行。
    # 只看 gate=design-loop 的事件(2026-08-22 起才記;之前的迴圈沒帳,算不出來,這裡如實講)。
    dl = [r for r in ded if r.get("gate") == "design-loop"]
    if dl:
        by = {}
        for r in dl:
            for nd_ in (r.get("nodes") or []):
                by.setdefault(nd_, set()).add(r.get("kind"))
        conv = sum(1 for k in by.values() if "converged" in k)
        capped = sum(1 for k in by.values() if "cap-reached" in k and "converged" not in k and "rewrite" not in k)
        rewrote = sum(1 for k in by.values() if "rewrite" in k and "converged" not in k)
        print(f"  審查迴圈結案方式(只算有記帳的 {len(by)} 個編號):閘過了 {conv} 個、跑滿上限沒過關(人裁放行) {capped} 個、人裁判整份重寫收尾 {rewrote} 個"
              + (f"——人裁放行率 {capped / len(by):.0%}" if by else ""))
        print("  (2026-08-22 起 loop next / loop status 才會記這個帳;更早的迴圈沒資料,不在分母)")
        print()
    # ── 閘的硬擋 / 放行 / 被跳過(#19 S1-S3)────────────────────────────────
    # ★每一種新事件都要指名一個讀它的地方★——這裡就是那個地方。
    # 沒有消費者的帳只是更大的垃圾場;而這批新增的三種事件的消費者就是這一段。
    hard = [r for r in ded if r.get("kind") == "blocked"]
    skipped = [r for r in ded if str(r.get("kind", "")).startswith("skipped")]
    fo = [r for r in ded if r.get("kind") == "fail-open"]
    if hard or skipped or fo:
        print("  閘的動作(#19 起才有帳;更早的擋下與放行沒有紀錄,不在分母):")
        if hard:
            _by = {}
            for r in hard:
                _by[r.get("gate", "?")] = _by.get(r.get("gate", "?"), 0) + 1
            print("    硬擋 %d 次:%s" % (len(hard), "、".join(f"{k} {v}" for k, v in sorted(_by.items()))))
        if skipped:
            _by = {}
            for r in skipped:
                _by[r.get("gate", "?")] = _by.get(r.get("gate", "?"), 0) + 1
            print("    被跳過 %d 次:%s" % (len(skipped), "、".join(f"{k} {v}" for k, v in sorted(_by.items())))
                  + "  ← ★這一行是「哪一道最常被跳」的答案★")
        if fo:
            _by = {}
            for r in fo:
                _by[r.get("gate", "?")] = _by.get(r.get("gate", "?"), 0) + 1
            print("    檢查自己壞掉而放行(fail-open)%d 次:%s" % (len(fo), "、".join(f"{k} {v}" for k, v in sorted(_by.items()))))
            print("    (fail-open 是刻意設計——不為缺環境擋死推送;但每一次放行都要看得見,不然分不出哪一層沒生效)")
        print()

    # ── hook 最近有沒有真的跑過(#19 S4)────────────────────────────────────
    # ★次數放這裡,不放 enforcement 那張表★(r1 架構對齊席):那張是「當下狀態」,
    # 次數與時間序列是另一種性質的資料,這個 repo 已經有這一段在做聚合。
    # ★不印「注入 N 次」★——那是成效,派工鏡頭 d1 明令不量;這裡只講「活著沒」。
    _hp = Path(repo_root) / "governance" / "runtime" / "hook-events.jsonl"
    if _hp.exists():
        import json as _hj
        import datetime as _hd
        _cut = _hd.datetime.now().astimezone() - _hd.timedelta(days=since_days)
        _agg = {}
        for _ln in _hp.read_text(encoding="utf-8", errors="replace").splitlines():
            if not _ln.strip():
                continue
            try:
                _e = _hj.loads(_ln)
                _t = _hd.datetime.fromisoformat(str(_e.get("ts", "")))
            except ValueError:
                continue
            if _t.tzinfo is None or _t < _cut:
                continue
            _a = _agg.setdefault(_e.get("hook", "?"), {"ok": 0, "timeout": 0, "error": 0})
            if _e.get("kind") in _a:
                _a[_e["kind"]] += 1
        if _agg:
            print(f"  hook 近 {since_days} 天真的跑過幾次(成功 / 逾時 / 失敗):")
            for _k in sorted(_agg):
                _v = _agg[_k]
                print(f"    {_k}: 成功 {_v['ok']} / 逾時 {_v['timeout']} / 失敗 {_v['error']}")
            print("    (只有『成功跑完』算跑過;逾時與失敗分開列——在進入點記帳的做法會把它們算成生效)")
            print()
    print("  註:這張表是「去重後」的筆數,跟不加 --stats 的畫面行數不是同一套算法——預設畫面還會再折疊一次。")


def _render_gov_nags(ded, min_days):
    """機制空轉偵測(Issues/自足性審計提醒空轉四十六天 的出口,2026-08-22):
    同一道軟閘對同一篇筆記,從第一次提醒到最後一次提醒跨 ≥ min_days 天,而且最後一次提醒就在最近一次
    doctor 體檢那天(=還在喊、沒人理)。有就列出並回 rc1(給自主迴圈週報當訊號),沒有 rc0。
    只看 kind=warned 的軟閘;硬擋的本來就擋得住人,不會空轉。"""
    import datetime as _dt
    runs = [r["ts"] for r in ded if r.get("gate") == "doctor-run"]
    last_run = max(runs) if runs else None          # 完整時間戳:同一天處理完再體檢,要能當場消失
    span = {}   # (gate,node) -> [first_ts,last_ts,count]
    for r in ded:
        if r.get("kind") != "warned" or r.get("hard"):
            continue
        for nd in r.get("nodes") or []:
            k = (r["gate"], nd)
            t = r["ts"]
            if k not in span:
                span[k] = [t, t, 1]
            else:
                span[k][0] = min(span[k][0], t); span[k][1] = max(span[k][1], t); span[k][2] += 1
    out = []
    for (g, nd), (ft, lt, c) in span.items():
        f, l = ft[:10], lt[:10]
        try:
            days = (_dt.date.fromisoformat(l) - _dt.date.fromisoformat(f)).days
        except ValueError:
            continue
        # 「還在喊」= 最後一次提醒不早於最近一次體檢(體檢會先寫提醒再寫 doctor-run,同秒內算還在喊)
        still = (last_run is None) or (lt[:19] >= last_run[:19])
        if days >= min_days and still:
            out.append((days, g, nd, f, l, c))
    if not out:
        print(f"沒有空轉的提醒:沒有任何閘對同一篇連續喊超過 {min_days} 天還沒人理。")
        return 0
    out.sort(reverse=True)
    print(f"提醒:下面這些是「同一道閘對同一篇連續喊了 ≥{min_days} 天、最近一次體檢({(last_run or '?')[:16]})還在喊」的空轉清單,共 {len(out)} 組。")
    print("機制有在跑,只是沒人去看——要嘛處理那篇,要嘛承認這道提醒對它無效、把它降成不提醒。")
    for days, g, nd, f, l, c in out[:30]:
        print(f"  {days:>4} 天  {g:10} {nd}  ({f} → {l},喊了 {c} 次)")
    if len(out) > 30:
        print(f"  … 還有 {len(out) - 30} 組")
    print("處理完一篇後它自然從清單消失;要看某篇被哪幾道閘喊:lumos gov <篇名>")
    return 1


def cmd_gov(env, node=None, since_days=90, full=False, stats=False, nags=0):
    """唯讀彙整六帳(bypass/governance/canary/kill/signoff/ci;rot-queue 2026-08-22 拆出)→ 治理事件時間軸。
    本機開發可見性工具(非合規物)。L2 無 node → 對 Systems 為部分視圖。
    去噪(2026-07-25,呈現層——帳本身不動):同日同類 advisory(軟/warned/無 detail,如 Check S
    每次 doctor 全名單重喊)跨 commit 折疊 ×N、同群 >6 節點收單行摘要;--full 回完整逐筆。"""
    import json
    import datetime
    docs = env.vault.parent
    cutoff = (datetime.date.today() - datetime.timedelta(days=since_days)).isoformat()

    def stem(s):
        return Path(str(s)).stem.lower()

    rows = []
    loaded = []          # --stats 要印「本次實際載入哪幾源」(ci 帳是條件載入,非固定六本)

    def load(name, mapper):
        p = docs / name
        if not p.exists():
            return
        loaded.append(name.lstrip(".").replace("-log.jsonl", "").replace(".jsonl", ""))
        for line in p.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(mapper(json.loads(line)))
            except (ValueError, KeyError):
                continue

    load(".bypass-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": "L2", "kind": "bypassed", "hard": False, "nodes": [], "detail": d.get("subject", "")})
    # .rot-queue.jsonl(L3)2026-08-22 拆出:寫帳的 verification-rot-check 8/21 已撤,本機也沒有這個檔;留 loader 只是假名額。
    load(".governance-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": d.get("gate", "?"), "kind": d.get("kind", "?"), "hard": bool(d.get("hard")),
         "nodes": [stem(x) for x in d.get("nodes", [])], "detail": d.get("note", ""),
         # 審查有沒有用記帳(2026-09-09):記帳被寫側擋下(canary/blocked)每次各算一筆——同一個 commit 連撞三次
         # 本來會被 (commit,nodes,gate,kind) 折成一次,「擋下 N 次」就永遠是 1;拿 ts+note(note 含事件隨機碼)當第 5 鑑別子(同秒也分得開,r1 f5)
         # 表態閘(2026-09-09,r3 接手席 H1):同 sha 兩筆 dispositions / recall-miss 各算各的——鑑別子拿 written_at(事件時間,微秒),
         # 不拿 ts:ts 是 HEAD commit 時間,同一顆 sha 重表態兩筆一模一樣(r1 併發席 f3/合約測試席 f1 實測折成一筆)
         "token": ((d.get("ts", "") + d.get("note", "")) if (d.get("gate") == "canary" and d.get("kind") == "blocked")
                   else (d.get("written_at") or d.get("ts", "")) if (d.get("gate") == "code-loop" and d.get("kind") in ("dispositions", "recall-miss")) else ""),
         "dispositions": d.get("dispositions") if d.get("kind") == "dispositions" else None,
         "candidates": d.get("candidates") if d.get("kind") == "dispositions" else None,   # 候選張力題數(2026-09-09)
         "recall_miss": d.get("recall_miss") if d.get("kind") == "recall-miss" else None,
         # 每支檔有家(2026-09-11 [S27]):擋下事件的(檔,節點)配對——回頭條件要拿它列出「被逼出來的 about_code」
         "pairs": d.get("pairs") if d.get("gate") == "nodehome-check" else None})
    # 第 6 源:業務簽核留痕(validation:人對業務正確性點頭的日期/人/內容)。
    load(".signoff-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": "signoff", "kind": "signed", "hard": False,
         "token": d.get("ts", ""), "nodes": [stem(d.get("node", ""))],
         "detail": (d.get("by", "") + " " + d.get("note", "")).strip()})
    # 第 5 源:kill 殺傷力驗證留痕(guard kill 的 verdict 史)。
    load(".kill-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": "kill", "kind": d.get("verdict", "?"), "hard": False,
         "token": d.get("invariant", "") + d.get("ts", ""),   # 同節點多合約/多次不互吞(dedup 第5鑑別子)
         "nodes": [stem(d.get("node", ""))],
         "detail": f"{d.get('invariant','')[:28]} [{d.get('test','')}] {d.get('note','')}".strip()})
    # 第 4 源:canary 審計留痕(審計員可靠度史)。只此 mapper 輸出 token 鍵(供 dedup 鑑別)。
    load(".canary-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": "",
         "gate": "canary", "kind": d.get("kind", "?"), "hard": False, "nodes": [],
         "token": d.get("token", ""), "auditor": d.get("auditor") or "?",
         "findings": d.get("findings"), "severity": d.get("severity", ""),
         "finding_kinds": d.get("finding_kinds"),
         "refute_verdicts": d.get("refute_verdicts"),
         # 審查有沒有用記帳(2026-09-08):讀側算「報→存活→重現不到→折/放行」要的欄位,缺=舊帳=印 ?
         "loop": d.get("loop"), "round": d.get("round"), "reported": d.get("reported"),
         "findings_set": d.get("findings_set"), "refuted_set": d.get("refuted_set"),
         "folded_set": d.get("folded_set"), "accepted_set": d.get("accepted_set"),
         "report_sha256": d.get("report_sha256"),
         # [S2] second 行的 verdict/ref 併進 detail(否則分歧訊號在治理帳全程隱形)
         "detail": ((f"verdict={d.get('verdict','?')} ref={d.get('ref','')} · "
                     if d.get("kind") == "second" else "")
                    + (f"loop={d['loop']} sev={d.get('severity', '?')} · " if d.get("loop") else "")
                    + (d.get("auditor", "") + " " + d.get("note", "")).strip())})

    # 第 7 源:CI 回流帳(總開關——未宣告 ci 區塊即完全不 load,否則移除宣告後歷史事件仍顯示)
    _ci_root = _anchor_repo_root(None)
    if _ci_root and _ci_config(_ci_root)[0]:
        load(CI_LOG_NAME, lambda d: {"ts": d.get("ts", ""), "commit": d.get("sha", ""),
             "gate": "ci", "kind": d.get("conclusion", "?"), "hard": False, "nodes": [],
             "token": d.get("dedup_key", ""),
             "detail": f"{d.get('workflow', '')} {d.get('title', '')} {d.get('failed_step', '')}".strip()})

    rows = [r for r in rows if (r["ts"][:10] or "9999") >= cutoff]
    seen, ded = set(), []
    for r in sorted(rows, key=lambda r: r["ts"]):
        # canary 每筆 token 唯一 → 加 token 當第 5 鑑別子(舊三源無此鍵,.get 回 "");必須用 .get 不可 r["token"]
        k = (r["commit"], frozenset(r["nodes"]), r["gate"], r["kind"], r.get("token", ""))
        if k in seen:
            continue
        seen.add(k)
        ded.append(r)
    if node:
        q = stem(node)
        ded = [r for r in ded if q in r["nodes"]]
    if nags:
        return _render_gov_nags(rows, nags)   # 用去重前的原始列:去重鍵含 commit,兩次體檢間沒 commit 會折掉最後一次日期
    # ── 去噪(呈現層):advisory(軟/warned/無 token/無 detail)同(日,gate,kind,node)折 ×N;
    #    同(日,gate,kind)群 >6 節點再收單行摘要。canary/kill/signoff/L2 等有 detail/token 逐筆保留。
    def _is_advisory(r):
        if r.get("gate") == "delguard" and r["kind"] in ("ok", "degraded") and not r.get("token"):
            return True   # delguard 每 commit 一筆且帶 note(第三輪稽核:原條件要 detail 為空,永遠折不到)——同日折 ×N
        return (not r["hard"]) and r["kind"] == "warned" and not r.get("token") and not r["detail"]
    lines = []
    if full:
        for r in ded:
            mark = "硬擋" if r["hard"] else "軟"
            lines.append(f"{r['ts'][:10]} [{r['gate']}/{r['kind']}/{mark}] {','.join(r['nodes']) or '-'}  {r['detail'][:50]}")
            for _pf, _pn in (r.get("pairs") or [])[:20]:
                lines.append(f"      配對:{_pf} → {_pn}")
    else:
        agg = {}          # (date,gate,kind) -> {node: 次數}(保序靠 dict 插入序)
        for r in ded:
            # doctor-run 標記只畫 run 邊界,預設畫面隱藏(否則每次 --ci 一行灌版面);
            # ★只在印出迴圈 continue,不動 ded——ded 與 --stats 共用,濾掉就沒了棘輪分母★
            if r["gate"] == "doctor-run":
                continue
            if _is_advisory(r):
                g = agg.setdefault((r["ts"][:10], r["gate"], r["kind"]), {})
                nk = ",".join(r["nodes"]) or "-"
                g[nk] = g.get(nk, 0) + 1
                if g[nk] == 1:
                    r["_agg"] = (r["ts"][:10], r["gate"], r["kind"], nk)   # 首見佔位,維持時間軸位置
                else:
                    r["_drop"] = True
        for r in ded:
            if r.get("_drop") or r["gate"] == "doctor-run":   # 第二處印出迴圈同樣隱藏 run 標記
                continue
            mark = "硬擋" if r["hard"] else "軟"
            if r.get("_agg"):
                date, gate, kind, nk = r["_agg"]
                g = agg[(date, gate, kind)]
                if len(g) > 6:                      # 大群組:整群收一行(只在群內首筆時印)
                    if g.get("_printed"):
                        continue
                    g["_printed"] = True
                    names = [k for k in g if k != "_printed"]
                    xmax = max(v for k, v in g.items() if k != "_printed")
                    head = ",".join(names[:3])
                    print(f"{date} [{gate}/{kind}/{mark}] {len(names)} 節點({head}…) ×{xmax}")
                else:                               # 小群組:逐節點+×N 計次
                    n = g[nk]
                    print(f"{date} [{gate}/{kind}/{mark}] {nk}" + (f" ×{n}" if n > 1 else ""))
                continue
            print(f"{r['ts'][:10]} [{r['gate']}/{r['kind']}/{mark}] {','.join(r['nodes']) or '-'}  {r['detail'][:50]}")
    for ln in lines:
        print(ln)
    if node:
        print("\n(註:有兩類事件天生不帶節點或用別的鍵記,所以只看單一節點時這份清單不是全貌)")
    # canary missed 分帳(2026-07-10,borrow mutation 文獻:missed 類別要分類追蹤,
    # missed-rate 是一級指標非異常事件)。per-auditor 計數 + note 的 type=X best-effort 分佈。
    can = [r for r in ded if r["gate"] == "canary"]
    if can and not node:
        import re as _re
        by_aud = {}
        by_type = {}
        for r in can:
            aud = r.get("auditor", "?")  # record 原生欄位(終審 F2:解析 detail 字串在無 --auditor 時誤歸戶)
            st = by_aud.setdefault(aud, {"caught": 0, "missed": 0})
            st[r["kind"]] = st.get(r["kind"], 0) + 1
            m = _re.search(r"type=([\w-]+)", r["detail"])
            if m:
                tt = by_type.setdefault(m.group(1), {"caught": 0, "missed": 0})
                tt[r["kind"]] = tt.get(r["kind"], 0) + 1
        print("\ncanary 分帳(各審查員的漏抓率 missed-rate,這是最看重的一項):")
        for aud, st in sorted(by_aud.items()):
            tot = st["caught"] + st["missed"]
            if tot:
                print(f"  {aud}: caught {st['caught']} / missed {st['missed']}"
                      f" (missed-rate {st['missed']/tot:.0%})")
        if by_type:
            print("  型別分佈: " + " | ".join(
                f"{k}:{v['caught']}c/{v['missed']}m" for k, v in sorted(by_type.items())))
        # [S2] 第二判者分帳(否則 overturn 分歧只在 detail 字串裡、看不到彙總)
        _sec = [r for r in can if r["kind"] == "second"]
        if _sec:
            _ag = sum(1 for r in _sec if "verdict=agree" in r.get("detail", ""))
            _ov = len(_sec) - _ag
            print(f"  覆核紀錄: {len(_sec)} 筆(同意原判 {_ag} / 翻盤 {_ov}"
                  + (f" ← 分歧率 {_ov/len(_sec):.0%},翻盤的那幾輪值得回頭看" if _ov else "") + ")")
        # 對抗層增量帳(2026-07-26,borrow arXiv 2605.25665 實戰報告欄):折入=caught 輪辯方裁決後
        # 存活折入的真缺陷數——測試綠後仍被對抗層(canary 護審/辯方/跨家族)抓到,天生就是「測試漏掉的」。
        # 長期趨零=整套機關裝飾品該砍;這是驗證層對自己的驗證。missed 輪判決不採信不計;
        # findings 欄 2026-07-21(M1)起才有,舊輪無欄誠實另計不混入。
        fold_total, fold_sev, fold_aud, legacy_rounds = 0, {}, {}, 0
        for r in can:
            # none=停用制無植入輪(2026-08-14 d5):折入 findings 語意不變,照計——
            # 只讀 caught 會使本帳(文檔標一級指標)自停用日起永凍 0(終審 F2)
            if r["kind"] not in ("caught", "none"):
                continue
            fnd = r.get("findings")
            if fnd is None:
                legacy_rounds += 1
                continue
            fold_total += fnd
            if fnd:
                sv = r.get("severity") or "?"
                fold_sev[sv] = fold_sev.get(sv, 0) + fnd
                aud = r.get("auditor", "?")
                fold_aud[aud] = fold_aud.get(aud, 0) + fnd
        sev_s = " ".join(f"{k} {v}" for k, v in sorted(fold_sev.items())) or "無"
        aud_s = " · ".join(f"{k} {v}" for k, v in sorted(fold_aud.items())) or "無"
        legacy_s = f"(另 {legacy_rounds} 舊輪無 findings 欄不計)" if legacy_rounds else ""
        print(f"  對抗層增量帳(測試都綠了之後審查還抓到、折回去修的缺陷;長期趨零就代表這層審查沒用、該砍): "
              f"折入 {fold_total} 筆缺陷 [{sev_s}] | 依審計員: {aud_s} {legacy_s}".rstrip())
    _shown = len(ded) if full else sum(1 for r in ded if r["gate"] != "doctor-run")
    print(f"\n近 {since_days} 天共 {_shown} 筆治理事件")
    if stats:
        # 原始行也要吃 node 縮限,否則同一張表兩欄母體不同(去重欄已縮、原始欄沒縮)
        _raw = [r for r in rows if (not node) or stem(node) in r["nodes"]]
        _render_gov_stats(_raw, ded, loaded, since_days, cutoff, node, repo_root=_vault_repo_root(env), escapes=_escape_rows_for(env))
    return 0


CLUSTER_STATES = ("resolved", "accepted-minor", "disputed-major")


def _parse_clusters(raw):
    """M2 risk-cluster 寫側解析:--clusters '名=狀態,...' → (dict{名:狀態}, None) 或 (None, 錯誤訊息)。
    三態白名單;accepted-minor 需冒號內嵌理由(整筆單一 note 對多 accepted-minor 無法對應=模糊過帳);
    尾逗號空段靜默過濾,但過濾後空列表=rc2(帶旗標即須有效內容,無「空字串=未帶」特例);
    設計:Projects/design-loop提效_計劃 M2(golden: governance/golden/dloop-m2-cluster)。"""
    parts = [p.strip() for p in str(raw).split(",") if p.strip()]
    if not parts:
        return None, "帶了 --clusters 但無有效內容(空字串/全逗號)"
    out = {}
    for p in parts:
        if "=" not in p:
            return None, f"段缺 '='(格式 名=狀態): {p!r}"
        name, state = p.split("=", 1)
        name, state = name.strip(), state.strip()
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,63}", name):
            return None, f"cluster 名非法(kebab 短 slug:小寫英數起頭+[-_],≤64): {name!r}"
        base = state.split(":", 1)[0]
        if base not in CLUSTER_STATES:
            return None, f"狀態 {base!r} 不在白名單 {'/'.join(CLUSTER_STATES)}"
        if base == "accepted-minor":
            if ":" not in state or not state.split(":", 1)[1].strip():
                return None, f"accepted-minor 需逐 cluster 內嵌理由(accepted-minor:理由): {p!r}"
        elif state != base:
            # resolved/disputed-major 必須精確相等——夾帶冒號後綴=未定義第四態(帳面破三態白名單)
            return None, f"狀態 {state!r} 夾帶後綴(僅 accepted-minor 可帶冒號理由)"
        if name in out:
            return None, f"同輪同名 cluster 重複: {name!r}"
        out[name] = state
    return out, None


LOOP_TIERS = ("light", "standard", "high")

# 嚴重度綁定機械掃 [S1](2026-08-26):severity 值序單一常數——原三處字面複製
# (panel 合取/cluster 閘/CLI choices)回填;寫側與掃描器共用,禁第四份(同 _quote_rows 單一實作鐵則)。
_SEV_ORDER = {"clean": 0, "minor": 1, "major": 2, "blocker": 3}
# 生效日:只給讀側([S2] 歷史掃分新舊帳)消費;寫側每筆 ts 天生=now 恆為「新」,
# 不刻 ts 分支,更嚴禁為了豁免而加 --ts/backdate 覆寫(=時戳造假後門)。(r2 delta d-f5)
# 設隔日不設當日:合入日(08-26)白天經舊碼寫入的帳列若被標「寫側 bug」是誤告——
# 日粒度切不開同日先後,保守往後推一天;當晚合入後的新列反正被寫側硬擋,只是掃描器標籤軟一階。
_SEV_WRITESIDE_CUTOFF = "2026-08-27"
# 改制回測 [S2]:判定制度版本常數——d5 判定語意改版就 bump;golden 閉包記它,
# replay 比對前先對版本:不同=「golden 過期」(指路重凍,不紅)——制度合法演進≠漂移(r1 s3-f3/ext-f2)。
_REPLAY_ENGINE_REV = "d5-2026-08-25"


def _intake_declared(text):
    """intake守衛 T1(2026-08-30 d1):intake 檔的前掃宣告行判定。
    規則(r2/r3 折入):①先剝 fenced 圍欄(```…```)再掃——同款行首 fullmatch 對圍欄內
    頂格示例照計,模板照抄即偽造(r2 b-F6 實測)②行首錨定 fullmatch `preflight-4: ran`,
    值域封閉單值 ③同檔多條宣告行=格式壞,視同無(fail-closed;後果只是 T2 的 ⚠,不擋)。
    回傳 True=有且僅有一條合法宣告行。"""
    import re as _re
    # ★走全檔唯一那支剝圍欄實作★(2026-09-16 同族掃描):原本這裡自己寫了一個
    # ```…``` 的正則,而那支共用函式的說明白紙黑字寫著「所有人都必須走這裡」——
    # 自己寫的正則有兩個致命假設(圍欄一定成對、標記一定在第 0 欄)。實測兩種形狀
    # 兩邊答案相反:①外層四個反引號、內層三個反引號 ②波浪號圍欄。
    # 兩種都讓「把樣板原樣貼進圍欄裡」被算成真的跑過前掃,正是這支判定自己
    # 宣稱要防的「模板照抄即偽造」。
    hits = [ln for _no, ln in _visible_lines(text.split("\n"))
            if ln.startswith("preflight-4:")]
    if len(hits) != 1:
        return False
    return _re.fullmatch(r"preflight-4:[ \t]*ran[ \t]*", hits[0]) is not None


def _intake_dir_status(repo_root, loop_id):
    """intake守衛 T2 判準:迴圈目錄的前掃留痕狀態。
    回傳 "no-dir"(目錄不存在=scratch 迴圈,跳過不印——r2 b-F1:自主迴圈 /tmp 工作區,
    不跳會每天印進沒人讀的 log)/"ok"(至少一份 *intake*.md 含合法宣告行——綁迴圈不綁輪,
    r2 b-F4/c-F5:實帳 11 份有 10 份在 r1、判定輪多為 r2+,綁輪必長噪)/"missing"。"""
    d = Path(repo_root) / "governance" / "review-reports" / str(loop_id)
    if not d.is_dir():
        return "no-dir"
    for f in sorted(d.glob("*intake*.md")):
        try:
            if _intake_declared(f.read_text(encoding="utf-8", errors="replace")):
                return "ok"
        except OSError:
            continue
    return "missing"


_SEV_DECL_LINE_RE = re.compile(r"severity:[ \t]*(clean|minor|major|blocker)[ \t]*")   # ★獨立宣告行的唯一定義★(code-review-yield r1 架構席 a2:原本逐字複製了五處,值域改一字要改五處)


def _report_severities(text):
    """[嚴重度綁定機械掃 S1] 報告檔 severity 宣告的★單一 parse 實作★(寫側+severity-check 共用)。
    逐行 fullmatch、空白只認水平空白(反斜線s 會吞換行讓標籤與值跨行黏上,r2 ext);
    行首錨定天生排掉引句行(以標籤起頭)與 blockquote(以 > 起頭)兩型逃逸(r1 s1/s2);
    大小寫、全形冒號、行首雜字一律不認(fixture 釘)。回 list[str](出現序)。"""
    out = []
    text = text.lstrip("\ufeff")   # BOM 不算內容(codex r1 f4)
    # 圍欄內不算(2026-09-09,審查有沒有用記帳 S1):reported 由這支數、拒收偵測走 _visible_lines 不看圍欄,
    # 兩邊可見性要同一套——不然席位在 ``` 裡示範一行 severity: blocker 會灌進 reported 與帳面下限。
    for _no, line in _visible_lines(text.splitlines(), keep_fenced=False):
        m = _SEV_DECL_LINE_RE.fullmatch(line)
        if m:
            out.append(m.group(1))
    return out


_SEV_RESIDUE_RE = re.compile(r"(?i)(?:\bsev(?:erity)?(?:\*\*|__)?\s*[:：]|嚴重度(?:\*\*|__)?\s*[:：]|\[(?:clean|minor|major|blocker)\]|[—–-]\s*(?:BLOCKER|MAJOR|MINOR)\b(?=\s*(?:$|[:：,，;；/|(（—–-])))")   # (?:\*\*|__)? = 粗體只包字不包冒號(**severity**: major);破折號型只在等級字後面接結尾或分隔符才算——「- minor 問題:…」「non-major 的調整」是散文(code-review-yield r1 f1),「- major / blocking: 是」「- MAJOR」才是殘留
_SEV_HEADING_LEVEL_RE = re.compile(r"(?i)^\s*#{1,6}\s.*[—–:：-]\s*(?:blocker|major|minor)\b")   # 標題裡嵌等級(## F1 — BLOCKER / ## f1: major):r3 通才席拿 code-batch20 真報告證明會被放過;標題散文裡提到 major 這個字不算
_SEV_SUMMARY_LINE_RE = re.compile(r"^\s*(?:#{1,6}\s*|[-*+>]\s*|\d+[.)]\s*)?(?:\*\*|__)?\s*(最嚴重|最高|整份|總結|不對齊共|blocking 條數)")
# ↑ 總結句照 SOP 本來就要寫 severity 字樣,不算殘留。★只認行首★(可帶標題/清單/引用/編號/粗體記號;2026-09-10 code 迴圈 r3):
#   原本整行任何位置出現「最高/總結/整份」就當總結句,內文講到「總結句」這條規則、或用到「最高並發」這種詞,
#   又碰巧提到比檔級高的等級,就被誤擋。不在行首的行照一般規則檢查(帶 severity: 的照樣算殘留)。


def _report_normalize_issues(text):
    """[審查有沒有用記帳 S1] 席報告「有沒有正規化」的★拒收偵測★(只用來拒、不用來數;數一律走 _report_severities):
    ①檔首(跳過開頭 HTML 註解與空行)第一個非空行必須是檔級獨立宣告 `severity: <值>`;
    ②其餘可見行(圍欄內不看)若含 severity/嚴重度/方括號等級字樣、卻不是 _report_severities 認得的獨立宣告行 → 殘留寫法;
      引句行(引句:/引句:/> 開頭)不算——那是逐字引審材。
    回 list[(行號, 原因, 行)];空=正規化過。r1–r3 五席各拿一種真實格式證明「放過就少算」,所以認不得就擋、不列舉例外。"""
    text = text.lstrip("\ufeff")   # BOM 不算內容(codex r1 f4:帶 BOM 的外部報告會被永久誤擋、normalizer 也修不了)
    lines = text.splitlines()
    issues = []
    i = 0
    while i < len(lines) and not lines[i].strip():
        i += 1
    _mt = _SEV_DECL_LINE_RE.fullmatch(lines[i]) if i < len(lines) else None
    _top = _mt.group(1) if _mt else None   # 檔級宣告的值;總結句豁免要拿它對
    # ★不跳 HTML 註解★(r3 架構席:專案三處明令不偵測註解;來源註記寫在檔級行之後)
    if _top is None:
        issues.append((i + 1 if i < len(lines) else 1, "檔首第一個非空行要是檔級 severity: <clean|minor|major|blocker>(來源註記之類放它後面)", lines[i] if i < len(lines) else ""))
    for no, ln in _visible_lines(lines, keep_fenced=False):
        s = ln.lstrip()
        if s.startswith(("引句:", "引句：", ">")):
            continue
        if _SEV_DECL_LINE_RE.fullmatch(ln):
            continue
        if _SEV_SUMMARY_LINE_RE.search(ln):
            # 總結句豁免有條件(code-review-yield r1 外家席 f1):提到的等級不得高於檔級宣告——「severity: clean / 總結: severity: blocker」
            # 就是拿白名單夾帶 blocker 又數成 0 條;檔級行缺(_top None)一律不豁免
            # 「其中 major 0 條」是在數零條,不是宣告等級(架構對齊席範本必寫這句;2026-09-10 code-工具自裝檔不算消費專案 r2
            # 檔級 minor 的架構席報告因此被擋)。只剝「等級字後面緊接 0 條」這種計數;非零、或 0 後面不是「條」
            # (「blocker 0 台」數的是台數,r3 正確性席)照樣算夾帶
            _vis_lv = re.sub(r"(?i)\b(?:clean|minor|major|blocker)\b\s*[:：]?\s*0\s*條", "", _strip_inline_markup(ln)[0])
            _lv = [w.lower() for w in re.findall(r"(?i)\b(clean|minor|major|blocker)\b", _vis_lv)]
            if _top is not None and all(_SEV_ORDER[w] <= _SEV_ORDER[_top] for w in _lv):
                continue
            if _lv:
                issues.append((no, f"總結句提到的等級({'/'.join(_lv)})高於檔級宣告({_top or '缺'})——總結句只能重述,不能藏更高的等級", ln))
                continue
        vis = _strip_inline_markup(ln)[0]   # 反引號裡的是在「講」格式(`- severity: X`),不是在宣告——沿用行內可見規則
        if _SEV_RESIDUE_RE.search(vis) or _SEV_HEADING_LEVEL_RE.match(vis):
            issues.append((no, "嚴重度要寫成獨立一行 severity: <值>(不是列表項、標題、粗體、方括號、破折號或別的拼法)", ln))
    return issues


_SEV_INLINE_DECL_RE = re.compile(r"^(\s*(?:[-*+]\s*)?(?:\*\*)?)(?:severity|Severity|嚴重度)(?:\*\*)?\s*[:：]\s*(clean|minor|major|blocker)\b\s*(.*)$")
_SEV_HEADING_DECL_RE = re.compile(r"^(\s*#{1,6}\s.*?)\s*[—–-]{1,2}\s*(?:severity\s*[:：]\s*)?(blocker|major|minor|clean)\b\s*[,，;；]?\s*(.*)$", re.I)


def normalize_report_text(text):
    """[審查有沒有用記帳 S1/S4] 把席報告常見的嚴重度寫法機械轉成 SOP 格式(獨立一行 severity: <值>),回 (新文字, 改了幾處, 還剩的殘留清單)。
    做的事只有三種、都是純格式:①行內/列表/粗體的 `severity: X ...` → 一行 `severity: X` + 其餘文字另起一行;
    ②標題裡嵌等級(`### F1 —— severity: blocker,blocking: 是` / `## F1 — BLOCKER`)→ 標題保留、下一行插 `severity: x`;
    ③第一個宣告不在檔首 → 檔首插一行檔級宣告(值=所有宣告裡最高的;原本就有檔級行則不動)。
    ★不碰內容、不改 severity 值、不動引句/圍欄★;轉不了的原樣留下,由 _report_normalize_issues 印給人改。"""
    if text.startswith("\ufeff"):
        text = text[1:]; changed_bom = 1   # codex r1 f4:BOM 剝掉算一處修改
    else:
        changed_bom = 0
    lines = text.splitlines()
    out, changed = [], changed_bom
    fence = None
    for ln in lines:
        s = ln.lstrip(" ")
        if s.startswith(("```", "~~~")) and len(ln) - len(s) <= 3:
            ch = s[0]; run = len(s) - len(s.lstrip(ch))
            if fence is None: fence = (ch, run)
            elif ch == fence[0] and run >= fence[1]: fence = None
            out.append(ln); continue
        if fence is not None or s.startswith(("引句:", "引句：", ">")) or _SEV_DECL_LINE_RE.fullmatch(ln):
            out.append(ln); continue
        if _SEV_SUMMARY_LINE_RE.search(ln):
            out.append(ln); continue
        m = _SEV_INLINE_DECL_RE.match(ln)
        if m and "`" in ln[:m.start(2)]:
            m = None   # 反引號裡的是在講格式,不轉
        if m:
            out.append(f"severity: {m.group(2).lower()}")
            rest = m.group(3).strip().lstrip("/／|,，;；").strip()
            if rest:
                out.append(rest)
            changed += 1
            continue
        m = _SEV_HEADING_DECL_RE.match(ln)
        if m:
            out.append(m.group(1).rstrip())
            out.append(f"severity: {m.group(2).lower()}")
            rest = m.group(3).strip()
            if rest:
                out.append(rest)
            changed += 1
            continue
        out.append(ln)
    decl = _report_severities("\n".join(out))
    i = 0
    while i < len(out) and not out[i].strip():
        i += 1
    if decl and not (i < len(out) and _SEV_DECL_LINE_RE.fullmatch(out[i])):
        top = max(decl, key=lambda v: _SEV_ORDER[v])
        out.insert(i, f"severity: {top}")
        changed += 1
    new = "\n".join(out) + ("\n" if text.endswith("\n") else "")
    return new, changed, _report_normalize_issues(new)


def cmd_report_normalize(path, write=False):
    """`lumos report-normalize <席報告.md> [--write]`:收貨正規化的機械那一半。不帶 --write 只印會改什麼與還剩什麼;帶了才原子覆寫。
    vault-free(跟 fold-check/prose-lint/quote-check 同層:只吃一個 markdown 路徑,不碰圖譜;r1 架構席 a1——原本接在 canary 那組後面,沒圖譜的 repo 跑不了)。
    rc:0=已正規化或改完沒殘留;1=改完仍有殘留(印行號,要人改);2=檔讀不到。"""
    try:
        text = Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError as e:
        print(f"擋下:讀不到 {path}({e})", file=sys.stderr)
        return 2
    new, changed, issues = normalize_report_text(text)
    if changed == 0 and not issues:
        print(f"✓ {path} 已是正規化格式(檔級行在檔首、每條 finding 一行 severity),不用改")
        return 0
    if write and new != text:
        _write_lf(Path(path), new)
        print(f"✓ 改了 {changed} 處並寫回 {path}")
    else:
        print(f"會改 {changed} 處(加 --write 才寫回):")
        import difflib
        for d in list(difflib.unified_diff(text.splitlines(), new.splitlines(), lineterm="", n=0))[2:40]:
            print("    " + d)
    if issues:
        print(f"⚠ 還有 {len(issues)} 處機器轉不了,要人改(不然 canary record 會擋):")
        for no, why, ln in issues[:10]:
            print(f"    第 {no} 行:{why}\n      {ln[:100]}")
        return 1
    return 0


def _report_reported_count(text):
    """[審查有沒有用記帳 S1] 報了幾條=檔級之後的獨立宣告行數(排除 clean)。前提是報告已通過 _report_normalize_issues。"""
    decl = _report_severities(text)
    return sum(1 for v in decl[1:] if v != "clean")


def _review_yield_round(rows):
    """[審查有沒有用記帳 S3] 一輪帳列 → 漏斗數字 dict(N 報/M 存活/R 重現不到/F 折/A 放行/S 存活多於席位報)。
    N=席位列 reported 加總,★同席同報告只算一次★(同一席會先留痕一筆、再當載體一筆;以 (auditor, report_sha256) 去重);
    任一欄缺(2026-09-09 前的帳沒這些鍵)→ 該格 None(印 ?),N/M/R 任一 None 就不算 S。純函式,disposal 尾與 gov --stats 共用。"""
    seen, N, n_missing = set(), 0, False
    for r in rows:
        key = (r.get("auditor"), r.get("report_sha256"))
        if key in seen:
            continue
        seen.add(key)
        if r.get("reported") is None:
            n_missing = True
        else:
            N += int(r["reported"])
    carrier = next((r for r in rows if r.get("findings_set")), None)
    M = len(carrier["findings_set"]) if carrier else None
    R = len(carrier["refuted_set"]) if carrier and carrier.get("refuted_set") is not None else None
    F = len(carrier.get("folded_set") or []) if carrier else None
    A = len(carrier.get("accepted_set") or []) if carrier else None
    N = None if n_missing or not seen else N
    S = None if (N is None or M is None or R is None) else max(0, M + R - N)
    return {"N": N, "M": M, "R": R, "F": F, "A": A, "S": S, "has_carrier": carrier is not None}


def _review_yield_line(y, escapes=None):
    """把 _review_yield_round 的 dict 印成一行(問閘尾與 gov --stats 同一種措辭)。"""
    q = lambda v: "?" if v is None else str(v)
    s_part = "算不了(缺欄位)" if y["S"] is None else f"存活多於席位報的 {y['S']} 條(編排者自找或漏併)"
    tail = f";這條迴圈累計逃逸 {escapes}" if escapes is not None else ""
    return (f"席位報 {q(y['N'])}(機器數)→ 存活 {q(y['M'])} / 編排者重現不到 {q(y['R'])}(人填,已對 intake)"
            f"→ 折 {q(y['F'])} / 放行 {q(y['A'])};{s_part}{tail}")


def _escape_rows_for(env, loop_id=None):
    """讀逃逸帳(append-only,不進閘);loop_id 給了就只回那條迴圈的。壞行跳過。"""
    out = []
    try:
        log = env.vault.parent / ".escape-log.jsonl"
        if not log.exists():
            return out
        for ln in log.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            if loop_id is None or d.get("loop") == loop_id:
                out.append(d)
    except OSError:
        pass
    return out


def _severity_check_row(rec, root, trust_sha=False):
    """[嚴重度綁定機械掃 S2] 單帳列 severity 對帳核心(CLI 與 disposal 尾端共用,單一實作)。
    回 (status, 白話訊息):ok/over(高報,保守)/under(低報)/noparse(報告無宣告行)/
    nofile(報告檔佚失)/shafail(報告與帳面指紋不符)。trust_sha=True 時跳過重算
    (disposal ③ 已對判定輪全席逐檔驗過,不對同一檔重算兩遍雜湊;r1 arch-f4)。"""
    rp = rec.get("report_path")
    if not rp:
        return "nofile", "帳列沒有報告檔路徑(舊形狀,寫側 2026-08-26 起已拒)"
    fp = Path(rp)
    if not fp.is_absolute():
        fp = Path(root) / rp
    try:
        text = fp.read_text(encoding="utf-8", errors="replace")
    except OSError as e:
        return "nofile", f"報告檔讀不到({e}): {rp}"
    if not trust_sha:
        want = rec.get("report_sha256")
        if want and _sha256_file(fp) != want:
            return "shafail", f"報告檔與帳面指紋不符(檔案被動過?)——先跑 lumos quote-check 查: {rp}"
    decl = _report_severities(text)
    led = rec.get("severity")
    if not decl:
        return "noparse", "報告裡沒有任何「severity: <值>」獨立宣告行(格式無法機械驗)"
    rmax = max(decl, key=lambda v: _SEV_ORDER[v])
    if led is None:
        return "under", f"帳面沒記 severity,報告宣告最高是 {rmax}"
    if _SEV_ORDER.get(led, -1) < _SEV_ORDER[rmax]:
        return "under", f"低報——報告宣告最高 {rmax},帳面只記 {led}(major 逃必折就是走這條路)"
    if _SEV_ORDER.get(led, 99) > _SEV_ORDER[rmax]:
        return "over", f"高報——帳面 {led} 高於報告最高 {rmax}(保守方向,下游只會更嚴)"
    return "ok", f"帳面 {led} == 報告最高 {rmax}"


def cmd_severity_check(loop_id, round_id, auditor, repo="."):
    """[嚴重度綁定機械掃 S2] 第四道收貨:席報告 severity 宣告↔帳面 --severity 對帳(vault-free)。
    介面吃帳列座標(--loop/--round/--auditor)不吃檔案路徑——對帳對象是帳列不是檔案,
    resolver 與 loop status 同一套 loop/round 篩選(r1 arch-f1 的第二種做法在此交代)。
    定位=第二層縱深:生效日(2026-08-26)前的歷史帳=advisory;生效日後抓到低報=寫側 [S1]
    有 bug(本應拒帳),紅字+指路開 Issue,converged 不自動撤。advisory 恆 rc0;
    找不到帳列/帳檔=rc2;報告 sha 與帳面不符=rc2 拒掃指路 quote-check。"""
    import json
    root = Path(repo).resolve()
    ledger = root / "docs" / ".canary-log.jsonl"
    if not ledger.exists():
        print(f"擋下:找不到帳本 {ledger}(--repo 要指 repo 根)", file=sys.stderr)
        return 2
    hit = None
    for line in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
        if not line.strip():
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("loop") == loop_id and d.get("round") == round_id and d.get("auditor") == auditor:   # round_id=None 時比對無 round 鍵的列(d.get 回 None)
            hit = d   # append 序,後者勝(同座標重記時看最新)
    if hit is None:
        print(f"擋下:帳本裡找不到 loop={loop_id} round={round_id} auditor={auditor} 的帳列", file=sys.stderr)
        return 2
    st, msg = _severity_check_row(hit, root, trust_sha=False)
    era_new = str(hit.get("ts", "")) >= _SEV_WRITESIDE_CUTOFF
    if st == "shafail":
        print(f"擋下:{msg}", file=sys.stderr)
        return 2
    if st == "under":
        tag = "這筆是生效日後的新帳——寫側本應拒帳,代表 [S1] 有 bug,開 Issue 攤人" if era_new else "歷史帳(生效日前),寫側不溯及"
        print(f"⛔ 低報:{msg}" + "\n" + f"  {tag}(本指令 advisory,不動任何閘)")
    elif st == "noparse":
        tag = "生效日後的新帳不該掃不出宣告行(寫側本應拒帳)——查 [S1]" if era_new else "歷史帳相容:格式無法機械驗,僅提醒"
        print(f"提醒:{msg}——{tag}")
    elif st == "nofile":
        print(f"提醒:{msg}")
    elif st == "over":
        print(f"提醒:{msg}")
    else:
        print(f"✓ {msg}")
    return 0


def _sha256_file(path):
    """檔案 sha256(M1包 #3);OSError 交呼叫端兜(目錄/無權限/不存在統一 rc2,沿 G1 慣例)。"""
    import hashlib
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def _vault_repo_root(env):
    """disposal 留痕路徑的落帳/解析根(r2 終審修,寫讀兩側★必須同用這一份★):
    從 vault 向上找 .git(docs/<slug>-knowledge 布局下 vault.parent=docs/ 非 repo root);
    找不到退 vault.parent(測試假 vault 行為不變)。"""
    p = env.vault.resolve()
    for cand in (p, *p.parents):
        if (cand / ".git").exists():
            return cand
    return env.vault.parent.resolve()


def cmd_canary(env, kind, auditor=None, token=None, note=None, loop=None, severity=None, findings=None, round_id=None, capture_counts=None, clusters=None, spec=None, reviewed=None, tokens=None, wallclock_min=None, tier=None, scope_lines=None, report=None, snapshot=None, intake=None, findings_set=None, folded_set=None, accepted_set=None, accept_reasons=None, canary_type=None, probe=None, finding_kinds=None, refute_verdicts=None, outcome=None, usd=None, orchestrator=None, refuted_set=None, finding_severities=None):
    """記一筆審計輪留痕。kind=caught|missed 是 canary 植入判定(★協議 2026-08-14 停用,
    僅歷史帳;見 Systems/canary-audit d5★);kind=none = 無植入輪的純處置帳載體——
    停用後每輪照記(severity/findings/disposal 欄位是 loop status --disposal 的讀取源)。
    record-only、本機;漏抓(missed)= 該輪審計員放水的訊號,經 lumos gov 可查詢。
    --loop/--severity:把這輪歸進某設計 loop(供 lumos loop status 算收斂)。
    --clusters(M2):該輪 risk-cluster 三態帳(每輪至多一筆帶;讀側 loop status --panel 消費)。
    天花板:這只證明「審計員有沒有醒著讀」,不證明它抓到所有真問題(見設計 doc)。"""
    import json
    import datetime
    import secrets
    if not token:
        token = "CANARY-" + secrets.token_hex(4)   # 隨機,非時間戳(同秒不撞)
    rec = {"ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
           "kind": kind, "auditor": auditor or "", "token": token, "note": note or ""}
    if loop:
        rec["loop"] = loop
    # D 前置(2026-08-05):植入型別/探針結果結構化——原散文 note 不可重算;
    # 不給不寫鍵(T1 相容慣例)。D 本體開工條件=帶型別記錄攢滿 15 筆(canary-stats 可數)。
    if canary_type:
        rec["canary_type"] = canary_type
    if probe:
        rec["probe"] = probe
    if round_id:
        if round_id.startswith("__"):
            # r3 終審修(3 席重疊):__ 為讀側內部鍵保留字首(round-less 逐筆 __seqN)——
            # 使用者 round-id 撞鍵可讓新輪併入舊輪、舊 carrier 冒充最新處置帳偽 PASS
            print(f"擋下:輪次編號不能用 __ 開頭(工具內部保留這個字首),換一個: {round_id!r}", file=sys.stderr)
            return 2
        rec["round"] = round_id   # panel 一輪 W 筆共享 round-id(loop status --panel 分組)
    if capture_counts:
        try:
            rec["capture_counts"] = [int(x) for x in str(capture_counts).split(",") if x.strip()]
        except ValueError:
            print(f"擋下:--capture-counts 要用逗號分隔的整數(像 2,1,1),你給的是 {capture_counts!r}", file=sys.stderr)
            return 2
    if severity:
        rec["severity"] = severity
    if findings is not None:
        rec["findings"] = findings
    if clusters is not None:   # 空字串也進解析器 → rc2(帶旗標即須有效內容,勿被 falsy 吞)
        parsed, err = _parse_clusters(clusters)
        if err:
            print(f"擋下:--clusters 分組設定寫錯了——{err}", file=sys.stderr)
            return 2
        rec["clusters"] = parsed   # dict{名:狀態},同 capture_counts 寫側轉型慣例
    # ── M1包 #3 雙 hash 鏈(loop機械脊椎M1包_計劃):--spec/--reviewed 必須同現 ──
    if (spec is None) != (reviewed is None):
        print("擋下:--spec(被審文件)和 --reviewed(它的內容指紋)要一起給、或都不給,你只給了一個;--reviewed 填派工當下那份文件的 sha256",
              file=sys.stderr)
        return 2
    if spec is not None:
        try:
            rec["result_sha256"] = _sha256_file(spec)   # record 於 fold 後執行=post-fold hash
        except OSError as e:
            print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
            return 2
        if not re.fullmatch(r"[0-9a-f]{64}", str(reviewed)):
            print(f"擋下:--reviewed 要填 64 碼的 sha256 指紋,你給的格式不對: {reviewed!r}", file=sys.stderr)
            return 2
        rec["reviewed_sha256"] = reviewed
        # 改制回測 [S2]①(2026-08-26):spec 路徑一併入帳——replay --freeze 補漏靠它反查
        # 該 loop 的被審文件(r2 delta d-f1:帳裡只存內容 sha 從沒存路徑,自動凍第一步就跑不動)。
        # 同 report/snapshot 落帳正規化:repo root 底下存相對路徑、之外存絕對。舊帳無此欄不溯及。
        _spr = Path(spec).resolve()
        try:
            rec["spec_path"] = str(_spr.relative_to(_vault_repo_root(env)))
        except ValueError:
            rec["spec_path"] = str(_spr)
    # ── M1包 #4 成本選配欄:非負整數,不給不寫鍵(同 --findings 慣例) ──
    # ★scope_lines(2026-08-02)★:這輪「被審材料有多少行」。
    # 為什麼要記——canary 抓到只證審查員醒著,但★東西越多越抓不到★是外部實測裡
    # 最主導的因素(arXiv 2606.15689:合成缺陷抓得到不可靠地預測真實缺陷抓得到,
    # 且 diff 大小是主導混淆變數)。本專案十輪 code-loop 的 diff 從 332 到 2770 行,
    # ★在帳上長得一模一樣★——等於無法回答「小 diff 上的 caught 是不是灌水」。
    # 這一欄不改任何判定、不進任何 gate,★純粹是把缺的變數記下來★,好讓
    # 「caught 率 vs 規模」這個問題日後答得出來(三種結果都有用:有關係→大 diff
    # 要切開或加席;沒關係→這個擔心在本情境不成立、寫下來別再擔心;反過來→查)。
    # ★不能回溯★:既有記錄沒有這個數字,時鐘從加上去那天才開始走。
    for _name, _val in (("tokens", tokens), ("wallclock_min", wallclock_min),
                        ("scope_lines", scope_lines)):
        if _val is not None:
            if _val < 0:
                print(f"擋下:--{_name.replace('_', '-')} 只能填 0 或正整數,你給的是 {_val}", file=sys.stderr)
                return 2
            rec[_name] = _val
    if scope_lines is not None and scope_lines > _CANARY_SCOPE_SOFT_CAP_LINES:
        rec["scope_oversize"] = True
        print(f"提醒:這輪要審的東西有 {scope_lines} 行,超過建議的軟上限 {_CANARY_SCOPE_SOFT_CAP_LINES} 行"
              f"(外部研究認為材料太多審查員容易看不完、漏審)。", file=sys.stderr)
        print("  不擋你記錄,但帳上已標成 scope_oversize,這一輪抓到的結果算弱證據——"
              "審查員可能是「看不完」而不是「沒問題」;收斂結論講保守一點,下一輪拆開審。", file=sys.stderr)
    # ── 自主迴圈結局帳(2026-08-26 auto-loop-repair-v2):outcome/usd 結構化欄 ──
    # 為什麼開新欄——[S4] 七天彙總要機器回讀「這輪怎麼收+花多少」;塞 note 散文是
    # 專案明文放棄的舊路(note 在讀側一律丟棄防散文注入)。不給不寫鍵,舊列=舊格式桶。
    if outcome is not None:
        # 封閉列舉(code-r1 s4-f1:細類值域也要鎖——只驗主類會讓未宣告的分類靜默進帳,
        # 讀側的彙總桶就對不上);新增細類=先改這裡+spec 分類節,逼兩邊同步。
        _OUTCOMES = ("converged", "skipped",
                     "unconverged:cap", "unconverged:disputed", "unconverged:degraded-high",
                     "tier-blocked:spec", "tier-blocked:gate", "tier-blocked:cross",
                     "pipeline_fail:api_error", "pipeline_fail:truncated",
                     "pipeline_fail:parse_fail", "pipeline_fail:anchor_fail",
                     "pipeline_fail:pending_write")
        if str(outcome) not in _OUTCOMES:
            print(f"擋下:--outcome 只收這 {len(_OUTCOMES)} 個值(結局分類是封閉列舉,新分類要先改"
                  f" spec 與這份白名單):{' / '.join(_OUTCOMES)};你給的是 {outcome!r}",
                  file=sys.stderr)
            return 2
        rec["outcome"] = str(outcome)
    if usd is not None:
        if usd < 0:
            print(f"擋下:--usd 只能填 0 或正數(這一輪實際花的美元),你給的是 {usd}", file=sys.stderr)
            return 2
        rec["usd"] = round(float(usd), 4)
    # ── M1包 #1 tier 定錨欄(選配;loop next/gate 讀首個帶 tier 記錄定錨) ──
    if tier is not None:
        if tier not in LOOP_TIERS:
            print(f"擋下:--tier 分級只能是 {'/'.join(LOOP_TIERS)} 之一,你給的是 {tier!r}", file=sys.stderr)
            return 2
        rec["tier"] = tier
    # ── d4 編排者定錨欄(選配;首個帶 orchestrator 的記錄定錨;帳面已定錨就不能中途換) ──
    if orchestrator is not None:
        if orchestrator not in LOOP_ORCHESTRATORS:
            print(f"擋下:--orchestrator 只能是 {'/'.join(LOOP_ORCHESTRATORS)} 之一,你給的是 {orchestrator!r}", file=sys.stderr)
            return 2
        if not loop:
            print("擋下:--orchestrator 是「誰在編排這個迴圈」,要跟 --loop 一起給;沒 --loop 的記錄定錨不到任何迴圈(孤兒欄)", file=sys.stderr)
            return 2
        if loop:
            _recs = _loop_records(env, loop)
            _prev = _loop_orchestrator(_recs)
            if _prev and _prev != orchestrator:
                print(f"擋下:這個審查編號第一筆就定成 {_prev} 編排,中途換成 {orchestrator} 帳就對不上——要換請開新編號", file=sys.stderr)
                return 2
            if _recs and _prev is None and orchestrator != "claude":   # 舊帳(沒欄)第一次帶旗標會回溯改分家(code-codex-s2 r1 單reviewer F1)
                print(f"擋下:這個審查編號已有 {len(_recs)} 筆沒記編排者的舊記錄,讀側一律視為 claude;現在補 {orchestrator} 會把前幾輪的外家判定全翻掉——要用 {orchestrator} 編排請開新編號", file=sys.stderr)
                return 2
        rec["orchestrator"] = orchestrator
    # ── T1 相容雙讀(design-loop重設計 實作計畫):處置帳六選配欄——★全部不給=行為與今日相同★ ──
    # 集合核對而非總數核對(r1 Codex:只核總數可被重複計數/虛構項配平);
    # 「不給不寫鍵」同 --findings 慣例;違反一律 rc2(寫側就擋,不留到 gate)。
    def _ids(raw):   # None=未給;""=明示空集合(兩者語意不同)
        return None if raw is None else [x.strip() for x in raw.split(",") if x.strip()]
    f_set, fo_set, ac_set = _ids(findings_set), _ids(folded_set), _ids(accepted_set)
    if any(x is not None for x in (fo_set, ac_set, accept_reasons, refute_verdicts, finding_kinds)) and f_set is None:
        print("擋下:--folded-set/--accepted-set/--accept-reason/--refute-verdict/--finding-kind 要跟 --findings-set 一起給(先列出發現了什麼,才能說各自怎麼處置)", file=sys.stderr)
        return 2
    if f_set is not None:
        if not f_set:
            print("擋下:--findings-set 不能是空的;這輪沒有任何發現的話,處置那幾個選項就別帶", file=sys.stderr)
            return 2
        if len(set(f_set)) != len(f_set):
            print(f"擋下:--findings-set 裡有重複 id: {f_set}", file=sys.stderr)
            return 2
        fo, ac = fo_set or [], ac_set or []
        F, FO, AC = set(f_set), set(fo), set(ac)
        if not FO <= F or not AC <= F:
            print("擋下:折掉(folded)或放行(accepted)的清單裡有 id 不在發現清單(findings-set)裡", file=sys.stderr)
            return 2
        if FO & AC:
            print(f"擋下:同一個發現不能既折掉又放行,這幾個兩邊都有: {sorted(FO & AC)}", file=sys.stderr)
            return 2
        if FO | AC != F:
            print(f"擋下:這幾個發現還沒處置: {sorted(F - FO - AC)}——每一條都要說清楚是折掉還是放行,"
                  "折掉加放行要剛好等於全部發現", file=sys.stderr)
            return 2
        reasons = {}
        for item in (accept_reasons or []):
            if "=" not in item:
                print(f"擋下:--accept-reason 要寫成 id=理由,你給的是 {item!r}", file=sys.stderr)
                return 2
            k, _, v = item.partition("=")
            reasons[k.strip()] = v.strip()
        if set(reasons) != AC or any(not v for v in reasons.values()):
            print(f"擋下:每個放行的發現都要附非空理由,不多不少(放行的有 {sorted(AC)},"
                  f" 附了理由的有 {sorted(reasons)})", file=sys.stderr)
            return 2
        if severity == "blocker" and AC:
            print("擋下:這輪有 blocker 等級的問題,blocker 只能折掉修正、不能放行,放行清單必須是空的", file=sys.stderr)
            return 2
        # ── 審查有沒有用記帳 S2(2026-09-08):載體必帶「編排者重現不到」清單,id 要對到 intake 的重現表列 ──
        if refuted_set is None:
            _gate_event_or_warn(_vault_repo_root(env), "canary", "blocked", f"refuted-set-missing loop={loop or ''} auditor={auditor or ''} id={uuid.uuid4().hex[:8]}", hard=True)
            print("擋下:帶 --findings-set 就要帶 --refuted-set(編排者機械重現不到、沒折也沒放行的發現;這輪一條都沒有就寫 --refuted-set none)"
                  "——選填的欄位沒人填(refute_verdicts 0/1216 是前科)", file=sys.stderr)
            return 2
        rreasons = {}
        if str(refuted_set).strip().lower() != "none":
            for item in str(refuted_set).split(","):
                item = item.strip()
                if not item:
                    print("擋下:--refuted-set 有空項(逗號之間沒東西)——這輪一條都沒有就明寫 none,別用空字串混過(空項會被當 none、跳過 intake 驗證;codex r1 f5)", file=sys.stderr)
                    return 2
                if "=" not in item:
                    print(f"擋下:--refuted-set 要寫成 id=理由(半形逗號分隔,所以理由裡別用半形逗號,改用全形「,」),你給的是 {item!r}", file=sys.stderr)
                    return 2
                k, _, v = item.partition("="); k, v = k.strip(), v.strip()
                if len(v) < _MANUAL_MIN_CHARS or not re.search(r"[^\W_]", v):
                    print(f"擋下:--refuted-set 的理由要 ≥{_MANUAL_MIN_CHARS} 字且有實字({k}={v!r})——「重現不到」得講怎麼試的", file=sys.stderr)
                    return 2
                if k in F:
                    print(f"擋下:--refuted-set 的 {k} 也在 --findings-set 裡——重現不到的發現不是存活的發現,二選一", file=sys.stderr)
                    return 2
                rreasons[k] = v
            if rreasons:
                if intake is None:
                    print("擋下:--refuted-set 非 none 時要帶 --intake:重現不到的 id 要對得上 intake 機械重現表那一列(含 HIT/MISS)", file=sys.stderr)
                    return 2
                try:
                    _itext = Path(intake).read_text(encoding="utf-8", errors="replace")
                except OSError as e:
                    print(f"擋下:--intake 指的檔案讀不到: {e}", file=sys.stderr)
                    return 2
                for k in rreasons:
                    _pat = re.compile(r"(?<!\w)" + re.escape(k) + r"(?!\w)")   # \w 邊界:a1 不因 a10 命中、甲 不因 甲乙 命中(r1 f4/codex f2:ASCII 邊界對 CJK id 形同虛設)
                    _kw = ("HIT", "MISS", "重現", "採信")
                    # 圍欄內不算(r1 f3):intake 裡示範格式的 ``` 範例列不能當真重現紀錄——可見性跟拒收偵測同一套 _visible_lines
                    if not any(_pat.search(ln) and any(w in ln for w in _kw) for _no, ln in _visible_lines(_itext.splitlines(), keep_fenced=False)):
                        print(f"擋下:--refuted-set 的 {k} 在 intake 裡找不到「同一列含整字 {k} 與 HIT/MISS/重現/採信」的重現表列——重現不到要有機械重現留痕(整字比對,{k}0 不算 {k})", file=sys.stderr)
                        return 2
        rec["findings_set"], rec["folded_set"], rec["accepted_set"] = f_set, fo, ac
        rec["refuted_set"] = sorted(rreasons)
        if rreasons:
            rec["refuted_reasons"] = rreasons
        if reasons:
            rec["accept_reasons"] = reasons
        # 流程自產工作量(Issues/流程自產工作量未量測 的入口,2026-08-22):每條發現標它在修什麼——
        # code(程式缺陷)/ spec(被審文件本身的缺陷)/ process(流程要求產出的規格文件、留痕格式、範本)。
        # 選填;給了就要全集對得上。幾個月後 gov --stats 算「findings 有幾成在修流程自己要求的東西」。
        if finding_kinds:
            kinds = {}
            for item in finding_kinds:
                if "=" not in item:
                    print(f"擋下:--finding-kind 要寫成 id=code|spec|process,你給的是 {item!r}", file=sys.stderr)
                    return 2
                k, _, v = item.partition("="); k, v = k.strip(), v.strip()
                if v not in ("code", "spec", "process"):
                    print(f"擋下:--finding-kind 的值只能是 code / spec / process,{k} 給的是 {v!r}", file=sys.stderr)
                    return 2
                kinds[k] = v
            if set(kinds) != F:
                print(f"擋下:--finding-kind 要每條發現各標一個(發現有 {sorted(F)},標了 {sorted(kinds)})", file=sys.stderr)
                return 2
            rec["finding_kinds"] = kinds
        # 逐條嚴重度(r2 回滾席,2026-09-17):輪級 severity 是整輪最高值,分不出「造成 major 的是哪一條」;
        # 逃逸自動記要判「code 型那條自己是不是 major 以上」就得逐條給。選填;給了鍵要 ⊆ 全集。
        if finding_severities:
            sevs = {}
            for item in finding_severities:
                if "=" not in item:
                    print(f"擋下:--finding-severity 要寫成 id=clean|minor|major|blocker,你給的是 {item!r}", file=sys.stderr)
                    return 2
                k, _, v = item.partition("=")
                k, v = k.strip(), v.strip()
                if v not in ("clean", "minor", "major", "blocker"):
                    print(f"擋下:--finding-severity 的值只能是 clean / minor / major / blocker,{k} 給的是 {v!r}", file=sys.stderr)
                    return 2
                sevs[k] = v
            if set(sevs) != F:
                # 跟 --finding-kind 一樣要全集(r4 邊界席:只標子集就能把真正 major 的那條漏掉,逃逸不記還標成逐條精度)
                print(f"擋下:--finding-severity 要每條發現各標一個(發現有 {sorted(F)},標了 {sorted(sevs)})", file=sys.stderr)
                return 2
            rec["finding_severities"] = sevs
        # 辯方明確表態(2026-08-27,Systems/finding-refute):辯方對它判過的每條發現表態三選一——
        # agree(同意是真的→維持折入)/ evidence(拿反證降級,須附 file:line→放行)/ concern(只存疑無反證→維持折入)。
        # ★純記帳,不改降級規則★:降級去向仍由 folded/accepted 決定,本欄只記辯方怎麼表態、不回頭改判閘。
        # 鍵是「辯方判過的」子集(⊆全集;辯方只開庭審低共識≥major,不是每條發現都判)。
        # 用途=補上 2026-08-22「辯方三分類先不做」裁定自己點名的缺口(帳裡無逐席對錯,故永遠偵測不到
        # 重啟條件);開始記,日後才能算「辯方標 evidence 降級的、後來證明是真的」有幾筆,用證據決定要不要翻案。
        if refute_verdicts:
            rv = {}
            for item in refute_verdicts:
                if "=" not in item:
                    print(f"擋下:--refute-verdict 要寫成 id=agree|evidence|concern,你給的是 {item!r}", file=sys.stderr)
                    return 2
                k, _, v = item.partition("="); k, v = k.strip(), v.strip()
                if v not in ("agree", "evidence", "concern"):
                    print(f"擋下:--refute-verdict 的值只能是 agree / evidence / concern,{k} 給的是 {v!r}", file=sys.stderr)
                    return 2
                rv[k] = v
            if not set(rv) <= F:
                print(f"擋下:--refute-verdict 的 id 要在發現清單裡(發現有 {sorted(F)},標了不存在的 {sorted(set(rv) - F)})", file=sys.stderr)
                return 2
            # 表態與去向的記帳一致性(寫側,如 accept-reason 鍵須==accepted-set;不碰 disposal 判閘/收斂):
            # evidence=辯方拿反證降級→該 id 的去向必是放行(accepted);agree/concern=辯方維持→必是折入(folded)。
            # 標了 evidence 卻沒放行 = 帳自打架,日後「抽驗降級樣本」會抽到沒降的,挖空本欄用途。
            # ★blocker 輪讓步(2026-08-29 修回歸)★:同輪 severity=blocker 時,上面那條舊規則
            # 強制放行清單必須是空的,而辯方反證推翻的發現照規矩「不折入」——兩條一夾,refuted
            # 發現無處可去,記帳整筆被擋。實害:自主迴圈 2026-08-29 那輪四次撞上,只能把辯方
            # 判決留空、反證寫進 note,結構帳因此少了四輪的辯方資料。
            # 本欄自稱「純記帳、不掛判閘」,所以讓步的是本欄不是判閘:blocker 輪允許 evidence
            # 落在折入,並提醒一句。★根因(blocker 輪該不該讓反證發現放行)是判閘語意問題,
            # 要動得走設計審,本次不碰★。
            _blocker_round = (severity == "blocker")
            for _k, _v in rv.items():
                if _v == "evidence" and _k not in AC:
                    if _blocker_round and _k in FO:
                        print(f"提醒:{_k} 標 evidence(辯方拿反證降級)但落在折入——這輪是 blocker 輪,"
                              "舊規則不准有放行,反證發現只能折;帳照記,反證 file:line 請寫進 --note",
                              file=sys.stderr)
                        continue
                    print(f"擋下:{_k} 標 evidence(辯方拿反證降級)但不在放行清單(--accepted-set)——降級的發現去向是放行,帳對不上", file=sys.stderr)
                    return 2
                if _v in ("agree", "concern") and _k not in FO:
                    print(f"擋下:{_k} 標 {_v}(辯方維持)但不在折入清單(--folded-set)——維持的發現去向是折入,帳對不上", file=sys.stderr)
                    return 2
            rec["refute_verdicts"] = rv
    # ── 嚴重度綁定機械掃 [S1] 寫側強制(2026-08-26)★行為改變★:審查席帳列
    # (--loop/--auditor 齊備即觸發,kind 不限——退役 caught/missed 也擋,換 kind 即繞過;
    # ★2026-08-26 cb3 折入時已放寬:不再要求 --round(漏打 --round 曾使整層蒸發);
    #   2026-08-29 前掃抓到本註解與下方訊息殘留舊字面「--round」,一併訂正★)
    # 一律必附 --report,且帳面 severity 不得低於報告宣告最高。實帳 681 筆審查席列有 286 筆
    # 無報告的舊形狀自此被拒,不設過渡:不附報告的審查帳事後無從重驗(disposal ③ 也 FAIL)。
    # 低報=拒(major 逃必折之路);高報=放行+提醒(保守方向,下游全閘「越高越嚴」r1-s1)。
    # cb3 r1 折入:原「三者齊備才觸發」= 漏打 --round 即整層繞過,而讀側照樣把 round-less
    # 列組成 __seqN 判定輪、severity 尾巴又跳過 __ 合成鍵——三層同時失靈(ext-f1+s1-f1 實測 PASS 到 converged)。
    # 關法:①處置帳(findings_set)必綁輪次與審查席 ②審查席(loop+auditor,結局帳除外)必帶輪次。
    # cb3 r2 extv:--outcome 豁免可被假冒(掛在處置帳上整層跳過)——結局帳與審查席欄位互斥:
    # 真實結局帳只帶 loop+auditor+outcome(+usd/note),帶任何審查欄位=不是結局帳,拒。
    if outcome is not None and kind != "none":
        print("擋下:--outcome 結局帳只能用 kind=none——kind=caught/missed 掛結局欄可湊 legacy 閘輪次(cb3 r2 delta 活體重現)", file=sys.stderr)
        return 2
    if outcome is not None and any(x is not None for x in (round_id, findings_set, severity, report, snapshot, intake, findings)):
        print("擋下:--outcome 是自主迴圈結局帳專用,不能跟審查席欄位(--round/--severity/--report/"
              "--snapshot/--intake/--findings*)混用——掛結局欄假冒豁免正是要關的繞道", file=sys.stderr)
        return 2
    if loop and findings_set is not None and not (round_id and auditor):
        print("擋下:處置帳(--findings-set)必須綁 --round 和 --auditor——無輪次的處置帳讀側已不受理,"
              "沒有席位的處置帳無從對帳", file=sys.stderr)
        return 2
    if loop and auditor and outcome is None:
        # 觸發=審查席帳列(loop+auditor;結局帳 --outcome 除外)。★不要求 round★——light/循序
        # 舊制形狀本來就無輪次且合法;繞道由「處置帳必綁輪次」+讀側 round-less 處置帳拒判關死。
        # (cb3 ext-f1/s1-f1:原「三者齊備」觸發=漏打 --round 即整層蒸發;spec S1 觸發條件據此放寬,已折回計劃)
        if not report:
            print("擋下:審查席記帳(帶 --loop/--auditor)一定要附 --report 審查報告檔——"
                  "不附報告的審查帳事後無從重驗;報告還沒落檔就先存檔再記(2026-08-26 起的新規矩)", file=sys.stderr)
            return 2
        try:
            _rtext = Path(report).read_text(encoding="utf-8", errors="replace")
        except OSError as e:
            print(f"擋下:--report 指的檔案讀不到: {e}", file=sys.stderr)
            return 2
        _decl = _report_severities(_rtext)
        if not _decl:
            print("擋下:報告裡找不到任何一行「severity: <clean|minor|major|blocker>」獨立宣告——"
                  "這行是機械對帳的宣告本體,乾淨輪也要寫一行 severity: clean;"
                  "表頭型(### id / 等級 / 標題)要先在收貨時正規化成獨立行再記", file=sys.stderr)
            return 2
        _rmax = max(_decl, key=lambda v: _SEV_ORDER[v])
        if severity is None:
            print(f"擋下:審查席記帳要帶 --severity(報告裡宣告的最高是 {_rmax}),忠實轉錄才有帳可對", file=sys.stderr)
            return 2
        if _SEV_ORDER[severity] < _SEV_ORDER[_rmax]:
            print(f"擋下:低報——報告宣告的最高嚴重度是 {_rmax},帳面卻只記 {severity};"
                  "帳面不能低於報告(major 靠低報逃過必折走的就是這條路),對正再記", file=sys.stderr)
            return 2
        if _SEV_ORDER[severity] > _SEV_ORDER[_rmax]:
            print(f"提醒:高報——帳面記 {severity} 高於報告宣告最高 {_rmax}(保守方向,放行;下游判定只會更嚴)", file=sys.stderr)
        # ── 審查有沒有用記帳 S1(2026-09-08):報告沒正規化就不收;「報了幾條」由機器數,沒有旗標可填 ──
        _issues = _report_normalize_issues(_rtext)
        if _issues:
            # 被擋也要留痕(r3 接手席 blocker:rc2 不落帳=永遠看不到「撞牆後沒記」有多少;kind=blocked 同 anchor/code-loop 用字);gov --stats「閘的動作」與審查段都印
            _gate_event_or_warn(_vault_repo_root(env), "canary", "blocked", f"report-not-normalized:{len(_issues)} loop={loop or ''} auditor={auditor or ''} id={uuid.uuid4().hex[:8]}", hard=True)   # id=事件隨機碼:同一秒連撞兩次不能在 gov 去重時折成一次(r1 f5/codex f3)
            print(f"擋下:席報告還沒正規化({len(_issues)} 處)——「報了幾條」要由機器從報告數,格式不對數出來就是假的;先改再記:", file=sys.stderr)
            for _no, _why, _ln in _issues[:8]:
                print(f"    第 {_no} 行:{_why}\n      {_ln[:90]}", file=sys.stderr)
            if len(_issues) > 8:
                print(f"    …還有 {len(_issues) - 8} 處", file=sys.stderr)
            print("  規則:檔首一行檔級 severity;每條 finding 恰一行獨立 severity: <值>;驗收輪留舊項不留 severity 字樣;引句行不算", file=sys.stderr)
            return 2
        rec["reported"] = _report_reported_count(_rtext)
        if findings is not None and findings > rec["reported"]:
            _gate_event_or_warn(_vault_repo_root(env), "canary", "blocked", f"findings-over-reported:{findings}>{rec['reported']} loop={loop or ''} auditor={auditor or ''} id={uuid.uuid4().hex[:8]}", hard=True)   # codex r1 f6:這種撞牆也算「寫側擋下」
            print(f"擋下:--findings(存活 {findings})不能多於報告裡報的條數({rec['reported']} 行獨立 severity 宣告,不含檔級與 clean)", file=sys.stderr)
            return 2
        # ★載體席必須全錨,記帳當下就驗★(2026-09-06 第三次踩:規矩寫「先跑引句檢查再選載體」,
        # 我三席都跑了、卻還是把有兩句錨不回快照的那席當載體)。處置閘本來就會驗,但那時帳已經
        # 寫進只進不出的帳本,撤不掉、只能換編號重記整輪——**把同一道檢查往前挪到寫帳之前,
        # 代價從「整輪重記」降成「換一席再敲一次」**。只驗載體席(帶處置清單那筆),
        # 其餘席的引句本來就允許錨不到(不採信而已,不擋)。
        if findings_set is not None and snapshot:
            _qrows = None
            try:
                _qrows = _quote_rows(_rtext, Path(snapshot).read_text(encoding="utf-8"))
            except OSError:
                _qrows = None   # 快照讀不到:下面的 --snapshot 存在性檢查會擋,這裡不重複報
            if _qrows:
                _qmiss = [r for r in _qrows if not r["ok"]]
                if _qmiss:
                    print(f"擋下:這一席要當全輪的帳本載體(帶了處置清單),但它的 {len(_qrows)} 句引言裡"
                          f"有 {len(_qmiss)} 句在凍結快照裡找不到原文。", file=sys.stderr)
                    print("  載體是整輪的記帳憑據,引句錨不回審材就等於憑據對不上;規矩是**挑每句都錨得到的那一席當載體**。", file=sys.stderr)
                    print("  帳本只進不出——真讓它寫進去,處置閘照樣會擋,那時就只能換迴圈編號把整輪重記一次。", file=sys.stderr)
                    print("  先看看哪幾句對不上:", file=sys.stderr)
                    print(f"      lumos quote-check {report} --spec {snapshot}", file=sys.stderr)
                    print("  常見情況:引的是既有程式碼(用來說明「專案本來就有這個做法」),它不在只含改動的快照裡", file=sys.stderr)
                    print("  ——這種引句不算編造,但那一席就不適合當載體;換一席全錨的來帶處置清單。", file=sys.stderr)
                    return 2
    # --intake 選配(intake守衛 T3,2026-08-30 d1):給了就走同款四行為,不給不擋。
    # 讀側重驗在處置閘③(★全輪掃——intake_path 掛 r1 帳列而判定輪多為 r2+,只掃判定輪=常態空轉,r3-F3★)。
    for _flag, _p in (("--report", report), ("--snapshot", snapshot), ("--intake", intake)):
        if _p is None:
            continue
        try:
            _h = _sha256_file(_p)
        except OSError as e:
            print(f"擋下:{_flag} 指的檔案讀不到: {e}", file=sys.stderr)
            return 2
        import os as _os
        if _os.path.getsize(_p) == 0:
            print(f"擋下:{_flag} 指的是空檔,留痕最少要有內容({_p})", file=sys.stderr)
            return 2
        _k = _flag.lstrip("-")
        # [r1 終審修+r2 修] 落帳路徑正規化:repo root 底下存相對路徑、之外存絕對——
        # 原樣存呼叫者字串=相對 cwd,換目錄跑 gate 留痕假失蹤(合法 loop 永久 FAIL)。
        # root 判定=_vault_repo_root(向上找 .git;r2 否決席:vault.parent 在 docs/ 兩層
        # 布局=docs/ 非 repo root,governance/ 留痕永遠落絕對路徑,可攜性假賣點)。
        _pr = Path(_p).resolve()
        try:
            _stored = str(_pr.relative_to(_vault_repo_root(env)))
        except ValueError:
            _stored = str(_pr)
        rec[_k + "_path"], rec[_k + "_sha256"] = _stored, _h
    path = env.vault.parent / ".canary-log.jsonl"
    # ── T6 收緊(design-loop重設計 實作計畫):disposal 定錨後留痕轉強制 ──
    # 定錨=該 loop 帳面已有任一筆帶 findings_set(同 M2 cluster「首個有效輪定錨」前例)。
    # 定錨後每筆 record 必帶 report+snapshot;未定錨/舊 loop 完全不受影響(相容鐵則)。
    if loop and path.exists() and not (report and snapshot):
        _anchored = False
        try:
            import json as _json6
            # [r1 終審修] 逐行容錯:壞行只跳該行——原整包 try 被 any() 短路順序玩死
            # (壞行排在定錨行前→先炸→整包 fail-open,T6 強制被繞過;4 席重疊 finding)。
            # 殘餘天花板:定錨行★自己★損毀仍偵測不到(讀側 disposal 閘壞行 rc2 兜底)。
            for _l in path.read_text(encoding="utf-8").splitlines():
                if not _l.strip():
                    continue
                try:
                    _d6 = _json6.loads(_l)
                except ValueError:
                    continue
                if _d6.get("loop") == loop and "findings_set" in _d6:
                    _anchored = True
                    break
        except OSError:
            _anchored = False   # 整檔讀不到=環境層問題,寫側不因此誤擋
        if _anchored:
            print(f"擋下:{loop!r} 這個審查編號已經走「每個發現都要處置」的嚴格模式(之前的記錄帶了發現清單),"
                  "之後每筆記錄都要帶 --report(審查報告)和 --snapshot(凍結快照)留痕", file=sys.stderr)
            return 2
    rc = _jsonl_append_verified(path, rec, "token", token)
    if rc != 0:
        return rc
    print(f"✓ 這筆審查結果({kind})記下來了,憑證 {token}" + (f" (審查員 {auditor})" if auditor else "")
          + f"\n    寫入 {path.resolve()}")
    # 逃逸自動記(規格落成可驗收條件_計劃 第五節):代碼審(code-<主題>)記到 major 以上,
    # 對回 <主題> 那條設計迴圈/計劃就記一筆。永遠不影響審查帳本身(任何失敗只印一行)。
    _kinds = rec.get("finding_kinds") if isinstance(rec.get("finding_kinds"), dict) else None
    _sevs = rec.get("finding_severities") if isinstance(rec.get("finding_severities"), dict) else None
    if _sevs is not None:
        # 逐條判(r2 回滾席):code 型那條自己要是 major 以上;沒標型別的那條當分不出、保守算
        _hit = any(v in ("major", "blocker") and (_kinds is None or _kinds.get(k) == "code") for k, v in _sevs.items())
        _precision = "finding" if _kinds is not None else "round"   # 沒標型別=分不出是不是 code 型,不能謊報成逐條精度(r3 邊界席)
    else:
        _has_code = (_kinds is None) or any(str(v) == "code" for v in _kinds.values())   # 沒標型別=分不出,保守記;標了就只收 code 型
        _hit = severity in ("major", "blocker") and _has_code
        _precision = "round"   # 輪級判準:這輪最高 major 且任一條是 code 型——粗,帳上標出來讓讀側分得出
    if loop and str(loop).startswith("code-") and _hit:
        try:
            derived = str(loop)[len("code-"):]
            _auto_escape(env, "code-loop", severity,
                         f"代碼審記到 {severity}({auditor or '?'}{' ' + str(round_id) if round_id else ''})",
                         [(derived, _plan_for_loop(env, derived))],
                         _git_head(env.vault.parent.parent), source="code-loop", extra={"precision": _precision})
        except Exception as _ex:   # 掛勾不准弄壞記帳
            _escape_auto_failed(env, str(loop), "code-loop", str(_ex))
    return 0


def _jsonl_append_verified(path, rec, key_field, key_value):
    """[S1 oracle品質包] append 一行 JSONL + 讀回自驗(成功宣稱與證據綁死)。
    caller 給唯一鍵欄名與值——不寫死欄名(record 用 token、second 用自身 token)。
    寫入 OSError → rc2(既有訊息);寫成功但重開檔讀不回該鍵 → rc2「落盤自驗失敗」。
    出身:2026-07-28 record 回報成功未落盤事故([[Issues/canary-record未落盤事件]])。"""
    import json
    try:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError as e:
        print(f"擋下:寫不進記錄檔({e}):\n    {path}", file=sys.stderr)
        return 2
    try:
        with open(path, encoding="utf-8", errors="replace") as f:   # 獨立重開檔(非同 fd)
            for line in f:
                if not line.strip():
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if isinstance(d, dict) and d.get(key_field) == key_value:
                    return 0
    except (OSError, ValueError) as e:
        print(f"canary record: 落盤自驗失敗——寫完讀回來檢查時讀不到({e}),這筆不算記成功:\n    {path.resolve()}", file=sys.stderr)
        return 2
    print(f"canary record: 落盤自驗失敗——系統說寫成功了,但讀回來找不到這一筆,這筆不算記成功:\n    {path.resolve()}",
          file=sys.stderr)
    return 2


def cmd_canary_second(env, ref_id=None, verdict=None, auditor=None, note=None):
    """[S2 oracle品質包] canary 判定的第二判者留痕(抽樣分權,telemetry-only)。
    走 [S1] 同一自驗 helper(唯一鍵=自身新 token);loop status 天然忽略(second 行無 loop 欄)。
    天花板:第二判者仍是 LLM,只壓「植入者=唯一判定者」的單點,不證判定為真。"""
    import json
    import datetime
    import secrets
    if not ref_id or not verdict:
        print("擋下:覆核要帶 --id(要覆核哪一筆)和 --verdict(同意還是推翻)", file=sys.stderr)
        return 2
    if verdict not in ("agree", "overturn"):
        print(f"擋下:--verdict 只能是 agree(同意)或 overturn(推翻),你給的是 {verdict!r}", file=sys.stderr)
        return 2
    if not auditor:
        print("擋下:覆核要帶 --auditor 寫明是誰覆核的;分權的意義就在於記得清楚是不同的人", file=sys.stderr)
        return 2
    path = env.vault.parent / ".canary-log.jsonl"
    found = False
    orig_auditor = ""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:   # 半截多位元組行不炸(替代字元)
            for line in f:
                if not line.strip():
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if isinstance(d, dict) and d.get("token") == ref_id and d.get("kind") != "second":
                    found = True
                    orig_auditor = (d.get("auditor") or "").strip()
                    break
    except OSError as e:
        print(f"擋下:審查記錄檔讀不到({e}):\n    {path}", file=sys.stderr)
        return 2
    if not found:
        print(f"擋下:記錄裡找不到編號 {ref_id} 的原判,沒東西可覆核", file=sys.stderr)
        return 2
    if orig_auditor and orig_auditor.strip().lower() == auditor.strip().lower():
        # 分權的核心:同一判者自覆核=沒有第二個人,字面擊穿 S2(2026-07-29 終審 Codex)
        print(f"擋下:覆核的人跟原判的人是同一位({orig_auditor}),覆核必須換不同的人(分權才有意義)",
              file=sys.stderr)
        return 2
    token = "CANARY-" + secrets.token_hex(4)
    rec = {"ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
           "kind": "second", "token": token, "ref": ref_id, "verdict": verdict,
           "auditor": auditor, "note": note or ""}
    rc = _jsonl_append_verified(path, rec, "token", token)
    if rc != 0:
        return rc
    print(f"✓ 覆核記下來了,憑證 {token}(覆核原判 {ref_id},結論 {verdict},覆核者 {auditor})"
          f" → {path.resolve()}")
    return 0


def _capture_counts_from_finders(finders):
    """異質 panel 接線(code-loop 三輪壓縮):把多個 finder 各自找到的 finding-key
    彙成 capture-recapture 輸入。code-loop 的 finder 是**異質**的——LLM reviewer、
    `.lumos/lint.json` SARIF linter、測試失敗、mutation 存活——各是一組 finding-key;
    確定性工具的錯誤剖面與 LLM 正交=真獨立票(直擊「9 judge 2 票」相關性天花板)。

    參數:finders = [[key,...], [key,...], ...],每個子 list = 一個 finder 找到的 key。
    回傳:各 distinct key「被幾個 finder 找到」的次數列表(降序,決定性)——
    直接餵 _estimate_remaining_defects 算殘餘。
    正規化:key strip+casefold(容忍大小寫/前後空白差異);同一 finder 內去重(重複只算一次)。"""
    from collections import Counter
    counter = Counter()
    for finder in finders:
        seen = set()
        for k in finder:
            nk = str(k).strip().casefold()
            if nk and nk not in seen:
                seen.add(nk)
                counter[nk] += 1
    return sorted(counter.values(), reverse=True)


def _cc_ints(cc):
    """capture_counts 型別守衛(2026-08-14 code-loop r1 s2 席):回純 int list,壞型回 None。
    非 list/元素非 int/bool 混入(bool 是 int 子類,isinstance 擋不住)一律判壞型——
    這些餵進 _estimate_remaining_defects 不炸、靜默算出假 0.0(最強假收斂訊號),
    所以所有讀側呼叫點統一過這裡,壞型明示、不得靜默算。"""
    if not isinstance(cc, list):
        return None
    if any(not isinstance(x, int) or isinstance(x, bool) for x in cc):
        return None
    return cc


def _estimate_remaining_defects(capture_counts):
    """capture-recapture 殘餘缺陷估計(Chao1 偏差修正版)。

    平行 panel 的收斂結構信號(loop 三輪壓縮):W 個獨立審計員讀同稿,
    `capture_counts` = 各 distinct 缺陷「被幾個審計員找到」的次數列表。
    從「只被 1 人找到(f1)」與「恰被 2 人找到(f2)」的比例估未找到的殘餘缺陷:
        remaining ≈ f1*(f1-1) / (2*(f2+1))   # 偏差修正,f2=0 不 div0
    高重疊(f1 小)→ 母體枯竭 → 殘餘≈0 → 收斂;低重疊(f1 大)→ 殘餘大 → 續跑。
    誠實天花板:小樣本估計會出極端值,當一個收斂信號、非 oracle(見設計節點)。"""
    if not capture_counts:
        return 0.0
    f1 = sum(1 for c in capture_counts if c == 1)
    f2 = sum(1 for c in capture_counts if c == 2)
    return f1 * (f1 - 1) / (2 * (f2 + 1))


def _round_valid_m2(recs):
    """M2 統一單位謂詞(有效輪):(caught+none)≥2 ∧ missed=0 ∧ 全部 kind ∈ 白名單。
    gate/fold/定錨/ledger/W 歸屬五處共用——嚴禁記錄級判定(2caught+1missed 輪的
    clusters 掛 caught 記錄上也不得採納);未知 kind 使輪無效(既有 2303 謂詞對此是盲的)。
    kind=none(2026-08-14 協議停用,Systems/canary-audit d5)=無植入輪,計入席數。"""
    kinds = [r.get("kind") for r in recs]
    if any(k not in ("caught", "missed", "none") for k in kinds):
        return False
    return (kinds.count("caught") + kinds.count("none")) >= 2 and kinds.count("missed") == 0


def _panel_extra_checks(latest, min_seats, spec):
    """M1包 判定輪加驗(code-loop 補審 r1 折入:cluster 與無-cluster 兩路皆須過,不得繞):
    min-seats 數相異非空 auditor(同席灌筆/空席不計)+ G3 hash(帶 --spec=聲明要驗)。回 fails 片段。"""
    fails = []
    if min_seats:
        seats = len({a for r in latest if (a := r.get("auditor"))})
        if seats < min_seats:
            print(f"[panel] min-seats 審查人數: ✗ — 規定 {min_seats} 個不同的人,實際只有 {seats} 個(同一人重複或沒填名字的不算)")
            fails.append("席數不足")
        else:
            print(f"[panel] min-seats 審查人數: ✓ — {seats} 個不同的人,達到規定的 {min_seats}")
    if spec is not None:
        err, info = _hash_chain_check([latest], spec)   # OSError 上拋至 cmd_loop_status 統一 rc2
        if err:
            print(f"[panel] G3 文件有沒有被事後改過: ✗ — {err}")
            fails.append("G3")
        elif info == "unbound":
            print("[panel] G3 文件有沒有被事後改過: ✗ — 判定輪的記錄沒帶文件指紋,沒辦法驗")
            fails.append("G3")
        else:
            print(f"[panel] G3 文件有沒有被事後改過: ✓ — {info}(同輪每筆指紋一致、最後一筆等於現在的檔)")
    return fails


def _panel_k2_active(rounds):
    """[A案 2026-08-05] K=2 適用判定:loop 首筆 ts 日期 ≥ cutoff(預設 2026-08-06)→新制。
    舊帳不回溯(spec 落地面5,借 T6 定錨慣例);env LUMOS_PANEL_K2_CUTOFF 供測試/緊急覆寫。"""
    import os
    cutoff = os.environ.get("LUMOS_PANEL_K2_CUTOFF", "2026-08-06")
    ts = str((rounds[0] if rounds else {}).get("ts") or "")
    return ts[:10] >= cutoff


def _panel_retired_for(rounds):
    """[probe輪退場 d1/甲裁 2026-08-25] panel 閘退役判定:loop 首筆 ts 日期 ≥ cutoff(預設
    2026-08-26)=新迴圈,panel 閘拒判並指路處置閘;舊迴圈(cutoff 前定錨)照常回放。
    env LUMOS_PANEL_RETIRE_CUTOFF 供測試/緊急覆寫。"""
    import os
    import re as _re
    cutoff = os.environ.get("LUMOS_PANEL_RETIRE_CUTOFF", "2026-08-26")
    ts = str((rounds[0] if rounds else {}).get("ts") or "")
    # ts 必須長得像日期才參與比較——非日期字串(測試假值/損壞帳)字典序會壓過日期字串,
    # 裸比較會把垃圾 ts 誤判成「未來新迴圈」而拒判(pre-push 全套實抓:fixture ts="t");
    # 非日期=舊帳語意,照舊放行(回放方向 fail-open)。
    return bool(_re.match(r"\d{4}-\d{2}-\d{2}", ts)) and ts[:10] >= cutoff


def _panel_round_conjuncts(recs, quiet=False):
    """單輪兩條合取(輪有效∧存活≤minor;capture-recapture 殘餘=advisory 觀測,2026-08-14 降級)——A案 K=2 抽出共用,
    ★單一實作★:判定輪(quiet=False,輸出逐字同改動前)與 K=2 前一輪(quiet=True)同函式。
    回 fails list。"""
    order = _SEV_ORDER   # 值序單一常數(嚴重度綁定機械掃 arch-f2 回填)
    fails = []
    caught_recs = [r for r in recs if r.get("kind") == "caught"]
    # 2026-08-14 canary 協議停用(Systems/canary-audit d5):kind=none=無植入輪的純處置帳載體。
    # none 制輪有效=記帳席數≥2 且零 missed(醒著證明改由 skill 層 quote-check 引句錨定機械把關);
    # 舊 caught 分支原樣保留(歷史帳/混用輪回放不變)。
    none_recs = [r for r in recs if r.get("kind") == "none"]
    caught = len(caught_recs)
    missed = sum(1 for r in recs if r.get("kind") == "missed")
    if none_recs and missed == 0 and (caught + len(none_recs)) >= 2:
        if not quiet:
            print(f"[panel] 輪有效: ✓ — {caught + len(none_recs)} 個人都記了帳")
    elif caught >= 2 and missed == 0:
        if not quiet:
            print(f"[panel] 輪有效: ✓ — {caught} 個人全部抓到植入的錯(near-perfect)")
    elif missed > 0:
        if not quiet:
            print(f"[panel] 輪有效: ✗ — 有 {missed} 人漏掉植入的錯(near-perfect 規則要求全員抓到;有人漏審的輪不能拿來當收斂證據)")
        fails.append("輪無效")
    else:
        if not quiet:
            print(f"[panel] 輪有效: ✗ — 記帳的人不夠(抓到 {caught} 人+無植入 {len(none_recs)} 人,少於 2 人,這輪無效)")
        fails.append("輪無效")
    # 嚴重度合取讀 caught+none(none 輪不讀會盲掉存活 findings——停用制下全輪都是 none)
    maxsev = max((order.get(r.get("severity", "clean"), 1) for r in caught_recs + none_recs), default=0)
    if maxsev >= 2:
        if not quiet:
            print(f"[panel] 留下的問題嚴不嚴重(最高只能到 minor): ✗ — 這輪還留著 {'blocker' if maxsev==3 else 'major'} 等級的問題沒解決,太嚴重不能過")
        fails.append("存活≥major")
    else:
        if not quiet:
            print("[panel] 留下的問題嚴不嚴重(最高只能到 minor): ✓ — 留下的問題都在可接受等級")
    # capture-recapture 殘餘:★2026-08-14 降 advisory,不進合取★(Projects/收斂閘殘餘估計降級_計劃 S1/S2)
    # 理由=鑑別力≈0(殘餘<1 組下輪 major+ 67% vs ≥1 對照組 79%,p≈0.25)+f1≤1 公式退化+席獨立前提被自家
    # 重疊分布(64-71% 單席獨佔)否定;舊「殘餘超門檻」「無capture_counts」兩條 fails 撤除。
    cc = next((r["capture_counts"] for r in recs if r.get("capture_counts")), None)
    if cc is None:
        if not quiet:
            print("[panel] 估計還有多少沒被抓到(看幾個人重複抓到同一條來推;只供參考,不影響過不過): 沒有重疊數據,算不出來")
    else:
        ccl = _cc_ints(cc)   # r1 s2:三個讀側呼叫點統一過型別守衛,壞型不得靜默算假 0.0
        if ccl is None:
            if not quiet:
                print("[panel] 估計還有多少沒被抓到(看幾個人重複抓到同一條來推;只供參考,不影響過不過): 數據格式不對,不算")
        else:
            remaining = _estimate_remaining_defects(ccl)
            if not quiet:
                note = "⚠ 低殘餘讀數無鑑別力(自帳對照 67% vs 79%,2026-08-14)" if remaining < 1.0 else ""
                print(f"[panel] 估計還有多少沒被抓到(看幾個人重複抓到同一條來推;只供參考,不影響過不過): 估計還有 {remaining:.2f} 個沒被抓到 {note}".rstrip())
    return fails


def _panel_probe_verdict(loop_id, rid, recs):
    """[A案 e'] 決定性抽查判定:sha256(loop_id+判定輪 rid+該輪 token 排序串)%2==0 → 應抽。
    輸入全部來自 append-only 帳(token=record 時 secrets 自動鑄造)——任何人可事後重算
    「該不該抽」,不依賴編排者誠實(r1 折入:原「編排者擲 p」嚇阻不成立)。"""
    import hashlib
    toks = ",".join(sorted(str(r.get("token") or "") for r in recs))
    h = int(hashlib.sha256(f"{loop_id}:{rid}:{toks}".encode("utf-8")).hexdigest(), 16)
    return h % 2 == 0


def _loop_status_panel(rounds, loop_id, min_seats=None, spec=None, env=None):
    """平行 panel 收斂謂詞(loop 三輪壓縮)。無-cluster 帳:兩條合取(輪有效∧存活max≤minor;殘餘=advisory
    ∧capture-recapture 殘餘,fail-closed)。cluster 帳(M2,設計 Projects/design-loop提效_計劃;
    golden: governance/golden/dloop-m2-cluster):首個有效輪帶 clusters 定錨 → 兩條合取
    (輪有效∧fold 後無 disputed-major),新生 cluster/capture-recapture 降 advisory,
    無效輪 clusters 忽略+警告區列帳(不蒸發)。讀側 rc2 類:round-id 非連續/型別損壞/
    有效輪 W 歸屬衝突/有效輪級混用。"""
    if _panel_retired_for(rounds):
        print("擋下:panel 閘自 2026-08-25 甲裁後僅供舊迴圈回放,這個編號是之後才開的新迴圈——", file=sys.stderr)
        print("  多席審查改用彙總記帳(處置清單只掛一席,其餘席只留痕),然後問處置閘:", file=sys.stderr)
        print("    lumos loop status <編號> --disposal --spec … --repo …", file=sys.stderr)
        print("  (詳 Projects/probe輪退場_計劃;帳不可撤,已誤記多筆處置清單就換編號重記)", file=sys.stderr)
        return 2
    from collections import OrderedDict
    groups = OrderedDict()
    for r in rounds:
        rid_ = r.get("round")
        if rid_ in groups and next(reversed(groups)) != rid_:
            # M2:round-id 被其他 round 隔開後重現=帳本次序損壞(append-only 不容跳寫)
            print(f"擋下:第 {rid_!r} 輪的記錄被別的輪次隔開後又出現(非連續重現),帳的順序亂了,沒辦法判斷",
                  file=sys.stderr)
            return 2
        groups.setdefault(rid_, []).append(r)
    if not groups:
        print(f"⏳ {loop_id} 還沒有任何一輪的多人審查記錄")
        return 1
    # ── M2 讀側型別防禦:clusters 欄必須是 dict[str,str](寫側轉型慣例;手改/損壞 → rc2 非 traceback)
    for r in rounds:
        if "clusters" in r:
            c = r["clusters"]
            if (not isinstance(c, dict)
                    or any(not isinstance(k, str) or not isinstance(v, str) for k, v in c.items())):
                print(f"擋下:有筆記錄的分組欄不是「群名:狀態」的形式(檔案壞了或被手改過?): {c!r}",
                      file=sys.stderr)
                return 2
    valid_of = {rid_: _round_valid_m2(recs) for rid_, recs in groups.items()}
    # ── M2 W 歸屬:有效輪同輪 >1 筆帶 clusters → rc2(無效輪多筆帶=豁免,列警告區)
    for rid_, recs in groups.items():
        if valid_of[rid_] and sum(1 for r in recs if "clusters" in r) > 1:
            print(f"擋下:第 {rid_} 輪有 {sum(1 for r in recs if 'clusters' in r)} 筆記錄都帶了分組,一輪只能有一筆"
                  f"(工具不會默默挑第一筆,請自己決定留哪筆)", file=sys.stderr)
            return 2
    # ── M2 定錨:第一個有效輪定模式(無效輪不定錨——首輪全 missed 的新 loop 不得鎖死)
    anchor_rid, anchor_cluster = None, False
    for rid_, recs in groups.items():
        if valid_of[rid_]:
            anchor_rid = rid_
            anchor_cluster = any("clusters" in r for r in recs)
            break
    if anchor_rid is not None:
        # 有效輪級混用守衛(無效輪豁免:帶或不帶皆不觸發)
        for rid_, recs in groups.items():
            if not valid_of[rid_]:
                continue
            has_c = any("clusters" in r for r in recs)
            if anchor_cluster and not has_c:
                print(f"擋下:這個審查編號從第 {anchor_rid} 輪起就是分組追蹤模式,但第 {rid_} 輪沒帶分組"
                      f";補那一輪的分組記錄,或開新的審查編號", file=sys.stderr)
                return 2
            if not anchor_cluster and has_c:
                print(f"擋下:這個審查編號從第 {anchor_rid} 輪起就定成不分組,但第 {rid_} 輪帶了分組"
                      f";想用分組追蹤請開新的審查編號,既有的不能中途改", file=sys.stderr)
                return 2
    if anchor_rid is not None and anchor_cluster:
        return _loop_status_panel_clusters(groups, valid_of, loop_id,
                                           min_seats=min_seats, spec=spec, all_rounds=rounds, env=env)
    # ── 無-cluster 舊帳(或零有效輪=未定錨):既有三條合取,fail-closed 不變 ──
    # cluster-intent 但未定錨(零有效輪):條 1 改用 M2 嚴格謂詞(unknown-kind 盲區補;
    # 純無-cluster loop 不受影響——舊行為迴歸保證只對真 legacy 帳)
    _cluster_intent = any("clusters" in r for r in rounds)
    rid, latest = next(reversed(groups.items()))
    if _cluster_intent and not valid_of[rid]:
        print(f"[panel] 輪有效: ✗ — 分組追蹤模式下第 {rid} 輪無效(要至少 2 人抓到、0 人漏掉)")
        for i, r in enumerate(latest, 1):
            print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('auditor','')}")
        print(f"⛔ PANEL GATE FAIL({loop_id} 第 {rid} 輪沒通過:這輪無效,分組模式也還沒定下來)")
        return 1
    fails = _panel_round_conjuncts(latest)   # A案:三條合取抽出共用(輸出逐字同改動前)
    # [A案 2026-08-05] K=2:cutoff 起的新 loop,收斂需最後★兩★輪各自過三條合取
    # (AEGIS 非單調序列+relmainnet 既遂實例;design-loop r1+r2 收斂裁定)。舊帳不回溯。
    k2 = _panel_k2_active(rounds)
    if k2 and not fails:
        rids = list(groups)
        if len(rids) < 2:
            print("[panel] K=2 連續兩輪乾淨: ✗ — 目前只有一輪(規則要連續兩輪都合格;第二輪要審全量材料)")
            fails.append("K=2需第二輪")
        else:
            prev_rid = rids[-2]
            prev_fails = _panel_round_conjuncts(groups[prev_rid], quiet=True)
            if prev_fails:
                print(f"[panel] K=2 連續兩輪乾淨: ✗ — 前一輪 {prev_rid} 沒過({'/'.join(prev_fails)})")
                fails.append("K=2前一輪未乾淨")
            else:
                # 前一輪殘餘觀測行內附值(S2:quiet 路徑不重印整段,但 K=2 為新 loop 預設,
                # 不附值則前一輪殘餘觀測在常態下整段消音——r1 邊界席 P8)
                pcc = next((r["capture_counts"] for r in groups[prev_rid] if r.get("capture_counts")), None)
                pccl = _cc_ints(pcc) if pcc is not None else None
                if pcc is None:
                    obs = "殘餘 obs 缺席"
                elif pccl is None:
                    obs = "殘餘 obs 壞型(counts 非 int list)"   # r1 s2:同守衛,壞型不印假值
                else:
                    obs = f"殘餘 obs {_estimate_remaining_defects(pccl):.2f}"
                print(f"[panel] K=2 連續兩輪乾淨: ✓ — 前一輪 {prev_rid} 也合格({obs})")
    fails += _panel_extra_checks(latest, min_seats, spec)
    for i, r in enumerate(latest, 1):
        print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('capture_counts','-')}\t{r.get('auditor','')}")
    for line in _cost_summary(rounds):
        print(line)
    if fails:
        print(f"⛔ PANEL GATE FAIL({loop_id} 第 {rid} 輪沒通過,卡在:{'/'.join(fails)})")
        return 1
    if k2:
        probe = _panel_probe_verdict(loop_id, rid, latest)
        print(f"✅ PANEL GATE PASS({loop_id} 第 {rid} 輪通過:連續兩輪乾淨、這輪有效、留下的問題都在可接受等級)")
        _loop_gov_mark(env, loop_id, "converged", "gate PASS")
        print(f"[panel] 抽查判定(觀測,任何人都能重算出同樣結果): {'本輪落在應抽樣——2026-08-25 起 panel 僅回放、不再加開 probe 輪(詳 Issues/probe輪三參數只在散文)' if probe else '免抽'}")
    else:
        print(f"✅ PANEL GATE PASS({loop_id} 第 {rid} 輪通過:這輪有效、留下的問題都在可接受等級)")
        _loop_gov_mark(env, loop_id, "converged", "gate PASS")
    return 0


def _loop_status_panel_clusters(groups, valid_of, loop_id, min_seats=None, spec=None, all_rounds=None, env=None):
    """M2 cluster 帳 gate:兩條合取(判定輪有效 ∧ fold 後無 disputed-major)。
    fold 只採有效輪(last-wins,同名跨輪最後狀態勝);無效輪 clusters 警告區列帳不蒸發;
    新生 cluster 與 capture-recapture 皆 advisory 不進合取。"""
    order = _SEV_ORDER   # 值序單一常數(嚴重度綁定機械掃 arch-f2 回填)
    rid, latest = next(reversed(groups.items()))
    fails = []
    # 條 1:判定輪(latest)有效——同一謂詞
    caught_recs = [r for r in latest if r.get("kind") == "caught"]
    n_caught, n_missed = len(caught_recs), sum(1 for r in latest if r.get("kind") == "missed")
    n_none = sum(1 for r in latest if r.get("kind") == "none")   # 停用制輪(d5)
    if valid_of[rid]:
        # 顯示與謂詞同步(終審 F4:原字面只印 caught,none 制輪印出「caught 0≥2 ✓」自相矛盾)
        if n_none:
            print(f"[panel/cluster] 輪有效: ✓ — {n_caught + n_none} 人記帳、沒人漏審")
        else:
            print(f"[panel/cluster] 輪有效: ✓ — {n_caught} 人抓到植入的錯、沒人漏")
    else:
        print(f"[panel/cluster] 輪有效: ✗ — 抓到 {n_caught} 人/無植入 {n_none} 人/漏掉 {n_missed} 人"
              f"(規則:記帳的人至少 2 個、沒人漏掉、每筆記錄的種類都合法)")
        fails.append("輪無效")
    # fold(僅有效輪,append 序 last-wins)+ ledger(首現/末更輪僅計有效輪,與 advisory 同源)
    from collections import OrderedDict as _OD
    ledger = _OD()
    for rid_, recs in groups.items():
        if not valid_of[rid_]:
            continue
        for r in recs:
            for name, state in (r.get("clusters") or {}).items():
                if name not in ledger:
                    ledger[name] = {"state": state, "first": rid_, "last": rid_}
                else:
                    ledger[name]["state"] = state
                    ledger[name]["last"] = rid_
    disputed = [n for n, e in ledger.items() if e["state"].split(":", 1)[0] == "disputed-major"]
    if disputed:
        print(f"[panel/cluster] 有沒有分組還卡在爭議且嚴重(disputed-major): ✗ — 還有 {len(disputed)} 組: {','.join(disputed)}")
        fails.append("存在disputed-major")
    else:
        print("[panel/cluster] 有沒有分組還卡在爭議且嚴重(disputed-major): ✓ — 沒有")
    # advisory:新生 cluster(僅基於有效輪;判定輪無效 → 不適用)
    if valid_of[rid]:
        born = [n for n, e in ledger.items() if e["first"] == rid]
        print(f"[panel/cluster] (僅供參考)這輪新生 cluster: {len(born)} 個"
              + (f": {','.join(born)}" if born else ""))
    else:
        print("[panel/cluster] (僅供參考)新生 cluster: 這輪無效,不統計")
    # advisory:capture-recapture(照算照印,不進合取;無 counts 不 fail-closed——cluster 帳接手守門)
    cc = next((r["capture_counts"] for r in latest if r.get("capture_counts")), None)
    ccl = _cc_ints(cc) if cc is not None else None   # r1 s2/s3:讀側統一型別守衛
    if cc is not None and ccl is None:
        print("[panel/cluster] (僅供參考)capture-recapture 漏網估計: 數據格式不對,不算")
    elif ccl is not None:
        remaining = _estimate_remaining_defects(ccl)
        print(f"[panel/cluster] (僅供參考)capture-recapture 漏網估計: 還有約 {remaining:.2f} 個沒抓到(不影響過不過)")
    else:
        print("[panel/cluster] (僅供參考)capture-recapture 漏網估計: 沒有重疊數據,算不出來")
    # 警告區:無效輪攜帶的 clusters(已忽略;資料本在 canary-log,顯示即留痕——status 唯讀)
    for rid_, recs in groups.items():
        if valid_of[rid_]:
            continue
        carried = []   # 全列:同名多筆逐條保留(dict.update 會靜默覆蓋掩掉爭議狀態)
        for r in recs:
            carried.extend((n, s) for n, s in (r.get("clusters") or {}).items())
        if carried:
            print(f"  ⚠ {rid_}(無效輪) clusters 已忽略: "
                  + ",".join(f"{n}={s}" for n, s in carried))
    # ledger 表
    if ledger:
        print("  ── cluster ledger(僅計有效輪)──")
        for n, e in ledger.items():
            print(f"  {n}\t{e['state']}\t首現 {e['first']}\t末更 {e['last']}")
    # [A案 2026-08-05] K=2(cluster 路同窗):fold 帳是累積的,故第二條件=前一輪也是有效輪
    _k2c = _panel_k2_active(all_rounds or [])
    if _k2c and not fails:
        rids_ = list(groups)
        prev_valid = len(rids_) >= 2 and valid_of.get(rids_[-2], False)
        if not prev_valid:
            print("[panel/cluster] K=2 連續兩輪乾淨: ✗ — " + ("目前只有一輪" if len(rids_) < 2 else f"前一輪 {rids_[-2]} 無效")
                  + "(K=2 需連續兩個有效輪)")
            fails.append("K=2前一輪未乾淨")
        else:
            print(f"[panel/cluster] K=2 連續兩輪乾淨: ✓ — 前一輪 {rids_[-2]} 也合格")
    fails += _panel_extra_checks(latest, min_seats, spec)   # M1包:cluster 路不得繞過(code-loop r1)
    for i, r in enumerate(latest, 1):
        print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('auditor','')}")
    for line in _cost_summary(all_rounds or []):
        print(line)
    if fails:
        print(f"⛔ PANEL GATE FAIL({loop_id} 第 {rid} 輪沒通過,卡在:{'/'.join(fails)})")
        return 1
    if _k2c:
        probe = _panel_probe_verdict(loop_id, rid, latest)
        print(f"✅ PANEL GATE PASS({loop_id} 第 {rid} 輪通過:連續兩輪乾淨、這輪有效、沒有分組卡在 disputed-major"
              f"[cluster 帳,{len(ledger)} 個 cluster])")
        _loop_gov_mark(env, loop_id, "converged", "panel gate PASS")
        print(f"[panel] 抽查判定(觀測,任何人都能重算出同樣結果): {'本輪落在應抽樣——2026-08-25 起 panel 僅回放、不再加開 probe 輪(詳 Issues/probe輪三參數只在散文)' if probe else '免抽'}")
    else:
        print(f"✅ PANEL GATE PASS({loop_id} 第 {rid} 輪通過:這輪有效、沒有分組卡在 disputed-major"
              f"[cluster 帳,{len(ledger)} 個 cluster])")
        _loop_gov_mark(env, loop_id, "converged", "panel gate PASS")
    return 0


def cmd_loop_capture_counts(env, finders, from_pitfalls=None, repo=None):
    """異質 panel 接線的機械生產者(code-loop 三輪壓縮):把各 finder 的 finding-key
    彙成 capture_counts + 算殘餘估計,吐出可直接餵 `canary record --capture-counts` 的逗號串。

    為什麼要機械算:重疊計數(哪個洞被幾個 finder 找到)是 capture-recapture 的核心輸入,
    人手數易錯——正是該機械化的。異質 finder 一律先正規化 key 再跨 finder 數重疊:
    LLM reviewer 的 finding、`pitfalls --diff` 的 SARIF linter 命中、測試失敗、mutation 存活,
    每個 finder 給一個 --finder(逗號分隔它找到的 key,如 file:line 或 section:nature)。
    確定性工具與 LLM 錯誤剖面正交 → 真獨立票,重疊(同洞多 finder 中)= 更強收斂信號。

    --from-pitfalls <range>:自動收割 `pitfalls --diff` 的命中成確定性 finder(免手貼)——
    按 source 分組(每個 linter driver / pitfalls 內建各自一個 finder,錯誤剖面互不相同),
    每個 finder = 該 source 命中的 `file:line` 集合,併進手動 --finder 一起算重疊。
    這關掉「手動把 linter 命中貼成 --finder」那半破口。

    finders = [comma_str, ...](每個 --finder 一項)。空/全空 → 印 0 缺陷、殘餘 0.0。"""
    parsed = [[k for k in str(fs).split(",") if k.strip()] for fs in (finders or [])]
    harvested = []
    if from_pitfalls:
        repo_root = _anchor_repo_root(repo)
        if repo_root is None:
            return 2
        data = _pitfall_diff_collect(from_pitfalls, repo_root, no_lint=False)
        if data is None:
            return 2                              # git 錯誤(壞 range 等),collect 已印
        from collections import OrderedDict
        by_source = OrderedDict()
        for c in data.get("claims", []):
            src = c.get("source") or "pitfalls-builtin"
            by_source.setdefault(src, []).append(f"{c['file']}:{c['line']}")
        for src, keys in by_source.items():
            harvested.append((src, keys))
            parsed.append(keys)
        for src, keys in harvested:
            print(f"收割 from-pitfalls finder [{src}]: {len(keys)} 命中")
    cc = _capture_counts_from_finders(parsed)
    remaining = _estimate_remaining_defects(cc)
    n_finders = len(parsed)
    n_distinct = len(cc)
    print(f"finders={n_finders} distinct-findings={n_distinct} "
          f"capture_counts={','.join(str(c) for c in cc) if cc else '(空)'}")
    print(f"remaining-estimate={remaining:.2f}  "
          "(僅供參考,不影響收斂判定——實測這個數字分不出好壞,別拿它決定要不要續跑)")
    if cc:
        print(f"→ canary record ... --capture-counts {','.join(str(c) for c in cc)}")
    return 0


def _hash_chain_check(rounds_list, spec_path, cur_sha_override=None):
    """M1包 #3 雙 hash 鏈收斂窗驗證(loop機械脊椎M1包_計劃)。
    rounds_list=[[rec,...],...] 窗內按序的「輪」列表(legacy=每筆一輪;panel=判定輪一組)。
    回 (fail_msg or None, info):fail=None 且 info='unbound' 表窗內全無 hash(呼叫端裁 FAIL/advisory)。
    驗四件:窗級 all-or-nothing(帶=雙欄俱全)/同輪雙欄各自一致/鏈續性 reviewed[k+1]==result[k]/
    窗末 result==sha256(當前檔)。窗首 reviewed 無窗內錨=已知逃逸不硬驗。"""
    def has_hash(r):
        return "reviewed_sha256" in r and "result_sha256" in r
    def half(r):
        return ("reviewed_sha256" in r) != ("result_sha256" in r)
    all_recs = [r for grp in rounds_list for r in grp]
    if any(half(r) for r in all_recs):
        return "收斂窗 hash 半帶(記錄僅有 reviewed/result 其一——雙欄必須成對)", ""
    banded = [has_hash(r) for r in all_recs]
    if not any(banded):
        return None, "unbound"
    if not all(banded):
        return "收斂窗 hash 半帶——收斂憑證無法互證(窗內任一筆帶即全體必須帶)", ""
    per_round = []   # [(reviewed, result), ...] 每輪一組
    for grp in rounds_list:
        revs = {r["reviewed_sha256"] for r in grp}
        ress = {r["result_sha256"] for r in grp}
        if len(revs) > 1 or len(ress) > 1:
            return ("同輪 hash 分裂——各席 reviewed 或 result 不一致(同輪宣稱多個版本)", "")
        per_round.append((next(iter(revs)), next(iter(ress))))
    for k in range(len(per_round) - 1):
        if per_round[k + 1][0] != per_round[k][1]:
            return (f"鏈續性斷裂——第 {k + 2} 輪 reviewed ≠ 第 {k + 1} 輪 result"
                    "(折入版本與下輪受審版本不接)", "")
    if cur_sha_override is not None:
        cur = cur_sha_override   # replay 凍結模式:G3 對閉包裡的凍結 sha,spec 檔之後合法演化不影響回放(改制回測 r1 s1-f1)
    else:
        cur = _sha256_file(spec_path)   # OSError 上拋——呼叫端統一 rc2(code-loop r2:panel/light 原轉字串成 rc1,與 G1 不對稱)
    if per_round[-1][1] != cur:
        return "spec 於審計後被改動(窗末 result ≠ 當前檔),需再過一輪", ""
    return None, f"{len(per_round)} 輪鏈驗訖"


def _cost_summary(rounds):
    """M1包 #4:任一筆有成本欄時回摘要行 list,否則空(零噪音)。"""
    rows = [(i, r) for i, r in enumerate(rounds, 1)
            if "tokens" in r or "wallclock_min" in r]
    if not rows:
        return []
    out = ["成本(自報,GIGO 同 anchors):"]
    tt = tm = 0
    for i, r in rows:
        tk, mn = r.get("tokens"), r.get("wallclock_min")
        tt += tk or 0
        tm += mn or 0
        out.append(f"  #{i}: tokens={tk if tk is not None else '-'} 分鐘={mn if mn is not None else '-'}")
    out.append(f"  總計: tokens={tt} 分鐘={tm}")
    return out


_COMPRESS_PIN_RE = re.compile(
    r"★INVARIANT★|★IRREVERSIBLE★|★CHECKPOINT★|停在放行點|anchor\s*驗證|anchor\s*verify|\[PIN\]", re.I)
_COMPRESS_EVID_RE = re.compile(r"VERIFY:|✅|\[test:|^\s*TEST:", re.I)
_COMPRESS_OPEN_RE = re.compile(r"-\s*\[\s\]|TODO|BLOCKER|⏳|未結", re.I)


def cmd_loop_compress(file, as_json=False):
    """[S2] 結構化壓縮(結清式收斂_計劃,2026-07-28):長跑上下文不交通用摘要——規則式三欄:
    壓不掉白名單(★合約/停在放行點/anchor 驗證/[PIN] 口頭約定)/已驗證證據(VERIFY:/✅/[test:)/
    未結約束(checkbox/TODO/BLOCKER)。白名單行在輸出**必存在**(治 governance decay 殘餘面:
    對話中途口頭約定寫成 [PIN] 行即壓不掉);無標記散文可丟。零模型、純規則,輸出走 stdout
    (落檔權在消費者——orchestrator 自行重導)。rc0 成功/rc2 檔不可讀。"""
    import json
    try:
        lines = Path(file).read_text(encoding="utf-8-sig").splitlines()
    except OSError as e:
        print(f"擋下:檔案讀不到({e}): {file}", file=sys.stderr)
        return 2
    pinned, evidence, open_items = [], [], []
    for ln in lines:
        s = ln.strip()
        if not s:
            continue
        if _COMPRESS_PIN_RE.search(s):
            pinned.append(s)
        elif _COMPRESS_EVID_RE.search(s):
            evidence.append(s)
        elif _COMPRESS_OPEN_RE.search(s):
            open_items.append(s)
    if as_json:
        print(json.dumps({"pinned": pinned, "evidence": evidence, "open": open_items,
                          "input_lines": len(lines)}, ensure_ascii=False, indent=1))
        return 0
    print("# 壓縮狀態(規則式;白名單壓不掉)")
    for title, bucket in (("壓不掉白名單", pinned), ("已驗證證據", evidence), ("未結約束", open_items)):
        print(f"## {title}")
        for s in bucket:
            print(f"- {s}")
    print(f"[compress] 輸入 {len(lines)} 行 → 保留 {len(pinned) + len(evidence) + len(open_items)} 行"
          f"(白名單 {len(pinned)}/證據 {len(evidence)}/未結 {len(open_items)})")
    return 0


# ── loop list:哪些審查迴圈還開著(執行DAG_調研 排第一順位的缺口) ──
# next/status/verify-progress 全都強制要 loop_id,卻沒有任何入口能先知道有哪些編號在飛,
# 實務上只能 tail .canary-log.jsonl 或看 git 未追蹤檔。關門訊號取治理帳的放行事件——
# 那是既有的、寫入當下就落的、可重算的東西,不新增任何要人維護的狀態。
# ★關門事件分成兩組,因為兩本帳認迴圈的方式不一樣★(2026-09-07 代碼審 r1,三席獨立抓到)
# 設計審那組把迴圈編號寫進 nodes 欄(109 筆全部有);
# ★code-loop 那組的 nodes 欄永遠是空陣列★(148 筆全空)——因為那本帳認的是「分支 + 版本」
# 不是迴圈編號,兩套識別體系從來沒建過對應關係。
# 第一版把兩組混在同一個集合裡用 nodes 比對,結果 code-loop 那半是死碼,
# 而且**實測有 23 個早就過閘的 code 迴圈被報成「空轉候選」**(code-234 / code-kill / code-cochange …)。
LOOP_CLOSE_EVENTS = {("design-loop", "converged"), ("design-loop", "cap-reached"),
                     ("design-loop", "rewrite")}
# code-loop 這組只能從自由文字的 detail 認編號(慣例上 detail 開頭就是編號)。
# ★這是啟發式,不是保證★:detail 是人寫的欄位,沒有任何機制強制它以編號開頭。
# 失效方式=編號沒寫在 detail 裡 → 那個迴圈會被報成沒關門(偏保守,不會反過來誤報成關了)。
# REVISIT:2026-11-07 正解是讓 code-loop pass/skip 收一個 --loop 參數、把編號寫進 nodes,
#   跟設計審那組同形;那要動到推送閘會呼叫的路徑,本批不做。
LOOP_CLOSE_EVENTS_BY_DETAIL = {("code-loop", "passed"), ("code-loop", "skipped")}
# ★這兩組以外的 (gate, kind) 都要在下面這張表裡分類過★——新增一種收工事件卻忘了歸類,
# 守衛會翻紅(t_loop_close_kinds_classified)。沒有這道,新的 kind 只會被靜默當成「沒關門」。
LOOP_NOT_CLOSE_EVENTS = {
    ("design-loop", "replay-refreeze"),   # 已凍結的判定重新凍一次,是基準更新不是收斂;
                                          # 而且重凍在判定 FAIL 時也會發生,當成關門會製造新洞
    # 2026-09-08 #19:閘擋人時由做判定的子命令自己落 kind=blocked 的 hard 帳。
    # ★擋人不是關門★——那是一次推送被擋下,迴圈本身沒有任何狀態變化。
    # 同族的 skipped-env / fail-open 在真實帳上出現第一筆時,守衛 t_loop_close_kinds_classified
    # 會再提醒;那時同樣歸這裡(★不得歸「算關門」★)。表裡只列真的出現過的(守衛的反向條件)。
    ("code-loop", "blocked"),
    # 棧別提問表態閘(2026-09-09):表態記錄與 recall-miss 帳都是陳述,不是關門(r2 接手席 H1:忘了登記守衛翻紅)。
    ("code-loop", "dispositions"),
    ("code-loop", "recall-miss"),
}
LOOP_CLOSE_SINCE = "2026-08-22"   # 治理帳出現第一筆 design-loop converged 的日子
# ★誠實記★:code-loop 的放行事件早得多(最早 2026-07-05),比這個日期早六週。
# 上面那個日期只用在「設計審那組」的免責聲明,不涵蓋 code-loop 那組。


def _loop_ts_key(ts):
    """ISO 時間字串 → 可比較的 UTC 秒數;解析不動或沒帶時區就回 None(呼叫端退回字串比對)。

    ★為什麼需要這一層★:審查帳與治理帳今天全部寫 +08:00(當場數過:1101 / 26443 筆都是),
    所以直接拿字串比大小剛好會對。但那是巧合不是保證——只要有一筆從別的時區(或 UTC)
    寫進來,字串比對就會**靜默**把開著判成關了、或反過來。這層把那個假設消掉,成本幾行。
    沒帶時區的一律不猜(回 None):猜錯比退回字串比對更糟。"""
    import datetime
    if not ts:
        return None
    try:
        d = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None
    if d.tzinfo is None:
        return None
    return d.timestamp()


def _loop_ts_newer(a, b):
    """a 是不是比 b 晚。兩邊都解得動就比 UTC 秒數,否則退回字串比對(舊帳相容)。"""
    ka, kb = _loop_ts_key(a), _loop_ts_key(b)
    if ka is not None and kb is not None:
        return ka > kb
    return (a or "") > (b or "")


# ★「關門後又記帳」不等於「重開」★(2026-09-07 代碼審 r1 折入時發現)
# 第一版判「最後一筆記錄比關門事件晚 → 算開著」。對真實資料是錯的:**過閘之後才補記帳是常態**
# ——實測 code-234 唯一那筆審查記錄比 code-loop 過閘晚 8 分鐘、code-kill 晚 14 分鐘,
# 兩個都是同一次工作的收尾簿記,卻被判成「又開新輪」而永遠列在空轉候選裡。
# 判準改成看時間差:同一天內的記帳算收尾,隔天以後才算真的重開。
# ★24 小時是拍的,不是量出來的★——它擋掉的是「幾分鐘的簿記時差」這個已觀察到的形態;
# 真的重開一個迴圈通常隔天以後,但沒有資料能證明這個門檻的最佳值。
# REVISIT:2026-11-07 若出現「關門後隔天以內真的重開」的實例,這個門檻要改成看輪次標籤而不是時間。
_LOOP_REOPEN_GRACE_SEC = 24 * 3600


def _loop_reopened(last_ts, close_ts):
    """還開著嗎。沒有關門事件=開著;有關門事件但之後隔了超過寬限期又記帳=重開。"""
    if not close_ts:
        return True
    ka, kb = _loop_ts_key(last_ts), _loop_ts_key(close_ts)
    if ka is None or kb is None:                  # 解不動就退回舊行為(字串比對)
        return (last_ts or "") > (close_ts or "")
    return (ka - kb) > _LOOP_REOPEN_GRACE_SEC


def _loop_close_stamps(env, known_loops=()):
    """治理帳 → {loop_id: 最後一次關門事件的 ts}。壞行跳過(回傳跳過行數)。

    兩條認法(理由見 LOOP_CLOSE_EVENTS 上面那段):
    - 設計審那組:編號寫在 nodes 欄,直接比對。
    - code-loop 那組:nodes 永遠空,只能從自由文字 detail 認編號——所以要先知道有哪些編號
      (known_loops,從審查帳來),再看 detail 裡有沒有出現。★啟發式,失效偏保守★。
    """
    import json, re as _re
    path = env.vault.parent / ".governance-log.jsonl"
    stamps, bad = {}, 0
    if not path.exists():
        return stamps, bad
    # 長的編號先比,免得 code-audit-batch4 吃掉 code-audit-batch4b 的 detail
    ordered = sorted((l for l in known_loops if l), key=len, reverse=True)
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            bad += 1
            continue
        # ★合法 JSON 但不是物件(例如一行 []、null、42)也要跳過★(2026-09-07 代碼審 r1 外家席):
        # 第一版只接 json.loads 的 ValueError,接著就 d.get(),這三種會拋 AttributeError 讓整支炸掉,
        # 違反自己承諾的「壞行跳過」。測試也只餵語法壞掉的行,沒餵這種。
        if not isinstance(d, dict):
            bad += 1
            continue
        gk = (d.get("gate"), d.get("kind"))
        ts = d.get("ts") or ""
        if gk in LOOP_CLOSE_EVENTS:
            for n in (d.get("nodes") or []):
                if isinstance(n, str) and _loop_ts_newer(ts, stamps.get(n, "")):
                    stamps[n] = ts
        elif gk in LOOP_CLOSE_EVENTS_BY_DETAIL and ordered:
            detail = d.get("detail") or ""
            for lid in ordered:
                if _re.search(r"(?<![\w-])" + _re.escape(lid) + r"(?![\w-])", detail):
                    if _loop_ts_newer(ts, stamps.get(lid, "")):
                        stamps[lid] = ts
                    break
    return stamps, bad


def cmd_loop_list(env, days=14, show_all=False, stale_only=False, as_json=False, now=None,
                  exclude=None):
    """帳面上還開著的審查迴圈。開著=沒有關門事件,或關門後又記了新的審查輪次。

    ★誠實界線★:設計審那組的關門事件慣例 %s 才開始,更早的迴圈天生沒有這筆
    (code-loop 那組早得多,最早 2026-07-05)——所以「沒關門」只等於「帳面沒看到關門事件」,
    不等於「沒做完」。code-loop 那組還多一層:它的編號只在自由文字裡,認法是啟發式,
    認不到就報成沒關門(偏保守)。唯讀恆 rc0(比照 canary-stats);
    壞行跳過但出聲(不靜默,也不 fail-closed——這是查詢不是閘)。""" % LOOP_CLOSE_SINCE
    import json, datetime
    path = env.vault.parent / ".canary-log.jsonl"
    per = {}
    bad = 0
    if path.exists():
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                bad += 1
                continue
            if not isinstance(d, dict):      # 合法 JSON 但不是物件(見 _loop_close_stamps 的說明)
                bad += 1
                continue
            lid = d.get("loop")
            if not isinstance(lid, str) or not lid:
                continue
            e = per.setdefault(lid, {"loop": lid, "last_ts": "", "rounds": set(), "records": 0,
                                     "last_severity": None, "tier": None, "orchestrator": None})
            e["records"] += 1
            ts = d.get("ts") or ""
            if not _loop_ts_newer(e["last_ts"], ts):   # ts >= last_ts(時區安全)
                e["last_ts"] = ts
                e["last_severity"] = d.get("severity")
            if d.get("round"):
                e["rounds"].add(d["round"])
            else:
                e["roundless"] = e.get("roundless", 0) + 1
            e["tier"] = e["tier"] or d.get("tier")
            e["orchestrator"] = e["orchestrator"] or d.get("orchestrator")
    closed, gbad = _loop_close_stamps(env, known_loops=per.keys())
    bad += gbad
    if now:
        try:
            today = datetime.date.fromisoformat(now)
        except ValueError:
            print("擋下:--now 要給 YYYY-MM-DD 這種格式的日期,你給的是 %r" % now, file=sys.stderr)
            print("  為什麼在意:這個值決定「幾天沒動」怎麼算,猜錯會把還在跑的迴圈報成空轉。", file=sys.stderr)
            print("  正確用法(不帶就是今天):", file=sys.stderr)
            print("      lumos loop list --now 2026-09-07", file=sys.stderr)
            return 2
    else:
        today = datetime.date.today()

    def _idle(ts):
        try:
            return (today - datetime.date.fromisoformat(ts[:10])).days
        except ValueError:
            return None

    rows = []
    for e in per.values():
        cts = closed.get(e["loop"], "")
        # ★輪數在「有的帶輪次、有的不帶」時不吐精確數字★(2026-09-07 代碼審 r1,兩席獨立指出):
        # 第一版是「有 round 就數相異值,全沒有才數筆數」,於是 3 筆裡只有 1 筆帶 r1 會顯示「1 輪」
        # ——比實際少、而且看起來像剛開始。同一份帳餵給 loop next / loop status 都是 rc2 擋下並說
        # 「分不出哪輪是判定輪」。這支是唯讀查詢不該擋,但也不該假裝算得準:混用就回 None。
        _mixed = bool(e["rounds"]) and e.get("roundless")
        rows.append({"loop": e["loop"], "last_ts": e["last_ts"], "idle_days": _idle(e["last_ts"]),
                     "rounds": None if _mixed else (len(e["rounds"]) or e["records"]),
                     "rounds_mixed": bool(_mixed), "last_severity": e["last_severity"],
                     "tier": e["tier"], "orchestrator": e["orchestrator"],
                     "closed_ts": cts or None,
                     "open": _loop_reopened(e["last_ts"], cts)})
    # 排除前綴:自主迴圈的每日場次(auto-YYYY-MM-DD)天生不會有關門事件、一天長一個,
    # 不排掉的話這份清單遲早被它們淹掉。★不寫死任何前綴★——要排什麼由呼叫端說。
    n_excluded = 0
    if exclude and any((x or "") == "" for x in exclude):
        # ★空前綴等於排除全部★(2026-09-07 代碼審 r1,兩席獨立指出):任何字串都以空字串開頭,
        # 於是 --exclude "" 會把清單清空,而人讀模式印出來的是「還沒關門的有 0 個」
        # ——跟「真的全部結案了」長得一模一樣。這支工具存在的理由就是不要讓人漏看還開著的迴圈,
        # 一個常見的手滑(組指令時某項是空的)會造成方向完全相反的靜默假全清。擋下,不猜。
        print("擋下:--exclude 不能給空字串——任何編號都以空字串開頭,那會把整份清單排空,",
              file=sys.stderr)
        print("      而印出來會跟「真的全部結案了」長得一樣。要排什麼就寫什麼,例如:", file=sys.stderr)
        print("      lumos loop list --exclude auto-", file=sys.stderr)
        return 2
    if exclude:
        keep = [r for r in rows if not any(r["loop"].startswith(x) for x in exclude)]
        n_excluded = len(rows) - len(keep)
        rows = keep
    rows.sort(key=lambda r: (_loop_ts_key(r["last_ts"]) or float("-inf"), r["last_ts"]), reverse=True)
    fresh = [r for r in rows if r["open"] and (r["idle_days"] is None or r["idle_days"] <= days)]
    stale = [r for r in rows if r["open"] and r["idle_days"] is not None and r["idle_days"] > days]
    done = [r for r in rows if not r["open"]]
    if bad:
        print("提醒:審查帳/治理帳有 %d 行讀不動,已跳過。" % bad, file=sys.stderr)
        print("  為什麼在意:讀不動的那幾行如果是關門事件,這份清單會把已經結案的迴圈報成還開著。", file=sys.stderr)
        print("  想知道是哪幾行:", file=sys.stderr)
        print("      git diff HEAD~1 -- docs/.canary-log.jsonl docs/.governance-log.jsonl", file=sys.stderr)
    if as_json:
        print(json.dumps({"now": today.isoformat(), "days": days, "open": fresh,
                          "stale": stale, "closed": done}, ensure_ascii=False, indent=2))
        return 0
    if not rows:
        print("審查帳裡還沒有任何迴圈。開第一輪:")
        print("    lumos loop next <編號> --tier standard --orchestrator claude --spec <計劃.md>")
        return 0

    def _line(r):
        idle = "?" if r["idle_days"] is None else "%d 天前" % r["idle_days"]
        sev = r["last_severity"] or "—"
        rnd = "混用?" if r.get("rounds_mixed") else "%2d 輪" % r["rounds"]
        return "  %-8s %-5s  最後一筆 %-7s  %s" % (idle, rnd, sev, r["loop"])

    if stale_only:
        print("審查迴圈:超過 %d 天沒動、帳面又沒關門的有 %d 個(空轉候選)" % (days, len(stale)))
        for r in stale:
            print(_line(r))
    else:
        print("審查迴圈:帳面上還沒關門的有 %d 個(最近 %d 天有動)" % (len(fresh), days))
        for r in fresh:
            print(_line(r))
        if show_all:
            print()
            print("已關門的 %d 個:" % len(done))
            for r in done:
                print("  %s  關於 %s" % (r["loop"], (r["closed_ts"] or "")[:10]))
    print()
    print("沒關門「不等於」沒做完——關門事件(治理帳裡的放行紀錄)這個慣例 %s 才開始," % LOOP_CLOSE_SINCE)
    print("更早的迴圈天生沒有這一筆;這裡只說「帳面沒看到關門事件」。")
    if not stale_only and stale:
        print("另有 %d 個超過 %d 天沒動也沒關門(空轉候選),看它們:" % (len(stale), days))
        print("    lumos loop list --stale")
    if n_excluded:
        print("(依 --exclude 略過 %d 個編號)" % n_excluded)
    print()
    print("要接哪一個,先問它下一步:")
    print("    lumos loop next <編號> --spec <計劃.md>")
    return 0


def cmd_loop_canary_stats(env, loop_id=None):
    """[d4 承諾的讀取面,2026-08-05] 跨輪 canary 累積帳彙總——寫入面(record note/caught/missed)
    T1-T7 落地後一直只能人翻 JSONL,正是「機制蓋好在等一個記得用它的人」病(全流程體檢命名)。
    席位×caught/missed×尾端連續 missed streak;streak≥2 印升級提示(「連 2 missed 升 opus」
    規則的機械眼——原靠編排者記得)。純唯讀觀測恆 rc0;壞行跳過並註記(不進任何 gate)。"""
    import json
    from collections import OrderedDict
    path = env.vault.parent / ".canary-log.jsonl"
    if not path.exists():
        print("⏳ 無 canary 帳")
        return 0
    per_loop = OrderedDict()   # loop -> OrderedDict(auditor -> {"caught":n,"missed":n,"streak":n})
    none_per_loop = {}         # loop -> n(kind=none 輪;停用制計數,不入 caught/missed 統計)
    overlap = {}               # loop -> {"counts":[int...合併], "badtype":n}(S3 重疊分布;讀全部 kind 含 none)
    n_bad = 0

    def _harvest_overlap(lp, d):
        # S3(2026-08-14,收斂閘殘餘估計降級 S3):跨輪分布合併(各輪母體獨立,彙總為分布統計非去重)。
        # 型別防禦(r1 邊界席 P7 實跑實證):非 list(如字串 "3,2,1")靜默進 _estimate 會算出假 0.0,
        # 必須計壞型明示跳過,不得靜默算。
        cc = d.get("capture_counts")
        if cc is None or not lp:
            return
        o = overlap.setdefault(lp, {"counts": [], "badtype": 0})
        ccl = _cc_ints(cc)   # r1 s2 F1:bool 是 int 子類,守衛統一在 _cc_ints 排除
        if ccl is not None:
            o["counts"].extend(ccl)
        else:
            o["badtype"] += 1
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                n_bad += 1
                continue
            lp = d.get("loop")
            kind = d.get("kind")
            _harvest_overlap(lp, d)
            # 協議停用(2026-08-14 d5):kind=none 不入 caught/missed 統計(無植入無此語意),
            # 但要計數——否則停用制 loop 在這裡回報「無記錄」,誤讀成什麼都沒發生
            # (2026-08-14 終審 F1:本報表是文檔點名的「升級提示機械眼」,不可靜默瞎掉)。
            if kind == "none" and lp:
                none_per_loop[lp] = none_per_loop.get(lp, 0) + 1
                continue
            if not lp or kind not in ("caught", "missed"):
                continue
            aud = d.get("auditor") or "(無席名)"
            seats = per_loop.setdefault(lp, OrderedDict())
            st = seats.setdefault(aud, {"caught": 0, "missed": 0, "streak": 0})
            st[kind] += 1
            st["streak"] = st["streak"] + 1 if kind == "missed" else 0   # 尾端連續 missed(append 序)
    except OSError as e:
        print(f"擋下:審查記錄檔讀不到({e}),沒有它算不出下一步。先確認檔案在不在、有沒有讀取權限:\n    {path}", file=sys.stderr)
        return 2
    def _print_overlap(lp):
        # S3 席位重疊分布(跨輪分布合併;席名=auditor 欄原文、鏡頭層不在帳內——誠實界線)
        o = overlap.get(lp)
        bad = f";另有 {o['badtype']} 筆重疊數據格式不對(壞型,不是整數清單),已跳過不計" if o and o["badtype"] else ""
        if not o or not o["counts"]:
            reason = "數據全部格式不對(壞型),沒得算" if (o and o["badtype"]) else "這個審查編號的記錄沒帶重疊數據 capture_counts"
            print(f"  重疊分布: 無重疊數據({reason}){bad}")
            return
        cs = o["counts"]
        f1 = sum(1 for c in cs if c == 1)
        print(f"  重疊分布(跨輪分布合併,非同一母體去重): 相異缺陷 {len(cs)} | 僅單席抓到 "
              f"{f1}/{len(cs)}({round(100 * f1 / len(cs))}%){bad}")

    targets = [loop_id] if loop_id else list(per_loop)
    if loop_id and loop_id not in per_loop:
        if none_per_loop.get(loop_id):
            print(f"ℹ [{loop_id}] 停用制 loop:{none_per_loop[loop_id]} 輪 kind=none(無植入;"
                  "canary-stats 僅回放歷史 caught/missed 帳,升級訊號改看 quote-check——d5)")
            _print_overlap(loop_id)   # r1 整合席 P5:重疊段不得被 none-only 提前返回吃掉
        else:
            print(f"⏳ 無記錄({loop_id} 目前一筆記錄都還沒有)")
        return 0
    for lp in targets:
        seats = per_loop[lp]
        tc = sum(v["caught"] for v in seats.values())
        tm = sum(v["missed"] for v in seats.values())
        rate = f"{tc}/{tc+tm}" if (tc + tm) else "0/0"
        nn = none_per_loop.get(lp, 0)
        print(f"[{lp}] caught {rate}(missed {tm})"
              + (f"  +{nn} 輪 none(停用制,不入統計)" if nn else ""))
        if loop_id:
            for aud, v in seats.items():
                tail = f"  尾端連續missed={v['streak']}" if v["streak"] else ""
                esc = "  ⚠ 連 2 missed → 升級模型(升 opus)" if v["streak"] >= 2 else ""
                print(f"  {aud}\tcaught {v['caught']}\tmissed {v['missed']}{tail}{esc}")
            _print_overlap(lp)   # S3:指定 loop 查詢時附重疊分布
    # D 前置:型別×探針×caught 表(帶 canary_type 的記錄才入列;attr 攢滿 15 筆=D 本體開工條件)
    # S2 回溯層(2026-08-06,plan:驗證層自證三件):型別來源如實分層——attr(結構化欄位)/
    # note(散文 type=X regex fallback,慣例寫法覆蓋率有限)/unknown(無任何線索,不硬猜)。
    # 覆蓋率即時計算(該 plan r2 折入:寫死數字會被自己的新記錄打臉);D 案 15 筆條件只認 attr。
    import re as _re
    typed = {}
    n_attr = n_note = n_unknown = 0
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("kind") not in ("caught", "missed"):
                continue
            if loop_id and d.get("loop") != loop_id:
                continue
            ct = d.get("canary_type")
            if ct:
                n_attr += 1
                key = (ct, d.get("probe") or "-", "attr")
            else:
                m = _re.search(r"type=([a-d])\b", d.get("note") or "")
                if m:
                    n_note += 1
                    key = (m.group(1), "-", "note")
                else:
                    n_unknown += 1
                    continue
            t = typed.setdefault(key, {"caught": 0, "missed": 0})
            t[d["kind"]] += 1
    except OSError:
        pass
    if typed or n_unknown:
        total = n_attr + n_note + n_unknown
        print(f"  ── 型別×探針×caught(attr {n_attr} / note {n_note} / unknown {n_unknown} / 總 {total};"
              f"attr 攢滿 15 筆=D 案開工條件)──")
        for (ct, pb, src), v in sorted(typed.items()):
            print(f"  {ct}\tprobe={pb}\tsrc={src}\tcaught {v['caught']}\tmissed {v['missed']}")
        if n_unknown:
            print(f"  (unknown {n_unknown} 筆無型別線索,不併入任何型別——如實分層,不硬猜)")
    if n_bad:
        print(f"  (帳面 {n_bad} 行不可解析,已跳過——壞行只影響觀測完整性,不進 gate)")
    print("  ★觀測非閘:caught 只證席位醒著,不證審得夠廣(caught≠覆蓋);missed 席 findings 不作廢(d4)★")
    return 0


def cmd_loop_verify_progress(env, loop_id, settle=None, as_json=False):
    """[S3] 獨立進度驗證器(結清式收斂_計劃,2026-07-28):看不到被審材料的覆核原語——
    直讀 .canary-log.jsonl(+選配 settle 清單檔),**只吃結構欄位**(kind/severity/findings/
    auditor 存在性/hash 存在性),note/--clusters 理由字串一律丟棄(LoopTrap 散文注入面隔離)。
    fail-closed:壞行/kind 缺失=rc2。誠實天花板:結構欄位≠客觀真值(findings/severity 源頭仍是
    LLM 裁決、帳由被驗方寫)——隔離的是散文注入,不是帳本自報。輸出=結構 JSON/純事實行,
    供編排者對照自己的收斂認知,非 oracle。"""
    import json
    path = env.vault.parent / ".canary-log.jsonl"
    rounds = []
    try:
        if path.exists():
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    print("擋下:審查記錄檔有讀不懂的行,輪次順序不可信,整個檔先不信"
                          "(修好或搬走壞行再重跑)", file=sys.stderr)
                    return 2
                if d.get("loop") == loop_id and d.get("kind") != "spec-gate":   # 規格閘留痕不是審查輪(雙向門放行_計劃 S16):不計席、不判無效
                    rounds.append(d)
    except OSError as e:
        print(f"擋下:檔案讀不到({e}): {path}", file=sys.stderr)
        return 2
    for i, r in enumerate(rounds, 1):
        if not isinstance(r.get("kind"), str):
            print(f"擋下:審查記錄第 {i} 筆少了 kind 欄位(抓到/漏掉/無植入),缺欄位就不信整份", file=sys.stderr)
            return 2
    def caught_ok(r):
        # none=協議停用制無植入輪(2026-08-14 d5),與 caught 同計合格輪
        return r.get("kind") in ("caught", "none") and bool(r.get("auditor"))
    streak = 0
    for r in reversed(rounds):
        if caught_ok(r) and r.get("severity") in ("clean", "minor"):
            streak += 1
        else:
            break
    out = {
        "loop": loop_id,
        "rounds": len(rounds),
        "kinds": [r.get("kind") for r in rounds],
        "clean_streak": streak,
        "findings_trend": [r.get("findings") for r in rounds],
        "last": ({"kind": rounds[-1].get("kind"), "severity": rounds[-1].get("severity"),
                  "has_result_hash": "result_sha256" in rounds[-1]} if rounds else None),
    }
    if settle is not None:
        try:
            data = json.loads(Path(settle).read_text(encoding="utf-8-sig"))
            entries = data["entries"]
            assert isinstance(entries, list) and entries
        except (OSError, ValueError, KeyError, AssertionError) as e:
            print(f"擋下:結清清單檔讀不到或格式不對: {e}", file=sys.stderr)
            return 2
        def is_caught_round(n):
            return isinstance(n, int) and 1 <= n <= len(rounds) and caught_ok(rounds[n - 1])
        unsettled = 0
        for e in entries:
            status = e.get("status")
            if status == "llm-ok" and not is_caught_round(e.get("verified_in_round")):
                status = "unverified"
            if status == "unverified" or (e.get("kind") == "semantic" and status != "llm-ok"):
                unsettled += 1
        out["settle"] = {"total": len(entries), "unsettled": unsettled,
                         "settled": len(entries) - unsettled}
    if as_json:
        print(json.dumps(out, ensure_ascii=False, indent=1, sort_keys=True))
    else:
        print(f"[verify-progress] loop={loop_id} rounds={out['rounds']} clean_streak={out['clean_streak']}")
        print(f"  kinds={out['kinds']} findings={out['findings_trend']}")
        if out["last"]:
            print(f"  last={out['last']}")
        if "settle" in out:
            print(f"  settle={out['settle']}")
    return 0


def _loop_status_settle(rounds, n_badlines, loop_id, settle_path, spec, repo, env=None):
    """settle 收斂閘([S1] 結清式收斂_計劃,2026-07-28):清單全結清 ∧ G1 refcheck ∧ G3(末筆 result=現檔)。
    K-streak/G2 由「逐條存在證明」取代(G2 印 advisory 不進合取)。
    caught 輪定義收緊:kind=caught ∧ auditor 非空;否則視同 missed(貶值 llm-ok)。
    fail-closed 族:log 壞行=rc2(及於整個共用檔——壞行無法歸屬 loop);清單檔不可讀/格式非法/
    零條目/llm-ok 缺 verified_in_round=rc2;懸空輪/非 caught 輪的 llm-ok=貶值視同未結清。
    清單檔=JSON {"entries":[{id,kind:mech|semantic,claim,status,verified_in_round?,spec_sha}]}
    (零依賴家規:JSON 非 YAML——stdlib 可解)。"""
    import json
    if n_badlines:
        print(f"擋下:審查記錄檔有 {n_badlines} 行讀不懂;輪次是照行序算的,壞行會讓後面全部歪掉,"
              "所以整個檔先不信。修好或搬走壞的那幾行再重跑", file=sys.stderr)
        return 2
    try:
        data = json.loads(Path(settle_path).read_text(encoding="utf-8-sig"))
    except OSError as e:
        print(f"擋下:--settle 指的清單檔讀不到({e}):\n    {settle_path}", file=sys.stderr)
        return 2
    except ValueError as e:
        print(f"擋下:--settle 清單檔不是合法的 JSON: {e}", file=sys.stderr)
        return 2
    entries = data.get("entries") if isinstance(data, dict) else None
    if not isinstance(entries, list) or not entries:
        print("擋下:清單要長成 {\"entries\":[...]} 而且至少一條;零條目的「全部收尾」等於什麼都沒證明,不收",
              file=sys.stderr)
        return 2
    for i, e in enumerate(entries, 1):
        if not isinstance(e, dict) or not all(k in e for k in ("id", "kind", "status", "spec_sha")):
            print(f"擋下:清單第 {i} 條少了必填欄位(id/kind/status/spec_sha 都要有)", file=sys.stderr)
            return 2
        if e["kind"] not in ("mech", "semantic") or e["status"] not in ("unverified", "mech-ok", "llm-ok"):
            print(f"擋下:清單條目 {e.get('id')} 的 kind 或 status 填了不認得的值(kind 只能是 mech 或 semantic,"
                  "status 只能是 unverified / mech-ok / llm-ok)", file=sys.stderr)
            return 2
        if e["status"] == "llm-ok" and not isinstance(e.get("verified_in_round"), int):
            print(f"擋下:清單條目 {e.get('id')} 標了 llm-ok 卻沒寫是第幾輪驗的(verified_in_round),不寫就等於沒人背書",
                  file=sys.stderr)
            return 2
    repo_root = _anchor_repo_root(repo)
    if repo_root is None:
        return 2
    try:
        cur_sha = _sha256_file(spec)
        text = Path(spec).read_text(encoding="utf-8-sig")
    except OSError as e:
        print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
        return 2
    fails = []
    # caught 輪(收緊定義):kind=caught|none ∧ auditor 非空;輪鍵=append 序(1-based)
    # (none=協議停用制無植入輪,2026-08-14 d5)
    def is_caught_round(n):
        if not (1 <= n <= len(rounds)):
            return False   # 懸空輪 fail-closed
        r = rounds[n - 1]
        return r.get("kind") in ("caught", "none") and bool(r.get("auditor"))
    unsettled = []
    for e in entries:
        status = e["status"]
        why = None
        if status == "llm-ok" and not is_caught_round(e["verified_in_round"]):
            status, why = "unverified", f"貶值(第 {e['verified_in_round']} 輪非 caught/懸空/空席)"
        if e["spec_sha"] != cur_sha:
            why = "spec_sha 過期(spec 已改版,重拆或確認重蓋)"
        elif status == "unverified" or (e["kind"] == "semantic" and status != "llm-ok"):
            why = why or ("語意條停 " + status + "(須 llm-ok 才結清)" if status != "unverified" else "未查證")
        if why:
            unsettled.append((e["id"], why))
    if unsettled:
        print(f"[settle] 清單全結清: ✗ — {len(entries)} 條裡還有 {len(unsettled)} 條沒收尾")
        for eid, why in unsettled:
            print(f"    {eid}: {why}")
        fails.append("清單未結清")
    else:
        print(f"[settle] 清單全結清: ✓ — {len(entries)} 條全部收尾了")
    claims, n_missing, n_oor, _n_ok = _refcheck_scan(text, repo_root)
    bad = [c for c in claims if c["status"] in ("missing", "line_out_of_range")]
    if bad:
        print(f"[settle] G1 文件裡的檔案/行號引用對不對: ✗ — 有 {len(bad)} 條對不上真正的程式碼")
        fails.append("G1")
    else:
        print(f"[settle] G1 文件裡的檔案/行號引用對不對: ✓ — {len(claims)} 條全部對得上")
    last = rounds[-1] if rounds else None
    if last is None:
        print("[settle] G3 最後一筆記錄的文件指紋對不對得上現在的文件: ✗ — 一筆記錄都沒有")
        fails.append("G3")
    elif last.get("result_sha256") != cur_sha:
        print("[settle] G3 最後一筆記錄的文件指紋對不對得上現在的文件: ✗ — 對不上(文件在最後一輪審完之後又改過了,請重審一輪)")
        fails.append("G3")
    else:
        print("[settle] G3 最後一筆記錄的文件指紋對不對得上現在的文件: ✓")
    fs = [r.get("findings") for r in rounds[-3:]]
    print(f"[settle] G2(僅供參考,不影響過不過)各輪問題數: {fs}")
    for i, r in enumerate(rounds, 1):
        print(f"{i}\t{r.get('kind', '?')}\t{r.get('severity', '-')}\t{r.get('ts', '')}\t{r.get('note', '')}")
    if fails:
        print(f"⛔ SETTLE GATE FAIL({loop_id} 沒通過,卡在:{'/'.join(fails)})")
        return 1
    print(f"✅ SETTLE GATE PASS({loop_id} 通過:清單全收尾、引用對得上、文件沒被事後改過)")
    _loop_gov_mark(env, loop_id, "converged", "gate PASS")
    return 0


def _esc_clean(v, limit=200):
    """逃逸帳顯示消毒(code-escape r1 B-1/B-2):控制字元(含換行/ESC)換空格——
    --list 的「一行一筆」是攔截/逃逸週報 grep 的載重合約,使用者可控的 desc 不得打穿;
    ANSI 逃逸碼進終端=帳本可信度風險。截斷防超長刷版。"""
    out = "".join(ch if ch >= " " and ch != "\x7f" else " " for ch in str(v))
    return out if len(out) <= limit else out[:limit] + "…"



def _git_head(repo_root):
    try:
        r = subprocess.run(["git", "-C", str(repo_root), "rev-parse", "HEAD"], capture_output=True, text=True, errors="replace")
        return r.stdout.strip() if r.returncode == 0 else ""
    except OSError:
        return ""


def _plans_in_range(repo_root, git_range, vault):
    """提交範圍碰到的計劃筆記(repo 相對路徑)。對回啟發式:碰到 Projects/*.md 就算。"""
    try:
        # ★中文檔名:git 預設把非 ASCII 路徑加引號並轉義,不關掉會一個計劃都對不上(taskbank 同型坑 2026-09-15)★
        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", git_range, "--"],
                           capture_output=True, text=True, errors="replace")
    except OSError:
        return []
    if r.returncode != 0:
        return []
    try:
        vrel = str(Path(vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
    except ValueError:
        return []
    out = []
    for line in r.stdout.splitlines():
        line = line.strip()
        if line.startswith(vrel + "/Projects/") and line.endswith(".md"):
            out.append(line)
    return out


def _loop_id_for_plan(plan_rel):
    """計劃檔名 → 迴圈編號:去 _計劃(design-loop skill 的慣例)。"""
    stem = Path(plan_rel).stem
    return stem[:-len("_計劃")] if stem.endswith("_計劃") else stem


def _plan_for_loop(env, loop_id):
    """迴圈編號 → 計劃筆記(vault 相對);找不到回 None。"""
    for cand in (f"{loop_id}_計劃.md", f"{loop_id}.md"):
        if (env.vault / "Projects" / cand).is_file():
            return f"Projects/{cand}"
    return None


def _door_for_loop(env, loop_id):
    """規格閘留痕裡這條迴圈最後一次判的門;沒有就 unknown(規格閘上線前一律 unknown)。"""
    path = env.vault.parent / ".canary-log.jsonl"
    door = "unknown"
    if not path.exists():
        return door
    for ln in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if not ln.strip():
            continue
        try:
            d = json.loads(ln)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("kind") == "spec-gate" and nfc(str(d.get("loop", ""))) == nfc(loop_id):
            door = _rec_plan_risk(d) if (d.get("plan_risk") or d.get("door")) else door
    return door


def _auto_escape(env, stage, severity, desc, loops, sha, source, extra=None):
    """逃逸自動記(規格落成可驗收條件_計劃 第五節):
    loops=[(迴圈編號, 計劃相對路徑或 None)]。歸因守衛放寬成「迴圈在審查帳 OR 計劃檔存在」——
    風險低不派審的計劃本來就不會出現在審查帳,只認審查帳會讓它們永遠記不到。
    去重鍵 (迴圈, 階段, sha)。回寫入筆數。不擋、不炸:任何一步失敗只印一行。"""
    log = env.vault.parent / ".escape-log.jsonl"
    ledger = env.vault.parent / ".canary-log.jsonl"
    known = set()
    if ledger.exists():
        for ln in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                v = json.loads(ln).get("loop")
            except ValueError:
                continue
            if isinstance(v, str):
                known.add(nfc(v))
    import datetime as _dt
    import secrets as _sec
    written = 0
    # ★寫側上鎖(r1 回滾席):兩個 hook 同時寫,各自讀到「還沒包含對方那筆」的 existing,去重會被繞過;
    # 讀 existing→判→append 整段都要在同一把 vault 寫入鎖裡(跟 set/append 共用)。
    with _vault_write_lock(env.vault):
        existing = set()
        for r in _escape_rows_for(env):
            existing.add((nfc(str(r.get("loop", ""))), r.get("stage"), r.get("sha")))
        for loop_id, plan_rel in loops:
            plan_ok = bool(plan_rel) and _plan_file_exists(env, plan_rel)
            if nfc(loop_id) in known:
                attribution = "ledger"
            elif plan_ok:
                attribution = "plan-file"
            else:
                print(f"逃逸自動記:「{loop_id}」既不在審查帳、也沒有計劃檔,對不回,不記")
                continue
            door = _door_for_loop(env, loop_id)
            if stage == "push-gate-unreviewed" and door != "low":
                # 這一型的語意是「被判成風險低、跳過審查,結果推送閘擋下」;風險高計劃缺留痕是流程沒走完,不是逃逸
                print(f"逃逸自動記:「{loop_id}」沒有風險低留痕(計劃風險:{door}),缺審查留痕算流程沒走完,不記")
                continue
            if (nfc(loop_id), stage, sha) in existing:
                print(f"逃逸自動記:「{loop_id}」在 {stage} 同一個 sha 已經記過,不重複")
                continue
            rec = {"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                   "token": "ESC-" + _sec.token_hex(4),
                   "loop": loop_id, "stage": stage, "severity": severity, "desc": " ".join(desc.split()),
                   "auto": True, "source": source, "sha": sha, "attribution": attribution, "plan_risk": door}
            if plan_rel:
                rec["plan"] = plan_rel
            if extra:
                rec.update(extra)
            if _jsonl_append_verified(log, rec, "token", rec["token"]) == 0:
                written += 1
                existing.add((nfc(loop_id), stage, sha))
                print(f"✓ 逃逸自動入帳:「{loop_id}」在 {stage} 記到 {severity}(計劃風險:{rec['plan_risk']},歸因:{attribution})")
            else:
                _escape_auto_failed(env, loop_id, stage, "append 自驗失敗")
    return written


def _plan_file_exists(env, plan_rel):
    """計劃檔存在性,兩邊都做 NFC 再比(r1 邊界席:git 回的路徑與磁碟檔名的正規化形式可能不同)。"""
    if (env.vault / plan_rel).is_file():
        return True
    parent = (env.vault / plan_rel).parent
    if not parent.is_dir():
        return False
    want = nfc(Path(plan_rel).name)
    try:
        return any(nfc(q.name) == want for q in parent.iterdir())
    except OSError:
        return False


def _escape_auto_failed(env, loop_id, stage, why):
    """fail-open 的失敗要看得見(r1 回滾席):無人看顧時 stderr 等於消失,寫一筆進治理帳。"""
    try:
        _append_governance_log(env.vault, [{"gate": "escape-auto", "kind": "escape-auto-failed", "hard": False,
                                            "nodes": [str(loop_id)], "note": f"{stage}: {why}"}])
    except Exception:
        pass
    print(f"逃逸自動記失敗({stage}/{loop_id}): {why}", file=sys.stderr)


def cmd_loop_escape(env, loop_id=None, stage=None, severity=None, desc=None,
                    defect_ref=None, list_mode=False, rule=None, auto=False, git_range=None, sha=None, repo=None):
    """逃逸帳原語(Projects/loop數據收集_計劃 M1②,2026-07-16 設計、2026-08-31 落地)。
    語意:某個審查迴圈收斂放行了,下游(實作/CI/prod/人)發現可歸因的缺陷→記一筆。
    整套審查系統的 ground truth 側;與攔截帳(★圖譜攔截★記號)互為兩面。
    append-only、不進任何閘;歸因是人工判斷(GIGO 同 cluster 歸併,計劃天花板明載)。
    ★歸因守衛的職責範圍(r1 外家 ESC-01 裁明)★:只防「編號打錯」(實存性),不驗迴圈
    收斂/放行狀態——那是語意判斷,歸人;守衛驗語意=偷渡閘,計劃明文不做。"""
    log = env.vault.parent / ".escape-log.jsonl"
    _SEV_W = {"minor": 0, "major": 1, "blocker": 2}
    if auto:
        # 自動模式(規格落成可驗收條件_計劃 第五節):給提交範圍,碰到的計劃筆記各記一筆;對不回就不記。
        if loop_id or list_mode:
            print("擋下:--auto 不吃迴圈編號也不能跟 --list 混用;編號由提交範圍碰到的計劃筆記推出來", file=sys.stderr)
            return 2
        if severity not in _SEV_W or not (stage or "").strip() or not (desc or "").strip():
            print("擋下:--auto 一樣要帶 --stage、--severity(minor|major|blocker)、--desc", file=sys.stderr)
            return 2
        if not git_range:
            print("擋下:--auto 要帶 --range <a..b>(推送/CI 的提交範圍),沒有範圍就對不回計劃", file=sys.stderr)
            return 2
        repo_root = Path(repo) if repo else env.vault.parent.parent
        plans = _plans_in_range(repo_root, git_range, env.vault)
        if not plans:
            print(f"逃逸自動記:範圍 {git_range} 對不回任何計劃筆記,不記(這不是錯,只是這次推送沒碰到計劃)")
            return 0
        vrel = str(Path(env.vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
        loops = [(_loop_id_for_plan(p), p[len(vrel) + 1:]) for p in plans]
        _auto_escape(env, stage.strip(), severity, desc, loops, sha or _git_head(repo_root), source=stage.strip())
        return 0
    if list_mode:
        if loop_id or stage or severity or desc or defect_ref:
            print("擋下:--list 是唯讀,不能跟記帳參數混用——照原樣執行你會以為記了、其實一筆都沒寫。要記帳就拿掉 --list 重跑", file=sys.stderr)
            return 2
        if not log.exists():
            print("逃逸帳是空的:還沒有任何一筆「迴圈放行後下游抓到可歸因缺陷」的紀錄。空≠零逃逸——也可能是沒人記;要記:")
            print("    lumos loop escape <迴圈編號> --stage <發現階段> --severity <minor|major|blocker> --desc <一句描述>")
            return 0
        import json as _je
        rows, bad = [], []
        for no, ln in enumerate(log.read_text(encoding="utf-8").splitlines(), 1):
            if not ln.strip():
                continue
            try:
                d = _je.loads(ln)
            except ValueError:
                bad.append(no)
                continue
            if not isinstance(d, dict):
                bad.append(no)      # 合法 JSON 但非物件(null/陣列)——r1 外家 ESC-03:一筆就能弄壞整個 --list
                continue
            rows.append(d)
        if bad:
            print(f"提醒:逃逸帳有 {len(bad)} 行壞損被跳過(行 {', '.join(map(str, bad[:5]))}"
                  + ("…" if len(bad) > 5 else "") + f");帳檔:{log}", file=sys.stderr)
        by_loop = {}
        for r in rows:
            by_loop.setdefault(str(r.get("loop", "?")), []).append(r)
        print(f"逃逸帳:{len(rows)} 筆(迴圈收斂放行後、下游抓到的可歸因缺陷;歸因為人工判斷)")
        for lp, rs in sorted(by_loop.items()):
            worst_row = max(rs, key=lambda r: _SEV_W.get(r.get("severity"), -1))
            wsev = worst_row.get("severity")
            wlabel = wsev if wsev in _SEV_W else f"非標準值 {_esc_clean(wsev, 20)}(手改帳?)"
            print(f"  {_esc_clean(lp, 60)}:{len(rs)} 筆(最重 {wlabel})")
            for r in rs:
                sev = r.get("severity")
                sev_disp = sev if sev in _SEV_W else f"?{_esc_clean(sev, 12)}"
                print(f"    {str(r.get('ts') or '?')[:10]} [{sev_disp}@{_esc_clean(r.get('stage', '?'), 30)}] {_esc_clean(r.get('desc', ''))}"
                      + (f"(佐證:{_esc_clean(r['defect_ref'], 80)})" if r.get("defect_ref") else "")
                      # ★逐筆看得到有沒有標規則★(r1 通才席):只有彙總看得到的話,巡帳的人不知道哪一筆漏標
                      + (f"[本來該抓的規則:{_esc_clean(str(r['rule']), 40)}]" if r.get("rule") else "[沒標該抓的規則]"))
        return 0
    # ── 記帳模式:全部驗證在此(r1 架構席 R-2:dispatch 只路由,驗證不拆層) ──
    if not loop_id:
        print("擋下:要記逃逸就得說是哪個迴圈編號放行的。看帳:\n    lumos loop escape --list", file=sys.stderr)
        return 2
    if severity not in _SEV_W:
        print("擋下:--severity 必填且只能是 minor|major|blocker(同審查帳值域)", file=sys.stderr)
        return 2
    if not (stage or "").strip():
        print("擋下:--stage 必填(在哪一站發現:實作/code-loop/CI/prod/使用者回報…)——缺階段的逃逸帳之後做不了「在哪一站漏的」分層統計", file=sys.stderr)
        return 2
    if not (desc or "").strip():
        print("擋下:--desc 不能空——沒有描述的逃逸帳讀側無從歸因,等於沒記", file=sys.stderr)
        return 2
    ledger = env.vault.parent / ".canary-log.jsonl"
    known, led_bad = set(), 0
    if ledger.exists():
        import json as _je2
        for ln in ledger.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                v = _je2.loads(ln).get("loop")
            except ValueError:
                led_bad += 1
                continue
            if isinstance(v, str):
                known.add(nfc(v))     # r1 邊界席 B-3:NFC 正規化,NFD 貼上形不再肉眼無解
    if nfc(loop_id) not in known:
        msg = f"擋下:審查帳裡沒有叫「{loop_id}」的迴圈——逃逸要歸因到真實存在的迴圈,先確認編號:\n    lumos gov --stats"
        if led_bad:
            msg += f"\n  (審查帳另有 {led_bad} 行壞損被跳過——查不到也可能是編號在那幾行裡)"
        print(msg, file=sys.stderr)
        return 2
    import datetime as _dt_esc
    import secrets as _sec_esc
    rec = {"ts": _dt_esc.datetime.now().astimezone().isoformat(timespec="seconds"),
           "token": "ESC-" + _sec_esc.token_hex(4),       # 落盤自驗唯一鍵(canary auto-mint 慣例)
           "loop": loop_id, "stage": stage.strip(), "severity": severity, "desc": desc.strip()}
    if defect_ref:
        rec["defect_ref"] = defect_ref
    if rule:
        # ★閉環的那一格★:標「本來哪條規則該抓」,漏網才長得出新的守衛;
        # 不標的話這本帳只記得「漏掉了」,永遠不會變成下次擋得住的東西(看待辦:lumos rule-gap)
        rec["rule"] = rule.strip()
    if log.is_symlink():
        # r2 終態席實測:既存 symlink 會繞過建檔保護、共用寫入原語 open('a') 跟隨連結寫進外部檔——
        # 每次寫前先擋本體(殘餘=判斷與開檔間競態,best-effort 同 _ledger_append 家族誠實降級)
        print(f"擋下:逃逸帳檔是一個符號連結,不往裡寫(帳本必須是普通檔案):\n    {log}", file=sys.stderr)
        return 2
    if not log.exists():
        try:
            os.close(os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644))
        except FileExistsError:
            pass
        except OSError as e:
            print(f"擋下:建不了逃逸帳檔({e}):\n    {log}", file=sys.stderr)
            return 2
    rc_w = _jsonl_append_verified(log, rec, "token", rec["token"])   # 共用硬化原語(OSError 擋下+讀回自驗);已知天花板=撞鍵時讀回比對可能對到舊筆(canary 全家族同款,hex4 空間機率極低)
    if rc_w:
        return rc_w
    print(f"✓ 逃逸入帳:迴圈 {loop_id} 放行的東西在「{rec['stage']}」被抓到 {severity} 級缺陷。")
    print("  這筆是審查系統的漏網紀錄——量的是「閘沒接住的」,與攔截帳(★圖譜攔截★)互為兩面;看全帳:")
    print("    lumos loop escape --list")
    return 0


def cmd_loop_status(env, loop_id, need=None, gate=False, spec=None, repo=None, panel=False, light=False, min_seats=None, settle=None, disposal=False, roster=False):
    """算某設計 loop 的收斂(收斂留痕):連 K 輪『canary caught 且 severity∈{clean,minor}』。
    --gate:升級為證據閘(K-streak 為必要條件,合取 G1 refcheck 引用座標 + G2 發現枯竭);
    findings 數的源頭仍是 LLM 裁決——gate 機械化的是算術,不是數字的正確性(見設計 doc)。
    讀 .canary-log.jsonl 的 **append 序**(不 ts-sort:ts 只到秒、同秒會並列),篩 loop==id。
    tail-K 滑動窗:前面髒輪不影響、只看最後 K 筆;missed/缺 severity 視同未收斂。
    exit 0=CONVERGED / 1=未收斂(含無記錄=還沒開始)/ 2=真錯誤。
    天花板:收斂=連 K 輪醒著的審計員沒找到 blocker/major,非完整正確;severity 自報(見設計 doc)。"""
    import json
    if light and panel:
        print("擋下:--light 和 --panel 不能一起用(light 是單人審、panel 是多人審,兩條不同的路),擇一", file=sys.stderr)
        return 2
    explicit_need = need is not None
    if need is None:
        need = 2
    if disposal:
        # [T4 處置閘] 獨立路徑(design-loop重設計 d2/B5):與所有既有模式互斥,舊閘一行不動
        if panel or light or settle is not None or explicit_need or min_seats is not None:
            print("擋下:--disposal 是獨立的一套閘,不能跟 --panel/--light/--settle/--need/--min-seats 一起用",
                  file=sys.stderr)
            return 2
        if spec is None:
            print("擋下:--disposal 一定要帶 --spec 指定被審的文件,不然沒辦法比對文件有沒有被改、留痕對不對(寧可擋也不猜)", file=sys.stderr)
            return 2
    if settle is not None:
        # [S1] rc2 互斥/前置群(fail-closed;結清式收斂_計劃 2026-07-28)
        if panel or light:
            print("擋下:--settle 不能跟 --panel 或 --light 一起用(目前只接單人審的記錄格式)", file=sys.stderr)
            return 2
        if explicit_need:
            print("擋下:--settle 模式不數輪數,--need 在這裡沒意義;與其默默忽略誤導你,不如請你拿掉 --need", file=sys.stderr)
            return 2
        if min_seats is not None:
            print("擋下:--settle 不能跟 --min-seats 一起用(人數檢查是算在最近幾輪上的,settle 模式沒有「最近幾輪」這個概念;"
                  "auditor 非空職能由 caught 定義收緊承接)", file=sys.stderr)
            return 2
        if not gate:
            print("擋下:--settle 要搭 --gate 一起用,不然沒有東西可判", file=sys.stderr)
            return 2
        if spec is None:
            print("擋下:--settle 一定要帶 --spec 指定被審的文件,每條收尾記錄和文件指紋都要跟現在的檔比對", file=sys.stderr)
            return 2
    if min_seats is not None and min_seats < 1:
        print(f"擋下:--min-seats 要填正整數(至少幾個人審),你給的是 {min_seats}", file=sys.stderr)
        return 2
    need = max(1, need)
    path = env.vault.parent / ".canary-log.jsonl"
    rounds = []
    n_badlines = 0
    bad_linenos = []   # disposal rc2 訊息用:壞行可一分鐘定位修復(r2 三席異議的降噪配套)
    try:
        if path.exists():
            for _ln, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    n_badlines += 1   # settle fail-closed 用;legacy/panel 維持容忍(行為不變)
                    bad_linenos.append(_ln)
                    continue
                if d.get("loop") == loop_id and d.get("kind") != "spec-gate":   # 規格閘留痕不是審查輪(雙向門放行_計劃 S16):不計席、不判無效
                    rounds.append(d)
    except OSError as e:
        print(f"擋下:檔案讀不到({e}): {path}", file=sys.stderr)
        return 2

    if roster:
        # [派工編制資料化] advisory 觀測——恆在各模式分支 early-return 之前印,rc 完全不動
        try:
            _roster_observe(env, loop_id, rounds, repo)
        except Exception as e:   # 觀測絕不擋閘:任何意外只降級為警告
            print(f"[roster] 提醒:派工名單對帳失敗,不影響過不過關: {e}")

    # 混用守衛(R2-F1 footgun):panel 記錄(有 round 欄)與 legacy 模式不可混用。
    # 用 all/any 而非單向 any:partial-mix(部分有 round、部分沒)也擋——否則 round-less
    # 記錄在 panel 模式會形成 None phantom 組、可能成「最新輪」偽過(review I1)。
    n_round = sum(1 for r in rounds if "round" in r)
    if panel and rounds and n_round != len(rounds):
        print("擋下:--panel 模式要求這個編號的每筆記錄都帶輪次,現在有記錄沒帶(混用或舊格式),不讀——不然會多算出一個不存在的 phantom 輪",
              file=sys.stderr)
        return 2
    if disposal:
        # 留痕解析根:預設=寫側同源的 _vault_repo_root(對稱);顯式 --repo 覆蓋
        # (r3 s2 席:git-less 部署副本裡 .git 不在,向上找會落錯根——給使用者一條明路)
        _dsp_root = Path(repo).resolve() if repo else _vault_repo_root(env)
        return _loop_status_disposal(rounds, loop_id, spec, n_badlines, _dsp_root,
                                     bad_linenos=bad_linenos, env=env, roster=roster, repo=repo)
    if not panel and n_round > 0:
        print("擋下:這個編號的記錄帶了輪次(多人審格式),但你沒加 --panel;不加的話一輪裡 W 個人的記錄會被當成 W 輪,所以不算",
              file=sys.stderr)
        return 2
    if settle is not None:
        return _loop_status_settle(rounds, n_badlines, loop_id, settle, spec, repo, env=env)
    if panel:
        try:
            return _loop_status_panel(rounds, loop_id, min_seats=min_seats, spec=spec, env=env)
        except OSError as e:   # G3 --spec 不可讀:與 legacy G1 對稱 rc2(code-loop r2 折入)
            print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
            return 2

    # ── M1包 #2:light K=1 謂詞(loop機械脊椎M1包_計劃;hash 強制 fail-closed) ──
    if light:
        if spec is None:
            print("擋下:--light 一定要帶 --spec 指定被審的文件,沒有對象就沒辦法驗文件有沒有被改", file=sys.stderr)
            return 2
        # ratchet 最先:任一 caught/none 筆 severity≥major → 永久 FAIL(missed 筆不觸發;
        # none=協議停用制的無植入輪——不納會使停用後 major 輪失去永久升級,閘變寬鬆)
        if any(r.get("kind") in ("caught", "none") and r.get("severity") in ("major", "blocker") for r in rounds):
            print(f"⛔ LIGHT GATE FAIL({loop_id}):曾經有一輪抓到 major 以上的問題,light 這個最寬鬆的規則從此永久失效(ratchet),"
                  "之後再乾淨的輪也洗不回來。開新的審查編號(原編號加 -std)換嚴格規則接著審")
            return 1
        if not rounds:
            print(f"⏳ 無記錄({loop_id} 目前一筆記錄都還沒有)")
            return 1
        last = rounds[-1]
        fails = []
        if last.get("kind") not in ("caught", "none"):
            fails.append("retryable——末輪 missed(判決不採信;light cap=2 內可重試)")
        if last.get("severity") not in ("clean", "minor"):
            fails.append(f"severity={last.get('severity')} 不在 {{clean,minor}}")
        sev, f = last.get("severity"), last.get("findings")
        if f is None or (sev == "clean" and f != 0) or (sev == "minor" and f < 1):
            fails.append(f"欄位互證矛盾:severity={sev} 與 findings={f} 不相容")
        try:
            err, info = _hash_chain_check([[last]], spec)
        except OSError as e:   # 與 legacy G1 對稱 rc2(code-loop r2 折入)
            print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
            return 2
        if err:
            fails.append(err)
        elif info == "unbound":
            fails.append("hash 未綁(light 強制 fail-closed:record 須帶 --spec/--reviewed)")
        if min_seats and len({a for r in [last] if (a := r.get("auditor"))}) < min_seats:
            fails.append(f"席數不足(min-seats={min_seats};空 auditor 不計席——code-loop r1 折入)")
        for line in _cost_summary(rounds):
            print(line)
        if fails:
            print(f"⛔ LIGHT GATE FAIL({loop_id} 沒通過,卡在):" + "；".join(fails))
            return 1
        print(f"✅ LIGHT GATE PASS({loop_id} 通過:單人審完、沒有中等以上問題、記錄互相對得上、文件沒被事後改過)")
        _loop_gov_mark(env, loop_id, "converged", "gate PASS")
        return 0

    def good(r):
        return r.get("kind") in ("caught", "none") and r.get("severity") in ("clean", "minor")

    converged = len(rounds) >= need and all(good(r) for r in rounds[-need:])
    streak = 0                                  # 從尾往回的連續合格數(算「還需 N」)
    for r in reversed(rounds):
        if good(r):
            streak += 1
        else:
            break
    if not gate:
        if converged:
            print(f"✅ CONVERGED({loop_id} 連續 {need} 輪審完且乾淨,判定收斂;總共跑了 {len(rounds)} 輪)")
            rc = 0
        else:
            print(f"⏳ 還需連續 {need - streak} 輪乾淨才算收斂({loop_id} 目前跑了 {len(rounds)} 輪)")
            rc = 1
        for i, r in enumerate(rounds, 1):       # 留痕:每輪一行 tab 分隔
            print(f"{i}\t{r.get('kind', '?')}\t{r.get('severity', '-')}\t{r.get('ts', '')}\t{r.get('note', '')}")
        for line in _cost_summary(rounds):
            print(line)
        return rc

    # ── 證據閘(--gate):K-streak(必要)∧ G1 refcheck(--spec 可選)∧ G2 發現枯竭 ──
    repo_root = _anchor_repo_root(repo)
    if repo_root is None:
        return 2
    fails = []
    if converged:
        print(f"[gate] K-streak 連續乾淨輪數(要 {need} 輪): ✓")
    else:
        print(f"[gate] K-streak 連續乾淨輪數(要 {need} 輪): ✗ — 還差 {need - streak} 輪審完且乾淨(目前 {len(rounds)} 輪)")
        fails.append("K-streak")
    if spec is None:
        print("[gate] G1 文件裡的檔案/行號引用對不對: 跳過(沒帶 --spec,沒有比對對象)")
    else:
        try:
            text = Path(spec).read_text(encoding="utf-8-sig")
        except OSError as e:
            print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
            return 2
        claims, n_missing, n_oor, _n_ok = _refcheck_scan(text, repo_root)
        bad = [c for c in claims if c["status"] in ("missing", "line_out_of_range")]
        if bad:
            print(f"[gate] G1 文件裡的檔案/行號引用對不對: ✗ — 有 {len(bad)} 條引用對不上真正的程式碼")
            for c in bad:
                loc = f"{c['token']}:{c['line']}" if c["line"] else c["token"]
                print(f"    {loc}({c['status']})")
            fails.append("G1")
        else:
            print(f"[gate] G1 文件裡的檔案/行號引用對不對: ✓ — {len(claims)} 條全部對得上")
    tail = rounds[-need:]
    fs = [r.get("findings") for r in tail]
    g2_fail = ""
    if len(tail) < need:
        g2_fail = f"紀錄不足 {need} 輪"
    elif any(f is None for f in fs):
        g2_fail = "tail-K 有輪缺 findings 欄位(fail-closed:用 canary record --findings N 記錄)"
    else:
        for r in tail:
            sev, f = r.get("severity"), r.get("findings")
            if (sev == "clean" and f != 0) or (sev == "minor" and f < 1):
                g2_fail = f"欄位互證矛盾:severity={sev} 與 findings={f} 不相容"
                break
        if not g2_fail:
            if need == 1:
                drained = fs[-1] == 0
            else:
                mono = all(fs[i] >= fs[i + 1] for i in range(len(fs) - 1))
                drained = mono and fs[-1] <= 1 and (fs[-1] == 0 or fs[-1] < fs[-2])
            if not drained:
                g2_fail = f"findings={fs} 未枯竭(需單調不增、末輪 ≤1 且末輪=0 或末步嚴格下降)"
    if g2_fail:
        print(f"[gate] G2 每輪找到的問題數有沒有遞減到零: ✗ — {g2_fail}")
        fails.append("G2")
    else:
        print(f"[gate] G2 每輪找到的問題數有沒有遞減到零: ✓ — 各輪問題數 {fs}")
    if min_seats:   # legacy gate 消費;**逐輪**驗非空(code-loop r2 Codex:整窗聯集會讓「一有一空」過關)
        bad = [i for i, r in enumerate(tail, 1)
               if len({a for a in [r.get("auditor")] if a}) < min_seats]
        if bad:
            print(f"[gate] min-seats 審查人數: ✗ — 第 {','.join(map(str, bad))} 輪席數不足"
                  f"(規定每輪至少 {min_seats} 人;沒填名字的不算)")
            fails.append("席數不足")
        else:
            print(f"[gate] min-seats 審查人數: ✓ — 最近 {len(tail)} 輪每輪都有 {min_seats} 人以上")
    # ── M1包 #3 G3 雙 hash 鏈(帶 --spec=聲明要驗;收斂窗=tail need 筆) ──
    if spec is not None:
        try:
            err, info = _hash_chain_check([[r] for r in tail], spec)
        except OSError as e:   # 對稱 G1 rc2(code-loop r2 折入;G1 讀 text 過≠hash 讀 bytes 必過,race 窗)
            print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
            return 2
        if err:
            print(f"[gate] G3 文件有沒有被事後改過(hash 鏈): ✗ — {err}")
            fails.append("G3")
        elif info == "unbound":
            print("[gate] G3 文件有沒有被事後改過(hash 鏈): ✗ — 這幾輪都沒留下「審的是哪份文件」的指紋;"
                  "請重審一輪,記錄時帶 --spec 和 --reviewed")
            fails.append("G3")
        else:
            print(f"[gate] G3 文件有沒有被事後改過(hash 鏈): ✓ — {info}")
    for i, r in enumerate(rounds, 1):
        print(f"{i}\t{r.get('kind', '?')}\t{r.get('severity', '-')}\t{r.get('findings', '-')}\t{r.get('ts', '')}\t{r.get('note', '')}")
    for line in _cost_summary(rounds):
        print(line)
    if fails:
        print(f"⛔ GATE FAIL({loop_id} 沒通過,卡在:{'/'.join(fails)})")
        return 1
    print(f"✅ GATE PASS({loop_id} 四關全過:連續乾淨輪數、引用對得上、問題數遞減、文件沒被改過)")
    _loop_gov_mark(env, loop_id, "converged", "gate PASS")
    return 0


_TIER_PARAMS = {"light": (1, 2), "standard": (3, 3), "high": (5, 3), "legacy": (1, 6)}  # tier→(width, cap)
# ★一輪能丟多少給審查員的軟上限★(2026-08-02)
# 為什麼有這條:審查員的任務是「在 N 行裡找出那個植入的錯」,而 context rot(脈絡越長、
# 注意力越差)是已發表的實測現象——有效脈絡長度約標稱值的 60-70%,★退化在 32K token 就
# 量得到★(不必塞爆),報告的退化幅度 13.9%-85%。
# ★這條門檻★純粹★借自外部文獻,本專案自己的資料不支持它★(2026-08-02 更正,
# 原註解在此宣稱「本專案資料落在線的兩邊、方向是反的」——★那個宣稱是錯的,已撤★):
#   ① 原始觀察(code-slim-python r1/r2 大 payload 零 findings、r3-r6 小 payload 有 findings)
#      經查證★兩組審的根本不是同一份碼★(前者 bash→Python 移植,後者後來才寫的 manifest 步驟),
#      拿來比就是拿蘋果比橘子,不構成任何證據。
#   ② 之後跑了★兩次刻意設計的對照實驗★(見圖譜 [[Projects/審查規模對照實驗]] 與
#      [[Projects/審查規模對照實驗二_Landmark真缺陷]]),★都不支持「量大→漏看」★:
#      命中率沒掉。實驗二甚至 7/7 全中,撞到天花板。
#   ③ 反而浮出另一個假說:量大影響的可能不是「有沒有看到」而是★判斷的自信度★——
#      大 payload 的席位會★有把握地宣稱有缺陷的地方沒問題★(見 [[Projects/規模影響判斷力假說]],
#      3/3 大 payload 席位講反、1/1 小 payload 席位找到)。★該假說 n=4、觀察性、
#      編碼者=提出者,尚未閉合 maker≠checker,★不得據以動 gate★。
# 門檻取 1800 行 ≈ 30K token,是★借用已發表的 32K 起點取略保守整數★,不是本專案量出來的。
# 這是軟上限:超過不擋(輪已經跑完才記帳,擋也來不及),但★記進帳並要求收斂宣稱講小★。
_CANARY_SCOPE_SOFT_CAP_LINES = 1800

_CANARY_TYPES = ("a", "b", "c", "d")   # 壞交叉引用/未定義旗標/未定義欄位常數/未定義產物裸檔名


# ── 派工編制資料化(Projects/派工編制資料化_計劃):編制宣告表+對帳原語 ──
# 編制數字單源=本表(skill 散文降解說);數值逐條抄自 lumos-design-loop/lumos-code-loop SKILL 現值。
