def _anchor_repo_root(repo):
    """--repo 顯式優先;省略時 cwd 逐層向上找 .git(同 refcheck 慣例)。失敗印錯回 None。"""
    if repo is not None:
        p = Path(repo)
        if not p.is_dir():
            print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
            return None
        return p
    for cand in (Path.cwd(), *Path.cwd().parents):
        if (cand / ".git").exists():
            return cand
    print("擋下:從目前目錄往上找不到 git repo,用 --repo 指定專案根目錄", file=sys.stderr)
    return None


def _quote_norm(s):
    """quote-check 的唯一正規化(T2 design-loop重設計):NFC → 剝 markdown 強調記號(*/`)
    → 空白(含全形\u3000/換行)摺疊單空格。★抽取與比對共用這一份——嚴禁第二份實作★
    (2026-08-02 教訓:預檢與主迴圈兩份實作當場漂移)。不做 lower(保留大小寫語意)。"""
    import re
    import unicodedata
    s = unicodedata.normalize("NFC", s)
    # Landmark 真場實測(2026-08-04):blockquote 折行的續行 > 記號會進 hay,引句永遠比不中
    s = re.sub(r"(?m)^\s*>\s?", "", s)
    s = s.replace("*", "").replace("`", "")
    return " ".join(s.split())


_QUOTE_MIN_NORM_LEN = 10   # 錨定紀律「引句 ≥10 字」轉機械(r1 否決席:一字引句必然錨得到=紀律被架空)


def _quote_rows(rtext, stext):
    """quote-check 核心(T4 抽出供 CLI 與 disposal gate 共用——★單一實作★):
    回 [{'quote','ok'},...];零引句回 None(呼叫端 fail loud)。
    引句止於★同型★閉引號:「…」內容許『』(r1 s1 席:原 [^」』]+ 在巢狀『就截斷,
    「規則『甲」被當前綴錨到,編造的後半永遠沒被驗);norm 後不足下限判 miss。"""
    import re
    # 標籤容錯(Landmark 真場實測 2026-08-04):席位自然寫成 **引句**：/**引句（註記）**：——
    # 只認裸「引句：」會把整份合規報告判成抽零條;容忍可選（…）註記與 * 強調記號
    _Q_LABEL = r"引句(?:（[^）\n]{0,40}）)?\**[：:]\s*"
    quotes = [m.group(1) if m.group(1) is not None else m.group(2)
              for m in re.finditer(_Q_LABEL + r"(?:「([^」]+)」|『([^』]+)』)", rtext)]
    # r3 修(s2 席):引號型態不成對(「…』)抽不出來會整條靜默消失=編造引句的逃逸口——
    # 「引句：」標記數 > 成功抽取數時,差額以格式 miss 入列(fail loud,不採信)
    n_markers = len(re.findall(_Q_LABEL + r"[「『]", rtext))
    if not quotes and not n_markers:
        return None
    hay = _quote_norm(stext)
    hay_ns = hay.replace(" ", "")
    rows = []
    for q in quotes:
        nq = _quote_norm(q)
        too_short = len(nq) < _QUOTE_MIN_NORM_LEN
        # CJK 折行 fallback(Landmark 真場實測):快照句中折行使 norm 後多一個空格,
        # 連續引句子字串必 miss——空白全剝再比一次(存在性檢查,黏合誤中風險可忽略:
        # 引句有 10 字下限,跨句黏合要恰好湊出同字序)
        anchored = nq in hay or nq.replace(" ", "") in hay_ns
        rows.append({"quote": q, "ok": (not too_short) and anchored,
                     **({"too_short": True} if too_short else {})})
    for _ in range(n_markers - len(quotes)):
        rows.append({"quote": "(引號未閉合/開閉型態不符,無法抽取)", "ok": False, "malformed": True})
    return rows


# ═══ 處置閘「資安席」一步(Projects/代碼審資安席_計劃,2026-09-11 Enzo 裁 d6)═══
# 高風險代碼審一律必派一席資安;編制表上 requirement=required-gated 的席,出席與否由這一步硬擋。
_REQUIREMENT_LABEL = {"required-gated": "必派(問閘會擋)"}   # loop next 人讀輸出用;--json 仍給原值
# 席名怎麼認:用連字號切段,任一段完全等於席位名或別名即算(英文不分大小寫)。只有人裁能加一個 required-gated 席。
_GATED_SEAT_ALIASES = {"資安": ("資安", "security")}


def _loop_anchor_tier(rounds):
    """迴圈的定錨分級:帳上第一筆帶 tier 的值。loop next 與處置閘資安席一步呼叫同一支——
    寫帳那側不擋中途改 tier,改用「任一筆 high」會對一個從沒被派過 high 編制的迴圈要求資安席(r1 邊界 B3)。"""
    return next((r["tier"] for r in rounds if r.get("tier")), None)


def _auditor_matches_slot(auditor, slot):
    """這個席名坐的是不是這個席位:連字號切段,任一段(去頭尾空白)完全等於席位名或別名即算,英文不分大小寫。
    ★整段相等,不是子字串★:「資安審-sonnet」「非資安-sonnet」不算;模型名自己帶連字號(資安-gpt-5.6-terra)、
    前面帶席號(s4-資安-sonnet)都算。原本「取最後一個連字號前那段」會把多連字號的真實命名判錯
    (帳上 308 個席名有 109 個帶兩個以上連字號;r1 邊界 B1、整合 C1)。"""
    if not isinstance(auditor, str) or not auditor.strip():
        return False
    names = {a.casefold() for a in _GATED_SEAT_ALIASES.get(slot, (slot,))}
    return any(seg.strip().casefold() in names for seg in auditor.split("-"))


def _git_unquote_path(s):
    """還原 git 在 diff 檔頭替路徑加的 C 式引號。core.quotePath 預設開:中文等非 ASCII 會寫成
    `"a/docs/\\344\\270\\255.md"` 這種八進位跳脫。沒加引號的原樣回。
    ★為什麼 lumos 自己呼叫 git 時用 -c core.quotePath=false、這裡卻要還原★(代碼審 r1 架構對齊 B1):
    專案慣例是從源頭關掉跳脫(本檔各處 git 呼叫都這樣做,代碼審 SKILL 的凍結指令也已補上同一個旗標);
    但凍結 patch 是編排者自己下指令產的輸入檔,舊迴圈、別家編排者、忘了帶旗標的都會帶引號——
    判不準就會把同一支檔當兩支、或把兩支當同一支,所以讀這種輸入時要容錯,不是另一套產生方式。
    ★只去掉行尾換行,不削空白★(r1 外家否決 E1):檔名尾端的空白是檔名的一部分,
    削掉會把「app/login.py」與「app/login.py 」併成一支,資安席只看過前者也能讓後者過關。"""
    s = s.rstrip("\r\n")
    if len(s) >= 2 and s[0] == '"' and s[-1] == '"':
        import codecs
        try:
            return codecs.escape_decode(s[1:-1].encode("latin-1", "backslashreplace"))[0].decode("utf-8", "surrogateescape")
        except Exception:
            return s[1:-1]
    return s


def _patch_files_from_text(text):
    """凍結 patch 改到哪些檔(集合)。檔名判法見 _patch_file_changes。"""
    return set(_patch_file_changes(text))


def _patch_file_changes(text):
    """凍結 patch 裡每支檔的「改動指紋」:{檔名: sha256}。
    檔名:每段 `diff --git` 在第一個 `@@` 之前依序取 `+++ b/…`(不是 /dev/null)→ `rename to …` → `--- a/…`(刪檔)
    → `diff --git` 行本身 b/ 那側;hunk 內容裡剛好長得像檔頭的行不算。既有的 _delguard_parse_diff 只用
    「 b/(.+)$」抓、不處理引號,所以不能直接拿來用。
    ★指紋算 hunk 的內容,不算位置★(代碼審 r1 通才 A1/資安 C1;r3 外家否決改):hunk 裡的增刪行與上下文行、
    `@@` 後面的段落標頭(函式名),加上 mode/新增刪除/改名/二進位這幾種檔頭;不算 `@@` 的行號與 `index` 那行——
    只差行號(rebase 常見)還算同一版。原本只比檔名,同一支檔換成含後門的內容照樣算「資安席看過」;
    r1 改成只算增刪行之後,同一段 `-check(user)/+allow(user)` 從公開端點搬到管理員端點指紋完全相同(r3 外家 Codex 實測),
    所以上下文與段落標頭也要算。代價:rebase 之後這段附近的程式也變了,資安席要對最新版再看一次(誤擋方向)。
    ★二進位檔例外★(代碼審 r2 通才 F1):二進位檔沒有增刪行,內容變化只在 `index 舊..新` 的「新」那一半
    (改動後的版本雜湊)與 `GIT binary patch` 資料行——這兩樣要算進去,否則換掉整個二進位檔指紋也不變。
    文字檔不算 index,因為 rebase 會讓它變、改動本身卻沒變。"""
    import hashlib
    files, cur, in_hunk = {}, None, False
    _HDR_KEEP = ("old mode ", "new mode ", "new file mode ", "deleted file mode ", "rename from ", "rename to ",
                 "Binary files ", "copy from ", "copy to ")

    def _strip(p, pre):
        p = _git_unquote_path(p.split("\t", 1)[0])
        return p[len(pre):] if p.startswith(pre) else p

    def _flush():
        if cur:
            name = cur.get("plus") or cur.get("rename") or cur.get("minus") or cur.get("hdr")
            if name:
                chg = cur["chg"] + ([f"post-blob {cur['post']}"] if cur.get("bin") and cur.get("post") else [])
                h = hashlib.sha256("\n".join(chg).encode("utf-8", "surrogateescape")).hexdigest()
                files[name] = h

    for ln in text.splitlines():
        if ln.startswith("diff --git "):
            _flush()
            rest, hdr = ln[len("diff --git "):], None
            if rest.endswith('"'):
                k = rest.rfind(' "b/')
                if k >= 0:
                    hdr = _strip(rest[k + 1:], "b/")
            else:
                k = rest.rfind(" b/")
                if k >= 0:
                    hdr = rest[k + 3:]
            cur, in_hunk = {"hdr": hdr, "chg": [], "bin": False, "post": None, "binpatch": False}, False
            continue
        if cur is None:
            continue
        if cur["binpatch"]:
            cur["chg"].append(ln)   # GIT binary patch 的資料行就是內容
            continue
        if in_hunk:
            if ln[:1] in ("+", "-", " ", "\\"):
                cur["chg"].append(ln)   # 增刪行、上下文行、「\ No newline」都是內容
            elif ln.startswith("@@"):
                cur["chg"].append("@@" + ln.split("@@", 2)[-1])   # 行號不算、段落標頭(函式名)算
            continue
        if ln.startswith("@@"):
            in_hunk = True
            cur["chg"].append("@@" + ln.split("@@", 2)[-1])   # 第一段的段落標頭也算
        elif ln.startswith("index ") and ".." in ln:
            cur["post"] = ln[len("index "):].split("..", 1)[1].split(" ", 1)[0]
        elif ln == "GIT binary patch":
            cur["bin"] = cur["binpatch"] = True
        elif ln.startswith(_HDR_KEEP):
            if ln.startswith("Binary files "):
                cur["bin"] = True
            cur["chg"].append(ln)
            if ln.startswith("rename to "):
                cur["rename"] = _git_unquote_path(ln[len("rename to "):])
        elif ln.startswith("+++ ") and ln[4:].strip() != "/dev/null":
            cur["plus"] = _strip(ln[4:], "b/")
        elif ln.startswith("--- ") and ln[4:].strip() != "/dev/null":
            cur["minus"] = _strip(ln[4:], "a/")
    _flush()
    return files


def _prov_check(r, key, prov_path):
    """單一帳列的一份留痕(key=report_path/snapshot_path/intake_path)還對不對得上。
    回 (狀態, 路徑):ok / missing(帳上沒帶)/ unreadable(讀不到)/ mismatch(sha 與帳面不符=事後被改)。
    處置閘的留痕重驗與資安席一步共用這一支,不各抄一份(r1 前掃 ④b)。"""
    pth = r.get(key)
    if not pth:
        return "missing", None
    try:
        got = _sha256_file(prov_path(pth))
    except OSError:
        return "unreadable", pth
    return ("ok" if got == r.get(key.replace("_path", "_sha256")) else "mismatch"), pth


def _gated_seats_for(rounds, loop_id):
    """資安席這一步對這個迴圈適不適用。回 (狀態, 說明, 席位清單):
    skip(不是代碼審 / 定錨分級的編制表沒有 required-gated 席 / 首筆帳早於生效日)、
    fail(帳上 ts 讀不動——判不了新舊迴圈,壞資料不放行,同 _disposal_clause_step)、apply(要檢查)。"""
    kind = _roster_kind(loop_id or "")
    if kind == "design":
        return "skip", "設計審不要求資安席——設計審編制不加", []
    # kind is None:編號 code 開頭卻不是 code-,看不出種類 → 照最嚴的當代碼審(代碼審 r1 通才 A2:
    # 原本整步跳過,換個名字就繞過;條款綁定那一步對同一種編號也是照它自己最嚴的方向判)
    tier = _loop_anchor_tier(rounds)
    entry = _TIER_ROSTER.get(("code", tier))
    slots = [s["slot"] for s in (entry or {}).get("seats", []) if s.get("requirement") == "required-gated"]
    if not slots:
        return "skip", f"定錨分級 {tier or '沒指定'},編制表沒有必派而且會擋的席", []
    keys = [(_loop_ts_key(str(r.get("ts", ""))), str(r.get("ts", ""))) for r in rounds if r.get("ts")]
    if any(k is None for k, _ in keys):
        bad = next(x for k, x in keys if k is None)
        return "fail", f"帳上有一筆 ts 讀不動或沒帶時區({bad!r}),判不了是不是生效日後開的迴圈;壞資料不放行", []
    if keys and min(k for k, _ in keys) < _loop_ts_key(_SECURITY_SEAT_SINCE):
        return "skip", f"迴圈首筆帳 {min(keys)[1][:19]} 早於生效日 {_SECURITY_SEAT_SINCE[:10]},不回溯", []
    return "apply", "", slots


def _gated_seat_rows(rounds, loop_id):
    """適用時,帳上坐 required-gated 席的那些帳列(凍結閉包要把它們的報告與凍結 patch 一起收)。"""
    st, _why, slots = _gated_seats_for(rounds, loop_id)
    if st != "apply":
        return []
    return [r for r in rounds if any(_auditor_matches_slot(r.get("auditor"), s) for s in slots)]


def _disposal_security_step(rounds, rid, loop_id, prov_path):
    """處置閘第六步「資安席」(第五步是條款綁定):回 "fail" / "ok" / "skip",自己印 [disposal] 資安席 那幾行。
    定錨 high、生效日後的代碼審,編制表上每個 required-gated 席:①整個迴圈有它的帳(席名判法見 _auditor_matches_slot)
    ②那筆的報告與凍結 patch 還在、sha 對 ③它看過的檔(凍結 patch 檔案清單聯集)涵蓋判定輪全部檔。
    看整個迴圈不是每一輪(判定輪常是只派一席的 delta 輪)。凍結/回放模式照樣重讀檔——凍結閉包也收了這些檔,
    所以即時判不過的,凍結重算也判不過(r1 外家否決 E2)。"""
    st, why, slots = _gated_seats_for(rounds, loop_id)
    if st == "skip":
        print(f"[disposal] 資安席: —({why})")
        return "skip"
    if st == "fail":
        print(f"[disposal] 資安席: ✗ — {why}")
        return "fail"
    judge = [r for r in rounds if r.get("round") == rid]
    if not judge and isinstance(rid, str) and rid.startswith("__seq"):
        # 不帶 --round 的迴圈:判定輪是讀側合成的 __seqN(逐筆自成一輪),帳上 round 欄是 None,拿 rid 比永遠比不中
        # → 原本判定輪抓不到檔名、恆判不過、訊息還講成材料放錯(代碼審 r3 編排者自找)。混帶/不帶輪次在上游就擋,這裡全是不帶的
        judge = [r for r in rounds if r.get("round") is None][-1:]
    jchg, junread = {}, []
    for sp in sorted({r.get("snapshot_path") for r in judge if r.get("snapshot_path")}):
        try:
            jchg.update(_patch_file_changes(prov_path(sp).read_text(encoding="utf-8", errors="replace")))
        except OSError:
            junread.append(sp)
    jfiles = set(jchg)
    _odd_id = _roster_kind(loop_id or "") is None
    verdict = "ok"
    for slot in slots:
        rows = [r for r in rounds if _auditor_matches_slot(r.get("auditor"), slot)]
        if not rows:
            seen = sorted({r.get("auditor") for r in rounds if r.get("auditor")})
            print(f"[disposal] 資安席: ✗ — 這個迴圈沒有「{slot}」席的帳(高風險代碼審必派,而且問閘會擋)"
                  + ("——編號 code 開頭卻不是 code-,看不出是哪一種審查,照最嚴的當代碼審" if _odd_id else ""))
            print(f"  帳上出現過的席名:{'、'.join(seen) if seen else '(無)'}——席名要有一段是「{slot}」,例如 {slot}-sonnet")
            print("  在意的原因:高風險代碼審一律要有一席站在攻擊者那邊看過這份改動(2026-09-11 人裁);沒有它,能被利用的洞沒人負責找。")
            print("  接下來:派一席資安(派工用 lumos-design-loop templates.md §7.8);已經審過、只是席名寫錯的,用正確席名把同一份報告補記一筆:")
            import shlex as _shlex   # 代碼審 r2 資安 G3:編號原樣塞進建議指令,照抄執行會被當成 shell 語法
            print(f"    lumos canary record none --loop {_shlex.quote(loop_id)} --round <那一輪> --auditor {slot}-<模型> --severity <最高> "
                  "--findings <條數> --report <報告> --snapshot <那一輪凍結 patch> --spec <那一輪凍結 patch> --reviewed <sha256>")
            verdict = "fail"
            continue
        good, bad = [], []
        for r in rows:
            probs = []
            for label, key in (("報告", "report_path"), ("凍結 patch", "snapshot_path")):
                pst, pth = _prov_check(r, key, prov_path)
                if pst != "ok":
                    probs.append({"missing": f"{label}沒記", "unreadable": f"{label}讀不到({pth})",
                                  "mismatch": f"{label} sha256 與帳面不符(事後被改)"}[pst])
            (bad if probs else good).append((r, probs))
        if not good:
            print(f"[disposal] 資安席: ✗ — 「{slot}」席的帳在,但留痕對不上:"
                  + ";".join(f"{r.get('round')} {r.get('auditor')} {'、'.join(p)}" for r, p in bad))
            print("  在意的原因:報告不在或事後被改,就證明不了那一席真的看過、看的是哪一版。")
            print("  接下來:找回原檔;找不回就重派一席資安再記帳。")
            verdict = "fail"
            continue
        if junread or not jfiles:
            print("[disposal] 資安席: ✗ — 判定輪的凍結 patch 讀不到或抓不到任何檔名"
                  + (f"({'、'.join(junread)})" if junread else "") + ",沒辦法確認資安席看過的檔有沒有涵蓋最後一版;看不懂就不放行")
            print("  在意的原因:代碼審的凍結材料應該是整條分支的 diff(git diff <merge-base>..HEAD);抓不到檔名多半是材料放錯了。")
            verdict = "fail"
            continue
        seen = {}
        for r, _p in good:
            for f, h in _patch_file_changes(prov_path(r["snapshot_path"]).read_text(encoding="utf-8", errors="replace")).items():
                seen.setdefault(f, set()).add(h)
        unseen = sorted(f for f in jfiles if f not in seen)
        changed = sorted(f for f in jfiles if f in seen and jchg[f] not in seen[f])
        if unseen or changed:
            parts = []
            if changed:
                parts.append(f"{len(changed)} 支的內容跟資安席看的不一樣(之後又改過):" + "、".join(changed[:10])
                             + ("…" if len(changed) > 10 else ""))
            if unseen:
                parts.append(f"{len(unseen)} 支資安席沒看過:" + "、".join(unseen[:10]) + ("…" if len(unseen) > 10 else ""))
            print("[disposal] 資安席: ✗ — 最後一版改到的檔," + ";".join(parts))
            print("  在意的原因:資安席看的是早一輪的材料;之後新碰到或又改過的檔,沒有人從攻擊者角度看過最後的樣子。")
            print(f"  接下來:對最新的凍結 patch 再派一席資安,記帳席名用 {slot}-<模型>。")
            verdict = "fail"
            continue
        r0 = good[0][0]
        print(f"[disposal] 資安席: ✓ — {r0.get('round')} {r0.get('auditor')}(看過的檔涵蓋最後一版 {len(jfiles)} 個)")
    return verdict


def _disposal_clause_step(rows, spec, root, env, loop_id="", spec_sha_override=None):
    """處置閘第五步(條款綁測試算進度 [S3]):回 "fail" / "ok" / "skip",自己印一行 [disposal] 條款綁定。
    skip 四種:①凍結/回放模式(spec_sha_override 有值,對凍結 sha 判、不重讀活檔)②迴圈類型是 code(loop id 前綴 code-,同 _roster_kind;
    code 開頭但不是 code- 的一律當設計審,fail-closed;不看副檔名——外家席:.patch 跳過只看尾碼會被設計審拿 patch 當審材繞過)
    ③迴圈首筆帳早於 _CLAUSE_GATE_SINCE(不回溯)④計劃無 [SN](opt-in 未啟用)。
    fail 六種:設計審審材不是 .md / 首筆帳 ts 讀不動 / 測試索引建不起來 / [SN] 像清單項卻是不認得的寫法(零條定義)/ 條款編號重複定義 / 任一條款未標;
    計劃讀不成文字 → "abort"(呼叫端同 G3 擋下 rc2,兩步同一種處置)。只在散文/標題提到 [SN]、沒有定義行 → skip(視同 opt-in 未啟用)。
    這是「設計審出口真的有東西逼」的那一半——沒有它,綁測試名跟 spec-trace 一樣沒人做(33 篇 15 篇零認領)。"""
    if spec_sha_override is not None:
        print("[disposal] 條款綁定: —(凍結/回放模式:不重讀活檔,以問閘當下的判定為準)")
        return "skip"
    if _roster_kind(loop_id or "") == "code":
        print("[disposal] 條款綁定: —(code 迴圈,審材是 diff 不是計劃,不看條款)")
        return "skip"
    # _roster_kind 回 None(code 開頭但不是 code-)一律當設計審:fail-closed,免得取個 codeX 的編號就繞過(r2 外家席實跑抓到)
    tss = [str(r.get("ts", "")) for r in rows if r.get("ts")]
    keys = [(_loop_ts_key(x), x) for x in tss]
    if any(k is None for k, _ in keys):
        bad = next(x for k, x in keys if k is None)
        print(f"[disposal] 條款綁定: ✗ — 帳上有一筆 ts 讀不動或沒帶時區({bad!r}),判不了新舊迴圈;壞資料不放行(同 findings 壞值的 fail-closed)")
        return "fail"
    if keys and min(k for k, _ in keys) < _loop_ts_key(_CLAUSE_GATE_SINCE):
        print(f"[disposal] 條款綁定: —(迴圈首筆帳 {min(keys)[1][:19]} 早於 {_CLAUSE_GATE_SINCE[:10]},不回溯)")
        return "skip"
    if not str(spec).endswith(".md"):
        print(f"[disposal] 條款綁定: ✗ — 設計審的審材必須是計劃筆記(.md),不是 {Path(str(spec)).name}(拿 patch 當審材繞不過這一步)")
        return "fail"
    try:
        text = Path(spec).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError) as e:
        print(f"擋下:--spec 指的文件讀不成文字({e.__class__.__name__}),確認路徑對不對:\n    {spec}", file=sys.stderr)
        return "abort"
    if not SPEC_CLAUSE_RE.search(text):
        print("[disposal] 條款綁定: —(計劃無 [SN] 條款,opt-in 未啟用)")
        return "skip"
    rows_b, err = _clause_bindings_for(env, text, root=root)
    if err:
        print(f"[disposal] 條款綁定: ✗ — 測試索引建不起來({err}),驗不了≠通過")
        return "fail"
    # 規格落成可驗收條件_計劃(半套)S9/S14:判定走跟 lumos spec-gate 同一支 _clause_check;句式與回退節只對首筆帳晚於 _SPEC_GATE_SINCE 的迴圈驗(綁定照驗)
    grammar = not keys or min(k for k, _ in keys) >= _loop_ts_key(_SPEC_GATE_SINCE)
    status, lines = _clause_check(text, rows_b, grammar=grammar, tag="disposal")
    for ln in lines:
        print(ln)
    return status


_LANDING_GATE_SINCE = "2026-09-12T00:00:00+08:00"   # 處置閘的落點那一步只看首筆帳在這之後的迴圈——不回溯(同 _CLAUSE_GATE_SINCE)
_LANDS_IN_ITEM_RE = re.compile(r"^Systems/[^/\[\]|#]+$")


def _lands_in_bad(values):
    """[S20] lands_in 每項要寫 Systems/<名>(純字串,不是 [[連結]]、不帶 .md、只收圖譜節點)。回寫錯的那幾項。"""
    bad = []
    for v in values:
        x = str(v).strip()
        if not x or not _LANDS_IN_ITEM_RE.match(x) or x.endswith(".md"):
            bad.append(x)
    return bad


def _disposal_landing_step(rows, spec, root, env, loop_id="", spec_sha_override=None):
    """處置閘第六步(每支檔有家 [S21]):計劃要寫明落點(lands_in)。形狀照條款綁定那一步:回 "fail"/"ok"/"skip"/"abort"。
    skip:凍結/回放模式、code 迴圈、首筆帳早於 _LANDING_GATE_SINCE(不回溯)、審材不是圖譜 Projects 底下 type 為 project 的 .md。
    fail:lands_in 空的,或有一項不是 Systems/<名> 的樣子。"""
    if spec_sha_override is not None:
        print("[disposal] 落點: —(凍結/回放模式:以問閘當下的判定為準)")
        return "skip"
    if _roster_kind(loop_id or "") == "code":
        print("[disposal] 落點: —(code 迴圈,不看計劃落點)")
        return "skip"
    tss = [str(r.get("ts", "")) for r in rows if r.get("ts")]
    keys = [k for k in (_loop_ts_key(x) for x in tss) if k is not None]
    if keys and min(keys) < _loop_ts_key(_LANDING_GATE_SINCE):
        print(f"[disposal] 落點: —(迴圈首筆帳早於 {_LANDING_GATE_SINCE[:10]},不回溯)")
        return "skip"
    sp = Path(str(spec))
    vault = Path(env.vault) if env is not None else None
    inside = False
    if vault is not None and str(spec).endswith(".md"):
        try:
            inside = sp.resolve().relative_to((vault / "Projects").resolve()) is not None
        except (ValueError, OSError):
            inside = False
    if not inside:
        # ★要真的在這個圖譜的 Projects 底下★:只看上一層資料夾叫不叫 Projects,/tmp/Projects/假.md 也會被當成計劃(第二輪外家席)
        print("[disposal] 落點: —(審材不是這個圖譜 Projects 底下的計劃,不看落點)")
        return "skip"
    try:
        text = sp.read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError) as e:
        print(f"擋下:--spec 指的文件讀不成文字({e.__class__.__name__}),確認路徑對不對:\n    {spec}", file=sys.stderr)
        return "abort"
    fm_lines, _body = split_frontmatter(text)
    fields = parse_frontmatter(fm_lines)[0] if fm_lines is not None else {}
    if str(fields.get("type", "")).strip() != "project":
        print("[disposal] 落點: —(審材的 type 不是 project,不看落點)")
        return "skip"
    items = [str(x).strip() for x in as_list(fields.get("lands_in")) if str(x).strip()]
    if not items:
        print("[disposal] 落點: ✗ — 計劃沒寫 lands_in(現況會寫進哪幾篇、或新開哪一篇);節點長成一篇包全部,就是因為落點從來沒被審過")
        print("    lumos append <計劃> lands_in Systems/<名>")
        return "fail"
    bad = _lands_in_bad(items)
    if bad:
        print("[disposal] 落點: ✗ — lands_in 這幾項不是 Systems/<名> 的樣子:" + "、".join(bad) + "(純字串、不帶 .md、不寫 [[連結]];落到 skill 或範本的寫在計劃正文)")
        return "fail"
    news = [x for x in items if not (vault / f"{x}.md").is_file()]
    print(f"[disposal] 落點: ✓ — {len(items)} 篇(" + "、".join(x + ("(新開)" if x in news else "") for x in items) + ")")
    return "ok"


def _loop_status_disposal(rounds, loop_id, spec, n_badlines=0, root=None, bad_linenos=None, env=None, roster=False, repo=None, readonly=False, spec_sha_override=None, result_out=None):
    """[T4] 處置閘(design-loop重設計 三):七步合取,全部讀側可重算(原本寫「四條合取」,2026-09-08 加⑤、2026-09-11 加⑥⑦後過期)——
    ①G3 hash 鏈 ②處置集合重算(不信寫側) ③留痕重驗(判定輪★全部★帶留痕欄的席,
    report/snapshot 存在且 sha 一致——r1 否決席:原只驗 carrier,竄改 missed 席報告照樣 PASS)
    ④quote-check 對 carrier 的帳面 snapshot 全 ok
    ⑤條款綁定(設計審計劃每條 [SN] 要標 [test:]/[manual:];代碼審 skip,見 _disposal_clause_step)
    ⑥資安席(定錨 high 的代碼審,required-gated 席出席+留痕+涵蓋最後一版;見 _disposal_security_step)
    ⑦落點(設計審計劃要寫明 lands_in;代碼審 skip,見 _disposal_landing_step)。
    ★canary caught/missed 不進合取(d4:觀測非閘;missed 不作廢 findings)★。
    壞行 fail-closed(r1 四席重疊:原壞行靜默跳過→latest 判錯輪可偽 PASS);
    round-id 非連續重現 rc2(reuse panel 守衛;原 OrderedDict 首現序拿錯輪)。
    留痕路徑:非絕對路徑以 repo root(root)解析(與寫側落帳慣例對稱)。
    exit 0=收斂 / 1=未過 / 2=帳面損壞或參數錯。"""
    from collections import OrderedDict
    if n_badlines:
        print(f"擋下:審查記錄檔有 {n_badlines} 行讀不懂,沒辦法確定「最後一輪」是哪輪,先不判"
              "(修好或搬走壞行再問)"
              + (f"——壞行行號: {bad_linenos}" if bad_linenos else "")
              + "(檔案有 git 版控,對照上一版找出壞行一分鐘就能修)",
              file=sys.stderr)
        return 2
    # r3 修:round 與 round-less 混用=rc2(同 panel 混用守衛精神;原樣混排會落進
    # 「非連續重現」的誤導訊息,或與內部 __seq 鍵互動出偽輪)
    n_round_ = sum(1 for r in rounds if "round" in r)
    if rounds and 0 < n_round_ < len(rounds):
        print("擋下:這個審查編號的記錄有的帶輪次、有的不帶,分不出哪輪是判定輪;"
              "統一補 --round,或全部不帶", file=sys.stderr)
        return 2
    groups = OrderedDict()
    for r in rounds:
        rid_ = r.get("round")
        if rid_ is None:
            # round-less 逐筆自成一輪(r2 回歸修:併成單一 __legacy 組會讓較早 carrier
            # 冒充最新判定/合法 legacy 第二筆假 rc2;守衛只管顯式 round-id)
            groups[f"__seq{len(groups)}"] = [r]
            continue
        if rid_.startswith("__"):
            # r3 修(3 席重疊):防舊帳/手改帳撞內部鍵(寫側已擋新寫入,讀側防守舊資料)
            print(f"擋下:記錄裡有輪次編號 {rid_!r} 用了工具保留的 __ 字首(手改過或舊版寫的),先改掉", file=sys.stderr)
            return 2
        if rid_ in groups and next(reversed(groups)) != rid_:
            # 同 panel 守衛:round-id 被其他輪隔開後重現=append-only 帳次序損壞
            print(f"擋下:第 {rid_!r} 輪的記錄被別的輪次隔開後又出現(非連續重現),帳的順序亂了,沒辦法判斷",
                  file=sys.stderr)
            return 2
        groups.setdefault(rid_, []).append(r)
    if not groups:
        print(f"⏳ 無記錄({loop_id} 目前一筆記錄都還沒有)")
        return 1
    rid, latest = next(reversed(groups.items()))

    def _prov_path(p):
        pp = Path(p)
        return pp if pp.is_absolute() or root is None else Path(root) / pp
    fails = []
    # ── ① G3 hash 鏈(fail-closed:unbound 也擋——disposal 是新閘,無舊帳包袱) ──
    if str(rid).startswith("__") and any("findings_set" in r for r in latest):
        print("擋下:這一輪是無輪次(round-less)帳列卻帶了處置結果——處置帳必須綁輪次"
              "(2026-08-26 關繞道:無輪次處置帳可讓低報逃過寫側守衛;真帳歷史零筆此形狀,fail-closed 不誤傷)",
              file=sys.stderr)
        return 2
    try:
        err, info = _hash_chain_check([latest], spec, cur_sha_override=spec_sha_override)
    except OSError as e:
        print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
        return 2
    if err:
        print(f"[disposal] G3 hash: ✗ — {err}")
        fails.append("G3")
    elif info == "unbound":
        print("[disposal] G3 hash: ✗ — 判定輪未綁 hash(disposal 閘 fail-closed,record 帶 --spec/--reviewed)")
        fails.append("G3")
    else:
        print(f"[disposal] G3 hash: ✓ — {info}")
    # ── ② 處置集合(輪級重算,不信寫側) ──
    carriers = [r for r in latest if "findings_set" in r]
    if len(carriers) > 1:
        print(f"擋下:第 {rid} 輪有 {len(carriers)} 筆記錄都帶了處置結果,一輪只能有一筆", file=sys.stderr)
        if _panel_retired_for(rounds):
            print("  多席審查(2026-08-25 甲裁後)一律彙總記帳:處置清單只掛一席,其餘席只留痕(severity/report)。", file=sys.stderr)
            print("  帳不可撤——換一個新編號照上式重記,再問 --disposal。(詳 Projects/probe輪退場_計劃)", file=sys.stderr)
        else:
            print("  這種「多席各自記帳」是 panel 型,不歸 --disposal 管(它只收一輪一筆處置帳的循序記帳)。改問:", file=sys.stderr)
            print("    lumos loop status <編號> --gate --panel --min-seats 3 --spec … --repo …", file=sys.stderr)
            print("  (2026-08-06 後的迴圈要連續兩輪乾淨才過;此路僅供 2026-08-25 前定錨的舊迴圈)", file=sys.stderr)
        return 2
    carrier = carriers[0] if carriers else None
    # findings 欄壞值(手改帳/舊寫入殘留)→ fail-closed rc2,同 clusters 型別防禦慣例(不 traceback)
    def _findings_zero(r):
        v = r.get("findings")
        if v is None:
            return False       # 沒填 ≠ 明說 0(legacy 帳缺欄不放行,逐筆成輪加固測試釘的)
        try:
            return int(v) == 0
        except (TypeError, ValueError):
            return None        # 壞值
    _fz = [_findings_zero(r) for r in latest]
    if any(x is None for x in _fz):
        print("擋下:有筆記錄的 findings 欄不是整數(檔案壞了或被手改過?)——fail-closed。"
              "對照 git 上一版找出壞行改回整數:\n    git diff HEAD -- docs/.canary-log.jsonl", file=sys.stderr)
        return 2
    vacuous = False
    if carrier is None:
        # 零發現的乾淨輪:record 端明文「沒發現別帶處置選項」,這裡再要求處置帳=兩邊打架、乾淨輪永遠過不了
        # (2026-08-24 code-out-top3 實踩)。手冊語意=「每個發現都有去向即過」→ 0 條發現視同全處置(vacuous)。
        # ★vacuous 只免「處置集合」這一項★——留痕重驗照跑(r1 blocker:免驗通行證);引句無可驗,橫幅不宣稱。
        if latest and all(_fz):
            vacuous = True
            print("[disposal] 處置集合: ✓ — 這輪 0 條發現,沒有東西要處置(空輪;留痕仍要重驗)")
        else:
            print("[disposal] 處置集合: ✗ — 判定輪有發現但無處置帳(record 帶 --findings-set/--folded-set/--accepted-set)")
            fails.append("無處置帳")
    else:
        F = set(carrier.get("findings_set") or [])
        FO = set(carrier.get("folded_set") or [])
        AC = set(carrier.get("accepted_set") or [])
        reasons = carrier.get("accept_reasons") or {}
        bad = None
        if FO & AC:
            bad = f"folded∩accepted 非空: {sorted(FO & AC)}"
        elif FO | AC != F:
            bad = f"未處置: {sorted(F - FO - AC)}"
        elif set(reasons) != AC or any(not str(v).strip() for v in reasons.values()):
            bad = "accepted 理由缺席或空"
        elif AC and any(r.get("severity") == "blocker" for r in latest):
            bad = "★輪內有 blocker 席,accepted 必須為空(d1;輪級重算,不信寫側單席視角)★"
        elif AC and str(loop_id).startswith("code-") and any(r.get("severity") in ("major", "blocker") for r in latest):
            bad = "★code 迴圈輪內有 major 以上的席,accepted 必須為空——major 一律折,不得附理由放行(probe輪退場 d2,Enzo 2026-08-25 裁:與 panel 時代 max≤minor 同嚴度;散文設計審不受此限)★"
        if bad:
            print(f"[disposal] 處置集合: ✗ — {bad}")
            fails.append("處置集合")
        else:
            print(f"[disposal] 處置集合: ✓ — {len(F)} 條全處置(折 {len(FO)}/放行 {len(AC)},理由齊)")
    # ── ③ 留痕重驗(判定輪全席) + ④ quote-check(carrier;vacuous 輪無引句可驗,只跑 ③) ──
    if carrier is not None or vacuous:
        _qsrc = carrier if carrier is not None else latest[-1]
        rp, sp = _qsrc.get("report_path"), _qsrc.get("snapshot_path")
        if not rp or not sp:
            print("[disposal] 留痕: ✗ — 判定輪未帶 report/snapshot(留痕缺席)")
            fails.append("留痕缺席")
        else:
            ok = True
            n_files = 0
            # 全席重驗:T6 定錨後每席都被迫留痕,讀側就得每席都重驗——
            # 只驗 carrier 等於把 missed 席留痕降回「寫側形式要求」(r1 否決席 finding)。
            for i, r in enumerate(latest, 1):
                for label, key in (("report", "report_path"), ("snapshot", "snapshot_path")):
                    pst, pth = _prov_check(r, key, _prov_path)   # 與資安席一步共用(代碼審資安席 [S2])
                    if pst == "missing":
                        # r2 回歸修(否決席):缺欄席不得靜默跳過——「全席重驗」對缺欄席
                        # 也要成立,否則定錨前搶跑的席=讀側盲區
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} 未帶 {label}(disposal 判定輪全席都要留痕)")
                        fails.append("留痕")
                        ok = False
                        continue
                    n_files += 1
                    if pst == "unreadable":
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} {label} 讀不到({pth})——record 完刪檔照樣擋")
                        fails.append("留痕")
                        ok = False
                    elif pst == "mismatch":
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} {label} sha256 與帳面不符(事後被改)")
                        fails.append("留痕")
                        ok = False
            # intake守衛 T3 讀側(2026-08-30 d1):★全輪掃★——intake_path 掛 r1 帳列而判定輪
            # 多為 r2+,照 report/snapshot 只掃判定輪=常態空轉(r3-F3);任一輪帳列有 intake_path
            # 就重驗,沒有就跳過(選配欄,不強制)。竄改 intake 與竄改 report 同罪(sha 不符=FAIL)。
            _ik_n = 0
            for _rid_g, _rows_g in groups.items():
                for _r_g in _rows_g:
                    _pst, _ip = _prov_check(_r_g, "intake_path", _prov_path)
                    if _pst == "missing":
                        continue
                    _ik_n += 1
                    if _pst == "unreadable":
                        print(f"[disposal] 留痕: ✗ — {_rid_g} intake 讀不到({_ip})——record 完刪檔照樣擋")
                        fails.append("留痕")
                        ok = False
                    elif _pst == "mismatch":
                        print(f"[disposal] 留痕: ✗ — {_rid_g} intake sha256 與帳面不符(事後被改)")
                        fails.append("留痕")
                        ok = False
            if ok:
                _ik_note = f"(含全輪 intake {_ik_n} 份)" if _ik_n else ""
                print(f"[disposal] 留痕: ✓ — 判定輪全席 {n_files} 份留痕存在且 sha256 與帳面一致{_ik_note}")
            if ok and vacuous and carrier is None:
                print("[disposal] quote-check: —(零發現報告無引句可驗,略過;橫幅不宣稱錨定)")
            elif ok:
                try:
                    rows = _quote_rows(_prov_path(rp).read_text(encoding="utf-8"),
                                       _prov_path(sp).read_text(encoding="utf-8"))
                except (OSError, UnicodeDecodeError) as e:
                    # sha 讀二進位過了,text 讀可炸(非 UTF-8)——FAIL 不 traceback(r1 s4 席)
                    print(f"[disposal] quote-check: ✗ — 報告/快照讀不成文字({e.__class__.__name__})")
                    fails.append("quote")
                    rows = None
                else:
                    if rows is None:
                        print("[disposal] quote-check: ✗ — 報告零引句(驗不了≠通過)")
                        fails.append("quote")
                    else:
                        miss = [q for q in rows if not q["ok"]]
                        n_short = sum(1 for q in rows if q.get("too_short"))
                        if miss:
                            print(f"[disposal] quote-check: ✗ — {len(miss)}/{len(rows)} 條錨不到快照"
                                  + (f"(其中 {n_short} 條低於 {_QUOTE_MIN_NORM_LEN} 字下限)" if n_short else ""))
                            fails.append("quote")
                        else:
                            print(f"[disposal] quote-check: ✓ — {len(rows)} 條引句全數錨定")
    # ── canary 觀測(不進合取——d4;none=停用制無植入輪——d5) ──
    ca = sum(1 for r in latest if r.get("kind") == "caught")
    mi = sum(1 for r in latest if r.get("kind") == "missed")
    nn = sum(1 for r in latest if r.get("kind") == "none")
    print(f"[disposal] canary(觀測,不進合取): caught {ca} / missed {mi}"
          + (f" / none {nn}(協議停用,d5)" if nn else "")
          + ("——missed 席 findings ★不作廢★(d4),供跨輪累積帳" if mi else ""))
    for i, r in enumerate(latest, 1):
        print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('auditor','')}")

    def _roster_tail():
        # roster對帳併入問閘 [S1]:問閘當輪異常轉述(異常才發聲;advisory 恆不動 rc)。
        # 三個提前 return 2 路(G3 spec 讀不到/一輪多處置帳/findings 壞值)刻意不掛——
        # 帳面異常優先於席位對帳(r3 e-f2)。roster 同帶=全史已印,尾端跳過(r2 d-f1)。
        if roster or str(rid).startswith("__"):
            return   # __seqN 合成鍵:round-less 無派工快照可對,沉默勝過錯誤示警(std-r1 s1-f2)
        try:
            kinds = _roster_observe(env, loop_id, rounds, repo, only_rid=rid, anomalies_only=True)
            if kinds:
                print("[roster] ↑ 席位對帳為觀測,不進合取")   # 免責字樣(severity-scan r1 s3-f4 順手補)
                # 留痕([S1c]):收集完、印完才一次性寫;寫入自身再包一層,失敗只損留痕不吞輸出(r3 e-f3)
                try:
                    _ldir = (Path(repo).resolve() if repo else _vault_repo_root(env)) / "governance" / "review-reports" / loop_id
                    _ldir.mkdir(parents=True, exist_ok=True)
                    import datetime as _dt
                    with open(_ldir / "roster-alerts.log", "a", encoding="utf-8") as _f:
                        _f.write(f"{_dt.date.today().isoformat()} {rid} {','.join(kinds)}\n")
                except OSError as _e:
                    print(f"[roster] 異常留痕寫入失敗({_e})——轉述已印,只是兩季覆核帳少這筆")
        except Exception as _e:
            print(f"[roster] 席位對帳失敗(降級不擋):{_e}")

    def _severity_tail():
        # 嚴重度綁定機械掃 [S3](2026-08-26):問閘收尾對判定輪逐席跑第二層 severity 對帳。
        # 異常才發聲;advisory 恆不動 rc;③已對判定輪全席報告逐檔重算過 sha→trust_sha 不重算
        # (r1 arch-f4);__seqN 合成鍵跳過(無派工上下文);例外降級不擋(比照 roster 尾端)。
        # 生效日後的帳列抓到低報=寫側 [S1] 有 bug(本應拒帳)——轉述+指路開 Issue,converged 不自動撤。
        if str(rid).startswith("__"):
            return
        try:
            _root = Path(repo).resolve() if repo else _vault_repo_root(env)
            _hits = []
            for _r in latest:
                _st, _msg = _severity_check_row(_r, _root, trust_sha=True)
                _new_era = str(_r.get("ts", "")) >= _SEV_WRITESIDE_CUTOFF
                if _st == "under" or (_st == "noparse" and _new_era):
                    _tag = "寫側有 bug,開 Issue 攤人;" if _new_era else "歷史帳,"
                    print(f"[severity] {_r.get('auditor','?')}: {_msg}({_tag}觀測,不進合取)")
                    _hits.append(f"severity_underreport:{_r.get('auditor','?')}")
            if _hits:
                try:
                    _ldir = (Path(repo).resolve() if repo else _vault_repo_root(env)) / "governance" / "review-reports" / loop_id
                    _ldir.mkdir(parents=True, exist_ok=True)
                    import datetime as _dt2
                    with open(_ldir / "roster-alerts.log", "a", encoding="utf-8") as _f2:
                        _f2.write(f"{_dt2.date.today().isoformat()} {rid} {','.join(_hits)}\n")
                except OSError as _e2:
                    print(f"[severity] 異常留痕寫入失敗({_e2})——轉述已印,只是覆核帳少這筆")
        except Exception as _e2:
            print(f"[severity] 嚴重度對帳失敗(降級不擋):{_e2}")
    if not readonly:
        # replay 唯讀:觀測尾巴不跑——roster 尾端會寫 roster-alerts.log(r2 delta d-f3 抓的第三個寫入點),
        # severity 尾端同理;純判定核心=四合取本體。
        _roster_tail()
        _severity_tail()
    # intake守衛 T2(2026-08-30 d1;advisory 不進合取不改 rc):非 code 迴圈才看
    # (r3-F2:code-loop 零前掃步驟,code 的 intake 是撈回紀錄非前掃紀錄——計數它=逼偽宣告)。
    if not readonly and not str(loop_id).startswith("code"):
        _ik_st = _intake_dir_status(root if root is not None else Path.cwd(), loop_id)
        if _ik_st == "ok":
            print("[disposal] intake(觀測,不進合取): ✓ — 迴圈目錄有帶 preflight-4 宣告行的前掃留痕")
        elif _ik_st == "missing":
            print("[disposal] intake(觀測,不進合取): ⚠ 迴圈目錄無帶 preflight-4 宣告行的 intake——"
                  "首輪前掃第四類可能沒跑(慣例=skills/lumos-design-loop/SKILL.md 步驟 2;不擋,記著補)")
        # no-dir(scratch 迴圈,如自主迴圈 /tmp 工作區)= 跳過不印
        # ── 審查有沒有用記帳 S3(2026-09-08):問閘這一輪的漏斗,觀測不進合取 ──
        _y = _review_yield_round(latest)
        _esc = len(_escape_rows_for(env, loop_id)) if env is not None else None
        print("[disposal] 審查有沒有用(觀測,不進合取;N 機器數、R 人填,別算比率): " + _review_yield_line(_y, _esc))
    # ── ⑤ 條款綁定(條款綁測試算進度 [S3],2026-09-08):計劃有 [SN] 的,每條要嘛 [test:] 要嘛 [manual:],否則不得 PASS。
    #    只看 .md 計劃、首筆帳在 _CLAUSE_GATE_SINCE 之後的迴圈(不回溯);懸空只印不擋(存在性歸 doctor/spec-trace 唸)。
    _cl = _disposal_clause_step(rounds, spec, root, env, loop_id=loop_id, spec_sha_override=spec_sha_override)
    if _cl == "abort":
        return 2          # 同 G3:審材讀不到是用法錯誤,整支停,不是「這一項沒過」(r1/r2 架構席)
    if _cl == "fail":
        fails.append("條款綁定")
    # ── ⑥ 資安席(代碼審資安席 [S2],2026-09-11 d6):定錨 high 的代碼審,編制表上 required-gated 席要出席、留痕對、
    #    看過的檔涵蓋判定輪。只看生效日後開的迴圈(不回溯)。凍結/回放照樣重讀檔(凍結閉包也收了這些檔)。
    _sec = _disposal_security_step(rounds, rid, loop_id, _prov_path)
    if _sec == "fail":
        fails.append("資安席")
    # ── ⑦ 落點(每支檔有家 [S21],2026-09-11):計劃要寫明現況落在哪幾篇;首筆帳在 _LANDING_GATE_SINCE 之後的迴圈才看。
    _ld = _disposal_landing_step(rounds, spec, root, env, loop_id=loop_id, spec_sha_override=spec_sha_override)
    if _ld == "abort":
        return 2
    if _ld == "fail":
        fails.append("落點")
    if result_out is not None:
        result_out["rid"] = rid
        result_out["fails"] = list(fails)
    if fails:
        print(f"⛔ DISPOSAL GATE FAIL ({loop_id} 輪 {rid}: {'/'.join(fails)})")
        return 1
    # 橫幅只列這次真的跑過而且過了的步驟(代碼審 r3 編排者自找:加了⑤⑥之後橫幅還寫死四項);skip 的不列、不宣稱
    _extra = "".join(f" ∧ {n}" for n, st in (("條款綁定", _cl), ("資安席", _sec), ("落點", _ld)) if st == "ok")
    if vacuous and carrier is None:
        print(f"✅ DISPOSAL GATE PASS ({loop_id} 輪 {rid}: G3 ∧ 0 發現空輪 ∧ 留痕可重算{_extra};引句無可驗不宣稱)")
    else:
        print(f"✅ DISPOSAL GATE PASS ({loop_id} 輪 {rid}: G3 ∧ 處置全清 ∧ 留痕可重算 ∧ 引句全錨定{_extra})")
    if not readonly:
        _loop_gov_mark(env, loop_id, "converged", "disposal gate PASS")
    return 0


def cmd_quote_check(report, spec, as_json=False):
    """錨定檢查(T2,vault-free):報告內每條「引句：「…」」norm 後須為凍結快照 norm 後的
    子字串。rc0=全 ok、rc1=有 miss、rc2=IO/零引句(★驗不了≠通過,fail loud★)。
    ★比對對象必須是派工當下的凍結快照,不是現檔★——對現檔跑,finding 折入後引句會
    「自我成真」(重設計 r1 Codex 折入:循環自證)。"""
    import json
    import re
    try:
        rtext = Path(report).read_text(encoding="utf-8")
        stext = Path(spec).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as e:
        # UnicodeDecodeError 非 OSError——非 UTF-8 檔原本直接 traceback(r1 s4 席)
        print(f"擋下:檔案讀不到: {e}", file=sys.stderr)
        return 2
    rows = _quote_rows(rtext, stext)
    if rows is None:
        print("擋下:這份審查報告裡一句「引句：「…」」都抽不到;驗不了不等於通過——"
              "審查員沒照派工格式寫的話,先補引句再記帳。\n"
              "  常見原因:①標籤寫成『引文:』『Quote:』等別名(只認「引句」;粗體或加註記的變體可以)"
              " ②引號用半形 \"…\" 或【…】(只認「」『』) "
              "③引句跟標籤不在同一行 ④開閉引號不成對(這種會列成錨不到,不是零條)", file=sys.stderr)
        return 2
    miss = [r for r in rows if not r["ok"]]
    if as_json:
        print(json.dumps({"report": str(report), "spec": str(spec),
                          "total": len(rows), "miss": len(miss), "quotes": rows},
                         ensure_ascii=False))
    else:
        for i, r in enumerate(rows, 1):
            mark = "✓" if r["ok"] else "✗"
            short = f"(<{_QUOTE_MIN_NORM_LEN} 字下限)" if r.get("too_short") else ""
            print(f"  {mark} #{i} 「{r['quote'][:60]}」{short}")
        print(f"{'✅ 全數錨定:報告裡每句引言都能在凍結快照找到原文' if not miss else f'⛔ {len(rows)} 句引言有 {len(miss)} 句在凍結快照裡找不到(找不到的那幾句不採信)'}"
              f"(比對時忽略粗體、反引號和空白差異;比對對象應該是派工當下的凍結快照)")
    return 0 if not miss else 1




_CJK_RE = re.compile(r"[\u4e00-\u9fff]")
_NODE_SUFFIX_RE = re.compile(r"(_計劃|_實作計畫|_調研)$")
_NODE_DATEPFX_RE = re.compile(r"^\d{4}-\d{2}-\d{2}_")


def _lc_strip_stem(node_rel):
    """節點檔名 stem 剝節點型後綴與日期前綴(D2 防泛用尾綴誤報,plan:連結缺失補全 r1)。"""
    s = Path(node_rel).stem
    s = _NODE_DATEPFX_RE.sub("", s)
    s = _NODE_SUFFIX_RE.sub("", s)
    return s


def _lc_lcs_cjk(a, b):
    """最長公共連續子字串;回其中 CJK 字元數(演算法明文=逐對 LCS-substring)。"""
    if not a or not b:
        return 0
    best = ""
    # O(len(a)*len(b)) 樸素 DP;stem 長度小,夠用
    prev = [0] * (len(b) + 1)
    for i in range(1, len(a) + 1):
        cur = [0] * (len(b) + 1)
        for j in range(1, len(b) + 1):
            if a[i - 1] == b[j - 1]:
                cur[j] = prev[j - 1] + 1
                if cur[j] > len(best):
                    best = a[i - cur[j]:i]
        prev = cur
    return sum(1 for ch in best if _CJK_RE.match(ch))


def cmd_link_candidates(code_file=None, goldset=None, repo=None, as_json=False):
    """[S1 連結缺失補全,2026-08-07](plan:Projects/連結缺失補全_計劃;borrow TLR 離線候選
    +pitfalls-gapfill 人裁姿勢)。code→節點補鏈候選生成,★唯讀恆 rc0、不寫任何檔★——
    補引用=人裁後的正常圖譜編輯(合約候選:自動寫入=maker bias 閉環,人閘不可拆)。

    偵測器(全決定論,零 LLM):
    - D1 純文字提及:節點可見文字(_visible_lines keep_fenced=False+INLINE_CODE_RE 剝——
      即 search 的 include_code=False 同款組合;勿用保留 inline-code 的 _strip_fences_text)
      含完整路徑/完整檔名;或含 stem 且 stem≥6 字元且含 _ 或 -(複合詞判準,防 config/system
      這類單詞洪水)。
    - D2 鄰居家族:direct 節點集 D 的單跳雙向鄰居(邊型統一四種:related/body-wikilink/
      plan_refs/verified_by,不遞迴),且 (a) 剝後綴 stem 與某 d 的 LCS-substring ≥4 CJK
      (防「_實作計畫」泛用尾綴誤報——r1 實測 11 檔同尾) 或 (b) 經 plan_refs/verified_by
      單跳相連。
    已 direct(含 basename-match)去重不出候選。CLI:code_file 與 goldset 互斥必居其一,
    goldset 路徑為參數(vendored 工具不得寫死本專案治具路徑,合約候選)。
    輸出 schema 封閉:{"file", "candidates":[{"node","signal","evidence","via"}]}。
    """
    import json
    import os
    if bool(code_file) == bool(goldset):
        print("擋下:要嘛給一個程式檔、要嘛用 --all-goldset,兩個選一個", file=sys.stderr)
        return 2
    repo_root = Path(repo or ".").resolve()
    vault = _vault_in(repo_root)
    if vault is None:
        print("擋下:找不到知識圖譜(--repo 指的目錄底下沒有 docs/*-knowledge)", file=sys.stderr)
        return 2
    env = Env(vault)
    files = []
    if goldset:
        try:
            gs = json.loads(Path(goldset).read_text(encoding="utf-8"))
            files = sorted({c["file"] for c in gs.get("edit", []) if c.get("file")})
        except (OSError, ValueError, TypeError) as e:
            print(f"擋下:標準答案集(goldset)讀不到或格式不對: {e}", file=sys.stderr)
            return 2
    else:
        rp = str(code_file)
        if os.path.isabs(rp):
            rp = os.path.relpath(rp, str(repo_root))
        if not (repo_root / rp).exists():
            print(f"擋下:這個程式檔不存在: {rp}", file=sys.stderr)
            return 2
        files = [rp]

    # 節點文字/鄰接一次建(全庫 ~240 節點,單進程)
    texts = {}
    for node_rel in env.notes:
        try:
            texts[node_rel] = (env.vault / node_rel).read_text(encoding="utf-8-sig",
                                                               errors="replace")
        except OSError:
            texts[node_rel] = ""
    stems = {rel: Path(rel).name for rel in texts}
    def _resolve(name):
        name = name.strip()
        for rel in texts:
            if rel == name or rel == name + ".md" or Path(rel).stem == name:
                return rel
        return None
    adj = {rel: {} for rel in texts}   # rel -> {nbr: set(edge_types)}
    _WIKI = re.compile(r"\[\[([^\]|#]+)")
    for rel, note in env.notes.items():
        edges = []
        for fld in ("related", "plan_refs", "verified_by"):
            for v in as_list(note.fields.get(fld)):
                m = _WIKI.match(str(v)) or re.match(r"(.+)", str(v).strip("[]\" "))
                tgt = _resolve(m.group(1)) if m else None
                if tgt:
                    edges.append((tgt, fld))
        for m in _WIKI.finditer(texts[rel]):
            tgt = _resolve(m.group(1))
            if tgt:
                edges.append((tgt, "body-wikilink"))
        for tgt, ty in edges:
            if tgt == rel:
                continue
            adj[rel].setdefault(tgt, set()).add(ty)
            adj[tgt].setdefault(rel, set()).add(ty)   # 單跳雙向

    out_all = []
    for rel_file in files:
        pairs = _impact_reverse_lookup(rel_file, env, repo_root)
        direct = {n for n, _h in pairs}
        base = Path(rel_file).name
        stem = Path(rel_file).stem
        stem_ok = len(stem) >= 6 and ("_" in stem or "-" in stem)
        cands = {}
        # D1
        for rel, text in texts.items():
            if rel in direct:
                continue
            ev = []
            for _no, ln in _visible_lines(text.split("\n"), keep_fenced=False):
                probe = INLINE_CODE_RE.sub("", ln)
                if rel_file in probe or base in probe or (stem_ok and stem in probe):
                    ev.append(ln.strip()[:120])
            if ev:
                cands[rel] = {"node": rel, "signal": "plain-text",
                              "evidence": ev[:3], "via": []}
        # D2
        for d in direct:
            d_stem = _lc_strip_stem(d)
            for nbr, types in adj.get(d, {}).items():
                if nbr in direct:
                    continue
                hit_a = _lc_lcs_cjk(_lc_strip_stem(nbr), d_stem) >= 4
                hit_b = bool(types & {"plan_refs", "verified_by"})
                if hit_a or hit_b:
                    c = cands.get(nbr)
                    if c:
                        c["signal"] = "both"
                        if d not in c["via"]:
                            c["via"].append(d)
                    else:
                        cands[nbr] = {"node": nbr, "signal": "neighbor-family",
                                      "evidence": [], "via": [d]}
        result = {"file": rel_file,
                  "candidates": sorted(cands.values(), key=lambda c: c["node"])}
        out_all.append(result)
        if not as_json:
            print(f"link-candidates {rel_file}: {len(result['candidates'])} 筆候選"
                  f"(direct {len(direct)} 已去重)")
            if not result["candidates"]:
                print("  無")
            for c in result["candidates"]:
                via = f"  via {','.join(c['via'])}" if c["via"] else ""
                ev = f"  「{c['evidence'][0][:60]}」" if c["evidence"] else ""
                print(f"  [{c['signal']}] {c['node']}{via}{ev}")
    if as_json:
        print(json.dumps(out_all[0] if code_file else out_all, ensure_ascii=False))
    if not as_json:
        print("  ★唯讀候選,不寫檔;補引用=人裁後的正常圖譜編輯(人閘省不掉)★")
    return 0




# ═══ diff 變異測試(S4,plan:驗證層去模型化;「植針考測試」取代「植針考人」)═══





# ⛔ mutate 家族已退場(2026-08-26,詳 Projects/建了沒人跑批次裁定_計劃:消費者 2026-08-08 已裁死、治理帳 0 次;復活=有真消費者立案從 git 史撿回)


def cmd_seat_check(report, dispatch, ledger=None, as_json=False):
    """[S1 有講沒做對帳,2026-08-06](plan:Projects/驗證層自證三件_計劃;borrow evidra
    protocol_violation)。收貨第三道(前兩道=quote-check/refcheck 既有直用):
    - unreported = dispatch 宣告的 materials 在報告零觸及(路徑/檔名字串機械比對;
      `lens` 為觀測欄位★不進判定★——抽象詞無機械 oracle,plan r2 折入)
    - out_of_scope = 報告引句(「引句：「…」」抽取,同 quote-check 單一實作)錨不進
      ★任何一份★ material(scope 三集合:materials=必查;repo 查證引用恆合法——本檢查
      只驗引句錨定,不碰 file:line 證據;引句出界才記越界)
    - materials 為空 → vacuous 豁免(不判兩類)
    恆 rc0(觀測不擋,升閘須另過 loop);輸入壞損 rc2 fail loud。--ledger 時 out_of_scope
    逐條 append {round,seat,quote,reason}(越界另記一本、不進收斂帳)。
    ★射程:測的是報告與留痕的協議內一致性——席一致地說謊(引句自編但恰好錨得進)抓不到★"""
    import json
    try:
        rtext = Path(report).read_text(encoding="utf-8")
        disp = json.loads(Path(dispatch).read_text(encoding="utf-8"))
        materials = disp.get("materials") or []
        assert isinstance(materials, list)
    except (OSError, UnicodeDecodeError, ValueError, AssertionError) as e:
        print(f"擋下:審查報告或派工單讀不到: {e}", file=sys.stderr)
        return 2
    out = {"report": str(report), "round": disp.get("round"), "seat": disp.get("seat"),
           "lens": disp.get("lens"), "unreported": [], "out_of_scope": [], "vacuous": False}
    if not materials:
        out["vacuous"] = True
        if as_json:
            print(json.dumps(out, ensure_ascii=False))
        else:
            print("seat-check: 派工單沒列任何要查的材料,沒東西可對(vacuous 豁免,不判漏查或出界)")
        return 0
    mat_texts = {}
    for mp in materials:
        try:
            mat_texts[mp] = _quote_norm(Path(mp).read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError):
            mat_texts[mp] = None   # 材料讀不到:不能當被觸及,也不能當錨定海;記 unreported 候選
    # ① unreported:material 的路徑或檔名都沒出現在報告文字
    for mp in materials:
        name = Path(mp).name
        if mp not in rtext and name not in rtext:
            out["unreported"].append(mp)
    # ② out_of_scope:引句錨不進任何 material(空白剝除 fallback 同 _quote_rows)
    quotes = _quote_rows(rtext, "") or []
    for q in quotes:
        if q.get("malformed"):
            continue
        nq = _quote_norm(q["quote"])
        anchored = any(h is not None and (nq in h or nq.replace(" ", "") in h.replace(" ", ""))
                       for h in mat_texts.values())
        if not anchored:
            out["out_of_scope"].append(q["quote"])
    if ledger and out["out_of_scope"]:
        try:
            with open(ledger, "a", encoding="utf-8") as f:
                for q in out["out_of_scope"]:
                    f.write(json.dumps({"round": disp.get("round"), "seat": disp.get("seat"),
                                        "quote": q, "reason": "引句錨不進任何派工 material"},
                                       ensure_ascii=False) + "\n")
        except OSError as e:
            print(f"擋下:出界引句的記錄寫不進去: {e}", file=sys.stderr)
            return 2
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
    else:
        print(f"seat-check {Path(report).name}: 派工要查但報告沒碰 unreported {len(out['unreported'])}"
              f" / 引句超出派工範圍 out_of_scope {len(out['out_of_scope'])}(派工材料 {len(materials)} 份;只觀測不擋)")
        for mp in out["unreported"]:
            print(f"  ⚠ unreported: {mp}(派工單說要查這份,報告裡一個字都沒提到)")
        for q in out["out_of_scope"]:
            print(f"  ⚠ out_of_scope: 「{q[:50]}」(這句引言不在派工的任何一份材料裡{';已記進出界帳' if ledger else ''})")
        print("  (這項只觀測不擋:看的是報告有沒有照派工單走,不評審查角度;引 file:line 當證據一律算合法)")
    return 0


def enforcement_status(root=None, home=None):
    """回各層防護「現在有沒有生效」的清單 [{layer, status, detail}](Projects/enforcement儀表板_計劃)。
    純唯讀、每層各自 try 包住(一層測不出來不拖垮整份;fail-open 本身要能被觀測)。
    status: active | inactive | degraded | unknown | registered-trust-unknown(只有 Codex hook 列會出:
    已註冊、檔在,但要人在互動 codex 審過才跑、本機讀不到——不進 summary 分母)。root=repo 根、home=~/(測試可注入)。"""
    import json as _json
    if root:
        root = Path(root)
    else:
        for cand in (Path.cwd(), *Path.cwd().parents):   # cwd 逐層向上找 .git(同 _anchor_repo_root 慣例)
            if (cand / ".git").exists():
                root = cand
                break
        else:
            root = Path.cwd()
    home = Path(home) if home else Path.home()
    rows = []

    def add(layer, status, detail=""):
        rows.append({"layer": layer, "status": status, "detail": detail})

    # ①②③ 全域 Claude hooks 註冊(讀 ~/.claude/settings.json)
    reg = {}
    try:
        sp = home / ".claude" / "settings.json"
        if sp.exists():
            d = _json.loads(sp.read_text(encoding="utf-8"))
            for ev, arr in (d.get("hooks") or {}).items():
                for grp in arr:
                    for hk in (grp.get("hooks") or []):
                        reg[str(hk.get("command", ""))] = True
    except Exception as e:
        reg = None  # 讀不到 settings → 三 hook 皆 unknown
    # ★r1 審:註冊了不等於生效★——還要目標 .py 真的在 ~/.claude/hooks/(懸空註冊是 _prune_dangling 存在的原因,
    # 2026-07-07 事故)。★r1 審:_GLOBAL_CLAUDE_HOOKS 有 4 支,原本漏檢 ci-status(CI 紅燈後備網)★。
    hookdir = home / ".claude" / "hooks"
    for layer, needle in (("session-entry-hook", "lumos-entry-hook.py"),
                          ("pretooluse-impact-hook", "impact-hook.py"),
                          ("stop-graph-sync-hook", "check-graph-sync.py"),
                          ("sessionstart-ci-status-hook", "ci-status-hook.py"),
                          ("pretooluse-dispatch-lens-hook", "dispatch-lens-hook.py"),
                          # ★這份清單是寫死列舉的,加 hook 一定要回來加一行★
                          # (2026-09-14 代碼審 r1 架構對齊席 major:記憶清掃那支漏登記,
                          #  於是它逾時、出錯、靜默失效,整個工具鏈都不會有任何感知)
                          ("sessionstart-memory-sweep", "memory-sweep.py")):
        if reg is None:
            add(layer, "unknown", "~/.claude/settings.json 讀不到")
            continue
        registered = any(needle in cmd for cmd in reg)
        file_ok = (hookdir / needle).exists()
        if registered and file_ok:
            # ★生效 ≠ 有註冊★(#19 S4):還要「現在的這個版本最近真的成功跑完過」。
            # 沒有近期成功不標 inactive——那可能只是七天內沒被觸發。
            _lv, _why = _hook_recent_ok(root, layer, hookdir / needle)
            if _lv == "ok":
                add(layer, "active", f"{needle};{_why}")
            else:
                add(layer, "stale" if _lv == "stale" else "unknown", f"{needle};{_why}")
        elif registered and not file_ok:
            add(layer, "degraded", f"{needle} 已註冊但檔案不在 ~/.claude/hooks/(懸空)")
        else:
            add(layer, "inactive", needle)

    # ③b Codex 側(Projects/Codex完全支援_計劃 S0-4):每支 hook 一列,值域
    # registered-trust-unknown | degraded | inactive | unknown——★不出 active★:Codex 的 hook 要人在互動畫面
    # 審過才跑,信任狀態本機讀不到(信任存放處沒查出來),所以最多只能說「已註冊、檔在」。
    # 判準單源=_codex_present(只看家目錄,不看 PATH):結果跟 HOME 隔離的測試一致。
    _ch = _codex_home(home)
    codex_ok = _codex_present(home)          # 與 install/teardown 同一判準
    creg = {}
    try:
        cp = _ch / "hooks.json"
        if cp.exists():
            d = _json.loads(cp.read_text(encoding="utf-8"))
            for ev, arr in (d.get("hooks") or {}).items():
                for grp in arr:
                    for hk in (grp.get("hooks") or []):
                        creg[str(hk.get("command", ""))] = True
    except Exception:
        creg = None
    chookdir = _ch / "hooks"
    for layer, needle in (("codex-session-entry-hook", "lumos-entry-hook.py"),
                          ("codex-pretooluse-impact-hook", "impact-hook.py"),
                          ("codex-stop-graph-sync-hook", "check-graph-sync.py"),
                          ("codex-sessionstart-ci-status-hook", "ci-status-hook.py"),
                          ("codex-subagentstart-dispatch-lens-hook", "dispatch-lens-hook.py")):
        if not codex_ok:
            # 不適用而非壞掉:標 unknown 才不會讓每 session 的入口 hook 對沒裝 Codex 的機器一直唸
            add(layer, "unknown", "本機無 codex,不適用(裝了再跑 lumos install --force)")
            continue
        if creg is None:
            add(layer, "unknown", f"{_ch / 'hooks.json'} 讀不到")
            continue
        registered = any(needle in cmd for cmd in creg)
        file_ok = (chookdir / needle).exists()
        if registered and file_ok:
            add(layer, "registered-trust-unknown", f"{needle} 已註冊、檔在;要不要跑由你在互動 codex 審過 hook 才算數,本機讀不到")
        elif registered and not file_ok:
            add(layer, "degraded", f"{needle} 已註冊但檔案不在 {chookdir}/(懸空)")
        else:
            add(layer, "inactive", needle)
    try:
        ver = ""
        if codex_ok:
            r = subprocess.run(["codex", "--version"], capture_output=True, text=True, timeout=10)
            ver = (r.stdout or r.stderr).strip().split("\n")[0]
        add("codex-cli", "active" if ver else "unknown",
            (ver + ";地基事實在 codex-cli 0.144.1 與 0.153.2 上實測(信任閘/密文兩版相同;自訂 agent 0.153.2 起選得中),其他版本要重驗 hook 行為") if ver else "本機無 codex,不適用")
    except Exception as e:
        add("codex-cli", "unknown", str(e))

    # ③b' Codex 自訂審查席 TOML(d6;每樣裝的東西都有一列——code-codex-d6 r1 架構席)
    try:
        if not codex_ok:
            add("codex-agent", "unknown", "本機無 codex,不適用")
        else:
            miss, foreign, ok = [], [], []
            for nm, _ in _CODEX_SEATS:
                af = _ch / "agents" / f"{nm}.toml"
                if not af.exists():
                    miss.append(nm)
                elif _CODEX_AGENT_MARK in af.read_text(encoding="utf-8", errors="replace"):
                    ok.append(nm)
                else:
                    foreign.append(nm)
            if foreign:
                add("codex-agent", "degraded", f"agents/{'、'.join(foreign)}.toml 是別人的檔(無 lumos 標記),lumos 不覆蓋")
            elif miss:
                add("codex-agent", "inactive", f"少了審查席 {'、'.join(miss)}(lumos install --force 會寫)")
            else:
                add("codex-agent", "active", f"三席都在:{_CODEX_AGENT_NAME}(散文審 {_CODEX_SEAT_MODEL}+medium)、{_CODEX_AGENT_CODE_NAME}(程式碼審 {_CODEX_SEAT_MODEL}+xhigh)、{_CODEX_AGENT_MAX_NAME}(高風險 {_CODEX_SEAT_MODEL}+xhigh);0.153.2 實測選得中、0.144.1 忽略;唯讀仍靠父代理沙盒")
    except Exception as e:
        add("codex-agent", "unknown", str(e))

    # ③c skills 兩層(對稱;r1 整合 F6):使用者層目錄裡有沒有 lumos-* 連結/目錄
    for layer, sk in (("claude-skills", home / ".claude" / "skills"), ("codex-skills", home / ".agents" / "skills")):
        try:
            if layer == "codex-skills" and not codex_ok:
                add(layer, "unknown", "本機無 codex,不適用")
                continue
            have = [p.name for p in sk.iterdir() if p.name.startswith("lumos-")] if sk.is_dir() else []
            add(layer, "active" if have else "inactive", f"{len(have)} 支 lumos-* 在 {sk}" if have else f"{sk} 無 lumos-* skill")
        except Exception as e:
            add(layer, "unknown", str(e))

    # ③d Codex 指示檔(AGENTS.md / AGENTS.override.md):區塊在、版本戳與 CLAUDE.md 一致
    try:
        aname = _agents_target(root)
        ap = root / aname
        cmp_ = root / "CLAUDE.md"
        if not ap.exists():
            add("agents-md", "unknown" if not codex_ok else "inactive", f"無 {aname}(lumos init/update 會注入)" + ("" if codex_ok else ";本機無 codex,不適用"))
        else:
            def _ver_of(path):
                b = path.read_bytes()
                if b.startswith(b"\xef\xbb\xbf"):
                    b = b[3:]
                return _parse_sentinel_version(b.decode("utf-8", "replace").replace("\r\n", "\n"))
            av = _ver_of(ap)
            cv = _ver_of(cmp_) if cmp_.exists() else None
            if av is None:
                add("agents-md", "inactive", f"{aname} 無紀律區塊(lumos update 注入)")
            elif cv is not None and av != cv:
                add("agents-md", "degraded", f"{aname} 版本戳 {av} ≠ CLAUDE.md {cv}(lumos update 刷新)")
            else:
                add("agents-md", "active", f"{aname} 版本戳 {av}" + ("(override 檔:同層 AGENTS.md 會被 Codex 忽略)" if aname.endswith("override.md") else ""))
    except Exception as e:
        add("agents-md", "unknown", str(e))

    # ④⑤ git pre-commit / pre-push:core.hooksPath 指向 scripts/hooks 且檔存在可執行
    try:
        hp = subprocess.run(["git", "-C", str(root), "config", "core.hooksPath"],
                            capture_output=True, text=True, errors="replace", timeout=10).stdout.strip()
    except Exception:
        hp = ""
    for layer, fn in (("git-pre-commit", "pre-commit"), ("git-pre-push", "pre-push")):
        try:
            f = root / "scripts" / "hooks" / fn
            ok = _hooks_path_is_ours(root, hp) and f.is_file() and os.access(str(f), os.X_OK)
            add(layer, "active" if ok else "inactive",
                f"core.hooksPath={hp or '(未設)'};{fn} {'在' if f.is_file() else '缺'}")
        except Exception as e:
            add(layer, "unknown", str(e))

    # ⑥ python
    try:
        add("python", "active", sys.version.split()[0])
    except Exception as e:
        add("python", "unknown", str(e))

    # ⑦ vendored 版本——★r1 審:_version_nudge 回 None 有四種(無 CLAUDE.md/無版本戳/來源不可達/真最新),
    # 原本全當 active 會讓「沒裝 lumos 的專案」假綠。改成先自查前提,分不清就 unknown,不假綠。★
    try:
        cm = root / "CLAUDE.md"
        if not cm.exists():
            add("vendored-cli", "unknown", "無 CLAUDE.md,無法判版本(非 lumos 專案?)")
        else:
            txt = cm.read_bytes()
            if txt.startswith(b"\xef\xbb\xbf"):
                txt = txt[3:]
            ver = _parse_sentinel_version(txt.decode("utf-8", "replace").replace("\r\n", "\n"))
            if ver is None:
                add("vendored-cli", "unknown", "CLAUDE.md 無版本戳(未接圖譜紀律區塊?)")
            else:
                # ★r2 審:_version_nudge 回 None 有兩種——「來源 clone 不可達」與「真的最新」,不能都當 active★。
                # 先自查來源可達性(同 _version_nudge 內部條件):不可達 → unknown(乾淨機器/CI 沒 clone 時別假綠)。
                src_lumos = _lumos_src() / "scripts" / "lumos"
                if not src_lumos.exists():
                    add("vendored-cli", "unknown", f"版本戳 {ver},但來源 clone 不可達,無法比對是否落後")
                else:
                    lag = _version_nudge(root)
                    add("vendored-cli", "degraded" if lag else "active", lag or f"版本戳 {ver},與來源比對未落後")
    except Exception as e:
        add("vendored-cli", "unknown", str(e))

    # ⑧ CI workflow
    try:
        ci = list((root / ".github" / "workflows").glob("*.yml")) if (root / ".github" / "workflows").exists() else []
        add("ci-workflow", "active" if ci else "inactive",
            ", ".join(p.name for p in ci) or "無 .github/workflows/*.yml")
    except Exception as e:
        add("ci-workflow", "unknown", str(e))

    # ⑨ anchor baseline(有 baseline 且全符=active;有 baseline 但 mismatch=degraded;無 baseline=inactive)
    try:
        bp = root / _ANCHOR_BASELINE_REL
        if not bp.exists():
            add("anchor-baseline", "inactive", "無 baseline(裁判防竄改未啟用)")
        else:
            import hashlib as _hl
            data = _json.loads(bp.read_text(encoding="utf-8"))
            bad = 0
            for rel, expected in (data.get("anchors") or {}).items():
                f = root / rel
                if not f.is_file() or _hl.sha256(f.read_bytes()).hexdigest() != expected:
                    bad += 1
            add("anchor-baseline", "active" if bad == 0 else "degraded",
                f"{len(data.get('anchors', {}))} 個錨點" + (f",{bad} 個不符" if bad else "全符"))
    except Exception as e:
        add("anchor-baseline", "unknown", str(e))

    # ⑩ 遠端 GitHub 設定:本機測不到,誠實留 unknown(要真查需接 gh API,零依賴+離線優先故不做)
    add("required-status-check", "unknown", "GitHub required check / branch protection 本機測不到")

    return rows


def enforcement_summary(rows):
    """回 (active 數, 非 unknown 總數, unknown 數)。分母排除 unknown;
    ★也排除 registered-trust-unknown★(Codex hook 已註冊但要人審過才跑、本機讀不到——既不算生效也不算壞,
    算進分母會讓摘要永遠紅;它在列表裡用 🔒 單獨可見)。"""
    # ★stale 跟 unknown 同一族:不確定,別冤枉★(2026-09-08 r1 架構席 major)。
    # 漏排它的話,「近期沒被觸發」會被算進分母當成沒生效,摘要永遠偏悲觀
    # ——那正是這個排除清單當初為 registered-trust-unknown 設立的同一個道理。
    unknown = sum(1 for r in rows if r["status"] in ("unknown", "registered-trust-unknown", "stale"))
    total = len(rows) - unknown
    active = sum(1 for r in rows if r["status"] == "active")
    return active, total, unknown


def cmd_enforcement(repo=None, as_json=False):
    """印各層防護現在有沒有生效。純唯讀。rc0 恆(唯讀查詢不判成敗;要判用各層自己的閘)。"""
    import json as _json
    if repo is not None and not Path(repo).is_dir():   # r1 審:typo'd --repo 別靜默印全 inactive
        print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
        return 2
    rows = enforcement_status(root=repo)
    if as_json:
        active, total, unknown = enforcement_summary(rows)
        print(_json.dumps({"rows": rows, "active": active, "total": total, "unknown": unknown}, ensure_ascii=False))
        return 0
    mark = {"active": "✅", "inactive": "❌", "degraded": "⚠️", "unknown": "❔",
            "registered-trust-unknown": "🔒", "stale": "🕰"}   # 新增值域要同步加圖示,不然落到 '?'(r1 架構席)
    print("Lumos 防護生效狀態(這查的是「有沒有裝上/接上」,不是「判得對不對」)\n")
    for r in rows:
        print(f"  {mark.get(r['status'], '?')} {r['layer']:26s} {r['status']:24s} {r['detail']}")
    active, total, unknown = enforcement_summary(rows)
    trust = sum(1 for r in rows if r["status"] == "registered-trust-unknown")
    print(f"\n有效防護:{active}/{total} 層生效" + (f"(另 {unknown - trust} 層本機測不到或不適用,列 unknown)" if unknown - trust else "")
          + (f"(另 {trust} 層 Codex hook 已註冊;有沒有按過信任本機測不到,沒按過就不會跑)" if trust else ""))
    if active < total:
        print("有沒生效的層 → 在專案根跑一次\n    lumos install --force\n  (仍 inactive 的看 detail;遠端檢查那項要去 GitHub 設 branch protection)")
    return 0


def _anchor_blocked(repo_root, mismatches, extra_msgs):
    """錨點擋下人的那一刻落一筆 hard 帳(#19 S1)。★這道永遠不可跳★——
    它是「裁判有沒有被換掉」那一層,跳掉它之後所有「測試綠」的結論都不可信。"""
    bits = []
    if mismatches:
        bits.append("%d 個驗證器檔跟基準線不一樣:%s" % (len(mismatches), ", ".join(
            (m if isinstance(m, str)
             else str(m.get("file") or m.get("path") or m))[:60] for m in mismatches[:4])))
    if extra_msgs:
        bits.append(";".join(str(x)[:80] for x in extra_msgs[:3]))
    _gate_event_or_warn(repo_root, "anchor", "blocked", "|".join(bits) or "anchor verify 失敗",
                        hard=True)


def cmd_anchor_verify(repo=None, as_json=False):
    """錨點完整性核對:baseline 內每個錨點檔算 sha256 比對。
    全符 rc=0;mismatch/缺檔 rc=1;baseline 不存在 rc=0+警示(漸進採用);參數錯 rc=2。
    只證「驗證器檔案沒被動過」,不證測試本身寫得對(spec 誠實天花板)。"""
    import json
    import hashlib
    repo_root = _anchor_repo_root(repo)
    if repo_root is None:
        return 2
    bp = repo_root / _ANCHOR_BASELINE_REL
    if not bp.exists():
        print("anchor: 還沒有基準線,驗證器防竄改檢查未啟用——建立後才生效:\n    lumos anchor approve --note \"理由\"")
        return 0
    try:
        data = json.loads(bp.read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        print(f"擋下:基準線檔讀不到: {e}", file=sys.stderr)
        return 2
    mismatches = []
    # ★集合檢查:偷偷多一支 hook 檔,至少要留下一種痕跡★(2026-09-06 全 repo 審視 #6)
    # 原本只逐條比對「清單裡有的檔」,所以在 scripts/hooks 底下新增一支從來沒人看。
    # ★誠實講清楚這條買到什麼★:它買到的是「無聲新增」變成有聲——不是防線。
    # 真正的攻擊者在你 checkout 的那一刻碼就已經跑過了,這條只保證事後對得出帳。
    _extra_msgs = []
    try:
        # ★用檔案系統當真相來源,不是版控★(第一版寫成 git ls-files,結果「hook 存在但沒
        # git add」時會誤報成「登記過但檔案不在了」——而逐檔比對那半看的是檔案系統,
        # 兩個來源混用就會互相打架。而且沒進版控的 hook 照樣會自動跑,它才是這條要盯的東西。)
        _hooks_dir = repo_root / "scripts" / "hooks"
        _present = set()
        if _hooks_dir.is_dir():
            for _f in _hooks_dir.rglob("*"):
                if not _f.is_file():
                    continue
                # 排除規則:編譯產物與編輯器/系統雜檔。★這是「不可能被註冊成 hook 的東西」★,
                # 不是「看起來無害的東西」——外家審查席 r1 指出兩個方向的問題:
                #   ① 排太多會變成躲藏處(所以只排編譯產物與已知雜檔,不排「副檔名不像 hook」的);
                #   ② 排太少會變成噪音(編輯器暫存檔一存就翻紅,守衛會被人關掉)。
                # ★不准用「目錄名」當排除依據★(2026-09-07 通才審查席重現):
                # 第一版寫「路徑任一段等於 __pycache__ 就跳過」,結果**把檔案放進一個
                # 名字叫 __pycache__ 的目錄就完全隱形**——實測:藏一支普通的 .py 進去,
                # verify 照樣印綠。排除清單一旦看目錄名,它自己就變成躲藏處。
                # 改成只看副檔名:真的位元碼快取本來就是 .pyc,照樣排掉;
                # 藏在那個目錄裡的 .py / .sh 則會被點名。
                _name = _f.name
                if (_f.suffix in (".pyc", ".pyo", ".swp", ".swo", ".orig", ".rej", ".bak")
                        or _name in (".DS_Store", "Thumbs.db")
                        or _name.endswith("~")):
                    continue
                _present.add(str(_f.relative_to(repo_root)))
        _listed = {k for k in data.get("anchors", {}) if k.startswith("scripts/hooks")}
        _new = sorted(_present - _listed)
        _gone = sorted(_listed - _present)
        if _new:
            _extra_msgs.append(f"scripts/hooks 底下多了 {len(_new)} 支沒登記的檔:{', '.join(_new)}")
        if _gone:
            _extra_msgs.append(f"登記過但檔案不在了:{', '.join(_gone)}")
    except OSError:
        pass    # 不在 git 專案裡 / 沒有 git → 這條檢查跳過,不影響逐條比對

    for rel, expected in sorted(data.get("anchors", {}).items()):
        f = repo_root / rel
        if not f.is_file():
            mismatches.append({"file": rel, "expected": expected, "actual": "(缺檔)"})
            continue
        actual = hashlib.sha256(f.read_bytes()).hexdigest()
        if actual != expected:
            mismatches.append({"file": rel, "expected": expected, "actual": actual})
    if as_json:
        print(json.dumps({"ok": not mismatches and not _extra_msgs, "mismatches": mismatches,
                          "roster": _extra_msgs}, ensure_ascii=False))
        if mismatches or _extra_msgs:
            _anchor_blocked(repo_root, mismatches, _extra_msgs)
            return 1
        return 0
    if _extra_msgs:
        print("✗ anchor verify 失敗——會自動執行的 hook 檔,登記的名單跟實際檔案對不上:")
        for _msg in _extra_msgs:
            print(f"  {_msg}")
        print("  這些檔是「你一打開資料夾就自動跑」的程式,所以名單本身也要對得上帳。")
        print("  確定是你自己加/刪的 → 把它加進 ANCHOR_FILES(scripts/lumos)再重新核可:")
        print("      lumos anchor approve --note \"為什麼多/少了這支 hook\"")
        if not mismatches:
            _anchor_blocked(repo_root, mismatches, _extra_msgs)
            return 1
    if mismatches:
        print("✗ anchor verify 失敗——驗證器(測試/檢查腳本)的內容跟上次核可的基準線不一樣:")
        for m in mismatches:
            act = m["actual"] if m["actual"] == "(缺檔)" else m["actual"][:16] + "…"
            print(f"  {m['file']}(期望 {m['expected'][:16]}… 實際 {act})")
        print("不是故意改的 → 用 git checkout 還原;是刻意改的 → 重新核可並留理由:\n    lumos anchor approve --note \"理由\"")
    else:
        print(f"✓ anchor verify — {len(data.get('anchors', {}))} 個驗證器檔案都跟基準線一致,沒被動過")
    if mismatches:
        _anchor_blocked(repo_root, mismatches, _extra_msgs)
        return 1
    return 0


def cmd_anchor_approve(repo=None, note=None, vault=None):
    """重算全部錨點 sha256 寫回 baseline + governance-log 留痕(anchor-approve 事件)。
    改錨點檔的唯一合法路徑;--note 必填(空理由=無資訊留痕)。"""
    import json
    import hashlib
    import datetime
    if not note or not note.strip():
        print("擋下:核可一定要帶 --note 寫理由,不然以後沒人知道為什麼改", file=sys.stderr)
        return 2
    repo_root = _anchor_repo_root(repo)
    if repo_root is None:
        return 2
    anchors, absent = {}, []
    for rel in ANCHOR_FILES:
        f = repo_root / rel
        if f.is_file():
            anchors[rel] = hashlib.sha256(f.read_bytes()).hexdigest()
        else:
            absent.append(rel)
    if absent:
        print(f"提醒:這些驗證器檔案不存在,沒列進基準線: {', '.join(absent)}")
    bp = repo_root / _ANCHOR_BASELINE_REL
    prev = {}
    if bp.exists():
        try:
            prev = json.loads(bp.read_text(encoding="utf-8")).get("anchors", {})
        except (OSError, ValueError):
            prev = {}
    changed = sorted({k for k in anchors if anchors[k] != prev.get(k)} | (set(prev) - set(anchors)))
    bp.parent.mkdir(parents=True, exist_ok=True)
    payload = {"version": 1, "anchors": anchors,
               "approved_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
               "note": note}
    bp.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    v = vault or find_vault(Path.cwd())
    if v is None:
        print("⚠ 無 vault:baseline 已寫,governance-log 留痕跳過")
    else:
        _append_governance_log(v, [{"gate": "anchor-approve", "kind": "approved",
                                    "hard": False, "nodes": changed, "note": note}])
    print(f"✓ anchor approve — {len(anchors)} 個錨點寫入 baseline({len(changed)} 個變更)")
    return 0


def _validate_repo_ref(repo_root, token, line, at_sha=None):
    """驗一條 repo 內檔案指涉:回 (status, excerpt)。status ∈ missing/line_out_of_range/ok。
    _refcheck_scan 與 check_regen_provenance(Check J 的 [src:] 驗證)共用——
    J-c 不得走 _refcheck_scan 抽取入口(inline-code 抽取 + top_dirs 靜默過濾會把假目錄放行,
    正是 J-c 要擋的幻覺;此 helper 直收已解析 path/line,無靜默過濾)。
    token 消毒(code-review blocker 修):空/絕對路徑/含 .. 一律 missing——top_dirs 過濾
    被拆掉時它隱含的安全性(空值/絕對/traversal 天然進不了 top_dirs)必須在此顯式補回,
    否則 [src: ]/[src:/etc/passwd]/[src:../..] 會 resolve 到 repo 外真實存在的路徑而判 ok。"""
    token = token.strip()
    from pathlib import PurePosixPath, PureWindowsPath
    if (not token
            or PurePosixPath(token).is_absolute() or PureWindowsPath(token).is_absolute()
            or ".." in PurePosixPath(token).parts):
        return "missing", ""
    # at_sha 給了就對那個 commit 的 git 樹驗,不看工作樹(表態閘 2026-09-09,r3 架構對齊席 A3:同一件事同一個入口,
    # 別在 code-loop 那邊另造一套);三態語意(missing/line_out_of_range/ok)兩條路一致。
    if at_sha:
        if not _git_tree_has(repo_root, at_sha, token):
            return "missing", ""
        if not line:
            return "ok", ""
        txt = _git_tree_text(repo_root, at_sha, token)
        file_lines = txt.splitlines() if txt is not None else None
        if "-" in line:
            lo, hi = (int(x) for x in line.split("-", 1))
        else:
            lo = hi = int(line)
        if file_lines is None or lo < 1 or hi < lo or lo > len(file_lines) or hi > len(file_lines):
            return "line_out_of_range", ""   # r1 邊界席 f1:10-5 / 5-0 這種範圍以前會 IndexError 或負索引繞回
        return "ok", (file_lines[lo - 1] if lo == hi else file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1])
    target = repo_root / token
    if not target.exists():
        return "missing", ""
    if target.is_dir() or not line:
        return "ok", ""
    if "-" in line:
        lo, hi = (int(x) for x in line.split("-", 1))
    else:
        lo = hi = int(line)
    try:
        file_lines = target.read_text(encoding="utf-8-sig", errors="replace").splitlines()
    except OSError:
        file_lines = None
    if file_lines is None or lo < 1 or hi < lo or lo > len(file_lines) or hi > len(file_lines):
        return "line_out_of_range", ""
    if lo == hi:
        return "ok", file_lines[lo - 1]
    return "ok", file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1]


def _node_code_ref_tokens(text, top_dirs):
    """節點文字裡用反引號寫的程式路徑引用,回 (full, bare):
    full=含 / 且頂層目錄存在的 (token, 行號) 清單(依出現順序、去重,帶 :行號 的剝成第二欄);bare=不含 / 的裸 token 集合。
    ★refcheck、改檔前推筆記、每支檔有家三處共用這一支★——推筆記認得的,跟每支檔有家認得的,一定一樣
    (兩套算法一定分岔,而分岔時沒有東西會翻紅;Projects/每支檔有家_計劃 [S7])。"""
    _suffix_re = re.compile(r":([^/]+)$")
    # ★不可換回 FENCE_RE★(見 _visible_lines):此處餵 G1 硬閘與 impact hook
    spans = [s.strip("`") for s in INLINE_CODE_RE.findall(_strip_fences_text(text))]
    seen = set()
    full = []
    for raw in spans:
        if "://" in raw or any(c in raw for c in "*<>?"):
            continue
        m = _suffix_re.search(raw)
        if m:
            token, sfx = raw[:m.start()], m.group(1)
            line = sfx if re.fullmatch(r"\d+(?:-\d+)?", sfx) else ""
        else:
            token, line = raw, ""
        if "/" not in token or (token, line) in seen:
            continue
        if token.split("/")[0] not in top_dirs:
            continue
        seen.add((token, line))
        full.append((token, line))
    return full, {s for s in spans if "/" not in s}


def _refcheck_scan(text, repo_root):
    """refcheck 抽取+核對核心(不列印):回 (claims, n_missing, n_oor, n_ok)。
    cmd_refcheck 與 loop status --gate(G1 錨)共用;抽取規則見 cmd_refcheck docstring。
    核對段走 _validate_repo_ref(與 Check J 共用);抽取段(inline-code+top_dirs 過濾)維持原規則。"""
    top_dirs = {p.name for p in repo_root.iterdir() if p.is_dir() and not p.name.startswith(".")}
    full, _bare = _node_code_ref_tokens(text, top_dirs)
    claims = []
    for token, line in full:
        status, excerpt = _validate_repo_ref(repo_root, token, line)
        claim = {"token": token, "line": line, "status": status, "excerpt": excerpt}
        if status == "ok" and (repo_root / token).is_dir():
            claim["dir"] = True
        claims.append(claim)

    n_missing = sum(1 for c in claims if c["status"] == "missing")
    n_oor = sum(1 for c in claims if c["status"] == "line_out_of_range")
    n_ok = sum(1 for c in claims if c["status"] == "ok")
    return claims, n_missing, n_oor, n_ok


