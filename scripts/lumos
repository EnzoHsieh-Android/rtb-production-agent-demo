    color:#ffffff;                                     /* 醒目:不透明純白(2026-09-11 使用者要求;舊版半透明霧白在亮節點旁讀不到) */
    text-shadow:0 1px 4px rgba(0,0,0,.95),0 0 3px rgba(0,0,0,.95);  /* 細陰影 → 深色背景與亮節點上都讀得到 */
    transform:translate(-9999px,-9999px);will-change:transform,opacity;transition:opacity .18s}
  #panel{position:fixed;top:64px;right:0;bottom:0;width:460px;max-width:90vw;z-index:9;
    background:linear-gradient(180deg,var(--surface),#0c0e15);border-left:1px solid var(--border);
    box-shadow:var(--shadow);transform:translateX(102%);
    transition:transform .42s cubic-bezier(.16,1,.3,1);display:flex;flex-direction:column}
