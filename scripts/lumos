def cmd_new(env, ntype, name, today, plan=None, systems=None, code=None, responsibility=None):
    if ntype not in TEMPLATES:
        print(f"擋下:這個筆記類型工具不認得,沒建檔。可用的類型:{sorted(TEMPLATES)}", file=sys.stderr)
        return 2
    if "/" in name or "\\" in name or ".." in name or name.startswith("."):
        print(f"擋下:名稱不能有斜線、「..」或以點開頭,不然檔案可能跑到圖譜外面: {name}", file=sys.stderr)
        return 2
    # 一鍵雙向(2026-08-05 收尾優化):verification 建檔當下填 plan_refs+對面 verified_by——
    # 把「事後 sync-verified-by 撿漏」變「寫入時就對」。僅 verification 收這兩旗標。
    if (plan or systems) and ntype != "verification":
        print("擋下:--plan/--systems 只有建驗證紀錄(verification)時才能用,其他類型請拿掉", file=sys.stderr)
        return 2
    def _norm_rel(x):
        x = x.strip().removesuffix(".md")
        return x + ".md"
    # 每支檔有家(2026-09-11,[S19]):建檔當下就講清楚它管哪幾支檔、負責什麼——出生時就要切對。
    # ★全部先驗完才建檔★:建了一半才發現路徑錯,會留下一篇沒家的空殼。
    code = [c for c in (code or []) if str(c).strip()]
    if code and ntype not in ("system", "issue"):
        print("擋下:--code 只有 system(它管哪幾支檔)與 issue(事故發生在哪幾支檔)能用", file=sys.stderr)
        return 2
    if responsibility is not None and ntype != "system":
        print("擋下:--responsibility 只有 system 節點能用(一句話講這篇負責什麼、不負責什麼)", file=sys.stderr)
        return 2
    if responsibility is not None and not _nodehome_resp_ok(responsibility):
        print(f"擋下:--responsibility 要至少 {_NODEHOME_RESP_MIN_CHARS} 個字、要有實字——一句話講這篇負責什麼、不負責什麼", file=sys.stderr)
        return 2
    code_rels = []
    for c in code:
        relp, err = _about_code_path(env, c)
        if err:
            print(f"擋下:--code {err},沒建檔", file=sys.stderr)
            return 2
        if relp not in code_rels:
            code_rels.append(relp)
    sys_rels = [_norm_rel(x) for x in (systems.split(",") if systems else []) if x.strip()]
    plan_rels = [_norm_rel(x) for x in (plan.split(",") if plan else []) if x.strip()]
    for rel in sys_rels + plan_rels:
        if not (env.vault / rel).exists():
            print(f"擋下:你要連的 {rel} 還不存在,沒建檔——先把那篇建起來再回來連,免得只連一半", file=sys.stderr)
            return 2
    folder, tmpl = TEMPLATES[ntype]
    path = env.vault / folder / f"{name}.md"
    if path.exists():
        print(f"擋下:這個名字的筆記已經有了,沒重複建: {path}", file=sys.stderr)
        return 2
    # 圖譜入口栓 B(spec v3):比對集★寫檔前★收集——env.notes 載於啟動、天生不含新檔,
    # 防「建檔後重掃自比 1.0=100% 誤鳴」(EL-13);限 project/system/issue 三型
    # (Verification 實測 81% 檔名有 ≥0.6 鄰居=天天誤鳴,EL-7);只在同型別資料夾內比(EL-17);
    # 訊息建檔後印;fail-open:例外不得改 rc、不得影響建檔(EL-5)
    _el_near_sibs = []
    if ntype != "verification":
        try:   # ★fail-open:本 try 內禁止 sys.exit/SystemExit(except Exception 攔不到)★
            _pfx = folder + "/"
            for _rel in env.notes:
                if _rel.startswith(_pfx) and _rel.endswith(".md") and _rel.count("/") == 1:
                    _stem = Path(_rel).stem
                    _r = _el_near_ratio(_stem, name)
                    if _r >= _EL_NEAR_THRESHOLD:
                        _el_near_sibs.append((_r, _stem, _rel))
        except Exception:
            _el_near_sibs = []
    path.parent.mkdir(parents=True, exist_ok=True)
    fm = tmpl.format(today=today)
    _write_lf(path, f"---\n{fm}\n---\n# {name}\n")
    self_rel = f"{folder}/{name}.md"
    # 跟下面回掛那兩段同一套:被擋或寫入鎖逾時(丟例外)也要講「筆記建好了」、其餘項目照做完、最後彙總(代碼審 r1 架構席)
    rc_own = 0
    # 一次失敗只印一行:丟例外的把原因接在同一行,回傳非零的原因已由 append/set 自己印在上面(代碼審 r2 正確性席、邊界席)
    for relp in code_rels:
        try:
            _rc, _why = cmd_append(env, self_rel, "about_code", relp), "(上面有原因)"
        except (OSError, ValueError, RuntimeError) as e:
            _rc, _why = 2, f"({e})"
        if _rc != 0:
            print(f"提醒:筆記建好了,但 --code {relp} 沒寫進 about_code{_why},照原因補:\n    lumos append <節點> about_code {relp}", file=sys.stderr)
            rc_own = 2
    if responsibility is not None:
        try:
            _rc, _why = cmd_set(env, self_rel, "responsibility", responsibility.strip()), "(上面有原因)"
        except (OSError, ValueError, RuntimeError) as e:
            _rc, _why = 2, f"({e})"
        if _rc != 0:
            print(f"提醒:筆記建好了,但負責範圍沒寫成{_why},照原因補:\n    lumos set <節點> responsibility \"…\"", file=sys.stderr)
            rc_own = 2
    # 非跨檔交易(2026-08-05 單席快審 F1,誠實化):逐檔各自原子,中途失敗會留部分連結——
    # 前置存在檢查擋掉最常見失敗;殘餘(磁碟滿/權限)接住例外、指路 sync-verified-by 撿漏
    rc_side = 0
    for rel in plan_rels:
        try:
            rc_side |= cmd_append(env, self_rel, "plan_refs", f"[[{rel.removesuffix('.md')}]]")
        except (OSError, ValueError, RuntimeError) as e:   # 擋下與寫入鎖逾時也要講「筆記建好了」(第四輪架構席)
            print(f"提醒:筆記建好了,但幫你回掛到計劃 {rel} 的 plan_refs 沒寫成功: {e}", file=sys.stderr)
            rc_side = 2
    for rel in sys_rels:
        try:
            rc_side |= cmd_append(env, rel, "verified_by", f"[[{folder}/{name}]]")
        except (OSError, ValueError, RuntimeError) as e:   # 擋下(ValueError)也要講「筆記建好了」(r3 整合席)
            print(f"提醒:筆記建好了,但幫你回掛到 {rel} 的 verified_by 沒寫成功: {e}", file=sys.stderr)
            rc_side = 2
    if rc_side:
        print("提醒:筆記建好了,但自動補的反向連結有一部分沒成功,健檢會抓到。補救先跑:\n    lumos sync-verified-by --apply\n  再手動補上沒連到的 plan_refs", file=sys.stderr)
        return 2
    if rc_own:
        return 2
    print(f"✓ new {ntype}: 骨架建好了 {path.relative_to(env.vault)}")
    # 圖譜入口栓 B 告知段(建檔完成後印——事故裡貴的不是建檔,是之後燒掉的審查輪;spec EL-7/EL-12)
    try:
        for _r, _stem, _rel in sorted(_el_near_sibs, reverse=True)[:3]:
            print(f"  ★近名節點已存在:{_stem}({_el_node_meta(env, _rel)[0] or '?'}/決策 {_el_node_meta(env, _rel)[1]} 條)"
                  "——若同主題,先讀它再繼續;重複開案的成本在後頭★")
    except Exception:
        pass
    # [S13] 開了 Systems 節點卻沒說它管哪幾支檔:家從此是推筆記的入口,不管檔的節點永遠推不出來。
    # 不擋——真的有「主題篇」這種東西;但它該在負責範圍裡講明為什麼。
    if ntype == "system" and not code_rels:
        print("  提醒:這篇沒說它管哪幾支檔(about_code 是空的)。不管任何程式檔的節點通常是「主題」不是「模組」"
              "——改那些檔的時候,工具推不出這篇。")
        print("    lumos append <節點> about_code <檔>")
        print("  真的是主題篇,就在負責範圍裡講明它為什麼不管檔:")
        print("    lumos set <節點> responsibility \"<為什麼不管檔、它負責什麼>\"")
    for line in NEW_HINT.get(ntype, []):
        print(f"  {line}")
    print(f"  內容填完先檢查這一篇,再跑全圖健檢:\n    lumos lint {name}\n    lumos doctor\n  (寫法規範在 lumos-project-notes skill)")
    return 0


# ═══════════════════════ 階段三: archive(lumos 自做,單遍) ═══════════════════════

ARCHIVABLE = {"pass", "done", "superseded"}


def cmd_archive(env, days, apply, today):
    import os
    import datetime
    cutoff = (datetime.date.fromisoformat(today) - datetime.timedelta(days=days)).isoformat()

    # 「活守衛護欄」:一份 Verification 若還在提到某條 ★INVARIANT★ 綁定、且該測試仍存在於 code 的守衛,
    # 它的有效性是 CI 每次真機跑出來證明的、不是日曆決定的 → 不按年齡歸檔(否則把還在跑綠的守衛證據
    # 降級進 Archive,等於歸檔規則[天數]凌駕有效性規則[CI 綠燈])。守衛若被刪(測試不在 code)則照舊可歸檔。
    repo_root = None
    for p in env.vault.parents:
        if p.name == "docs":
            repo_root = p.parent
            break
    live_guard_tests = set()
    guard_re = None
    if repo_root is not None:
        # 多平台感知:每 invariant 依平台前綴解析,對其平台 root+profile 的 method set 判存活。
        # 收「存活的裸方法名」(非帶前綴的 ref)——guard_re 要在 Verification 文字裡搜方法名。
        _, split, default, methods_for, _hay = _platform_test_index(repo_root)
        for _n in env.notes.values():
            invs, _ = extract_contracts(_n)
            for inv in invs:
                try:
                    for plat, name in resolve_test_refs(inv, split, default):
                        if name in methods_for(plat):
                            live_guard_tests.add(name)
                except ValueError:
                    continue   # 未定義平台前綴:非有效綁定,不護
        if live_guard_tests:
            # 精確度對齊 Check T:用【詞界】比對方法名,不是 raw 子字串。
            # 否則短/前綴名(live `Pay` 命中散文 "Payment"、`Foo` 命中 `FooBar`)會
            # 假性護住無關 Verification → 它們永遠不歸檔(歸檔靜默失效)。
            # re.ASCII:方法名是 ASCII 識別字;否則 Python \b 視 CJK 為 \w,
            # 「守衛Pay跑」(中文緊貼方法名無空格)→ \b 不成立 → 漏護(under-protection,更危險)。
            guard_re = re.compile(r"\b(?:" + "|".join(map(re.escape, live_guard_tests)) + r")\b",
                                  re.ASCII)
    guards_all_dead = repo_root is not None and not live_guard_tests and any(
        invariant_test_refs(inv)
        for _n in env.notes.values() for inv in extract_contracts(_n)[0])

    cands = []       # (rel, stem, ym)
    protected = []   # (rel, [backs...]):早於 cutoff 但仍背書存活守衛
    for rel, n in sorted(env.notes.items()):
        if not rel.startswith("Verification/") or "/Archive/" in rel:
            continue
        if str(n.fields.get("status", "")) not in ARCHIVABLE:
            continue
        datestr = str(n.fields.get("created") or n.fields.get("date") or "")[:10]
        if not DATE_RE.match(datestr) or datestr > cutoff:
            continue
        # 活守衛護欄:這篇是否【詞界】提到任一條「測試仍存在」的綁定名 → 是則保留不歸檔
        if guard_re is not None:
            try:
                raw = (env.vault / rel).read_text(encoding="utf-8-sig")
            except Exception:
                raw = ""
            backs = sorted(set(guard_re.findall(raw)))
            if backs:
                protected.append((rel, backs))
                continue
        cands.append((rel, n.stem, datestr[:7]))

    print(f"lumos archive — vault: {env.vault}")
    print(f"  cutoff: {cutoff} (--days {days})  mode: {'APPLY' if apply else 'DRY-RUN(--apply 真執行)'}")
    if repo_root is None:
        print("  提醒:找不到專案根目錄,沒辦法查哪些驗證還有測試守著,這次只看年齡歸檔")
    if guards_all_dead:
        print("  提醒:合約綁的測試在程式碼裡一個都找不到(被刪了或根本沒綁),沒辦法判斷哪些驗證還有守衛"
              "(這不代表全部都能放心歸檔)")
    if protected:
        print(f"  活守衛護欄:{len(protected)} 篇早於 cutoff 但仍背書存活守衛(綁定測試還在 code)→ 保留不歸檔")
        for rel, backs in protected:
            print(f"      • {rel}  (backs: {', '.join(backs)})")
    print()
    if not cands:
        print("  無符合條件的 Verification(status∈{pass,done,superseded} 且早於 cutoff;已扣除活守衛護欄保留者)")
        return 0

    moved_stems = {stem for _, stem, _ in cands}
    # 計算每個被移檔的 path 式入連結(body + frontmatter 字串一起,raw text 掃)
    rewrite_plan = defaultdict(list)  # rel → [stem,...] 該檔內要正規化的 path 式連結
    for rel, n in env.notes.items():
        try:
            text = (env.vault / rel).read_text(encoding="utf-8-sig")
        except Exception:
            continue
        for stem in moved_stems:
            if re.search(r"\[\[Verification/" + re.escape(stem) + r"(?=[\]|#])", text):
                rewrite_plan[rel].append(stem)

    print(f"  將歸檔 {len(cands)} 篇:")
    for rel, stem, ym in cands:
        print(f"    • {rel} → Verification/Archive/{ym}/{stem}.md")
    n_links = sum(len(v) for v in rewrite_plan.values())
    print(f"\n  path 式入連結正規化(→ basename): {n_links} 處,分佈 {len(rewrite_plan)} 檔")
    for rel, stems in sorted(rewrite_plan.items()):
        print(f"    • {rel}: {', '.join(stems)}")
    if not apply:
        print("\n  (DRY-RUN,未動檔。basename 式入連結不受影響=移檔不斷)")
        return 0

    # 1) 先正規化連結(檔案還在原位)。順序=先 rewrite 後移檔:若中途失敗,
    #    已 rewrite 未移檔的檔其 basename 連結仍解析得到(檔還在 Verification/),狀態良性;
    #    且 re-run archive 會跳過已正規化的(無 path 式可改)只補移檔 → 可重入恢復。
    rewritten = 0  # 實際改寫處數(非計畫數;CRLF 跳過時不灌水,GAP-4)
    for rel, stems in sorted(rewrite_plan.items()):
        p = env.vault / rel
        raw = p.read_bytes()
        if raw.startswith(b"\xef\xbb\xbf") or b"\r\n" in raw:
            print(f"  ⚠ 跳過 rewrite(BOM/CRLF 慣例外,不靜默正規化): {rel}", file=sys.stderr)
            continue
        text = raw.decode("utf-8")
        for stem in stems:
            text, n_sub = re.subn(r"\[\[Verification/" + re.escape(stem) + r"(?=[\]|#])",
                                  "[[" + stem, text)
            rewritten += n_sub
        tmp = p.with_suffix(p.suffix + ".lumos-tmp")
        try:
            _write_lf(tmp, text)
            os.replace(tmp, p)
        finally:
            if tmp.exists():
                tmp.unlink()
    # 2) 移檔
    moved = 0
    for rel, stem, ym in cands:
        src = env.vault / rel
        dst_dir = env.vault / "Verification" / "Archive" / ym
        dst_dir.mkdir(parents=True, exist_ok=True)
        dst = dst_dir / f"{stem}.md"
        if dst.exists():
            print(f"  ⚠ 跳過(目標已存在): {dst}", file=sys.stderr)
            continue
        os.replace(src, dst)
        moved += 1
    print(f"\n  ✓ 歸檔 {moved} 篇,正規化 {rewritten} 處連結(計畫 {n_links})")
    return 0


# ═══════════════════════ main ═══════════════════════

def _refuse_if_probe(action):
    """探針沙盒事故防線(Issues/探針沙盒改動真全域機器狀態,2026-09-02):
    情境探針把 repo 複製到臨時沙盒、在裡面跑 claude -p,但那個 session 的 HOME 是真的 ~/,
    所以它(或它跑的任何子程序)一旦執行安裝/更新/卸載,會把真的 ~/.claude/skills 重新連到沙盒副本;
    沙盒清掉後全域 skills 全變懸空連結。2026-09-02 實際炸過一次(八個 skill 斷)。
    探針環境一律設 LUMOS_PROBE=1;這幾個會動全域機器狀態的指令在探針下直接拒絕。"""
    import os
    if os.environ.get("LUMOS_PROBE") == "1":
        print(f"擋下:偵測到 LUMOS_PROBE=1(情境探針沙盒),拒絕執行「{action}」——"
              f"這會把真的 ~/.claude 重連到臨時沙盒,沙盒一清就全斷。探針裡不該重裝工具鏈。", file=sys.stderr)
        return True
    return False


def cmd_install(force=False):
    """全域 lumos + user-scope skills(機器層一鍵)。Unix=symlink、Win=.cmd shim。"""
    import os
    if _refuse_if_probe("install"):
        return 2
    src = Path(__file__).resolve()
    bindir = Path.home() / ".local" / "bin"
    bindir.mkdir(parents=True, exist_ok=True)
    if _IS_WIN:
        shim = bindir / "lumos.cmd"
        # ★直譯器名稱在安裝當下偵測,不寫死 python★(2026-09-07 #7)。
        # ★這是「刻意複製一份 + 守衛盯著兩邊一致」,不是「呼叫既有那支」★
        # (2026-09-07 代碼審 r1 架構席:我原本的註解寫「不另造第二套」,但程式碼其實
        #  就是另打了一份——宣稱與事實不符)。真的不能呼叫:精簡版是獨立交付包,
        # 這支被 vendor 進消費端專案時 slim/ 根本不在,import 必炸。所以照這個 repo
        # 對 hook 那批的既有做法:複製一份、加一條測試盯住兩邊的候選順序與退回值一致
        # (t_windows_interpreter_pick_matches_slim)。判斷本身借的是
        # slim/install.py:_pick_windows_interpreter,那支的完整理由寫在它的說明裡:
        # 只有 python3.exe、沒有 python.exe 的 Windows 機器(某些官方安裝器 / 商店版)
        # 上,安裝會用 python3 跑完並印「裝好了」,但 shim 寫死呼叫 python,
        # 之後每次打 lumos 都是「'python' 不是可執行的命令」——裝完即壞,而且要等
        # 使用者真的去用才發現。寫命令名稱不寫絕對路徑的理由見那支的說明
        # (版本管理工具換 exe 是常態,絕對路徑撐不過升級)。
        import shutil as _shutil
        py_cmd = next((c for c in ("python3", "python") if _shutil.which(c)), "python")
        shim.write_text(f'@echo off\r\n{py_cmd} "{src}" %*\r\n', encoding="utf-8")
        print(f"✓ 安裝: {shim} → {py_cmd} {src}")
    else:
        dst = bindir / "lumos"
        if dst.is_symlink() and dst.resolve() == src:
            print(f"✓ 已安裝(symlink 正確): {dst} → {src}")
        elif dst.exists() or dst.is_symlink():
            if not force:
                cur = str(dst.resolve()) if dst.is_symlink() else "(一般檔案)"
                print(f"⚠ {dst} 已存在(→ {cur}),加 --force 覆寫", file=sys.stderr)
                return 2
            dst.unlink(); dst.symlink_to(src); print(f"✓ 覆寫安裝: {dst} → {src}")
        else:
            dst.symlink_to(src); print(f"✓ 安裝: {dst} → {src}")
    # 連帶裝 skills(r2-F1:機器層一鍵)
    print("裝 user-scope skills…")
    _install_skills()
    # 全域 ~/.claude hooks/settings 同步(install全域hook同步_計劃:全域機器自癒——
    # copy 現役 hooks + 刪已撤除 hook 殘留 + prune 懸空註冊;來源=來源 repo 自身)
    _src_repo = Path(__file__).resolve().parent.parent
    _states = {}
    for _h in ("claude", "codex"):            # r3:接上契約,別無條件印成功;三態各印各的(r2 邊界 N2)
        _states[_h] = _sync_global_hooks(_src_repo, _h)
        print(_sync_msg(_h, _states[_h]))
    # PATH 檢查(r1-F7:用 os.pathsep,Windows 是 ;)
    if str(bindir) not in os.environ.get("PATH", "").split(os.pathsep):
        hint = (f'  Windows:把 {bindir} 加進使用者 PATH(系統環境變數)'
                if _IS_WIN else f'  export PATH="$HOME/.local/bin:$PATH"')
        print(f"⚠ {bindir} 不在當前 PATH —\n{hint}", file=sys.stderr)
    else:
        print(f"  {bindir} 已在 PATH — 任何專案打 `lumos doctor` 即可")
    if any(v == "merge-failed" for v in _states.values()):   # hook 註冊沒寫進去,自動化不能當成功(r1 外家 #4)
        print("✗ install 未完成:hook 註冊寫不進去(見上面的 ⚠),修好設定檔再跑一次", file=sys.stderr)
        return 2
    return 0


def cmd_uninstall():
    """對稱移除 cmd_install 裝的東西:全域指令(Unix symlink / Win lumos.cmd)+ user-scope skills。"""
    import os, shutil
    if _refuse_if_probe("uninstall"):
        return 2
    removed = []
    bindir = Path.home() / ".local" / "bin"
    for name in ("lumos.cmd", "lumos"):          # Win shim + Unix symlink
        g = bindir / name
        if g.is_symlink():
            removed.append(f"{g}(symlink → {g.resolve()})"); g.unlink()
        elif g.exists():
            # 守衛(std F10,teardown一鍵拆機_計劃):同名一般檔不刪(可能是使用者別的工具);
            # 只有 symlink 才是我方 install 產物。避免 uninstall/teardown 誤刪非我方檔。
            print(f"  ⚠ {g} 是一般檔(非 symlink),保留不動——非 lumos 安裝物", file=sys.stderr)
    sk = Path.home() / ".claude" / "skills"      # 對稱 _install_skills:junction/symlink/複製夾都清
    for s in _SKILLS:
        d = sk / s
        if d.is_symlink():
            d.unlink(); removed.append(str(d))
        elif d.is_dir():
            try:
                os.rmdir(d)                       # junction/空夾:只移連結本身,不跟進 target(同 W4)
            except OSError:
                shutil.rmtree(d, ignore_errors=True)
            removed.append(str(d))
    shared = Path.home() / ".agents" / "skills"   # Codex 側(開放共用目錄):只收 symlink 與帶標記的複製物
    for s in _SKILLS:
        d = shared / s
        if d.is_symlink():
            d.unlink(); removed.append(str(d))
        elif d.is_dir():
            if (d / _SKILL_MARKER).exists():
                shutil.rmtree(d, ignore_errors=True); removed.append(str(d))
            else:
                try:
                    os.rmdir(d); removed.append(str(d))     # 空夾/junction
                except OSError:
                    print(f"  ⚠ {d} 不是 lumos 裝的(無標記檔),保留不動", file=sys.stderr)
    if removed:
        print("✓ 移除:\n  " + "\n  ".join(removed))
    else:
        print("✓ 未安裝(無全域 lumos / skills)")
    return 0


def _selfdelete_risk(root: Path) -> bool:
    """Windows 專屬:正在跑的這份 lumos 就是 root 底下那份 vendored copy 嗎?

    `_deinit_remove_vendored` 最後會刪 `scripts/lumos`——POSIX 上刪掉執行中的檔案
    無妨(所以刻意排最後),★但 Windows 不准刪執行中的檔案★,會拋 PermissionError,
    而那句 `p.unlink()` 沒有 try/except。後果不是「少刪一個檔」而是★半做★:走
    teardown 的話,①全域 hook 已清、②CLAUDE.md 已剝、閘已拆,才在這裡炸 traceback,
    ③uninstall 根本沒機會跑。使用者拿到一個拆一半又看不懂的狀態。

    這條路很容易走到:Windows 裝完要重開 session 才吃得到 PATH,拿不到 `lumos`
    這個指令的人自然會打 `python scripts\\lumos teardown`。

    ★只在 Windows 回 True★——POSIX 上這條路是合法且刻意支援的,不能一起擋掉。
    `LUMOS_SIMULATE_WINDOWS` 只是測試接縫(本機沒有 Windows 可驗)。
    """
    if not (_IS_WIN or os.environ.get("LUMOS_SIMULATE_WINDOWS") == "1"):
        return False
    try:
        me, r = Path(__file__).resolve().parts, root.resolve().parts
    except OSError:
        return False       # 路徑解不開(權限/壞連結)就不擋(never block on unknown)
    # ★保留不用 `Path.is_relative_to()` 的寫法★(原因是舊宣告 ≥3.8;2026-09-06 宣告訂正為 ≥3.9 後這行不再是硬約束,但既有寫法可用、不特意改)
    # (同檔 `_write_lf` 為了同一個理由避開 3.10 才有的 write_text(newline=))。
    # ★也不要把 except 放寬成 `except Exception`★:這道守衛的失敗模式是「回 False」,
    # 一旦把自己的程式錯誤(如 AttributeError)也吞掉,守衛就★靜默地等於不存在★
    # ——2026-08-02 代碼審 r2 抓到的正是這個組合。
    return len(me) > len(r) and me[:len(r)] == r


def cmd_teardown(yes=False, source=None):
    """一鍵拆機:當前 repo 專案層 + 機器全域(CLI/skills/hooks),★永遠保留圖譜文件★。
    範圍(std F11)=當前 repo + 機器全域,非全機所有 repo(別 repo 的注入/hooks、來源 clone 都留)。
    三步順序(std F5,全域先——趁 deinit 還沒刪掉 vendored merge):
      ①_teardown_global_claude ②cmd_deinit(keep_graph=True) ③cmd_uninstall。
    設計/審計:Projects/teardown一鍵拆機_計劃。"""
    import subprocess
    try:                                       # repo root(對稱 deinit,非 git 中止)
        # ★嚴格解碼★:這個路徑要拿去拆東西,換成替代字元等於猜路徑(見 cmd_deinit 同一段的說明)
        root = Path(subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True, errors="strict",
            stderr=subprocess.DEVNULL).strip())
    except UnicodeDecodeError:
        print("擋下:專案路徑裡有不是 UTF-8 的字元,為了不拆錯地方,不動手", file=sys.stderr)
        return 2
    except Exception:
        print("擋下:這裡不是 git 專案,拆除需要確定的專案根目錄,不會拿目前目錄猜", file=sys.stderr)
        return 2
    src = _lumos_src(source)
    if root.resolve() == src.resolve():
        print("擋下:你現在就在 Lumos 工具鏈的來源 repo 裡,不能在這裡拆它自己", file=sys.stderr)
        return 2
    if _selfdelete_risk(root):   # Windows 自刪(見 _selfdelete_risk)——在任何 mutation 之前擋
        print("擋下:Windows 上不能用專案自帶的那份 lumos 拆它自己"
              f"({Path(__file__).resolve()})——最後刪 vendored 時會刪到執行中的檔案,"
              "留下拆一半的狀態。", file=sys.stderr)
        print("  改用全域指令重跑:  lumos teardown", file=sys.stderr)
        print("  (若 PATH 還沒吃到,先重開一個終端;或直接用來源那份:"
              f"  python {src / 'scripts' / 'lumos'} teardown)", file=sys.stderr)
        return 2
    # 確認——★拒絕/取消前零 mutation★(std F13)
    if not yes:
        if not sys.stdin.isatty():
            print("擋下:這不是互動式終端、沒辦法問你確認,又沒加 --yes,不拆。確定要拆就加 --yes", file=sys.stderr)
            return 2
        print("teardown 將拆【當前 repo 專案層】(pre-commit/pre-push 閘、CLAUDE.md 注入、vendored 工具)")
        print("  +【機器全域】(~/.local/bin/lumos、user-scope skills、~/.claude 全域 hooks)。")
        print("  圖譜文件保留;scripts/hooks|templates 只刪 lumos 檔、你的自有檔保留(F9)。")
        print("  ⚠ 仍在的破壞性:剝 CLAUDE.md 注入會正規化 sentinel 外空白/換行;移除全部 lumos 家族")
        print("     skills(含各語言 *-idioms 慣例 skill,以 ls skills/ 為準;你名字不同的 skill 不碰)。")
        print("  (只拆當前 repo——別的 repo 與 bootstrap 來源 clone 不動。)")
        try:
            ans = input("確定? [y/N] ").strip().lower()
        except EOFError:
            # isatty() 在某些終端/Windows 回 True 但 stdin 其實 EOF → 讀不到確認。
            # 對齊 cmd_deinit 與 _confirm_tty 的既有硬化(同一現場,Windows 真機踩過):
            # 破壞性操作安全預設=拒絕(rc2,同上面非互動分支),不是往下做。
            # ★不要拿 --yes 當解法★——那等於跳過確認直接執行破壞性操作。
            print("擋下:等不到你的確認輸入,不拆。"
                  "確定要拆再加 --yes", file=sys.stderr)
            return 2
        if ans not in ("y", "yes"):
            print("已取消(未改動)。")
            return 0
    # 三步(全域先)
    print("① 全域 hook 清理…")
    _teardown_global_hooks(Path(__file__).resolve().parent.parent, "claude")
    _teardown_global_hooks(Path(__file__).resolve().parent.parent, "codex")
    print("② 拆專案層(deinit,保留圖譜)…")
    rc_deinit = cmd_deinit(keep_graph=True, yes=True, source=source)
    print("③ 拆機器 CLI/skills(uninstall)…")
    rc_uninstall = cmd_uninstall()
    print(f"✓ teardown 完成(deinit rc={rc_deinit} / uninstall rc={rc_uninstall};圖譜保留)。"
          "  重裝:bootstrap 或 install + init。")
    return 0


def cmd_deinit(keep_graph=False, dry_run=False, yes=False, source=None):
    """專案層反安裝(對稱 cmd_init):拆本 repo 的 pre-commit 閘 / vendored 工具組 /
    CLAUDE.md 注入區塊 /(預設)圖譜 vault。不碰機器共用項(~/.claude)。不自動 commit。"""
    import subprocess
    # root 走 git toplevel;非 git 目錄中止(不 fallback cwd——deinit 會刪檔)
    # ★嚴格解碼,不換字元★(2026-09-11 代碼審第三輪外家席):路徑的位元組不是 UTF-8 時,
    # 換成替代字元的路徑可能剛好是旁邊另一個已安裝的專案,後面就會刪掉★它的★圖譜。解不了就擋。
    try:
        root = Path(subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True, errors="strict",
            stderr=subprocess.DEVNULL).strip())
    except UnicodeDecodeError:
        print("擋下:專案路徑裡有不是 UTF-8 的字元,為了不刪錯地方,不動手", file=sys.stderr)
        return 2
    except Exception:
        print("擋下:這裡不是 git 專案,移除需要確定的專案根目錄,不會拿目前目錄猜", file=sys.stderr)
        return 2
    # pre-flight 守衛①:來源 repo 自我保護(對齊 cmd_update 的 root==src → return 2)
    src = _lumos_src(source)
    if root.resolve() == src.resolve():
        print("擋下:你現在就在 Lumos 工具鏈的來源 repo 裡,不能在這裡移除它自己", file=sys.stderr)
        return 2
    # ★dry-run 例外(2026-08-02 代碼審 r2)★:純預覽、零 mutation,不會走到刪自己那一步,
    # 擋它只是誤傷合法的唯讀操作(而且使用者正想用它看看會動到什麼)。
    if not dry_run and _selfdelete_risk(root):   # Windows 自刪——mutation 之前擋
        print("擋下:Windows 上不能用專案自帶的那份 lumos 拆它自己"
              f"({Path(__file__).resolve()})——最後刪 vendored 時會刪到執行中的檔案,"
              "留下拆一半的狀態。", file=sys.stderr)
        print("  改用全域指令重跑:  lumos deinit", file=sys.stderr)
        print("  (若 PATH 還沒吃到,先重開一個終端;或直接用來源那份:"
              f"  python {src / 'scripts' / 'lumos'} deinit)", file=sys.stderr)
        return 2
    vault = _vault_in(root)
    # pre-flight 守衛②:vault == root 鐵閘(防 rmtree 整個 repo)
    if vault is not None and vault.resolve() == root.resolve() and not keep_graph:
        keep_graph = True
        print("⚠ 偵測到 standalone vault(圖譜=repo 根):強制保留圖譜,只拆其餘專案層。",
              file=sys.stderr)
    will_delete_vault = (vault is not None) and (not keep_graph)
    installed = _deinit_detect_installed(root)
    has_claude = _claude_block_present(root)
    if not installed and not will_delete_vault and not has_claude:
        print("✓ 未安裝(此 repo 無 Lumos 專案層)")
        return 0
    if dry_run:
        print("lumos deinit --dry-run(僅預演,不改動):")
        print(f"  root: {root}")
        print("  拆閘: git config --unset core.hooksPath" if installed
              else "  拆閘: (core.hooksPath 未設,略)")
        if has_claude:
            print("  剝 CLAUDE.md graph-discipline 區塊")
        if will_delete_vault:
            n = len([f for f in vault.rglob("*") if f.is_file()])
            print(f"  刪圖譜 vault: {vault}({n} 檔)")
        elif vault is not None:
            print(f"  保留圖譜 vault: {vault}")
        print("  移除 vendored 工具組(白名單:5 檔 + hooks/templates 兩夾)")
        return 0
    if will_delete_vault and not yes:
        if not sys.stdin.isatty():
            print("擋下:這不是互動式終端、沒辦法問你確認,又沒加 --yes,不刪圖譜。確定要刪就加 --yes",
                  file=sys.stderr)
            return 2
        files = [f for f in vault.rglob("*") if f.is_file()]
        dirty = subprocess.run(["git", "-C", str(root), "status", "--porcelain", str(vault)],
                               capture_output=True, text=True, errors="replace").stdout
        n_dirty = len([ln for ln in dirty.splitlines() if ln.strip()])
        print(f"將刪除圖譜 vault: {vault}({len(files)} 檔)")
        if n_dirty:
            print(f"  ⚠ 其中 {n_dirty} 個未 commit — 刪了 git 救不回!")
        try:
            ans = input("確定刪除?輸入 y 繼續、其他取消: ").strip().lower()
        except EOFError:
            # isatty() 在某些終端/Windows 回 True 但 stdin 其實 EOF → 讀不到確認。
            # 破壞性操作安全預設:拒刪(對齊上面非互動 rc2)。
            print("擋下:等不到你的確認輸入,不刪圖譜。確定要刪再加 --yes", file=sys.stderr)
            return 2
        if ans != "y":
            print("已取消。")
            return 1
    # ── 固定順序執行(pre-flight 已過)──
    _deinit_unbar_gate(root)                 # step 1 先拆閘
    _deinit_strip_claude(root)               # step 2 剝 CLAUDE.md 區塊
    if will_delete_vault:                    # step 3 刪圖譜(pre-flight + 安全網已過)
        import shutil
        shutil.rmtree(vault)
    _deinit_remove_vendored(root, src)       # step 4 最後移 vendored(可能含自己);src 供逐檔白名單(F9)
    print("✓ deinit 完成(專案層已移除)。檢視 `git diff` 後自行 commit。")
    return 0


_HOOK_LIVENESS_WINDOW_DAYS = 7


def _hook_recent_ok(repo_root, hook_name, hook_path):
    """這支 hook 最近有沒有「成功跑完」過(#19 S4)。

    回 (verdict, note):verdict ∈ {"ok", "stale", "unknown"}。

    ★三個條件同時成立才算 ok★(r1 外家否決席 blocker):
    只用「近 7 天跑過」判不出「現在」有沒有效——hook 今天上午跑過、下午被移除,
    接下來七天照樣顯示有效,那正是「以為防護還在、其實已經沒了」。
    所以除了②有近期成功事件之外,還要①現在有註冊(呼叫端已經判過)
    ③**現在的檔案指紋跟那筆事件記的一樣**(換版本要看得出來)。

    ★沒有近期成功不等於失效★:可能只是七天內沒有自然觸發(例如那支 hook
    要開子代理才會跑)。所以回 `stale/unknown`,★不回 inactive★。

    ★逾時與失敗不算「跑過」★:事件的 kind 分成 ok/timeout/error,這裡只認 ok。
    """
    import json as _j
    import datetime as _dt
    import hashlib as _h
    f = Path(repo_root) / "governance" / "runtime" / "hook-events.jsonl"
    if not f.exists():
        return "unknown", "還沒有任何 hook 事件檔(這台機器還沒跑過,或剛 clone)"
    try:
        cur_fp = _h.sha256(Path(hook_path).read_bytes()).hexdigest()[:16] if hook_path else ""
    except OSError:
        cur_fp = ""
    cutoff = _dt.datetime.now().astimezone() - _dt.timedelta(days=_HOOK_LIVENESS_WINDOW_DAYS)
    root_s = str(Path(repo_root).resolve())
    latest = None
    try:
        for ln in f.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                e = _j.loads(ln)
            except ValueError:
                continue
            if e.get("hook") != hook_name or e.get("kind") != "ok":
                continue
            if e.get("repo") and e.get("repo") != root_s:
                continue          # ★別的 repo 的事件不算數★(跨 repo 假綠)
            try:
                ts = _dt.datetime.fromisoformat(str(e.get("ts", "")))
            except ValueError:
                continue
            if ts.tzinfo is None:
                continue
            if ts > _dt.datetime.now().astimezone():
                continue          # 未來時間戳不採信(時鐘被調過)
            if ts < cutoff:
                continue
            if latest is None or ts > latest[0]:
                latest = (ts, e)
    except OSError:
        return "unknown", "hook 事件檔讀不動"
    if latest is None:
        return "stale", f"近 {_HOOK_LIVENESS_WINDOW_DAYS} 天沒有成功跑完的紀錄(可能只是沒被觸發)"
    if cur_fp and latest[1].get("fp") and latest[1].get("fp") != cur_fp:
        return "stale", "最近那次成功跑的是別的版本(檔案指紋對不上,換版之後還沒跑過)"
    return "ok", f"最近一次成功 {latest[0].strftime('%Y-%m-%d %H:%M')}"


def _hooks_path_is_ours(root: Path, val: str) -> bool:
    """core.hooksPath 的值指的是不是本 repo 的 scripts/hooks。

    ★不能拿字串直接比★(#19 S5):`git config core.hooksPath` 存的可能是相對路徑、
    絕對路徑、或以 `~` 開頭——三種寫法指的是同一個地方。
    2026-09-08 實測:本機存的是絕對路徑,而 enforcement 拿它跟字面的 "scripts/hooks" 比,
    於是把兩道每次推送都在跑的 git 閘印成 inactive。
    ★方向是「該說有卻說沒有」★:表面安全,實際後果是那兩列長期紅、真的掉了也沒有訊號價值。

    這支是從 _deinit_unbar_gate 抽出來的既有做法(架構對齊席:不要寫第二份),
    只多補一件它沒處理的:`~` 展開。
    """
    if not val:
        return False
    v = os.path.expanduser(val)
    vp = Path(v) if Path(v).is_absolute() else (root / v)
    ours = root / "scripts" / "hooks"
    try:
        return vp.resolve() == ours.resolve()
    except Exception:
        return str(vp) == str(ours)


def _deinit_unbar_gate(root: Path) -> int:
    """拆 pre-commit 閘:git -C root config --unset core.hooksPath。
    rc 0(已 unset)/ rc 5(key 本不存在)皆成功;其他 rc 印 warning 但不中止
    (真正保險是 step 4 會刪掉 scripts/hooks/ 的 lumos hook 檔,缺 hook 檔 git 自會放行)。
    守衛(std F8,teardown一鍵拆機_計劃):只在 core.hooksPath 指向本 repo scripts/hooks 時才 unset;
    指向使用者自設(如 .githooks)則保留不動——別誤殺使用者的 git hooks(deinit/teardown 共用此安全)。"""
    import subprocess
    cur = subprocess.run(["git", "-C", str(root), "config", "--get", "core.hooksPath"],
                         capture_output=True, text=True, errors="replace")
    val = cur.stdout.strip()
    if val:
        if not _hooks_path_is_ours(root, val):   # #19 S5:抽成共用,別留第二份實作
            print(f"  ⚠ core.hooksPath={val} 非指向 lumos(scripts/hooks),保留不動(可能是你自設的)",
                  file=sys.stderr)
            return 0
    r = subprocess.run(["git", "-C", str(root), "config", "--unset", "core.hooksPath"],
                       capture_output=True, text=True, errors="replace")
    if r.returncode not in (0, 5):
        print(f"  ⚠ git config --unset core.hooksPath rc={r.returncode}(續行)", file=sys.stderr)
    return r.returncode


def _extract_claude_block_span(text: str):
    """定位 CLAUDE.md 中的 LUMOS:GRAPH-DISCIPLINE sentinel 區塊,回傳三態。

    回傳 (state, span):
      "found"  → span 是 BlockSpan(body, body_start, body_end);
                 body = START 行結尾 \\n 之後、END 行開頭之前的子字串,strip 首尾空行;
                 保證 text[body_start:body_end] == body。
      "absent" → (START 前綴出現 0 次 且 END 出現 0 次) → ("absent", None)
                 乾淨「沒這塊」,T2 可安全附加。
      "broken" → 只 START 沒 END / 只 END 沒 START / END 在 START 前 /
                 START 前綴出現 > 1 次 → ("broken", None)
                 有殘跡但壞了,不可盲改。
    """
    start_count = 0
    idx = 0
    si = -1
    # 計算 START 前綴出現次數,同時記第一次位置
    while True:
        pos = text.find(_CLAUDE_START_PREFIX, idx)
        if pos == -1:
            break
        start_count += 1
        if start_count == 1:
            si = pos
        idx = pos + 1

    ei = text.find(_CLAUDE_END)

    has_start = start_count > 0
    has_end = ei != -1

    # absent: 兩者皆無
    if not has_start and not has_end:
        return ("absent", None)

    # broken: 只有其中一個 / 重複 START / END 在 START 前
    if start_count > 1:
        return ("broken", None)
    if has_start and not has_end:
        return ("broken", None)
    if has_end and not has_start:
        return ("broken", None)
    if ei < si:
        return ("broken", None)

    # found: si = START 行首字元;找該行結尾(含 \n)
    nl_after_start = text.find("\n", si)
    if nl_after_start == -1:
        # START 行是檔案最後一行,無換行 → 無 body
        body_raw_start = len(text)
    else:
        body_raw_start = nl_after_start + 1  # body 從 START 行下一字元開始

    # body 結束 = END 行開頭字元
    body_raw_end = ei  # text[body_raw_start:body_raw_end] 是未 strip 的 body

    raw_body = text[body_raw_start:body_raw_end]

    # strip 首尾空白行(只去掉 \n,保留內部縮排)
    stripped = raw_body.strip("\n")

    if stripped:
        # 在 raw_body 中找 stripped 的真實位移
        inner_start = raw_body.find(stripped)
        body_start = body_raw_start + inner_start
        body_end = body_start + len(stripped)
    else:
        # body 全是空白行:body 設為空字串,位移指向 body_raw_start
        body_start = body_raw_start
        body_end = body_raw_start
        stripped = ""

    return ("found", BlockSpan(body=stripped, body_start=body_start, body_end=body_end))


# Task 2 ─────────────────────────────────────────────────────────────────────
# START 行(本 task 無版本戳;T5 會在此字串中插入版本號——形式保留易替換)


# 07-29 依官方 context engineering 指南瘦身後的紀律範本大小(a0c5100e 當時的 graph-discipline.md,5256 bytes);
# doctor Check D 拿它當基線,長回五成以上就提醒([[Projects/skills提示工程優化_計劃]] S4)。
_DISCIPLINE_SLIM_BASELINE_BYTES = 5256


def _expected_claude_body(root: Path, slug: str) -> "str | None":
    """讀 scripts/templates/graph-discipline.md,{{KG}} 替換後 strip 首尾空行 → 預期 body 字串。
    範本不存在 → None(呼叫端 skip Check D)。
    strip 用 `.strip("\\n")`(只去首尾空行、保留內縮排),與 _extract_claude_block_span 的 body
    取法一致——reinject 寫入、extract 讀回、Check D 比對三處同一算法,版本差不觸發(版本在 body 外)。"""
    tpl_path = root / "scripts" / "templates" / "graph-discipline.md"
    if not tpl_path.exists():
        return None
    return tpl_path.read_text(encoding="utf-8").replace("{{KG}}", f"docs/{slug}-knowledge/").strip("\n")



def _agents_target(root: Path) -> str:
    """Codex 讀的指示檔名:該層有 AGENTS.override.md 就只讀它(官方規則),否則 AGENTS.md(d1)。"""
    return "AGENTS.override.md" if (root / "AGENTS.override.md").exists() else "AGENTS.md"


def _reinject_targets(root: Path):
    """紀律區塊的目標清單:CLAUDE.md(Claude Code)+ Codex 的指示檔;注入/剝除/Check D 三端共用(r1 整合 F1/F2)。"""
    return ("CLAUDE.md", _agents_target(root))


def _reinject_all(root: Path, slug: str, quiet=False):
    """對所有目標各跑一次 _reinject_claude_block,印人話,回 {target: ReInjectResult}。
    既有 AGENTS 檔第一次被注入(appended)時印它前 8 行——語意衝突機器判不了(r2 整合 F12)。"""
    out = {}
    for t in _reinject_targets(root):
        ri = _reinject_claude_block(root, slug, target=t)
        out[t] = ri
        if quiet:
            continue
        if ri.status == "updated":
            print(f"  {t} 紀律區塊已更新")
            if ri.diff and t == "CLAUDE.md":
                for line in ri.diff.splitlines()[:20]:  # 最多印 20 行 diff 摘要
                    print(f"    {line}")
        elif ri.status in ("created", "appended"):
            print(f"  {t} 紀律區塊已注入({ri.status})")
            if ri.status == "appended" and t != "CLAUDE.md":
                head = (root / t).read_text(encoding="utf-8", errors="replace").splitlines()
                own = [l for l in head if "LUMOS:GRAPH-DISCIPLINE" not in l][:8]
                print(f"  ★{t} 原本就有內容,看一眼它跟紀律區塊有沒有互相打架(機器判不了語意):")
                for l in own:
                    print(f"    | {l[:100]}")
        elif ri.status == "sentinel_broken":
            print(f"  ⚠ {t} sentinel 半壞,未自動覆蓋,請檢查", file=sys.stderr)
        # unchanged / no_template → 靜默
    return out


def _reinject_claude_block(root: Path, slug: str, target: str = "CLAUDE.md") -> "ReInjectResult":
    """讀 vendored 範本 → {{KG}} 替換 → 組 sentinel block → 依三態更新 target(預設 CLAUDE.md;
    Codex 的 AGENTS.md / AGENTS.override.md 走同一段,d1)。

    status ∈ created|updated|unchanged|appended|sentinel_broken|no_template。
    diff:僅 updated 帶 difflib.unified_diff 字串,其餘 None。
    讀入時正規化 CRLF→LF 並去 BOM;寫入一律 _write_lf(強制 LF / 無 BOM)。
    """
    import difflib

    # 1. 範本 + body(共用 _expected_claude_body 確保 Check D 比對算法一致)
    body = _expected_claude_body(root, slug)
    if body is None:
        return ReInjectResult("no_template", None)

    # 3. 組 block(START 行帶當前版本戳,機械插值——版本在 body 外,不影響 Check D 比對)
    start_line = _START_TEMPLATE.format(version=LUMOS_VERSION)
    block = start_line + "\n" + body + "\n" + _CLAUDE_END

    # 4. 讀目標檔(去 BOM + CRLF 正規化;★整檔都會被正規化,不只區塊★)
    cm = root / target
    if cm.exists():
        raw = cm.read_bytes()
        # 去 UTF-8 BOM
        if raw.startswith(b"\xef\xbb\xbf"):
            raw = raw[3:]
        claude_text = raw.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
    else:
        claude_text = None

    # 5. 三態分派
    if claude_text is None:
        # 目標不存在 → created(檔頭依目標名;r2 整合 F11:曾寫死 "# CLAUDE.md")
        _write_lf(cm, f"# {target}\n\n" + block + "\n")
        return ReInjectResult("created", None)

    state, span = _extract_claude_block_span(claude_text)

    if state == "broken":
        return ReInjectResult("sentinel_broken", None)

    if state == "absent":
        # 有檔但無 sentinel → appended。CLAUDE.md 沿舊行為接檔尾;
        # AGENTS 檔插檔首(第一個 # 標題行之後;沒有標題行→檔案最前)——Codex 把整鏈 AGENTS 檔串起來
        # 只吃 32 KiB、超過靜默截斷,靠前一點少被砍(d1;r2 邊界 N5 定 fallback)。
        if target == "CLAUDE.md":
            new_text = claude_text.rstrip() + "\n\n" + block + "\n"
        else:
            lines = claude_text.split("\n")
            idx = next((i for i, l in enumerate(lines) if l.startswith("#")), None)
            if idx is None:
                new_text = block + "\n\n" + claude_text.lstrip("\n")
            else:
                new_text = "\n".join(lines[:idx + 1]) + "\n\n" + block + "\n\n" + "\n".join(lines[idx + 1:]).lstrip("\n")
            new_text = new_text.rstrip() + "\n"
        _write_lf(cm, new_text)
        return ReInjectResult("appended", None)

    # state == "found": splice body + 同步刷新 START 行(版本戳落在存量戶的唯一路徑——
    # 只換 body 會讓 updated 路徑永遠拿不到版本戳,標籤機制對存量安裝戶形同虛設。
    # START 行在管理區塊「內」,★INVARIANT★ 只保護 sentinel 之外,刷新它不違約)。
    old_body = span.body
    new_body = body
    si = claude_text.find(_CLAUDE_START_PREFIX)
    sl_begin = claude_text.rfind("\n", 0, si) + 1
    sl_end = claude_text.find("\n", si)
    old_start_line = claude_text[sl_begin:sl_end] if sl_end != -1 else claude_text[sl_begin:]

    if old_body == new_body and old_start_line == start_line:
        return ReInjectResult("unchanged", None)

    # 有差 → 先換 body(高位移),再換 START 行(低位移,原始位移仍有效);兩 splice 之間
    # 的原始空白行區逐字保留。
    new_text = claude_text[:span.body_start] + new_body + claude_text[span.body_end:]
    if sl_end != -1 and old_start_line != start_line:
        new_text = new_text[:sl_begin] + start_line + new_text[sl_end:]
    _write_lf(cm, new_text)

    diff = "".join(difflib.unified_diff(
        (old_start_line + "\n" + old_body).splitlines(keepends=True),
        (start_line + "\n" + new_body).splitlines(keepends=True),
        fromfile="old block",
        tofile="new block",
    ))
    return ReInjectResult("updated", diff)


def _deinit_strip_claude(root: Path) -> bool:
    """剝 CLAUDE.md 與 Codex 指示檔(AGENTS.md / AGENTS.override.md)的 LUMOS:GRAPH-DISCIPLINE 區塊;
    其餘內容/整個檔都留。目標清單與注入端同一份(r1 整合 F1)。任一檔有剝到 → True;都無 → False。"""
    hit = False
    # ★掃三個候選檔,不只當前目標★:先注入 AGENTS.md、後來才加 override,目標會變,舊檔區塊要一起剝(r1 外家 #3)
    for t in ("CLAUDE.md", "AGENTS.md", "AGENTS.override.md"):
        cm = root / t
        if not cm.exists():
            continue
        text = cm.read_text(encoding="utf-8")
        start_marker = "<!-- LUMOS:GRAPH-DISCIPLINE:START"
        end_marker = "LUMOS:GRAPH-DISCIPLINE:END -->"
        si = text.find(start_marker)
        ei = text.find(end_marker)
        if si == -1 or ei == -1 or ei < si:
            continue
        ei += len(end_marker)
        new = (text[:si].rstrip() + "\n" + text[ei:].lstrip()).strip()
        _write_lf(cm, (new + "\n") if new else "")
        hit = True
    return hit


def _deinit_remove_vendored(root: Path, src=None) -> list:
    """白名單移除 vendored 工具組:① _VENDORED_TOOLKIT 固定 5 檔;
    ② scripts/hooks/、scripts/templates/ ★依 src 列舉逐檔刪★(對稱 _vendor_toolchain 的 rglob 安裝)。
    F9 修(2026-07-24,Issues/deinit整夾刪使用者檔):不再整夾 rmtree——只刪 src 有的 lumos 檔、
    保留使用者放這兩夾的自有檔,夾空了才移。fallback(a):src 缺(None 或來源夾不存在)→ 保守留夾
    +warn、不刪(never delete unknown)。scripts/ 底下使用者自有檔不碰;scripts/ 空了才 rmdir。
    回傳已移除相對路徑列表。"""
    removed = []
    for rel in _VENDORED_TOOLKIT:
        p = root / rel
        if p.exists():
            # ★刪不掉不該炸穿整個流程★(2026-08-01):這裡以前是裸 unlink()。
            # 走 teardown 時,①全域 hook 已清、②CLAUDE.md 已剝、閘已拆,
            # 若在這裡拋 PermissionError(Windows 刪執行中的檔、防毒鎖檔),
            # ③uninstall 根本沒機會跑 → 使用者拿到拆一半又只看到 traceback 的
            # 狀態。改成印清楚哪一個檔沒刪掉、繼續往下走完;★不靜默★——沒刪掉
            # 的檔不會被記進 removed,呼叫端印出來的清單仍然誠實。
            # (Windows 自刪這條主要路徑另有 _selfdelete_risk 在 mutation 前擋。)
            try:
                p.unlink(); removed.append(rel)
            except OSError as e:
                print(f"  ⚠ 移除 {p} 失敗,跳過(其餘步驟照跑): {e}", file=sys.stderr)
    mp = root / _VENDORED_MANIFEST   # 工具檔的內容指紋清單是工具自己的東西,跟著拆
    if mp.is_file():
        try:
            mp.unlink(); removed.append(_VENDORED_MANIFEST)
        except OSError as e:
            print(f"  ⚠ 移除 {mp} 失敗,跳過(其餘步驟照跑): {e}", file=sys.stderr)
    for d in _VENDORED_TREE_DIRS:
        tgt = root / d
        if not tgt.is_dir():
            continue
        src_d = (src / d) if src is not None else None
        if src_d is None or not src_d.is_dir():   # fallback(a):列舉不出 → 保守留夾
            print(f"  ⚠ 無法從來源列舉 {d} 的 lumos 檔清單,保留整夾避免誤刪你的檔"
                  "(手動清理,或 deinit/teardown 加 --source 指向 Lumos 來源)", file=sys.stderr)
            continue
        for f in src_d.rglob("*"):                # 對稱安裝:src_d 下的檔即 lumos-owned,逐檔刪
            if f.is_file():
                rel_f = f.relative_to(src_d)
                t = tgt / rel_f
                if t.exists():
                    t.unlink(); removed.append(f"{d}/{rel_f}")
        for sub in sorted((p for p in tgt.rglob("*") if p.is_dir()),   # 由深到淺移空子目錄
                          key=lambda x: len(x.parts), reverse=True):
            if not any(sub.iterdir()):
                sub.rmdir()
        if any(tgt.iterdir()):                    # 夾內尚有使用者檔 → 留+warn
            leftover = sorted(p.name for p in tgt.iterdir())
            print(f"  ⚠ {d} 保留(內有非 lumos 檔:{', '.join(leftover[:5])})", file=sys.stderr)
        else:
            tgt.rmdir(); removed.append(d + "/")
    sc = root / "scripts"
    if sc.is_dir() and not any(sc.iterdir()):
        sc.rmdir(); removed.append("scripts/")
    return removed


def _deinit_detect_installed(root: Path) -> bool:
    """target repo root 是否有專案層安裝痕跡:core.hooksPath 有值 或 scripts/hooks/ 存在。
    不靠 scripts/lumos 自身存在(執行檔與'此 repo 是否裝過'無關)。"""
    import subprocess
    hp = subprocess.run(["git", "-C", str(root), "config", "core.hooksPath"],
                        capture_output=True, text=True, errors="replace")
    if hp.returncode == 0 and hp.stdout.strip():
        return True
    return (root / "scripts" / "hooks").is_dir()


def _claude_block_present(root: Path) -> bool:
    cm = root / "CLAUDE.md"
    return cm.exists() and "LUMOS:GRAPH-DISCIPLINE:START" in cm.read_text(encoding="utf-8")


def _lumos_src(source=None):
    """解析 Lumos 唯一源 repo 路徑:--source > $LUMOS_HOME > ~/harness/lumos-toolchain。"""
    import os
    return Path(source or os.environ.get("LUMOS_HOME")
                or (Path.home() / "harness" / "lumos-toolchain")).expanduser()


# ── Task 5: 版本 parse + nudge ───────────────────────────────────────────────

def _parse_sentinel_version(claude_text: str) -> "str | None":
    """從 CLAUDE.md 文字中找 START sentinel 行,空格切分取形如 vX.Y 的欄位。
    取不到(無 START / START 行無版本欄位) → None;不 crash。"""
    _ver_re = re.compile(r"\bv\d+\.\d+\b")
    for line in claude_text.splitlines():
        if _CLAUDE_START_PREFIX in line:
            # START 行存在,掃各 token 找 vX.Y
            for token in line.split():
                if _ver_re.fullmatch(token):
                    return token
            # START 行存在但無版本欄位 → None
            return None
    return None


def _version_nudge(root: Path) -> "str | None":
    """比對本專案 CLAUDE.md sentinel 版本 vs 來源 clone 的 LUMOS_VERSION。

    - 來源 clone 不存在/不可達 → None(靜默 skip;CI 無來源 clone 不誤報)。
    - CLAUDE 版本 < 來源版本(字串不等且 CLAUDE 較舊) → 軟提示字串。
    - 相等 / CLAUDE 較新 / 任一取不到 → None。
    """
    # 1. 讀 CLAUDE.md sentinel 版本
    cm = root / "CLAUDE.md"
    if not cm.exists():
        return None
    try:
        claude_text = cm.read_bytes()
        if claude_text.startswith(b"\xef\xbb\xbf"):
            claude_text = claude_text[3:]
        claude_text = claude_text.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
    except OSError:
        return None
    claude_ver = _parse_sentinel_version(claude_text)
    if claude_ver is None:
        return None

    # 2. 讀來源 clone 的 LUMOS_VERSION(文字 grep,不 import 避免副作用)
    src = _lumos_src()
    src_lumos = src / "scripts" / "lumos"
    if not src_lumos.exists():
        return None  # 來源不可達 → 靜默 skip
    try:
        _ver_pat = re.compile(r'^LUMOS_VERSION\s*=\s*"(v\d+\.\d+)"', re.MULTILINE)
        src_text = src_lumos.read_text(encoding="utf-8", errors="replace")
        m = _ver_pat.search(src_text)
        if not m:
            return None
        src_ver = m.group(1)
    except OSError:
        return None

    # 3. 比對:CLAUDE 版本 < 來源版本 → nudge(簡單字串不等判準;版本是 advisory)
    if claude_ver == src_ver:
        return None
    # 嘗試 tuple 比對(vMAJOR.MINOR → (MAJOR, MINOR));取不到就用字串不等
    def _ver_tuple(s):
        try:
            parts = s.lstrip("v").split(".")
            return tuple(int(x) for x in parts)
        except (ValueError, AttributeError):
            return None
    ct = _ver_tuple(claude_ver)
    st = _ver_tuple(src_ver)
    if ct is not None and st is not None and ct >= st:
        return None  # CLAUDE 版本 ≥ 來源,不 nudge
    # CLAUDE 落後(或無法比較)→ 提示
    return (
        f"本專案紀律區塊版本 {claude_ver} 落後來源 {src_ver},"
        f" 可跑 lumos update 刷新"
    )


# vendored 工具組白名單(固定 5 檔,scripts/ 前綴;hooks/templates 兩夾另走整夾刪)。
# _vendor_toolchain 安裝端與 cmd_deinit 移除端共用,避免漂移。
_VENDORED_TOOLKIT = ("scripts/lumos", "scripts/test_lumos.py",
                     "scripts/merge-claude-settings.py", "scripts/graph-rename.sh",
                     "scripts/fetch-notesmd.sh")
_VENDORED_TREE_DIRS = ("scripts/hooks", "scripts/templates")   # 安裝時整個目錄照來源複製過去的那兩個
# ★工具確實會安裝進消費專案的每一支檔(精確檔名)★——跳過判斷只認這張表,不認目錄前綴。
# 2026-09-10 代碼審 r1 四席獨立抓到:原本照目錄前綴跳過,消費專案自己放在 scripts/hooks、
# scripts/templates 的程式會被當成工具的檔,推送閘的風險分級被降、逃過代碼審。
# 表要跟工具鏈 repo 裡那兩個目錄底下受版控的檔一模一樣:有一支測試逐檔比對,少登記或多登記都會翻紅。
_VENDORED_TREE_FILES = (
    "scripts/hooks/claude/_hookevent.py",
    "scripts/hooks/claude/check-graph-sync.py",
    "scripts/hooks/claude/ci-status-hook.py",
    "scripts/hooks/claude/memory-sweep.py",
    "scripts/hooks/claude/dispatch-lens-hook.py",
    "scripts/hooks/claude/impact-hook.py",
    "scripts/hooks/claude/lumos-entry-hook.py",
    "scripts/hooks/post-commit",
    "scripts/hooks/pre-commit",
    "scripts/hooks/pre-push",
    "scripts/templates/graph-discipline.md",
)
_VENDORED_ALL = frozenset(_VENDORED_TOOLKIT + _VENDORED_TREE_FILES)


_VENDORED_MANIFEST = ".lumos/vendored.json"   # 安裝/更新時記下每支工具檔的內容指紋


def _vendored_digest(data):
    """工具檔的內容指紋:換行統一成 LF 再算 sha256(Windows 的換行轉換不該讓指紋對不上)。"""
    import hashlib
    return hashlib.sha256(bytes(data).replace(b"\r\n", b"\n")).hexdigest()


def _vendored_manifest_write(root):
    """把工作目錄裡「工具自裝檔」的內容指紋寫進 .lumos/vendored.json(安裝與更新時呼叫;回寫進去的 {路徑: 指紋})。"""
    files = {}
    for rel in sorted(_VENDORED_ALL):
        p = Path(root) / rel
        if p.is_file():
            files[rel] = _vendored_digest(p.read_bytes())
    mp = Path(root) / _VENDORED_MANIFEST
    mp.parent.mkdir(parents=True, exist_ok=True)
    # 格式跟錨點基準線同一種({"version": 1, <路徑: sha256>…};第四輪架構席)。不走錨點那種「人核可才改」的流程:
    # 這份是安裝時的事實紀錄,錯了的方向是「多掃」不是「少擋」。ensure_ascii:從某版本讀回來走的是文字模式的 git show
    _write_lf(mp, json.dumps({"version": 1,
                              "note": "lumos 安裝時記下的工具檔內容指紋;內容對得上的才不算專案自己的程式",
                              "files": files}, ensure_ascii=True, indent=1) + "\n")
    return files


def _vendored_state(root, ref=None):
    """回 (原封不動的工具檔, 存在的工具檔) 兩個集合;ref=None 看工作目錄,否則看那個版本。

    ★原封不動=檔名在精確清單上,而且內容跟安裝時記下的指紋一模一樣★(2026-09-10 代碼審 r3 併發資源席:
    只比檔名的話,專案自己改了工具裝進來的檔、或把自己的程式放成工具的檔名,風險掃描就完全看不到)。
    指紋清單不在或讀不懂 → 原封不動的=空集合:一支都不跳,寧可多掃(舊版安裝的專案更新後就有清單)。"""
    present, data = set(), {}
    if ref is None:
        for p in sorted(_VENDORED_ALL):
            fp = Path(root) / p
            if fp.is_file():
                present.add(p)
                try:
                    data[p] = fp.read_bytes()
                except OSError:   # 讀不到(權限、被鎖)=不算原封不動、照樣掃(第四輪邊界席:原本直接噴錯中斷)
                    data[p] = None
        try:
            man = json.loads((Path(root) / _VENDORED_MANIFEST).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            man = None
    else:
        # 讀那個版本的檔用專案既有的 git show 包裝(第四輪架構席:第三輪另寫了一套 cat-file --batch 解析)
        for p in sorted(_VENDORED_ALL):
            r = _lens_git(root, "show", f"{ref}:{p}", binary=True)
            if r is None:                 # git 跑不起來 → 不知道 → 當成在、而且沒對上(照樣掃)
                present.add(p)
                data[p] = None
            elif r.returncode == 0:
                present.add(p)
                data[p] = r.stdout
        man = _json_at_ref(root, ref, _VENDORED_MANIFEST)
    files = man.get("files") if isinstance(man, dict) else None
    if not isinstance(files, dict):
        return frozenset(), frozenset(present)
    return (frozenset(p for p in present if data.get(p) is not None and files.get(p) == _vendored_digest(data[p])),
            frozenset(present))


def _diff_range_ends(root, diff_range):
    """git diff 的範圍拆成 (起點, 終點);終點 None=工作目錄。A..B、A..、A...B(起點取共同祖先)、單一版本。"""
    import subprocess
    r = str(diff_range).strip()
    if "..." in r:
        a, b = r.split("...", 1)
        a, b = a or "HEAD", b or "HEAD"
        try:
            mb = subprocess.run(["git", "merge-base", a, b], capture_output=True, text=True, errors="replace",
                                cwd=str(root), timeout=_disp_git_timeout())
            return (mb.stdout.strip() or a), b
        except (OSError, subprocess.TimeoutExpired):
            return a, b
    if ".." in r:
        a, b = r.split("..", 1)
        return (a or "HEAD"), (b or "HEAD")
    return r, None


def _is_toolchain_repo(root):
    """這個 repo 是不是工具鏈本體(那裡 scripts/lumos 就是產品,不能當成外來的跳過)。

    ★判別鍵沿用既有慣例★(見 `_self_repo_origin`):skills/lumos-project-notes/SKILL.md
    是 user-scope skill 的唯一源,永遠不會被複製進消費專案。"""
    try:
        return (Path(root) / "skills" / "lumos-project-notes" / "SKILL.md").is_file()
    except Exception:
        return False


def _pull_source_or_abort(src, allow_stale=False):
    """更新來源 clone;拉不到就中止。回傳 0=可繼續、None=中止(呼叫端不得再寫任何檔)。

    ★為什麼 fail-closed★:原本 pull 失敗只印一行警告就繼續 vendor,來源落後或有本機
    分歧時會靜默拿舊版蓋掉專案裡較新的檔——消費端實戰咬過兩次,那行警告混在一堆輸出裡
    根本看不到。「拿不到最新」與「確定這是最新」是兩種狀態,不該用同一條路走完。

    ★但無 remote 不算失敗★:手動複製 / slim 安裝出來的來源本就沒有 remote,那是合法的
    離線情境,擋它等於把離線使用者鎖在門外。只有「有 remote 卻拉不到」才中止。
    _vendor_toolchain(專案層) 與 cmd_bootstrap(機器層) 共用本函式,避免兩處政策漂移。
    """
    import subprocess
    if not (src / ".git").is_dir():
        print("  (來源非 git repo,跳過 pull)")
        return 0
    has_remote = subprocess.run(["git", "-C", str(src), "remote"],
                                capture_output=True, text=True, errors="replace").stdout.strip()
    if not has_remote:
        print("  (來源無 remote:離線 clone,跳過 pull)")
        return 0
    print("  git pull 來源(取最新工具組)…")
    if subprocess.run(["git", "-C", str(src), "pull", "--ff-only"]).returncode == 0:
        return 0
    # ★來源「只髒了工具自己寫的帳」不該擋人★(2026-09-06 全 repo 審視 #5)
    # 症狀:唯讀的 `lumos show`/`context` 就會 append docs/.usage-log.jsonl,而那本帳是版控的。
    # 只要有人在來源 clone 裡查過一次圖譜,之後這台機器所有專案的 update / bootstrap --pull
    # 全部被 fail-closed 擋住;逃生門寫在錯誤訊息最後一行,沒人會讀到那裡。
    #
    # ★做法是「聯集合併」,不是 stash/pop★:這幾本是 append-only 的 JSONL,兩邊各自加了行,
    # stash pop 會判成衝突並★在帳本裡留下衝突標記★——那比原本擋住更糟,帳本直接壞掉、
    # 之後每次讀都炸(第一版真的踩到,實測留下 <<<<<<< 標記)。正確解是把兩邊的行取聯集:
    # 先把本機那份讀進記憶體 → checkout 回 HEAD → pull → 把本機獨有的行補回去。
    # 非 JSONL 的簿記檔(anchor-baseline.json 是一份 JSON 物件)不能這樣併,照原路擋下。
    dirty = subprocess.run(["git", "-C", str(src), "status", "--porcelain=v1", "-z"],
                           capture_output=True, text=True, errors="replace").stdout
    # ★用 -z 逐筆解析,不要對人看的格式做字串切片★(2026-09-06 代碼審 r1 外家席):
    # porcelain 的 rename 是 `R  old\0new`、含特殊字元的路徑在非 -z 模式會被 C-style 跳脫並加引號,
    # 光 strip('"') 解不開。-z 模式路徑原樣不跳脫;rename/copy 會多吃一個 NUL 欄位,我們直接
    # ★保守拒絕★(狀態碼含 R/C 就不自動併),寧可照原路擋下也不要判錯。
    paths, bad_shape = [], False
    if dirty:
        parts = dirty.split("\0")
        i = 0
        while i < len(parts):
            ent = parts[i]
            if not ent:
                i += 1
                continue
            xy, path = ent[:2], ent[3:]
            if "R" in xy or "C" in xy:      # rename/copy:後面還跟一個來源路徑,保守不併
                bad_shape = True
                i += 2
                continue
            paths.append(path)
            i += 1
    mergeable = (not bad_shape) and paths and all(
        p in _BOOKKEEPING_FILES and p.endswith(".jsonl") for p in paths)
    if paths and not mergeable and all(p in _BOOKKEEPING_FILES for p in paths):
        print("  (來源只髒了簿記檔,但其中有不是 append-only JSONL 的、或有改名——不自動併,照原路擋下)",
              file=sys.stderr)
    if mergeable:
        print(f"  來源只髒了工具自己寫的帳({len(paths)} 本 append-only)——取聯集後續拉,不丟任何一行")
        # ★先把本機那份存到磁碟再動 git★(2026-09-06 代碼審 r1 外家席):原本只存在記憶體,
        # checkout 之後若被 SIGKILL / 斷電 / 寫回失敗,那些★從未進過 git 物件庫★的行就永久消失
        # ——而且第一版的錯誤訊息還叫人用 `git checkout HEAD@{1}` 救,那是假的。
        import tempfile as _tf, shutil as _sh
        bak = Path(_tf.mkdtemp(prefix="lumos-bookkeeping-backup-"))
        saved = {}
        try:
            for rel in paths:
                f = src / rel
                saved[rel] = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
                _sh.copy2(f, bak / rel.replace("/", "__")) if f.exists() else None
        except OSError as e:
            print(f"  ⚠ 備份簿記帳失敗,照原路擋下(沒有動任何檔):{e}", file=sys.stderr)
            saved = None
        if saved is not None:
            print(f"    (動手前已備份到 {bak};全部併回成功才會刪)")
            subprocess.run(["git", "-C", str(src), "checkout", "--"] + paths,
                           capture_output=True, text=True, errors="replace")
            # ★比較對象是「拉之前的已提交版」,不是拉下來的內容★(2026-09-06 代碼審 r1 折入後
            # 自己的測試抓到):checkout 完檔案就等於 base。要補回的是「本機在 base 之上加了什麼」
            # ——拿拉下來的內容比,會在遠端剛好也加了同一行時把本機那筆當成重複吃掉。
            base = {}
            for rel in paths:
                f = src / rel
                base[rel] = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
            rc2 = subprocess.run(["git", "-C", str(src), "pull", "--ff-only"]).returncode
            all_ok = True
            for rel, old_lines in saved.items():
                f = src / rel
                try:
                    now = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
                    # ★用計數不用集合★(外家席):JSONL 是事件序列不是集合,同一行內容合法地出現
                    # 兩次是常態(同秒同節點的兩筆);set 判「有沒有」會把本機新增的那筆吃掉。
                    # 算的是「本機在 base 之上加了幾份」,加幾份就補幾份到拉下來的版本後面。
                    from collections import Counter as _C
                    need = _C(old_lines) - _C(base.get(rel, []))
                    extra = []
                    for l in old_lines:
                        if need[l] > 0:
                            extra.append(l)
                            need[l] -= 1
                    if extra:
                        raw = f.read_text(encoding="utf-8") if f.exists() else ""
                        sep = "" if (raw == "" or raw.endswith("\n")) else "\n"
                        with open(f, "a", encoding="utf-8") as fh:
                            fh.write(sep + "\n".join(extra) + "\n")
                        print(f"    {rel}:本機獨有的 {len(extra)} 行已補回")
                except OSError as e:
                    all_ok = False
                    print(f"  ⚠ {rel} 併回失敗——★那幾行還在備份裡★:{bak}/{rel.replace('/', '__')}\n"
                          f"    ({e})", file=sys.stderr)
            if all_ok:
                _sh.rmtree(bak, ignore_errors=True)
            if rc2 == 0:
                return 0
            print(f"  (pull 仍失敗;本機的帳已經併回,備份留在 {bak})", file=sys.stderr)
    if allow_stale:
        print("  ⚠ --allow-stale:pull 失敗,明示沿用現有來源繼續", file=sys.stderr)
        return 0
    print(f"擋下:工具鏈來源拉不到最新版(可能是網路不通、有本地改動擋住、或歷史分岔),先停。\n"
          f"  不會拿可能過期的來源蓋掉你的專案——默默裝到舊版這個坑踩過兩次。\n"
          f"  先去來源那邊處理:\n    cd {src} && git status && git pull --ff-only\n"
          f"  確定就要用現在這份來源:重跑並加 --allow-stale", file=sys.stderr)
    return None


def _vendor_toolchain(src, root, slug, no_pull=False, allow_stale=False):
    """從 Lumos 來源 src vendor 工具組到專案 root(python 單一源 scaffold + hooks + 結尾自癒)。
    回傳 0;來源無效回傳 None。圖譜資料受 _scaffold_project 的 skip 保護不被動。
    cmd_update / cmd_init(--with-hooks) 共用。"""
    import subprocess, shutil, filecmp
    installer = src / "scripts" / "install-graph-toolchain.sh"  # 仍作來源有效性探針(薄殼亦在)
    if not installer.exists():
        print(f"擋下:找不到 Lumos 工具鏈的來源({src} 底下沒有安裝腳本)。\n"
              f"  三種解法擇一:--source <路徑> 指定、設環境變數 $LUMOS_HOME、或 clone 到 ~/harness/lumos-toolchain",
              file=sys.stderr)
        return None
    if not no_pull:
        rc_p = _pull_source_or_abort(src, allow_stale)
        if rc_p is None:
            return None                      # fail-closed:一個檔都還沒動就退場
    # 安裝邏輯收進 python 單一源(scaffold + hooks);bash 安裝器僅留薄殼。
    _scaffold_project(root, slug)
    _init_additive_setup(root)     # 只加不覆寫;掛在這裡讓 `lumos update` 也能把設定骨架補給既有專案
    _set_hooks_path(root)          # 全域同步★不在這裡★——要等下面的 copy2 自癒把 vendored 檔換新
    rc = 0
    # 結尾 diff 自癒:python 端逐檔比對 src↔target,差異即補(可安全覆寫)。
    # ★只複製精確清單上的檔★(第三輪外家否決席:原本整個目錄照來源 rglob,來源裡沒進版控的檔也被裝進去,
    # 可是跳過清單只列受版控的檔——裝進去的檔不在清單上,消費專案又把它當成自己的程式掃)。清單跟來源受版控的檔
    # 是否一致,由 t_vendored_file_list_matches_what_install_ships 守
    toolkit = list(_VENDORED_TOOLKIT) + list(_VENDORED_TREE_FILES)
    healed = []
    for rel in toolkit:
        s, t = src / rel, root / rel
        if not s.exists():
            continue
        if (not t.exists()) or not filecmp.cmp(s, t, shallow=False):
            t.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(s, t)
            if s.stat().st_mode & 0o111:
                t.chmod(t.stat().st_mode | 0o111)
            healed.append(rel)
    if healed:
        print(f"  結尾自癒:補齊 installer 漏的 {len(healed)} 檔 → {', '.join(healed)}")
    else:
        print("  ✓ 結尾自癒檢查:工具組完全對齊(無漏)")
    # 記下工具檔的內容指紋:風險掃描與健檢只跳過「內容跟這裡一模一樣」的工具檔(r3 併發資源席)
    _vendored_manifest_write(root)
    # 範本已是最新(copy2 迴圈完成) → reinject 紀律區塊(CLAUDE.md + Codex 指示檔,d1)
    _reinject_all(root, slug)
    # ★全域同步放在這裡★(2026-09-06 全 repo 審視 #5):要等上面的 copy2 自癒把 vendored hook
    # 換成來源的新版之後才同步出去,否則 `lumos update` 會拿更新前的舊副本覆蓋全域 hooks。
    _sync_global_from_project(root)
    return rc


def cmd_update(source=None, no_pull=False, allow_stale=False):
    """從 Lumos 唯一源 repo 更新「本專案」vendored 的工具組。
    = (git pull Lumos) + install-graph-toolchain --target <本專案> --slug <自動偵測>。
    圖譜資料受 install-graph-toolchain 的 scaffold-skip 保護,不會被動。"""
    if _refuse_if_probe("update"):
        return 2
    src = _lumos_src(source)
    vault = find_vault(Path.cwd())
    if vault is None:
        # ★三條路同一套說法、同一個退出碼★(2026-09-07 全 repo 審視 #9)
        return _no_vault_msg()
    root = vault.parent.parent  # docs/<slug>-knowledge → docs → 專案 root
    slug = vault.name[:-len("-knowledge")] if vault.name.endswith("-knowledge") else vault.name
    if root.resolve() == src.resolve():
        # 來源 repo 自身:範本本地即最新,無 pull/vendor 之需——reinject-only
        # (2026-08-05 實戰缺口修:改完範本後來源 repo 自己的 CLAUDE.md 原本無路可刷)
        res = _reinject_all(root, slug, quiet=True)
        ri = res["CLAUDE.md"]
        print(f"lumos update — 來源 repo 自身:只刷新紀律區塊({', '.join(f'{k}:{v.status}' for k, v in res.items())})")
        return 0 if all(v.status in ("updated", "unchanged", "created", "appended") for v in res.values()) else 2
    print(f"lumos update — 來源 {src} → 本專案 {root}（slug={slug}）")
    rc = _vendor_toolchain(src, root, slug, no_pull=no_pull, allow_stale=allow_stale)
    return 2 if rc is None else rc


def _skills_list():
    """user-scope skills=repo skills/ 下所有含 SKILL.md 的目錄(掃目錄防清單漂移——
    舊硬編碼 tuple 曾漏 code-loop 等;同步修 install.sh 同款漂移)。"""
    repo = Path(__file__).resolve().parent.parent
    d = repo / "skills"
    if not d.is_dir():
        return ()
    return tuple(sorted(p.name for p in d.iterdir() if (p / "SKILL.md").is_file()))


_SKILLS = _skills_list()


def _link_or_copy(src: Path, dst: Path):
    """src→dst:Unix symlink、Win 目錄 junction、失敗 fallback 複製。src 須為目錄。"""
    import os, shutil, subprocess
    # W4:Windows junction 不被 is_symlink() 認出。舊碼 rmtree(dst) 會「跟進」junction 刪掉
    # 來源 target;且重跑時 junction 殘留 → mklink 報已存在 → 不冪等。改:junction/空夾用
    # os.rmdir(只移連結本身、不碰 target),真實非空夾才 rmtree。
    if dst.is_symlink():
        dst.unlink()                                  # Unix symlink
    elif dst.is_dir():
        try:
            os.rmdir(dst)                             # junction 或空夾:只移連結/夾,不跟進 target
        except OSError:
            shutil.rmtree(dst, ignore_errors=True)    # 真實非空夾(上次 fallback 複製過)
    elif dst.exists():
        dst.unlink()
    dst.parent.mkdir(parents=True, exist_ok=True)
    try:
        if _IS_WIN:
            # W2:mklink 輸出走 OEM 碼頁(繁中=cp950),text=True 預設 UTF-8 解碼會在
            # reader thread 炸 UnicodeDecodeError。errors="replace" 防炸,returncode 仍可靠。
            r = subprocess.run(["cmd", "/c", "mklink", "/J", str(dst), str(src)],
                               capture_output=True, text=True, encoding="utf-8", errors="replace")
            if r.returncode != 0:
                raise OSError(r.stderr)
        else:
            dst.symlink_to(src)
    except OSError:
        shutil.copytree(src, dst, dirs_exist_ok=True)  # Python ≥ 3.8(專案宣告 ≥3.9)
        try:
            (dst / _SKILL_MARKER).write_text("lumos fallback copy;安裝器可整夾重建\n", encoding="utf-8")
        except OSError:
            pass
        print(f"  ⚠ 連結失敗,改複製(失去 git pull 即更新): {dst}")


def _install_skills():
    # ★r1 正確性席:防線下移到真正動全域機器狀態的地方★——原本只擋四個指令入口,
    # 但 cmd_init → _vendor_toolchain → _install_hooks_py 這條路也會重連 ~/.claude/skills、繞過入口守衛。
    # 擋在這個變動原語,不論從哪個指令進來都擋得住。
    if _refuse_if_probe("install-skills"):
        return
    repo = Path(__file__).resolve().parent.parent
    dest = Path.home() / ".claude" / "skills"
    for s in _SKILLS:
        src = repo / "skills" / s
        if src.is_dir():
            _link_or_copy(src, dest / s)
            print(f"  ✓ skill {s}")
    # Codex 也讀同一個開放標準(agentskills.io):使用者層 ~/.agents/skills/(2026-09-04 隔離 HOME 實測會載入)。
    # ★開放共用目錄★:既有真目錄只有帶我方標記檔才重建,否則跳過+warn(別人的 skill 不能刪)。
    shared = Path.home() / ".agents" / "skills"
    for s in _SKILLS:
        src = repo / "skills" / s
        if src.is_dir():
            if _link_or_copy_shared(src, shared / s):
                print(f"  ✓ skill(codex) {s}")


def _link_or_copy_shared(src: Path, dst: Path) -> bool:
    """開放共用目錄版 _link_or_copy:dst 是「非我方」真目錄(不是 symlink/junction、沒有標記檔)→
    跳過+印一行,回 False;其餘交給 _link_or_copy(它會把 symlink/空夾/帶標記的複製物重建)。"""
    import os
    try:   # 我方裝的(symlink 或 Windows junction,realpath 都會解到 repo 的 skills/<名>)→ 直接重建,別當外方(r1 單reviewer F5)
        if dst.exists() and Path(os.path.realpath(dst)) == src.resolve():
            _link_or_copy(src, dst)
            return True
    except OSError:
        pass
    if dst.is_symlink():
        # 使用者自己的同名 symlink(指到 lumos skills/ 以外)也不能換掉(r1 外家 #2);指到我方或懸空的才重建
        try:
            tgt = dst.resolve(strict=True)
        except (OSError, RuntimeError):
            tgt = None
        mine = src.resolve().parent
        if tgt is not None and tgt != src.resolve() and mine not in tgt.parents and tgt != mine:
            print(f"  ⚠ 跳過 {dst}:已有不是 lumos 裝的同名連結(→ {tgt}),不覆蓋(要換成 lumos 版請先自己移走它)", file=sys.stderr)
            return False
    elif dst.is_dir():
        try:
            empty = not any(os.scandir(dst))
        except OSError:
            empty = False
        if not empty and not (dst / _SKILL_MARKER).exists():
            print(f"  ⚠ 跳過 {dst}:已有不是 lumos 裝的同名目錄,不覆蓋(要換成 lumos 版請先自己搬走它)", file=sys.stderr)
            return False
    _link_or_copy(src, dst)
    return True


_INIT_SUBDIRS_FULL = ("Systems", "Verification", "Projects", "Issues", "Sessions", "MOC")


def _scaffold_project(root: Path, slug: str):
    kg = root / "docs" / f"{slug}-knowledge"
    if kg.exists():
        print(f"  ✓ vault 已存在,跳過 scaffold(保護資料): {kg}")
        return
    for d in _INIT_SUBDIRS_FULL:
        (kg / d).mkdir(parents=True, exist_ok=True)
    _write_lf(kg / "MOC" / "index.md",
              f"---\ntype: moc\nstatus: doing\n---\n# {slug} 知識圖譜總索引\n")
    # ★帳檔落在 docs/(vault.parent,見 _append_governance_log 等),.gitignore 必須寫在同一層★——
    # 2026-06-26 起一直寫在 vault 內,對上一層的帳檔一個都沒忽略到(L4 清帳 2026-08-21 抓到:
    # 本 repo 帳檔因此全被追蹤,筆記「皆 gitignore」長期為假)。改寫到 docs/.gitignore;
    # 既有 repo 已追蹤的帳檔不受影響(gitignore 不 untrack),要不要 untrack 是另一個決定。
    # ★治理帳不在忽略清單裡★(消費專案接入靜默失效 [D]/[S6],2026-09-09):
    # 它是 CI 唯一讀得到表態與留痕的地方(_codeloop_read_from_ledger 的 docstring、
    # Systems/棧別提問表態閘 都這樣寫),忽略掉等於新專案接 CI 時那條路直接斷。
    # 其餘帳檔仍是本機流水,照舊忽略。
    _write_lf(kg.parent / ".gitignore",
              "# 本機流水帳(不進版控);★治理帳 .governance-log.jsonl 刻意不在這裡★——\n"
              "# CI 靠它讀代碼審留痕與棧別提問表態,忽略掉那條路就斷了。\n"
              ".bypass-log.jsonl\n.rot-queue.jsonl\n.canary-log.jsonl\n"
              ".kill-log.jsonl\n.signoff-log.jsonl\n.usage-log.jsonl\n.ci-log.jsonl\n")
    print(f"  ✓ scaffold {kg}(帳檔 .gitignore → {kg.parent / '.gitignore'})")


def _init_additive_setup(root: Path):
    """init 每一條路都要跑的「只加不覆寫」設定(★既有專案也拿得到★)。

    ★為什麼要從 scaffold 裡搬出來★(2026-09-09 r1 架構對齊席 f2):
    這兩樣本來寫在 _scaffold_project 裡,而那支開頭就是「vault 已存在 → 直接 return」,
    外面的 cmd_init 又對「已有 vault 且沒帶 --force」更早 return。兩層 guard 的用意都是
    ★保護既有 vault 的內容不被覆寫★——但新的產出借用同一把鎖等於被連坐:
    所有本來就有 vault 的既有消費專案(這批修的正是這種專案的接入靜默)不論怎麼跑 init
    都拿不到設定骨架與本機留痕的忽略設定。
    這兩件事本身都是「檔案不存在才寫」,不會覆寫任何東西,所以不需要那把鎖。"""
    # ★本機執行期狀態要忽略★:留痕/表態的 marker 綁著當下的版本號,
    # 提交出去等於把「某台機器某個時刻的狀態」散播給所有人,而且一提交版本就移動、自己作廢。
    gov_ignore = root / "governance" / ".gitignore"
    if not gov_ignore.exists():
        gov_ignore.parent.mkdir(parents=True, exist_ok=True)
        _write_lf(gov_ignore,
                  "# 這底下是 per-machine 的執行期狀態,不版控、不跨機當權威\n"
                  "# (CI 讀的是 docs/.governance-log.jsonl,那份刻意沒被忽略)。\n"
                  "# code-loop:代碼審留痕與棧別提問表態的本機標記,綁 HEAD 版本號——一提交版本就移動、自己作廢。\n"
                  "# runtime:hook 事件流水,每台機器各自的事實。★2026-09-09 補★:第一版漏了它,\n"
                  "# 而第一個接入的真專案(calc-ios)因此把 hook-events.jsonl 提交進版控。\n"
                  "code-loop/\n"
                  "runtime/\n")
        print(f"  ✓ 本機留痕的忽略設定 {gov_ignore}")
    _init_config_skeleton(root)


# 副檔名 → (test_profile, symbol_profile, 一句人話)。給 init 猜這個 repo 是什麼棧用。
# ★這張表是「反查」出來的,不是第三份副檔名清單★(r1 架構對齊席 f4,blocker):
# 第一版手打了 ext→profile 的對照,結果 `.vue` 寫成 symbol_profile "vue"、`.dart` 寫成 "dart",
# 而 SYMBOL_PROFILES 根本沒有這兩個鍵——init 猜中語言、卻把設定寫壞,之後每次讀設定都印
# 「未知 symbol_profile」再退回 C#。正典只有兩張表(TEST_PROFILES 的 exts、SYMBOL_PROFILES
# 的 code_exts),這裡一律從那兩張反查;手寫的只剩「人話標籤」與兩處歧義的取捨。
# ★只用來產「請你確認」的骨架,不當斷言★(消費專案接入靜默失效 [A]/S1;r1 邊界席 f5 要求多語言走多平台格式)
_STACK_HUMAN = {
    ".swift": "iOS / Swift", ".kt": "Android / Kotlin", ".kts": "Android / Kotlin",
    ".java": "Java", ".cs": ".NET / C#", ".py": "Python", ".dart": "Flutter / Dart",
    ".ts": "TypeScript / Node", ".tsx": "TypeScript / React", ".mts": "TypeScript",
    ".cts": "TypeScript", ".js": "JavaScript / Node", ".jsx": "JavaScript / React",
    ".mjs": "JavaScript", ".cjs": "JavaScript", ".vue": "Vue", ".sql": "SQL", ".ps1": "PowerShell",
}
# 一個副檔名被多個 test profile 認領時挑誰(唯一的人工取捨,寫明理由):
# .ts/.js 家族同時屬於 node-jest(單元測試)與 playwright(端對端)——骨架先給單元測試那條,
# 端對端專案自己改。這是偏好不是事實,所以骨架照樣標「推測」。
_STACK_PREFER_TEST = {"node-jest": 2, "playwright": 1}
# 拿來猜棧會全錯的副檔名:yaml/yml 在幾乎每個 repo 都是 CI/設定檔,數量還常常最多。
_STACK_GUESS_SKIP_EXTS = {".yaml", ".yml"}


_STACK_GUESS_CACHE = None   # 整支 CLI 跑期算一次(模組級單例,同 _TESTMAP_DIR_RE 的既有寫法)


def _stack_guess():
    """副檔名 → {test, symbol, human, symbol_weak}。反查自兩張正典表,結果 cache。

    ★對不到就留空字串,不硬湊★:例如 `.dart` 沒有任何 symbol profile 認領、`.vue` 沒有任何
    test profile 認領。留空的後果是 init 產出的骨架該欄是空的,而健檢 S3 會唸「你的程式碼是
    這種副檔名、但設定認的是別的」——比硬填一個不存在的值好,因為那個值只會換來每次讀設定
    都印一行警告、而且永遠沒人知道為什麼。"""
    global _STACK_GUESS_CACHE
    if _STACK_GUESS_CACHE is not None:
        return _STACK_GUESS_CACHE
    tp_by_ext, sp_by_ext = {}, {}
    for name, prof in TEST_PROFILES.items():
        for ext in (prof.get("exts") or ()):
            if ext in _STACK_GUESS_SKIP_EXTS:
                continue
            cur = tp_by_ext.get(ext)
            if cur is None or _STACK_PREFER_TEST.get(name, 0) > _STACK_PREFER_TEST.get(cur, 0):
                tp_by_ext[ext] = name
    for name, prof in SYMBOL_PROFILES.items():
        for ext in (prof.get("code_exts") or ()):
            sp_by_ext.setdefault(ext, [])
            sp_by_ext[ext].append(name)
    # 一個副檔名被多個 symbol profile 認領時,★挑跟測試 profile 同一種語言的那個★——
    # 判準也是反查出來的,不再多開一張表:哪個 symbol profile 的副檔名跟這支測試 profile
    # 重疊最多,就當它們是同一種語言。實例:`.js` 同時被 csharp(它的清單裡混了 .vue/.js/.sql)
    # 與 typescript 認領,而 .js 的測試 profile 是 node-jest,跟 typescript 重疊 6 個、
    # 跟 csharp 只重疊 1 個 → 挑 typescript。沒挑到就退回「有認領的隨便一個」。
    partner = {}
    for tname, tprof in TEST_PROFILES.items():
        texts = set(tprof.get("exts") or ())
        best, best_n = "", 0
        for sname, sprof in SYMBOL_PROFILES.items():
            n = len(texts & set(sprof.get("code_exts") or ()))
            if n > best_n:
                best, best_n = sname, n
        partner[tname] = best
    out = {}
    for ext in set(tp_by_ext) | set(sp_by_ext):
        if ext in _STACK_GUESS_SKIP_EXTS:
            continue
        owners = sp_by_ext.get(ext) or []
        pick = partner.get(tp_by_ext.get(ext, ""), "")
        sp = pick if pick in owners else (owners[0] if owners else "")
        # ★猜得弱要講出來★(2026-09-09 代碼審 r2 f4):`.vue`/`.sql`/`.ps1` 只有 csharp 那份
        # 副檔名清單收了它們(那是「C# 店裡也會有的檔」的意思,不是「這是 C# 專案」)。
        # 反查因此會把一個以 Vue/SQL/PowerShell 為主的專案猜成 symbol_profile csharp——
        # 值合法、所有檢查都不唸,等於把 r1 修掉的「猜錯沒人知道」換成更隱蔽的版本。
        # weak=True 表示「這個 profile 不是為這個副檔名而生的,只是碰巧收了它」。
        weak = bool(sp) and sp != pick
        out[ext] = {"test": tp_by_ext.get(ext, ""), "symbol": sp,
                    "human": _STACK_HUMAN.get(ext, ext), "symbol_weak": weak}
    _STACK_GUESS_CACHE = out
    return out


_SKELETON_RUN_CMD = {
    # 骨架裡先給一個「形狀對」的指令當起點——★重點是形狀,不是它在你機器上跑得動★。
    # xcodebuild 那條刻意寫滿三段(target/類別/方法):少寫一段會讓過濾條件對不到任何測試,
    # 而那正是 2026-09-09 在第一個 iOS 專案上抓到的假綠來源。
    # ★也刻意不帶 -quiet★(2026-09-09 r1 折入,實測):-quiet 會把「Executed N tests」那行藏起來,
    # 而那行是這道閘唯一能證明「真的跑了東西」的證據——帶了 -quiet,跑 1 支跟跑 0 支的輸出一模一樣。
    "swift-xctest": "xcodebuild test -scheme <你的 scheme> -destination 'platform=iOS Simulator,name=<模擬器名>' -only-testing:<測試 target>/<測試類別>/{method}",
    "kotlin-junit": "./gradlew test --tests '*{method}'",
    # Java 專案分 Gradle 與 Maven 兩種建置,骨架先給 Gradle 形(跟 kotlin-junit 同一條,
    # 混編專案直接沿用);Maven 專案自己換成 `mvn -Dtest='<測試類別>#{method}' test`。
    # ★本機沒裝 gradle/mvn,這兩條指令沒有實跑核對過★,只保證形狀對(要能只跑一支測試)。
    "java-junit": "./gradlew test --tests '*{method}'",
    # ★尾巴那段 runsettings 不能省★(2026-09-09 r1 折入,dotnet 9.0.117 實測):
    # 沒有它,`dotnet test --filter` 對一個根本不存在的測試名照樣印「No test matches」然後回 0,
    # 閘拿退出碼當「測試跑過」就是假綠;加上去之後同一條指令回 1,對到真測試時仍回 0。
    "csharp-xunit": "dotnet test --filter FullyQualifiedName~{method} -- RunConfiguration.TreatNoTestsAsError=true",
    "python": "python3 -m pytest -k {method}",
    # jest 沒有對應的旗標(29.x 實測:-t 對不到任何測試仍回 0,--passWithNoTests=false 也一樣)——
    # 這條靠下面的「跑過的證據」比對摘要行,不靠退出碼。
    "node-jest": "npx jest -t {method}",
    "dart": "flutter test --plain-name {method}",
    "playwright": "npx playwright test -g {method}",
}

# 掃 repo 猜技術棧時一律略過的目錄(★兩支掃描共用同一份★——r1 單reviewer f4:
# 兩邊各有一份且內容不同時,init 猜出來的骨架跟健檢驗的東西會對不上,
# 「猜錯沒人知道」正好在自己身上重演一次)。
# ★只放「不是人寫的原始碼」的目錄★:相依套件、建置產物、工具自己的目錄。
# 合併時特意★把 scripts 從名單裡拿掉★:它原本只在健檢那份裡,而那是普通的原始碼目錄
# ——照舊略過的話,本 repo 自己的 Python 全在 scripts/ 底下,健檢就再也抓不到
# 「這個 repo 從沒設 symbol_profile、一直吃 C# 預設」那一條真的問題(實測會從 1 條變 0 條)。
# vault 用「目錄名結尾 -knowledge」認,不整個 docs/ 略過(專案可能在 docs/ 放範例程式)。
_STACK_SCAN_SKIP = {"node_modules", ".git", "build", "DerivedData", "dist", "vendor",
                    "Pods", ".venv", "venv", ".gradle", ".build", "target",
                    "governance", ".lumos"}


def _stack_scan_skip(name):
    return name in _STACK_SCAN_SKIP or name.endswith("-knowledge")


def _stack_ext_counts(root):
    """數 repo 裡各種程式碼副檔名各有幾個檔。回 {ext: n}。

    ★用 os.walk 就地剪枝,不是 rglob 之後再過濾★(r1 單reviewer f5,實測):
    rglob 會先把 node_modules 底下 2000 個檔全部走過一遍才被丟掉——略過名單對它想排除的
    正是最大的那幾個目錄完全沒省到。健檢每次都跑這段,大型專案會隨依賴目錄大小線性變慢。"""
    import os as _os
    counts = {}
    known = _stack_guess()
    # ★lumos 自己安裝進來的檔不算這個專案的技術棧★(2026-09-10,一個小 Vue 專案上實撞):
    # init 會把 CLI、自己的測試檔和五支 hook 複製到消費專案的 scripts/ 底下,那是八個 .py。
    # 那個專案自己只有六個 .js,於是健檢反過來唸「你有 8 個 .py,測試設定卻只認 .js」——
    # 舉的證據全是 lumos 自己的檔,而且專案愈小愈容易被唸,正好唸在剛接入的人臉上。
    # ★只跳過工具確實安裝的那幾支檔(精確檔名,見 _VENDORED_ALL)★,同目錄底下專案自己的檔照樣算
    # ——第一版照目錄前綴跳過,代碼審 r1 抓到專案自己的 hook 程式也被一起跳過。
    _base = _os.path.abspath(str(root))
    # 工具鏈本體那裡 scripts/lumos 就是產品,一支都不跳;消費專案只跳「內容跟安裝時一模一樣」的工具檔
    _skip = frozenset() if _is_toolchain_repo(root) else _vendored_state(root)[0]
    for dirpath, dirnames, filenames in _os.walk(_base):
        dirnames[:] = [d for d in dirnames if not _stack_scan_skip(d)]
        rd = _os.path.relpath(dirpath, _base)
        for fn in filenames:
            ext = _os.path.splitext(fn)[1].lower()
            if ext not in known:
                continue
            if _skip and _posix_norm(fn if rd == "." else _os.path.join(rd, fn)) in _skip:
                continue
            counts[ext] = counts.get(ext, 0) + 1
    return counts


def _profile_stack_mismatch(root):
    """設定的技術棧跟 repo 裡實際的程式碼對不對得上(消費專案接入靜默失效 [B]/S2)。

    ★只看實際副檔名,不看值是預設還是設定檔寫的★——寫成「跟預設不符」的話,
    init 產出的骨架一寫進去值就不是預設了,猜錯也永遠不會出聲(r1 外家備援席 f2)。
    回一串人話;對得上回空 list。"""
    if not root:
        return []   # vault 不在 git repo 底下(測試 fixture、--vault 指到別處):沒有 repo 可比,靜默跳過
    root = Path(root)
    counts = _stack_ext_counts(root)
    if not counts:
        return []
    test_msgs, sym_msgs = [], []
    try:
        pdata = load_platforms(root)
    except Exception:
        pdata = {"multiplatform": False, "platforms": {}}
    if pdata.get("multiplatform"):
        covered = set()
        for pe in pdata["platforms"].values():
            # ★"profile" 存的是攤開後的 profile 物件,不是名字★(2026-09-10 修):
            # 拿它去 TEST_PROFILES 查表 = 用 dict 當 key,直接丟 TypeError 把整支 doctor
            # 中斷在這一段。名字要用的話在隔壁的 "profile_name"。
            _pe_prof = pe.get("profile")
            if not isinstance(_pe_prof, dict):
                _pe_prof = TEST_PROFILES.get(_pe_prof) or {}
            covered |= set(_pe_prof.get("exts") or [])
    else:
        covered = set(load_test_profile(root).get("exts") or [])
    # 只唸「數量夠多、卻沒有任何平台的測試 profile 認得」的副檔名(散落幾個檔不算)。
    # ★門檻不只看絕對數量,也看它佔不佔份量★:本 repo 實測——它是 Python 專案,
    # 但安裝腳本有 4 個 .ps1,只用「≥3 個」的話會唸一句「你的測試設定掃不到這些 .ps1」,
    # 而那裡面根本沒有測試。改成「還要不少於最大宗的四分之一」就只剩真的那幾條。
    _top = max(counts.values())
    _floor = max(3, _top / 4)
    for ext, n in sorted(counts.items(), key=lambda kv: -kv[1]):
        if n >= _floor and ext not in covered:
            test_msgs.append(f"專案裡有 {n} 個 {ext} 檔,但測試設定認的是 {sorted(covered) or '(預設 C#)'}——掃不到這些檔裡的測試")
    sym, _neg = load_symbol_profile(root)
    sym_ordered = list(sym.get("code_exts") or [])
    sym_exts = set(sym_ordered)
    # ★主要副檔名一個都沒有=這個設定八成不是為這個 repo 挑的★(r2 f4):
    # 每個符號 profile 的清單第一個副檔名是它的本命(csharp→.cs、swift→.swift…),
    # 後面那些是「這種店裡也會有的檔」(csharp 收了 .vue/.sql/.ps1)。所以一個 Vue 專案
    # 反查會得到 csharp——值合法、上面兩組都不唸,因為 .vue 確實在 csharp 清單裡。
    # 這一條專門補那個洞:本命副檔名掛零就出聲。
    if sym_ordered and counts.get(sym_ordered[0], 0) == 0:
        sym_msgs.append(f"符號設定認的本命副檔名是 {sym_ordered[0]},但這個專案一個 {sym_ordered[0]} 檔都沒有"
                        f"(它還認 {sorted(sym_exts - {sym_ordered[0]})},所以不會被上面那條唸到)"
                        "——這個設定八成不是為這個專案挑的")
    for ext, n in sorted(counts.items(), key=lambda kv: -kv[1]):
        if n >= _floor and ext not in sym_exts:
            sym_msgs.append(f"專案裡有 {n} 個 {ext} 檔,但 symbol_profile 認的是 {sorted(sym_exts)}——筆記提到的符號在這些檔裡查不到也不會報")
    # ★兩組各自留額度,截斷要說實話★(r1 單reviewer f3,實測):
    # 舊寫法是兩組接成一串再 out[:8],而測試那組永遠排在前面——symbol_profile 那整類
    # 在副檔名一多的專案會被整批吃掉,而且標頭照印「有 8 項」,看不出還有沒講的。
    # ★跟健檢的 _soft_list 是同一個 idiom,故意沒抽成共用函式★(r2 架構席 f3):
    # 那支定義在 run_doctor 內部、吃單一 list、直接印出去回 None,裝不下「兩組各留額度、
    # 回傳 list 給呼叫端」;為了這五行去改它會動到十個既有呼叫點。文案對齊成同一種說法
    # (「… 還有 N 條」),以後改動任一邊請回頭看另一邊——scripts/lumos 的 _soft_list。
    cap, out = 4, []
    for group in (test_msgs, sym_msgs):
        out.extend(group[:cap])
        if len(group) > cap:
            out.append(f"… 還有 {len(group) - cap} 條(同一類)")
    return out


def _config_left_blank(root):
    """設定骨架產了但沒填(消費專案接入靜默失效 [B];r1 單reviewer f9)。

    為什麼要另外驗:猜不到技術棧時骨架會把 test_profile / symbol_profile 寫成空字串,
    而讀設定那支對空字串一律靜默退回 csharp 預設——清單外的語言(Rust、Go…)因此
    第一天起兩個關鍵設定都錯,而且 S3 靠副檔名比對也抓不到(它只認得出正典表裡的副檔名)。
    這一條純粹看「骨架欄位還空著沒有」,跟語言無關。"""
    import json as _json
    if not root:
        return []
    cfg_path = Path(root) / ".lumos" / "config.json"
    if not cfg_path.exists():
        return []
    try:
        cfg = _json.loads(cfg_path.read_text(encoding="utf-8"))
    except Exception:
        return ["`.lumos/config.json` 解析失敗——整份設定會被當作不存在,測試 profile 與符號 profile 都退回 C# 預設"]
    if not isinstance(cfg, dict):
        return []
    out = []
    if not cfg.get("test_profile") and not cfg.get("platforms"):
        out.append("`.lumos/config.json` 的 test_profile 還是空的——掃不到你的測試,合約綁不上任何東西(閘會靜默放行)")
    if not cfg.get("symbol_profile"):
        out.append("`.lumos/config.json` 的 symbol_profile 還是空的——符號檢查會用 C# 的副檔名清單,對你的程式碼視而不見")
    return out


def _init_config_skeleton(root):
    """init 產出 .lumos/config.json 骨架(消費專案接入靜默失效 [A]/S1)。

    為什麼要產:不產的話 test_profile 與 symbol_profile 各自退回 csharp 預設,
    非 C# 專案第一天起兩個關鍵設定都錯而且★沒有任何提示★——2026-09-09 第一個 iOS 專案實地踩到。
    既有設定一律不覆寫;猜到的棧一律標「推測」不當斷言;多語言走既有 platforms 多根多 profile 格式。"""
    import json as _j
    cfg_path = Path(root) / ".lumos" / "config.json"
    if cfg_path.exists():
        return   # 既有設定不碰
    guess = _stack_guess()
    counts = _stack_ext_counts(root)
    ranked = sorted(counts.items(), key=lambda kv: -kv[1])
    # ★不能寫 // 註解★:這是要被 json.loads 讀的檔,加註解會讓整份設定解析失敗、退回預設,
    # 反而製造出這批要解的那種靜默。說明一律走 JSON 欄位。
    note = ("這份是 lumos init 產出的骨架,裡面的技術棧是用副檔名推測的——請開檔確認。"
            "猜錯的話兩件事會靜默失效:掃不到你的測試(合約綁不上)、符號檢查對你的程式碼視而不見。"
            "確認完可以把這個 _請先確認 欄位刪掉。")
    blank = {"_說明": "偵測不到已知的技術棧。填 test_profile(可選:%s)與 symbol_profile(可選:%s),並把 run_cmd 改成你專案跑單一測試的指令(必須帶 {method} 佔位符,而且對不存在的測試名要回非零或在輸出裡數得出跑了幾支)" % ("/".join(sorted(TEST_PROFILES)), "/".join(sorted(SYMBOL_PROFILES))),
             "test_profile": "", "symbol_profile": "", "test": {"run_cmd": ""}}
    if not ranked:
        body = blank
    elif len(ranked) == 1 or ranked[0][1] > sum(c for _, c in ranked[1:]) * 3:
        ext = ranked[0][0]
        g = guess[ext]
        tp, sp, human = g["test"], g["symbol"], g["human"]
        body = {"_推測": f"看到 {counts[ext]} 個 {ext} 檔,猜這是 {human} 專案——不對就改",
                "test_profile": tp, "symbol_profile": sp,
                "test": {"run_cmd": _SKELETON_RUN_CMD.get(tp, "")}}
        if not tp or not sp:
            body["_請自己填"] = ("這個副檔名在正典表裡只被其中一種 profile 認領,另一個留空給你填:"
                                f"test_profile 可選 {'/'.join(sorted(TEST_PROFILES))};"
                                f"symbol_profile 可選 {'/'.join(sorted(SYMBOL_PROFILES))}")
        if g["symbol_weak"]:
            body["_這個猜得很弱"] = (f"symbol_profile 猜成 {sp},只是因為 {sp} 的副檔名清單裡碰巧收了 {ext}"
                                    f"——那不代表這是 {sp} 專案。符號檢查會用 {sp} 的清單去找筆記提到的符號,"
                                    "對不上就整批查不到也不會報。請自己確認,可選:"
                                    f"{'/'.join(sorted(SYMBOL_PROFILES))}")
    else:
        plats = {}
        # ★每一種偵測得到的語言都要列出來,不能只取前幾名★(2026-09-12 多語言驗證 repo 實撞):
        # 原本是 ranked[:3],一個九種語言的 repo 只會產出三個平台,其餘六種的測試從此掃不到——
        # 而掃不到的症狀不是報錯,是合約綁不上、閘靜默放行。多列一個平台的代價只是使用者刪一段設定,
        # 少列一個的代價是那個語言的守衛整批不存在,兩邊不對等。
        for ext, n in ranked:
            g = guess[ext]
            tp, sp, human = g["test"], g["symbol"], g["human"]
            if not tp:
                continue
            plats.setdefault(tp.split("-")[0], {"profile": tp, "root": ".", "run_cmd": _SKELETON_RUN_CMD.get(tp, ""),
                                                "_推測": f"看到 {n} 個 {ext} 檔({human})"})
        if not plats:
            body = blank
        else:
            body = {"_推測": "看到多種語言,用多平台格式(每個平台各自的 root/profile/run_cmd)——請確認並把 root 改成各平台真正的目錄;偵測得到的語言全部列出來了,不需要的平台整段刪掉就好",
                    "default_platform": next(iter(plats)), "platforms": plats,
                    "symbol_profile": guess[ranked[0][0]]["symbol"]}
    cfg_path.parent.mkdir(parents=True, exist_ok=True)
    body = {"_請先確認": note, **body}
    _write_lf(cfg_path, _j.dumps(body, ensure_ascii=False, indent=2) + "\n")
    print(f"  ✓ 設定骨架 {cfg_path}(★技術棧是推測的,請開檔確認★——猜錯會讓測試掃描與符號檢查靜默失效)")


_GLOBAL_CLAUDE_HOOKS = ("check-graph-sync.py", "impact-hook.py", "ci-status-hook.py", "lumos-entry-hook.py", "dispatch-lens-hook.py",
                        "memory-sweep.py",
                        # ★共用模組也要複製★(2026-09-08 code-enforcement-obs r1 外家席 blocker):
                        # 五支 hook 都 `from _hookevent import guard`。沒複製它 → 安裝副本 import 失敗
                        # → 退回不記事件 → enforcement 對那五列永遠 unknown。★裝了等於沒裝★,
                        # 而且來源樹的測試照樣全綠(測的是來源樹,不是安裝副本)。
                        "_hookevent.py")
_GLOBAL_HOOKS = _GLOBAL_CLAUDE_HOOKS   # 兩家共用同一批檔(Claude→~/.claude/hooks、Codex→~/.codex/hooks;Projects/Codex完全支援_計劃 d2);舊名留給既有呼叫/測試
_SKILL_MARKER = ".lumos-managed"       # fallback 複製出的 skill 目錄帶此標記檔;開放共用目錄只重建帶標記的(r2 邊界 N1)
_HARNESS_HOME = {"claude": (".claude", "settings.json"), "codex": (".codex", "hooks.json")}
# ★撤除 hook 要分兩階段,不能一刀刪檔★(2026-08-22 立;症狀真實發生過)
#
# 症狀:`lumos install` 把已撤除 hook 的真檔刪掉,但★正在跑的 session★在啟動當下讀進的
# settings 快照裡還註冊著那支——檔案不在了,那些 session 每次觸發都報錯。2026-08-22 有人
# 為此手寫空殼補回去兩次(每跑一次 install 就被刪一次)。
#
# 兩階段:
#   階段一 STUB   —— 這一版換成 exit 0 空殼。舊 session 照樣觸發、什麼都不做、不報錯;
#                     新 session 讀到的 settings 已剪乾淨,根本不會叫它。
#   階段二 DELETE —— 確認沒有 session 還帶著舊註冊(隔一版/隔一天)才真刪檔。
# 撤新的 hook:先加進 STUB;下一版把它從 STUB 移到 DELETE。
#
# code-loop-guard.py:2026-07-06 ADR 撤除 Stop nag(見 Projects/code-loop必用守衛_計劃)——早過相容期,直接刪。
# verification-rot-check.py:2026-08-21 體檢 #8 撤除(核心從未觸發、每次 Bash 付啟動成本;
#   見 Verification/2026-08-21_工具鏈體檢修復批)——相容期中,留空殼。
# 相容期空殼:剛撤的 hook 先換成 exit 0 的空殼,不刪檔——正在跑的 session 讀進的 settings
# 快照可能還註冊著它,真檔一刪那些 session 每次觸發都報錯(2026-08-22 實際發生過)。
# 下一版把名字從這裡移到 _RETIRED_CLAUDE_HOOKS 就是真刪。
_RETIRED_STUB_CLAUDE_HOOKS = ()
# 真刪:相容期已過。verification-rot-check.py 2026-08-22 撤除、2026-09-06 真刪(相容期兩週,
# 遠超「舊 session 還活著」的實際窗口;它的取代品 Systems/verification-rot-eval 是 design-only
# 從未實作,同日結案)。
_RETIRED_CLAUDE_HOOKS = ("code-loop-guard.py", "verification-rot-check.py")

_RETIRED_HOOK_STUB_BODY = (
    "#!/usr/bin/env python3\n"
    '"""已撤除 hook 的相容期空殼——什麼都不做,直接放行。\n'
    "\n"
    "存在的唯一理由:正在跑的 session 在啟動當下讀進的 settings 快照可能還註冊著這支。\n"
    "真檔一旦刪掉,那些 session 每次觸發都會報錯(2026-08-22 實際發生過)。新開的\n"
    "session 讀到的 settings 已經剪乾淨,不會叫到這裡。\n"
    "\n"
    "下一版從 _RETIRED_STUB_CLAUDE_HOOKS 移到 _RETIRED_CLAUDE_HOOKS 即真刪。\n"
    '"""\n'
    "import sys\n"
    "\n"
    "sys.exit(0)\n"
)


def _codex_home(home=None) -> Path:
    """Codex 的家目錄:$CODEX_HOME 優先(Codex 自己就這樣找 config/hooks;r1 外家 #1),否則 ~/.codex。"""
    import os
    env = os.environ.get("CODEX_HOME")
    if env:
        return Path(env).expanduser()
    return (Path(home) if home else Path.home()) / ".codex"


def _codex_present(home=None) -> bool:
    """本機有沒有 Codex:★單一判準=Codex 家目錄(~/.codex 或 $CODEX_HOME)在不在★,不看 PATH——
    install/teardown/enforcement 三處共用同一個答案(code-codex-s0 r1 架構席:曾兩套判準分岔);
    codex 第一次跑就會建家目錄,「有 binary 沒目錄」=還沒用過,等用過再 lumos install --force 即可。"""
    return _codex_home(home).is_dir()


def _sync_global_claude(src_repo: Path):
    """相容包裝:Claude 側同步,回 True=ok(既有呼叫/測試用)。三態版見 _sync_global_hooks。"""
    return _sync_global_hooks(src_repo, "claude") == "ok"


def _sync_global_hooks(src_repo: Path, harness: str) -> str:
    """全域 hooks/註冊同步(不需專案;install 與 _install_hooks_py 共用)。harness=claude|codex:
    claude → ~/.claude/hooks + settings.json;codex → ~/.codex/hooks + hooks.json(合併器 --target codex)。
    ①copy 現役 hooks ②刪已撤除 hook 殘留真檔 ③跑 merge-claude-settings(_prune_dangling 剪懸空註冊)④codex 專用:寫自訂審查席 TOML(d6)。
    來源=src_repo(install 用來源 repo 自身、update 用專案 vendored copy);HOME 隔離可測。
    回三態字串:ok / probe(探針擋下,沒動) / merge-failed(hooks 設定檔壞或合併器非 0,hook 檔已 copy 但註冊沒更新)
    / absent(codex 專用:本機無 codex,跳過)。★不共用一顆布林★——False 曾被呼叫端寫死解讀成 LUMOS_PROBE,
    設定檔壞掉會印出誤導訊息(Projects/Codex完全支援_計劃 r2 邊界 N2)。"""
    # ★r1 正確性席:同 _install_skills——cmd_init/_vendor_toolchain 這條路會經此覆寫真的 ~/.claude/hooks
    # 與動 settings.json,繞過四個指令入口的守衛。擋在變動原語。
    if _refuse_if_probe(f"sync-global-{harness}"):
        return "probe"
    if harness == "codex":
        _ch = _codex_home()
        if _ch.exists() and not _ch.is_dir():   # r1 單reviewer F1:~/.codex 是檔案,mkdir 會炸穿整支 install
            return "home-not-dir"
        if not _codex_present():
            return "absent"
    import subprocess, shutil
    hdir, _ = _HARNESS_HOME[harness]
    chooks = (_codex_home() if harness == "codex" else Path.home() / hdir) / "hooks"
    chooks.mkdir(parents=True, exist_ok=True)
    src_dir = src_repo / "scripts" / "hooks" / "claude"
    for f in _GLOBAL_HOOKS:                   # ① 現役 hooks copy(兩家同一批檔)
        s = src_dir / f
        if s.exists():
            shutil.copy2(s, chooks / f)
    for f in _RETIRED_STUB_CLAUDE_HOOKS:      # ②a 相容期:換 exit 0 空殼,★不刪檔★
        stub = chooks / f                     #     (刪了會炸掉還帶著舊註冊的 session)
        if stub.is_symlink():
            stub.unlink()                     #     symlink 先拆,免得寫穿到來源檔
        stub.write_text(_RETIRED_HOOK_STUB_BODY, encoding="utf-8")
        stub.chmod(0o755)
    for f in _RETIRED_CLAUDE_HOOKS:           # ②b 過了相容期:真刪殘留檔
        stale = chooks / f
        if stale.exists() or stale.is_symlink():
            stale.unlink()
    merge = src_repo / "scripts" / "merge-claude-settings.py"  # ③ merge+prune 懸空(含②剛變懸空的)
    if merge.exists():
        args = [sys.executable, str(merge)] + (["--target", "codex"] if harness == "codex" else [])
        r = subprocess.run(args)
        if r.returncode != 0:              # 合併器只在設定檔 JSON 壞時回 1:別當成功
            return "merge-failed"
    if harness == "codex":                 # ④ 自訂審查席 TOML(d6)——刻意放在合併器之後:設定檔壞掉(merge-failed)就整個 Codex 側不算裝好,
                                           #    TOML 不寫、下次 install --force 再補;hook 檔 copy 在前面已做(自癒無害)(code-codex-d6 r1 單reviewer F3)
        st = _install_codex_agent()
        if st == "created":
            print(f"  ✓ Codex 自訂審查席已寫三份:")
            print(f"      {_CODEX_AGENT_NAME:<22} 散文審(設計審),{_CODEX_SEAT_MODEL} + medium —— 也是預設")
            print(f"      {_CODEX_AGENT_CODE_NAME:<22} 程式碼審(一般風險),{_CODEX_SEAT_MODEL} + xhigh")
            print(f"      {_CODEX_AGENT_MAX_NAME:<22} 程式碼審(高風險),{_CODEX_SEAT_MODEL} + xhigh")
            print(f"    派工詞點名哪一個就用哪一個;0.153.2 實測選得中、0.144.1 忽略;唯讀仍靠父代理 --sandbox read-only")
    return "ok"


_CODEX_AGENT_NAME = "lumos_reviewer"   # 底線:模型 spawn 時會把連字號正規化成底線(2026-09-04 實看)
# 第三種「我方」標記(sentinel HTML 註解給 markdown、.lumos-managed 檔給目錄):TOML 檔只能用行註解當標記,不是另立做法
_CODEX_AGENT_MARK = "# lumos-managed: 由 lumos install 寫入,teardown 收走;改範本請改 scripts/lumos"
_CODEX_AGENT_CODE_NAME = "lumos_reviewer_code"  # 程式碼審(一般風險)
_CODEX_AGENT_MAX_NAME = "lumos_reviewer_max"   # 程式碼審(高風險);09-11 起與一般程式碼審同設定,見下方註解
_CODEX_AGENT_INSTRUCTIONS = """你是 lumos 的外部審查席(乾淨脈絡,不帶編排者的結論)。只讀不寫、不改任何檔。
每條 finding 一行獨立 severity: clean|minor|major|blocker、一行 blocking: 是|否、一行 引句:「逐字出自審材」、引程式碼寫 file: `路徑:行號`。
blocker/major 要附能翻紅的最小重現,附不出標「未能重現」。沒問題的節寫「已讀,無 finding」。最後一行總結最嚴重 severity 與 blocking 條數。"""

# ★三席分流(2026-09-07 立兩席,09-08 Enzo 再裁拆成三席;2026-09-11 Enzo 裁三席一律降到 Sol)★
#
#   散文審(設計審)  lumos_reviewer       sol + medium   ← 也是預設
#   程式碼審(一般)  lumos_reviewer_code  sol + xhigh
#   程式碼審(高風險) lumos_reviewer_max   sol + xhigh
#
# ★2026-09-11 為什麼全部降到 Sol★:外家席額度常撞上限——當天代碼審第二輪,Codex 席跑到一半
#   「You've hit your usage limit」,換 Sol 也一樣被擋到額度重置(額度是整個帳號共用)。
#   降一級模型是為了讓同一段額度撐更多席;推理強度照舊分 medium / xhigh。三個席名保留,
#   派工詞與範本不用改;高風險席與一般程式碼審席現在設定相同,之後要再拉開只改這裡的常數。
# ★為什麼散文審只給 medium★:2026-09-08 實測,拿 xhigh 去審一份 8k 字元的 README 語感,
#   慢到使用者當場喊停。挑中文語感這種題目不需要深推理;xhigh 該留給「爆炸半徑判不出來」
#   那種要真的想很久的題目。**推理強度要配題目,不是越高越好——它的成本是牆鐘時間,
#   而審查慢到讓人不想派,就等於沒有這道防線。**
# ★舊版(09-08~09-11)高風險席用 astra 的理由★:Astra 在 Plus 方案的額度很緊(查到每 5 小時 5–45 則,未實測),
#   全用它會一輪吃光、之後退回「沒有外家席」——[[Issues/外家席長期缺席仍照跑loop]]
#   記過這個前科(九個審查席全同一家族)。09-11 起連 terra 都常撞上限,所以一律降到 Sol。
# ★model / model_reasoning_effort 兩個欄位都是實測有效的★(2026-09-07,codex-cli 0.153.2):
#   給用不了的模型 → 席位啟動失敗噴 400;給亂填的強度 → 明確報錯並列出支援值。
#   ⚠ 別用「叫席位自報模型代號」來驗——實測它會答錯(TOML 指定 5.4-mini,它自報 GPT-6)。
def _codex_agent_toml(name: str, model: str, effort: str, why: str) -> str:
    return _CODEX_AGENT_MARK + f'''
name = "{name}"
description = "lumos 的乾淨審查席({why}):設計審/代碼審派工詞點名 {name} 時使用。只讀不寫,逐條 finding 附 severity 與逐字引句。"
developer_instructions = """{_CODEX_AGENT_INSTRUCTIONS}"""
model = "{model}"
model_reasoning_effort = "{effort}"
sandbox_mode = "read-only"
'''


_CODEX_SEAT_MODEL = "gpt-5.6-sol"   # 三席共用(2026-09-11 Enzo 裁:額度常撞上限,降到 Sol);要拉開再各自給
_CODEX_AGENT_TOML = _codex_agent_toml(_CODEX_AGENT_NAME, _CODEX_SEAT_MODEL, "medium", "散文審,也是預設")
_CODEX_AGENT_CODE_TOML = _codex_agent_toml(_CODEX_AGENT_CODE_NAME, _CODEX_SEAT_MODEL, "xhigh", "程式碼審")
_CODEX_AGENT_MAX_TOML = _codex_agent_toml(_CODEX_AGENT_MAX_NAME, _CODEX_SEAT_MODEL, "xhigh", "程式碼審,高風險")
_CODEX_SEATS = ((_CODEX_AGENT_NAME, _CODEX_AGENT_TOML),
                (_CODEX_AGENT_CODE_NAME, _CODEX_AGENT_CODE_TOML),
                (_CODEX_AGENT_MAX_NAME, _CODEX_AGENT_MAX_TOML))


def _install_codex_agent(home=None) -> str:
    """Codex 自訂審查席(d6,2026-09-05):寫 CODEX_HOME/agents/lumos_reviewer.toml。0.153.2 實測派工詞點名選得中;0.144.1 忽略(無害)。
    ★sandbox_mode 只當提示,實測不擋寫檔——唯讀靠父代理 --sandbox read-only★。回 created|unchanged|skipped-foreign|skipped-not-dir(對齊 _reinject_claude_block 的 created/unchanged 詞彙)。"""
    d = _codex_home(home) / "agents"
    if d.exists() and not d.is_dir():      # agents 是檔案不是目錄 → 講清楚、不炸穿整次同步(code-codex-d6 r1 外家 #1)
        print(f"  ⚠ {d} 不是目錄,略過自訂審查席 TOML(搬走那個檔再跑 lumos install --force)", file=sys.stderr)
        return "skipped-not-dir"
    try:
        d.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        print(f"  ⚠ 建不了 {d}({e}),略過自訂審查席 TOML", file=sys.stderr)
        return "skipped-not-dir"
    states = []
    for nm, toml in _CODEX_SEATS:
        f = d / f"{nm}.toml"
        if f.exists():
            cur = f.read_text(encoding="utf-8", errors="replace")
            if _CODEX_AGENT_MARK not in cur:
                print(f"  ⚠ {f} 已存在且不是 lumos 寫的,保留不動(要用 lumos 版請先自己移走)", file=sys.stderr)
                states.append("skipped-foreign"); continue
            if cur == toml:
                states.append("unchanged"); continue
        f.write_text(toml, encoding="utf-8")
        states.append("created")
    for pref in ("skipped-foreign", "created"):   # 優先序:別人的檔優先講,其次「寫了」,全同才算 unchanged
        if pref in states:
            return pref
    return "unchanged"


def _remove_codex_agent(home=None) -> list:
    """teardown 對稱:每一席都收,只刪帶標記的那份;★回真正刪掉的檔名清單★(空清單=什麼都沒刪,falsy)。
    回清單不回 bool 的理由:多席之後「刪了幾個」跟「刪了哪些」不一樣,teardown 的移除清單要照實列,
    不能因為函式回 True 就把每一席都當成刪過(那會 report 一個沒發生的動作)。"""
    d = _codex_home(home) / "agents"
    gone = []
    for nm, _ in _CODEX_SEATS:
        f = d / f"{nm}.toml"
        try:
            if f.exists() and _CODEX_AGENT_MARK in f.read_text(encoding="utf-8", errors="replace"):
                f.unlink(); gone.append(f"agents/{nm}.toml")
        except OSError:
            pass
    return gone


def _sync_msg(harness: str, state: str) -> str:
    """三態→給人看的一行(成功講改了什麼;失敗講原因與下一步)。"""
    hdir, sfile = _HARNESS_HOME[harness]
    name = "Claude" if harness == "claude" else "Codex"
    if state == "ok":
        tail = ";★Codex 的 hook 要你開一次互動 codex 審過(Hooks need review 畫面或 /hooks)才會跑;信任綁的是 hooks.json 裡那條命令列——lumos 更新 hook 檔內容不用重審,命令列變了才要;exec 不會問★" if harness == "codex" else "(含清撤除的舊註冊)"
        return f"  ✓ 全域 {name} hooks/{sfile} 已同步{tail}"
    if state == "probe":
        return f"  ⚠ 全域 {name} hooks 同步被擋(LUMOS_PROBE)——未動 ~/{hdir}"
    if state == "merge-failed":
        return f"  ⚠ 全域 {name} hooks:檔已 copy 但 ~/{hdir}/{sfile} 損毀、註冊沒更新——修好 JSON 再跑 lumos install --force"
    if state == "absent":
        return "  (本機沒有 Codex 家目錄(~/.codex 或 $CODEX_HOME)=還沒用過 codex:略過 Codex hooks;用過之後再跑一次 lumos install --force)"
    if state == "home-not-dir":
        return f"  ⚠ Codex 家目錄 {_codex_home()} 不是目錄(是個檔案):略過 Codex hooks——搬走那個檔再跑 lumos install --force"
    return f"  ? 全域 {name} hooks 同步狀態 {state}"


def _teardown_global_claude(src_repo: Path):
    """相容包裝:Claude 側拆除(既有呼叫/測試用)。"""
    return _teardown_global_hooks(src_repo, "claude")


def _teardown_global_hooks(src_repo: Path, harness: str):
    """_sync_global_hooks 的移除半邊(teardown 用):清全域 ~/.claude(或 ~/.codex)的我方 hook + 剪其懸空註冊。
    ①先驗 settings.json 可解析→壞則跳過+warn、★不刪 .py★(不製造懸空,std F6)②rm 我方現役+撤除 hook
    ③跑 merge --prune-only(★只剪懸空、不 re-add★——預設 merge 會把 hook 加回,抵銷 teardown)④收自家自訂審查席 TOML(codex)⑤收 .bak。
    須在 deinit 刪掉 vendored merge-claude-settings.py 之前跑(std F5,由 cmd_teardown 順序保證)。
    設計:Projects/teardown一鍵拆機_計劃。回 True=已處理 / False=因 settings 壞跳過。"""
    import subprocess, json
    hdir, sfile = _HARNESS_HOME[harness]
    chome = _codex_home() if harness == "codex" else Path.home() / hdir
    if harness == "codex" and not chome.is_dir():
        if chome.exists():
            print(f"  ⚠ Codex 家目錄 {chome} 不是目錄,略過 Codex 側清理", file=sys.stderr)
        return True                           # 沒裝過 Codex 側(或家目錄是檔案):無事可拆
    chooks, settings = chome / "hooks", chome / sfile
    if settings.exists():                     # ① 先驗可解析(壞 → 不半做)
        try:
            json.loads(settings.read_text(encoding="utf-8"))
        except Exception as e:
            print(f"  ⚠ ~/{hdir}/{sfile} 無法解析({e}),跳過全域 hook 清理"
                  "(避免刪了檔卻剪不掉註冊、留懸空)", file=sys.stderr)
            return False
    removed = []                              # ② rm 我方 hook 真檔
    for f in _GLOBAL_HOOKS + _RETIRED_CLAUDE_HOOKS + _RETIRED_STUB_CLAUDE_HOOKS:
        p = chooks / f            # ★含相容期空殼★:拆機後機器上不該留我方任何檔
        if p.exists() or p.is_symlink():
            p.unlink(); removed.append(f)
    merge = src_repo / "scripts" / "merge-claude-settings.py"   # ③ prune-only 剪懸空我方註冊
    if merge.exists() and settings.exists():
        subprocess.run([sys.executable, str(merge), "--prune-only"] + (["--target", "codex"] if harness == "codex" else []))
    if harness == "codex":                            # ④ 自家自訂審查席 TOML(d6;三席,照實列刪掉的那些)
        removed.extend(_remove_codex_agent())
    bak = settings.with_suffix(".json.bak")   # ⑤ 合併器每次改檔留的備份也收掉(r1 單reviewer F7:拆機要對稱)
    if bak.exists():
        try:
            bak.unlink(); removed.append(bak.name)
        except OSError:
            pass
    name = "Claude" if harness == "claude" else "Codex"
    print(f"  ✓ 全域 {name} hook 清理:移除 {len(removed)} 檔 + 剪懸空我方註冊" if removed
          else f"  ✓ 全域 {name} hook:無我方殘留")
    return True


def _set_hooks_path(root: Path):
    """① git config core.hooksPath(專案本地)。★跟全域同步拆開★——見 _sync_global_from_project。"""
    import subprocess
    subprocess.run(["git", "-C", str(root), "config", "core.hooksPath", "scripts/hooks"])
    print("  ✓ hooks:core.hooksPath 已設")


def _sync_global_from_project(root: Path):
    """②③ 全域 hooks/settings 同步,來源=專案 vendored copy。

    ★呼叫時機很要緊:必須在 vendored 檔案已經被更新之後★(2026-09-06 全 repo 審視 #5)。
    原本這兩件跟 core.hooksPath 綁在同一支 _install_hooks_py,而它在 _vendor_toolchain 裡
    排在 filecmp 自癒迴圈★之前★——於是 `lumos update` 會拿「更新前」的舊副本去覆蓋全域
    ~/.claude/hooks,把整台機器最核心的收工 hook 靜默換成六月版(實測 30912B → 15303B),
    訊息還印綠燈;舊版的 settings merger 甚至會把已撤除的 hook 註冊加回去。
    """
    for _h in ("claude", "codex"):
        print(_sync_msg(_h, _sync_global_hooks(root, _h)))


def _install_hooks_py(root: Path):
    """相容外殼:兩件一起做。★新程式碼請分開呼叫★,尤其是「先更新 vendored 再同步全域」
    那條路(_vendor_toolchain);這支留給「來源就是最新」的呼叫點(cmd_init 的新建路徑)。"""
    _set_hooks_path(root)
    _sync_global_from_project(root)


def _confirm_tty(prompt):
    """三階互動確認(curl|bash 安全;設計:Projects/bootstrap一鍵對稱_計劃 std F1/F2/F3):
    回 True(答 y/yes)/False(其他答案=拒絕)/None(非互動或無人回答→呼叫端跳過)。
    ①stdin.isatty→input();EOFError 落入②非當 False(isatty 撒謊時別誤判拒絕)
    ②os.open(tty,O_RDWR) 低階 fd(★r+ 開法對 tty 會炸 not seekable★)+os.write prompt
      +select timeout(有控制終端≠有人回答,防 readline 永久掛)+os.read
    ③皆不可→None。嚴禁在非 isatty 時讀 sys.stdin(curl|bash 下那是腳本殘文管線)。
    測試接縫:LUMOS_TTY(預設 /dev/tty;單元測指 pty slave)/LUMOS_TTY_TIMEOUT(預設 30s)。"""
    import os, select
    def _norm(ans):
        return ans.strip().lower() in ("y", "yes")   # 嚴格答案+預設 N(F2-B 殘文緩解)
    if sys.stdin.isatty():
        try:
            return _norm(input(prompt))
        except EOFError:
            pass                                     # isatty 撒謊 → 試 ②(F2-A)
    tty_path = os.environ.get("LUMOS_TTY", "/dev/tty")
    try:
        timeout = float(os.environ.get("LUMOS_TTY_TIMEOUT", "30"))
    except ValueError:
        timeout = 30.0
    try:
        fd = os.open(tty_path, os.O_RDWR)
    except OSError:
        return None
    try:
        os.write(fd, prompt.encode("utf-8"))
        readable, _, _ = select.select([fd], [], [], timeout)
        if not readable:
            os.write(fd, "\n(無回應,視為略過)\n".encode("utf-8"))
            return None
        data = os.read(fd, 256)
        if not data:
            return None
        return _norm(data.decode("utf-8", errors="replace"))
    except OSError:
        return None
    finally:
        os.close(fd)


def _self_repo_origin(script=None):
    """執行中腳本所屬 clone 的 origin URL(全域 lumos=symlink 進來源 clone,resolve 後可定位)。
    非 git repo/無 origin/git 不可用/★非工具鏈本體★ → None(呼叫端退硬編碼預設)。
    用途=鏡像自足(2026-08-19):從 Citrus_Lumos_Full 之類鏡像 clone 裝起的機器,bootstrap
    自動 clone 的預設來源=鏡像自己,不會漏回上游 repo。
    ★身分探針(單審 blocker 修)★:vendored 進業務專案的 scripts/lumos 是普通已提交檔——沒有
    這道探針,在業務 repo 裡跑 bootstrap 會把★業務 repo 的 origin★clone 成工具鏈來源,且全域
    symlink 從此指錯、無聲。判別鍵=skills/lumos-project-notes/SKILL.md(user-scope skill 唯一
    源,永不 vendor 進消費專案;同 install.py 來源 repo 判定慣例)。"""
    import subprocess
    repo = Path(script or __file__).resolve().parent.parent
    if not (repo / ".git").exists():
        return None
    if not (repo / "skills" / "lumos-project-notes" / "SKILL.md").is_file():
        return None   # vendored 消費副本/無關 repo:不信其 origin
    try:
        r = subprocess.run(["git", "-C", str(repo), "remote", "get-url", "origin"],
                           capture_output=True, text=True, errors="replace")
    except OSError:
        return None
    u = r.stdout.strip()
    return u if (r.returncode == 0 and u) else None


def _bootstrap_url(lumos_url=None, script=None):
    """bootstrap 預設 clone URL 解析鏈:旗標 > $LUMOS_URL > 本 clone origin(鏡像自足,含身分探針)
    > 硬編碼上游。抽成函式=解析順序可被行為測試釘住(單審抓到原字串包含斷言=假綠)。"""
    import os
    return (lumos_url or os.environ.get("LUMOS_URL") or _self_repo_origin(script=script)
            or "https://github.com/EnzoHsieh-Android/Lumos")


def cmd_bootstrap(lumos_url=None, lumos_home=None, pull=False, init=False, allow_stale=False):
    """一鍵在專案內裝好一切:自動 clone Lumos(若缺)→ user-scope skills → 全域 lumos → 專案層自動接線。
    專案層四分流(設計:Projects/bootstrap一鍵對稱_計劃):有 vault+vendored→接 hooks｜有 vault 無
    vendored(中間態)→提示跑 init 補齊｜無 vault→_confirm_tty 確認(y 才 auto-init;--init 免確認)｜
    非 git→跳過只做機器層。--pull:既有 Lumos clone 也 git pull 拉最新。
    冪等:auto-init 只在無 vault 時觸發;cmd_init 一律 force=False+no_pull=True(pull 政策歸 step1)。
    失敗傳播(std F8):各步查 returncode,任一失敗最終 rc=1,不吞錯照印成功。"""
    import os, subprocess
    if _refuse_if_probe("bootstrap"):
        return 2
    home = Path(lumos_home or os.environ.get("LUMOS_HOME")
                or (Path.home() / "harness" / "lumos-toolchain")).expanduser()
    url = _bootstrap_url(lumos_url)   # 解析鏈:旗標>env>本 clone origin(鏡像自足+身分探針)>硬編碼
    # 1) 確保 Lumos 來源在(缺則自動 clone;--pull 則既有 clone 也拉最新)
    # 存在性判定=scripts/lumos(真正要執行的檔;code-loop r1 F3:與 get.sh 同判準,免部分 clone 下兩端不一致)
    if (home / "scripts" / "lumos").exists():
        if pull:
            print(f"[1/3] Lumos 來源已在,git pull 更新: {home}")
            # 與 _vendor_toolchain 共用政策:有 remote 卻拉不到就中止,不拿可能過期的
            # 來源往下走(step3 的 auto-init 會把它 vendor 進專案 → 同一個降版坑)。
            if _pull_source_or_abort(home, allow_stale) is None:
                return 2
        else:
            print(f"[1/3] Lumos 來源已在: {home}（--pull 可拉最新 skills）")
    else:
        branch = os.environ.get("LUMOS_BRANCH", LUMOS_RELEASE_BRANCH)
        print(f"[1/3] clone Lumos({branch} 對外線)→ {home} …")
        home.parent.mkdir(parents=True, exist_ok=True)
        # 先抓對外線;抓不到就退回預設分支並講清楚(release 分支可能還沒開,
        # 冷啟動不該因此炸掉)。用分支不用 tag——tag 會進 detached HEAD,
        # 之後 git pull / lumos update 全部靜默停在裝機那版(2026-07-30 裁定)。
        ok = subprocess.run(["git", "clone", "--branch", branch, url, str(home)],
                            capture_output=True, text=True, errors="replace").returncode == 0
        if not ok:
            print(f"  提醒:抓不到 {branch} 這條對外線(分支還沒開、或名字改了),改用預設分支。",
                  file=sys.stderr)
            print("  這代表你拿到的是開發線的內容,可能還沒發布過。", file=sys.stderr)
            if subprocess.run(["git", "clone", url, str(home)]).returncode != 0:
                print(f"擋下:自動下載失敗。手動跑這行再重試:\n    git clone {url} {home}", file=sys.stderr)
                return 2
    # 2) 全域 lumos → 指向 Lumos 來源(非 vendored copy);install --force 已連帶裝 user-scope skills
    print("[2/3] 裝全域 lumos(+ user-scope skills)…")
    failures = []
    rc2 = subprocess.run([sys.executable, str(home / "scripts" / "lumos"),
                          "install", "--force"]).returncode
    if rc2 != 0:                                  # std F8:不吞錯
        print(f"  提醒:重新安裝(install --force)失敗,回傳碼 {rc2}", file=sys.stderr)
        failures.append("install")
    # 3) 專案層自動接線(四分流;git toplevel 才算專案)
    try:
        # 嚴格解碼:這個路徑要拿去裝東西,解不了就當成不在專案裡(跳過專案層),不猜路徑
        root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"],
                                            text=True, errors="strict", stderr=subprocess.DEVNULL).strip())
    except Exception:
        root = None
    if root is None:
        print("[3/3] 非 git repo,跳過專案層(機器層已裝;到專案內再跑 bootstrap 或 lumos init)")
    else:
        os.environ["LUMOS_HOME"] = str(home)      # std F6:cmd_init 內 _lumos_src 讀此傳導自訂 home
        vault = _vault_in(root)
        vendored = (root / "scripts" / "merge-claude-settings.py").exists()
        if vault is not None and vendored:        # ① 已是專案 → 接 hooks(git config 每機器要重接)
            print(f"[3/3] 裝 repo hooks（{root}）…")
            try:
                # ★只設路徑,不從這裡同步全域★(2026-09-06 代碼審 r1 外家席):步驟 2 才剛用
                # 最新的來源裝好全域 hooks,這裡若再從「可能很舊」的消費專案同步一次,會把它倒退。
                # 專案自己的 vendored 檔要更新是 `lumos update` 的事,那條路已改成自癒後才同步。
                _set_hooks_path(root)
            except Exception as e:
                print(f"  ⚠ hooks 安裝失敗:{e}", file=sys.stderr)
                failures.append("hooks")
        elif vault is not None:                   # ② 中間態(F5:_vault_in 只看名稱,別疊自動動作)
            print(f"[3/3] ⚠ {root} 有 vault({vault.name})但無 vendored 工具——"
                  "跑 `lumos init` 補齊(不自動動)", file=sys.stderr)
        else:                                     # ③ 無 vault → 確認後 auto-init
            go = init
            if not go:
                ans = _confirm_tty(f"[3/3] 要把 {root} 建成 lumos 專案(建圖譜+工具+hooks)嗎? [y/N] ")
                if ans is None:
                    print("[3/3] 非互動環境,跳過建專案(要建:互動跑或加 --init)")
                go = (ans is True)
            if go:
                print(f"[3/3] 初始化 lumos 專案（{root}）…")
                try:
                    rc3 = cmd_init(force=False, no_pull=True)   # F7:pull 政策歸 step1;永不 force
                except Exception as e:                           # code-loop r1 F2:init 內部炸(權限/磁碟)別裸 traceback
                    print(f"  ⚠ init 失敗:{e}", file=sys.stderr)
                    failures.append("init")
                else:
                    # code-loop r1 F2:cmd_init 對 vendor 失敗只印警告仍回 0(rc 判定是死碼)
                    # → 後驗實體:vault 與 vendored 工具都真的在才算成功,半成品要反映在最終 rc
                    if rc3 or _vault_in(root) is None \
                            or not (root / "scripts" / "merge-claude-settings.py").exists():
                        print("  ⚠ init 未完整(vault 或 vendored 工具缺,詳見上方訊息)", file=sys.stderr)
                        failures.append("init")
    if failures:
        print(f"\n✗ bootstrap 部分失敗:{', '.join(failures)}(其餘步驟已完成)", file=sys.stderr)
        return 1
    print("\n✓ bootstrap 完成。最後一步:**重啟 Claude Code session**(L1/L3 hooks 要 session start 才載入)。")
    return 0


def _slugify_vault(name: str):
    """repo basename → vault slug:小寫、非英數轉 -、收斂連續 -、去頭尾 -、去既有 -knowledge 尾。"""
    s = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    if s.endswith("-knowledge"):
        s = s[:-len("-knowledge")]
    return s or "project"


def cmd_init(name=None, force=False, with_hooks=True, no_pull=False, allow_stale=False):
    """在當前 repo 初始化知識圖譜:建 docs/<slug>-knowledge/{6 個資料夾} + .gitignore,
    預設並 vendor 工具組 + 裝 pre-commit/pre-push 閘(--no-hooks 只建圖譜輕量版)。
    像 `openspec init`:一行開好就能 `lumos new`。
    分工:init = 專案層(圖譜 + 該 repo 的 hooks);bootstrap = 機器層(clone Lumos/skills/全域 lumos),一輩子一次。
    序列(既有 vault 非 force):_reinject_claude_block(讀本機已 vendor 範本,不 pull、不重裝 hooks)
      → _init_additive_setup(只加不覆寫:設定骨架 + 本機留痕的忽略設定)→ early-return。
    序列(新 vault 或 --force):_vendor_toolchain(pull + copy2 + hooks + reinject) → scaffold → 完成。
    no_hooks 路徑(不分新/既有):只 _reinject_claude_block(讀本機已 vendor 範本,無則靜默)。"""
    import subprocess
    try:
        # 嚴格解碼:這個路徑要拿去寫檔,換成替代字元會在不存在的路徑上建出一整棵資料夾;解不了就照原本的退路用目前目錄
        root = Path(subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True, errors="strict", stderr=subprocess.DEVNULL).strip())
    except Exception:
        root = Path.cwd()
    existing = _vault_in(root)
    # slug 決定順序:① --name 顯式 ② 既有 vault 的 slug ③ repo basename。
    # ②必須先於③:否則既有 vault 上跑 --force 會用 repo basename 當 slug,
    # 建錯一個空 vault + 把 CLAUDE.md {{KG}} 路徑寫錯(現場事故:basename landmarkmember
    # vs 既有 vault landmark-knowledge)。既有 vault 的資料夾名即權威 slug,不重新 slugify。
    if name:
        slug = _slugify_vault(name)
    elif existing is not None and existing.name.endswith("-knowledge"):
        slug = existing.name[:-len("-knowledge")]
    else:
        slug = _slugify_vault(root.name)

    # ── Step 1: reinject CLAUDE.md(依路徑輕/重分流)─────────────────────
    # 既有 vault 非 force:只 reinject(輕量);不 pull、不重裝 hooks。
    # 新 vault 或 --force:完整 _vendor_toolchain(pull + copy2 + hooks + reinject)。
    # no_hooks 路徑:一律只 reinject(讀本機已 vendor 範本,無則靜默)。
    def _do_reinject():
        _reinject_all(root, slug)     # CLAUDE.md + Codex 指示檔(d1),印人話

    if with_hooks:
        src = _lumos_src()
        if root.resolve() == src.resolve():
            print("\n  (當前就是 Lumos 來源本身,跳過 vendor/hooks;CLAUDE.md 紀律區塊照刷)")
            _do_reinject()   # 2026-08-05 修:原本連 reinject 一起跳過,範本更新後來源 repo 自己永不刷新
        elif existing is not None and not force:
            # 既有 vault 非 force:輕量路徑,只刷新 CLAUDE.md 紀律區塊
            _do_reinject()
        else:
            # 新 vault 或 --force:完整 vendor(pull + copy2 + hooks + reinject)
            print(f"lumos init — 在 {root} 建圖譜 vault: docs/{slug}-knowledge/")
            print("\n裝 hooks:vendor 工具組 + 啟用 pre-commit/pre-push 閘…")
            rc = _vendor_toolchain(src, root, slug, no_pull=no_pull, allow_stale=allow_stale)
            # _vendor_toolchain 已呼叫 _install_hooks_py + _reinject_claude_block;不重複
            if rc is None:
                print("  ⚠ 來源不可用,略過 hooks(圖譜已建好)。日後補裝:lumos update")
    else:
        # no_hooks:讀本機 vendored 範本執行 reinject(無範本 → no_template → 靜默)
        _do_reinject()

    # ── Step 2: 只加不覆寫的設定(★新舊專案都要,不受下面的早退影響★)──────
    # r1 架構對齊席 f2:這兩樣本來被關在「保護既有 vault」的兩層早退後面,
    # 於是最需要它們的既有消費專案永遠拿不到。它們自己就是「檔案不存在才寫」。
    _init_additive_setup(root)

    # ── Step 3: existing/force 判定 ───────────────────────────────────
    if existing is not None and not force:
        print(f"✓ 此 repo 已有 vault: {existing.relative_to(root)}")
        print("  (要另建用 --name <slug>;要在既有 vault 上重裝/更新 hooks 與工具組用 --force,vault 內容不動)")
        return 0

    # ── Step 4: scaffold 圖譜資料(新 vault;既有 vault 內部 kg.exists() guard 保護) ──
    if not with_hooks:
        print(f"lumos init — 在 {root} 建圖譜 vault: docs/{slug}-knowledge/")
    _scaffold_project(root, slug)  # 6 夾 + .gitignore + MOC/index.md;既有 vault 自動 skip 保護資料

    print("\n✓ init 完成。開始用:")
    print(f"    cd {root}")
    print("    lumos new system <模組名>     # 建第一個系統節點")
    print("    lumos doctor                  # 健檢")
    if with_hooks:
        print("  (已裝 pre-commit/pre-push 閘:改 code 沒更新圖譜會被擋)")
    return 0


def _vault_in(d: Path):
    """d 之下是否有 vault: docs/*-knowledge 或 docs/knowledge(專案佈局),
    或 d 本身就是 vault root(standalone,如核心 repo:有 MOC/ + Verification|Systems)。"""
    docs = d / "docs"
    if docs.is_dir():
        for sub in sorted(docs.iterdir()):
            if sub.is_dir() and sub.name.endswith("-knowledge"):
                return sub
        if (docs / "knowledge").is_dir():
            return docs / "knowledge"
    # standalone vault root(核心 repo 等):MOC/ + (Verification/ 或 Systems/)
    if (d / "MOC").is_dir() and ((d / "Verification").is_dir() or (d / "Systems").is_dir()):
        return d
    return None


def find_vault(start: Path):
    """從 cwd 往上走找 vault(全域安裝後可從任何專案子目錄跑)。"""
    start = start.resolve()
    for d in [start, *start.parents]:
        v = _vault_in(d)
        if v is not None:
            return v
        if (d / ".git").exists():  # 到 repo 根還沒找到就停(別爬出專案)
            break
    return None



