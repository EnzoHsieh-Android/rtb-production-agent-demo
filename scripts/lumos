# 區塊、你寫的圖譜筆記——都是你的,Lumos 不主張任何權利。
"""Lumos — 幫你把「為什麼這樣做」記成一張查得到的圖,並在動手前推到你眼前。

程式碼只告訴你現在長什麼樣;這張圖記的是為什麼這樣設計、邊界在哪、哪些不能改、驗證過沒。
不需要裝 Obsidian,CI 上也跑得動。

第一次用,照這三步走:
  lumos search <關鍵字>     先找有沒有人寫過(中文查詢:概念之間加空白)
  lumos context <節點>      看那一篇在講什麼、跟誰有關
  lumos contracts <節點>    動它之前有什麼不能碰的

★底下 argparse 會把每個子命令列出來,各附一句「什麼時候用」。★
這段刻意不再手抄一份清單:2026-09-07 全 repo 審視 #9 量到,手抄那份停在 10 個、
實際有 66 個,而且同一批指令被印兩遍。清單的單一來源是 HELP_WHEN,由 argparse 自己印。
(這裡也刻意不寫「共幾個」——寫了就是另一個會過期的數字。)

解析範圍(對齊 Obsidian 行為與 skill 鐵則):
  - body 的 [[wikilink]],排除 fenced code block 與 inline code(Obsidian 不索引)
  - frontmatter: 整個值恰為一個 wikilink 才索引(散文中夾帶的 [[..]] 不算;
    2026-06-13 並跑首日 parity diff 修正)
  - block scalar(summary: |- 等)內的 [[..]] 不算連結(鐵則 2)
  - 連結解析: 路徑優先,fallback basename,大小寫不敏感,NFC 正規化
"""
import argparse
import os
import re
import uuid
import sys
import time
import unicodedata
from collections import defaultdict, deque, namedtuple
from pathlib import Path

_IS_WIN = os.name == "nt"

# ── Task 5: 版本標籤(人可讀;advisory nudge 用;非正確性 oracle) ───────────────
LUMOS_VERSION = "v1.0"  # release 手動 bump;允許粗——它是標籤,不是內容指紋
# ★發布通道的分支名★(2026-09-07 #7 落地;設計出處 [[Projects/版本發布流程_計劃]] S5):
# main=開發線(可壞),release=對外線(只有 owner 快轉過去)。三個 clone 站一律先試這條,
# 分支還不存在時退回預設分支並印一行說明——冷啟動不能因此炸掉。
LUMOS_RELEASE_BRANCH = "release"


def _version_text():
    """`lumos --version` 印的東西。

    ★它回答的是「你手上這支 lumos 是哪一版」,不是「這台機器整體是哪一版」★
    ——同一台機器可能同時有三個答案:全域指令(捷徑指向來源 clone)、
    各專案自己複製的一份、以及全域的 AI hooks(來源是最後一個跑安裝的專案)。
    這條只答第一個,所以訊息裡明講它在哪。

    版本號是**人可讀的標籤,不是內容指紋**(既有決策:嚴禁拿它當「該不該更新」的判準),
    所以後面補一個真的指紋:來源 clone 的 commit 短碼與有沒有未提交的改動。
    複製到專案裡的那份沒有 git 脈絡,就照實說沒有,不要編一個出來。
    """
    import subprocess as _sp
    here = Path(__file__).resolve().parent.parent
    # 這一支是「工具鏈來源」還是「被複製進某個專案的那一份」?判準用檔案系統實況:
    # 來源 repo 才有 skills/ 那批方法論手冊。分清楚很重要——複製進專案的那一份,
    # 底下的 git 指紋是**那個專案的** commit,不是工具鏈的版本。
    is_source = (here / "skills" / "lumos-project-notes").is_dir()
    lines = ["lumos %s" % LUMOS_VERSION, "  這支的位置: %s" % (Path(__file__).resolve(),)]
    lines.append("  這一支是: %s" % ("工具鏈來源本身" if is_source
                                     else "被複製進某個專案的那一份(指紋是那個專案的,不是工具鏈的)"))
    try:
        sha = _sp.run(["git", "-C", str(here), "rev-parse", "--short", "HEAD"],
                      capture_output=True, text=True, errors="replace", timeout=5)
        if sha.returncode == 0 and sha.stdout.strip():
            dirty = _sp.run(["git", "-C", str(here), "status", "--porcelain"],
                            capture_output=True, text=True, errors="replace", timeout=5)
            mark = "(有未提交的改動)" if dirty.stdout.strip() else ""
            branch = _sp.run(["git", "-C", str(here), "rev-parse", "--abbrev-ref", "HEAD"],
                             capture_output=True, text=True, errors="replace", timeout=5)
            bname = branch.stdout.strip() or "?"
            # ★複製進別的專案時,這個編號是「那個專案的」,不是工具鏈的★
            # (2026-09-07 代碼審 r1 外家席:不講清楚的話,讀的人會拿它當工具鏈版本用)
            if is_source:
                lines.append("  這一份的內容指紋: %s 在分支 %s %s" % (sha.stdout.strip(), bname, mark))
            else:
                lines.append("  所在專案的 commit: %s 在分支 %s %s" % (sha.stdout.strip(), bname, mark))
                lines.append("  (這是**那個專案的**編號,不是工具鏈的版本;工具鏈版本只有上面那個標籤)")
        elif is_source:
            lines.append("  這一份沒有 git 脈絡(來源目錄不是 git 倉庫,例如從壓縮檔解出來的),只有版本標籤可講")
        else:
            lines.append("  這一份沒有 git 脈絡(被複製進來的那一份,而且所在目錄不是 git 倉庫),只有版本標籤可講")
    except Exception:
        lines.append("  這一份的內容指紋: 查不到(git 不在或這裡不是 git 倉庫)")
    lines.append("  同一台機器可能有三份不同版本的 lumos(全域指令 / 各專案複製的一份 / 全域 AI hooks),")
    lines.append("  這裡只回答你現在跑的這一支。")
    return "\n".join(lines)


class _VersionAction(argparse.Action):
    """--version:印版本再結束。用自訂 action 是因為指紋要當場算,
    不能在建 parser 的時候就跑 git(那會讓每一次呼叫都多花一個子行程)。"""

    def __init__(self, option_strings, dest, **kw):
        kw["nargs"] = 0
        super().__init__(option_strings, dest, **kw)

    def __call__(self, parser, namespace, values, option_string=None):
        print(_version_text())
        parser.exit(0)

# ── CLAUDE.md sentinel 常數(Task 1: reinject)────────────────────────────────
# START 行後面可能帶版本戳與說明(e.g. " v1.2 — 勿手改 -->"),故用前綴 find。
_CLAUDE_START_PREFIX = "<!-- LUMOS:GRAPH-DISCIPLINE:START"
_CLAUDE_END = "<!-- LUMOS:GRAPH-DISCIPLINE:END -->"
# Task 5: START 行模板(含版本佔位符);reinject 時 .format(version=LUMOS_VERSION)。
# 範本 graph-discipline.md 保持無版本戳(canonical prefix 形式);
# 版本由 reinject 當下插值——單一源 = LUMOS_VERSION 常數,無「改範本忘 bump」風險。
_START_TEMPLATE = (
    "<!-- LUMOS:GRAPH-DISCIPLINE:START {version}"
    " — 自動注入/更新,勿手改本區塊;"
    "改範本 scripts/templates/graph-discipline.md -->"
)
# BlockSpan: body=兩 sentinel 之間的內容(strip 首尾空行),
#            body_start/body_end=body 在原 text 中的字元位移,
#            保證 text[body_start:body_end] == body。
BlockSpan = namedtuple("BlockSpan", "body body_start body_end")
# Task 2: ReInjectResult ─ status ∈ created|updated|unchanged|appended|sentinel_broken|no_template
ReInjectResult = namedtuple("ReInjectResult", "status diff")

# ★FENCE_RE 已於 2026-08-03 移除,不要再加回來★——它有兩個致命假設:
#   ①圍欄成對(未閉合就看不見) ②標記在第 0 欄(收尾縮排會與下一個區塊錯配、
#   把中間的真散文整段吞掉)。這兩個假設在 code-loop r2/r4 各造成實測的靜默錯答:
#   幽靈圖譜邊、假合約佐證、G1 硬閘對壞引用放行、impact hook 漏掉合約節點。
# ★一律改用 `_visible_lines`(全檔唯一的 fence 判定)★:
#   要「剝圍欄 + 剝 inline code」→ `_strip_code_text`
#   要「只剝圍欄、★保留 inline code★」→ `_strip_fences_text`(refcheck 家族要這個)
INLINE_CODE_RE = re.compile(r"`[^`\n]*`")
_DOUBLE_BACKTICK_RE = re.compile(r"``.+?``")


def _strip_inline_markup(line):
    """行內層級的「哪些字看得見」——跟 `_visible_lines`(行層級)配成一對,★全檔唯一★,別在別處自寫第二份
    (條款綁定 -b r2 架構席:三條規則散在 clause_bindings 裡就是第二份)。
    剝:雙反引號 span、單反引號 span(INLINE_CODE_RE);★未閉合的反引號之後一律不信★(程式碼範例裡的 [test:]/[manual:] 不能當證據,寧可少認)。
    ★不碰 HTML 註解★:-b r3 兩席證明「偵測註解」本身就是洞(先關再開、註解正則不認反引號邊界),註解裡的 [SN] 一律走「認不得→擋」。
    回 (看得見的文字, 有沒有因未閉合反引號截掉東西)。search 的 probe 刻意只用 INLINE_CODE_RE 不走這裡:搜尋寧可多看見,截掉=靜默看不見(2026-08-03 那個坑)。"""
    s = INLINE_CODE_RE.sub("", _DOUBLE_BACKTICK_RE.sub("", line))
    if "`" in s:
        return s.split("`", 1)[0], True
    return s, False
WIKILINK_RE = re.compile(r"\[\[([^\[\]]+?)\]\]")
DATE_PREFIX_RE = re.compile(r"^(\d{4}-\d{2}-\d{2})")
TOP_KEY_RE = re.compile(r"^([A-Za-z_][\w-]*):\s*(.*)$")
LIST_ITEM_RE = re.compile(r"^\s+-\s+(.*)$")
QUOTED_DATE_RE = re.compile(
    r'^\s*(?:-\s+)?(?:date|created|updated|decided|ended):\s*"\d{4}-\d{2}-\d{2}"')
RULE3_RE = re.compile(r"^\s+-\s+\w+: [^\"'|>\s][^\"']*: \S")  # 未引號值含 ": "


def nfc(s):
    return unicodedata.normalize("NFC", s)


def strip_quotes(s):
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
        return s[1:-1]
    return s


def _posix_norm(s):
    """路徑比對鍵的共用正規化:反斜線轉斜線、去 ./ 與 a/../b(純字面,不查檔案);空的回空字串。
    工具自裝檔判別、about_code 的比對、排序加分讀 about_code 共用這一個(2026-09-10 代碼審 r3 架構席/整合席:
    原本三處各寫一份,排序那側只剝開頭的 ./,不解 ..)。"""
    import posixpath
    v = str(s).strip().replace("\\", "/")
    return posixpath.normpath(v) if v else ""


_SINGLE_WIKILINK_RE = re.compile(r"\[\[([^\[\]]+?)\]\]")   # 整個值恰好是一個連結(fullmatch 用;讀側索引與寫側判斷共用)


def _multi_link_value(s):
    """清單欄位的一個值裡有兩個以上連結開頭——一項只能是一個連結或一個值。
    讀的一側(parse_frontmatter 的 lint)與寫的一側(_list_scalar_value)共用這一個判斷(2026-09-10 代碼審 r3 架構席:
    原本讀側只認 `]], [[` 與 `]],[[`,寫側看兩個以上 [[,`[[A]],  [[B]]` 讀側不吭聲、寫側卻擋)。
    只用在清單欄位:散文欄位(例如 valid_under)講到兩個連結是正常的。"""
    return str(s).count("[[") > 1


def link_target(s):
    """從 wikilink 字串/list 項抽**完整 target**(去 [[]]、alias、heading、引號;**保留路徑**)。
    `[[Verification/X|y]]` → `Verification/X`。寫側 dedup 用它做精確比對:
    既修子字串誤判(A vs A_v2 不同),又不像 basename-only 把跨資料夾 Systems/X vs
    Verification/X 誤判相同(2026-06-13 第二輪審計 NEW-A)。"""
    t = strip_quotes(str(s).strip())
    t = t.replace("[[", "").replace("]]", "")
    t = t.split("|")[0].split("#")[0].strip()
    if t.lower().endswith(".md"):
        t = t[:-3]
    return nfc(t)


def split_frontmatter(text):
    """回傳 (fm_lines or None, body)"""
    if not text.startswith("---"):
        return None, text
    lines = text.split("\n")
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return lines[1:i], "\n".join(lines[i + 1:])
    return None, text


def parse_frontmatter(fm_lines):
    """極簡 parser(本 vault 慣例範圍): top-level 純量 + 字串 list + block scalar 內文。
    回傳 (fields, block_keys, lint)
      fields: dict[key] = str | list[str];block scalar 的 key 也存內文(供 context 用)
      block_keys: block scalar 的 key 集合(其值內的 [[..]] 不得索引,鐵則 2)
      lint: 鐵則指紋發現
    """
    fields, block_keys, lint = {}, set(), []
    seen = set()
    i, n = 0, len(fm_lines)
    while i < n:
        line = fm_lines[i]
        m = TOP_KEY_RE.match(line)
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        if key in seen:
            lint.append(f"同一層欄位名重複,工具不知道該信哪個: {key}")
        seen.add(key)
        if val in ("|", "|-", ">", ">-"):
            block = []
            i += 1
            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
                if fm_lines[i].strip():
                    block.append(fm_lines[i].strip())
                i += 1
            fields[key] = "\n".join(block)
            block_keys.add(key)
            continue
        if val == "":
            items = []
            i += 1
            while i < n:
                l2 = fm_lines[i]
                if not l2.strip():
                    i += 1
                    continue
                if not l2.startswith(" "):
                    break
                ms = LIST_ITEM_RE.match(l2)
                if ms:
                    item = strip_quotes(ms.group(1).strip())
                    items.append(item)
                    if "]], [[" in item or "]],[[" in item or (key in LIST_KEYS and _multi_link_value(item)):
                        lint.append(f"一個欄位塞了多個連結卻寫成一串字,會被當成一個不存在的 ghost 筆記,要拆成一行一項: {key} 項")
                if RULE3_RE.match(l2):
                    lint.append(f"欄位值裡有「冒號+空白」又沒加引號,讀出來會被切斷,整個值請用引號包起來: {l2.strip()[:60]}")
                i += 1
            fields[key] = items
            continue
        sval = strip_quotes(val)
        if sval == "[]":  # 行內空列表(YAML flow style)
            fields[key] = []
            i += 1
            continue
        fields[key] = sval
        if "]], [[" in sval or "]],[[" in sval or (key in LIST_KEYS and _multi_link_value(sval)):
            lint.append(f"一個欄位塞了多個連結卻寫成一串字,會被當成一個不存在的 ghost 筆記,要拆成一行一項: {key}")
        i += 1
    for line in fm_lines:
        if QUOTED_DATE_RE.match(line):
            lint.append(f"日期加了引號會被當成文字、排序比較都失效,引號拿掉: {line.strip()}")
    return fields, block_keys, lint


def extract_targets(text):
    out = []
    for raw in WIKILINK_RE.findall(text):
        t = raw.split("|")[0].split("#")[0].strip()
        if t:
            out.append(nfc(t))
    return out


class Note:
    __slots__ = ("rel", "stem", "fields", "block_keys", "fm_lines",
                 "targets", "lint", "mtime")


def load_vault(vault: Path):
    notes = {}
    for p in sorted(vault.rglob("*.md")):
        rel = nfc(p.relative_to(vault).as_posix())
        n = Note()
        n.rel = rel
        n.stem = nfc(p.stem)
        try:
            n.mtime = p.stat().st_mtime
            text = p.read_text(encoding="utf-8-sig")  # -sig: BOM 檔也偵測得到 frontmatter
        except Exception as e:
            n.fields, n.block_keys, n.fm_lines = {}, set(), []
            n.targets, n.lint, n.mtime = [], [f"讀檔失敗: {e}"], 0
            notes[rel] = n
            continue
        fm_lines, body = split_frontmatter(text)
        if fm_lines is not None:
            fields, block_keys, lint = parse_frontmatter(fm_lines)
        else:
            fm_lines, fields, block_keys, lint = [], {}, set(), []
        body_clean = _strip_code_text(body)   # ★不可換回 FENCE_RE:看不見未閉合圍欄→幽靈邊★
        # frontmatter 連結規則(對齊 Obsidian): 整個值恰為一個 wikilink 才索引,
        # 夾在散文中間的 [[..]] 不算;block scalar 整段排除(鐵則 2)
        fm_targets = []
        for key, v in fields.items():
            if key in block_keys:
                continue
            for item in (v if isinstance(v, list) else [v]):
                s = str(item).strip()
                fm = _SINGLE_WIKILINK_RE.fullmatch(s)
                if fm:
                    t = fm.group(1).split("|")[0].split("#")[0].strip()
                    if t:
                        fm_targets.append(nfc(t))
        n.fields = fields
        n.block_keys = block_keys
        n.fm_lines = fm_lines
        n.targets = extract_targets(body_clean) + fm_targets
        n.lint = lint
        notes[rel] = n
    return notes


def build_index(notes):
    by_stem = defaultdict(list)
    for rel, n in notes.items():
        by_stem[n.stem.lower()].append(rel)
    return by_stem


def make_resolver(notes, by_stem):
    rels = set(notes)

    def resolve(target):
        t = target
        if t.lower().endswith(".md"):
            t = t[:-3]
        if "/" in t:
            cand = t + ".md"
            if cand in rels:
                return cand
            t = t.rsplit("/", 1)[1]
        hits = by_stem.get(t.lower())
        if hits:
            return hits[0]
        return None

    return resolve


def as_list(v):
    if v is None:
        return []
    if isinstance(v, list):
        return [str(x) for x in v]
    return [str(v)]


class Env:
    def __init__(self, vault):
        self.vault = vault
        self.notes = load_vault(vault)
        self.by_stem = build_index(self.notes)
        self.resolve = make_resolver(self.notes, self.by_stem)
        self._edges = None

    @property
    def edges(self):
        if self._edges is None:
            out_e, in_e = defaultdict(list), defaultdict(list)
            for rel, n in self.notes.items():
                seen = set()
                for t in n.targets:
                    d = self.resolve(t)
                    if d and d != rel and d not in seen:
                        seen.add(d)
                        out_e[rel].append(d)
                        in_e[d].append(rel)
            self._edges = (out_e, in_e)
        return self._edges

    def find(self, arg):
        """以 stem 或相對路徑找筆記,回傳 rel 或 None"""
        a = nfc(arg.strip())
        if a.lower().endswith(".md"):
            a = a[:-3]
        if "/" in a and (a + ".md") in self.notes:
            return a + ".md"
        hits = self.by_stem.get(a.rsplit("/", 1)[-1].lower())
        if hits:
            if len(hits) > 1:
                print(f"⚠ 同名筆記 {len(hits)} 個,取第一個: {hits[0]}", file=sys.stderr)
            return hits[0]
        return None


def first_line(s, width=72):
    s = (s or "").strip().split("\n")[0]
    return s if len(s) <= width else s[:width] + "…"


def status_of(env, rel):
    v = env.notes[rel].fields.get("status", "")
    return v if isinstance(v, str) else ""


TYPED_EDGE_FIELDS = ("verified_by", "plan_refs", "related")


def build_typed_index(env):
    """[M2/P0] typed-edge 反向索引——從 frontmatter 具名欄位(verified_by/plan_refs/related)建
    「每節點 ← 誰、以哪種邊型指向我」。補 Env.edges 無型別的洞(建圖層以 target 去重丟來源欄位)。
    每次呼叫現建現用(天生新鮮、無持久化=無腐爛)。合約(關係層主網 M2):
    - 只索引「整個值恰為一個 wikilink」(沿 load_vault fm_targets 規則);殘留 scalar → scalars
      warnings、不進索引(不靜默納入)。block scalar 欄位整段排除(鐵則 2)。
    - ghost(unresolved)→ ghosts 清單(不靜默丟);path 式不 fallback 到 stem(那是靜默猜)。
    - 同名無路徑 [[X]] 多篇候選 → ambiguous + 候選清單(嚴禁靜默指第一篇——不走 env.resolve,
      直接查 by_stem 候選數)。
    - 去重鍵 (source, target字面, type);ambiguous 條目 target=原 wikilink 字面。
    回傳 dict: rev={target_rel:[(source_rel,etype)]} fwd={source_rel:{etype:[target_rel]}}
              ghosts=[(src,字面,etype)] ambiguous=[(src,字面,etype,[候選])] scalars=[(src,etype,值)]"""
    rev = defaultdict(list)
    fwd = defaultdict(lambda: defaultdict(list))
    ghosts, ambiguous, scalars = [], [], []
    seen = set()
    for rel, n in sorted(env.notes.items()):
        for etype in TYPED_EDGE_FIELDS:
            if etype in n.block_keys:
                continue
            for item in as_list(n.fields.get(etype)):
                s = str(item).strip()
                if not s:
                    continue
                m = re.fullmatch(r"\[\[([^\[\]]+?)\]\]", s)
                if not m:
                    scalars.append((rel, etype, s))
                    continue
                t = nfc(m.group(1).split("|")[0].split("#")[0].strip())
                if not t:
                    continue
                key = (rel, t, etype)
                if key in seen:
                    continue
                seen.add(key)
                tt = t[:-3] if t.lower().endswith(".md") else t
                if "/" in tt:
                    cand = tt + ".md"
                    if cand in env.notes:
                        rev[cand].append((rel, etype))
                        fwd[rel][etype].append(cand)
                    else:
                        ghosts.append((rel, t, etype))
                else:
                    cands = env.by_stem.get(tt.lower(), [])
                    if len(cands) == 1:
                        rev[cands[0]].append((rel, etype))
                        fwd[rel][etype].append(cands[0])
                    elif not cands:
                        ghosts.append((rel, t, etype))
                    else:
                        ambiguous.append((rel, t, etype, sorted(cands)))
    return {"rev": rev, "fwd": fwd, "ghosts": ghosts, "ambiguous": ambiguous, "scalars": scalars}


# ═══════════════════════ doctor ═══════════════════════

def _stem_hit(stem, text):
    """stem 是否在 text 中作為「整詞」出現。ASCII stem 用詞界(re.ASCII,避 api 命中 pos_api_auth);
    CJK 無詞界 → 子字串比對,靠呼叫端的前綴抑制處理重疊(點數 vs 點數商城)。"""
    if stem.isascii():
        return re.search(r"\b" + re.escape(stem) + r"\b", text, re.ASCII) is not None
    return stem in text


def _suggest_systems_for_orphan(env, rel, n):
    """為 orphan Verification 推薦『最可能該掛哪個 Systems』(非 auto-fix,供人確認)。
    線索強度:本篇正文連向 Systems(3)> 經 plan_refs 計劃連到(2)> feature 提到 stem(1)。
    回傳 [(sys_rel, score, reason), ...] 依 (score, stem 長度) 降序(同分時更具體的 stem 優先)。"""
    cands = {}   # sys_rel -> (score, reason)

    def add(sys_rel, score, reason):
        if sys_rel in env.notes and (sys_rel not in cands or score > cands[sys_rel][0]):
            cands[sys_rel] = (score, reason)

    for t in n.targets:                                  # 1) 本篇正文連向的 Systems
        d = env.resolve(t)
        if d and d.startswith("Systems/"):
            add(d, 3, "本篇正文連向(verified_by 未同步 → 可 sync-verified-by)")
    for pr in as_list(n.fields.get("plan_refs")):        # 2) plan_refs → 計劃 → 計劃連向 Systems
        pd = env.resolve(link_target(pr))
        if pd and pd in env.notes:
            for t in env.notes[pd].targets:
                d = env.resolve(t)
                if d and d.startswith("Systems/"):
                    add(d, 2, f"經 plan_refs [[{env.notes[pd].stem}]] 連到")
    # 3) feature 提到某 Systems stem(只用人寫的 feature,不用自動檔名;整詞 + 前綴重疊抑制)
    feat = " ".join(str(x) for x in as_list(n.fields.get("feature")))
    if feat:
        matched = [(sr, sn.stem) for sr, sn in env.notes.items()
                   if sr.startswith("Systems/") and sn.stem and _stem_hit(sn.stem, feat)]
        stems = [s for _, s in matched]
        for sr, st in matched:
            if any(st != o and st in o for o in stems):   # st 是另一命中 stem 的子字串 → 丟(留更具體者)
                continue
            add(sr, 1, f"feature 提到「{st}」")
    return sorted(((s, sc, r) for s, (sc, r) in cands.items()),
                  key=lambda x: (-x[1], -len(env.notes[x[0]].stem or "")))


def _loop_gov_mark(env, loop_id, kind, note=""):
    """設計/代碼審查迴圈的結案方式進治理帳(工具鏈補強十件 #6):gate=design-loop,
    kind=converged(閘過了)| cap-reached(跑滿上限沒過)| rewrite(人裁判整份重寫、開新編號收尾;設計審收斂重定義 d3,2026-08-25;note 必寫前編號)。gov --stats 三種分開計數。
    fail-open:寫不進去不影響判定輸出。"""
    if env is None:
        return
    try:
        _append_governance_log(env.vault, [{"gate": "design-loop", "kind": kind, "hard": False,
                                            "nodes": [loop_id], "note": note}])
    except Exception:
        pass


def _replay_git_blob(root, relpath):
    """--freeze 前置:檔案已 commit 且與 HEAD 一致才記 blob id(r3 delta d-f2:hash-object 不落
    物件、-w 落懸空 blob 兩週可被 GC——取 HEAD 的 blob 保證被 tree 引用)。回 (blob_id, err)。"""
    import subprocess as _sp
    head = _sp.run(["git", "-C", str(root), "rev-parse", f"HEAD:{relpath}"],
                   capture_output=True, text=True, errors="replace")
    if head.returncode != 0:
        return None, f"{relpath} 還沒 commit 進版控"
    work = _sp.run(["git", "-C", str(root), "hash-object", str(Path(root) / relpath)],
                   capture_output=True, text=True, errors="replace")
    if work.returncode != 0:
        return None, f"{relpath} 讀不到({work.stderr.strip()[:80]})"
    if head.stdout.strip() != work.stdout.strip():
        return None, f"{relpath} 工作樹內容與 HEAD 不一致(先 commit 卷證再凍)"
    return head.stdout.strip(), None


def cmd_loop_replay(env, loop_id, golden=None, freeze=False, spec=None, note=None, repo=None):
    """改制回測 [S1/S2](2026-08-26):gate 判定回放。
    凍結模式(--freeze --spec):對 loop 現帳跑唯讀判定,產 governance/replay/<id>/verdict.json
    =完整輸入閉包(全列原文+逐行 sha 集+spec sha+檔案 sha/blob+engine_rev)。
    回放模式(--golden):對閉包重算,差異四分類——邏輯漂移/帳被動=紅 rc1;
    帳本長大/golden 過期=列出不紅。唯讀:治理帳零寫入、不跑觀測尾巴。
    範圍=d5 處置帳形狀;panel 舊制 rc2 指路 loop status --gate --panel(語意重算既有,不入 golden)。
    rc:0=無異狀 / 1=紅(漂移或資料完整性) / 2=用法或帳形狀錯。"""
    import json
    import hashlib
    import datetime
    if freeze == bool(golden):
        print("擋下:--freeze(凍結)和 --golden(回放)要挑一個模式", file=sys.stderr)
        return 2
    root = Path(repo).resolve() if repo else _vault_repo_root(env)
    ledger = env.vault.parent / ".canary-log.jsonl"

    def _load_rows():
        raw, parsed = [], []
        try:
            for line in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
                if not line.strip():
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get("loop") == loop_id:
                    raw.append(line)
                    parsed.append(d)
        except OSError as e:
            print(f"擋下:帳本讀不到({e}): {ledger}", file=sys.stderr)
            return None, None
        return raw, parsed

    def _sha(s):
        return hashlib.sha256(s.encode("utf-8")).hexdigest()

    if any(ch in str(loop_id) for ch in ("/", "\\", "..")):
        print(f"擋下:loop 編號含路徑字元({loop_id!r})——golden 目錄以編號命名,不受理(目錄安全+週跑掃描只看一層)", file=sys.stderr)
        return 2
    if freeze:
        if not spec:
            print("擋下:凍結模式要帶 --spec(帳裡沒有 spec 路徑欄,凍結當下由操作者給)", file=sys.stderr)
            return 2
        raw, parsed = _load_rows()
        if raw is None:
            return 2
        if not raw:
            print(f"擋下:帳本裡沒有 loop={loop_id} 的任何記錄,沒東西可凍", file=sys.stderr)
            return 2
        # 兩趟同一份實作:第一趟取判定輪 rid(G3 對活檔可能已 FAIL,不影響分組);
        # 第二趟用窗末 sha 重算=凍結的 verdict——spec 檔收斂後常繼續被編輯(常態),
        # 凍結若對活檔算 G3,回放(對凍結 sha 算)就恆報假邏輯漂移(凍結/回放兩側輸入必須同構)。
        out = {}
        rc = _loop_status_disposal(parsed, loop_id, spec, 0, root, env=env, repo=repo,
                                   readonly=True, result_out=out)
        if rc == 2:
            print("擋下:這個 loop 的帳形狀進不了 d5 處置判定(多半是 panel 舊制多席各自帳)——"
                  "舊制語意重算用 lumos loop status <id> --gate --panel;golden 回放只涵蓋 d5", file=sys.stderr)
            return 2
        rid = out.get("rid")
        if str(rid).startswith("__"):
            print("擋下:這個 loop 是無輪次(round-less)舊制形狀,不入 golden——"
                  "回放只涵蓋帶輪次的 d5 處置迴圈(light/settle 舊帳照舊用各自閘語意)", file=sys.stderr)
            return 2
        spec_sha_frozen = next((r.get("result_sha256") for r in parsed
                                if r.get("round") == rid and r.get("result_sha256")), None)
        out = {}
        rc = _loop_status_disposal(parsed, loop_id, None, 0, root, env=env, repo=repo,
                                   readonly=True, spec_sha_override=spec_sha_frozen, result_out=out)
        try:
            if spec_sha_frozen and _sha256_file(spec) != spec_sha_frozen:
                print("  (提示:spec 檔已在收斂後被編輯——常態;閉包凍的是窗末指紋,回放不受影響)")
        except OSError:
            pass
        files = {}
        # 判定輪全席+資安席那幾筆(代碼審資安席 [S2]/r1 外家否決 E2):資安席一步在凍結/回放照樣重讀它的報告與凍結 patch,
        # 所以那些檔也要進閉包、要求進版控,回放的完整性檢查才蓋得到;生效日前的迴圈 _gated_seat_rows 回空,閉包不變。
        _closure = [r for r in parsed if r.get("round") == rid]
        _closure += [r for r in _gated_seat_rows(parsed, loop_id) if r not in _closure]
        for r in _closure:
            for k in ("report", "snapshot"):
                rp = r.get(k + "_path")
                if not rp or rp in files:
                    continue
                if Path(rp).is_absolute():
                    print(f"擋下:卷證在 repo 外(帳面存絕對路徑 {rp})——無法版控錨定,不入 golden;"
                          "git 的 HEAD:<path> 不吃絕對路徑,這不是「沒 commit」的問題(cb3 s2-f5)", file=sys.stderr)
                    return 2
                blob, err = _replay_git_blob(root, rp)
                if err:
                    print(f"擋下:凍結前置檢查沒過——{err};先把卷證 commit 進版控再凍", file=sys.stderr)
                    return 2
                files[rp] = {"sha256": r.get(k + "_sha256"), "git_blob": blob}
        spec_sha = spec_sha_frozen
        _spr = Path(spec).resolve()
        try:
            spec_rel = str(_spr.relative_to(root))
        except ValueError:
            spec_rel = str(_spr)
        verdict = {
            "loop": loop_id, "round": rid, "engine_rev": _REPLAY_ENGINE_REV,
            "frozen_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            "spec_path": spec_rel, "spec_sha": spec_sha,
            "rows": raw,
            "all_row_shas": sorted(_sha(l) for l in raw),
            "files": files,
            "verdict": {"rc": rc, "fails": out.get("fails", [])},
        }
        vdir = root / "governance" / "replay" / loop_id
        vdir.mkdir(parents=True, exist_ok=True)
        target = vdir / "verdict.json"
        # 順序(cb3 s2-f3):①新內容先落暫存檔(最會失敗的一步最先做)②舊檔歸檔③replace 上位
        # ④最後才寫治理帳留痕——寫入失敗時不會留下「帳說成功、檔卻不在」的假紀錄。
        _tmp = vdir / ".verdict.tmp"
        try:
            _tmp.write_text(json.dumps(verdict, ensure_ascii=False, indent=1), encoding="utf-8")
        except OSError as e:
            print(f"擋下:verdict 寫不進去({e}): {target}", file=sys.stderr)
            return 2
        _refroze = None
        if target.exists():
            # 重凍=制度演進後的合法基準更新,比照 anchor approve:理由必填+留痕+歸檔不覆寫
            if not note or not note.strip():
                print("擋下:這個 loop 已有 golden 判定檔——重凍要帶 --note 說為什麼(比照 anchor approve,寫治理帳留痕)", file=sys.stderr)
                return 2
            stamp = datetime.datetime.now().strftime("%Y-%m-%d-%H%M%S")
            arch = vdir / f"verdict-{stamp}.json"
            if arch.exists():
                print(f"擋下:歸檔目的檔已存在({arch.name}),不覆寫歷史——等一秒再重凍", file=sys.stderr)
                return 2
            try:
                target.rename(arch)
            except OSError as e:
                print(f"擋下:歸檔失敗({e})——多半是同秒有另一個重凍在跑,等一下再試", file=sys.stderr)
                return 2
            _refroze = arch.name
        import os as _os_rp
        try:
            _os_rp.replace(_tmp, target)
        except OSError as e:
            print(f"擋下:新 verdict 換上位失敗({e})——舊檔"
                  + (f"已歸檔 {_refroze},此刻這個 loop 沒有現行 verdict,修好磁碟後重跑 --freeze" if _refroze else "未動")
                  , file=sys.stderr)
            return 2
        if _refroze:
            _loop_gov_mark(env, loop_id, "replay-refreeze", note.strip())
            print(f"  舊 golden 已歸檔 {_refroze};重凍理由已寫治理帳")
        print(f"✓ 已凍結 {loop_id} 的判定閉包(輪 {rid},{len(raw)} 列帳,{len(files)} 份卷證檔)"
              f"\n    {target}")
        return 0

    # ── 回放模式 ──
    try:
        g = json.loads(Path(golden).read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        print(f"擋下:golden 檔讀不了({e}): {golden}", file=sys.stderr)
        return 2
    red = []
    # ── ⓪ golden 本體先驗(cb3 finder-f3/ext-f2:回放不能拿 golden 驗 golden 自己——
    # 對 HEAD blob 比對,竄改/未提交的修改先現形;不在 HEAD=剛凍結未 commit,提醒不紅)──
    try:
        _grel = str(Path(golden).resolve().relative_to(Path(root)))
        _gblob, _gerr = _replay_git_blob(root, _grel)
        if _gerr and "還沒 commit" not in _gerr:
            red.append(f"golden 本體與版控不符({_gerr})——凍結檔的竄改偵測以版控為錨,先查 git diff -- {_grel}")
        elif _gerr:
            print(f"  (提醒:golden 尚未 commit——入版控後才受本體竄改偵測保護)")
    except ValueError:
        print("  (提醒:golden 在 repo 外,無法版控錨定本體)")
    # engine_rev 不同=過期,但只跳過「重算」;帳被動/檔被動的完整性檢查照跑
    # (cb3 s2-f2:原提早 return 讓「改個版本欄位」就繞過全部竄改偵測)
    _engine_stale = g.get("engine_rev") != _REPLAY_ENGINE_REV
    # ① live 帳集合分類(基準=凍結當下全列 sha 集;只凍判定輪會讓多輪 loop 恆報長大,r2 delta d-f2)
    raw, _parsed_live = _load_rows()
    if raw is None:
        return 2
    live = {_sha(l) for l in raw}
    frozen = set(g.get("all_row_shas", []))
    missing = frozen - live
    extra = live - frozen
    if missing:
        red.append(f"帳被動:凍結時的 {len(missing)} 列帳在現帳裡消失或被改(append-only 帳不該少東西)")
    if extra:
        print(f"  帳本長大:凍結後同 loop 合法多了 {len(extra)} 列(常態,不紅)")
    # ② 凍結卷證檔完整性(sha 先驗;壞了不硬算,不誤報成邏輯漂移——r2 ext-f4)
    file_bad = []
    for rp, meta in (g.get("files") or {}).items():
        fp = Path(root) / rp
        try:
            cur = _sha256_file(fp)
        except OSError:
            file_bad.append(f"{rp}(佚失)")
            continue
        if cur != meta.get("sha256"):
            file_bad.append(f"{rp}(內容被動;git blob {str(meta.get('git_blob'))[:10]} 可從版控史回復)")
    if file_bad:
        red.append("凍結檔被動/佚失:" + ";".join(file_bad))
    if _engine_stale:
        import shlex as _shlex   # 代碼審 r3 資安 G1:印給人照抄的指令,編號與帳上的路徑都加引號
        _gsp = g.get("spec_path")
        print(f"  golden 過期(制度已演進:{g.get('engine_rev')} → {_REPLAY_ENGINE_REV})——"
              f"重算跳過;完整性檢查照上;確認新制合理後重凍:"
              f"lumos loop replay {_shlex.quote(loop_id)} --freeze --spec {_shlex.quote(str(_gsp)) if _gsp else '<計劃>'} --note <理由>")
    # ③ 對凍結閉包重算(卷證檔壞了就不硬算;制度過期不硬算)
    if not file_bad and not _engine_stale:
        rows = []
        for line in g.get("rows", []):
            try:
                rows.append(json.loads(line))
            except ValueError:
                red.append("golden 檔內帳列解析失敗(golden 自身損壞)")
                rows = None
                break
        if rows is not None:
            out = {}
            rc = _loop_status_disposal(rows, loop_id, None, 0, root, env=env, repo=repo,
                                       readonly=True, spec_sha_override=g.get("spec_sha"),
                                       result_out=out)
            want = g.get("verdict") or {}
            if rc == 2:
                red.append("邏輯漂移:凍結輸入現在連判定都進不了(當時判得了)——讀側行為變了")
            elif rc != want.get("rc") or sorted(out.get("fails", [])) != sorted(want.get("fails", [])):
                red.append(f"邏輯漂移:同一份凍結輸入重算判定不同——當時 rc={want.get('rc')}"
                           f" fails={want.get('fails')},現在 rc={rc} fails={out.get('fails')}")
    if red:
        for r in red:
            print(f"⛔ {r}")
        return 1
    print(f"✓ 回放一致:{loop_id} 輪 {g.get('round')} 同輸入同判定,凍結帳與卷證完好")
    return 0


def cmd_loop_rewrite(env, loop_id, successor, note):
    """人裁「整份重寫」的收尾記帳(設計審收斂重定義 d3 帳面件的寫入端;2026-08-25 第一次真實
    rewrite 事件時補建)。寫 gate=design-loop kind=rewrite 事件到治理帳,note 機械帶血緣
    (prev=舊編號;successor=新編號)——「連續兩次判重寫→強制攤人,不得三開」靠沿 note 鏈查,
    本指令寫入前自動查一跳:若本編號自己就是某次 rewrite 的 successor,印強制攤人警告(advisory)。"""
    if not successor or successor.strip() == loop_id.strip():
        print("擋下:--successor 要給新開的迴圈編號,而且不能跟舊編號一樣——重寫=換新編號載新版,同號沒有「重寫」可言", file=sys.stderr)
        return 2
    # 血緣一跳查詢:這個編號是不是已經是上一次重寫的產物?
    chain_prev = None
    try:
        import json as _j
        import re as _re
        gl = env.vault.parent / ".governance-log.jsonl"
        # 邊界比對:successor=<id> 後面必須是分號或字串結尾——裸子字串會讓前綴編號互撞
        # (successor=lf-a 誤中 successor=lf-a2;clf r1 主審 F1 實驗重現),偽造連續重寫警告。
        _pat = _re.compile(r"successor=" + _re.escape(loop_id.strip()) + r"(;|$)")
        if gl.exists():
            for line in gl.read_text(encoding="utf-8").splitlines():
                try:
                    o = _j.loads(line)
                except ValueError:
                    continue
                if not isinstance(o, dict):
                    continue          # 非物件 JSON 行(壞帳)跳過,不炸整個指令
                if o.get("gate") == "design-loop" and o.get("kind") == "rewrite" \
                        and _pat.search(str(o.get("note", ""))):
                    chain_prev = (o.get("nodes") or [None])[0]   # 多筆時取最後一筆(帳序=時序,最近的血緣)
    except OSError:
        pass
    lineage = f"prev={loop_id.strip()};successor={successor.strip()};{note or ''}".rstrip(";")
    _loop_gov_mark(env, loop_id.strip(), "rewrite", lineage)
    print(f"✓ 迴圈 {loop_id} 以「人裁整份重寫」收尾,入治理帳;新版由 {successor} 接手審。")
    print("  在意的原因:重寫不重置攤人義務——這筆帳讓「gov --stats」的放行率統計不失真,也讓血緣可查。")
    if chain_prev:
        print(f"  ★這已是連續第二次判重寫(上一段血緣:{chain_prev} → {loop_id})——強制攤人,不得三開★")
    print("  之後查血緣:")
    print("    lumos gov --stats")
    return 0


def _gate_event(repo_root, gate, kind, note, *, hard=False, head_sha=None,
                ref=None, nodes=None, extra=None):
    """擋人(或放行/被跳過)的那一刻,由★做判定的那一方★落一筆治理帳(#19 S1)。

    ★為什麼不是 hook 來記★:這個 repo 既有的寫入模式是「做事的那支子命令,
    順便把自己的判定落帳」(_append_governance_log 的寫者是 doctor --ci 與 anchor approve;
    _codeloop_gov_log 的寫者是 code-loop 自己)。沒有任何先例是「hook 呼叫一個
    專門用來記帳的端點」——而且 2026-09-07 真的有人寫過一個不存在的 `lumos gov-event`,
    當時的結論就是「工具沒有給外部腳本寫治理帳的入口」。r1 架構對齊席把這條翻出來。

    ★attempt_id 是拿來把同一次推送的事件串起來的★(#19 S6):pre-push 是逐 ref 迴圈,
    而錨點與健檢跑在迴圈外面——「當下的 commit」對整支層級的閘沒有唯一答案。
    整支層級的事件用 attempt_id(由 hook 產生、經環境變數傳進來),
    逐 ref 的事件另外帶那一行真正的 sha。

    ★回傳值要被看★(#19 S7):True=寫進去了,False=沒寫進去。
    既有的寫入器是 `except OSError: pass`,錯誤靜靜吞掉——如果新的照抄,
    「擋人時一定有帳」這個承諾在磁碟滿/權限錯/帳檔壞掉時就是空的。
    ★但是:寫不進去不得改寫閘的判定★——該擋還是擋(反過來要求「寫成功才擋」
    會讓觀測系統故障變成放行,那正是這批要修的病的鏡像)。呼叫端負責在 stderr 講一句。
    """
    import json as _json
    import datetime as _dt
    root = Path(repo_root)
    docs = root / "docs"
    if not docs.is_dir():
        # ★「這個 repo 根本沒有這本帳」不是「寫不進去」★(2026-09-08 r1 通才席 major):
        # 沒跑過 lumos init 的 repo 本來就沒有 docs/,這是結構性、每次都會發生、
        # 永遠不會自己好。用「寫不進去」那句話講它,會讓人以為工具壞了去瞎排查,
        # 久了養成忽略這類警告的習慣——恰好抵銷這批想建立的信任。
        # 既有的姐妹寫入器面對同一情境是靜靜略過,這裡對齊它:回 None 表示「不適用」。
        return None
    if not head_sha:
        try:
            head_sha = _sp_run_text(["git", "-C", str(root), "rev-parse", "HEAD"])
        except Exception:
            head_sha = ""
    # ★動態閘名要自己對名單★(既有漂移釘 t_gov_stats_gate_drift 抓到的):
    # 那條釘子掃全檔「"gate": 後面不是字串字面值」的位置,防的是
    # 「用變數當閘名 → 逃過字面值掃描 → gov 的名單漏掉它」。這支是通用寫入器,
    # 閘名本來就是參數,所以改成★在這裡對名單★——不在名單上就不寫,並且喊出來。
    # 這樣既保住那條釘子的用意,又不必為了通過它把通用寫入器拆成六份。
    if gate not in _KNOWN_GATES:
        print(f"  ⚠ 想記一筆 gate={gate},但它不在 _KNOWN_GATES 名單上——"
              f"沒有寫(否則 gov 的統計會漏掉它)。要新增閘名請同時更新 _KNOWN_GATES。",
              file=sys.stderr)
        return False
    ev = {
        "ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "commit": (head_sha or "")[:7],
        "gate": gate, "kind": kind, "hard": bool(hard),
        "nodes": list(nodes or []), "note": note,
        # ★同一個 gate 的欄位名要對得起來★(2026-09-08 r1 架構席 major):
        # 既有的 _codeloop_gov_log 把備註寫成 detail、分支寫成 branch,而這支寫 note / ref
        # ——同一個 gate="code-loop" 的歷史紀錄要認兩套欄名才查得全。兩邊都寫。
        "detail": note,
    }
    att = os.environ.get("LUMOS_PUSH_ATTEMPT", "").strip()
    if att:
        ev["attempt_id"] = att[:64]
    if ref:
        # ★這裡刻意不寫 branch★:架構對齊席指出「新事件讀不到」時說了一句
        # 「目前不算功能性錯誤——新事件本來就不該被當成 marker」。
        # ★那句話講的是一個保護,不是一個不一致★——我第一次折的時候把它當成欄名不一致、
        # 順手加了 branch 別名,結果 blocked 事件當場被 _codeloop_read_from_ledger
        # 當成留痕讀走,既有測試翻紅。欄名對齊只做 note/detail 那一半,分支識別不對齊。
        ev["ref"] = ref
    if head_sha:
        ev["head_sha"] = head_sha
    if extra:
        ev.update(extra)
    try:
        with open(docs / ".governance-log.jsonl", "a", encoding="utf-8") as f:
            f.write(_json.dumps(ev, ensure_ascii=False) + "\n")
        return True
    except OSError:
        return False


def _gate_event_or_warn(repo_root, gate, kind, note, **kw):
    """落帳,寫不進去就在 stderr 講一句。★永遠不改變呼叫端的判定★(#19 S7)。"""
    ok = _gate_event(repo_root, gate, kind, note, **kw)
    if ok is None:
        return None          # 這個 repo 沒有治理帳(沒跑過 lumos init)——不適用,不是故障
    if not ok:
        print(f"  ⚠ telemetry-write-failed:{gate} 這一筆帳寫不進去(判定不受影響,照原樣執行)",
              file=sys.stderr)
    return ok


def _sp_run_text(cmd):
    import subprocess as _sp
    return _sp.run(cmd, capture_output=True, text=True, errors="replace").stdout.strip()


def _append_governance_log(vault, events):
    """寫者=doctor --ci + anchor approve:把 gate findings append 到 docs/.governance-log.jsonl。
    非 git / 取不到 HEAD → 跳過(不報錯)。dedup 留給讀時(lumos gov)。"""
    if not events:
        return
    import json
    import datetime
    import subprocess
    try:
        commit = subprocess.run(["git", "rev-parse", "--short", "HEAD"],
                                capture_output=True, text=True, errors="replace", cwd=str(vault)).stdout.strip()
    except Exception:
        commit = ""
    if not commit:
        return
    ts = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    path = vault.parent / ".governance-log.jsonl"
    try:
        with open(path, "a", encoding="utf-8") as f:
            for e in events:
                f.write(json.dumps({"ts": ts, "commit": commit, **e}, ensure_ascii=False) + "\n")
    except OSError:
        pass


def run_doctor(env: Env, strict: bool, color: bool, suggest=False, ci=False, verbose=False):
    C = {k: (v if color else "") for k, v in
         dict(R="\033[31m", Y="\033[33m", G="\033[32m", B="\033[1m", X="\033[0m").items()}
    notes, by_stem, resolve = env.notes, env.by_stem, env.resolve
    print(f"{C['B']}lumos doctor{C['X']} — vault: {C['B']}{env.vault}{C['X']} (self-contained, no Obsidian)")
    # [S37] 每支檔有家的擋被關成 warn/off 時開頭就講——關掉這件事要看得見
    _nh_mode = _nodehome_config(_vault_repo_root(env))["mode"]
    if _nh_mode != "on":
        print(f"  {C['Y']}⚠{C['X']} 這個專案把「每支檔有家」的擋設成 {_nh_mode}(.lumos/config.json 的 node_home.gate)——新增沒家的檔、寫回落錯篇不會被擋")
    print()
    issues = 0
    gov_events = []          # 本輪 gate findings → governance-log(--ci 才寫)

    def section(idx, title):
        print(f"{C['B']}[{idx}]{C['X']} {title}")

    def ok(msg):
        print(f"  {C['G']}✓{C['X']} {msg}")

    def warn(lines, head, advice=None):
        nonlocal issues
        # ★空清單也是一段提醒★:Check F 這種「沒有逐條、只有一句」的走 warn([]),issues 加 0,
        # 只數 warn_soft 會漏掉它(2026-09-06 全 repo 審視:收尾行說 0 issues 蓋掉七段警告)
        if not lines:
            # 只有標題、沒有逐條的那種提醒(例如「這個 repo 沒接 linter」):它本身就是一條,
            # 不然收尾行會出現「1 段、共 0 條」這種讀不通的話(r1 外家席)
            _soft["segs"] += 1
            _soft["lines"] += 1
            _soft["heads"].append(head)
        print(f"  {C['Y']}⚠{C['X']} {head}")
        for l in lines:
            print(f"      • {l}")
        if advice:
            print(f"  {C['B']}建議動作{C['X']}: {advice}")
        issues += len(lines)

    _verbose = verbose or ci   # --ci 視同 verbose:CI 日誌要完整;互動預設收斂(體檢 #10)
    _SOFT_CAP = 3
    # 收尾行要講「還有幾段提醒」——不改 rc、不改軟硬分級,只是別讓結論行比正文樂觀
    _soft = {"segs": 0, "lines": 0, "heads": []}

    def warn_soft(lines, head, advice=None):
        _soft["segs"] += 1
        _soft["lines"] += len(lines)
        _soft["heads"].append(head)
        # 軟提醒:印出但不動 issues → 不影響 rc(R3-MAJOR-3)
        # ★預設每段最多 3 條★(2026-08-21 體檢 #10):軟段([P]19 行/[Y]6 行…)多為歷史/自指噪音,
        # 每次跑幾十行把硬提醒淹掉、Claude 一整天沒讀過一條;其餘收成一行,--verbose 全列。
        print(f"  {C['Y']}⚠{C['X']} {head}")
        shown = list(lines) if _verbose else list(lines)[:_SOFT_CAP]
        for l in shown:
            print(f"      • {l}")
        if len(lines) > len(shown):
            print(f"      … 另 {len(lines) - len(shown)} 條(lumos doctor --verbose 看全部)")
        if advice:
            print(f"  {C['B']}建議{C['X']}: {advice}")

    collisions = {s: rs for s, rs in by_stem.items() if len(rs) > 1}

    incoming = defaultdict(int)
    unresolved = set()
    for rel, n in notes.items():
        for t in n.targets:
            dest = resolve(t)
            if dest is None:
                unresolved.add(t)
            elif dest != rel:
                incoming[dest] += 1

    section("1/4", "驗證紀錄有沒有掛到它驗證的功能上(沒掛的驗證紀錄等於沒人找得到)")
    # [真遺忘第二刀 2026-07-26] superseded 豁免 orphan 檢查——E1 判死背書叫拔、拔了變 orphan
    # 再被這裡唸=刀子咬尾巴;作廢=該遺忘無事可辦(stale/fail 不豁免:待重驗,orphan 提醒仍有用)。
    orphans = [rel for rel in notes
               if rel.startswith("Verification/") and incoming[rel] == 0
               and status_of(env, rel).strip() != "superseded"]
    if not orphans:
        ok("每份驗證紀錄都有被引用")
    elif suggest:
        print(f"  {C['Y']}⚠{C['X']} 發現 {len(orphans)} 個 Verification 沒任何 incoming link(附推薦掛載 Systems):")
        for o in sorted(orphans):
            print(f"      • {o}")
            sug = _suggest_systems_for_orphan(env, o, notes[o])
            if not sug:
                print("          ↳ (feature/plan_refs/連結皆無線索 → 人工判斷)")
            for sys_rel, _sc, reason in sug[:3]:
                print(f"          ↳ 推薦 {sys_rel}  [{reason}]")
            if len(sug) > 3:
                print(f"          ↳ (另有 {len(sug) - 3} 個較弱線索略過)")
        issues += len(orphans)
        print(f"  {C['B']}建議動作{C['X']}: 確認後 `lumos append <Systems> verified_by \"[[<本篇>]]\"`"
              ";若推薦理由是「本篇正文連向」(verified_by 漏寫)→ `lumos sync-verified-by` 可批次補。")
    else:
        warn(sorted(orphans), f"有 {len(orphans)} 份驗證紀錄沒被任何筆記引用(等於沒人找得到):",
             "找到它驗證的 Systems 並補進 verified_by(`--suggest` 看推薦掛載目標)")
    print()

    # ── ★未閉合 frontmatter(2026-08-03 code-loop r4 抓到的既有 major)★ ──
    # `split_frontmatter` 假設 frontmatter 成對:少一個收尾 `---` 就回 (None, 整份檔),
    # 於是★整份檔(含 frontmatter)當 body 索引★,後果實測有三:
    #   ①該節點的 ★INVARIANT★ ★從 contracts 完全消失★(合約登記簿靜默少一條)
    #   ②block scalar 裡的 [[wikilink]] 變成★真的圖譜邊★(鐵則 2 靜默失效)
    #   ③doctor 輸出★完全不提這個檔★(連 Check S 都沒有它,因為讀不到 type)
    # ★寫入端 `load_raw_for_edit` 對同一狀態明確 raise ValueError,讀取端卻默默照收★
    # ——這道檢查就是把讀取端的沉默補成響亮。放硬 issue(不是軟提醒):它會讓
    # pre-push 的 `doctor --ci` 擋下來,因為靜默少一條合約正是本工具最不能接受的事。
    section("1.5/4", "筆記開頭的欄位區塊有沒有正確收尾(沒收尾整篇會被當成正文,合約標記就消失了)")
    _fm_broken = []
    for _rel in sorted(env.notes):
        try:
            _t = (env.vault / _rel).read_text(encoding="utf-8-sig")
        except OSError:
            continue
        if not _t.startswith("---"):
            continue          # 沒 frontmatter 是合法的,不管
        _ls = _t.split("\n")
        if not any(_ls[_i].strip() == "---" for _i in range(1, len(_ls))):
            _fm_broken.append(_rel)
    if not _fm_broken:
        ok("沒有未閉合的 frontmatter")
    else:
        warn(_fm_broken,
             f"有 {len(_fm_broken)} 篇筆記開頭欄位區塊沒收尾(有起頭的 --- 沒有結尾的 ---),整篇會被當成正文:",
             "補上收尾的 `---`。沒補之前,這篇的合約查不到,正文裡的 [[連結]] 也會被當成真的連結")
    print()

    section("2/4", "有沒有連到不存在筆記的連結")
    if not unresolved:
        ok("沒有連到不存在筆記的連結")
    else:
        warn([f"[[{t}]]" for t in sorted(unresolved)],
             f"有 {len(unresolved)} 個連結連到不存在的筆記:",
             "建立目標筆記 / 修正打錯的名字 / 移除過時引用")
    print()

    section("3/4", "驗證紀錄說它驗了某功能,功能那邊有沒有反向登記")
    # 以 resolve 到的 rel 比對:path 式 [[Verification/X]] 與 basename [[X]] 等價(同篇),
    # 但 [[Projects/X]] 與 Verification/X 不同篇(第二輪審計 NEW-B)。存 Verification 的 rel。
    expected = defaultdict(set)
    for rel, n in notes.items():
        if not rel.startswith("Verification/"):
            continue
        # [E1↔Check3 矛盾修,LandmarkMember 實驗場實錘 2026-07-15] stale/fail 驗證跳過——
        # E1 判死背書要拔,Check 3 若仍強索回掛會跟 E1 打架(拔了這邊報漏寫、掛回那邊報死背書)。
        # 失效驗證的內文連結留作歷史導航,不再構成雙向義務。
        # [真遺忘第二刀 2026-07-26] superseded 同入 skip 集:search 已預設藏作廢節點,
        # doctor 這頭不能反向強索「把作廢驗證掛回」——一邊藏一邊撿=方向打架(Codex teardown審 F3)。
        if status_of(env, rel).strip() in ("stale", "fail", "superseded"):
            continue
        for t in n.targets:
            dest = resolve(t)
            if dest and dest.startswith("Systems/"):
                expected[dest].add(rel)
    missing = []
    for sys_rel, verif_rels in sorted(expected.items()):
        actual_rels = {resolve(link_target(a))
                       for a in as_list(notes[sys_rel].fields.get("verified_by"))}
        actual_rels.discard(None)
        missed = sorted(notes[v].stem for v in verif_rels if v not in actual_rels)
        if missed:
            missing.append(f"{sys_rel} 漏: {' | '.join(missed)}")
    if not missing:
        ok("每份驗證紀錄都掛到了它驗證的功能上")
    else:
        warn(missing, f"有 {len(missing)} 篇功能筆記沒反向登記它的驗證紀錄(verified_by 漏寫):",
             "對每個 Systems 補上漏寫的 verified_by")
    print()

    section("4/4", "計劃結案之後又有新驗證,計劃本身有沒有跟著更新")
    chain = []
    for rel, n in notes.items():
        if not rel.startswith("Verification/"):
            continue
        refs = as_list(n.fields.get("plan_refs"))
        if not refs:
            continue
        m = DATE_PREFIX_RE.match(n.stem)
        v_date = m.group(1) if m else None
        for r in refs:
            name = r.replace("[[", "").replace("]]", "").split("|")[0].strip()
            dest = resolve(nfc(name))
            if dest is None:
                chain.append(f"{n.stem} 的 plan_refs 斷鏈: {name}")
                continue
            pf = notes[dest].fields
            status = str(pf.get("status", ""))
            u = pf.get("updated", "")
            u = (u[0] if u else "") if isinstance(u, list) else u  # updated 萬一是 list 取首項(GAP-2)
            p_updated = str(u)[:10] or None
            if status in ("done", "superseded") and v_date and p_updated and v_date > p_updated:
                chain.append(f"{notes[dest].stem} (status:{status}, updated:{p_updated}) "
                             f"結案後有較新驗證: {n.stem}")
    if not chain:
        ok("每個結案計劃都有跟上它後來的驗證,沒有斷掉的引用")
    else:
        warn(sorted(chain), f"有 {len(chain)} 個計劃結案後沒跟上新驗證、或引用斷掉:",
             "結案計劃有較新驗證 → 更新計劃本體; 斷鏈 → 修正 plan_refs 路徑")
    print()

    section("G", "有沒有兩篇筆記同檔名(連結會分不清要連哪一篇)")
    if not collisions:
        ok("沒有同檔名的筆記,連結不會連錯")
    else:
        warn([f"{s}: {' , '.join(sorted(rs))}" for s, rs in sorted(collisions.items())],
             f"有 {len(collisions)} 組筆記同檔名——不帶資料夾的連結會分不清要連哪篇:",
             "改名其一,或全 vault 引用改用完整路徑形態")
    print()

    section("L", "筆記開頭欄位的格式有沒有踩到已知會讓工具讀錯的寫法")
    lint_lines = []
    for rel, n in sorted(notes.items()):
        for l in n.lint:
            lint_lines.append(f"{rel}: {l}")
    if not lint_lines:
        ok("筆記開頭欄位沒踩到已知會讀錯的寫法")
    else:
        warn(lint_lines, f"有 {len(lint_lines)} 處開頭欄位踩到已知會讀錯的寫法:",
             "鐵則修法見 lumos-project-notes skill; 污染指紋見 pre-commit Gate 1 指引")
    print()

    # Check M: 狀態標籤漂移(status 欄位 vs tags 的 status/*;反正規化完整性,
    # 兜住繞過 set status 同步的寫入路徑;見 Projects/狀態標籤同步守衛_計劃)
    section("M", "狀態欄位跟狀態標籤有沒有講同一件事")
    drift_lines = []
    for rel, n in sorted(notes.items()):
        st = n.fields.get("status")
        if not (isinstance(st, str) and st.strip()):
            continue
        for tg in as_list(n.fields.get("tags")):
            if isinstance(tg, str) and tg.startswith("status/") and tg != f"status/{st.strip()}":
                drift_lines.append(f"{rel}: status={st} vs {tg}")
    if not drift_lines:
        ok("狀態欄位跟狀態標籤一致")
    else:
        warn(drift_lines, f"有 {len(drift_lines)} 篇的狀態欄位跟狀態標籤不一致(漂移):",
             "`lumos set <節點> status <值>` 會連標籤一起同步;手改請對齊兩處")
    print()

    # Check C: core_refs 跨 repo 指針完整性(只在有 core_refs 時跑)
    import os
    section("C", "指向跨專案核心知識庫的指針,對方檔案還在不在")
    repo_root = None
    for p in env.vault.parents:
        if p.name == "docs":
            repo_root = p.parent
            break
    core_env = os.environ.get("CORE_KNOWLEDGE_ROOT")
    core_refs_all = []
    for rel, n in sorted(notes.items()):
        for ref in as_list(n.fields.get("core_refs")):
            r = ref.strip()
            if r:
                core_refs_all.append((rel, r))
    # 核心 repo 根目錄: CORE_KNOWLEDGE_ROOT env 優先,否則 sibling 慣例(<repo>.parent/<repo-dir-name>)
    core_base = None
    if core_env:
        core_base = Path(core_env)
    elif repo_root is not None and core_refs_all:
        first_seg = core_refs_all[0][1].split("/", 1)[0]
        core_base = repo_root.parent / first_seg
    if not core_refs_all:
        ok("沒有指向跨專案核心知識庫的指針")
    elif core_base is None or not core_base.is_dir():
        # 核心 repo 不在此環境(如 CI 未 checkout 跨 repo)→ 跳過,不誤判懸空
        print(f"  {C['Y']}—{C['X']} 核心 repo 不在此環境(CI 未 checkout?),跳過跨 repo 檢查"
              f"(本機設 CORE_KNOWLEDGE_ROOT 或置核心 repo 為 sibling 可驗)")
    else:
        dangling = []
        for rel, ref in core_refs_all:
            if core_env:
                parts = ref.split("/", 1)
                rest = parts[1] if len(parts) == 2 else ref
                target = core_base / rest
            else:
                target = repo_root.parent / ref
            if not target.exists():
                dangling.append(f"{rel} → {ref}")
        if not dangling:
            ok(f"{len(core_refs_all)} 個跨專案指針都指到存在的檔")
        else:
            warn(dangling, f"有 {len(dangling)} 個跨專案指針指向核心知識庫裡不存在的檔:",
                 "核心 repo 改名/移檔 → 修專案 core_refs 路徑(指針紀律不留快照,懸空=權威失聯)")
    print()

    # Check T: ★INVARIANT★ 合約測試綁定(載重宣稱必須認領存在的可執行證據)
    # 「形式 → 真」缺的那一環:doctor 不執行測試,但強制每條 ★INVARIANT★ 指向一個
    # 真實存在的測試 → 杜絕「裸合約」(宣稱無證據)與「懸空 test_ref」(綁了不存在的測試)。
    section("T", "標成「不能破壞的合約」的規則,有沒有綁到一條真的會跑的測試")
    inv_all = []
    for rel, n in sorted(notes.items()):
        invs, _ = extract_contracts(n)
        for inv in invs:
            inv_all.append((rel, inv))
    if not inv_all:
        ok("沒有標成「不能破壞的合約」的規則,不需要綁測試")
    else:
        naked, bound, unaudited = [], [], []
        for rel, inv in inv_all:
            clean, refs = strip_test_refs(inv)
            if refs:
                bound.append((rel, clean, refs))
                if not invariant_audit_refs(inv):     # 綁了測試但沒經獨立合法性審計
                    unaudited.append((rel, clean))
            else:
                naked.append((rel, clean, refs))
        dangling, fake, bad_platform = [], [], []
        if bound:
            if repo_root is None:
                print(f"  {C['Y']}—{C['X']} 無法定位 repo root,跳過 test_ref 存在性檢查(裸合約仍檢)")
            else:
                # 多平台感知:每 ref 依平台前綴選對 root+profile 的 method set/haystack(跨 repo)。
                pdata, split, default, methods_for, hay_for = _platform_test_index(repo_root)
                for rel, clean, refs in bound:
                    for seg in refs:
                        if split and ":" in seg:            # 多平台:含冒號 = 平台:名
                            plat, name = seg.split(":", 1)
                            plat, name = plat.strip(), name.strip()
                            if plat not in split:           # 未定義前綴 → 明確報錯(不誤當方法名)
                                bad_platform.append(
                                    f"{rel}: [test:{seg}] 平台前綴 '{plat}' 未定義於 platforms"
                                    f"({', '.join(split)})")
                                continue
                        else:                               # legacy 或無前綴段 → default 平台
                            plat, name = default, seg
                        if name in methods_for(plat):
                            continue  # 真實測試方法(依該平台 profile 認 attr)
                        _attr = pdata["platforms"][plat]["profile"]["attr_hint"]
                        if name in hay_for(plat):
                            # 出現在程式碼但不是測試方法 → 偽證據(子字串巧合/被改名/拼錯屬性)
                            fake.append(f"{rel}: [test:{seg}] 在程式碼出現,但不是 {_attr} 測試方法")
                        else:
                            dangling.append(f"{rel}: [test:{seg}] 在程式碼中找不到")
        if not naked and not dangling and not fake and not unaudited and not bad_platform:
            ok(f"{len(bound)} 條 ★INVARIANT★ 都綁了真實可執行測試方法且經獨立審計 "
               "(0 裸合約 / 0 偽證據 / 0 懸空 / 0 未審 / 0 未定義平台)")
        if bad_platform:
            warn(bad_platform, f"有 {len(bad_platform)} 條測試綁定寫了未定義的平台前綴(設定檔 platforms 裡沒這個平台):",
                 "config.json 的 platforms 補該平台,或修正 [test:平台:名] 的平台前綴")
        if naked:
            warn([f"{r}: {first_line(c, 70)}" for r, c, _ in naked],
                 f"發現 {len(naked)} 條裸 ★INVARIANT★:標成不能破壞的合約,卻沒綁任何測試,沒人能機械驗證它還成不成立:",
                 "在 invariant 行尾加 [test:測試名],並寫對應測試")
        if fake:
            warn(fake, f"發現 {len(fake)} 條偽證據:合約綁的名字不是真的測試方法,跑不起來:",
                 "確認 [test:] 名字 = 該平台 profile 認的真測試方法名(別綁到散文/工具方法/拼錯屬性)")
        if dangling:
            warn(dangling, f"有 {len(dangling)} 條合約綁的測試在程式碼裡找不到(懸空):",
                 "建立該測試,或修正 [test:] 名稱")
        if unaudited:
            warn([f"{r}: {first_line(c, 70)}" for r, c in unaudited],
                 f"發現 {len(unaudited)} 條 ★INVARIANT★ 綁了測試但合法性未經獨立審計 "
                 "(『是不是真鐵則 / 綁的測試夠不夠格』仍由提出者自評 → maker/checker 破口):",
                 "派一個無對話脈絡的乾淨 agent 判合法性(別餵你的結論),過了用 "
                 "`lumos guard audit <node> \"<KEY 行子字串>\"` 留痕")
    print()

    # Check R: 可逆性回退綁定(★IRREVERSIBLE★ 動手前要有實質回退;★CHECKPOINT★ 軟提醒)
    section("R", "標成「做了就回不去」的動作,有沒有寫清楚怎麼回退或怎麼防")
    rev_err, rev_soft = [], []
    for rel, nnote in sorted(notes.items()):
        for marker, clean, ref, guard_ref in extract_reversibility(nnote):
            t_ = nnote.fields.get("type")
            if t_ != "system":
                rev_err.append(f"{rel}: {marker} 標在非 Systems(type={t_!r})")
                gov_events.append({"gate": "check-r", "kind": "blocked", "hard": True, "nodes": [nnote.stem]})
            elif marker == "★IRREVERSIBLE★":
                if not (_rollback_resolved(nnote, ref) or _guard_resolved(nnote, guard_ref)):
                    rev_err.append(f"{rel}: {first_line(clean, 60)} (加 [rollback:decisions] 或 [guard:decisions])")
                    gov_events.append({"gate": "check-r", "kind": "blocked", "hard": True, "nodes": [nnote.stem]})
            elif not _rollback_resolved(nnote, ref):  # ★CHECKPOINT★;guard_ref 不讀
                rev_soft.append(f"{rel}: {first_line(clean, 60)}")
                gov_events.append({"gate": "check-r", "kind": "warned", "hard": False, "nodes": [nnote.stem]})
    if not rev_err and not rev_soft:
        ok("無未綁回退的可逆性標記")
    if rev_err:
        warn(rev_err, f"發現 {len(rev_err)} 條 ★IRREVERSIBLE★ 缺實質回退/標錯型別:標成做了回不去,卻沒寫怎麼回退或怎麼防:",
             "在那一行加 [rollback:decisions](寫怎麼退)或 [guard:decisions](寫怎麼防重複做),並在 decisions 裡填上內容;這種標記只能放在 Systems 筆記")
    if rev_soft:
        warn_soft(rev_soft, f"{len(rev_soft)} 條標成「有存檔點」的動作建議補寫回退方式(不擋):",
                  "加 [rollback:decisions] + decisions rollback")
    print()

    # Check S: L4 自足性審計提醒(軟,不擋,不計 issues)——type=system 節點:
    #   無 self_audit(或格式非法) = 從未跑 L4;self_audit 日期 < updated = 節點更新後未重審(過期)。
    # 真實性無法機械驗(lumos 不 spawn agent),只給「摩擦地板」提醒派乾淨 agent 跑自足性審計
    # (只讀圖譜還原現況),過了 `lumos self-audit <node>` 留痕。同 maker/checker 誠實天花板。
    section("S", "功能筆記有沒有被不知道背景的人重新確認過內容還站得住(提醒,不擋)")
    sa_missing, sa_stale = [], []
    for rel, n in sorted(notes.items()):
        if n.fields.get("type") != "system":
            continue
        if str(n.fields.get("status", "")).strip() in ("stale", "superseded"):
            continue
        sa_val = str(n.fields.get("self_audit", "")).strip()
        m = re.search(r"(\d{4}-\d{2}-\d{2})", sa_val) if sa_val else None
        sa_date = m.group(1) if m else None
        if not sa_date:                       # 無 self_audit 或解析不出日期 → 視同未審
            sa_missing.append(rel)
            gov_events.append({"gate": "check-s", "kind": "warned", "hard": False, "nodes": [n.stem]})
            continue
        upd = str(n.fields.get("updated", "")).strip()
        # 缺 updated → 不做過期判定(避免誤報);有則純字串比較(lumos 保證 bare YYYY-MM-DD)
        if upd and sa_date < upd:
            sa_stale.append((rel, f"{rel} (self_audit {sa_date} < updated {upd})"))
            gov_events.append({"gate": "check-s", "kind": "warned", "hard": False, "nodes": [n.stem]})
    # [S3] 中心性重驗排程:兩清單各自按 PR 降冪重排(僅顯示序;gov 寫入序=上方掃描迴圈,不動)
    if sa_missing or sa_stale:
        _pr_s = _hazen_percentile(_graph_pagerank(env))
        sa_missing.sort(key=lambda r: (-_pr_s.get(r, 0.0), r))
        sa_stale.sort(key=lambda t_: (-_pr_s.get(t_[0], 0.0), t_[0]))
    sa_stale = [m for _rel, m in sa_stale]

    def _soft_list(items, head, advice):
        # 同一個 idiom 另有一份在 _profile_stack_mismatch(它要「兩組各留額度並回傳 list」,
        # 這支吃單一 list 又直接印,裝不下)——改文案或上限時兩邊一起看(r2 架構席 f3)。
        shown = items[:8]
        lines = list(shown)
        if len(items) > len(shown):
            lines.append(f"… 還有 {len(items) - len(shown)} 篇")
        warn_soft(lines, head, advice)

    if not sa_missing and not sa_stale:
        ok("每篇功能筆記都有人重新確認過,而且確認之後沒再改動")
    if sa_missing:
        _soft_list(sa_missing,
                   f"有 {len(sa_missing)} 篇功能筆記從來沒被不知道背景的人重新確認過內容還站不站得住:",
                   "派無脈絡乾淨 agent 只讀圖譜還原現況,過了 `lumos self-audit <node>` 留痕;輕量無需則略過")
    if sa_stale:
        _soft_list(sa_stale,
                   f"有 {len(sa_stale)} 篇功能筆記在上次確認之後又改過,需要再確認一次:",
                   "重派乾淨 agent 還原審後 `lumos self-audit <node>` 重新留痕")
    print()

    # Check S2: about_code 過期(軟,不擋,不計 issues)——工具清單 #6(Projects/固定席扇出降權_計劃,2026-08-24):
    #   有 about_code_stamp 的節點(全 type,不只 system——事故類也標),比「現在正文雜湊」vs stamp 第三段;
    #   不同=標了之後正文改過(標籤可能不對);沒第三段/非 12 碼 hex=舊格式。跳過 stale/superseded(同 Check S)。
    #   ★不併入 Check S★(它只掃 system,r3 s3f11);★不用 git★(三輪設計審實證日期制表達不了順序);
    #   受總開關 LUMOS_IMPACT_ABOUT(0=整段略過,s1f6:只關一半等於沒關)。訊息先叫人看標籤對不對,restamp 不是萬靈丹(Codex r3 f1)。
    section("S2", "語意「關於」標籤(about_code)標了之後正文有沒有又改過(提醒,不擋)")
    if int(_impact_knob("LUMOS_IMPACT_ABOUT", 1)) == 0:
        ok("(about 總開關 LUMOS_IMPACT_ABOUT=0,過期檢查略過)")
    else:
        ac_stale, ac_oldfmt = [], []
        for rel, n in sorted(notes.items()):
            stamp = n.fields.get("about_code_stamp")
            if not isinstance(stamp, str) or not stamp.strip():
                continue
            if str(n.fields.get("status", "")).strip() in ("stale", "superseded"):
                continue
            expired, nh, sh = about_code_expired(env.vault, rel, stamp)
            if sh is None:
                ac_oldfmt.append(f"{rel} (about_code_stamp {stamp} 沒有正文雜湊段,舊格式)")
                gov_events.append({"gate": "check-s2", "kind": "warned", "hard": False, "nodes": [n.stem]})
            elif expired:
                ac_stale.append(f"{rel} (about_code_stamp 正文雜湊 {sh} → 現在 {nh if nh is not None else '讀不到正文'})")
                gov_events.append({"gate": "check-s2", "kind": "warned", "hard": False, "nodes": [n.stem]})
        if not ac_stale and not ac_oldfmt:
            ok("每篇有 about_code 標籤的筆記,標了之後正文都沒再改")
        if ac_stale:
            _soft_list(ac_stale,
                       f"有 {len(ac_stale)} 篇筆記的 about_code 標了之後正文又改過,標籤可能過期:",
                       "先看這篇的 about_code 對現在的正文還對不對:對 → `lumos about-code restamp <節點>`;不對 → set/append/remove 修完再 restamp")
        if ac_oldfmt:
            _soft_list(ac_oldfmt,
                       f"有 {len(ac_oldfmt)} 篇的 about_code_stamp 是舊格式(沒有正文雜湊),量不出有沒有過期:",
                       "批次預標的跑一次 `lumos about-code migrate-stamp --at <標註當時 commit>`;單篇核過就 `lumos about-code restamp <節點>`")
    print()

    section("S3", "設定的技術棧跟專案裡實際的程式碼對不對得上(提醒,不擋)")
    # ★判準是「跟 repo 實際副檔名不符」,不是「還在吃預設值」★(消費專案接入靜默失效 [B]/S2;
    # r1 外家備援席 f2 指出:寫「跟預設不符」會被 init 產出的骨架抵銷——骨架一寫,值就不是預設了,
    # 猜錯也永遠不會出聲)。所以這裡只比實際副檔名,不管值從哪來。
    # ★清單外的語言也要抓得到★(r1 單reviewer f9):副檔名比對只認得出正典表裡那幾種,
    # Rust / Go 之類的專案骨架會留空字串,而讀設定那支對空字串一律靜默退回 C# 預設。
    # 所以另外看一眼「骨架欄位是不是還空著」——那一條跟語言無關。
    _mismatch = _config_left_blank(repo_root) + _profile_stack_mismatch(repo_root)
    if not _mismatch:
        ok("測試與符號的技術棧設定跟專案裡的程式碼對得上")
    else:
        _soft_list(_mismatch,
                   f"有 {len(_mismatch)} 項技術棧設定跟專案裡實際的程式碼對不上:",
                   "改 `.lumos/config.json` 的 test_profile / symbol_profile;對不上的話,測試掃不到(合約綁不上)、符號檢查對你的程式碼視而不見,而且兩者都不會報錯")
        for _m in _mismatch:
            gov_events.append({"gate": "check-s3", "kind": "warned", "hard": False, "nodes": []})
    print()

    section("S4", "標了 about_code 的合約節點,波及計算連得到嗎(提醒,不擋)")
    # ★只唸「有合約且綁測試」的節點★(消費專案接入靜默失效 [C]/S3;r1 接手席實數:
    # 不縮小條件本 repo 會被唸 40 篇、是計劃自訂門檻的四倍,縮小後 2 篇)。
    # 理由:about_code 原本只做固定席排序不做連結(2026-08-23 甲案收窄)。
    # ★2026-09-12 這個前提已部分翻案★:確認過的家(那篇正文或摘要真的寫出這支檔)現在會直接進必推名單,
    # 見 [[Projects/推筆記認家_計劃]];這道檢查唸的仍是下面那件事,不受影響。
    # 真正會出事的是「合約綁了測試、但波及計算連不到這個節點」——那道合約測試閘會靜默跳過。
    _unlinked = []
    for rel, n in sorted(notes.items()):
        acs = as_list(n.fields.get("about_code"))
        if not acs:
            continue
        _raw = (env.vault / rel).read_text(encoding="utf-8", errors="replace")
        # ★合約看開頭欄位、路徑看整篇★:合約按慣例寫在 summary 的 KEY 行(讀整篇會把
        # 正文裡「談到某條合約」的筆記也算進來,本 repo 實測 13 篇 vs 2 篇,超過本案自訂的 5 條門檻)。
        _m_fm = re.search(r"(?ms)\A---\n(.*?)^---\n", _raw)
        _fm = _m_fm.group(1) if _m_fm else ""
        if "★INVARIANT★" not in _fm or "[test:" not in _fm:
            continue
        if not any(f"`{a}`" in _raw for a in acs):
            _unlinked.append(f"{rel} (about_code: {', '.join(acs[:2])})")
            gov_events.append({"gate": "check-s4", "kind": "warned", "hard": False, "nodes": [n.stem]})
    if not _unlinked:
        ok("有合約又標了 about_code 的節點,波及計算都連得到")
    else:
        _soft_list(_unlinked,
                   f"有 {len(_unlinked)} 篇標了 about_code 的合約節點,波及計算連不到:",
                   "在正文裡用反引號寫出那個路徑(例:實作在 `app/pay.py`)——about_code 欄位只做排序不建連結,波及計算認的是正文裡的路徑;連不到的話這篇合約綁的測試在推送時會被靜默跳過")
    print()

    section("I", "審查迴圈的首輪前掃有沒有留痕(滾動窗觀測;提醒,不擋)")
    # intake守衛 T4(2026-08-30 d1):升級迴路的機械閉環——外家 r2 裁「計數靠散文=到第六案
    # 也不會發生」(repo 有提醒被無視 546 次的帳)。數數和喊人的是機器,決定升不升的是人。
    # 滾動窗(r3-F4:累積制觸發後恆真、每天印同句=546 形態;窗內達標自然靜默)。
    try:
        import subprocess as _sp
        _repo_root = _vault_repo_root(env)
        # 窗的 cutoff=宣告行慣例誕生日(2026-08-30),非 intake 慣例誕生日(08-25)——
        # 數誕生前的迴圈=首日必觸發且永不能合規(r3-F5「同向偏誤」的實現,落地冒煙當場撞到)
        _r = _sp.run(["git", "-c", "core.quotepath=false", "log", "--diff-filter=A",
                      "--since=2026-08-30T00:00:00", "--name-only", "--pretty=format:",
                      "--", "governance/review-reports/"],
                     capture_output=True, text=True, errors="replace", cwd=str(_repo_root), timeout=15)
        if _r.returncode != 0:
            raise RuntimeError("git log 失敗")
        _seen = []
        for _ln in reversed(_r.stdout.splitlines()):   # 反轉=舊到新,首見序=迴圈開場序
            _ln = _ln.strip().strip('"')
            _parts = _ln.split("/")
            if len(_parts) < 3 or _parts[0] != "governance" or _parts[1] != "review-reports":
                continue
            _d = _parts[2]
            if _d.startswith("code"):
                continue   # r3-F2:code-loop 零前掃步驟,計數它=逼偽宣告
            _dp = _repo_root / "governance" / "review-reports" / _d
            if not _dp.is_dir():
                continue   # r3-F1:review-reports/ 下有散檔,排除非目錄項
            if _d not in _seen:
                _seen.append(_d)
        _win = _seen[-6:]   # 滾動窗=最近 6 個非 code 迴圈
        _decl = [_d for _d in _win if _intake_dir_status(_repo_root, _d) == "ok"]
        if not _win:
            ok("宣告行慣例誕生(2026-08-30)後還沒有非 code 審查迴圈,無可觀測")
        elif len(_win) < 6:
            ok(f"滾動窗未滿(現 {len(_win)}/6 個迴圈,{len(_decl)} 個有前掃宣告行)——滿 6 個才判")
        elif len(_decl) >= 5:
            ok(f"最近 6 個審查迴圈有 {len(_decl)} 個帶前掃宣告行(≥5/6)——慣例活著")
        else:
            _absent = [_d for _d in _win if _d not in _decl]
            # 條件(c):缺席迴圈帳面有 blocker 輪(嚴重度是帳面欄位,機械可讀——取代不可判的分類)
            _blk = []
            try:
                _clog = _repo_root / "docs" / ".canary-log.jsonl"
                import json as _j
                _rows = [_j.loads(_l) for _l in _clog.read_text(encoding="utf-8").splitlines() if _l.strip()]
                for _d in _absent:
                    if any(_row.get("loop") == _d and _row.get("severity") == "blocker" for _row in _rows):
                        _blk.append(_d)
            except OSError:
                pass
            if _blk:
                warn([f"缺席且帳面有 blocker 輪:{', '.join(_blk)}"],
                     f"最近 6 個審查迴圈只有 {len(_decl)} 個帶前掃宣告行(<5/6),且缺席迴圈出過 blocker——"
                     "★轉硬擋條件已達,去裁:Projects/intake守衛_計劃(T4 預先登記的裁決請求)★:",
                     "裁「升 --intake 為必附」或「維持 advisory 並記理由」;窗內補齊宣告行後本段自然靜默")
            else:
                # ★這一支要用「不擋」的那支★(2026-09-07 全 repo 審視 batch12 順修):
                # 訊息自己寫著「未達裁決門檻」,卻用了會讓 issue 計數增加、進而擋住推送的那支
                # ——說沒達門檻又擋人,自相矛盾。而且這一段的標題就寫著「提醒,不擋」。
                # 上面那支(缺席者出過 blocker、"轉硬擋條件已達")是刻意要擋的,維持不動。
                # 出身:同一天的代碼審在別的地方抓到「標題寫不擋、實際會擋」這個形態,
                # 回頭查這一段就是同型,而且當場擋住了一次正常的推送。
                warn_soft([f"缺席:{', '.join(_absent)}"],
                          f"最近 6 個審查迴圈只有 {len(_decl)} 個帶前掃宣告行(<5/6),但缺席者無 blocker 輪(未達裁決門檻):",
                          "首輪前掃(design-loop 步驟 2 第四類)跑完把宣告行 preflight-4: ran 寫進 rN-intake.md")
    except Exception as _e:
        ok(f"前掃留痕觀測跳過(fail-open:{_e})")
    print()

    section("A1", "每天自動跑的那支治理腳本,最近有沒有跑完(提醒,不擋)")
    # ★第二通道★(2026-09-07 全 repo 審視 #18):即時通道是 governance/wrapper-watchdog.sh
    # (獨立排程、跟被監看的那支不同失敗域)。這一段是入帳通道,看門狗是外部 shell、沒有寫治理帳的入口。
    # ★訂正第二句我自己寫錯的註解★(2026-09-07 代碼審 r1 邊界席實測打臉):
    # 第一版這裡寫「兩條讀同一份健康檔,所以不會各說各話」——讀同一份檔案不代表看同一個欄位。
    # 這一段讀 steps、看門狗第一版讀 total,餵一份「五步全 0、只有 total 壞掉」的檔,
    # 兩邊當場講出完全相反的結論。現在兩邊都以 steps 為準,total 只當交叉檢查。
    #
    # ★訂正一句我自己寫錯的註解★(2026-09-07 代碼審 r1 架構席判 blocking):
    # 第一版寫「健檢本來就會把 gate findings 落治理帳」——**那不是自動的**。
    # 要那一段自己呼叫 gov_events.append 才會落帳;不掛就永遠進不了 14 天升級鏈,
    # 而「入帳通道」正是這一段存在的唯一理由。
    # (順帶記個實測:14 段軟提醒裡 6 段有掛、8 段沒掛——所以那不是「無一例外的鐵律」,
    #  但我這一段的設計明白依賴落帳,所以非掛不可。)
    # ★一定要用 warn_soft★:同一天才因為「標題寫不擋、實際用了會擋的那支」擋掉一次正常推送
    #(見 [[Systems/測試假綠形態]]);這支腳本沒跑不該擋住任何人推程式碼。
    try:
        import datetime as _dt
        import json as _wj
        _hp = _vault_repo_root(env) / "governance" / ".daily-governance-health.json"
        if not _hp.exists():
            ok("這台機器上沒有那支腳本的健康紀錄(沒裝排程、或還沒跑過第一次)——不判")
        else:
            _hd = _wj.loads(_hp.read_text(encoding="utf-8"))
            # ★型別不對也是「格式不對」,不能讓它掉到最外層的 broad except★
            # (2026-09-07 代碼審 r1 邊界席實測:值是壞字串會印具體的黃色警告,值是 JSON 數字
            #  則拋 AttributeError、被外層吃掉退化成一句綠色「跳過」——同一類壞資料兩種待遇)。
            _fin = _hd.get("finished_at")
            _fin = _fin if isinstance(_fin, str) else ("" if _fin is None else repr(_fin))
            _age = None
            try:
                _d0 = _dt.datetime.fromisoformat(_fin.replace("Z", "+00:00"))
                _age = (_dt.datetime.now(_dt.timezone.utc) - _d0).total_seconds()
            except (ValueError, TypeError, AttributeError):
                pass
            _bad_steps = [k for k, v in (_hd.get("steps") or {}).items() if v not in (0, "0")]
            if _age is None:
                warn_soft([f"健康紀錄的時間讀不動:{_fin!r}"],
                          "那支每天跑的治理腳本,健康紀錄格式不對:",
                          "看 governance/.daily-governance-health.json")
                gov_events.append({"gate": "daily-wrapper", "kind": "unreadable", "hard": False,
                                   "nodes": [], "detail": f"finished_at 讀不動:{_fin!r}"})
            elif _age > 36 * 3600:
                warn_soft([f"最後一次跑完 {_fin}(約 {int(_age/3600)} 小時前)"],
                          "★那支每天跑的治理腳本超過 36 小時沒跑完★——它不會自己喊:",
                          "看 governance/logs/daily-wrapper.log;排程是 launchd com.enzo.lumos.daily-governance")
                gov_events.append({"gate": "daily-wrapper", "kind": "stale", "hard": False,
                                   "nodes": [], "detail": f"最後一次跑完 {_fin}"})
            elif _bad_steps:
                warn_soft([f"失敗的步驟:{', '.join(sorted(_bad_steps))}"],
                          "那支每天跑的治理腳本最後一次跑完,但有步驟失敗:",
                          "看 governance/logs/ 底下對應那一步的 log")
                gov_events.append({"gate": "daily-wrapper", "kind": "step-failed", "hard": False,
                                   "nodes": [], "detail": "失敗的步驟:" + ", ".join(sorted(_bad_steps))})
            else:
                ok(f"那支每天跑的治理腳本 {int((_age or 0)/3600)} 小時前跑完,五步都是 0")

            # ★誰看看門狗★(2026-09-07 代碼審 r1 外家否決席判 blocker 的根):
            # 看門狗自己也是一支排程,它沒被裝、被停掉、或每次一起跑就掛,一樣沒有人會知道。
            # 它每跑一次都會覆寫自己的狀態檔(不管有沒有事),所以那個檔的時間 = 它上次跑的時間。
            _ws = _hp.parent / ".wrapper-watchdog-state"
            _wage = None
            if _ws.exists():
                _wage = _dt.datetime.now().timestamp() - _ws.stat().st_mtime
            # ★剛從睡眠醒來不算逾期★:閉蓋的 Mac 幾乎一直在睡,launchd 的每小時工作
            # 睡著時不會跑;不擋這一下就會在每次長假之後誤報一輪。
            _awake = None
            try:
                import re as _wre
                import subprocess as _wsp
                _wo = _wsp.run(["sysctl", "-n", "kern.waketime"], capture_output=True,
                               text=True, timeout=5).stdout
                _wm = _wre.search(r"\bsec = (\d+)", _wo)
                if _wm:
                    _awake = _dt.datetime.now().timestamp() - int(_wm.group(1))
            except Exception:
                pass
            if _awake is not None and _awake < 2 * 3600:
                pass   # 剛醒來,排程還沒輪到
            elif _wage is None:
                warn_soft(["找不到 governance/.wrapper-watchdog-state"],
                          "★這台機器有治理腳本,但看門狗沒在跑★——腳本死了不會有人知道:",
                          "裝它:bash governance/install-watchdog.sh")
                gov_events.append({"gate": "daily-wrapper", "kind": "watchdog-absent", "hard": False,
                                   "nodes": [], "detail": "看門狗沒有狀態檔,推定沒裝或沒跑"})
            elif _wage > 36 * 3600:
                warn_soft([f"看門狗上次跑是 {int(_wage/3600)} 小時前(排程是每小時一次)"],
                          "★看門狗自己停掉了★——腳本死了不會有人知道:",
                          "查它:bash governance/install-watchdog.sh --status")
                gov_events.append({"gate": "daily-wrapper", "kind": "watchdog-stale", "hard": False,
                                   "nodes": [], "detail": f"看門狗上次跑是 {int(_wage/3600)} 小時前"})
    except Exception as _e:
        ok(f"治理腳本健康觀測跳過(fail-open:{_e})")
    print()

    section("A2", "治理帳長太快了沒(提醒,不擋)")
    # ★只裝門檻觸發器,先不分檔★(2026-09-07 全 repo 審視 #18):
    # 這本帳有四個整檔讀者(rewrite 血緣查詢、gov 彙整、code-loop 的 CI fallback、週回放),
    # 分檔要一起動那四個,現在 4MB 還不值得。分檔的做法到門檻再談。
    # ★訂正一條寫錯的理由★:第一版寫「加上判定回放要逐行算雜湊閉包」——
    # 那個閉包讀的是**另一本帳**(.canary-log.jsonl),不是這一本。四個整檔讀者這半才是真的。
    #
    # ★門檻用「成長率」不是「絕對量」★(設計審 r1 邊界席實測):
    # 原本寫「近 7 日平均每日超過 500 筆」,而實測近 8 天是 62/61/91/159/391/669/931/1155
    # ——7 日均值 337 還沒過,但連三天單日已破 500 且逐日翻倍,那條門檻上線幾天就會天天叫,
    # 變成第三種「叫了但沒人在意」的訊號。改成抓「異常加速」:近 7 日均值 > 前 7 日均值的兩倍。
    _LEDGER_MB_CAP = 5
    try:
        import datetime as _gd
        import json as _wj
        _gp = env.vault.parent / ".governance-log.jsonl"
        if not _gp.exists():
            ok("這個專案還沒有治理帳,不判")
        else:
            _mb = _gp.stat().st_size / 1048576.0
            # ★只讀檔尾,不整份讀★(代碼審 r1 併發席):問題只問「最近 14 天」,
            # 卻用 O(全部歷史) 的讀法回答,而這本帳自己正在加速膨脹——偵測膨脹的機制
            # 自己的成本跟著它想偵測的現象一起長,現在 4MB/34ms 沒事,但沒有封頂。
            _CAP = 24 * 1048576
            _sz = _gp.stat().st_size
            _from = max(0, _sz - _CAP)
            with open(_gp, "rb") as _fh:
                _fh.seek(_from)
                _raw = _fh.read()
            if _from:
                _raw = _raw.split(b"\n", 1)[1] if b"\n" in _raw else b""   # 丟掉切一半的頭一行
            _by_day = {}
            _oldest = None
            for _l in _raw.decode("utf-8", "replace").splitlines():
                _l = _l.strip()
                if not _l or not _l.startswith("{"):
                    continue
                # ★一行壞掉只跳那一行★(代碼審 r1 邊界席實測):第一版用「從 "ts" 起算 40 個字元
                # 再切引號」取日期,而防呆數的引號是「到行尾」、真正切的只有那 40 個字元,兩邊範圍
                # 不一致——ts 的值沒加引號時就 IndexError,被最外層 broad except 接住印成綠色「跳過」,
                # 不是跳過那一行,是整本兩萬多行的統計一起作廢。這本帳沒有寫入時的格式驗證,壞行可達。
                # ★順便對時區★:兩個寫入者一個用本機時區、一個用 commit 作者時區,只截字串前 10 碼
                # 會把午夜前後的同一時刻分進不同天(邊界席與外家否決席各自指出)。
                try:
                    _tv = _wj.loads(_l).get("ts")
                    if not isinstance(_tv, str):
                        continue
                    _td = _gd.datetime.fromisoformat(_tv)
                except Exception:
                    continue
                _day = _td.astimezone().date().isoformat()
                if _oldest is None or _day < _oldest:
                    _oldest = _day
                _by_day[_day] = _by_day.get(_day, 0) + 1
            _today = _gd.date.today()
            # 讀檔尾讀不到 15 天前 → 前 7 日那半是殘的,比出來的倍數會偏高,不比。
            _window_ok = (_from == 0) or (_oldest is not None
                                          and _oldest <= (_today - _gd.timedelta(days=15)).isoformat())
            def _win(a, b):   # 第 a..b 天前(含),缺日算 0
                return [_by_day.get((_today - _gd.timedelta(days=_k)).isoformat(), 0)
                        for _k in range(a, b)]
            _recent = _win(1, 8)     # 昨天往前 7 天(不含今天:今天還沒過完)
            _prev = _win(8, 15)
            _ra = sum(_recent) / 7.0
            _pa = sum(_prev) / 7.0
            _msgs = []
            if _mb > _LEDGER_MB_CAP:
                _msgs.append(f"檔案 {_mb:.1f} MB,超過 {_LEDGER_MB_CAP} MB")
            if not _window_ok:
                pass   # 視窗殘缺,不比成長率(檔案大小那條照判)
            elif _pa >= 1 and _ra > _pa * 2:
                _msgs.append(f"近 7 日平均每天 {_ra:.0f} 筆,是前 7 日({_pa:.0f} 筆)的 {_ra/_pa:.1f} 倍")
            if _msgs:
                warn_soft(_msgs, "治理帳長得比平常快,或已經偏大:",
                          "先看是哪一道閘在重複寫:lumos gov --stats")
                gov_events.append({"gate": "ledger-growth", "kind": "fast", "hard": False,
                                   "nodes": [], "detail": "；".join(_msgs)})
            else:
                ok(f"治理帳 {_mb:.1f} MB;近 7 日每天 {_ra:.0f} 筆(前 7 日 {_pa:.0f} 筆),沒有異常加速"
                   if _window_ok else f"治理帳 {_mb:.1f} MB;只讀得到最近一段,成長率這次不比")
    except Exception as _e:
        ok(f"治理帳成長觀測跳過(fail-open:{_e})")
    print()

    # Check E1: 失效背書(軟,不擋,不計 issues)——關係層語意檢查(補 Check 3 只查邊存不存在、不查
    #   邊還對不對):某節點 verified_by 指向的 Verification 已 stale/fail = 死背書(掛著給人假安心感、
    #   驗證其實已失效)。ghost 目標交既有 ghost 檢查,這裡跳過(不重疊職責)。
    #   設計見 Projects/關係層傳播守衛_計劃 [S6](phase-1 MVP,免前置、純 frontmatter)。
    #   ★這段註解原本孤零零卡在別的段落前面★(2026-09-07 代碼審 r1 架構席指出,查證後
    #   確認★不是本批造成的、之前就分家了★),順手搬回它自己的段落頭上。
    section("E1", "筆記引用的驗證紀錄,是不是已經失效或被推翻了(拿失效的驗證當依據)")
    dead_endorse = []
    for rel, n in sorted(notes.items()):
        for item in as_list(n.fields.get("verified_by")):
            vrel = env.resolve(link_target(item))
            if not vrel:                          # ghost → 交既有 ghost 檢查,跳過
                continue
            vst = status_of(env, vrel).strip()
            if vst in ("stale", "fail", "superseded"):   # superseded=作廢背書同死(真遺忘第二刀 07-26)
                dead_endorse.append(f"{rel} → [[{vrel}]] (status={vst})")
                gov_events.append({"gate": "check-e1", "kind": "warned", "hard": False, "nodes": [n.stem]})
    if not dead_endorse:
        ok("筆記引用的驗證紀錄都還有效")
    else:
        _soft_list(dead_endorse,
                   f"發現 {len(dead_endorse)} 條失效背書(引用的驗證已經失效或被推翻,還掛著當依據):",
                   "重跑驗證改回 pass、或改標記/移除該 verified_by;死背書給假安心感,是關係層頭號腐爛之一")
    print()

    # Check E2: 建在被推翻決策上(軟,不擋,不計 issues)——關係層時序法(把 Check 4 的時序 proxy 推到「決策
    #   翻案」層):某節點 D 有 valid:false 決策(且有 ended)→ 沿「方向語意明確」的連入邊(verified_by/plan_refs)
    #   找指向 D 的來源節點 A → A.updated 早於該決策 ended = A 可能還建在 D 已被推翻的決策上、沒跟上。時序法是
    #   啟發(可能人早手動確認過但沒動 updated),故 warn_soft。內聯 typed 反查(不建 [P0] 可重用 index——doctor
    #   本就掃全圖,補網不需;主網 proactive 連鎖才需 P0)。設計見 Projects/關係層傳播守衛_計劃 [S7]。
    #   已知限制:無 cascade ledger(主網 future)→ 判過無關卻沒動 A.updated 的會每次重報;量少時手動 bump 消音。
    section("E2", "有沒有筆記建立在已經被推翻的決策上、卻沒跟著改")

    import datetime
    def _ymd(s):
        try:
            return datetime.date.fromisoformat(str(s)[:10])
        except (ValueError, TypeError):
            return None
    # [M2] 內聯反查遷移至 build_typed_index 共用(P0);E2 只消費 resolved(ghost/ambiguous
    #   不拿來做時序判定——ghost 交既有 ghost 檢查、ambiguous 由 M4 消費端浮出)。
    #   只收方向語意明確的邊(related 弱、排除)。
    _tidx = build_typed_index(env)
    typed_in = {t: [(s, e) for (s, e) in pairs if e in ("verified_by", "plan_refs")]
                for t, pairs in _tidx["rev"].items()}
    # [M3] ledger 抑制:掃 rel-cascade 帳本折疊出 terminal 事件(判過的粒度鍵)——terminal ts
    #   不早於決策 ended(日級;同日判定=翻案後立即處理的常態)→ 該邊跳過(解「判過無關卻每輪重報」
    #   永久假陽性)。E2 定位帳檔=全目錄掃(復用 list 的讀法),不需重建含秒數的檔名。
    _led_terminal = {}
    _casc_unseen_ts = []   # [T1 連鎖佇列軟提醒] header 合法且零筆判定=開了沒人看過的待辦單
    _casc_broken = 0       # header 損毀(壞 JSON/空檔)——全庫無主動管道報它(E2 只抽 transitions 不看 header)
    _rcd = _rel_cascade_dir(env)
    if _rcd.exists():
        for _p in sorted(_rcd.glob("*.jsonl")):
            _h, _trs = _ledger_read(_p)
            if _h is None:
                _casc_broken += 1
            elif not _trs:
                _casc_unseen_ts.append(str(_h.get("ts", "")))
            for _k, _t in _ledger_fold(_trs).items():
                _led_terminal[_k] = max(_led_terminal.get(_k, ""), str(_t.get("ts", "")))
    build_on_dead = []
    for drel, dn in sorted(notes.items()):
        for d in parse_decisions(dn.fm_lines):
            if str(d.get("valid", "true")).lower() != "false":
                continue
            ended = _ymd(d.get("ended"))
            if not ended:                        # 無 ended → 無從時序比對(P1 起新翻案自動補),跳過
                continue
            dcontent = first_line(str(d.get("content", "")), 40)
            did = str(d.get("id", "")).strip()
            for arel, etype in typed_in.get(drel, []):
                aupd = _ymd(notes[arel].fields.get("updated"))
                if not (aupd and aupd < ended):
                    continue
                # [M1] E2 首判精化:鄰居有 decision_refs → 只在指到「那條」翻案決策時才標
                #   (指到別條=已聲明依賴面、與本翻案無關,不冤枉);無 refs → 退回節點+ended 級(相容不退化)
                # [自動養成 不對稱信任] 抑制向只讀 decision_refs(human/cascade),**不讀 decision_refs_ai**
                #   ——誤 ai-ref 拿來抑制真落後邊=靜默漏傳播=頭號腐爛;ai-ref 抑制不了 E2(結構保證)
                refs = [str(x).strip() for x in as_list(notes[arel].fields.get("decision_refs"))]
                if refs:
                    def _hits(s):
                        mm = re.fullmatch(r"(.+?)#(d\d+)", s)
                        return bool(mm and did and mm.group(2) == did and env.resolve(mm.group(1)) == drel)
                    if not any(_hits(s) for s in refs):
                        continue
                # [M3] ledger 跳過:這筆 (鄰居×邊型×root決策) 已有 terminal 判定且不早於 ended → 判過,不重報
                if did:
                    _lts = _led_terminal.get((arel, etype, f"{drel}#{did}"), "")
                    if _lts:
                        # [tz 跨日修 2026-07-20] ledger ts=UTC(_utc_ts)、ended=本地日期(date.today)
                        # ——兩時間源混用:台北 00:00-08:00 窗口 UTC 日期仍昨天,raw [:10] 比較
                        # 誤判「判定早於翻案」→ 判過照樣重報(t_e2_ledger_tz_boundary 實抓)。
                        # 修=比較點把 UTC ts 轉本地日期;寫入側維持 UTC 不動(歷史帳相容)。
                        _lts_day = _lts[:10]
                        try:
                            import datetime as _dtz
                            _lts_day = _dtz.datetime.fromisoformat(_lts).astimezone().date().isoformat()
                        except ValueError:
                            pass  # 非 iso 舊格式 → 退回 raw 日級比較(fail-open)
                        if _lts_day >= str(d.get("ended", ""))[:10]:
                            continue
                build_on_dead.append(
                    f"{arel} --{etype}--> {drel}(決策「{dcontent}」{ended} 翻案,來源自 {aupd} 未更新)")
                gov_events.append({"gate": "check-e2", "kind": "warned", "hard": False,
                                   "nodes": [notes[arel].stem]})
    if not build_on_dead:
        ok("沒有筆記建在被推翻的決策上")
    else:
        _soft_list(build_on_dead,
                   f"有 {len(build_on_dead)} 處可能建在被推翻的決策上(用時間順序推的,不是定論):",
                   "查該邊是否真受翻案影響:是→更新來源節點跟上新決策;否→已確認無關可 bump 來源 updated 消音;純語意矛盾留 AI 交叉審")

    # Check E4: 翻案開的連鎖待辦單有沒有人跟([T1] Projects/連鎖佇列軟提醒_計劃,2026-08-25)。
    #   刻意全靜默設計:乾淨時整段不印(不佔版面;同 Check W 既有先例);天數=UTC-aware fromisoformat
    #   相減 .days(照 cmd_rel_cascade_list 慣例,勿混本地日期——E2 的 tz 跨日雷);未來 ts 記 0 天;
    #   ts 缺失/非法照計入、天數標不明。擺位:留在 E2 後(統計就在 E2 迴圈收的)——★勿移到 E3 後:
    #   會落進 t_check_e3 系測試的 [E3]..[H] 切片窗★;段名 E4 取新增序,非畫面序(ccr r1 兩席對照後裁)。
    if _casc_unseen_ts or _casc_broken:
        section("E4", "翻案開的連鎖待辦單有沒有人跟")
        import datetime as _dt4
        _now4 = _dt4.datetime.now(_dt4.timezone.utc)
        _daysv, _no_ts = [], 0
        for _ts4 in _casc_unseen_ts:
            try:
                _d04 = _dt4.datetime.fromisoformat(_ts4)
                if _d04.tzinfo is None:
                    _d04 = _d04.replace(tzinfo=_dt4.timezone.utc)
                _daysv.append(max(0, (_now4 - _d04).days))
            except ValueError:
                _no_ts += 1
        _lines4 = []
        if _casc_unseen_ts:
            _age4 = f"最老 {max(_daysv)} 天" if _daysv else "建立時間不明"
            if _daysv and _no_ts:
                _age4 += f",另 {_no_ts} 張建立時間不明"
            _head4 = (f"{len(_casc_unseen_ts)} 張連鎖待辦單自建立後零筆判定({_age4})——"
                      "決策翻案後,引用它的筆記還成不成立沒人回頭判(撤稿研究:沒提醒時 94.6% 的引用不承認撤稿)")
            if _casc_broken:
                _lines4.append(f"另有 {_casc_broken} 張帳本開頭損毀(root 不可恢復),需人工檢視")
        else:
            _head4 = f"{_casc_broken} 張連鎖帳本開頭損毀,待辦單內容救不回來——多半是翻案當下寫入被打斷,需人工檢視"
        warn_soft(_lines4, _head4, advice="lumos rel-cascade list")
        # nodes=[] 是刻意偏離「每違規節點各一筆」慣例:cascade 帳本不是圖譜節點、無 stem 可填,
        # 聚合計數走 note 欄(全庫唯一同形狀的是 doctor-run 彙總事件)。
        gov_events.append({"gate": "check-cascade", "kind": "warned", "hard": False, "nodes": [],
                           "note": f"unseen={len(_casc_unseen_ts)} broken={_casc_broken}"})
        print()
    print()

    # Check E5: 回訪到期(REVISIT 行;Projects/回訪掃描_計劃 v3,2026-08-31)。
    #   段名取新增序非畫面序(E4 慣例);擺位=E4 後 E3 前(勿移進 [E3]..[H] 測試切片窗)。
    #   行判準:strip 行首空白與 - / * 列表前綴後以 REVISIT: 開頭;表格行(| 開頭)與 code 區不算
    #   (走 _search_visible_lines 剝碼)。日期先 fromisoformat parse——失敗=壞行入計數不進比較
    #   (fail-closed,E4 損毀慣例);過了才與今天比,≤今天=到期。全靜默:0 到期 0 壞行整段不印。
    #   gov event nodes=到期筆記 stem(刻意不學 check-cascade 的 nodes=[]:nags 週報按 gate+node
    #   連唸天數升級 LINE,填 stem 牙才咬得到——接電條款另半=daily-governance.sh 跑 doctor --ci)。
    _rv_due, _rv_bad = [], 0
    import datetime as _dt5
    _today5 = _dt5.date.today()
    for _rel5, _n5 in env.notes.items():
        try:
            _txt5 = (env.vault / _rel5).read_text(encoding="utf-8-sig")
        except OSError:
            continue
        for _no5, _raw5, _pr5 in _search_visible_lines(_txt5.split("\n"), False):
            _l5 = _pr5.strip()
            if _l5.startswith(("- ", "* ")):
                _l5 = _l5[2:].lstrip()
            if not _l5.startswith("REVISIT:") or _pr5.lstrip().startswith("|"):
                continue
            _restv = _l5[len("REVISIT:"):]
            _datev, _, _sumv = _restv.partition(" ")
            try:
                _dv = _dt5.date.fromisoformat(_datev)
            except ValueError:
                _rv_bad += 1
                continue
            if _dv <= _today5:
                _rv_due.append(((_today5 - _dv).days, _datev, _sumv.strip(), _n5.stem))
    if _rv_due or _rv_bad:
        section("E5", "回訪到期(當初承認風險時許的「回頭看」)")
        _rv_due.sort(reverse=True)   # 最老優先
        # 摘要與節點名過 _esc_clean(code-revisit r1 H-1:兩天前才在逃逸帳修過的控制碼穿透洞,勿三挖)
        _lines5 = [f"{d} {_esc_clean(sm, 60)}(逾 {ag} 天)← {_esc_clean(st, 40)}" for ag, d, sm, st in _rv_due]
        _head5 = (f"{len(_rv_due)} 件回訪到期(最老逾 {_rv_due[0][0]} 天)——到日子了,處理完把該行日期改下一次或刪行"
                  if _rv_due else "")
        if _rv_bad:
            # 壞損數進 head 不進 lines(H-2:cap3 會把它吞進「另 N 條」隱形——head 恆可見)
            _bad_line5 = f"另有 {_rv_bad} 行 REVISIT 日期格式壞損(parse 不過=永遠不會到期),先修格式"
            if _head5:
                _head5 += f";{_bad_line5}"
            else:
                _head5 = _bad_line5
        warn_soft(_lines5, _head5, advice='lumos search "REVISIT:"')
        gov_events.append({"gate": "check-revisit", "kind": "warned", "hard": False,
                           "nodes": sorted({st for _, _, _, st in _rv_due}),
                           "note": f"due={len(_rv_due)} bad={_rv_bad}"})
        print()

    # Check E3: 意圖鏈斷義(軟,不擋,不計 issues)——[M1/S8] 精確版:decision_refs(全域格式
    #   <節點rel>#dN,M1/P2 決策穩定 ID)指向的那條決策已 valid:false → 本驗證建在被推翻的意圖上。
    #   dangling ref(格式壞/節點不存在/id 未指派)也浮出——不靜默通過,對齊 M2 反靜默紀律。
    #   設計見 Projects/關係層主網_實作計畫 M1;取代母計劃 [S8] 的高噪音 advisory。
    section("E3", "驗證紀錄引用的決策,是不是已經被翻案了")
    e3_broken, e3_dangling = [], []
    for rel, n in sorted(notes.items()):
        # [自動養成 不對稱信任] firing 向讀「聯集」decision_refs + decision_refs_ai(放寬)
        #   ——ai 填的也能觸發提醒;錯了 advisory 級、人一刪,低 harm(對比抑制向的保守)
        # [code-loop r1 A/C-minor] (rel,ref) 去重:過渡態同 ref 可能兩欄都有,避免重複通報虛胖計數
        seen_e3 = set()
        for ref in as_list(n.fields.get("decision_refs")) + as_list(n.fields.get("decision_refs_ai")):
            s = str(ref).strip()
            if s in seen_e3:
                continue
            seen_e3.add(s)
            m = re.fullmatch(r"(.+?)#(d\d+)", s)
            if not m:
                e3_dangling.append(f"{rel} → {s} (格式非 <節點rel>#dN)")
                continue
            trel = env.resolve(m.group(1))
            if not trel:
                e3_dangling.append(f"{rel} → {s} (節點不存在)")
                continue
            d = next((x for x in parse_decisions(notes[trel].fm_lines)
                      if str(x.get("id", "")).strip() == m.group(2)), None)
            if d is None:
                e3_dangling.append(f"{rel} → {s} (該節點無此決策 id,或未 reindex)")
                continue
            if str(d.get("valid", "true")).lower() == "false":
                e3_broken.append(f"{rel} → {s} (決策已翻案 ended={d.get('ended', '?')})")
                gov_events.append({"gate": "check-e3", "kind": "warned", "hard": False, "nodes": [n.stem]})
    if not e3_broken and not e3_dangling:
        ok("驗證紀錄引用的決策都還有效")
    if e3_broken:
        _soft_list(e3_broken,
                   f"有 {len(e3_broken)} 份驗證紀錄引用的決策已經被翻案:",
                   "本驗證實作的意圖已翻案:重驗並更新、或改指新決策、或標 stale")
    if e3_dangling:
        _soft_list(e3_dangling,
                   f"有 {len(e3_dangling)} 個決策引用指向不存在的決策:",
                   "修正 ref 格式/目標;若目標節點決策未編號先跑 lumos decision-reindex <節點>")
    print()

    # Check H: 漏標可逆性提醒(軟,不擋,不計 issues)——僅 --ci 掃 diff,提示疑似漏標 ★IRREVERSIBLE★
    section("S5", "計劃條款寫的測試名,程式碼裡找不找得到(提醒,不擋)")
    # ★這道的來源是真事故★(節點範圍與索引守衛_計劃,2026-09-10):一份計劃在條款裡寫了
    # 七個測試名,其中五支從來沒被寫出來。`lumos spec-trace` 一直在報「懸空 7」,但那是
    # 要人自己想到去敲的指令——lint 綠、doctor 綠、pre-push 放行,掛了一整天沒人知道,
    # 最後是人問「驗證節點怎麼這麼少」才翻出來。
    #
    # ★偵測能力本來就有,缺的是把它接到一個會自己跑的時機上★。Check T 驗的是 Systems
    # 節點的 ★INVARIANT★,完全不看 Projects 計劃的條款——這道補的正是那一半。
    #
    # 重用 spec-trace 的抽取(_clause_bindings_for/_clause_summary),不自己再寫一套:
    # 同一件事兩套算法一定會分岔,而分岔時沒有任何東西會翻紅。
    _dangling = []
    for rel, n in sorted(notes.items()):
        if n.fields.get("type") != "project":
            continue
        if str(n.fields.get("status", "")).strip() in ("superseded", "stale"):
            continue
        try:
            _txt = (env.vault / rel).read_text(encoding="utf-8", errors="replace")
            _rows, _err = _clause_bindings_for(env, _txt)
        except Exception:
            continue
        if _err or not _rows:
            continue
        # ★懸空的定義要跟 spec-trace 自己算的一致★(代碼審 r1 正確性席 major):
        # 第一版我手抄成三個字串,其中兩個根本不存在於 _CLAUSE_STATE_ZH,
        # 是憑空造的死分支;而真正也算懸空的
        # unrecognized(設定認不到)與 mentioned(只被提到)反而漏掉。
        # ★同一件事兩套算法必定分岔★——這正是這批自己 [S11] 要防的事,
        # 我卻在實作時犯了同一個錯。改成引用同一組常數,不再手抄。
        _bad = [r for r in _rows if r.get("state") in _CLAUSE_HANG_STATES]
        if _bad:
            _ids = ", ".join(str(r.get("clause") or r.get("id") or "?") for r in _bad[:4])
            _dangling.append(f"{rel} ({len(_bad)} 條:{_ids})")
            gov_events.append({"gate": "check-s5", "kind": "warned", "hard": False, "nodes": [n.stem]})
    if not _dangling:
        ok("計劃條款寫的測試名,程式碼裡都找得到")
    else:
        _soft_list(_dangling,
                   f"有 {len(_dangling)} 份計劃的條款寫了測試名,但程式碼裡找不到那支測試:",
                   "逐份跑 `lumos spec-trace <計劃節點>` 看是哪幾條;測試名寫錯就改名字,測試根本沒寫就補寫——★計劃寫了測試名不等於測試存在★")
    print()

    section("S6", "圖譜總索引有沒有把節點列全(提醒,不擋)")
    # 事故背景同上:那兩個消費專案的總索引是空殼(只有一個標題),於是「這條合約該放哪」
    # 只有一個答案——放我已經有的那一篇,然後那一篇越長越大。
    # 有地圖才有第二個答案。
    _moc_notes = [rel for rel, n in notes.items() if n.fields.get("type") == "moc"]
    if not _moc_notes:
        # ★沒有索引要出聲,不是靜默跳過★:靜默跳過會讓人以為「檢查過了沒問題」,
        # 而空索引正是事故的成因之一。
        gov_events.append({"gate": "check-s6", "kind": "warned", "hard": False, "nodes": []})
        warn_soft(["這個圖譜沒有 type: moc 的總索引節點"],
                  "沒有總索引,跳過覆蓋率檢查:",
                  "建一篇 `MOC/index.md`(type: moc)當路標——新增合約前先在上面找它的家,找不到就代表該建新節點")
    else:
        _linked = set()
        # ★索引自己宣告的範圍要算數★(r1 邊界席/接手席的誤報警告,實跑當場證實):
        # 本工具鏈的索引第一段就寫「下面只列 Systems(機制)節點」——照字面把 Issues
        # 也算進分母的話,第一次跑就唸 51 篇,全部是專案刻意不收的。那是噪音不是訊號,
        # 而提醒型檢查一旦噪音大,人就學會整段略過。
        _scope = {"system", "issue"}
        for _m in _moc_notes:
            _mtxt = (env.vault / _m).read_text(encoding="utf-8", errors="replace")
            if re.search(r"只列\s*Systems|僅列\s*Systems|only\s+Systems", _mtxt, re.I):
                _scope = {"system"}
            for _t in notes[_m].targets:
                _d = env.resolve(_t)
                if _d:
                    _linked.add(_d)
        _unlisted = []
        for rel, n in sorted(notes.items()):
            if n.fields.get("type") not in _scope:
                continue
            if str(n.fields.get("status", "")).strip() in ("superseded", "stale"):
                continue
            if rel not in _linked:
                _unlisted.append(rel)
                # ★每個軟提醒分支都要落一筆帳★(代碼審 r1 噪音席):
                # 不掛的話這道的提醒永遠進不了治理統計與 14 天升級鏈,
                # 跟其餘五道軟提醒變成兩種形狀。
                gov_events.append({"gate": "check-s6", "kind": "warned",
                                   "hard": False, "nodes": [n.stem]})
        if not _unlisted:
            ok(f"總索引把 {len([1 for r, n in notes.items() if n.fields.get('type') in _scope])} 篇節點都列到了(範圍:{'/'.join(sorted(_scope))})")
        else:
            _soft_list(_unlisted,
                       f"有 {len(_unlisted)} 篇節點沒被總索引連到(找不到入口的節點,下一個人只會往舊的那篇塞):",
                       "在總索引補一行連過去;索引是「這條合約該放哪」的唯一地圖,漏列等於那篇不存在")
    print()

    section("S7", "有沒有哪一篇的合約多到讀不完(提醒,不擋)")
    # ★判準只看「一篇有幾條合約」★——這是拿六個真圖譜資料點校準出來的,而且改過一次:
    # 原本用「佔全圖比重 + 提到幾個檔」,抓不到第二種長歪形狀(一篇管一個模組裡的三個
    # 主題,只提一個檔)。改成數合約條數之後六個資料點全對而且更簡單。
    #
    # 校準(節點範圍與索引守衛_計劃 [S5] 的表):本工具鏈自己最多 7 條;兩次長歪都在
    # 15 條以上;兩次拆完都在 8 條以下。中間有明顯空隙。
    _cfg = _lumos_config_near_vault(env) or {}
    _ns = _cfg.get("node_scope") if isinstance(_cfg.get("node_scope"), dict) else {}
    _cap = _ns.get("max_contracts", 10)
    # ★bool 要單獨擋★(代碼審 r1 正確性席 major):Python 裡 bool 是 int 的子類,
    # isinstance(True, int) 為真、True < 1 為假,兩段防呆都會放行,
    # 門檻就悄悄變成 1——每篇有合約的節點都會被誤判「讀不完」。
    if isinstance(_cap, bool) or not isinstance(_cap, int) or _cap < 1:
        warn_soft([f"node_scope.max_contracts 的值看不懂({_cap!r}),退回預設 10"],
                  "專案設定裡的門檻不合法:", "改成 1 以上的整數")
        _cap = 10
    _overloaded = []
    for rel, n in sorted(notes.items()):
        if n.fields.get("type") not in ("system", "issue"):
            continue
        if str(n.fields.get("status", "")).strip() in ("superseded", "stale"):
            continue
        try:
            _inv, _debt = extract_contracts(n)
        except Exception:
            continue
        _cnt = len(_inv) + len(_debt)
        if _cnt >= _cap:
            _overloaded.append(f"{rel} ({_cnt} 條合約)")
            gov_events.append({"gate": "check-s7", "kind": "warned", "hard": False, "nodes": [n.stem]})
    if not _overloaded:
        ok(f"沒有哪一篇的合約超過 {_cap} 條(門檻:node_scope.max_contracts)")
    else:
        _soft_list(_overloaded,
                   f"有 {len(_overloaded)} 篇的合約多到一次讀不完(門檻 {_cap} 條):",
                   "跑 `lumos contracts <節點>` 把那些合約列出來,看它們是不是其實在講好幾件事——是的話一件一篇拆開;真的是同一件事就把門檻調高(專案設定 node_scope.max_contracts)。★這道量的是「還讀得完嗎」,不是「設計對不對」★")
    print()

    # ── 每支檔有家的舊帳(2026-09-11,Projects/每支檔有家_計劃 [S28]):排在合約條數那段之後、[H] 之前——
    # 軟段截斷那支測試切的是 [S] 到 [E1],插進那個窗口會被數進去而翻紅(鄰居三段同一條位置紀律)。
    _nhl = _nodehome_ledger(_vault_repo_root(env), env.vault)
    section("S8", "每支程式檔有沒有一篇管它的節點(提醒,不擋;新增的由提交前檢查擋)")
    if _nhl is None:
        print("  (不是 git 專案或讀不到檔案清單,跳過)")
    else:
        if not (_nhl["bypassed"] or _nhl["legacy"]):
            ok("每支需要家的程式檔都有家(about_code 列了它)")
        if _nhl["bypassed"]:
            warn_soft(_nhl["bypassed"],
                      f"有 {len(_nhl['bypassed'])} 支是守衛上線之後才新增、卻沒有家的檔——該被擋卻進來了(有人跳過提交前檢查,或開關被關):",
                      "替它們安家:lumos new system <名> --code <檔> --responsibility \"<負責什麼>\",或 lumos append <確實在講它的節點> about_code <檔>")
        if _nhl["legacy"]:
            warn_soft(_nhl["legacy"],
                      f"有 {len(_nhl['legacy'])} 支是上線前就在、還沒有家的舊檔(舊帳,分批還;下次要往圖譜寫它的說明時會被要求先安家):",
                      "一次替一個資料夾安家:lumos new system <名> --code <檔> …,或加進確實在講它的那篇")
        if _nhl["bad_names"]:
            warn_soft(_nhl["bad_names"],
                      f"有 {len(_nhl['bad_names'])} 支程式檔的檔名不是 UTF-8——圖譜是 UTF-8 文字,寫不進它的路徑,永遠當不了誰的家:",
                      "改名成 UTF-8,或加進 .lumos/config.json 的 node_home.ignore")
        for _f in _nhl["bypassed"] + _nhl["legacy"]:
            gov_events.append({"gate": "check-s8", "kind": "warned", "hard": False, "nodes": [_f]})
    print()
    section("S9", "節點有沒有用反引號寫別人的檔(提醒,不擋;新寫進去的由提交前檢查擋)")
    if _nhl is not None:
        if not (_nhl["foreign"] or _nhl["foreign_new"]):
            ok("沒有節點用反引號寫別人家的程式檔")
        def _nh_fmt(d):
            return [f"{r[:-3]}:{'、'.join(fs[:4])}{' …' if len(fs) > 4 else ''}" for r, fs in d.items()]
        if _nhl["foreign_new"]:
            warn_soft(_nh_fmt(_nhl["foreign_new"]),
                      f"有 {len(_nhl['foreign_new'])} 篇節點在守衛上線之後才寫進別人家的檔名——該被擋卻進來了(有人跳過提交前檢查,或開關被關):",
                      "改寫成那支檔的家的節點連結 [[Systems/…]];那支檔沒家就先替它安家")
        if _nhl["foreign"]:
            warn_soft(_nh_fmt(_nhl["foreign"]),
                      f"有 {len(_nhl['foreign'])} 篇節點用反引號寫了別人家的檔(上線前就在的舊帳)——改那些檔時工具會推出這篇,東西就越寫越多(長出一篇包全部的成因):",
                      "改寫成那支檔的家的節點連結 [[Systems/…]];那支檔沒家就先替它安家")
        for _r in list(_nhl["foreign_new"]) + list(_nhl["foreign"]):
            gov_events.append({"gate": "check-s9", "kind": "warned", "hard": False, "nodes": [Path(_r).stem]})
    print()
    section("S10", "管很多支檔的節點有沒有寫一句負責範圍(提醒,不擋)")
    if _nhl is not None:
        if not (_nhl["over"] or _nhl["over_new"]):
            ok(f"沒有節點管超過 {_nhl['cfg']['max_files']} 支檔卻沒寫負責範圍(上限:node_home.max_files)")
        if _nhl["over_new"]:
            warn_soft([f"{r[:-3]}(管 {c} 支)" for r, c in _nhl["over_new"]],
                      f"有 {len(_nhl['over_new'])} 篇是守衛上線之後才變成管超過 {_nhl['cfg']['max_files']} 支檔、卻沒寫負責範圍——該被擋卻進來了:",
                      "寫一句負責什麼、不負責什麼:lumos set <節點> responsibility \"…\"")
        if _nhl["over"]:
            warn_soft([f"{r[:-3]}(管 {c} 支)" for r, c in _nhl["over"]],
                      f"有 {len(_nhl['over'])} 篇管超過 {_nhl['cfg']['max_files']} 支檔卻沒寫負責範圍(舊帳):",
                      "寫一句負責什麼、不負責什麼:lumos set <節點> responsibility \"…\";寫不出一句話的,通常代表它其實在管好幾件事,該拆")
        for _r, _c in _nhl["over_new"] + _nhl["over"]:
            gov_events.append({"gate": "check-s10", "kind": "warned", "hard": False, "nodes": [Path(_r).stem]})
        for _w in _nhl["cfg"]["warnings"]:
            warn_soft([_w], "每支檔有家的設定有問題:", "照上面那句改 .lumos/config.json")
    print()

    section("S11", "從程式重建出來的節點有沒有說自己管哪些檔,還有管了卻連檔名都沒提到的(提醒,不擋)")
    if _nhl is not None:
        if not _nhl["regen_no_home"]:
            ok("沒有蓋了「從程式重建」章、卻一支檔都不管又沒寫負責範圍的節點")
        else:
            warn_soft([r[:-3] for r in _nhl["regen_no_home"]],
                      f"有 {len(_nhl['regen_no_home'])} 篇是從程式重建出來的,卻一支檔都沒管、也沒寫負責範圍(舊帳;新蓋章的由提交前檢查擋):",
                      "把它管的檔寫上去:lumos append <節點> about_code <檔>;真的不管檔就寫明為什麼:lumos set <節點> responsibility \"…\"")
        if not _nhl["unmentioned"]:
            ok("沒有節點管了某支檔、摘要和正文卻連檔名都沒提到")
        else:
            warn_soft([f"{r[:-3]} ← {f}" for r, f in _nhl["unmentioned"]],
                      f"有 {len(_nhl['unmentioned'])} 對「管了這支檔、卻連檔名都沒提到」——改那支檔時會把這篇推到看的人眼前,推錯篇比沒推更花時間:",
                      "在那篇寫一句它負責這支檔的什麼;或改掛到真的在講它的那篇:lumos remove <節點> about_code <檔>")
        for _r in _nhl["regen_no_home"]:
            gov_events.append({"gate": "check-s11", "kind": "warned", "hard": False, "nodes": [Path(_r).stem]})
        for _r, _f in _nhl["unmentioned"]:
            gov_events.append({"gate": "check-s11", "kind": "warned", "hard": False, "nodes": [Path(_r).stem]})
    print()

    section("S12", "規格閘(半套):新迴圈的計劃有幾成掛了條款,還有每份計劃最近一次跑出來的紅綠弱證據(提醒,不擋)")
    try:
        _sg_since = _loop_ts_key(_SPEC_GATE_SINCE)
        _first = {}
        _cl = env.vault.parent / ".canary-log.jsonl"
        if _cl.exists():
            for _ln in _cl.read_text(encoding="utf-8", errors="replace").splitlines():
                try:
                    _d = json.loads(_ln)
                except ValueError:
                    continue
                _lp = str(_d.get("loop", "") or "")
                if not isinstance(_d, dict) or not _lp or _lp.startswith("code-") or not _d.get("ts"):
                    continue
                _k = _loop_ts_key(str(_d["ts"]))
                if _k is not None and (_lp not in _first or _k < _first[_lp]):
                    _first[_lp] = _k
        _new = sorted(lp for lp, k in _first.items() if k >= _sg_since)
        _with = 0
        for _lp in _new:
            _pp = env.vault / "Projects" / f"{_lp}_計劃.md"
            try:
                if _pp.exists() and SPEC_CLAUSE_RE.search(_pp.read_text(encoding="utf-8", errors="replace")):
                    _with += 1
            except OSError:
                pass
        if not _new:
            ok("有條款的計劃比例 0/0,還沒有計劃掛條款(句式閘上線後還沒有新迴圈)")
        else:
            ok(f"有條款的計劃比例 {_with}/{len(_new)}(分母=首筆帳晚於 {_SPEC_GATE_SINCE[:10]} 的設計迴圈;RETIRE-IF ① 看它降不降)")
        _latest = {}
        _gl = env.vault.parent / ".governance-log.jsonl"
        if _gl.exists():
            for _ln in _gl.read_text(encoding="utf-8", errors="replace").splitlines():
                try:
                    _d = json.loads(_ln)
                except ValueError:
                    continue
                if isinstance(_d, dict) and _d.get("kind") == "spec-gate-run":
                    for _nd in _d.get("nodes") or []:
                        _latest[str(_nd)] = _d.get("note", "")
        if _latest:
            _rows = []
            for _nd, _note in sorted(_latest.items()):
                _m = re.search(r"red=(\d+) green=(\d+) weak=(\d+)", _note or "")
                _rows.append(f"{Path(_nd).stem}: 紅 {_m.group(1)}/綠 {_m.group(2)}/弱證據 {_m.group(3)}" if _m else f"{Path(_nd).stem}: {_note}")
            warn_soft(_rows, f"最近一次規格閘跑出來的紅綠弱證據({len(_rows)} 份計劃;紅=新行為還沒做,綠=做完或既有,弱=證據不夠):",
                      "紅的條款做完會變綠;一直紅=沒人理它,RETIRE-IF ② 看這個")
        else:
            ok("還沒有任何計劃跑過規格閘(lumos spec-gate <計劃>)")
    except Exception as _e:   # 健檢一段壞了不能拖垮整份;標題寫「不擋」就只准 warn_soft
        warn_soft([], f"這一段算不出來({_e.__class__.__name__}: {_e}),先跳過")
    print()

    section("S14", "風險低計劃放行(舊稱雙向門放行):放行了幾份、逃逸幾筆(按門與階段)、三條撤除條件的分子——人讀人裁,不自動擋(提醒,不擋)")
    try:
        _sg_latest = _spec_gate_latest_records(env)
        _two = {lp: r for lp, r in _sg_latest.items() if _rec_plan_risk(r) == "low"}
        _one = {lp: r for lp, r in _sg_latest.items() if _rec_plan_risk(r) == "high"}
        if not _sg_latest:
            ok("還沒有任何計劃留過規格閘的門(lumos spec-gate <計劃> 過了會留)")
        else:
            _mo = sum(1 for r in _two.values() if r.get("manual_only"))
            ok(f"風險低計劃放行 {len(_two)} 份(其中全靠人驗、走小改動閘的 {_mo} 份)、風險高計劃 {len(_one)} 份(每條迴圈只看最後一筆留痕;門判定規則版本 {_DOOR_RULE_VERSION}、小改動規則版本 {_SMALL_CHANGE_RULE_VERSION})")
            _esc = _escape_rows_for(env)
            _by = {}
            for _e in _esc:
                _dr = _rec_plan_risk(_e) if (_e.get("plan_risk") or _e.get("door")) else _door_for_loop(env, str(_e.get("loop", "")))
                _by.setdefault(_dr, {}).setdefault(str(_e.get("stage") or "?"), 0)
                _by[_dr][str(_e.get("stage") or "?")] += 1
            for _dr in ("low", "high", "unknown"):
                if _by.get(_dr):
                    print(f"    逃逸({'風險低計劃' if _dr == 'low' else '風險高計劃' if _dr == 'high' else '風險不明'})按階段:" + "、".join(f"{k} {v}" for k, v in sorted(_by[_dr].items())))
            _tw_esc = [_e for _e in _esc if ((_rec_plan_risk(_e) if (_e.get("plan_risk") or _e.get("door")) else _door_for_loop(env, str(_e.get("loop", "")))) == "low") and _e.get("precision") != "round"]
            _first30 = set(sorted(_two, key=lambda lp: str(_two[lp].get("ts", "")))[:30])
            _n_blocker = len({str(_e.get("loop")) for _e in _tw_esc if _e.get("severity") == "blocker"})
            _n_major = len({str(_e.get("loop")) for _e in _tw_esc if _e.get("severity") in ("major", "blocker") and str(_e.get("loop")) in _first30})
            _n_unrev = len({str(_e.get("loop")) for _e in _tw_esc if _e.get("stage") == "push-gate-unreviewed"})
            _round_only = sum(1 for _e in _esc if _e.get("precision") == "round")
            print(f"    撤除條件分子(只數 precision≠round 與手動記的列;輪級粗判 {_round_only} 列另計不入):blocker 級逃逸 {_n_blocker} 份 / 前 30 份裡 major 以上 {_n_major} 份 / push-gate-unreviewed {_n_unrev} 份")
            print("    門檻(拍的,結果出來前不改):①blocker ≥1 份 → 立刻退回風險低計劃放行 ②前 30 份 major 以上 ≥3 份 → 退回 ③push-gate-unreviewed ≥2 份 → 門判定規則重審")
            if _two:
                _rows = [f"{lp}:條款 {r.get('n_clauses', '?')}/紅 {r.get('n_red', '?')}/keeps {r.get('n_keeps', 0)}(留痕 {str(r.get('ts', ''))[:10]})" for lp, r in sorted(_two.items())]
                warn_soft(_rows, f"風險低計劃的條款數與紅測試數({len(_rows)} 份;分不清「規則太嚴」還是「沒空寫測試」時看這裡):", "紅要在推送前做綠;一直沒推=沒人做,不是閘的問題")
                import datetime as _dtm
                _now = _dtm.datetime.now().astimezone()
                _stale = []
                for lp, r in sorted(_two.items()):
                    _pp = env.vault / str(r.get("plan") or "")
                    _nn = env.notes.get(str(r.get("plan") or ""))
                    if _nn is None or str(_nn.fields.get("status")) != "doing":
                        continue
                    try:
                        _age = (_now - _dtm.datetime.fromisoformat(str(r.get("ts")))).days
                    except (ValueError, TypeError):
                        continue
                    if _age > _DOOR_STALE_DAYS:
                        _stale.append(f"{lp}:{_age} 天沒新留痕({_pp.name})")
                if _stale:
                    warn_soft(_stale, f"風險低 doing 計劃超過 {_DOOR_STALE_DAYS} 天沒新留痕({len(_stale)} 份):", "做完就 lumos set 成 done;還在做就重跑 lumos spec-gate 留一筆")
    except Exception as _e:
        warn_soft([], f"這一段算不出來({_e.__class__.__name__}: {_e}),先跳過")
    print()

    section("H", "這次改動碰到正式環境、外部 API 或寄送,筆記有沒有標「做了就回不去」(提醒,不擋)")
    if not ci:
        print("  (僅 --ci 模式掃 diff;互動模式略過)")
    else:
        hint_hits = _scan_diff_for_irreversible_hints(str(env.vault))
        if not hint_hits:
            ok("這次改動沒碰到疑似做了就回不去的操作")
        else:
            warn_soft(
                hint_hits,
                f"這次改動有 {len(hint_hits)} 行疑似碰到做了就回不去的操作(正式環境/外部 API/寄送):",
                "去對應的 Systems 筆記確認有沒有標 ★IRREVERSIBLE★ 並寫好回退或防護;確定其實可逆就忽略",
            )
    print()

    # Check K: ★COMBO★ 組合覆蓋提醒(軟,不擋,不計 issues)——標了 ★COMBO★ 的最重 ★INVARIANT★
    #   只綁 1 個 [test:] 標記 → 提醒補組合。數 [test:] 標記個數(TEST_REF_RE,非展開名數),免 [test:a,b] 逗號繞過。
    section("K", "最重要的合約是不是只綁了一條測試(提醒補組合情境)")
    combo_thin, combo_any = [], False
    for rel, n in sorted(notes.items()):
        invs, _ = extract_contracts(n)
        for inv in invs:
            if "★COMBO★" not in inv:
                continue
            combo_any = True
            if len(TEST_REF_RE.findall(inv)) == 1:
                combo_thin.append(inv.replace("★COMBO★", "").strip())
                gov_events.append({"gate": "check-k", "kind": "warned", "hard": False, "nodes": [n.stem]})
    if not combo_any:
        ok("沒有標成「最重要合約」的規則,不需要組合測試")
    elif combo_thin:
        _soft_list(combo_thin,
                   f"有 {len(combo_thin)} 條最重要的合約只綁了一條測試(只測正常路徑):",
                   "為這條最重鐵則補一條組合情境測試(多條件交叉),別只測 happy-path")
    else:
        ok("最重要的合約都綁了兩條以上的測試")
    print()

    # Check D: 紀律區塊漂移守衛(內容比對)
    # 範本 scripts/templates/graph-discipline.md ↔ CLAUDE.md sentinel block body。
    # guard: 範本不存在 → skip(不算 issue);CLAUDE.md absent → skip(未注入過的 repo 不罰)。
    # broken → 報漂移(算 issue,但不取 .body 避免 crash)。
    section("D", "專案 CLAUDE.md 與 Codex 指示檔(AGENTS.md)裡的工具鏈紀律區塊,跟範本有沒有對上")
    if repo_root is None:
        print("  (無 docs/ 佈局,略過 Check D)")
    else:
        # slug 從 vault 名取(慣例 docs/<slug>-knowledge → vault.name 去尾碼)
        _d_vault_name = env.vault.name
        _d_slug = (_d_vault_name[:-len("-knowledge")]
                   if _d_vault_name.endswith("-knowledge") else _d_vault_name)
        expected_body = _expected_claude_body(repo_root, _d_slug)
        if expected_body is None:
            print("  (無 scripts/templates/graph-discipline.md 範本,略過 Check D)")
        else:
            # 目標清單=CLAUDE.md + Codex 指示檔(d1;三端共用同一份清單)
            for _d_name in _reinject_targets(repo_root):
                _d_cm = repo_root / _d_name
                if not _d_cm.exists():
                    print(f"  (無 {_d_name},略過 — 尚未注入無需比對)")
                    continue
                _d_text = _d_cm.read_bytes()
                if _d_text.startswith(b"\xef\xbb\xbf"):
                    _d_text = _d_text[3:]
                _d_text = _d_text.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
                _d_state, _d_span = _extract_claude_block_span(_d_text)
                if _d_state == "absent":
                    print(f"  ({_d_name} 無 sentinel 區塊,略過 — 尚未注入)")
                elif _d_state == "broken":
                    warn([f"{_d_name} 紀律區塊的起訖標記 sentinel 損壞(只剩頭或只剩尾)——用 lumos update(或 lumos init)修復"],
                         f"{_d_name} sentinel 損壞(broken)— 無法比對,視為漂移:",
                         "lumos init --force 或 lumos update 修復 sentinel 再重驗")
                else:
                    # found: 比對 body
                    if _d_span.body == expected_body:
                        ok(f"{_d_name} 的工具鏈紀律區塊跟範本一致")
                    else:
                        warn([f"{_d_name} 紀律區塊跟範本不同步——用 lumos update(或 lumos init)刷新"],
                             f"{_d_name} 紀律區塊漂移(與範本不一致):",
                             f"lumos update 或 lumos init --force 刷新 {_d_name} 紀律區塊")
            # Codex 把 git 根到 cwd 每層生效的那一個 AGENTS 檔串起來,合計上限 32 KiB、超過靜默截斷
            # (官方文件;r1 邊界 F6b)。這裡只估本 repo 根這一層(有 override 只算 override),>75% 提醒。
            _d_eff = repo_root / _agents_target(repo_root)
            if _d_eff.exists():
                _d_bytes = _d_eff.stat().st_size
                if _d_bytes > 32768 * 0.75:
                    warn([f"{_d_eff.name} 有 {_d_bytes} bytes,Codex 整鏈 AGENTS 檔上限 32768、超過會靜默截掉後面——把非必要內容搬走或縮短"],
                         f"{_d_eff.name} 單這一層就佔整鏈上限 {_d_bytes * 100 // 32768}%(>75%;全域與子目錄另計):",
                         "縮短該檔或把長內容移到圖譜筆記")
                else:
                    print(f"  {_d_eff.name} {_d_bytes} bytes=整鏈上限 32768 的 {_d_bytes * 100 // 32768}%(只算 repo 根這一層;全域 ~/.codex/AGENTS.md 與子目錄另計,超過靜默截斷)")
            # 常駐紀律範本長回來要看得見([[Projects/skills提示工程優化_計劃]] S4):07-29 瘦身後 5.1KB,
            # 09-11 量到 8.2KB 才發現——中間沒有任何一處印過。只在範本所在的來源 repo 印;只提醒、不擋、不進 issues。
            _d_tpl = repo_root / "scripts" / "templates" / "graph-discipline.md"
            if _d_tpl.exists():
                _d_tb = _d_tpl.stat().st_size
                _d_pct = _d_tb * 100 // _DISCIPLINE_SLIM_BASELINE_BYTES
                if _d_tb > _DISCIPLINE_SLIM_BASELINE_BYTES * 1.5:
                    warn_soft([f"紀律範本 scripts/templates/graph-discipline.md 現在 {_d_tb} bytes,"
                               f"是上次瘦身後({_DISCIPLINE_SLIM_BASELINE_BYTES} bytes)的 {_d_pct}%"],
                              "常駐的紀律範本長回五成以上了——它每回合都注入每個專案的 CLAUDE.md/AGENTS.md:",
                              "再瘦一次:細節搬進 skill 參考檔、範本只留指路(搬家不刪義);見 Projects/skills提示工程優化_計劃")
                else:
                    print(f"  紀律範本 {_d_tb} bytes,是上次瘦身後({_DISCIPLINE_SLIM_BASELINE_BYTES} bytes)的 {_d_pct}%(超過 150% 才提醒)")
    print()

    section("V", "寫了「這個結論在什麼前提下成立」的筆記,有多少超過 90 天沒回頭看(提醒,不擋)")
    vu_total, vu_stale = [], []
    for rel, n in sorted(notes.items()):
        if not _conds(n.fields.get("valid_under")):
            continue
        vu_total.append(rel)
        age = _node_age_days(n)
        if age is not None and age > 90:
            vu_stale.append(f"{rel}(已 {age} 天未更新)")
    if not vu_total:
        ok("沒有筆記寫「這個結論在什麼前提下成立」,這項不用量")
    elif vu_stale:
        rate = len(vu_stale) / len(vu_total)
        warn_soft(vu_stale,
                  f"{len(vu_stale)}/{len(vu_total)} ({rate:.0%}) 個 valid_under 節點 >90 天未更新(前提可能失效):",
                  "進場 lumos context 已會警示;>90 天者建議重核 valid_under、必要時標 stale 或建新 Verification")
    else:
        ok(f"0/{len(vu_total)} (0%) — 所有 valid_under 節點 ≤90 天")
    print()

    section("P", "筆記提到的程式檔路徑,檔案還在不在(提醒,不擋)")
    if repo_root is None:
        ok("(這個專案沒有 docs/ 資料夾,檔案路徑檢查跳過)")
    else:
        top_dirs = {p.name for p in repo_root.iterdir() if p.is_dir() and not p.name.startswith(".")}
        _suffix_re = re.compile(r":([^/]+)$")
        stale_claims = []
        for rel, n in sorted(notes.items()):
            # ★體檢 #10(2026-08-21)降噪★:Verification 是「當時的紀錄」,引用當時路徑是它的職責,
            # 碼搬走不該叫它改;superseded/stale 節點同理。只守「宣稱現況」的活節點。
            if n.fields.get("type") == "verification" or \
               str(n.fields.get("status", "")).strip() in ("superseded", "stale"):
                continue
            try:
                text = (env.vault / rel).read_text(encoding="utf-8-sig")
            except OSError:
                continue
            # ★不可換回 FENCE_RE★:它錨第 0 欄、假設成對,縮排收尾會吞掉真散文(見 _visible_lines)
            spans = [s.strip("`") for s in INLINE_CODE_RE.findall(_strip_fences_text(text))]
            seen_paths = set()
            for raw in spans:
                if "://" in raw or any(c in raw for c in "*<>?"):
                    continue
                if "{" in raw or "}" in raw:      # 大括號展開寫法 a/{x,y}.md 不是路徑(體檢 #10 實測假陽性)
                    continue
                m = _suffix_re.search(raw)
                if m:
                    token, sfx = raw[:m.start()], m.group(1)
                    line = sfx if re.fullmatch(r"\d+(?:-\d+)?", sfx) else ""
                else:
                    token, line = raw, ""
                if "/" not in token or token in seen_paths:
                    continue
                if token.split("/")[0] not in top_dirs:
                    continue
                seen_paths.add(token)
                if not (repo_root / token).exists():
                    loc = f"{rel}:{line}" if line else rel
                    stale_claims.append(f"{loc} → {token}(已不存在)")
        if stale_claims:
            warn_soft(stale_claims,
                      f"有 {len(stale_claims)} 處筆記提到的程式檔路徑已經不存在(碼被刪或搬了?):",
                      "碼被刪/改名?更新節點正文的路徑引用,或補對應節點")
        else:
            ok("筆記提到的程式檔都還在")
    print()

    # ── Check N:可重算數字宣稱(存查詢不存答案;成因 F「寫死易漂的值」)──
    # 由來:2026-08-12 LandmarkMember 全 24 篇交叉審計,★F 類每一批都復發★——
    # 「共 5 處」(實為 7)、「8 場景通過」、「46 場景」(實為 40)、「9 個元件」(實為 8 少列一個)、
    # 行號 173/392(實為 189/415)。2026-06-10 首跑就記過教訓「計數/清單型主張最會漂」,
    # 但★沒有配任何機制★,兩個月後照樣復發。
    # PRIOR-ART(真搜):世界的解是 doctest 那套「單一真相源」哲學——同一份東西既是文件也是
    # 可執行檢查,不維護第二份。這裡的借法是★存查詢不存答案★:節點寫下「怎麼算」,
    # doctor 每次重算並比對,數字漂了當場說。
    # 語法(body 內,緊跟在數字後面):
    #   <!--lumos:count=7 re=某正則 in=**/*.cs-->
    # 安全:不執行 shell、不 eval;只用 python re + fnmatch 掃 repo,有檔數/位元組上限,
    # 壞正則吞成單條提示不炸 doctor。
    # ── Check Y:被提及符號的存在性(成因 D「寫的時候就錯」)──
    # 與 delguard 的分工:delguard 驗「被刪的符號圖譜還在講」(diff-based,只在 commit 時);
    # 本檢查驗「圖譜提到的符號 repo 裡有沒有」(全量,寫錯當下就抓)——★code 從沒變過也抓得到★,
    # 那正是成因 D(diff-based 機制結構上無效的那一類)。
    # 首發實績:2026-08-12 抓到 [[活動報名]] 寫 `ActivityService.RegisterAsync`,實際是
    # SubmitRegistrationAsync——★這條在同日 10 個 agent 的兩階段交叉審計中被漏掉★
    # (實證員驗了行為、沒挑方法名)。
    # ★噪音實測(LandmarkMember 30 篇 Systems)★:
    #   寬鬆抽法(任何 PascalCase inline code)→ 930 候選 / 74 未命中(7%),抽樣多為環境變數名
    #   (ADMIN_LOG_VIEWER_KEY)、DB 欄位(TBmemberdisc.WelcomeCouponNo)、會員編號範例、
    #   別 repo 頁面(MemberDisc.aspx) = 精度極差;
    #   收緊成「方法/類別形狀」(無底線/無數字/非全大寫/無副檔名,且 以 Async 結尾 或 帶點)
    #   → 279 候選 / 1 未命中(0.4%),★該 1 條是真陽性★。
    section("Y", "筆記點名的方法或類別,程式碼裡找不找得到(寫錯或已改名;提醒,不擋)")
    if repo_root is None:
        ok("(這個專案沒有 docs/ 資料夾,符號檢查跳過)")
    else:
        _yprof, _yneg = load_symbol_profile(repo_root)
        _sym_re = re.compile(_yprof["shape_re"])
        _ext_re = re.compile(r"\.(aspx|html|cs|js|vue|sql|ps1|yml|json|md|kt|py)$", re.I)
        _sufs, _dot_ok = tuple(_yprof.get("suffixes") or ()), _yprof.get("dotted_ok", True)

        def _is_symbol_shaped(s):
            """方法/類別形狀(★由 symbol_profile 決定,不寫死語言慣例★)。
            共通排除:含底線/斜線/空白、有副檔名、帶數字(範例 ID)、全大寫(環境變數)。
            ★注意★:python profile 的 shape_re 允許底線,故底線排除只在 shape_re 不允許時才成立
            ——這裡改成先跑 shape_re,再套「非全大寫/無數字/無副檔名」的通用雜訊排除。"""
            if "/" in s or " " in s or _ext_re.search(s):
                return False
            if any(c.isdigit() for c in s) or s.isupper():
                return False
            if not _sym_re.match(s):
                return False
            if _sufs and any(s.endswith(x) for x in _sufs):
                return True
            return _dot_ok and "." in s

        _hay = build_code_haystack(repo_root)
        _ghosts, _seen = [], set()
        # ★只掃 Systems★:語意上只有它宣稱「現在長怎樣」。
        # Projects 提的是「打算做的方法」(還沒寫)、Verification/Issues 記的是歷史狀態
        # (當時存在、現已移除)——對那些節點報「repo 查無」是誤報而非發現。
        # 實測佐證:全型別掃 → 37 命中(多為計劃中的未來方法/已移除的歷史方法);
        # 限 Systems → 1 命中且為真陽性。
        for rel, n in sorted(notes.items()):
            if n.fields.get("type") != "system":
                continue
            try:
                text = (env.vault / rel).read_text(encoding="utf-8-sig")
            except OSError:
                continue
            # ★否定語境豁免★:節點常常「正確地記錄某符號已不存在」
            # (例:「`RefundPointsAsync` 全庫零命中」「已移除 `GetRollingTotalAsync`」)。
            # 對這種行報「repo 查無」是把正確的紀錄當錯誤——實測這是最大宗誤報,
            # 且 2026-08-12 訂正圖譜時我們自己就寫了好幾條這種句子。
            _NEG = _yneg   # ★語系相依,由 neg_lexicon/neg_extra 配置(見 NEG_LEXICONS)★
            for _ln in _strip_fences_text(text).splitlines():
                _neg = any(k in _ln for k in _NEG)
                for raw in INLINE_CODE_RE.findall(_ln):
                    s = raw.strip("`").strip()
                    if not _is_symbol_shaped(s) or (rel, s) in _seen:
                        continue
                    _seen.add((rel, s))
                    if _neg:
                        continue
                    if s.split(".")[-1] not in _hay:
                        _ghosts.append(f"{rel} → `{s}`(repo 查無此符號)")
        if _ghosts:
            warn_soft(_ghosts,
                      f"有 {len(_ghosts)} 個筆記點名的方法或類別在程式碼裡找不到(寫錯或改名了?):",
                      "可能改名了、寫錯了、或本來就在別的 repo(那就別用行內程式碼格式寫,或註明來源)。"
                      "這種問題就算程式碼從沒改過也會發生,只看改動的檢查抓不到,所以才在這裡提")
        else:
            ok("筆記點名的方法和類別在程式碼裡都找得到")
    print()

    section("N", "筆記裡帶重算標記的數字,重算一遍還對不對(提醒,不擋)")
    if repo_root is None:
        ok("(這個專案沒有 docs/ 資料夾,數字重算跳過)")
    else:
        import fnmatch as _fn
        _CNT_RE = re.compile(r"<!--\s*lumos:count=(\d+)\s+re=(.+?)\s+in=(\S+?)\s*-->")
        _MAX_FILES, _MAX_BYTES = 4000, 40_000_000
        _drift, _bad, _n_marks = [], [], 0
        for rel, n in sorted(notes.items()):
            try:
                text = (env.vault / rel).read_text(encoding="utf-8-sig")
            except OSError:
                continue
            # 圍欄內是語法範例不是宣稱——Check N 自家節點的範例曾被當真標記掃,每次 doctor
            # 都喊一條假漂移(2026-08-21 L4 清帳抓到)。★剝圍欄一律走 _strip_fences_text(全檔唯一
            # fence 判定;同日首版誤用 ```.*?``` 正則,正是檔頭明令「不要再加回來」的 FENCE_RE,
            # 當天 design-loop r2 s4 席抓到改正)★。保留 inline code(標記本身是 HTML 註解,不受影響)。
            text = _strip_fences_text(text)
            for m in _CNT_RE.finditer(text):
                _n_marks += 1
                claimed, pat, glob = int(m.group(1)), m.group(2), m.group(3)
                try:
                    cre = re.compile(pat)
                except re.error as e:
                    _bad.append(f"{rel} → 正則不合法({e}):{pat[:40]}")
                    continue
                actual, nf, nb = 0, 0, 0
                try:
                    for dp, dirs, files in os.walk(repo_root):
                        dirs[:] = [d for d in dirs if d not in CODE_SKIP_DIRS]
                        for f in files:
                            fp = Path(dp) / f
                            r_ = str(fp.relative_to(repo_root)).replace(os.sep, "/")
                            if not (_fn.fnmatch(r_, glob) or _fn.fnmatch(f, glob)):
                                continue
                            nf += 1
                            if nf > _MAX_FILES or nb > _MAX_BYTES:
                                raise RuntimeError("掃描量超上限")
                            try:
                                body_ = fp.read_text(encoding="utf-8", errors="ignore")
                            except OSError:
                                continue
                            nb += len(body_)
                            actual += len(cre.findall(body_))
                except RuntimeError as e:
                    _bad.append(f"{rel} → {e}(收窄 in= 的 glob):{glob}")
                    continue
                if actual != claimed:
                    _drift.append(f"{rel} → 宣稱 {claimed} / 實測 **{actual}**"
                                  f"(re={pat[:30]} in={glob})")
        if _drift or _bad:
            warn_soft(_drift + _bad,
                      f"{len(_drift)} 個數字宣稱與實測不符" +
                      (f"、{len(_bad)} 個標記本身有問題" if _bad else "") + ":",
                      "更新節點裡的數字(或修 re=/in=);★這正是這個標記存在的意義——"
                      "數字會漂,所以別讓它靜靜地漂★")
        elif _n_marks:
            ok(f"{_n_marks} 個可重算數字宣稱全部對得上")
        else:
            ok("(沒有任何數字帶重算標記;筆記裡容易過期的數字建議加標記讓工具自己重算)")
    print()

    # Check J: regen 重生來源守衛(from-scratch 節點的 provenance 分級+拒絕發明無證據合約)。
    # 與 cmd_lint 共用 check_regen_provenance(防兩入口規則漂移);映射表——
    # errs→warn(hard)計 issues/warns→warn_soft/gov_events→僅 --ci 落帳。
    _regen_rels = [(rel_, n_) for rel_, n_ in sorted(notes.items())
                   if isinstance(n_.fields.get("regen"), str) and n_.fields.get("regen").strip()]
    if _regen_rels:
        section("J", "從程式碼重建出來的筆記,每條主張有沒有標清楚是有證據、推測、還是找不到出處(regen 重生來源守衛)")
        _jroot = repo_root if repo_root is not None else _repo_root_from_env(env)
        j_err_lines, j_soft_lines = [], []
        for rel_, n_ in _regen_rels:
            j_errs, j_warns, j_gov = check_regen_provenance(n_, _jroot)
            j_err_lines.extend(f"{rel_}: {e}" for e in j_errs)
            j_soft_lines.extend(f"{rel_}: {w}" for w in j_warns)
            gov_events.extend(j_gov)
            for _e in j_errs:
                gov_events.append({"gate": "check-j", "kind": "blocked", "hard": True,
                                   "nodes": [n_.stem]})
        if j_err_lines:
            warn(j_err_lines, f"{len(j_err_lines)} 條重建筆記的主張沒標清楚出處(違反 regen 重生來源守衛):",
                 "補 [src:路徑(:行號)]/[git:sha] 證據、或改標 推測:/佚失:(合約不能建在推測上)")
        else:
            ok(f"{len(_regen_rels)} 篇重建筆記的證據指針都驗得到")
        if j_soft_lines:
            warn_soft(j_soft_lines, f"{len(j_soft_lines)} 條重建筆記的提醒(不擋):")
        print()

    # Check N: 版本 nudge(軟提醒,dev-machine advisory;不算 issue、不擋 CI)
    if repo_root is not None:
        _nudge = _version_nudge(repo_root)
        if _nudge:
            section("W", "工具鏈版本有沒有落後(提醒,不擋)")
            warn_soft([_nudge], _nudge, "用這個指令把工具鏈和紀律區塊更新到最新:lumos update")
            print()

    # Check F: linter 宣告檔健康(lint接線收口 [S1]:SARIF 橋最後一哩——宣告了跑不動的
    # 東西,審查就漏那些告警;有宣告才驗,無宣告一行跳過不擋。路徑解析走本函式既有的
    # _vault_repo_root(git 感知;沿革:env.vault 直拼→假綠、doctor 區域 repo_root→standalone
    # 消失、_repo_root_from_env→standalone 回 parent 與既有定義互斥——三坑都踩過,本行是
    # 三次修正的終點。與 cmd_lint_check 的 _anchor_repo_root(cwd 錨)是兩入口語境刻意分工;
    # lint-check 找不到 root 已改 rc2 響亮(code-batch2 r2 d-f2)。
    if True:
        _lf = _lint_load_and_validate(_vault_repo_root(env))   # git 感知解析(ext-f1:_repo_root_from_env 對 standalone 回 parent,與 .git 在 vault 內的既有定義互斥)
        section("F", "linter 宣告檔還健康嗎(.lumos/lint.json;沒宣告就跳過)")
        if not _lf["declared"]:
            # ★2026-08-29 誠實化★:原本這裡印綠勾「未宣告跳過」——等於恭喜你沒接 linter。
            # 沒接的後果是實的:代碼審完全看不到任何 linter 告警,那些本來最便宜就能抓到的
            # 問題只能靠審查員肉眼。空轉要說出來,而且要說得出下一步,別的 repo 才知道去裝。
            warn([], "這個 repo 沒有接 linter(.lumos/lint.json 不存在)——代碼審看不到任何 linter 告警,"
                     "那類最便宜就能抓的問題目前全靠審查員肉眼:",
                 "要接的話三步:①先在這個專案裝一個 linter(如 eslint / detekt / ruff / stylelint,"
                 "看技術棧)②建 .lumos/lint.json 宣告它怎麼跑、輸出 SARIF 到哪 "
                 "③跑 lumos lint-check --smoke 驗它真的跑得動;接好之後 pitfalls 就會把它的告警"
                 "帶進審查鏡頭。不打算接也可以,但這是選擇不是預設健康")
        elif _lf["parse_error"]:
            warn([f".lumos/lint.json:{_lf['parse_error']}"],
                 ".lumos/lint.json 不是合法 JSON——宣告壞掉=橋整條斷,審查吃不到 lint 告警:",
                 "修好 JSON;格式規範與真跑驗證:lumos lint-check --smoke")
            gov_events.append({"gate": "check-lint-decl", "kind": "warned", "hard": False,
                               "nodes": [], "note": "lint.json parse error"})
        elif _lf["problems"]:
            _fl = [f"[{pr['stack']}] {pr['issue']}" for pr in _lf["problems"]]
            warn(_fl, f".lumos/lint.json 有 {len(_fl)} 個宣告問題(宣告了跑不動的東西,審查會漏這些告警):",
                 "逐條修宣告;工具是否真的跑得動用 lumos lint-check --smoke 驗")
            gov_events.append({"gate": "check-lint-decl", "kind": "warned", "hard": False,
                               "nodes": [], "note": f"problems={len(_fl)}"})
        else:
            # ★2026-08-29 誠實化★:原訊息只說「格式健康」,讀起來像 linter 有在保護這個
            # 專案——實際上所有自動路徑(pre-push 三處、tier 判定)都帶 --no-lint,CI 也不跑
            # pitfalls,真正會執行 linter 的 _lint_run_and_parse 只有兩個手動呼叫者。也就是
            # 「宣告的形狀」天天有人驗,「宣告的東西跑不跑得動」從來沒有自動驗過一次。
            ok("linter 宣告檔格式健康——★這只證明宣告寫得對,不證明 linter 真的跑得動★:"
               "宣告的東西跑不跑得動要手動 lumos lint-check --smoke 驗;"
               "推送前的新增告警閘會真的執行它們(2026-09-13 起,見 [[Projects/新增告警閘_計劃]])")
        # 新增告警閘的兩個數字:自動放行幾次、放行清單幾條。
        # ★沒有人去數,「有記帳」這句話就是空頭支票★——自動放行是已知的繞道向量(把工具移掉或弄慢就能過)。
        _lnr = _vault_repo_root(env)
        if _lnr is not None:
            _auto = _lint_new_autopass_count(_lnr)
            _wv, _wverr = _lint_waivers_load(_lnr)
            _bits = []
            if _auto:
                _bits.append(f"最近 30 天自動放行 {_auto} 次(工具沒裝/逾時/拉不到規則都算)")
            if _wverr:
                _bits.append(_wverr)
            elif _wv:
                _bits.append(f"放行清單有 {len(_wv)} 條")
            if _bits:
                warn_soft(_bits, "新增告警閘的放行狀況(提醒,不擋):",
                          "自動放行多代表檢查根本沒在跑;逐條放行多代表規則跟這個專案不合。"
                          "看放行了什麼:lumos lint-waive --list")
        print()

    if ci:
        # ★run 標記(2026-08-21,doctor-run事件_計劃)★:乾淨 run 也要留痕——帳本只記警告時,
        # 分不出「修好了」與「還在」(「已清」=該 run 有標記但無該節點的 check-* 事件)。
        # nodes 恆空、不進 issues、不改 rc;gov 預設畫面隱藏(見 cmd_gov),--full/--stats 照列。
        _gates_hit = len({e.get("gate") for e in gov_events if str(e.get("gate", "")).startswith("check-")})
        gov_events.append({"gate": "doctor-run", "kind": "ran", "hard": False, "nodes": [],
                           "note": f"issues={issues} gates={_gates_hit} soft={_soft['segs']}"})
        _append_governance_log(env.vault, gov_events)

    # 「還有幾段提醒」——子句從各段自己的標題取,不手寫第二份文字(會漂)
    def _soft_tail():
        # ★不要把各段標題截斷拼成一句★:那些標題是完整句子,截到十幾個字會變成讀不懂的碎片
        # (2026-09-06 試過兩版都難讀)。這裡只給數字——結論行的任務是「別比正文樂觀」,
        # 細節上面每一段都印過了,要全文一個指令就有。
        if not _soft["segs"]:
            return ""
        # 排版照該檔既有慣例:提醒行用 ⚠、指令獨立一行(跟 warn/warn_soft 的 advice 同款)
        # ——r1 架構對齊席:原本用了全檔沒出現過的 · 符號、又把指令接在句尾同一行,
        # 跟長期標準「發生什麼→為何在意→指令獨立一行」分岔
        cnt = f"{_soft['segs']} 段、共 {_soft['lines']} 條"
        return (f"\n  {C['Y']}⚠{C['X']} 另有 {cnt}提醒沒算進上面那個數字——它們不影響判定,"
                f"但每一段剛才都印了\n  {C['B']}看全部{C['X']}: lumos doctor --verbose")

    print(f"{C['B']}─────────────────────────────────{C['X']}")
    if issues == 0:
        print(f"{C['G']}{C['B']}✓ 圖譜健康{C['X']} — 0 issues ({len(notes)} 篇){_soft_tail()}")
        return 0
    print(f"{C['Y']}{C['B']}⚠ 發現 {issues} 個 issue{C['X']} ({len(notes)} 篇){_soft_tail()}")
    return 1 if strict else 0


# ═══════════════════════ 階段二: 讀側 ═══════════════════════

# ★摘要符號詞彙表的單一來源★(2026-09-15,plan:[[Projects/標籤系統精簡_計劃]] S10):
# 原本這裡與 SYMBOLISH_RE 那邊各寫死一份九值,只改一份會讓「已收編」只有一半是真的
# ——搜尋會把命中行標成錯的符號區域,而單篇快檢卻說沒問題。
# PRIOR-ART / REVISIT 兩個是紀律文件明文要求寫的(CLAUDE.md 設計段與鐵則四),
# 之前不在表內:前者含連字號、連抓錯字的正則都比對不到(加白名單是無效動作),
# 後者會被當成打錯字唸——兩種相反的壞法。
# 2026-09-21 補四個:紀律範本改成「程式碼為主」之後,寫筆記要先分「程式碼推不推得出來」,
# 分類前綴是 WHY(當初為什麼這樣決定)/RULE(程式看不到的限制)/PITFALL(踩過的坑)/
# FACT(現況描述,要標以程式碼為準並附查詢指令)。範本叫人寫、工具卻不認的話,
# 那幾行會被 lint 唸成打錯字,也不會被當成摘要行——規範直接空轉。
SYMBOL_NAMES = {"KEY", "FLOW", "DEP", "TEST", "AUTH", "FLAG", "DECISION", "VERIFY", "CORE",
                "PRIOR-ART", "REVISIT",
                "WHY", "RULE", "PITFALL", "FACT"}
SYMBOL_RE = re.compile(r"^(" + "|".join(sorted(SYMBOL_NAMES, key=len, reverse=True)) + r"):")

# ★脈絡標記的「同一行還要有什麼」★(2026-09-21 第三階段;單源=紀律範本〈寫筆記時〉那一節)
# 只唸警告不擋:規則是寫給人判斷的,機械只能看形狀,判錯就擋會逼人繞過去。
# ★只套四個新前綴★:FLOW:/DEP: 在本 repo 就有 277 行舊的,一開就是幾百條警告——
# 「誤報多過真報」的機制活不過一週,舊帳不追改,新寫的現況描述請改用 FACT:。
# RETIRE-IF:連續兩個月零觸發(大家本來就寫對了),或誤報多過真報 → 撤掉這一段。
# REVISIT:2026-11-21 看觸發統計,順便決定要不要延伸到 FLOW:/DEP:。
_CTX_REGRESS_RE = re.compile(r"\[test:|重現|repro", re.I)
_CTX_QUERY_RE = re.compile(r"`[^`]{6,}`")          # 一條可重跑的查詢指令(反引號包起來)
# 出處 = 日期 / 決策編號 / [[節點]] / 既有的 [src:] 標記 / 真的像 sha 的字串
# (★不收純數字★:2026-09-21 通才席 F5——原本 [0-9a-f]{7,40} 讓任意 7 位數字都算出處)
_CTX_SRC_RE = re.compile(r"20\d\d-\d\d-\d\d|#d\d+|\[\[|\[src:|\bd\d+\b"
                         r"|\b(?=[0-9a-f]{7,40}\b)[0-9a-f]*[a-f][0-9a-f]*\b")

# 前綴 → (判定函式, 缺什麼的白話, 怎麼補)
_CONTEXT_MARKER_RULES = {
    "WHY": (lambda s: bool(_CTX_SRC_RE.search(s)),
            "出處",
            "行內補一個日期、決策編號(#d3)、提交 sha 或 [[節點]],不然下一個人沒辦法查證這句話"),
    "PITFALL": (lambda s: bool(_CTX_REGRESS_RE.search(s)),
                "防回歸",
                "補 [test:測試名],或寫一條會重現的指令;兩個都沒有,這條只是感想"),
    "FACT": (lambda s: "以程式碼為準" in s and bool(_CTX_QUERY_RE.search(s)),
             "以程式碼為準的標註或查詢指令",
             "現況描述會過期:同一行標「以程式碼為準」並用反引號附一條可重跑的查詢指令;"
             "能從程式碼直接查到的,其實不該抄進筆記"),
}

# ★RULE: 的生命週期欄位★(2026-09-21 外家審計 F4 折入)
# 原本只驗「行內有日期字樣 + 有退場字樣」,`RULE:2030-99-99 退場:永不撤` 這種假規則零警告,
# 而且「這條過期了沒」沒人判得出來——散文寫的有效期不等於可執行的有效期。
# 欄位沿用本 repo 既有的 [test:]/[audit:] 行內寫法,不新發明語法:
#   [since:YYYY-MM-DD] 什麼時候立的(必填)   [retire:<條件>] 看到什麼就該撤掉(必填)
#   [until:YYYY-MM-DD] 硬到期日(選填)       [confirmed:YYYY-MM-DD] 最後一次確認(選填)
#   [status:active|superseded] 預設 active  [applies:<版本或範圍>](選填)
# 只有 since 與 retire 都寫齊、且不是 superseded 的 RULE 行,才有挑戰程式碼的效力(見紀律範本第 3 條)。
# 一欄位一個正則,形狀跟鄰居 TEST_REF_RE / AUDIT_REF_RE / ROLLBACK_REF_RE 一致
# (2026-09-21 架構對齊席:原本寫成一條合併正則+dict,是這支檔裡的第二種做法)
SINCE_REF_RE = re.compile(r"\[since:\s*([^\]]*)\]")
UNTIL_REF_RE = re.compile(r"\[until:\s*([^\]]*)\]")
CONFIRMED_REF_RE = re.compile(r"\[confirmed:\s*([^\]]*)\]")
STATUS_REF_RE = re.compile(r"\[status:\s*([^\]]*)\]")
RETIRE_REF_RE = re.compile(r"\[retire:\s*([^\]]*)\]")
APPLIES_REF_RE = re.compile(r"\[applies:\s*([^\]]*)\]")
_RULE_FIELD_RES = {"since": SINCE_REF_RE, "until": UNTIL_REF_RE, "confirmed": CONFIRMED_REF_RE,
                   "status": STATUS_REF_RE, "retire": RETIRE_REF_RE, "applies": APPLIES_REF_RE}
_RULE_CONFIRM_STALE_DAYS = 180


def parse_rule_fields(rest):
    """把 RULE: 行裡的 [key:value] 抓成 dict(重複出現取最後一個,跟鄰居一樣)。"""
    out = {}
    for k, rx in _RULE_FIELD_RES.items():
        ms = list(rx.finditer(rest))
        if ms:
            out[k] = ms[-1].group(1).strip()
    return out


def rule_field_truncated(rest):
    """值裡含右中括號(典型:退場條件引用 [[節點]])會被截斷,截掉的部分沒人看得到。

    既有的 [test:]/[audit:] 家族也是同一種截斷,差別在那些欄位的值本來就是識別字;
    [retire:] 是散文,踩到的機會高很多,所以這裡主動唸出來而不是默默截掉。
    """
    bad = []
    for k, rx in _RULE_FIELD_RES.items():
        for m in rx.finditer(rest):
            if rest[m.end():m.end() + 1] == "]":
                bad.append(k)
    return sorted(set(bad))


def _rule_date(v):
    import datetime as _dt
    try:
        return _dt.date.fromisoformat(v)
    except Exception:
        return None


def rule_lifecycle_warnings(rest, today=None):
    """一條 RULE: 行的生命週期檢查,回傳警告清單(不擋)。"""
    f = parse_rule_fields(rest)
    out = []
    # 同一行塞兩條 RULE:,後面那條沒填欄位也會借用前面的(2026-09-21 通才席 F4)
    if rest.count("RULE:") >= 1:
        out.append("一行只放一條 RULE:——同一行寫兩條時欄位會混在一起算,"
                   f"沒填欄位的那條會借用旁邊的而被判過關:{rest.strip()[:40]}")
    trunc = rule_field_truncated(rest)
    if trunc:
        out.append("這幾個欄位的值裡有右中括號,會被截斷(常見於退場條件引用 [[節點]]):"
                   + "、".join(f"[{k}:…]" for k in trunc)
                   + "——改寫成不帶中括號的一句話,或把節點名寫在欄位外面"
                   + f":{rest.strip()[:40]}")
    missing = [k for k in ("since", "retire") if not f.get(k)]
    if missing:
        out.append("脈絡標記『RULE:』缺 " + "、".join(f"[{k}:…]" for k in missing)
                   + "——規則要機械讀得到「什麼時候立的」和「看到什麼就該撤掉」,"
                     "散文寫的有效期沒人判得出來;寫不出退場條件,就是還沒想清楚這條該不該立"
                   + f":{rest.strip()[:40]}")
    st = (f.get("status") or "active").lower()
    if st == "superseded":
        out.append("這條 RULE 標了 [status:superseded],已經沒有挑戰程式碼的效力,"
                   "只能當歷史線索;確定撤掉就把整行刪掉,別留著讓人誤讀"
                   f":{rest.strip()[:40]}")
    elif st != "active":
        out.append(f"[status:{st}] 不是認得的值(只收 active / superseded):{rest.strip()[:40]}")
    import datetime as _dt
    today = today or _dt.date.today()
    for key, label in (("since", "立的日期"), ("until", "到期日"), ("confirmed", "最後確認")):
        v = f.get(key)
        if v and _rule_date(v) is None:
            out.append(f"[{key}:{v}] 不是合法日期({label}要寫成 YYYY-MM-DD):{rest.strip()[:40]}")
    until = _rule_date(f.get("until") or "")
    if until and until < today and st == "active":
        out.append(f"這條 RULE 的 [until:{f['until']}] 已經過期({today} 了)還標著 active——"
                   "確認還要不要留:要留就往後延並補 [confirmed:],不留就刪掉或標 superseded"
                   f":{rest.strip()[:40]}")
    conf = _rule_date(f.get("confirmed") or "")
    if conf and (today - conf).days > _RULE_CONFIRM_STALE_DAYS and st == "active":
        out.append(f"這條 RULE 超過 {_RULE_CONFIRM_STALE_DAYS} 天沒人確認過"
                   f"(最後一次是 {f['confirmed']})——還成立就更新 [confirmed:],不成立就撤掉"
                   f":{rest.strip()[:40]}")
    return out


def context_marker_warnings(summary_text):
    """檢查摘要裡四個脈絡前綴的形狀,回傳警告字串清單(不產生 error)。"""
    out = []
    for raw in (summary_text or "").split("\n"):
        line = raw.strip()
        if not line:
            continue
        m = SYMBOL_RE.match(line)
        if not m:
            continue
        if m.group(1) == "RULE":
            out.extend(rule_lifecycle_warnings(line[len("RULE:"):]))
            continue
        rule = _CONTEXT_MARKER_RULES.get(m.group(1))
        if not rule:
            continue
        ok, missing, how = rule
        rest = line[len(m.group(1)) + 1:]
        if not ok(rest):
            out.append(f"脈絡標記『{m.group(1)}:』缺{missing}——{how}:{rest.strip()[:40]}")
    return out

FM_KEY_RE = re.compile(r"^\s*([A-Za-z_][\w-]*):")


def _search_region(lineno, line, fm_end):
    """標記命中行所在的結構區域 — 讓「合約行 vs 散文」一眼可辨(尊重標籤哲學)。"""
    s = line.strip()
    if "★INVARIANT★" in s:
        return "★INVARIANT★"
    if "★DEBT★" in s:
        return "★DEBT★"
    if lineno <= fm_end:
        m = SYMBOL_RE.match(s)
        if m:
            return m.group(1)            # summary 符號行: KEY/FLOW/DEP...
        mk = FM_KEY_RE.match(line)
        if mk:
            return f"fm:{mk.group(1)}"    # frontmatter 欄位
        return "fm"
    return "body"


# ── 檢索排序核心(BM25F,borrow Whoosh 公式+Robertson BM25F tf 加權;spec:檢索優化_計劃) ──

_RANK_ASCII_RE = re.compile(r"[a-z0-9][a-z0-9_\-]*")
_RANK_CJK_RE = re.compile(r"[\u4e00-\u9fff\u3400-\u4dbf]+")
_RANK_FIELD_W = {"title": 4.0, "aliases": 3.5, "summary": 2.5, "tags": 1.5, "body": 1.0, "type": 0.5}   # aliases=同義詞欄(2026-08-05,詞面落空最便宜解;權重略低於標題)


def _rank_tokenize(text):
    """中文連續段→字元 bigram(單字段→unigram);ASCII→完整 token+snake/kebab/數字拆分;小寫。"""
    out = []
    low = nfc(text or "").lower()
    for m in _RANK_CJK_RE.finditer(low):
        seg = m.group(0)
        if len(seg) == 1:
            out.append(seg)
        else:
            out.extend(seg[i:i + 2] for i in range(len(seg) - 1))
    for m in _RANK_ASCII_RE.finditer(low):
        tok = m.group(0)
        out.append(tok)
        parts = [p for p in re.split(r"[_\-]|(?<=[a-z])(?=[0-9])|(?<=[0-9])(?=[a-z])", tok) if p]
        if len(parts) > 1 or (parts and parts[0] != tok):
            out.extend(p for p in parts if p != tok)
    return out


def _rank_idf(n_docs, df):
    """平滑 IDF(Whoosh/Lucene Classic):log(N/(df+1))+1——小語料全出現詞仍為正。"""
    import math
    return math.log(n_docs / (df + 1)) + 1.0


def _rank_bm25(tf, idf, dl, avgdl, k1=1.2, b=0.75):
    return idf * (tf * (k1 + 1)) / (tf + k1 * ((1 - b) + b * dl / max(avgdl, 1e-9)))


def _rank_fields(env, rel):
    """節點 → 欄位文本 dict(title/summary/tags/body/type)。body 去 frontmatter。"""
    n = env.notes.get(rel)
    try:
        text = (env.vault / rel).read_text(encoding="utf-8-sig")
    except Exception:
        text = ""
    lines = text.split("\n")
    fm_end = 0
    if lines and lines[0].strip() == "---":
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                fm_end = i + 1
                break
    body = "\n".join(lines[fm_end:])
    f = n.fields if n else {}
    tags = f.get("tags")
    tags = " ".join(tags) if isinstance(tags, list) else str(tags or "")
    aliases = f.get("aliases")
    aliases = " ".join(str(a) for a in aliases) if isinstance(aliases, list) else str(aliases or "")
    return {"title": (n.stem if n else Path(rel).stem),
            "aliases": aliases,
            "summary": str(f.get("summary") or ""),
            "tags": tags, "body": body, "type": str(f.get("type") or "")}


_RANK_TYPE_MULT_MOC = 0.4   # A1 型別先驗:MOC=hub 降權(goldset 實證關鍵字磁鐵;train 網格凍結)


_RANK_STATUS_MULT = 1.0   # A1.5 狀態先驗(stale/superseded 降權;goldset 網格後凍結,1.0=關)


def _rank_type_mult(env, rel):
    """型別/狀態先驗乘數(A1/A1.5,節點靜態先驗_調研):moc 降權、stale/superseded 降權、其餘 1.0。
    降權用乘法(比例效果跨 query 一致,企業搜尋標準);LUMOS_RANK_* env 供評測消融覆寫。"""
    n = env.notes.get(rel)
    fields = n.fields if n and isinstance(n.fields, dict) else {}
    t = str((fields.get("type") or "")).strip().lower()
    m = 1.0
    if t == "moc":
        try:
            m *= float(os.environ.get("LUMOS_RANK_MOC_MULT", _RANK_TYPE_MULT_MOC))
        except ValueError:
            m *= _RANK_TYPE_MULT_MOC
    st = str((fields.get("status") or "")).strip().lower()
    if st in ("stale", "superseded"):
        try:
            m *= float(os.environ.get("LUMOS_RANK_STATUS_MULT", _RANK_STATUS_MULT))
        except ValueError:
            m *= _RANK_STATUS_MULT
    return m


def _rank_score_candidates(env, query, candidates):
    """對候選集跑 BM25F(欄位 tf 加權於飽和前,單一虛擬文件)× 型別先驗乘數(A1)。
    回 [(rel, score, hits)]。N/df/avgdl 以候選集為 corpus(排序目的,絕對值不跨查詢比較)。"""
    q_tokens = list(dict.fromkeys(_rank_tokenize(query)))
    if not q_tokens or not candidates:
        return [(r, 0.0, []) for r in candidates]
    docs = {}
    for rel in candidates:
        fields = _rank_fields(env, rel)
        tfs = {}
        dl = 0.0
        for fname, ftext in fields.items():
            w = _RANK_FIELD_W[fname]
            toks = _rank_tokenize(ftext)
            dl += len(toks)          # 長度用未加權 token 數(spec §1)
            for tok in toks:
                if tok in q_tokens:
                    tfs[tok] = tfs.get(tok, 0.0) + w   # tf 加權於飽和前
        docs[rel] = (tfs, dl)
    n_docs = len(docs)
    avgdl = sum(d for _, d in docs.values()) / max(n_docs, 1)
    df = {t: sum(1 for tfs, _ in docs.values() if t in tfs) for t in q_tokens}
    out = []
    for rel, (tfs, dl) in docs.items():
        score = 0.0
        hits = []
        for tok in q_tokens:
            tf = tfs.get(tok, 0.0)
            if tf <= 0:
                continue
            score += _rank_bm25(tf, _rank_idf(n_docs, df[tok]), dl, avgdl)
            hits.append(tok)
        out.append((rel, round(score * _rank_type_mult(env, rel), 4), hits))
    # A3 權威度(in-degree 飽和加分)已試已殺(2026-07-11 goldset 雙面負增益:
    # search 0.875→0.847@w0.2、edit P@8 0.70→0.65@w0.1——本圖的高連結節點=導覽樞紐非答案,
    # 與 MOC 磁鐵實證同構)。詳見 Projects/節點靜態先驗_調研 消融紀錄;勿憑直覺復活。
    out.sort(key=lambda x: (-x[1], x[0]))
    return out


def _is_forgotten(env, rel):
    """召回層真遺忘判定:status=superseded 預設藏(GateMem 2026-07-24 吸收)。
    ★只認 superseded,不含 stale★——stale 是「待重驗」警訊,藏了=把該看見的提醒也遺忘、製造新洞
    (見 Projects/真遺忘召回過濾_計劃 樞紐陷阱)。valid:false 決策屬 decisions 層、不歸此節點層判定。"""
    n = env.notes.get(rel)
    if not n or not isinstance(n.fields, dict):
        return False
    return str(n.fields.get("status") or "").strip().lower() == "superseded"


def _strip_code_text(text, include_code=False):
    """把「程式碼區塊/inline code 以外看得見的文字」串成一段——★整段文字層的唯一實作★。

    ★為什麼不用 `FENCE_RE.sub("")`(2026-08-03 code-loop r2,全局哨兵抓到,附兩處實測重現)★:
    `FENCE_RE` 是成對非貪婪比對,★看不見未閉合的 ``` 圍欄★。同一個弱點原本散在四處,
    其中兩處後果比 search 嚴重得多——
      ① `load_vault()`:未閉合圍欄裡的 `[[wikilink]]` ★被當成真的圖譜邊索引進去★
         → 幽靈連結進入持久化的圖結構(backlinks 實測會多報一條)。
      ② `cmd_guard_trace()`:未閉合圍欄裡的測試名 ★被當成合約的真實佐證★
         → 污染 ★INVARIANT★→[test:]→Verification 證據鏈,正好打臉該指令自己的保證。
    逐行 toggle 的語意才是對的:未閉合圍欄之後一律視為 code(隱形),與主搜尋一致。
    ★爆炸半徑(2026-08-03 r3 由 Codex 覆核後修正,原宣稱過強)★:
      ・全庫 220 篇★無任何未閉合圍欄★(兩方各自掃過,一致)
      ・wikilink 邊集合 ★新舊完全相同(差集為空)★
        ★這裡刻意★不寫具體數字★,只寫不變量★——2026-08-03 r4 三位審查員各自
        獨立量,得到 436/382/728、976/728/240 等多組互不相同的值,沒有一個等於
        我原本抄來的「354」(那是 `lumos export --format dot` 的邊數口徑)。
        ★「邊數是多少」取決於你怎麼數(出現次數/去重/含不含 frontmatter/解析前後),
        但「新舊相同」與口徑無關——★該記的是不變量,不是那個數★。
        要自己驗:任選一種口徑,對 `body_clean` 用舊寫法與 `_strip_code_text`
        各算一次邊集合,比差集。
        ★過程檢討:我當初把 r3 審查員報告裡的數字直接抄進 docstring、沒有自己量,
         正是本專案同日剛在圖譜更正過的「數字被沿用進句子」——只是碰巧站得住★
      ・`guard trace` 全 vault 輸出 ★逐字元相同★(67 行,實測 diff)
      ・★但「清洗後文字一個字都不變」這個更強的說法不成立★:33-36 篇不同
        (兩位審查員各自量到 33 與 36,計數口徑略異;方向一致)——新法(逐行
        `lstrip().startswith("```")`)接受★縮排的圍欄★,舊 `FENCE_RE` 只認第 1 欄。
        ★這是與不閉合圍欄★正交★的另一類變化,原本的「爆炸半徑=0」理由沒涵蓋它★;
        方向上新法與主搜尋一致(search 一直都是逐行 lstrip)、也與 CommonMark 一致,
        故判定為修正而非回歸——但★這是事後補的論證,不是原本就驗過的★。
    """
    return "\n".join(pr for _no, _raw, pr in _search_visible_lines(text.split("\n"), include_code))


def _visible_lines(lines, keep_fenced=False):
    """★全檔唯一的 fenced-code 判定實作★:逐行 toggle,回 (行號從1起, 原始行)。

    `keep_fenced=True` 時保留圍欄★內★的文字(但仍跳過 ``` 標記行本身)。

    ★為什麼所有人都必須走這裡(2026-08-03 code-loop r2/r4)★:原本各處自己用
    `FENCE_RE = re.compile(r"^```.*?^```", re.S | re.M)`,那個正則有兩個致命假設——
      ① 假設圍欄★成對★:未閉合的圍欄看不見(r2 抓到:幽靈圖譜邊、假合約佐證)
      ② 假設圍欄標記★在第 0 欄★:收尾圍欄一縮排就跟下一個區塊的開頭錯配,
         ★把中間的真散文整段當程式碼吞掉★(r4 抓到,實測某條路徑宣稱直接消失)
    ②的消費端是治理機制本身(refcheck → design-loop 的 G1 硬閘、Edit/Write 前
    自動注入必看合約的 impact hook)——★一個縮排的 ``` 就能把某節點的鐵則警告
    靜默關掉★。逐行 toggle 對兩個假設都免疫。
    
    ★兩段式讀法(2026-09-16 代碼審 r2)★:先照 CommonMark 讀——收尾圍欄後面只能有空白,
    帶語言標記的那行不算收尾(不然巢狀範例裡的樣板會被當成真的)。但這條規則比題目寬:
    收尾★打錯一個字、多敲一鍵★也會變成「關不掉」,後面到檔尾所有內容(含合約行)
    無聲隱形——正是下面警告過的最危險模式換個門長出來。所以規格讀法如果讀完還有圍欄沒關,
    就整份退回寬鬆讀法(同字元、長度夠就算關)。取捨:同一份文件裡同時有巢狀範例★和★
    沒關到的圍欄時,會退回寬鬆、巢狀那題就擋不住——那等於回到 2026-09-16 之前的行為,
    不算退步,而且真的有沒關到的圍欄本來就該先修那個。
    """
    def _scan(strict):
        """回 (看得見的行, 收尾時還有沒有圍欄開著)。strict=照 CommonMark(收尾不得帶東西)。"""
        fence = None      # 開著的圍欄:(字元, 長度)。同字元且至少一樣長才能關
        # ★不偵測 HTML 註解★(-b r3 單reviewer 兩條 blocker:`-->  <!--` 先關再開會把後面整份藏掉)
        out = []
        for i, ln in enumerate(lines):
            indent = len(ln) - len(ln.lstrip(" "))
            s = ln.lstrip(" ")
            # 縮排 ≤3 格才是圍欄標記;4 格以上(或 tab)是縮排程式碼區塊的內容,不是邊界
            is_marker = indent <= 3 and not ln.startswith("\t") and s.startswith(("```", "~~~"))
            if is_marker:
                ch = s[0]
                run = len(s) - len(s.lstrip(ch))
                if fence is None:
                    fence = (ch, run)
                    continue
                if ch == fence[0] and run >= fence[1] and (not strict or s[run:].strip() == ""):
                    fence = None
                    continue
            if fence is not None and not keep_fenced:
                continue
            out.append((i + 1, ln))
        return out, fence is not None

    out, unterminated = _scan(True)
    if unterminated:                      # 規格讀法讀不完 → 退回寬鬆(見說明的取捨)
        out, _ = _scan(False)
    yield from out


def _strip_fences_text(text):
    """只剝 fenced code block,★保留 inline code★——給 refcheck 家族用。

    ★為什麼不能用 `_strip_code_text`★:那支連 inline code 一起剝,而 refcheck
    要抽的路徑宣稱★正是寫在 inline code 裡★(`` `scripts/foo.py:12` ``)。
    用錯會讓所有宣稱憑空消失、G1 對著空清單宣告通過。
    """
    return "\n".join(ln for _no, ln in _visible_lines(text.split("\n")))


def _search_visible_lines(lines, include_code):
    """產生 (行號從1起, 原始行, 比對用 probe)——★search 的「哪些字看得見」唯一實作★。

    ★為什麼要抽出來(2026-08-03 code-loop r1,slot3 附實測)★:多詞回退的預檢原本自己
    寫了一份「整段 regex 剝 fence」,與主迴圈的「逐行 in_fence toggle」是★兩份實作★,
    遇到★未閉合的 ``` 圍欄★就分岔:主迴圈把圍欄後全部視為 code(隱形),預檢的成對
    regex 剝不掉懸空那半段(仍可見)。後果不是「回退多觸發一次」這種小事——是
    ★逐詞覆蓋虛報非零★:實測單獨搜某詞 0 篇,覆蓋卻印該詞 1 篇,直接打臉 M1.5
    「告訴你哪個詞 0 命中」的存在理由。
    ★我原本在註解裡把這個邊界寫成「方向保守、無害」——那個評估只涵蓋了「回退觸發
    與否」,沒涵蓋「覆蓋數字本身」。同一個坑今天第六次:用一個後果描述邊界,另一個
    後果就不在視野裡。★ 修法不是補正則,是讓兩邊共用這一份。
    """
    for _no, ln in _visible_lines(lines, keep_fenced=include_code):
        yield _no, ln, (ln if include_code else INLINE_CODE_RE.sub("", ln))


# ★字對回退的觸發下限(暫用值,還沒校準)★:只有「連續漢字段長度 ≥ 這個數」才拿它切字對。
# 4 個字 = 3 個字對,跟既有那句提示的觸發條件同一個數,不是另外拍的。
# ★這個數還沒有實測依據★——計劃 [S2] 明寫門檻要在對照組裡定,而對照組要等這支能跑才組得出
# 候選池(這就是為什麼實作排在量測前面)。目前預設關,所以拍錯也不影響任何人。
# REVISIT:2026-10-14 用 [S2] 那套獨立評測校準這個數,連同查詢長度一起看(短查詢與長問句
# 的風險不同,實測四個漢字三題有兩題仍正確回 0,真正的風險在長問句)。
_CJK_LOOSE_MIN_RUN = 4
# ★字對數上限★(2026-09-07 代碼審 r1 通才席判 major,兩邊各自量過):
# 這條回退的成本是 O(字對數 × 篇數 × 篇幅)——預檢對每個字對、每篇筆記做一次子字串比對,
# 主迴圈再對每一行比一次。本庫 441 篇實測(我自己量的,通才席另外量到同一個量級):
#   10 字 0.55s / 30 字 0.87s / 50 字 1.18s / 100 字 1.94s / 300 字 5.13s(通才席量到 3000 字 47.9s)
# 這支旗標是給「自然問句」用的,而貼一整段文字進來看起來就是掛住了。
# ★不做無聲截斷★(那會讓人以為查完了):超過上限就不跑回退,並且講清楚為什麼。
# 50 這個數是照上面那條曲線挑的——約 1.2 秒,還在「等一下」而不是「卡住了」的區間。
_CJK_LOOSE_MAX_PAIRS = 50


def _strip_zero_width(s):
    """拿掉肉眼看不見的零寬字元(常見於手機輸入法與網頁複製貼上)。

    ★為什麼需要★(2026-09-07 代碼審 r1 通才席實測):一串中文裡夾一個 U+200B 時,
    Python 的 split() 不把它當空白(所以多詞回退不會退),而「有沒有空白」的判斷
    如果把它算成空白,字對回退的閘又會被擋掉——★兩條路同時失效,而且完全沒有訊息★,
    使用者拿到的是沉默的 0 筆。它也會把連續漢字段切斷,讓字對切不出來。
    """
    return re.sub(r"[\u200b-\u200f\ufeff]", "", s or "")


def _cjk_bigrams(term):
    """把查詢裡的★連續漢字段★切成相鄰兩字一組:「檢索優化」→ 檢索 / 索優 / 優化。去重保序。

    ★這支是單一真相★:預檢、主迴圈、提示、測試都用它,不要各自再切一份。
    這個檔案裡記著兩次真事故,都是「同一個問題長出第二份獨立實作」造成的——
    預檢自己剝一份程式碼圍欄而跟主迴圈分岔,結果是幽靈連結邊、以及逐詞覆蓋虛報非零。

    ★字元域只認漢字(基本區 + 擴充 A),跟排序切詞器同源★:假名與諺文在那支切詞器裡
    根本產不出字對,放進來只會生出永遠 0 命中的雜訊。日文漢字假名混寫只取漢字那幾段。
    ★擴充 B 以上不涵蓋★(2026-09-07 代碼審 r1 外家否決席指出,實測屬實:「𠀀𠀁𠀂𠀃」
    不進回退)。不擴的理由:這支跟排序切詞器共用同一條字元域規則,擴了會一起改動排序的
    切詞行為,那是另一件事、要另外量。★所以旗標的說明文字改成「漢字(基本區與擴充 A)」,
    不要說「中文」——宣稱的範圍不得大於實際做到的範圍,這條在這支檔案裡被抓到過三次。★
    REVISIT:2026-11-14 跟「要不要翻預設」一起看要不要擴字元域(人名、古籍、異體字會用到)。

    ★為什麼要有長度下限★:比照鄰居那三道濾網(丟純數字、丟單字、丟可拆分的複合詞)——
    那三道是實測逼出來的,不是防禦性寫法(「2026」命中 381/385 等於全庫召回,
    單一常見漢字同病)。字對天生長度 2、非 ASCII、不含連字號,所以純數字與可拆分那兩道
    對它是空的;真正會咬到的是★短漢字段★,而它就是「單字全庫召回」的同一種病:
    兩個字的段只切得出一個字對,那個字對很可能是個常見詞,一命中就爆量。
    所以只有長度 ≥ _CJK_LOOSE_MIN_RUN 的段才拿來切——這一條同時當觸發門檻用,
    不另立第二個判準(兩個判準各寫一份,就是上面那兩次事故的形狀)。
    """
    out, seen = [], set()
    for m in _RANK_CJK_RE.finditer(_strip_zero_width(nfc(term or "").lower())):
        seg = m.group(0)
        if len(seg) < _CJK_LOOSE_MIN_RUN:
            continue
        # ★切詞交給 _rank_tokenize,不自己再切一份★
        # (2026-09-07 代碼審 r1 架構對齊席判 blocking,查證屬實:這個 repo 有明文規矩,
        #  寫在 _el_query_tokens 的說明裡——「重用 _rank_tokenize(禁第二份切詞實作)」。
        #  第一版我只借了那條字元域的規則,切的迴圈自己重寫一遍,等於違反同一條家規,
        #  而我在這支函式的說明裡才剛寫完「同一個問題長出第二份實作付過兩次學費」。
        #  ★那個警告我只用來提醒未來的呼叫端,沒有拿來檢查自己這一步。★
        #  實測十題(含日文混寫、ASCII 夾雜、空字串、重複字)兩種寫法輸出完全一致。)
        # 這裡傳進去的一定是「單一連續漢字段」,所以它只會吐這一段的字對。
        for bg in _rank_tokenize(seg):
            if bg not in seen:
                seen.add(bg)
                out.append(bg)
    return out


# ★「有沒有空白」要認全形★(2026-09-07 全 repo 審視 #22 順手修的既有洞)。
# 修之前:用全形空白分詞的查詢會同時收到兩行互相矛盾的訊息——多詞回退說「已經照規矩
# 分詞查過」,下一行的提示又說「你查的是一串沒有空白的中文,請加空白」。
# 這個洞不是本案造成的,但既然要動同一個判準,順手修掉。
# ★零寬字元不算空白★:它不是分詞意圖,而且 Python 的 split() 也不把它當空白——
# 算進來會讓多詞回退與字對回退同時失效且無聲(見 _strip_zero_width)。
# ★誠實記一句★:呼叫端都會先跑 _strip_zero_width,所以這一改目前★量不到行為差別★
# (翻紅釘實測:只拆這一改,測試照樣全綠)。留著是因為這條規則本身就該是對的
# ——「零寬字元是空白」在任何讀者眼裡都是錯的判斷,而且哪天有人拿掉前面那道剝除,
# 這裡是最後一道。不是死碼,是語意正確且目前被前一道遮住。
_ANY_SPACE_RE = re.compile(r"\s|[\u3000\u00a0\u2000-\u200a]")


def _cjk_nospace_hint(term, hits, regex=False, already_advised=False):
    """黏成一串沒斷開就幾乎必定 0 筆(Landmark 2026-08-11 實測 8 句 3 句 0 筆):整串當片語比對,
    整串找不到才退成各詞分開找,而黏成一串沒有「各詞」可退。0 命中且查詢含 ≥4 個中日韓字、沒有空白 → 提示。

    ★字元域刻意比字對回退寬★(2026-09-07 全 repo 審視 #22,[S6] 兩件事分開裁):
    「要不要跑字對回退」只認漢字(假名與諺文在切詞器裡根本產不出字對);
    但「要不要建議加空白」對日韓查詢一樣有用——那是跟文字系統無關的操作建議,
    統一成漢字判定會靜默拿掉日韓查詢今天就有的這句提示,那是行為退步。
    所以這裡照舊認中日韓,★只是訊息不再說「中文」★(說了對日韓查詢就是錯的)。
    """
    # ★同一個建議不准印兩次★(2026-09-07 代碼審 r1 通才席實測):字對回退觸發、
    # 而每一組覆蓋都是 0 時,結果會是 0 筆——於是這一句又被呼叫一次,印出跟前面
    # 一模一樣的「加空白」建議與一模一樣的指令範例。不是矛盾,是囉唆,而這一批
    # 本來就在收斂訊息品質。呼叫端已經講過就不再講。
    if hits or regex or already_advised:
        return None
    t = _strip_zero_width(term or "").strip()
    # ★空白要認全形★:修之前,用全形空白分詞的查詢會同時收到兩行互相矛盾的訊息——
    # 多詞回退說「已經照規矩分詞查過」,這一句又說「你查的是一串沒有空白的中文,請加空白」。
    if _ANY_SPACE_RE.search(t) or len(t) < 4:
        return None
    cjk = sum(1 for ch in t if "\u4e00" <= ch <= "\u9fff" or "\u3040" <= ch <= "\u30ff" or "\uac00" <= ch <= "\ud7af")
    if cjk < 4:
        return None
    return ("提醒:0 筆,而且你查的是黏成一串、中間沒有空白的字。搜尋會先把整串當片語比對,整串找不到才退成各詞分開找——"
            "黏成一串就沒有「各詞」可退,所以自然問句幾乎必定 0 筆。把概念之間加空白再查一次,例如「作廢訂單點數怎麼收回」改成:\n"
            "    lumos search \"作廢 收回 點數\"")


def cmd_search(env, term, path_prefix=None, regex=False, files_only=False, include_code=False,
               ranked=False, top=20, as_json=False, include_superseded=False,
               any_terms=True, cjk_loose=False):
    """全文搜尋(frontmatter + body)。預設大小寫不敏感 substring;--regex 用正則。
    預設**排除 fenced code 區塊 + inline code**(對齊 doctor 連結抽取的慣例,--code 才含);
    context 標記命中區域(★INVARIANT★/KEY/fm:欄位/body)。職責=自由文字;結構化查詢走
    contracts/decisions/stale/doctor。取代 obsidian search(2026-06-13)。
    2026-07-11 起 ranked(BM25F 相關性排序)為 CLI 預設(goldset 評測 §6 search 面全過,
    數字見 Verification/2026-07-11_檢索goldset評測);只重排既有候選、不擴召回、預設全量;
    --legacy 走舊字母序,--regex 自動走舊路。"""
    if regex:
        try:
            pat = re.compile(term, re.IGNORECASE)
        except re.error as e:
            print(f"擋下:你給的正則表達式不合法({e}),換一個", file=sys.stderr)
            return 2
        matches = lambda s: pat.search(s) is not None
    else:
        needle = nfc(term).lower()
        matches = lambda s: needle in nfc(s).lower()
    # ★多詞回退(2026-08-02;Projects/檢索多詞回退_計劃)★
    # 問題:候選階段是★整串子字串比對★——`search "BM25 檢索 排序"` 只要那幾個字沒連在
    # 一起出現過就是 0 候選。而 BM25F 本身完全會處理多詞(`impact --diff` 拿整段 hunk 當
    # query 運作正常),壞的是前面這道撈候選的關卡。
    # ★fallback-only,不是「永遠 OR」★:只在整串片語★全庫都找不到★時,才退成各詞 OR 召回。
    #   為什麼不無條件 OR:`_rank_score_candidates` 的 N/df/avgdl ★以候選集為語料★,擴召回
    #   會擾動所有既有查詢的排序。實測現有 goldset 30 題全部回 >0 候選 → 回退條件永不
    #   觸發 → 那 30 題行為一行不變,★零回歸是機械可證的,不是量出來的★。
    # ★為什麼用「掃描前預檢」而不是「掃完發現 0 再掃一次」★:後者要把整個主迴圈包進
    #   兩趟結構,而 legacy 模式是★邊掃邊 print★,兩趟會把同一次查詢印兩份;改成先緩衝
    #   再印等於為了一條死路重排主迴圈,風險不成比例。預檢只在多詞時跑,且一找到就 break。
    # ★已知邊界(誠實)★:預檢用簡化的 fence/inline-code 剝除近似主迴圈的排除規則,不是
    #   同一份實作。極端情況(未閉合的 ``` 圍欄)兩者判斷可能不一致——方向是★保守★:
    #   預檢誤判成「找得到」時只是不回退(維持現況),不會造成錯誤召回。
    _fb_terms = [t for t in nfc(term).lower().split() if t] if not regex else []
    _fb_used = False
    # ★沒有空白的中文:把回退用的那組詞換成相鄰兩字一組★(2026-09-07 全 repo 審視 #22)
    # 問題:一串沒有空白的中文★結構上永遠查不到★——下面那道回退要求「超過一個詞」,
    # 而沒有空白就是一個詞。CLAUDE.md 第一條紀律就是在教這件事,而一條紀律存在,
    # 就代表這個坑一直有人踩,踩的人是每個新 session 的 AI。
    # ★做法是「換掉回退時用哪一組詞」,不是新開一支候選收集器★(設計 [S3],r2 兩席都建議):
    #   下面那個預檢與主迴圈已經把路徑篩選、可見文字判定、命中行標記、排除作廢節點、
    #   隱藏筆數、三種輸出次序全部綁在一起。抽第二份出來 = 這支檔案已經付過兩次學費的
    #   那個形狀(同一個問題長出第二份獨立實作 → 幽靈連結邊 + 逐詞覆蓋虛報非零)。
    # ★預設關★(設計 [S5]):量測完才裁預設,而量測要等這支能跑才組得出候選池。
    # ★訂正一句我自己寫太大的宣稱★(2026-09-07 代碼審 r1 外家否決席判 major,查證屬實):
    #   第一版寫「預設關的時候沒有任何呼叫端的行為改變」——**那句話是假的**。
    #   同一批還改了下面那句「加空白」提示,而它在預設路徑上:
    #     ①措辭改了(不再說「中文」,因為對日韓查詢是錯的)
    #     ②全形空白分詞且 0 命中時★不再印★(那是刻意修掉的矛盾訊息)
    #   精確版本是:★候選集與結果不變,變的只有那句提示★。
    #   用固定語料實測過(三篇假筆記、五種查詢):輸出唯一的差異就是提示措辭那兩行,
    #   結果行一字不差。★不要用「行為一行不變」這種涵蓋不了自己改動的說法。★
    # ★不共用 --no-any★:那支旗標的語意有硬合約釘住只管「多詞查詢」,共用等於在沒走
    #   合約更新流程的情況下改寫合約範圍;而且使用者可能想單獨關這一支、保留多詞回退。
    _fb_kind = "words"
    if cjk_loose and (not regex) and len(_fb_terms) == 1 \
            and not _ANY_SPACE_RE.search(_strip_zero_width(term or "")):
        _bg = _cjk_bigrams(term)
        if len(_bg) > _CJK_LOOSE_MAX_PAIRS:
            print(f"(這串太長了:切出 {len(_bg)} 組相鄰兩字,超過 {_CJK_LOOSE_MAX_PAIRS} 組就不跑放寬比對——"
                  f"組數乘上筆記數,會慢到像掛住。放寬比對是給短問句用的。\n"
                  "  改成幾個關鍵詞加空白會又快又準,例如:\n"
                  '    lumos search "作廢 收回 點數"', file=sys.stderr)
        elif _bg:
            _fb_terms = _bg
            _fb_kind = "chars"
    _bg_note_cov = {}   # 字對回退時:節點 → 這篇命中了哪幾組(算「幾組裡命中幾組」用)
    # ★2026-08-03 起為預設(人裁)★——`--no-any` 逃生。翻預設的證據
    # (Projects/檢索多詞回退_計劃 M4):
    #   ①現況是「每個現實多詞查詢都回 0」(Landmark 284 篇 10/10、本庫快照 10/10)
    #   ②回退後 nDCG@5 0→0.767、MRR 0.95、第一名為「必看」7/10
    #     (雙評 Claude+Codex 跨家族、分歧交乾淨 opus 裁決)
    #   ③★零回歸機械可證★(回退只在整串片語全庫無命中時觸發)+對照組 5 題逐檔完全相同
    #   ④M1.5 逐詞覆蓋已把「查無」訊號還回來 ⑤查無任何機器消費端依賴「回 0」語意
    # ★誠實邊界★:pooling bias(候選池半數來自回退自己的 top-10)、n=10、單一快照。
    _fb_cov = {}        # M1.5:逐詞覆蓋(term -> 命中篇數);只在回退真的觸發時才印
    if (any_terms or _fb_kind == "chars") and (not regex) and len(_fb_terms) > 1:
        _fb_seen = False
        for _r in sorted(env.notes):
            if path_prefix and not _r.startswith(path_prefix):
                continue
            # ★與主迴圈同樣排除「真遺忘(superseded)」的節點★——不排的話逐詞覆蓋會
            # 比實際搜得到的多(2026-08-02 實測:門檻 55 vs 搜尋顯示的 50,差在 7 筆
            # 被隱藏的作廢節點)。覆蓋數若>實際,使用者會以為「這個詞有東西」而其實
            # 搜不到,★誤導方向與本功能要解的問題正好相反★。
            if not include_superseded and _is_forgotten(env, _r):
                continue
            try:
                _t = (env.vault / _r).read_text(encoding="utf-8-sig")
            except Exception:
                continue
            # ★與主迴圈共用同一份「可見行」實作★(不再自己剝一次,見 _search_visible_lines)
            _low = nfc("\n".join(pr for _no, _raw, pr
                                  in _search_visible_lines(_t.split("\n"), include_code))).lower()
            # ★順手數逐詞覆蓋(M1.5)★:本圈本來就讀了每個檔、也做過同樣的排除,
            # 多幾次子字串測試幾乎免費;不另開一圈。找到片語就 break,那時
            # 覆蓋數不完整——但那條路不會回退、也就不會印,無害。
            for _t2 in _fb_terms:
                if _t2 in _low:
                    _fb_cov[_t2] = _fb_cov.get(_t2, 0) + 1
            if needle in _low:
                _fb_seen = True
                break
        if not _fb_seen:
            _fb_used = True
            matches = lambda s: any(t in nfc(s).lower() for t in _fb_terms)
            # ★M1.5:把「查無」這個訊號用另一種形式還回來★
            # 為什麼需要:回退之後搜尋★幾乎不可能再回 0★——你永遠會拿到看起來
            # 合理的東西,而那可能只是常見詞的噪音。今天「0 筆」至少有時候代表
            # 「這個概念不在圖譜裡」,回退把那個訊號吃掉了。
            # 2026-08-02 Landmark 284 篇實測的實例:查「續會 門檻 計算」第一名是
            # 「停車折抵」,看起來像排序爛——其實是「續會」全庫 0 篇(查詢用詞猜錯),
            # 剩下兩個常見詞(門檻 50/計算 35)把結果洗走。逐詞覆蓋一印就當場看穿。
            # ★走 stderr★:與既有的「已隱藏 N 筆作廢結果」同一慣例,不污染 stdout
            # 的機器可讀輸出(--json/--files-only 的呼叫端會解析它)。
            _cov_txt = "  ".join(f"★{t}:0★" if _fb_cov.get(t, 0) == 0 else f"{t}:{_fb_cov.get(t, 0)}"
                                 for t in _fb_terms)
            # ★措辭必須是「未作廢的節點裡無命中」不是「全庫無命中」★
            # (2026-08-03 code-loop r1,slot3 附實測;slot2 同一處判 minor,依規矩取高)
            # 為什麼:預檢刻意跳過 superseded(那是對的——被藏起來的東西對使用者等於
            # 不存在,此時該回退)。但若片語★只★出現在一篇作廢節點裡,舊措辭會印
            #   （多詞回退:整串片語★全庫無命中★…）
            #   （已隱藏 1 筆作廢結果，--include-superseded 顯示）
            # ★兩行自相矛盾★:第一行斷言全庫沒有,第二行承認有 1 筆被藏。使用者只看
            # 最顯眼的第一行,會斷定「圖譜裡沒這東西」→ 可能重造一個已存在的節點。
            # ★危險方向是「誤判為不存在」,比多顯示一點雜訊嚴重★。
            # ★訊息宣稱的範圍不得大於實際檢查的範圍★——這條在同一天被抓到★三次★:
            #   r1:片語只在作廢節點時說「全庫無命中」(其實有,只是被藏)
            #   r2:`--path` 限定時仍說「未作廢的節點裡/全庫」(其實只掃了子集)
            # 兩次都是同一個錯:★用一個維度描述範圍,另一個維度就不在視野裡★。
            # 既有慣例本來就有揭露路徑範圍(見本函式尾端 `suffix = f"(限 {path_prefix})"`),
            # 這裡沒跟上。修法:範圍字串把「作廢」與「路徑」兩個維度都串進去。
            #   r3:第四個維度 `--code`(codex minor)——預設不搜 code block,片語若只
            #       存在於程式碼區塊裡,說「節點裡無命中」仍不精確。
            _sc = []
            if path_prefix:
                _sc.append(f"{path_prefix} 底下")
            _sc.append("未作廢的節點" if not include_superseded else "全部節點")
            _sc.append("(含程式碼區塊)" if include_code else "的可見文字")
            _scope_txt = "".join(_sc)
            if _fb_kind == "chars":
                # ★三段式,而且不准用行話★(設計 [S7];「字對召回」對使用者是沒解釋過的詞):
                # 發生什麼 → 為什麼該在意 → 指令獨立一行。
                # ★第一層訊號:永遠明示整串是 0★(設計 [S4])。回退之後結果不會是 0,
                # 使用者永遠拿得到看起來合理的東西——不講清楚整串其實一筆都沒有,
                # 就等於把「這個概念圖譜裡沒有」這個訊號吃掉了。
                print(f"(整串「{term}」在{_scope_txt}裡一筆都沒有。以下是放寬條件找到的:"
                      f"把它切成相鄰兩字一組去比對,所以命中可能只是字面重疊、跟你要找的事情無關。\n"
                      f"  每一組各自命中幾篇:{_cov_txt})", file=sys.stderr)
                print("  查得更準的做法是概念之間加空白,例如:\n"
                      '    lumos search "作廢 收回 點數"', file=sys.stderr)
                if any(_fb_cov.get(t, 0) == 0 for t in _fb_terms):
                    # ★誠實記一個彆扭★(設計 [S4]):零命中標記會落在切割產生的無意義組合上
                    # (「銀行貸款利率」切出來的「行貸」「款利」本來就不該有命中),
                    # 所以那些星號看起來像「這個概念圖譜沒有」,其實只是切割的雜訊。
                    print("  標 ★ 的那幾組 0 命中——但切出來的組合本來就有一半不是真的詞"
                          "(「銀行貸款」會切出「行貸」),所以這裡的 0 不代表圖譜沒記",
                          file=sys.stderr)
            else:
                print(f"(多詞回退:你查的整串詞在{_scope_txt}裡找不到完全一致的,改成每個詞分開查、有出現就算;"
                      f"逐詞覆蓋 {_cov_txt})", file=sys.stderr)
                if any(_fb_cov.get(t, 0) == 0 for t in _fb_terms):
                    print(f"  提醒:標 ★ 的那個詞在{_scope_txt}裡 0 命中——多半是你用的詞跟圖譜裡的說法不一樣,"
                          "不代表圖譜沒記這件事;先換個說法再查一次", file=sys.stderr)
    def _bg_ratio(rel):
        """字對回退時,這一筆「幾組裡命中幾組」。沒走字對回退就回空字串。
        ★不用行話★(設計 [S7]):對使用者講「組」,不講「字對」「bigram」。

        ★涵蓋範圍要講清楚★(2026-09-07 代碼審 r1 外家否決席判 minor,屬實):
        設計寫「每筆結果顯示比率」,而 `--files-only` 那條路★沒有★——它是機器消費端,
        輸出格式是 `節點 (命中行數)`,有呼叫端在解析,塞一段中文進去會打壞它們。
        所以精確版本是:**給人看的兩種輸出(排序後、字母序)有比率;`--files-only`
        格式不動,比率改走 `--json` 的 char_pairs_hit / char_pairs_total 兩個欄位**。
        這跟這支檔案既有的慣例一致(提示一律走 stderr,不污染 stdout)。"""
        if not (_fb_used and _fb_kind == "chars"):
            return ""
        _n = len(_bg_note_cov.get(rel, ()))
        return f"  ({len(_fb_terms)} 組裡命中 {_n} 組)"

    if ranked and regex:
        print("(--regex 模式不做相關性排序,照舊順序輸出)", file=sys.stderr)
        ranked = False
    _cand_hits = {}     # ranked:rel -> hit 行數(候選=legacy 命中集,不擴召回)
    _cand_detail = {}   # ranked:rel -> (hits, fm_end) 供逐檔明細輸出
    total_files = total_hits = 0
    hidden_superseded = 0   # 真遺忘:命中但因 superseded 被藏的結果筆數(★命中後才算,非全庫 superseded 數)
    for rel in sorted(env.notes):
        if path_prefix and not rel.startswith(path_prefix):
            continue
        try:
            text = (env.vault / rel).read_text(encoding="utf-8-sig")
        except Exception:
            continue
        lines = text.split("\n")
        fm_end = 0
        if lines and lines[0].strip() == "---":
            for i in range(1, len(lines)):
                if lines[i].strip() == "---":
                    fm_end = i + 1
                    break
        hits = []
        _seen_bg = set()
        for _no, ln, probe in _search_visible_lines(lines, include_code):
            if matches(probe):
                hits.append((_no, ln))
                if _fb_used and _fb_kind == "chars":
                    # ★第三層訊號:每筆結果「幾組裡命中幾組」★(設計 [S4])。
                    # 為什麼用比率不用分數:分數是以★每次的候選集★當語料算出來的,
                    # 絕對值不能跨查詢比(21 個候選的 2.02 跟 1 個候選的 0.31 不同語料);
                    # 鄰居那案已經因為同一個理由刪掉過分數門檻。比率是★查詢內可比★的。
                    _lp = nfc(probe).lower()
                    for _b in _fb_terms:
                        if _b in _lp:
                            _seen_bg.add(_b)
        if not hits:
            continue
        # 真遺忘濾網(★插點=命中確認後、三路分岔前):預設藏 superseded,--include-superseded 逃生。
        # 在此計數→hidden_superseded=命中被藏筆數(非全庫 superseded 數);三路(ranked/legacy/regex)一致。
        if not include_superseded and _is_forgotten(env, rel):
            hidden_superseded += 1
            continue
        total_files += 1
        total_hits += len(hits)
        if _fb_used and _fb_kind == "chars":
            _bg_note_cov[rel] = _seen_bg
        if ranked:
            _cand_hits[rel] = len(hits)
            _cand_detail[rel] = (hits, fm_end)
            continue
        if files_only:
            print(f"{rel} ({len(hits)})")
            continue
        print(f"{rel}{_bg_ratio(rel)}")
        for lineno, ln in hits[:8]:
            s = ln.strip()
            tag = _search_region(lineno, ln, fm_end)
            disp = s if len(s) <= 90 else s[:90] + "…"
            print(f"  {lineno} [{tag}]: {disp}")
        if len(hits) > 8:
            print(f"  … 還有 {len(hits) - 8} 處")
    # 真遺忘:隱藏提示一律走 stderr(全模式含 --files-only;stderr 不污染 stdout 機器可讀輸出)。
    # 印隱藏數=遺忘可審計(GateMem);不印=靜默遺忘,正是本案要堵的洞。
    if hidden_superseded:
        print(f"(已隱藏 {hidden_superseded} 筆作廢結果;要看的話加 --include-superseded)", file=sys.stderr)
    if ranked:
        import json as _json
        scored = _rank_score_candidates(env, term, list(_cand_hits))
        if int(top) > 0:
            scored = scored[:int(top)]
        if as_json:
            results = [{"node": rel, "score": score, "hits": hits, "match_lines": _cand_hits[rel]}
                       for rel, score, hits in scored]
            # ★機器端不必去解析提示文字★(設計 [S4] 第 4 點):三個欄位直接給。
            # phrase_hits 恆為 0 是重點——它就是「整串一筆都沒有」那個被回退吃掉的訊號。
            _payload = {"results": results, "candidates": len(_cand_hits),
                        "hidden_superseded": hidden_superseded}
            if _fb_used and _fb_kind == "chars":
                _payload["phrase_hits"] = 0
                _payload["loose_cjk_fallback"] = True
                _payload["char_pair_coverage"] = {t: _fb_cov.get(t, 0) for t in _fb_terms}
                for _r in _payload["results"]:
                    _r["char_pairs_hit"] = len(_bg_note_cov.get(_r["node"], ()))
                    _r["char_pairs_total"] = len(_fb_terms)
            print(_json.dumps(_payload, ensure_ascii=False))
        elif files_only:
            for rel, score, _h in scored:
                print(f"{rel} ({_cand_hits[rel]})")
        else:
            for rel, score, toks in scored:
                print(f"{score:7.3f}  {rel}  [{','.join(toks[:5])}]{_bg_ratio(rel)}")
                d_hits, d_fm = _cand_detail.get(rel, ([], 0))
                for lineno, ln in d_hits[:8]:
                    s = ln.strip()
                    tag = _search_region(lineno, ln, d_fm)
                    disp = s if len(s) <= 90 else s[:90] + "…"
                    print(f"    {lineno} [{tag}]: {disp}")
                if len(d_hits) > 8:
                    print(f"    … 還有 {len(d_hits) - 8} 處")
            trunc = f"top {len(scored)} / " if len(scored) < len(_cand_hits) else ""
            print(f"\n({trunc}共 {len(_cand_hits)} 篇候選,照相關性排序;想照檔名排加 --legacy)")
        # ★圖譜先行注入(2026-08-14 Enzo 裁)★:search 命中卻只掃摘要就下「圖譜沒記」的結論,
        # 是實證過的失效模式(金鑰明明在節點第 64 行,靠摘要判成「沒有」)。有命中就提醒一句,
        # 走 stderr 與逐詞覆蓋同慣例;--json/--files-only 不印(機器消費端)。
        if not scored and not as_json and not files_only:
            _h = _cjk_nospace_hint(term, 0, regex,
                                   already_advised=(_fb_used and _fb_kind == "chars"))
            if _h:
                print(_h, file=sys.stderr)
        if scored and not as_json and not files_only:
            print("提醒:命中≠查完——搜尋只告訴你「哪裡可能有」,不是完整內容;光看摘要就判「圖譜沒記」以前真的出過錯。"
                  "下結論前先讀全文:lumos show <節點>", file=sys.stderr)
        return 0
    suffix = f"(限 {path_prefix})" if path_prefix else ""
    if not include_code:
        suffix += " [已排除 code block,--code 可含]"
    print(f"\n{total_hits} 處 / {total_files} 篇{suffix}")
    _h = _cjk_nospace_hint(term, total_files, regex,
                           already_advised=(_fb_used and _fb_kind == "chars"))
    if _h and not files_only:
        print(_h, file=sys.stderr)
    if total_files and not files_only:
        print("提醒:命中≠查完——搜尋只告訴你「哪裡可能有」,不是完整內容;光看摘要就判「圖譜沒記」以前真的出過錯。"
              "下結論前先讀全文:lumos show <節點>", file=sys.stderr)
    return 0


def cmd_links(env, rel, reverse=False):
    out_e, in_e = env.edges
    rows = (in_e if reverse else out_e).get(rel, [])
    arrow = "←" if reverse else "→"
    print(f"{rel} {arrow} {len(rows)} 個節點:")
    for d in sorted(rows):
        print(f"  • {d} [{status_of(env, d)}]")
    return 0


def cmd_map(env, rel, depth):
    out_e, _ = env.edges
    seen = {rel}

    def walk(cur, d, prefix):
        if d > depth:
            return
        children = [c for c in sorted(out_e.get(cur, []))]
        for i, c in enumerate(children):
            tail = "└─" if i == len(children) - 1 else "├─"
            mark = " (↺)" if c in seen else ""
            print(f"{prefix}{tail} {c} [{status_of(env, c)}]{mark}")
            if c not in seen:
                seen.add(c)
                walk(c, d + 1, prefix + ("   " if i == len(children) - 1 else "│  "))

    print(f"{rel} [{status_of(env, rel)}]  (depth={depth}, ↺=已出現過)")
    walk(rel, 1, "")
    return 0


# 標準格式: KEY 行前綴 ★INVARIANT★ / ★DEBT★(可帶 (日期) 前綴)。
# 錨定 KEY 行起始 → 排除「散文中提到標記」的誤報(如方法論文件講解標記用法)。
INVARIANT_RE = re.compile(r"^KEY:\s*(?:\([^)]*\)\s*)?★INVARIANT★\s*(.*)")
DEBT_RE = re.compile(r"^KEY:\s*(?:\([^)]*\)\s*)?★DEBT★\s*(.*)")


def extract_contracts(note):
    """從 summary block 的 KEY 行抽標準格式 ★INVARIANT★ / ★DEBT★。回傳 (invariants, debts)。
    只認 KEY 行前綴(標準格式),散文中提及不算 — 否則方法論文件會誤報。"""
    summ = note.fields.get("summary")
    inv, debt = [], []
    if isinstance(summ, str):
        for line in summ.split("\n"):
            line = line.strip()
            mi = INVARIANT_RE.match(line)
            if mi:
                inv.append(mi.group(1).strip())
            md = DEBT_RE.match(line)
            if md:
                debt.append(md.group(1).strip())
    return inv, debt


TEST_REF_RE = re.compile(r"\[test:\s*([^\]]+)\]")
# [audit:模型/日期] — ★INVARIANT★ 合法性經「無對話脈絡的獨立 agent」審計過的留痕。
# 與 [test:] 平行:test 證『有沒有照規則做』,audit 證『這規則該不該是鐵則 / 綁的測試夠不夠格』
# (沒標準答案的判斷不得由提出者本人自評 — maker/checker)。doctor Check T 強制。
AUDIT_REF_RE = re.compile(r"\[audit:\s*([^\]]+)\]")
# [manual:一句怎麼驗] — 計劃 [SN] 條款行「沒有測試可掛、靠人驗」的標記(條款綁測試算進度 S1,2026-09-08)。
# 同家族:跟 test/audit 一起被 INV_TAG_RE 剝掉(誤寫進 ★INVARIANT★ 行也不會污染乾淨宣稱文字);但★合約行不認它★——合約要測試不是人,
# 它只被 clause_bindings 讀。內容太短(<4 字)不算「講了怎麼驗」,視同未標。
MANUAL_REF_RE = re.compile(r"\[manual:\s*([^\]]*)\]")
_MANUAL_MIN_CHARS = 4
# 抽「乾淨宣稱文字」時 test/audit/kill 與 regen 證據指針(src/git)都要剝掉(否則漏進顯示/子字串比對)。
# src|git 擴充(M1 Check J):影響 11 處行號/8 類呼叫點(Check T 乾淨宣稱/contracts/lint 訊息/
# guard 分類·list·trace/scaffold/kill-add/audit)——行為後果:guard 定位對「正文相同只差指針」
# 的合約改多重命中=要求更精確正文(指針非宣稱正文,符合語意非退化);[test:] 抽取不受影響。
INV_TAG_RE = re.compile(r"\[(?:(?:test|audit|kill|src|git):\s*[^\]]+|manual:\s*[^\]]*|keeps)\]")   # keeps=風險低「維持既有行為」裸標籤(雙向門放行_計劃 S15)   # manual 允許空(要能剝掉 [manual: ]),其餘照舊至少一字
KILL_REF_RE = re.compile(r"\[kill:\s*recipes\s*\]")
# 真實可執行測試方法:xUnit 屬性([Fact]/[Theory]/[SkippableFact],含 (Skip=..) 變體)
# + 可選後續屬性(InlineData/MemberData/Trait)→ 存取修飾 → 可選 async → 回傳型別 → 方法名。
# B6 審計:Check T 不能只做子字串比對(會把「散文裡剛好提到的字」當證據);必須認到真方法。
TEST_METHOD_RE = re.compile(
    r"\[(?:Fact|Theory|SkippableFact)\b[^\]]*\]"
    r"(?:\s*\[[^\]]*\])*"
    r"\s*(?:public|internal|protected|private)\s+(?:async\s+)?"
    r"[\w.<>,\[\]\?]+\s+"
    r"([A-Za-z_]\w*)\s*\(",
    re.S)
# 2026-09-08 補 .swift/.dart 與 ESM/CJS 變體:Check Y 的碼庫掃描(build_code_haystack)走這張表,不走
# SYMBOL_PROFILES 的 code_exts——少了 .swift 時 Swift 專案每個符號都被判「查無」(t_checky_swift_and_typescript_profiles 抓到)。
CODE_EXTS_T = {".cs", ".py", ".js", ".ts", ".tsx", ".jsx", ".mjs", ".cjs", ".mts", ".cts", ".vue",
               ".sql", ".kt", ".java", ".go", ".rs", ".swift", ".dart"}
CODE_SKIP_DIRS = {".git", "node_modules", "bin", "obj", "dist", "build",
                  "__pycache__", "publish", "vendor", ".vs", ".idea"}

# Kotlin/JUnit 測試方法:@Test/@ParameterizedTest 等註解 → (中間不跨 `{`,即不越過方法體)
# → fun 方法名(允許反引號帶空白的 Kotlin 測試名)。去註解後比對(同 C#)。
# ★中段有長度上限★(2026-09-12 代碼審 r1 邊界席實測):整支檔一個 `{` 都沒有時,每個配不到的
# 註解都會掃到檔尾,兩萬個註解要 11 秒,而這支掃描每次健檢與推送前都跑。註解到方法簽章之間
# 正常不會超過 600 字元(註解＋修飾詞),超過就是這支檔本來就不長那樣。
KOTLIN_TEST_RE = re.compile(
    r"@(?:Test|ParameterizedTest|RepeatedTest)\b[^{]{0,600}?\bfun\s+(`[^`]+`|[A-Za-z_]\w*)\s*\(",
    re.S)

# Java/JUnit 測試方法:註解 → void 方法名。中段不能照抄 Kotlin 那條的 `[^{]*?`——Java 的參數化
# 註解自己帶大括號(`@ValueSource(ints = {1, 2, 3})`),那樣寫會在那裡斷掉整支漏掉。
# ★2026-09-12 代碼審 r1 五席同報,中段從無界 `.*?` 改成下面這個有界、括號感知的寫法★:
#   - 允許:不是 `;{}()` 的任何字元(修飾詞、其他註解的名字、換行)
#   - 允許:一整組小括號(可含一層巢狀),用來吃 `@ValueSource(ints = {1,2,3})` 與 `@DisplayName("…")`
#   - 不允許:跨過 `;` 或方法體的 `{`/`}` ——所以 @Test 標在非 void 方法上、或 @Test 被當成
#     另一個註解型別的組成部分時,不會再抓到後面某個無關方法的名字當成「真測試」
#   - 上限 600:註解配不到方法時不會一路掃到檔尾(席位實測無界版本 1MB 的檔要 43 秒)
# 方法名允許非 ASCII 開頭(Java 識別字本來就允許中文;`[^\W\d]` = 是字母或底線、不是數字)。
# 已知邊界:跨行的文字區塊(text block)內容不會被當字串剝掉,裡面若剛好有 `void 某某(` 仍可能誤配。
JAVA_TEST_RE = re.compile(
    r"@(?:Test|ParameterizedTest|RepeatedTest)\b"
    r"(?:[^;{}()]|\((?:[^()]|\([^()]*\))*\)){0,600}?"
    r"\bvoid\s+([^\W\d]\w*)\s*\(",
    re.S)

# Maestro(Android E2E)flow 綁 name: 欄位。行尾 \s*$ 錨:多字 name(含空白)NO MATCH
# → 與 playwright 對稱、不製造假陽性(識別字安全的 name 才可綁,設計慣例)。
MAESTRO_NAME_RE = re.compile(r"(?m)^name:\s*[\"']?([A-Za-z_]\w*)[\"']?\s*$")
# file_must_match:只認含 appId: 行首的檔(真 Maestro flow),濾掉 CI 等其他 yaml。
MAESTRO_FLOW_RE = re.compile(r"(?m)^appId:")
# Playwright(web E2E):test('id')/test.describe('id')。capture 識別字後需緊接引號,
# 故含空白 title(如 'should show menu')NO MATCH(設計上不可綁)。
PLAYWRIGHT_TEST_RE = re.compile(r"\btest(?:\.describe)?\(\s*[\"']([A-Za-z_]\w*)[\"']")

# Dart/Flutter:test('id')/testWidgets('id') 字串名錨——識別字名才可綁(含空白 NO MATCH,
# 設計上不可綁,同 playwright);Dart 有 // 與 /*..*/ 註解故 comment_strip 走 c-style。
DART_TEST_RE = re.compile(r"\btest(?:Widgets)?\(\s*[\"']([A-Za-z_]\w*)[\"']")

# Swift(2026-09-08,iOS 補棧):兩代框架並存——XCTest 靠命名慣例(方法名必須 test 開頭,runner 才收),
# Swift Testing 靠 @Test 巨集(任何名字、任何位置;@Test("顯示名") 也算)。單一 capture group:
# @Test 分支收任意識別字,裸 func 分支用 lookahead 限定 test 前綴。修飾詞(private/static/…)可夾在中間。
SWIFT_TEST_RE = re.compile(
    r"(?:@Test\b(?:\([^)]*\))?\s*(?:(?:public|private|internal|fileprivate|static|final|mutating|override|nonisolated)\s+)*func\s+"
    r"|\bfunc\s+(?=test))([A-Za-z_]\w*)\s*\(")

# Jest / Vitest(2026-09-08,Node 補棧):test('id')/it('id')/describe('id'),含 .only/.skip/.concurrent
# 修飾;識別字名才可綁(含空白 NO MATCH,同 playwright/dart 設計)。.each 帶樣板字串不收。
JEST_TEST_RE = re.compile(r"\b(?:test|it|describe)(?:\.(?:only|skip|concurrent))?\(\s*[\"']([A-Za-z_]\w*)[\"']")

# Python:行首錨(欄位 0)——排除巢狀/類內/縮排 def 與被註解的 # def(對齊「module-global 才被
# runner 收集」語意;無框架註冊標記可錨=誠實天花板,見 Projects/CheckT-Python-profile_計劃)。
PYTHON_TEST_RE = re.compile(r"(?m)^def ((?:t|test)_[A-Za-z0-9_]+)\s*\(")

# ── 測試棧 profile(語言可插拔;P5 — Android/Kotlin 等也能用 guard + Check T)──
# 每個 profile:exts(discover 掃哪些副檔名)/ method_re(group(1)=方法名)/
# scaffold_ext(產 stub 副檔名)/ dir_mode(suffix=頂層目錄 endswith / rglob=遞迴找目錄名)/
# dirs[gtype]=(include, exclude)。預設 csharp-xunit(向後相容)。
# ── Check Y 的兩層 profile(2026-08-12 通用性修正)──
# 原始版本把「C# 命名慣例」與「中文否定詞」寫死在檢查裡 → Enzo 質疑:換一份圖譜/語言棧
# 就靜靜失效且不會報錯。歷史重放實測佐證這個風險是真的:當時取樣腳本因中文檔名跳脫,
# ★把 25/30 個節點濾掉、結論從「2% 持續三個月」變成「0% 完全沒問題」★——
# 表面形狀的假設一旦沒說清楚,錯得無聲無息。故抽成 profile,跟 TEST_PROFILES 同一套做法。
SYMBOL_PROFILES = {
    # shape_re:符號整體形狀;suffixes:視為「方法」的後綴(空 tuple=不靠後綴);
    # dotted_ok:帶點(Class.Method)是否也算候選
    "csharp": {
        "shape_re": r"^[A-Z][A-Za-z]*(?:\.[A-Za-z][A-Za-z]*)*$",
        "suffixes": ("Async",), "dotted_ok": True,
        "code_exts": (".cs", ".vue", ".js", ".sql", ".ps1"),
    },
    "kotlin": {
        "shape_re": r"^[A-Z][A-Za-z]*(?:\.[a-zA-Z][A-Za-z]*)*$",
        "suffixes": (), "dotted_ok": True,
        "code_exts": (".kt", ".kts", ".java"),
    },
    "python": {   # snake_case 方法 → 形狀規則完全不同,證明 profile 化是必要的
        "shape_re": r"^[a-z_][a-z0-9_]*(?:\.[a-z_][a-z0-9_]*)*$",
        "suffixes": (), "dotted_ok": True,
        "code_exts": (".py",),
    },
    # Swift / TypeScript(2026-09-08,iOS 與 Node 補棧;★尚無真專案跑過★):型別 PascalCase、方法
    # camelCase,跟 Kotlin 同形狀,所以借同一條 shape_re;裸 camelCase 自由函式(fetchUser)不進候選
    # =刻意的保守天花板(進了會把散文裡的英文單字當符號,噪音比漏檢貴)。
    "swift": {
        "shape_re": r"^[A-Z][A-Za-z]*(?:\.[a-zA-Z][A-Za-z]*)*$",
        "suffixes": (), "dotted_ok": True,
        "code_exts": (".swift",),
    },
    "typescript": {
        "shape_re": r"^[A-Z][A-Za-z]*(?:\.[a-zA-Z][A-Za-z]*)*$",
        "suffixes": (), "dotted_ok": True,
        "code_exts": (".ts", ".tsx", ".mts", ".cts", ".js", ".mjs", ".cjs"),
    },
    # Dart / Flutter(2026-09-13;★尚無真專案跑過★):型別 PascalCase、方法 camelCase,大致跟
    # Kotlin 同形狀,★但不能直接借★——Flutter 的 State 類幾乎都是私有的底線開頭(_MyPageState),
    # 借 Kotlin 那條會讓筆記裡最常被點名的那種類別一律「查無」。所以只多開一個可選的前置底線。
    "dart": {
        "shape_re": r"^_?[A-Z][A-Za-z0-9]*(?:\.[a-zA-Z_][A-Za-z0-9]*)*$",
        "suffixes": (), "dotted_ok": True,
        "code_exts": (".dart",),
    },
}
# 否定語境詞表:節點「正確地記錄某符號已不存在」時不該被報錯。
# ★這是語系相依的★——換英文圖譜要換 lexicon,不是改檢查邏輯。
NEG_LEXICONS = {
    "zh": ("零命中", "已移除", "不存在", "查無", "已刪", "從未", "已退役", "移除",
           "無此", "原記", "舊名", "改名", "已改", "棄用", "不使用", "廢棄", "停用",
           "未使用", "dead", "removed", "deleted", "no longer", "renamed",
           "deprecated", "unused", "obsolete"),
    "en": ("removed", "deleted", "no longer", "renamed", "deprecated", "unused",
           "obsolete", "does not exist", "not found", "dead code", "former",
           "used to be", "was replaced"),
}


def load_symbol_profile(repo_root):
    """讀 <repo>/.lumos/config.json 的 symbol_profile / neg_lexicon(預設 csharp + zh)。
    沿用 load_test_profile 的形狀:未知名稱→警告並回預設,壞 JSON→不 crash。"""
    import json
    prof = dict(SYMBOL_PROFILES["csharp"])
    neg = NEG_LEXICONS["zh"]
    cfg_path = repo_root / ".lumos" / "config.json"
    if not cfg_path.exists():
        return prof, neg
    try:
        cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"⚠ .lumos/config.json 解析失敗,Check Y 用 csharp+zh 預設: {e}", file=sys.stderr)
        return prof, neg
    name = cfg.get("symbol_profile") or "csharp"
    if name in SYMBOL_PROFILES:
        prof = dict(SYMBOL_PROFILES[name])
    elif name != "csharp":
        print(f"⚠ 未知 symbol_profile '{name}'(有: {', '.join(SYMBOL_PROFILES)}),用 csharp",
              file=sys.stderr)
    lang = cfg.get("neg_lexicon") or "zh"
    if lang in NEG_LEXICONS:
        neg = NEG_LEXICONS[lang]
    elif lang != "zh":
        print(f"⚠ 未知 neg_lexicon '{lang}'(有: {', '.join(NEG_LEXICONS)}),用 zh", file=sys.stderr)
    ov = cfg.get("symbol")           # 欄位級逃生口(同 test 的 inline override)
    if isinstance(ov, dict):
        for k in ("shape_re", "suffixes", "dotted_ok", "code_exts"):
            if k in ov:
                prof[k] = tuple(ov[k]) if isinstance(ov[k], list) else ov[k]
    extra = cfg.get("neg_extra")     # 專案自有說法(例:「已封存」「凍結」)
    if isinstance(extra, list):
        neg = tuple(neg) + tuple(str(x) for x in extra)
    return prof, neg


