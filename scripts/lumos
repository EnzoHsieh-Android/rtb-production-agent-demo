  .chip.off{opacity:.38}
  #cy{position:fixed;top:64px;left:0;right:0;bottom:0;z-index:1}
  /* 常駐節點標籤:HTML 疊層,逐幀貼到節點螢幕座標上(無 WebGL 文字依賴) */
