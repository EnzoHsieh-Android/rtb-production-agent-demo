def _html_model(env):
    """蒐集語意模型給 HTML 視圖:nodes(含 type/status/合約/stale/raw)+ typed edges。"""
    out_e, in_e = env.edges
    nodes, edges, seen = [], [], set()
    for rel, n in env.notes.items():
        inv, debt = extract_contracts(n)
        summ = n.fields.get("summary")
        summ = summ if isinstance(summ, str) else ""
        status = status_of(env, rel)
        ntype = n.fields.get("type")
        ntype = ntype if isinstance(ntype, str) and ntype else rel.split("/")[0].lower()
        try:
            raw = (env.vault / rel).read_text(encoding="utf-8-sig")
        except Exception:
            raw = ""
        _dt = n.fields.get("date") or n.fields.get("created")
        nodes.append({
            "id": rel, "label": n.stem, "rel": rel, "type": ntype, "status": status,
            "folder": rel.split("/")[0], "inv": inv, "debt": debt,
            "date": str(_dt) if _dt else "",
            "indeg": len(set(in_e.get(rel, []))),
            "summary": [l.strip() for l in summ.split("\n") if l.strip()][:6],
            "raw": raw,
        })
    # typed edges: plan_refs / verified_by / link
    for rel, n in env.notes.items():
        plan = {env.resolve(link_target(x)) for x in as_list(n.fields.get("plan_refs"))}
        verify = {env.resolve(link_target(x)) for x in as_list(n.fields.get("verified_by"))}
        plan.discard(None); verify.discard(None)
        for d in set(out_e.get(rel, [])):
            kind = "plan" if d in plan else "verify" if d in verify else "link"
            key = (rel, d, kind)
            if key not in seen:
                seen.add(key)
                edges.append({"source": rel, "target": d, "kind": kind})
    return {"nodes": nodes, "edges": edges}


_VIZ_LIBS = {
    "3d-force-graph": ("https://cdn.jsdelivr.net/npm/3d-force-graph@1.80.0",
                       '<script src="https://cdn.jsdelivr.net/npm/3d-force-graph@1.80.0"></script>'),
    "marked": ("https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js",
               '<script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>'),
}
_FONT_LINKS = ('<link rel="preconnect" href="https://fonts.googleapis.com">\n'
               '<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>\n'
               '<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">')


def _fetch_text(url, cache):
    """下載文字資源並快取(scripts/vendor/)。離線重複 export 不再抓。
    用 curl(走系統憑證;macOS python urllib 常無 cert store 致 SSL verify 失敗)。"""
    import subprocess
    if cache.exists():
        return cache.read_text(encoding="utf-8")
    cache.parent.mkdir(parents=True, exist_ok=True)
    txt = subprocess.run(["curl", "-fsSL", url], capture_output=True, text=True,
                         timeout=60, check=True).stdout
    if not txt:
        raise RuntimeError("空回應")
    cache.write_text(txt, encoding="utf-8")
    return txt


def cmd_export_html(env, out_path, standalone=False):
    import json
    import datetime
    model = _html_model(env)
    # </script> 在嵌入 JSON 裡會提早關閉 <script> 標籤破壞整頁 → 轉義 </(標準作法)
    data = json.dumps(model, ensure_ascii=False).replace("</", "<\\/")
    stamp = datetime.date.today().isoformat()
    html = _HTML_TEMPLATE.replace("__DATA__", data).replace("__STAMP__", stamp) \
                         .replace("__VAULT__", env.vault.name) \
                         .replace("__NC__", str(len(model["nodes"]))) \
                         .replace("__EC__", str(len(model["edges"])))
    if standalone:
        # inline cytoscape/marked(去 CDN,防火牆/離線可開);字體退化系統字(移除 google link)
        vendor = Path(__file__).resolve().parent / "vendor"
        for name, (url, tag) in _VIZ_LIBS.items():
            try:
                src = _fetch_text(url, vendor / f"{name}.min.js").replace("</script", "<\\/script")
            except Exception as e:
                print(f"擋下:--standalone 模式要先下載 {name},這台機器至少要連一次網,現在抓不到: {e}", file=sys.stderr)
                return 2
            html = html.replace(tag, f"<script>{src}</script>")
        html = html.replace(_FONT_LINKS, "<!-- standalone: 字體退化系統字(無外部 CDN) -->")
    Path(out_path).write_text(html, encoding="utf-8")
    mode = "standalone(自包含/離線可開)" if standalone else "CDN"
    print(f"✓ export html [{mode}]: {out_path}  ({len(model['nodes'])} 節點 / {len(model['edges'])} 邊)")
    return 0


# ═══════════════════════ 階段三: 寫側 T1(行級手術) ═══════════════════════

SCALAR_KEYS = {"status", "updated", "created", "type", "self_audit", "signed_off", "regen", "pitfall_ask", "pitfall_source", "about_code_stamp", "responsibility"}  # pitfall_* 2026-08-09 已知坑策展庫;about_code_stamp 2026-08-23(語意欄位基礎,計劃:固定席扇出降權)
LIST_KEYS = {"verified_by", "plan_refs", "related", "tags", "aliases", "pitfall_when", "core_refs", "about_code", "lands_in"}   # aliases 2026-08-05;pitfall_when 2026-08-09(已知坑策展庫,content-trigger);core_refs 2026-08-11(升格加指針/降格拆指針,兩向都要 T1;值是純路徑非 wikilink——lumos-core-knowledge skill 明令禁跨 vault wikilink)
LINK_KEYS = ("verified_by", "plan_refs", "related", "core_refs")  # S2「純連結欄位」子集(≠LIST_KEYS:那是 append 白名單,pitfall_when=content-trigger 不算連結);spec=Projects/code側刪除傳播守衛_計劃
DATE_KEYS = {"updated", "created", "date", "decided", "ended"}
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def fm_structure(fm_lines):
    """回傳 ordered [(key, start, end, kind)]，kind ∈ scalar/list/block。
    end = 該 key 區塊最後一行的 index(含)。"""
    out = []
    i, n = 0, len(fm_lines)
    while i < n:
        m = TOP_KEY_RE.match(fm_lines[i])
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        start = i
        if val in ("|", "|-", ">", ">-"):
            i += 1
            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
                i += 1
            out.append((key, start, i - 1, "block"))
        elif val == "":
            # 消費所有縮排行(含 list item 的 sub-mapping,如 decisions 的 content/decided),
            # 與 parse_frontmatter 一致 → fm_structure 算出的 end 涵蓋整個區塊(BUG-5 對齊)
            i += 1
            while i < n and (fm_lines[i].startswith(" ") or not fm_lines[i].strip()):
                i += 1
            out.append((key, start, i - 1, "list"))
        elif val == "[]":
            # YAML 合法空清單(範本 `aliases: []` 就是這樣寫)。2026-08-23 前被判成 scalar →
            # 從範本建的節點第一次 append 必敗,全庫 15 篇在此狀態。★只認空的 `[]`★,
            # 非空 inline list(`[a, b]`)仍當 scalar——那要真的解析逗號與引號,不在本次,
            # 且 append 遇到它會被擋(不會壞),可接受。
            out.append((key, start, start, "list"))
            i += 1
        else:
            out.append((key, start, start, "scalar"))
            i += 1
    return out


def fmt_scalar(key, value):
    """純量值格式化。日期 bare(不加引號避污染指紋);含 ': ' 或特殊字元才引號。"""
    v = value.strip()
    if key in DATE_KEYS:
        if not DATE_RE.match(v):
            raise ValueError(f"{key} 要寫成 年-月-日(例如 2026-08-22),你給的是 {v}")
        return v  # bare,絕不加引號
    # YAML 型別劫持守衛: true/false/null/yes/no/~ 與純數字當 status 會被解析成 bool/num/null
    if v.lower() in ("true", "false", "null", "yes", "no", "on", "off", "~") or \
       re.fullmatch(r"-?\d+(\.\d+)?", v):
        return '"' + v + '"'
    if re.search(r":\s|^[\[\{>|*&!#@`]|^\s|\s$", v) or v == "":
        return '"' + v.replace('"', '\\"') + '"'
    return v


def fmt_list_item(value):
    """list 項格式化。wikilink / 含特殊字元 → 引號(鐵則1 安全:一項一行)。"""
    v = value.strip()
    if v.startswith("[[") or re.search(r":\s|^[\[\{]", v):
        return '"' + v.replace('"', '\\"') + '"'
    return v


def edit_fm_scalar(fm_lines, key, value):
    fm = list(fm_lines)
    formatted = fmt_scalar(key, value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct:
        s, e, kind = struct[key]
        if kind != "scalar":
            raise ValueError(f"{key} 是{kind}型欄位,set 只能改單一值的欄位(清單用 lumos append;決策用 lumos decision-add)")
        fm[s] = f"{key}: {formatted}"
    else:
        # 插在開頭純量區之後(第一個 list/block key 之前,否則末尾)
        ins = len(fm)
        for k, s, e, kind in fm_structure(fm):
            if kind in ("list", "block"):
                ins = s
                break
        fm.insert(ins, f"{key}: {formatted}")
    return fm


def edit_fm_sync_status_tag(fm_lines, status):
    """set status 的反正規化同步:tags 內既有 status/* 項就地改寫為 status/<新值>。
    無 tags/無 status/* 標籤則不動(純同步不發明;繞過本路徑的寫入由 lint/doctor
    漂移守衛兜底)。回傳 (new_fm, tags 內有無 status/* 標籤)。"""
    fm = list(fm_lines)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if "tags" not in struct or struct["tags"][2] != "list":
        return fm, False
    s, e, _kind = struct["tags"]
    found = False
    for i in range(s + 1, e + 1):
        m = re.match(r"^(\s*-\s*)status/\S+\s*$", fm[i])
        if m:
            fm[i] = f"{m.group(1)}status/{status}"
            found = True
    return fm, found


def _list_scalar_value(fm, key, line_idx):
    """清單欄位的單一值寫法(`key: 值`)讀出那一個值(去引號,空的回 "")。

    ★看起來是同一行清單就丟 ValueError★:工具不解析同一行裡的逗號(fm_structure 與
    parse_frontmatter 都把它當成一個值),照單一值轉會把整串 "[a, b]" 寫成一項。
    判準看「去引號後的值本身」,不列舉寫法(2026-09-10 代碼審 r2:只比對原始字串時,
    整串加引號、逗號前後多打空白都繞得過):以 [ 或 { 開頭(單一連結 [[X]] 除外),
    或一個值裡有兩個以上連結開頭。加了引號的空清單 "[]" 跟讀的一側一樣當成空的。"""
    m = TOP_KEY_RE.match(fm[line_idx])
    val = m.group(2).strip() if m else ""
    sval = strip_quotes(val)
    t = sval.strip()   # 引號裡面前面多一個空白也要認得(第三輪外家否決席:" [a, b]" 繞過)
    if t == "[]":
        return ""
    # 單一連結要「整個值恰好是一個連結」才豁免(第三輪外家找洞席:[[Systems/A], Systems/B] 開頭像連結就被放行)
    if (t.startswith(("[", "{")) and not _SINGLE_WIKILINK_RE.fullmatch(t)) or _multi_link_value(t):
        raise ValueError(f"{key} 寫成同一行的清單({val}),工具不解析這種寫法,"
                         f"硬加會把整串當成一項寫壞,檔案沒動。這種寫法目前只能手動改成一行一項"
                         f"({key}: 換行後每項一行「  - 值」),改完再重跑")
    return t   # 去掉前後空白:引號裡只有空白就是空的(第四輪正確性席:原本會留下一筆空白垃圾項)


def _list_key_scalar_to_list(fm, key, line_idx):
    """清單欄位被寫成單一值(`about_code: src/x.py`)時,改寫成一項的清單再給 append/remove 用。

    ★讀的一側本來就把單一值當成一項的清單★(as_list),只有寫的一側不認得——
    於是一篇筆記一旦是單一值寫法,append 說它不是清單、set 又不收清單欄位,
    沒有任何指令改得動(2026-09-10 代碼審 r1)。空值(`key:`)當成空清單;
    同一行的清單寫法擋下不轉(見 _list_scalar_value)。"""
    sval = _list_scalar_value(fm, key, line_idx)
    m = TOP_KEY_RE.match(fm[line_idx])
    raw = m.group(2).strip() if m else ""
    fm = list(fm)
    fm[line_idx] = f"{key}:"
    if sval:
        # ★原本那一項原封不動★:有引號就照原樣搬,不去掉再重新加(第三輪外家找洞席:'[[Systems/API "v2"]]'
        # 被重新加成帶反斜線的雙引號,讀的一側不解反斜線,讀回來就不是原本那篇了)
        quoted = len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'"
        fm.insert(line_idx + 1, f"  - {raw if quoted else fmt_list_item(sval)}")
    return fm


def edit_fm_append(fm_lines, key, value):
    fm = list(fm_lines)
    item = fmt_list_item(value)
    tgt = link_target(value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct and struct[key][2] == "scalar" and key in LIST_KEYS:
        cur = _list_scalar_value(fm, key, struct[key][0])
        if cur and link_target(cur) == tgt:
            return fm  # 已經有了:原樣回傳,不改寫成清單格式(r2)
        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
        struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct:
        s, e, kind = struct[key]
        if kind != "list":
            raise ValueError(f"{key} 是{kind}型欄位,append 只能加進清單型欄位")
        # `key: []` 空清單 → 改寫成多行格式的開頭 `key:`,後面照常插第一項
        if s == e and TOP_KEY_RE.match(fm[s]) and TOP_KEY_RE.match(fm[s]).group(2).strip() == "[]":
            fm[s] = f"{key}:"
        # dedup: 精確 full-target 比對(保留路徑;非子字串、非 basename-only)
        for j in range(s + 1, e + 1):
            existing = fm[j].strip()
            if existing.startswith("-") and link_target(existing[1:]) == tgt:
                return fm  # 已存在,no-op
        # 偵測現有項縮排,否則預設 2 空格
        indent = "  "
        for j in range(s + 1, e + 1):
            if fm[j].lstrip().startswith("-"):
                indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
                break
        # 插在最後一個非空行之後(避開區塊尾部空行,免在 list 中插出空行)
        last = e
        while last > s and not fm[last].strip():
            last -= 1
        fm.insert(last + 1, f"{indent}- {item}")
    else:
        ins = len(fm)
        fm.insert(ins, key + ":")
        fm.insert(ins + 1, f"  - {item}")
    return fm


def edit_fm_remove(fm_lines, key, value):
    """T1 list 項移除(append 的逆操作,同一套 link_target 精確比對)。

    回傳 (new_fm, removed_count)。removed_count==0 代表沒命中(呼叫端該報錯,
    不可靜默 no-op——打錯字卻回成功是本函式最該防的失敗)。
    命中多筆(歷史重複項)一次清乾淨。清完若 list 空了,連 key 行一起移除
    (留 `key:` 裸鍵會被 YAML 解成 null,doctor/lint 對「有鍵無值」的判讀比沒鍵更糟)。
    比對用 link_target():`[[A]]` / `[[Folder/A|alias]]` / 純路徑 `x/y.md` 一致處理,
    保留路徑不做 basename-only(同 append dedup,避免 Systems/X 誤刪 Verification/X)。"""
    fm = list(fm_lines)
    tgt = link_target(value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key not in struct:
        raise ValueError(f"這篇筆記沒有 {key} 這個欄位")
    if struct[key][2] == "scalar" and key in LIST_KEYS:
        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
        struct = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
    s, e, kind = struct[key]
    if kind != "list":
        raise ValueError(f"{key} 是{kind}型欄位,remove 只能從清單型欄位拿掉項目")
    hits = []
    for j in range(s + 1, e + 1):
        existing = fm[j].strip()
        if existing.startswith("-") and link_target(existing[1:]) == tgt:
            hits.append(j)
    if not hits:
        return fm, 0
    for j in reversed(hits):
        del fm[j]
    # 清完是否還有存活項?沒有就把 key 行也拿掉(空 list 不留裸鍵)
    struct2 = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
    if key in struct2:
        s2, e2, _ = struct2[key]
        if not any(fm[j].strip().startswith("-") for j in range(s2 + 1, e2 + 1)):
            del fm[s2:e2 + 1]
    return fm, len(hits)


def decisions_items(fm_lines):
    """surgical 定位 decisions[] 的每個項目行範圍(不重序列化,延伸 T1 到巢狀)。
    回傳 (block_start, block_end, [(item_start, item_end)], item_indent, sub_indent)
    或 None(無 decisions)。item_end 含,已去尾部空行。處理項目內含 nested 子清單。"""
    block = None
    for k, s, e, kind in fm_structure(fm_lines):
        if k == "decisions" and kind == "list":
            block = (s, e)
            break
    if block is None:
        return None
    s, e = block
    item_indent = None
    starts = []
    for i in range(s + 1, e + 1):
        ln = fm_lines[i]
        if not ln.strip():
            continue
        m = re.match(r"^(\s*)-\s", ln)
        if m:
            ind = len(m.group(1))
            if item_indent is None:
                item_indent = ind
            if ind == item_indent:  # 只認最淺層 dash(子清單的 dash 更深,不算項目)
                starts.append(i)
    items = []
    for idx, st in enumerate(starts):
        en = (starts[idx + 1] - 1) if idx + 1 < len(starts) else e
        while en > st and not fm_lines[en].strip():
            en -= 1
        items.append((st, en))
    sub_indent = (item_indent + 2) if item_indent is not None else 4
    return s, e, items, (item_indent or 2), sub_indent


def load_raw_for_edit(path: Path):
    """讀 raw,拒 BOM/CRLF(本 vault 慣例 LF/no-BOM,異常不靜默正規化)。
    回傳 (all_lines, fm_start, fm_end_exclusive)。fm = all_lines[1:fm_end]。"""
    raw = path.read_bytes()
    if raw.startswith(b"\xef\xbb\xbf"):
        raise ValueError("這個檔開頭帶 BOM 標記,工具不寫這種檔;先把檔案存成不帶 BOM 的 UTF-8")
    if b"\r\n" in raw:
        raise ValueError("這個檔的換行是 Windows 式(CRLF),工具只寫 Unix 式(LF)。Windows 上常是 git autocrlf 造成的;"
                         "修法:確認 .gitattributes 有套用(圖譜目錄標 eol=lf)再跑 git add --renormalize .,"
                         "或單檔跑 dos2unix。工具不會偷偷幫你改行尾。")
    lines = raw.decode("utf-8").split("\n")
    if not lines or lines[0].strip() != "---":
        raise ValueError("這篇筆記開頭沒有欄位區塊(---),沒辦法改欄位")
    fm_end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            fm_end = i
            break
    if fm_end is None:
        raise ValueError("開頭欄位區塊沒收尾(有起頭的 --- 沒有結尾的 ---),先補上")
    return lines, 1, fm_end


def _write_lf(path: Path, text: str):
    """寫 UTF-8 / LF / no-BOM,平台無關(不靠 text mode)。vault 唯一寫入原語。
    用 write_bytes:write_text(newline=) 要 Python 3.10,違反本專案 ≥3.9。
    [2026-08-05 單席快審 F2] tmp→os.replace 原子替換:防半寫毀檔(CLAUDE.md reinject 等
    整檔覆寫消費者)。read-modify-write 的併發:set/append/remove 由呼叫端上鎖(_vault_write_lock),
    其他寫入指令仍是 last-write-wins(單機 CLI,accepted)。
    ★暫存檔名每次都不一樣★(2026-09-10 代碼審 r3 併發資源席:原本同一篇筆記大家用同一個固定暫存檔名,
    兩個程序同時寫就互搶,實測六個同時跑六個都噴 FileNotFoundError)——跟 mkstemp 同一種做法(獨佔建一個唯一名),
    但權限給 0o666、讓它跟一般建檔一樣受 umask 管;原檔在就照原檔的權限(例如 +x)。
    ★不用 mkstemp 再改權限★(第四輪併發資源席):mkstemp 建成 0600,要調回一般樣子只能先讀整個程序的 umask
    (設成 0 再設回來),那一瞬間別的執行緒建的檔會拿到錯的權限。"""
    import os as _os, shutil as _sh, uuid as _uuid
    tmp = str(path.with_name(f"{path.name}.{_os.getpid()}-{_uuid.uuid4().hex[:8]}.tmp-wlf"))
    fd = _os.open(tmp, _os.O_WRONLY | _os.O_CREAT | _os.O_EXCL, 0o666)   # 權限照一般建檔
    try:
        with _os.fdopen(fd, "wb") as fh:
            fh.write(text.encode("utf-8"))
        if path.exists():
            _sh.copymode(path, tmp)
        _os.replace(tmp, path)
    except BaseException:
        try:
            _os.unlink(tmp)
        except OSError:
            pass
        raise


def atomic_write_verify(path: Path, new_lines, key, expected_check):
    """寫 tmp → re-parse 自驗 + lint 無新指紋 → atomic rename。任一步敗:tmp 丟棄,原檔不動。"""
    orig_fm = load_raw_for_edit(path)
    orig_lint = set(parse_frontmatter(orig_fm[0][1:orig_fm[2]])[2])
    text = "\n".join(new_lines)
    new_fm_lines = new_lines[1:]
    for i in range(1, len(new_lines)):
        if new_lines[i].strip() == "---":
            new_fm_lines = new_lines[1:i]
            break
    fields, _, new_lint = parse_frontmatter(new_fm_lines)
    if not expected_check(fields):
        raise RuntimeError(f"寫完讀回來檢查,{key} 的值跟要寫的不一樣,這次寫入不算成功")
    introduced = set(new_lint) - orig_lint
    if introduced:
        raise RuntimeError("寫完讀回來檢查,發現欄位區塊多了會讀錯的寫法,這次寫入不算成功:" + "; ".join(sorted(introduced)))
    _write_lf(path, text)   # 本身就是「寫暫存檔→原子換名」;原本外面再包一層固定檔名的暫存檔,兩層固定名互搶(r3)


_VAULT_LOCK_STALE_SEC = 30   # 一次筆記寫入不到一秒;鎖檔 30 秒還沒放掉,當成拿鎖的程序死了、原子接手
_VAULT_LOCK_HELD = {}         # 這個程序已經拿著的寫入鎖 → 巢狀呼叫直接過(可重入),不自己卡自己


_VAULT_LOCK_WARNED = {}        # 鎖的位置換過一次就別再唸(同一個程序內)


def _vault_lock_where(vault):
    """這個筆記庫的寫入鎖該放哪、位置有沒有不對勁。回 (鎖檔路徑, 不對勁的原因|None)。

    ★獨立一支,不是巢狀函式★(2026-09-16 推送前的新增告警閘擋下:算進外層之後超過複雜度
    上限)。分開之後還多買到一件事:「決定位置」與「拿鎖」各自看得完,代碼審 r2 抓到的那個坑
    (位置算在可重入判斷後面、巢狀呼叫卡死自己)變成結構上不可能再犯。

    ★鎖檔的資料夾要過信任檢查★(同族掃描):放的位置是照派工鏡頭快取的先例抄的,但
    ★只抄了放哪裡、沒抄那道檢查★。★不可信就換個地方鎖,不是乾脆不鎖★(代碼審 r1 外家席):
    不鎖等於把一個安全問題換成一個正確性問題——原本鎖檔雖然落在不可信的地方、鎖本身仍然有效;
    不鎖之後兩個程序就能同時做讀—改—寫,而且觸發條件不需要攻擊者,把快取目錄搬到別的磁碟
    就會踩到。退路選筆記庫自己:要寫的就是它、使用者一定擁有它,兩個程序算出來的路徑一樣,
    互斥照樣成立。

    ★沒擋到的殘留(照實寫,別當成全防住了)★:檢查排在建資料夾之後,連結指到的地方仍會多出
    一個空資料夾——鄰居那幾處同樣順序,是共用寫法本來就有的缺口,不是這處特有;真正危險的
    動作(寫鎖檔、改權限、刪目錄)都在檢查之後。
    """
    import hashlib
    key = hashlib.sha256(os.path.realpath(str(vault)).encode("utf-8")).hexdigest()[:32]
    primary = Path.home() / ".cache" / "lumos" / "vault-lock" / f"{key}.lock"
    # ★逐層建、逐層檢查★(2026-09-16):原本一次 mkdir 出整條路徑再檢查,
    # 檢查不過時連結指到的地方已經被建出一層空資料夾了。
    if not _mkdir_trusted_under_home(".cache", "lumos", "vault-lock"):
        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
    if not _trusted_private_dir(primary.parent, ".cache", "lumos", "vault-lock"):
        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
    return primary, None


def _vault_lock_say(lock, why):
    """鎖的位置不對勁時講一次(呼叫端負責「同一個程序只講一次」)。"""
    # ★只剩一種原因★(2026-09-16 代碼審 資安席):改用逐層建之後,「決定位置」那支
    # 不再區分「建不起來」與「不可信」——兩種都退到同一條退路,所以原本那個分支是死碼,
    # 而且把兩種原因混成同一句話會讓人去檢查一條其實沒有連結問題的路徑。
    print(f"提醒:放寫入鎖的資料夾用不了({why[1]})——它自己或上層被換成了"
          "指向別處的連結、或別人也寫得進去。", file=sys.stderr)
    print("  為什麼在意:鎖是用來擋「兩個程序同時改同一個筆記庫、後寫的蓋掉先寫的」;"
          f"這次改把鎖放在筆記庫自己裡面({lock.name}),功能不變,只是位置換了。",
          file=sys.stderr)
    print("  要回到原本的位置,先看那條路徑是誰建的:", file=sys.stderr)
    print(f"    ls -ld {why[1]} {Path(why[1]).parent}", file=sys.stderr)


def _vault_write_lock(vault):
    """同一個筆記庫的 set/append/remove 一次只讓一個程序做「讀—改—寫」(2026-09-10 代碼審 r3 併發資源席:
    沒有鎖時,回報成功的項目會被同時跑的另一個程序蓋掉)。

    ★用專案既有的鎖檔做法★(_excl_lock_try:獨佔建鎖檔、寫程序編號、過期用換名原子接手;第四輪架構席:
    第三輪另開了一套 flock,是專案裡第二種鎖),搶不到就每 0.05 秒再試、最多 60 秒(RuntimeError)。
    鎖檔放 ~/.cache/lumos/vault-lock/(照 dispatch-lens 快取的先例:不放共用暫存目錄——路徑可預測、會被別的使用者先佔)。
    同一個程序巢狀拿同一把鎖直接過(第四輪:原本自己卡自己 60 秒,訊息還說「別的程序在寫」);
    鎖的資料夾建不起來就照寫,但會講一聲(第四輪:原本默默不上鎖)。"""
    import contextlib, time as _t

    @contextlib.contextmanager
    def _cm():
        # ★「鎖放哪」必須在「這把鎖是不是自己已經拿著」之前決定★(2026-09-16 代碼審 r2):
        # 排在後面的話,巢狀呼叫會拿舊路徑的鍵去查、查不到,內層卡滿 60 秒再拋
        # 「別的程序正在寫」這句假訊息——那正是本函式說明裡「第四輪已修過」的舊坑
        # 從退路分支重新長出來。現在決定位置是獨立一支,結構上不可能再排錯順序。
        lock, why = _vault_lock_where(vault)
        k = str(lock)

        if _VAULT_LOCK_HELD.get(k):          # 自己已經拿著這把鎖:巢狀直接過
            _VAULT_LOCK_HELD[k] += 1
            try:
                yield
            finally:
                _VAULT_LOCK_HELD[k] -= 1
            return

        if why and not _VAULT_LOCK_WARNED.get(k):
            _VAULT_LOCK_WARNED[k] = True
            _vault_lock_say(lock, why)
        deadline = _t.monotonic() + 60
        while not _excl_lock_try(lock, _VAULT_LOCK_STALE_SEC):
            if _t.monotonic() > deadline:
                raise RuntimeError("等了 60 秒還輪不到寫入(同一個筆記庫有別的程序正在寫,或上一個寫入的程序卡住了),檔案沒動")
            _t.sleep(0.05)
        _VAULT_LOCK_HELD[k] = 1
        try:
            yield
        finally:
            _VAULT_LOCK_HELD.pop(k, None)
            try:   # 只刪自己的鎖(過期被接手時,鎖檔已經是別人的)
                if lock.read_text(encoding="utf-8").split("\n", 1)[0] == str(os.getpid()):
                    lock.unlink()
            except OSError:
                pass
    return _cm()


def cmd_set(env, rel, key, value):
    with _vault_write_lock(env.vault):
        return _cmd_set_locked(env, rel, key, value)


def _cmd_set_locked(env, rel, key, value):
    if key not in SCALAR_KEYS:
        print(f"擋下:{key} 不能用 set 改,檔案沒動。set 只能改這些純量欄位:{sorted(SCALAR_KEYS)}"
              f"(清單欄位用 lumos append;決策新增/翻案用 lumos decision-add / decision-supersede)", file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, s, e = load_raw_for_edit(path)
    new_fm = edit_fm_scalar(lines[1:e], key, value)
    exp = fmt_scalar(key, value)
    exp_val = strip_quotes(exp)
    tag_synced = False
    if key == "status":
        new_fm, tag_synced = edit_fm_sync_status_tag(new_fm, exp_val)
    new_lines = lines[:1] + new_fm + lines[e:]

    def _check(f):
        if str(f.get(key, "")) != exp_val:
            return False
        if tag_synced:
            want = f"status/{exp_val}"
            tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
            return want in tags and all(t == want for t in tags if t.startswith("status/"))
        return True

    atomic_write_verify(path, new_lines, key, _check)
    print(f"✓ set {rel}: {key} 已改成 {exp}" + ("(狀態標籤 status/* 也同步改了)" if tag_synced else ""))
    return 0


def cmd_self_audit(env, rel, model="sonnet", date=None):
    """L4 自足性審計留痕:寫 self_audit: <model>/<date> 到節點 frontmatter。
    語意:這整篇節點的「自足性」(無主對話脈絡的乾淨 agent 只讀圖譜能不能還原
    專案現況)已由一個獨立 agent 審過並通過。對應 guard audit 的角色(乾淨 agent
    審後蓋戳),但程式路徑獨立——這是節點級戳記,guard audit 是行級 [audit:]。
    工具只記留痕,不證明審計真乾淨——派 agent 的乾淨脈絡/中立 prompt 靠主對話誠實。"""
    import datetime
    if date is None:
        date = datetime.date.today().isoformat()
    else:
        try:
            datetime.date.fromisoformat(date)
        except ValueError:
            print(f"擋下:--date 要寫成 年-月-日(例如 2026-08-22),你給的是 {date!r}", file=sys.stderr)
            return 2
    return cmd_set(env, rel, "self_audit", f"{model}/{date}")


def _disk_spelling(root, relp):
    """relp 每一層照磁碟上的真實檔名拼回來(大小寫、Unicode 寫法以磁碟為準;只差 Unicode 寫法的算同一個)。
    回 (真實拼法, None);某一層目錄讀不到檔名清單回 (None, 那一層目錄)——擋不擋由呼叫端決定。"""
    cur, real = root, []
    for part in relp.split("/"):
        try:
            names = os.listdir(cur)
        except OSError:
            return None, ("/".join(real) or ".")
        hit = part if part in names else next((n for n in names if nfc(n) == nfc(part)), None)
        if hit is None:
            hit = next((n for n in names if nfc(n).casefold() == nfc(part).casefold()), part)
        real.append(hit)
        cur = cur / hit
    return "/".join(real), None


def _about_code_key(root, value):
    """about_code 一項「指的是哪一支檔」的比對鍵(append 去重、remove 找項共用)。
    檔案還在:用磁碟上的真實位置——解 symlink、大小寫與 Unicode 寫法照磁碟(2026-09-10 代碼審 r3:
    只做字面正規化時,symlink 別名、舊的大小寫錯字項都會被當成另一支檔,疊出重複又刪不掉);
    檔案不在了:退回字面正規化(remove 要清得掉檔已刪的舊項)。比較一律用 NFC。"""
    lex = _posix_norm(strip_quotes(str(value).strip()))
    if not lex:
        return ""
    try:
        target = (root / lex).resolve()
        rel = target.relative_to(root).as_posix()
    except (ValueError, OSError):
        return nfc(lex)
    if not target.is_file():
        return nfc(lex)
    real, _ = _disk_spelling(root, rel)
    return nfc(real or rel)


def _about_code_path(env, value):
    """about_code 的一項要是「這個 repo 裡真的存在的程式檔」(2026-09-10 代碼審 r1)。

    回 (正規化後的 repo 相對路徑, None) 或 (None, 擋下的理由)。
    ★先解析再比對 repo 根★:只看「存不存在」的話,絕對路徑與 ../ 都會繞出 repo 而且通過;
    存成正規化的樣子,排序加分用的鍵才對得上(src/../src/a.py 跟 src/a.py 要是同一個)。"""
    v = str(value).strip().replace("\\", "/")   # Windows 反斜線寫法也收(r3 邊界席:原本永遠「找不到」)
    if not v:
        return None, "about_code 不能是空的"
    if Path(v).is_absolute():
        return None, f"about_code 要寫 repo 相對路徑,「{v}」是絕對路徑"
    root = _vault_repo_root(env).resolve()
    target = (root / v).resolve()
    try:
        relp = target.relative_to(root).as_posix()
    except ValueError:
        return None, f"「{v}」跑出這個 repo 了(repo 根是 {root})"
    if not target.is_file():
        return None, (f"「{v}」不是這個 repo 裡的檔案" + ("(它是目錄;about_code 要寫到檔案)" if target.is_dir() else "(找不到)"))
    # ★大小寫要跟磁碟上的真實檔名一致★(r2):排序加分拿這個值去比對 git 的改動路徑(大小寫敏感);
    # 大小寫不敏感的檔案系統上 SRC/A.TS 也通過 is_file,存進去就永遠對不上
    # 只差 Unicode 正規化寫法(é 一個字 vs e 加重音符號)的是同一個檔,不算寫錯:Mac 的磁碟兩種都認,
    # 目錄清單卻只列存進去的那一種(派第三輪之前自己抓到的誤擋)——兩邊都轉成 NFC 再比。
    # ★讀不到目錄的檔名清單就擋★(r3 併發資源席:原本當成「寫對了」放行,錯字大小寫照樣存進去)
    real, unreadable = _disk_spelling(root, relp)
    if unreadable:
        return None, f"讀不到目錄 {unreadable} 的檔名清單,沒辦法確認「{v}」的大小寫有沒有寫對"
    if nfc(real) != nfc(relp):
        return None, f"「{v}」的大小寫跟磁碟上的檔名不一致(磁碟上是 {real})"
    return relp, None


def cmd_append(env, rel, key, value):
    with _vault_write_lock(env.vault):
        return _cmd_append_locked(env, rel, key, value)


def _cmd_append_locked(env, rel, key, value):
    if key not in LIST_KEYS:
        print(f"擋下:{key} 不能用 append 加,檔案沒動。append 只能加這些清單欄位:{sorted(LIST_KEYS)}(純量欄位用 lumos set)", file=sys.stderr)
        return 2
    if key == "about_code":
        value, why = _about_code_path(env, value)
        if why:
            print(f"擋下:{why},檔案沒動。about_code 要填這個 repo 裡真的存在的程式檔(repo 相對路徑)", file=sys.stderr)
            return 2
    path = env.vault / rel
    lines, s, e = load_raw_for_edit(path)
    if key == "about_code":
        root = _vault_repo_root(env).resolve()
        want = _about_code_key(root, value)
        same = [x for x in as_list(parse_frontmatter(lines[1:e])[0].get(key)) if _about_code_key(root, x) == want]
        if same:
            hint = "" if value in same else f"(現有寫法是 {same[0]},指的是同一支檔;要換成 {value}:先 remove 再 append)"
            print(f"✓ {rel} 的 {key} 已經有 {value}{hint},檔案沒動")
            return 0
    new_fm = edit_fm_append(lines[1:e], key, value)
    if new_fm == lines[1:e]:
        print(f"✓ {rel} 的 {key} 已經有 {value},檔案沒動")
        return 0
    new_lines = lines[:1] + new_fm + lines[e:]
    tgt = link_target(value)
    before = {t for t in (link_target(x) for x in as_list(parse_frontmatter(lines[1:e])[0].get(key))) if t}   # 空值不算一項
    # 寫完讀回來:新的那項在,★原本的每一項也都還在★(第三輪外家找洞席:只驗新項,舊項被改壞也過)
    atomic_write_verify(path, new_lines, key,
                        lambda f: tgt in {link_target(x) for x in as_list(f.get(key))}
                        and before <= {link_target(x) for x in as_list(f.get(key))})
    print(f"✓ append {rel}: {key} 多了一項 {value}")
    return 0


def cmd_remove(env, rel, key, value):
    with _vault_write_lock(env.vault):
        return _cmd_remove_locked(env, rel, key, value)


def _cmd_remove_locked(env, rel, key, value):
    """T1 list 項移除(append 逆操作)。補的是 2026-08-11 實戰撞到的缺口:
    死背書(verified_by 指向已 superseded 的驗證)、降格後殘留的 core_refs 指針,
    都只能靠移除 list 項來收,但 set 只收純量、append 只能加,唯一合法退路
    (obsidian processFrontMatter)還要 Obsidian 開著 → 實務上等於無路可走。

    ★不命中一律 rc=2★:打錯字卻回成功,會讓呼叫端以為清乾淨了(死背書照舊掛著),
    比報錯危險得多。

    ★2026-08-23 擴充:value 省略 = 把純量欄位整個拿掉★(design-loop about-code-field r3:
    回滾要「刪 stamp」,但 set 只能覆寫、沒有刪除原語——回滾最後一步是空的)。
    不加新子命令,remove 一個指令學一次。守衛:type/status/created 是筆記骨架,刪了 lint/doctor
    全炸,硬擋;清單欄位不准省略 value(避免一句話誤刪整個 verified_by)。"""
    if value is None:
        return _cmd_remove_scalar(env, rel, key)
    if key not in LIST_KEYS:
        print(f"擋下:{key} 不能用 remove 刪,檔案沒動。remove 只能動這些清單欄位:{sorted(LIST_KEYS)}"
              f"(純量欄位要整個拿掉:不帶 value)", file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, s, e = load_raw_for_edit(path)
    if key == "about_code":
        # 同一支檔的每一種寫法都拿掉(舊資料可能同一支檔寫了兩種);比對鍵見 _about_code_key
        root = _vault_repo_root(env).resolve()
        want = _about_code_key(root, value)
        spellings = list(dict.fromkeys(x for x in as_list(parse_frontmatter(lines[1:e])[0].get(key))
                                       if _about_code_key(root, x) == want))
        new_fm, n = lines[1:e], 0
        for sp_ in spellings:
            new_fm, k = edit_fm_remove(new_fm, key, sp_)
            n += k
        gone = lambda f: not any(_about_code_key(root, x) == want for x in as_list(f.get(key)))
    else:
        new_fm, n = edit_fm_remove(lines[1:e], key, value)
        _t = link_target(value)
        gone = lambda f: not any(link_target(x) == _t for x in as_list(f.get(key)))
    if n == 0:
        cur = [str(x) for x in as_list(parse_frontmatter(lines[1:e])[0].get(key))]
        hint = ""
        if key == "about_code":   # 目錄讀不到時比對鍵只能退回字面,大小寫與別名對不上——講明(第四輪整合席)
            _lex = _posix_norm(strip_quotes(str(value).strip()))
            if _lex and not _lex.startswith("/"):
                _unr = _disk_spelling(_vault_repo_root(env).resolve(), _lex)[1]
                if _unr:
                    hint = f";讀不到目錄 {_unr} 的檔名清單,大小寫與別名沒辦法比對,請用筆記裡原本的寫法"
        print(f"擋下:{rel} 的 {key} 裡沒有 {value}(比對用的目標是 {link_target(value)}),可能打錯字或早就不在了,檔案沒動;"
              f"目前有 {len(cur)} 項:{cur[:8]}{' …' if len(cur) > 8 else ''}{hint}", file=sys.stderr)
        return 2
    new_lines = lines[:1] + new_fm + lines[e:]
    # 寫完讀回來:要拿掉的都不在了,★其他每一項都還在★(第三輪外家找洞席:原本只驗「拿掉了」)
    _keep = {link_target(x) for x in as_list(parse_frontmatter(lines[1:e])[0].get(key))
             if gone({key: [x]}) and link_target(x)}   # 空值不算一項
    atomic_write_verify(path, new_lines, key,
                        lambda f: gone(f) and _keep <= {link_target(x) for x in as_list(f.get(key))})
    print(f"✓ remove {rel}: {key} 拿掉了 {value}" + (f"(共拿掉 {n} 項)" if n > 1 else ""))
    return 0


_SKELETON_KEYS = ("type", "status", "created")   # 刪了筆記就不是筆記:lint/doctor/分類全依賴


def _cmd_remove_scalar(env, rel, key):
    """remove 的純量分支:整欄拿掉。"""
    if key in _SKELETON_KEYS:
        print(f"擋下:{key} 是筆記骨架欄位,拿掉了 lint/doctor/分類全會炸,檔案沒動。"
              f"要改值用 lumos set", file=sys.stderr)
        return 2
    if key in LIST_KEYS:
        print(f"擋下:{key} 是清單欄位,不准一句話整欄拿掉(誤刪整個 verified_by 這種事發生過一次就夠了),"
              f"檔案沒動。要逐值拿:lumos remove <節點> {key} <值>", file=sys.stderr)
        return 2
    if key not in SCALAR_KEYS:
        print(f"擋下:{key} 不在可動的純量欄位清單裡:{sorted(SCALAR_KEYS)},檔案沒動", file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, s, e = load_raw_for_edit(path)
    fm = lines[1:e]
    struct = {k: (a, b, kind) for k, a, b, kind in fm_structure(fm)}
    if key not in struct:
        print(f"擋下:{rel} 沒有 {key} 這個欄位,沒東西可拿,檔案沒動", file=sys.stderr)
        return 2
    a, b, kind = struct[key]
    new_fm = fm[:a] + fm[b + 1:]
    new_lines = lines[:1] + new_fm + lines[e:]
    atomic_write_verify(path, new_lines, key, lambda f: key not in f)
    print(f"✓ remove {rel}: {key} 整欄拿掉了")
    return 0


def about_code_to_rater(a, b):
    """★about_code 預標 → refresh_labels merge 的格式★(工具清單 #8,2026-08-23)。

    輸入兩席各 {節點: [檔路徑…]};輸出兩席各 {節點: {檔: 0|1}},可直接餵 `refresh_labels.py merge`。
    r3 實測:merge 硬吃 {題:{候選:int}},對 list 呼叫 .items() 直接 AttributeError。

    ★候選集 = 兩席聯集★:A 列了 B 沒列的檔,B 側填 0——那是 B 的反對票(讀過全文判「不關於」),
    不是沒意見;留空 merge 會把它當 B 缺席丟進人裁桶,把明確的分歧混成不確定。
    ★節點只在一席出現★(另一席沒標)→ 另一席該節點整個不出現,讓 merge 照既有語意判 degraded。
    """
    ra, rb = {}, {}
    a = a or {}
    b = b or {}
    for node in set(a) | set(b):
        fa, fb = a.get(node), b.get(node)
        union = sorted(set(fa or []) | set(fb or []))
        if fa is not None:
            ra[node] = {f: (1 if f in fa else 0) for f in union}
        if fb is not None:
            rb[node] = {f: (1 if f in fb else 0) for f in union}
    return ra, rb


def note_body_hash(vault, rel):
    """★正文雜湊:about_code 過期守衛的尺★(about-code-impl-std r2/r3,2026-08-24)。

    回 frontmatter 之外正文(rstrip 後)的 sha256 前 12 碼;檔不存在/讀不到 → None。
    為什麼是雜湊不是日期:三輪設計審實證「日期/commit 數」表達不了「標記在同日序列的哪一格」
    (83 篇首日就誤判 2 篇),而守衛要答的只是「標記時看的正文跟現在一樣嗎」——直接比正文最老實。
    ★必須 utf-8-sig★:BOM 檔否則 split_frontmatter 切不出 frontmatter、整檔算進雜湊,
    「只改 frontmatter 不過期」就破(std-r3 arch+s1 兩席抓到)。無快取、無 git、無子行程。
    """
    try:
        text = (Path(vault) / rel).read_text(encoding="utf-8-sig")
    except Exception:
        return None
    return _body_hash_of_text(text)


def _body_hash_of_text(text):
    """正文雜湊的唯一公式(note_body_hash 讀現在的檔、migrate-stamp 讀 git show 的舊檔,兩者共用)。"""
    import hashlib
    _, body = split_frontmatter(text)
    return hashlib.sha256(body.rstrip().encode("utf-8")).hexdigest()[:12]


def _stamp_parts(stamp):
    """about_code_stamp 三段 `<誰>/<日期>/<正文雜湊12碼>`;第三段非 12 碼 hex 視同沒有(舊格式)。"""
    if not isinstance(stamp, str):
        return None, None, None
    parts = [x.strip() for x in stamp.split("/")]
    who = parts[0] if len(parts) >= 1 else None
    day = parts[1] if len(parts) >= 2 else None
    h = parts[2] if len(parts) >= 3 else None
    if h is not None and not (len(h) == 12 and all(c in "0123456789abcdef" for c in h)):
        h = None
    return who, day, h


def about_code_expired(vault, rel, stamp):
    """過期 = 現在正文雜湊 ≠ stamp 第三段(或沒有第三段/舊格式)。回 (expired: bool, now_hash, stamp_hash)。"""
    _, _, sh = _stamp_parts(stamp)
    nh = note_body_hash(vault, rel)
    return (sh is None or nh is None or nh != sh), nh, sh


def cmd_about_code_restamp(env, rel, by="claude"):
    """★restamp = 「我剛核過這篇的 about_code 對現在的正文仍然正確」★(工具清單 #11,std-r3 釘語意)。

    三段全換:`<by>/<今天>/<現在正文雜湊>`。第一段離開 batch- 後,`revert --batch` 不再撤它
    (合約候選 #4「人工修正過的不被誤撤」在官方工具這條路上成立;std-r3 s1f2)。
    ★沒有批次模式★——一口氣把所有可疑標籤洗白正是橡皮章(Codex r3 f1)。
    沒有 about_code 的節點擋下:沒東西可核。
    """
    if str(by).strip().startswith("batch-"):
        print(f"擋下:--by 不能以 batch- 開頭({by})——那是批次預標的命名空間,重標完會被 `about-code revert --batch` 當成批次一起撤掉"
              f"(合約候選 #4:人工修正過的不被誤撤)。用 claude、你的名字之類。", file=sys.stderr)
        return 2
    asked = rel
    try:
        rel = env.find(rel)
    except Exception as e:
        print(f"擋下:找不到節點 {asked}({e})", file=sys.stderr)
        return 2
    n = env.notes.get(rel) if rel else None
    if n is None:
        print(f"擋下:找不到節點 {asked}", file=sys.stderr)
        return 2
    if not as_list(n.fields.get("about_code")):
        print(f"擋下:{rel} 沒有 about_code,沒東西可核。先 lumos append <節點> about_code <檔> 再 restamp。", file=sys.stderr)
        return 2
    h = note_body_hash(env.vault, rel)
    if h is None:
        print(f"擋下:{rel} 讀不到正文", file=sys.stderr)
        return 2
    import datetime
    stamp = f"{by}/{datetime.date.today().isoformat()}/{h}"
    rc = cmd_set(env, rel, "about_code_stamp", stamp)
    if rc == 0:
        print(f"✓ restamp {rel}:about_code_stamp = {stamp}(表示你核過標籤對現在的正文仍正確)")
    return rc


def cmd_about_code_migrate_stamp(env, at_commit, repo_root=None, dry_run=False):
    """★一次性:batch-* 兩段式 stamp 補第三段,用「標註當時 commit」的正文算★(Codex r3 f2:用現在的=橡皮章)。

    `git show <commit>:<path>` 逐篇取當時正文(路徑當參數傳,不經 git 輸出,無 quotepath 問題);
    第一、二段不動。寫入後 doctor/impact 用現在的正文比——標完之後改過的自然變「過期」進人核清單。
    已三段式的跳過(冪等);非 batch- 的(人工修正過)不動。
    """
    import subprocess
    root = Path(repo_root).resolve() if repo_root else _vault_repo_root(env)
    if root is None:
        print("擋下:找不到 repo 根(給 --repo)", file=sys.stderr)
        return 2
    rel_vault = os.path.relpath(str(Path(env.vault).resolve()), str(root.resolve()))   # macOS /var→/private/var
    targets = []
    for rel, n in sorted(env.notes.items()):
        stamp = n.fields.get("about_code_stamp")
        who, day, h = _stamp_parts(stamp)
        if who is None or not who.startswith("batch-") or h is not None:
            continue
        targets.append((rel, who, day))
    if not targets:
        print(f"✓ migrate-stamp:0 篇要補(batch-* 兩段式的都補過了)")
        return 0
    done, failed = 0, 0
    for rel, who, day in targets:
        spec = f"{at_commit}:{rel_vault}/{rel}"
        r = subprocess.run(["git", "-C", str(root), "show", spec], capture_output=True)
        if r.returncode != 0:
            print(f"  ⚠ {rel}:git show {spec} 失敗(當時可能還沒有這篇),跳過", file=sys.stderr)
            failed += 1
            continue
        h = _body_hash_of_text(r.stdout.decode("utf-8-sig", errors="replace"))
        new = f"{who}/{day}/{h}"
        if dry_run:
            print(f"  [dry-run] {rel}: {new}")
            done += 1
            continue
        if cmd_set(env, rel, "about_code_stamp", new) == 0:
            done += 1
        else:
            failed += 1
    tail = f",{failed} 篇失敗" if failed else ""
    print(f"✓ migrate-stamp(@{at_commit[:8]}):補了 {done} 篇{tail};之後跑 lumos doctor 看哪些「標完之後正文改過」要人核")
    return 0 if failed == 0 else 1


def cmd_about_code_revert(env, batch_date, dry_run=False):
    """★整批撤銷某天的 about_code 預標★(工具清單 #7,2026-08-23)。

    批次寫入時 stamp 第一段固定 `batch-<日期>`;本指令找第一段★精確等於★它的節點,
    逐值拿掉 about_code、整欄拿掉 stamp。人工修正過的 stamp 第一段會變(`claude/…`),
    不在範圍——★這是本指令最怕誤傷的那類,比對用精確字串不用包含★。
    r3 抓到原計劃寫的 `lumos query --field` 根本不存在,所以這是新子命令。
    """
    want = f"batch-{batch_date}"
    targets = []
    for rel, n in sorted(env.notes.items()):
        stamp = n.fields.get("about_code_stamp")
        if not isinstance(stamp, str):
            continue
        if stamp.split("/", 1)[0].strip() == want:
            targets.append((rel, [str(x) for x in as_list(n.fields.get("about_code"))]))
    if not targets:
        print(f"擋下:沒有任何節點的 about_code_stamp 第一段是 {want},沒東西可撤。"
              f"(人工修正過的會是 claude/… 之類,不算批次;日期格式 YYYY-MM-DD)", file=sys.stderr)
        return 2
    print(f"{'[dry-run] ' if dry_run else ''}批次 {want}:{len(targets)} 篇")
    for rel, vals in targets:
        print(f"  {rel}  about_code {len(vals)} 項")
    if dry_run:
        return 0
    done, failed = 0, 0
    for rel, vals in targets:
        # std-r1 s3f8:單篇任一值拿不掉 → ★stamp 留著★(下次 revert 還找得到它)、不算撤成功;
        # 值先去重——清單重複時第一次 remove 會把同值全拿掉,第二次拋 ValueError(實測崩潰)
        bad = None
        for v in list(dict.fromkeys(vals)):
            try:
                if cmd_remove(env, rel, "about_code", v) != 0:
                    bad = v
                    break
            except Exception as e:   # 一篇壞不該拖垮整批
                bad = f"{v}({e})"
                break
        if bad is not None:
            print(f"  ⚠ {rel} 拿 {bad} 失敗:這篇 stamp 保留、不算撤成功,其餘繼續", file=sys.stderr)
            failed += 1
            continue
        if cmd_remove(env, rel, "about_code_stamp", None) == 0:   # 走有上鎖的入口(第四輪併發資源席:原本直接呼叫底層函式、繞過寫入鎖)
            done += 1
        else:
            failed += 1
    tail = f",{failed} 篇失敗(stamp 還在,修好再跑一次)" if failed else ""
    print(f"✓ about-code revert:撤了 {done} 篇(批次 {want}){tail}")
    return 0 if failed == 0 and done == len(targets) else 1


def _fm_of(all_lines):
    """從完整檔行抽 frontmatter 行(供 decision 自驗用 parse_decisions 重解)。"""
    for i in range(1, len(all_lines)):
        if all_lines[i].strip() == "---":
            return all_lines[1:i]
    return all_lines[1:]


def _fmt_decision_value(v):
    """decision 子欄位值格式化(含 ': ' 或特殊字元 → 引號,避鐵則 3)。"""
    v = v.strip()
    if re.search(r":\s|^[\[\{>|*&!#@`\"']|^\s|\s$", v) or v == "":
        return '"' + v.replace('"', '\\"') + '"'
    return v


def cmd_decision_supersede(env, rel, match, by, ended=None):
    """T3 巢狀手術:把 decisions[] 中 content 含 match 的決策標 valid:false + 補
    superseded_by/ended。surgical line-based(不重序列化,最小 diff;優於 ruamel reflow)。
    [P1]:ended 缺則自動補今日 + 同步 bump 頂層 updated(單次 atomic,供 E2 時序法)。"""
    import datetime
    if ended and not DATE_RE.match(ended):
        raise ValueError(f"--ended 要寫成 年-月-日(例如 2026-08-22),你給的是 {ended}")
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    loc = decisions_items(fm)
    if loc is None:
        raise ValueError("這篇筆記還沒有任何決策紀錄(decisions)")
    if not loc[2]:  # block 存在但解析不到項目(Bug2:0-indent / 非標準縮排)
        raise ValueError("決策區塊(decisions)讀不出任何一條,通常是縮排不對:工具只認兩個空白的縮排,不認 tab 或不縮排")
    _, _, items, _, sub = loc
    pad = " " * sub
    needle = nfc(match)
    id_mode = re.fullmatch(r"#d\d+", match.strip())
    if id_mode:
        # [M1/R12] #dN 精確定址:比對項內 id 行
        want = match.strip()[1:]
        hits = [(st, en) for (st, en) in items
                if any(re.match(rf"^{pad}id:\s*{re.escape(want)}\s*$", fm[i])
                       for i in range(st, en + 1))]
        if not hits:
            raise ValueError(f"找不到編號 {match} 的決策,可能這篇的決策還沒編號;先跑:\n    lumos decision-reindex {rel}")
    else:
        hits = [(st, en) for (st, en) in items
                if needle in nfc("\n".join(fm[st:en + 1]))]
        if not hits:
            raise ValueError(f"找不到內容含「{match}」的決策")
        if len(hits) > 1:
            # [M1/R12] 選擇端唯一命中:first-match 會「先改錯項、再用錯項 id 精確驗證它改成功」
            cands = "; ".join(first_line(fm[st].split("content:", 1)[-1].strip(), 40)
                              for (st, _) in hits[:5])
            raise ValueError(f"「{match}」命中 {len(hits)} 條決策,分不清要改哪條,不敢亂猜。"
                             f"候選: {cands} …改用更長的片段,或用 --match \"#dN\" 指定編號")
    st, en = hits[0]
    valid_line = None
    for i in range(st, en + 1):
        if re.match(rf"^{pad}valid:\s", fm[i]):   # 只認精確 sub_indent(Bug5:移除過寬 fallback,免誤命中子清單)
            valid_line = i
            break
    if valid_line is None:
        raise ValueError("這條決策沒有 valid 欄位(或縮排不是兩個空白),工具不敢自動翻案,請手動處理或先修結構")
    # Bug3: 已 superseded 不重插(免重複鍵)。同 sub_indent 已有 superseded_by → 拒
    for i in range(st, en + 1):
        if re.match(rf"^{pad}superseded_by:\s", fm[i]):
            raise ValueError("這條決策已經被翻案過了(有 superseded_by),不重複翻;要改成被誰取代請手動編輯")
    fm[valid_line] = f"{pad}valid: false"
    # [P1] ended 選填 → 缺則自動補今日(E2 時序法要 ended 才判得了「鄰居晚於翻案沒?」)
    if not ended:
        ended = datetime.date.today().isoformat()
    ins = [f"{pad}superseded_by: {_fmt_decision_value(by)}", f"{pad}ended: {ended}"]
    fm[valid_line + 1:valid_line + 1] = ins
    # [P1] supersede = 對本節點的實質編輯 → 同步 bump 頂層 updated(單次 atomic,同一份 fm;
    #   不串第二個寫命令避免半完成)。有則就地換、無則插在 decisions: 前(不動決策區索引)。
    today = datetime.date.today().isoformat()
    upd_i = next((k for k, ln in enumerate(fm) if re.match(r"^updated:\s", ln)), None)
    if upd_i is not None:
        fm[upd_i] = f"updated: {today}"
    else:
        dec_i = next((k for k, ln in enumerate(fm) if re.match(r"^decisions:\s*$", ln)), len(fm))
        fm[dec_i:dec_i] = [f"updated: {today}"]
    new_lines = lines[:1] + fm + lines[e_fm:]
    # [M1/P2] 讀 target 的 id → 組全域格式 <rel>#d<N> 回傳(下游 header/CASCADE/--from 同格式,無裸碼流出)
    did = None
    for i in range(st, en + 1):
        m = re.match(rf"^{pad}id:\s*(d\d+)\s*$", fm[i])
        if m:
            did = m.group(1)
            break
    gid = f"{rel}#{did}" if did else None

    def _check(_fields):
        for d in parse_decisions(_fm_of(new_lines)):
            # [M1] 有 id → ID 精確驗證(content 子字串重疊會驗錯項);無 id(未 reindex 舊節點)→ 退回 content 驗證
            hit = (str(d.get("id", "")).strip() == did) if did \
                else (needle in nfc(str(d.get("content", ""))))
            if hit:
                return str(d.get("valid", "")).lower() == "false" and "superseded_by" in d
        return False
    atomic_write_verify(path, new_lines, "decisions", _check)
    _tag = f" [{gid}]" if gid else ""
    print(f"✓ supersede {rel}: 決策「{match[:30]}」→ valid:false + superseded_by + ended={ended} (updated bump {today}){_tag}")
    return 0, gid


def _max_decision_id(fm_lines):
    """[M1/P2] 掃 decisions[] 既有 id: d<N>,回最大 N(無則 0)。新號=max+1(不重排既有、
    不回收缺號——ID 穩定性合約:翻案後永不重用)。"""
    mx = 0
    for d in parse_decisions(fm_lines):
        m = re.fullmatch(r"d(\d+)", str(d.get("id", "")).strip())
        if m:
            mx = max(mx, int(m.group(1)))
    return mx


def cmd_decision_add(env, rel, content, decided, context=None, why=None):
    """T3 巢狀手術:append 一條新 ADR 決策到 decisions[](無則建)。surgical line-based。
    [M1/P2]:指派穩定 id d<max+1> 並回傳 (rc, 全域決策id <rel>#d<N>);dispatcher 解包後
    CLI 對外仍只回整數 rc。"""
    if not DATE_RE.match(decided):
        raise ValueError(f"擋下:--decided 要寫成 年-月-日(例如 2026-08-22),你給的是 {decided}")
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    loc = decisions_items(fm)
    new_id = f"d{_max_decision_id(fm) + 1}"
    if loc is None:
        # 無 decisions key → 在 fm 末尾建
        item_indent, sub = 2, 4
        block = [f'{" "*item_indent}- content: {_fmt_decision_value(content)}',
                 f"{' '*sub}id: {new_id}"]
        if context:
            block.append(f'{" "*sub}context: {_fmt_decision_value(context)}')
        if why:
            block.append(f'{" "*sub}why_chosen: {_fmt_decision_value(why)}')
        block += [f"{' '*sub}decided: {decided}", f"{' '*sub}valid: true"]
        fm = fm + ["decisions:"] + block
    else:
        _, e_block, items, item_indent, sub = loc
        ip, sp = " " * item_indent, " " * sub
        block = [f"{ip}- content: {_fmt_decision_value(content)}", f"{sp}id: {new_id}"]
        if context:
            block.append(f"{sp}context: {_fmt_decision_value(context)}")
        if why:
            block.append(f"{sp}why_chosen: {_fmt_decision_value(why)}")
        block += [f"{sp}decided: {decided}", f"{sp}valid: true"]
        last = items[-1][1] if items else e_block
        fm[last + 1:last + 1] = block
    new_lines = lines[:1] + fm + lines[e_fm:]
    needle = nfc(content)

    def _check(_fields):
        # [M1] ID 精確驗證:新 id 那條存在且 content 相符(取代純 content 子字串——重疊時驗錯項)
        return any(str(d.get("id", "")).strip() == new_id
                   and needle in nfc(str(d.get("content", "")))
                   for d in parse_decisions(_fm_of(new_lines)))
    atomic_write_verify(path, new_lines, "decisions", _check)
    print(f"✓ decision-add {rel}: 記下一條決策「{content[:30]}」(編號 {new_id},目前有效)")
    return 0, f"{rel}#{new_id}"


def cmd_decision_reindex(env, rel=None, all_mode=False):
    """[M1/P2] 回填遷移:對既有無 id 決策依文件順序、從既有最大 id+1 接續編號(不重排既有、
    不回收缺號——混合狀態絕不撞既有 id);冪等(已有 id 跳過)。單節點一次一篇;--all 批次套用
    到所有有 decisions 的節點(decision_refs 自動養成前置 P;顯式指令、非隱式改)。
    解析不到的決策項明確拒絕(同 supersede 0-indent/tab 語意),不靜默跳過造成缺洞。"""
    if all_mode:
        targets = sorted(r for r, n in env.notes.items() if decisions_items(n.fm_lines) is not None)
        done = errs = 0
        for r in targets:
            try:
                cmd_decision_reindex(env, r)
                done += 1
            except (ValueError, RuntimeError, OSError) as e:   # [code-loop r1 A] 補 OSError:寫檔面(磁碟滿/權限)
                print(f"  ✗ {r}: {e}", file=sys.stderr)
                errs += 1
        print(f"✓ reindex --all: 掃 {len(targets)} 個決策節點,{done} 處理 / {errs} 拒絕(格式不合)")
        return 2 if errs else 0
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    loc = decisions_items(fm)
    if loc is None:
        raise ValueError("這篇筆記還沒有任何決策紀錄(decisions)")
    if not loc[2]:
        raise ValueError("決策區塊(decisions)讀不出任何一條,通常是縮排不對:工具只認兩個空白的縮排,不認 tab 或不縮排")
    _, _, items, _, sub = loc
    pad = " " * sub
    nxt = _max_decision_id(fm) + 1
    # 先依文件順序算好指派,再由下而上插入(插入不位移未處理的上方索引)
    plan = []
    for (st, en) in items:
        if not any(re.match(rf"^{pad}id:\s*d\d+\s*$", fm[i]) for i in range(st, en + 1)):
            plan.append((st, f"d{nxt}"))
            nxt += 1
    if not plan:
        print(f"✓ reindex {rel}: 全部決策已有 id,無需回填(冪等)")
        return 0
    pre_ids = {str(d.get("id", "")).strip() for d in parse_decisions(fm) if d.get("id")}
    for st, did in reversed(plan):
        fm[st + 1:st + 1] = [f"{pad}id: {did}"]   # 插在 dash(content)行之後
    new_lines = lines[:1] + fm + lines[e_fm:]

    def _check(_fields):
        ds = parse_decisions(_fm_of(new_lines))
        ids = [str(d.get("id", "")).strip() for d in ds]
        return (all(re.fullmatch(r"d\d+", i) for i in ids)          # 全數有 id
                and len(ids) == len(set(ids))                        # 唯一
                and pre_ids <= set(ids))                             # 既有 id 未被動
    atomic_write_verify(path, new_lines, "decisions", _check)
    print(f"✓ reindex {rel}: 回填 {len(plan)} 條 id({plan[0][1]}..{plan[-1][1]});既有 {len(pre_ids)} 條跳過")
    return 0


# ── [M3/S5b] rel-cascade ledger:連鎖判定的 append-only 帳本 ──
# 設計/合約見 Projects/關係層主網_實作計畫 M3(3 輪 design-loop 釘死):
# 每 cascade 一檔 governance/rel-cascade/<cascade-id>.jsonl;行帶 event 判別欄
# (header|transition);重放折疊=只折 transition、同粒度鍵取檔內物理序最後一筆(沿
# canary-log 慣例:讀 append 序、不 ts-sort);torn 行(壞 JSON)=未提交,跳過。

CASCADE_ID_RE = re.compile(r"^[A-Za-z0-9._-]+$")
REL_CASCADE_EDGES = ("verified_by", "plan_refs")   # 方向語意明確的邊(related 弱,v1 恆不展)


def _rel_cascade_dir(env):
    """帳本目錄=<repo root>/governance/rel-cascade(可追蹤逐 cascade 檔,非 vault-parent 隱藏帳慣例——
    刻意設計)。repo root:docs/<slug>-knowledge 型= docs 的上層;standalone vault=vault 自身
    (絕不往系統 temp 等共用父層爬;.jsonl 非 .md,load_vault 不掃、無污染)。"""
    root = env.vault.parent.parent if env.vault.parent.name == "docs" else env.vault
    return root / "governance" / "rel-cascade"


def _utc_ts():
    import datetime
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def _ledger_append(path, obj):
    """[M3 並行合約] O_APPEND fd + 單次 os.write() 整行 bytes(≤4KB 寫前拒,不截斷)。
    POSIX regular file 實務原子;Windows/跨平台 best-effort、預期單寫者(誠實降級,r1 D10)。
    無 O_CREAT——confirm/prune 永不建檔(建檔只屬觸發端 rel_cascade_create,r2 R4)。
    [code-loop r1] O_NOFOLLOW 拒 symlink 終點(字元白名單擋不住,CX1);os.write 回傳驗滿寫
    (ENOSPC 短寫會留中段殘行且 rc=0 假成功,B1)——短寫即 RuntimeError,呼叫端 rc=2。"""
    import json
    data = (json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8")
    if len(data) > 4096:
        raise ValueError(f"這筆事件有 {len(data)} 位元組,超過 4KB 上限,不寫(不截斷,免得寫一半)")
    fd = os.open(str(path), os.O_WRONLY | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0))
    try:
        written = os.write(fd, data)
        if written != len(data):
            raise RuntimeError(f"帳本短寫:只寫進 {written}/{len(data)} 位元組,可能磁碟滿了——這筆沒完整寫入,重試前先查空間")
    finally:
        os.close(fd)


def rel_cascade_create(env, root_gid, node_rel):
    """[M3 定址合約] 觸發端唯一鑄造者:mint cascade-id=c-<UTC秒ts>-<sha1(root全域id)[:8]>(-<n>)?
    + O_CREAT|O_EXCL 建檔寫 header。同秒撞名遞增序號(不等下秒;上限 99 防異常迴圈)。
    純生成、不含節點名——中文 rel 無淨化問題(r1 D5 消解)。回 cascade_id。"""
    import datetime, hashlib, json
    d = _rel_cascade_dir(env)
    d.mkdir(parents=True, exist_ok=True)
    ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d%H%M%S")
    base = f"c-{ts}-{hashlib.sha1(root_gid.encode('utf-8')).hexdigest()[:8]}"
    for suffix in [""] + [f"-{i}" for i in range(1, 100)]:
        cid = base + suffix
        p = d / (cid + ".jsonl")
        try:
            fd = os.open(str(p), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        except FileExistsError:
            continue
        try:
            hdr = json.dumps({"event": "header", "ts": _utc_ts(),
                              "root_decision_id": root_gid, "node": node_rel},
                             ensure_ascii=False) + "\n"
            os.write(fd, hdr.encode("utf-8"))
        finally:
            os.close(fd)
        return cid
    raise RuntimeError("連續 99 次都撞到同名的 cascade 編號,目錄可能有問題")


def _ledger_read(path):
    """重放讀取:append 序逐行 parse;壞 JSON 行跳過(torn=未提交事件,丟棄正確)。
    header=首行且 event:header 才算(torn header → None,root 不可恢復)。回 (header|None, transitions)。"""
    import json
    try:
        raw = path.read_text(encoding="utf-8")
    except (FileNotFoundError, OSError):
        return None, []
    header, trans = None, []
    for i, line in enumerate(raw.splitlines()):
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if i == 0 and o.get("event") == "header" \
                and str(o.get("root_decision_id", "")).strip() and str(o.get("node", "")).strip():
            # [code-loop r1 CX2] 必要欄位齊才算合法 header——空殼 {"event":"header"} 會讓
            #   resume 拿空 root 靜默 rc=0 裝成功,而非走「不可恢復 rc=1」救援語意
            header = o
        elif o.get("event") in ("transition", "visited"):
            # visited=空單巡過(2026-09-16,Issues/空連鎖單巡過無法銷帳):它沒有鄰居與邊型欄位,
            # 折疊那支用 all(k) 過濾會自動略過它,所以收進來不影響任何既有判定;
            # 收它的唯一用途是讓體檢的「零筆=沒看過」不再對空單嘮叨。
            trans.append(o)
    return header, trans


def _ledger_fold(transitions):
    """狀態折疊:同 (neighbor×edge_type×from_decision_id) 取物理序最後一筆。

    ★只認 event=transition★(2026-09-16 代碼審 r1 外家席):巡過那種事件★按慣例★不帶
    鄰居與邊型,所以原本靠三個粒度欄位「剛好都有值」來過濾——那是寫入端的慣例,
    讀取端一個字都沒保證。帳本是 append-only 純文字,任何一筆手改的或別的工具寫進來的
    巡過紀錄只要帶齊三個欄位,就會蓋掉真正的待判狀態,空單守衛跟著放行、體檢也把
    那個時間當成已判定時間。過濾要看事件種類,不看欄位剛好有沒有填。"""
    state = {}
    for t in transitions:
        if t.get("event") != "transition":
            continue
        k = (t.get("neighbor"), t.get("edge_type"), t.get("from_decision_id"))
        if all(k):
            state[k] = t
    return state


def _validate_cascade_id(cid):
    # [code-loop r1 A3] fullmatch 非 match——match+$ 會放過尾端換行(re 的 $ 容忍結尾 \n)
    if not CASCADE_ID_RE.fullmatch(cid) or ".." in cid:
        raise ValueError(f"cascade 編號只能用字母、數字、點、底線、連字號(不能有 ../ 這種): {cid}")


def _validate_from_gid(from_id):
    if re.fullmatch(r"d\d+", from_id.strip()):
        raise ValueError(f"--from 要寫完整的 <筆記路徑>#d<編號>,只給裸的 {from_id} 不收(不帶路徑會跟別篇的同號決策搞混)")
    if not re.fullmatch(r".+#d\d+", from_id.strip()):
        raise ValueError(f"--from 格式要是 <筆記路徑>#d<編號>,你給的是: {from_id}")


def _fm_list_insert(fm, field, quoted):
    """往 frontmatter 的 list 欄位插一個已引號化的項(欄位不存在則建)。
    ★單一實作★:_append_decision_ref(T1)與 dref promote 共用(code-dref arch-f4:原兩處複製)。
    fm 就地改;呼叫端負責去重檢查(此函式只管插入)。"""
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if field in struct:
        s, e, _kind = struct[field]
        if _kind != "list":   # code-dref d-f3:非清單型不插(防第三個呼叫點忘了驗 kind 複製坑)
            raise ValueError(f"{field} 是{_kind}型欄位,不能插清單項")
        indent = "  "
        for j in range(s + 1, e + 1):
            if fm[j].lstrip().startswith("-"):
                indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
                break
        last = e
        while last > s and not fm[last].strip():
            last -= 1
        fm.insert(last + 1, f"{indent}- {quoted}")
    else:
        fm.append(field + ":")
        fm.append(f"  - {quoted}")


def _append_decision_ref(env, rel, field, ref):
    """[decision_refs 自動養成 T1] 把精確 decision_ref(<rel>#dN)append 到 field
    (decision_refs=human/cascade-confirmed | decision_refs_ai=AI 填)。**exact-string dedup**
    ——不用 link_target(它 split('#') 會把 #dN 剝掉,導致同節點不同決策誤 dedup 成一條)。
    值一律引號化(含 #// 安全)。走 atomic_write_verify。回 True=新增 / False=已存在。"""
    ref = ref.strip()
    # [code-loop r1 CX3/B + delta] 顯式拒 " / \ / 任何 C0 控制字元(<0x20,含裸 \r/\n/\t)——
    #   strip_quotes 不反跳脫、CRLF 檔案守衛只認 \r\n 序列認不出裸 CR;合法 <rel>#dN 永不含這些。
    #   「凡控制字元一律拒」比枚舉個案完整(delta reviewer:漏 \r)。
    if '"' in ref or '\\' in ref or any(ord(c) < 0x20 for c in ref):
        raise ValueError(f"決策引用裡有不能用的字元(引號、斜線、控制字元): {ref!r}")
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    quoted = '"' + ref + '"'   # ref 已排除 "/\ → 純引號包裹即安全 round-trip(含 #// 無虞)
    if field in struct:
        s, e, kind = struct[field]
        if kind != "list":
            raise ValueError(f"{field} 是{kind}型欄位,沒辦法往裡面加決策引用")
        for j in range(s + 1, e + 1):
            if fm[j].lstrip().startswith("-") and strip_quotes(fm[j].lstrip()[1:].strip()) == ref:
                return False   # exact 已存在
    _fm_list_insert(fm, field, quoted)   # 共用插入(code-dref arch-f4)
    new_lines = lines[:1] + fm + lines[e_fm:]
    atomic_write_verify(path, new_lines, field,
                        lambda f: any(str(x).strip() == ref for x in as_list(f.get(field))))
    return True



# ═══════════ decision_refs 自動養成 T3(dref-v4;六原語,乾淨雙欄)═══════════
# 設計:Projects/decision_refs自動養成_實作計畫.md ★v4 現行 spec★(dref-v4 三輪收斂)。
# 不對稱信任(T1 已建):E2 抑制只讀 decision_refs 正欄、E3 firing 讀聯集;此六原語不動 E2/E3 讀側。

_DREF_E2_FIELDS = ("verified_by", "plan_refs")   # E2 typed_in 實際抑制範圍(排 related,對齊 scripts:1236)


def _dref_parse(ref):
    """ref '<節點>#dN' → (節點字面, did) 或 None(格式不合)。"""
    m = re.fullmatch(r"(.+?)#(d\d+)", str(ref).strip())
    return (m.group(1), m.group(2)) if m else None


def _dref_norm(env, ref):
    """正規化 tuple (resolve(節點), did);節點解不到或格式不合→None。"""
    pr = _dref_parse(ref)
    if not pr:
        return None
    node = env.resolve(pr[0])
    return (node, pr[1]) if node else None


def _dref_same(env, a, b):
    """兩 ref 是否同一決策:正規化 tuple 相等。只吃「ref」(a/b 皆 <節點>#dN),故 did 恆有值
    ——無 id 決策不會變成 ref、由 _dref_coverage_scan 的 no_id_dead 分支另處理(不經此函式,
    s1-f3:此處 na[1]/nb[1] 恆真、是防禦性冗餘非活守衛)。"""
    na, nb = _dref_norm(env, a), _dref_norm(env, b)
    if not na or not nb:
        return False
    return na == nb


def _node_decisions(env, rel):
    """回某節點的 decisions list(parse_decisions on 記憶體 fm_lines,照 E2 慣例 scripts:1256;
    arch-f1:不用 load_raw_for_edit 重讀檔——那是寫入前置原語、拒 BOM/CRLF,會把 load_vault
    讀得動但格式稍偏的節點候選悄悄吞成空)。"""
    n = env.notes.get(rel)
    return parse_decisions(n.fm_lines) if n else []


def _dref_filled(env, rel):
    """已填集合=decision_refs ∪ decision_refs_ai 的正規化 tuple(略去解不到的)。"""
    n = env.notes.get(rel)
    if not n:
        return set()
    out = set()
    for fld in ("decision_refs", "decision_refs_ai"):
        for r in as_list(n.fields.get(fld)):
            nn = _dref_norm(env, r)
            if nn and nn[1]:
                out.add(nn)
    return out


def _dref_candidates(env, rel, tidx):
    """★共用候選產生函式★(backlog/candidates 同口徑,r1 ext-f2)。
    回 (cands, skipped_no_id):cands=[(target_rel, did, content, valid)],三具名邊 fwd 解到的
    節點的所有決策(含已翻案=E3 要抓),只列有 id;無 id 計數。正規化元素=(target_rel, did)。"""
    cands, skipped = [], 0
    fwd = tidx["fwd"].get(rel, {})
    seen = set()
    for etype in TYPED_EDGE_FIELDS:
        for trel in fwd.get(etype, []):
            for d in _node_decisions(env, trel):
                did = str(d.get("id", "")).strip()
                if not did:
                    skipped += 1
                    continue
                key = (trel, did)
                if key in seen:
                    continue
                seen.add(key)
                cands.append((trel, did, first_line(str(d.get("content", "")), 60),
                              str(d.get("valid", "true")).lower() != "false"))
    return cands, skipped


def cmd_dref_backlog(env, as_json=False):
    """[V1] 列該跑 suggest 的節點:候選集 − 已填 ≠ 空(正規化 tuple 集合差)。"""
    import json as _j
    tidx = build_typed_index(env)
    rows, omitted_all_no_id = [], 0
    for rel in sorted(env.notes):
        cands, skipped = _dref_candidates(env, rel, tidx)
        if not cands:
            if skipped:
                omitted_all_no_id += 1
            continue
        cand_set = {(c[0], c[1]) for c in cands}
        filled = _dref_filled(env, rel)
        unfilled = cand_set - filled
        if unfilled:
            rows.append({"node": rel, "unfilled": len(unfilled), "candidates": len(cand_set)})
    if as_json:
        print(_j.dumps({"backlog": rows, "omitted_all_no_id": omitted_all_no_id}, ensure_ascii=False))
    else:
        if not rows:
            print("backlog 空:結構可達的候選都已填(或無候選)")
        for r in rows:
            print(f"  {r['node']}  未填 {r['unfilled']}/{r['candidates']}")
        if omitted_all_no_id:
            print(f"  (另有 {omitted_all_no_id} 個節點候選決策全無 id、悄悄不列——是漏 reindex 還是真沒關聯?先 lumos decision-reindex --all)")
    return 0


def cmd_dref_candidates(env, rel_in, as_json=False):
    """[V2] 列某節點候選決策(含翻案),讀側去重已填,附 skipped_no_id。"""
    import json as _j
    rel = env.find(rel_in)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {rel_in} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return 2
    tidx = build_typed_index(env)
    cands, skipped = _dref_candidates(env, rel, tidx)
    filled = _dref_filled(env, rel)
    n = env.notes.get(rel)
    summary = first_line(str((n.fields.get("summary") if n else "") or ""), 80)
    out_rows = []
    for trel, did, content, valid in cands:
        already = (trel, did) in filled
        out_rows.append({"ref": f"{trel}#{did}", "content": content,
                         "valid": bool(valid), "already_filled": already})   # valid 已是 bool(_dref_candidates 轉好,arch-f3)
    if as_json:
        print(_j.dumps({"node": rel, "summary": summary, "candidates": out_rows,
                        "skipped_no_id": skipped}, ensure_ascii=False))
    else:
        print(f"節點 {rel}:{summary}")
        for r in out_rows:
            flag = " [已填]" if r["already_filled"] else ("" if r["valid"] else " [已翻案]")
            print(f"  {r['ref']}{flag}  {r['content']}")
        if skipped:
            print(f"  (略過 {skipped} 條無 id 決策——先 reindex 才能被 ref)")
        if not out_rows:
            print("  (無結構可達候選決策)")
    return 0


def cmd_dref_add_ai(env, rel_in, ref):
    """[V3] 寫 decision_refs_ai:存在性驗證+正規化冪等(已在正欄→no-op)。"""
    rel = env.find(rel_in)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {rel_in} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return 2
    nn = _dref_norm(env, ref)
    if not nn or not nn[1]:
        print(f"擋下:ref 要寫成 <節點>#dN 且節點解得到: {ref!r}", file=sys.stderr)
        return 2
    tnode, did = nn
    if not any(str(d.get("id", "")).strip() == did for d in _node_decisions(env, tnode)):
        print(f"擋下:{tnode} 沒有決策 {did}(dangling ref,拒寫)", file=sys.stderr)
        return 2
    n = env.notes.get(rel)
    # 已在正欄(正規化命中)→ no-op(不重複塞 ai 欄)
    for r in as_list(n.fields.get("decision_refs")):
        if _dref_same(env, r, ref):
            print(f"✓ {ref} 已在 decision_refs 正欄(human 確認過),不重複塞 ai 欄")
            return 0
    for r in as_list(n.fields.get("decision_refs_ai")):
        if _dref_same(env, r, ref):
            print(f"✓ {ref} 已在 decision_refs_ai(冪等 no-op)")
            return 0
    canon = f"{tnode}#{did}"
    _append_decision_ref(env, rel, "decision_refs_ai", canon)
    print(f"✓ add-ai {rel}: decision_refs_ai += {canon}(標 by:ai;E3 firing 生效、抑制不了 E2)")
    return 0


def cmd_dref_list(env, rel_in, by=None):
    """[V4] 分欄列 ref。"""
    rel = env.find(rel_in)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {rel_in} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return 2
    n = env.notes.get(rel)
    fields = [("decision_refs", "human/confirmed")] if by == "human" else \
             [("decision_refs_ai", "ai")] if by == "ai" else \
             [("decision_refs", "human/confirmed"), ("decision_refs_ai", "ai")]
    for fld, label in fields:
        vals = as_list(n.fields.get(fld))
        print(f"  [{label}] {fld}:" + (" (空)" if not vals else ""))
        for v in vals:
            print(f"    - {v}")
    return 0


def cmd_dref_prune(env, rel_in, ref, by=None):
    """[V5] 移除 ref(正規化定位)。--by 移該欄、無 --by 兩欄都移。區分真移除/本來不在。"""
    rel = env.find(rel_in)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {rel_in} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return 2
    n = env.notes.get(rel)
    flds = ["decision_refs"] if by == "human" else ["decision_refs_ai"] if by == "ai" \
           else ["decision_refs", "decision_refs_ai"]
    removed = []
    for fld in flds:
        for v in list(as_list(n.fields.get(fld))):
            if _dref_same(env, v, ref):
                if _dref_remove_ref(env, rel, fld, v):
                    removed.append(f"{fld}:{v}")
    if removed:
        print(f"✓ prune {rel}: 已移除 {', '.join(removed)}")
    else:
        print(f"✓ prune {rel}: 這條 ref 本來就不在(是不是打錯正規形?用 decision-refs list 對一下)")
    return 0


def _dref_remove_ref(env, rel, field, exact_val):
    """從 field 移除一筆逐字等於 exact_val 的 list 項(atomic_write_verify)。回 True=移除。"""
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if field not in struct:
        return False
    s, e, kind = struct[field]
    target_j = None
    for j in range(s + 1, e + 1):
        if fm[j].lstrip().startswith("-") and strip_quotes(fm[j].lstrip()[1:].strip()) == exact_val:
            target_j = j
            break
    if target_j is None:
        return False
    del fm[target_j]
    # 清完若 list 空→連 key 行移除(裸鍵被 YAML 解 null,doctor/lint 判讀比沒鍵更糟;照 edit_fm_remove,arch-f5)
    struct2 = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
    if field in struct2:
        s2, e2, _ = struct2[field]
        if not any(fm[j].strip().startswith("-") for j in range(s2 + 1, e2 + 1)):
            del fm[s2:e2 + 1]
    new_lines = lines[:1] + fm + lines[e_fm:]
    atomic_write_verify(path, new_lines, field,
                        lambda f: all(str(x).strip() != exact_val for x in as_list(f.get(field))))
    return True


def _dref_coverage_scan(env, rel, tidx):
    """[promote 覆蓋提醒] E2 對齊掃描:該節點指向的翻案決策中、正欄無 ref 命中的落後邊。
    回 (suppressed_with_id, no_id_dead):有 id 的用 _dref_same 判正欄命中;無 id 的另列(連補都補不了)。"""
    n = env.notes.get(rel)
    正欄 = as_list(n.fields.get("decision_refs")) if n else []
    suppressed, no_id_dead = [], []
    fwd = tidx["fwd"].get(rel, {})
    seen = set()
    for etype in _DREF_E2_FIELDS:   # 排 related,對齊 E2 typed_in
        for trel in fwd.get(etype, []):
            for d in _node_decisions(env, trel):
                if str(d.get("valid", "true")).lower() != "false":   # 只看翻案(valid:false)——parse_decisions 存字串,照 E2/cmd_decisions 慣例判(code-dref ext-f1 blocker:原 truthy 誤跳全部翻案)
                    continue
                did = str(d.get("id", "")).strip()
                content = first_line(str(d.get("content", "")), 50)
                if not did:
                    key = (trel, content)
                    if key not in seen:
                        seen.add(key)
                        no_id_dead.append(f"{trel}(翻案「{content}」,無 id)")
                    continue
                ref = f"{trel}#{did}"
                if (trel, did) in seen:
                    continue
                seen.add((trel, did))
                if not any(_dref_same(env, r, ref) for r in 正欄):
                    suppressed.append(f"{ref}(翻案「{content}」)")
    return suppressed, no_id_dead


def cmd_dref_promote(env, rel_in, ref):
    """[V6] _ai→decision_refs 抽查蓋章(升級可抑制 E2)。正規化全操作+dangling 拒+覆蓋提醒+雙欄原子。"""
    rel = env.find(rel_in)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {rel_in} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return 2
    nn = _dref_norm(env, ref)
    if not nn or not nn[1]:
        print(f"擋下:ref 要寫成 <節點>#dN 且節點解得到: {ref!r}", file=sys.stderr)
        return 2
    tnode, did = nn
    if not any(str(d.get("id", "")).strip() == did for d in _node_decisions(env, tnode)):
        print(f"擋下:{tnode} 沒有決策 {did}(dangling,拒 promote——防失效 ref 蓋章洗白)", file=sys.stderr)
        return 2
    canon = f"{tnode}#{did}"
    n = env.notes.get(rel)
    in_main = [v for v in as_list(n.fields.get("decision_refs")) if _dref_same(env, v, ref)]
    in_ai = [v for v in as_list(n.fields.get("decision_refs_ai")) if _dref_same(env, v, ref)]
    # 冪等分支
    if not in_ai and in_main:
        print(f"✓ {canon} 已在正欄(冪等 no-op)")
        return 0
    if not in_ai and not in_main:
        print(f"擋下:{canon} 兩欄都沒有,promote 沒對象——先 add-ai", file=sys.stderr)
        return 2
    # 覆蓋提醒(不擋,人裁;但不得靜默)
    tidx = build_typed_index(env)
    suppressed, no_id_dead = _dref_coverage_scan(env, rel, tidx)
    other = [s for s in suppressed if not _dref_same(env, s.split("(")[0], ref)]
    if not as_list(n.fields.get("decision_refs")) and (other or no_id_dead):
        print("  ⚠ 覆蓋提醒:這一蓋讓正欄非空,E2 將只警告被 ref 命中的翻案決策——本節點以下翻案落後邊會被連帶靜默:")
        for s in other:
            print(f"      {s}(可補 ref 解)")
        for s in no_id_dead:
            print(f"      {s} ★連補都補不了:先 reindex 給 id、或明知會被無條件壓掉仍蓋章★")
    # 雙欄原子:remove _ai 命中、add 正欄一份、一次寫
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    # 移 _ai 所有命中
    if "decision_refs_ai" in struct:
        s, e, _k = struct["decision_refs_ai"]
        for j in range(e, s, -1):
            if j < len(fm) and fm[j].lstrip().startswith("-") and _dref_same(env, strip_quotes(fm[j].lstrip()[1:].strip()), ref):
                del fm[j]
        # 清完若 _ai list 空→連 key 行移除(arch-f5:promote 手刪段也漏,r1 只補了 prune)
        struct = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
        if "decision_refs_ai" in struct:
            _sa, _ea, _ = struct["decision_refs_ai"]
            if not any(fm[j].strip().startswith("-") for j in range(_sa + 1, _ea + 1)):
                del fm[_sa:_ea + 1]
        struct = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
    # 加正欄(若正欄尚無命中)——共用插入(code-dref arch-f4)
    if not in_main:
        _st = {k: kind for k, _s, _e, kind in fm_structure(fm)}
        if _st.get("decision_refs") not in (None, "list"):   # s1-f4:非清單型清楚擋
            print("擋下:decision_refs 欄位不是清單型,沒辦法 promote 進去(先修正 frontmatter)", file=sys.stderr)
            return 2
        _fm_list_insert(fm, "decision_refs", '"' + canon + '"')
    new_lines = lines[:1] + fm + lines[e_fm:]

    def _check(f):
        main_hits = sum(1 for v in as_list(f.get("decision_refs")) if _dref_same(env, v, ref))
        ai_hits = sum(1 for v in as_list(f.get("decision_refs_ai")) if _dref_same(env, v, ref))
        return main_hits == 1 and ai_hits == 0
    atomic_write_verify(path, new_lines, "decision_refs", _check)
    print(f"✓ promote {rel}: {canon} 從 _ai 搬進正欄(升級可抑制 E2)")
    return 0


def cmd_rel_cascade_write(env, verb, neighbor, cascade_id, from_id, edge, by):
    """[M3] confirm|prune:append 一筆 transition。寫前驗證(R4):檔存在(不存在→拒,建檔只屬觸發端)、
    header 合法(torn→拒,與 resume rc=1 救援語意按指令類別分流)、--from==header root(全鏈同源)。"""
    _validate_cascade_id(cascade_id)
    _validate_from_gid(from_id)
    nrel = env.find(neighbor)
    if nrel is None:
        raise ValueError(f"找不到相鄰的那篇筆記: {neighbor}")
    p = _rel_cascade_dir(env) / (cascade_id + ".jsonl")
    if not p.exists():
        raise ValueError(f"找不到 cascade 帳本 {cascade_id}——帳本只會在 decision-supersede 翻案時建立,confirm/prune 不會自己建")
    header, _ = _ledger_read(p)
    if header is None:
        raise ValueError("cascade 帳本的開頭壞了,不寫;用 resume 會把它標成不可恢復,後續靠健檢的 E2 補抓")
    if header.get("root_decision_id") != from_id.strip():
        raise ValueError(f"--from 指的決策不屬本 cascade(這本帳的起點是 {header.get('root_decision_id')}),一本帳只追同一條翻案鏈")
    state = "confirmed" if verb == "confirm" else "pruned"
    _ledger_append(p, {"event": "transition", "ts": _utc_ts(), "neighbor": nrel,
                       "edge_type": edge, "from_decision_id": from_id.strip(),
                       "state": state, "by": by})
    print(f"✓ rel-cascade {verb} {nrel} --edge {edge} ({cascade_id}, by={by})")
    # [decision_refs 自動養成 T1] confirm = 地面真相「鄰居依賴這條決策」→ 回寫 decision_ref。
    #   provenance 雙欄不對稱信任:by ai → decision_refs_ai(E3 firing 生效、E2 抑制碰不到);
    #   by human → decision_refs(可抑制 E2)。prune 不回寫(判無關=不記依賴)。
    #   回寫失敗=軟警告不回滾(帳本才是地面真相,decision_refs 是衍生、可從帳本重建)。
    if verb == "confirm":
        # [code-loop r1 C-medium] fail-**safe**:只有明確 by==human 才落可信正欄;非 ai/human
        #   (None/打錯/未來新值)一律落不可信 ai 欄——安全守門不靠上游 argparse 撐(誤落正欄=可抑制 E2)
        field = "decision_refs" if by == "human" else "decision_refs_ai"
        try:
            if _append_decision_ref(env, nrel, field, from_id.strip()):
                print(f"  ↳ decision_refs 養成: {nrel}.{field} += {from_id.strip()}")
        except Exception as _e:
            # [code-loop r1 CX2] 不過度承諾:reconcile 命令尚未實作(列 future),此處僅記帳本已提交
            print(f"  ⚠ decision_ref 回寫失敗(帳本已記為地面真相;節點欄位本次未同步): {_e}", file=sys.stderr)
    return 0


def cmd_rel_cascade_list(env, stale_days=None):
    """[M3] 以活動齡列 cascade(--stale N=最後事件 ts 早於 N 天;不判開放/完成精確分類——
    活動齡才是可算的 crash/失敗偵測器)。stdout、查無 rc=0 空輸出。"""
    import datetime
    d = _rel_cascade_dir(env)
    if not d.exists():
        return 0
    now = datetime.datetime.now(datetime.timezone.utc)
    for p in sorted(d.glob("*.jsonl")):
        header, trans = _ledger_read(p)
        cid = p.stem
        root = header.get("root_decision_id") if header else "(header 損毀,root 不可恢復)"
        all_ts = [o.get("ts", "") for o in ([header] if header else []) + trans if o.get("ts")]
        last = max(all_ts) if all_ts else ""
        if stale_days is not None and last:
            try:
                age = (now - datetime.datetime.fromisoformat(last)).days
            except ValueError:
                age = None
            if age is not None and age < stale_days:
                continue
        folded = _ledger_fold(trans)
        n_c = sum(1 for t in folded.values() if t.get("state") == "confirmed")
        n_p = sum(1 for t in folded.values() if t.get("state") == "pruned")
        print(f"{cid}  root={root}  last={last or '?'}  confirmed={n_c} pruned={n_p}")
    return 0


def _typed_hop1(env, node_rel, idx=None):
    """[M4/S2] typed hop-1 原語:在 [P0] typed 索引上列「誰以方向語意明確的邊指向 node」單層鄰居。
    多跳/visited 交 [S4] 編排(resume/判斷閘)。回 (neighbors=[(src,etype,invariant數)], ambigs=[(字面,候選數)])。"""
    if idx is None:
        idx = build_typed_index(env)
    neighbors, ambigs = [], []
    for (src, etype) in idx["rev"].get(node_rel, []):
        if etype not in REL_CASCADE_EDGES:
            continue
        inv_n = len(extract_contracts(env.notes[src])[0]) if src in env.notes else 0
        neighbors.append((src, etype, inv_n))
    for (asrc, lit, aetype, cands) in idx["ambiguous"]:
        if node_rel in cands and aetype in REL_CASCADE_EDGES:
            ambigs.append((lit, len(cands)))
    return neighbors, ambigs


def cascade_surface(env, node_rel, root_decision_id, stream=None):
    """[M4/S1] surfacing 印行器:對 ledger 唯讀、不叫 AI(判斷閘=外部 agent 步驟)。
    NEIGHBOR 行由本函式印(dispatcher 印 CASCADE 行——它持有 mint 的 id 與 root id,T2 職責切分)。
    行式 schema=交接通道(編排者從此組 confirm/prune 參數)。回攤出的鄰居數。"""
    out = stream if stream is not None else sys.stderr
    neighbors, ambigs = _typed_hop1(env, node_rel)
    for (src, etype, inv_n) in neighbors:
        tag = f" INVARIANT_COUNT {inv_n}" if inv_n else ""
        print(f"NEIGHBOR {src} EDGE {etype}{tag}", file=out)
    for (lit, n) in ambigs:
        print(f"NEIGHBOR-AMBIG {lit} CANDIDATES {n}", file=out)
    return len(neighbors) + len(ambigs)


def cmd_impact_node(node_arg, repo=None, as_json=False):
    """[M4/S2] impact 第三模式 CLI 皮(供人手動查;自動迴圈走進程內原語不 shell-out):
    typed hop-1 列「誰依賴我」。與 --file/--diff 互斥、與 --depth 互斥(單層列舉無深度語意)。"""
    import json
    start = Path(repo).resolve() if repo else Path.cwd()
    vault = find_vault(start)
    if vault is None:
        # ★三條路同一套說法、同一個退出碼★(2026-09-07 全 repo 審視 #9)
        return _no_vault_msg()
    env = Env(vault)
    rel = env.find(node_arg)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {node_arg} 的筆記,先確認名稱或路徑", file=sys.stderr)
        return 2
    neighbors, ambigs = _typed_hop1(env, rel)
    if as_json:
        print(json.dumps({"node": rel,
                          "neighbors": [{"rel": s, "edge": e, "invariant_count": n}
                                        for (s, e, n) in neighbors],
                          "ambiguous": [{"literal": l, "candidates": n} for (l, n) in ambigs]},
                         ensure_ascii=False))
        return 0
    print(f"NODE {rel}  typed-hop1 連入(verified_by/plan_refs;related 弱恆不展):")
    for (src, etype, inv_n) in neighbors:
        tag = f" INVARIANT_COUNT {inv_n}" if inv_n else ""
        print(f"  NEIGHBOR {src} EDGE {etype}{tag}")
    for (lit, n) in ambigs:
        print(f"  NEIGHBOR-AMBIG {lit} CANDIDATES {n}")
    if not neighbors and not ambigs:
        print("  (無 typed 連入鄰居)")
    return 0


def cmd_rel_cascade_resume(env, cascade_id):
    """[M3] 「續」的交付項(D16):重放折疊→取 header root→重展 root+最終態 confirmed 鄰居
    (先 confirm 後 prune 不重展)→對粒度鍵差集→列剩餘待判。decision_id=root 全鏈攜帶(R3)。
    輸出:首行 CASCADE 行(編排者跨 session 拿 --from 不需讀檔)+NEIGHBOR 行 schema。
    中斷接續/escalate 待人項/誤 prune 翻案補跑下游 三場景共用。torn header → rc=1。"""
    _validate_cascade_id(cascade_id)
    p = _rel_cascade_dir(env) / (cascade_id + ".jsonl")
    if not p.exists():
        raise ValueError(f"找不到 cascade 帳本: {cascade_id}")
    header, trans = _ledger_read(p)
    if header is None:
        print(f"✗ {cascade_id}: header 損毀,root 不可恢復——本 cascade 放棄,交補網 E2 兜底", file=sys.stderr)
        return 1
    root_gid = header.get("root_decision_id", "")
    pending = _rel_cascade_pending(env, header, trans, quiet=False)
    print(f"CASCADE {cascade_id} ROOT {root_gid}")
    for line in pending:
        print(line)
    return 0


def _rel_cascade_pending(env, header, trans, quiet=True):
    """回這張單「還剩哪些鄰居沒判」的行清單(空清單=沒東西可判)。

    ★唯一實作★:resume 與 visited 都問這一支,不各寫一份——這個 repo 已經為
    「同一個問題長出第二份獨立實作」付過兩次學費。visited 要判「這張單是不是真的空」,
    問的就是同一件事,差別只在它不印、只看空不空。
    """
    root_gid = header.get("root_decision_id", "")
    node = header.get("node", "")
    state = _ledger_fold(trans)
    confirmed = sorted({k[0] for k, t in state.items() if t.get("state") == "confirmed"})
    seeds = [node] + [c for c in confirmed if c != node]
    idx = build_typed_index(env)
    pending, seen, expanded = [], set(), set()
    for s in seeds:   # visited=root∪最終態 confirmed;粒度鍵冪等,重複展開無害只多列
        if s in expanded:   # 菱形:同節點經兩路抵達 → 不再展,stderr 留痕(反靜默紀律)
            if not quiet:
                print(f"CASCADE-SKIP 已展過不重展: {s}", file=sys.stderr)
            continue
        expanded.add(s)
        neighbors, ambigs = _typed_hop1(env, s, idx=idx)
        for (src, etype, inv_n) in neighbors:
            k = (src, etype, root_gid)
            if k in state or k in seen:
                continue
            seen.add(k)
            tag = f" INVARIANT_COUNT {inv_n}" if inv_n else ""
            pending.append(f"NEIGHBOR {src} EDGE {etype}{tag}")
        for (lit, n) in ambigs:
            if (s, lit) not in seen:
                seen.add((s, lit))
                pending.append(f"NEIGHBOR-AMBIG {lit} CANDIDATES {n}")
    return pending


def cmd_rel_cascade_visited(env, cascade_id, from_id):
    """[2026-09-16] 空的連鎖待辦單記一筆「巡過」,讓體檢不再嘮叨。

    出身(Issues/空連鎖單巡過無法銷帳,2026-08-31 立、2026-09-01 Enzo 委任裁辦):
    決策翻案會自動開一張「去看看誰還引用舊決策」的待辦單。單如果★天生是空的★
    (翻案當下沒人引用),就沒有東西可判——但體檢認「有判定才算看過」,於是空單會被
    嘮叨到天荒地老,嘮叨久了人就學會忽略,正是提醒麻痺型。2026-09-16 實測 15 張零判定
    的單裡★14 張是空的★,命中那篇 Issue 自己寫的升級條件「又一張空票出現」。

    ★與「零筆=沒看過」那條裁定相容★(Projects/連鎖佇列軟提醒_計劃 d2):嘮叨偵測的是
    「你從沒看過這張單」,巡過就是看過了,該閉嘴。

    ★這個動詞唯一的危險是變成萬用消音鍵★,所以「空不空」★當場機械驗★:
    重放帳本、展開待判鄰居,真的一個都沒有才准記。呼叫的人說了不算。
    """
    _validate_cascade_id(cascade_id)
    _validate_from_gid(from_id)
    p = _rel_cascade_dir(env) / (cascade_id + ".jsonl")
    if not p.exists():
        raise ValueError(f"找不到 cascade 帳本 {cascade_id}——帳本只會在 decision-supersede 翻案時建立")
    header, trans = _ledger_read(p)
    if header is None:
        raise ValueError("cascade 帳本的開頭壞了,不寫;用 resume 會把它標成不可恢復")
    if header.get("root_decision_id") != from_id.strip():
        raise ValueError(f"--from 指的決策不屬本 cascade(這本帳的起點是 {header.get('root_decision_id')})")
    # ★展不開不等於空★(2026-09-16 代碼審 r1 外家席):起點筆記被刪掉或改名之後,
    # 展開鄰居會得到零筆,但那是「問不到」不是「真的沒人引用」——當成空單放行,
    # 等於把還沒確認完的待辦悄悄消掉。所以先確認起點還在。
    if not env.resolve(header.get("node", "")):
        print(f"擋下:這張單的起點筆記找不到了({header.get('node', '')}),不能記巡過。", file=sys.stderr)
        print("  為什麼在意:起點不在就展不開鄰居,結果會是零筆——那是問不到,"
              "不是真的沒東西可判;當成空單記下去會把還沒確認完的待辦消音。", file=sys.stderr)
        print("  接下來:確認那篇是被改名還是真的刪了,再決定這張單要不要作廢:", file=sys.stderr)
        print(f"    lumos rel-cascade resume {cascade_id}", file=sys.stderr)
        return 2
    pending = _rel_cascade_pending(env, header, trans)
    if pending:
        print(f"擋下:這張單還有 {len(pending)} 個鄰居沒判,不能記巡過。", file=sys.stderr)
        print("  為什麼在意:巡過是給「天生沒東西可判」的空單用的;"
              "有待判的還記巡過,等於把該回頭看的事消音。", file=sys.stderr)
        print("  接下來:逐篇判完再說,看還剩哪些:", file=sys.stderr)
        print(f"    lumos rel-cascade resume {cascade_id}", file=sys.stderr)
        return 2
    _ledger_append(p, {"event": "visited", "ts": _utc_ts(),
                       "from_decision_id": from_id.strip(),
                       "note": "空單:重放當下零個待判鄰居"})
    print(f"✓ rel-cascade visited {cascade_id}(空單,零個待判鄰居;體檢不再把它算成沒看過)")
    return 0


