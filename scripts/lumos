    background:rgba(15,18,25,.92);text-shadow:0 1px 3px rgba(0,0,0,.9)}  /* 醒目:純白字、底更不透明(2026-09-11) */
  #legend .lt{font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:1.4px;text-transform:uppercase;color:#d6dcea;margin-bottom:10px}
