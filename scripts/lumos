<div id="hint">點節點 → 高亮鄰域 + 飛入聚焦 · 拖曳旋轉 · 滾輪縮放 · 右鍵平移</div>
<script>
const DATA = __DATA__;
const TYPE_COLOR = {system:'#6ba5ff',verification:'#4fd6a8',issue:'#f5b15c',project:'#b98cff',moc:'#8b93ad'};
const GOLD='#ffd479', STALE='#ff7b91', DIMN='#151924', DIML='rgba(74,84,116,.035)';
const LINKBASE={verify:'#4fd6a8',plan:'#b98cff',link:'rgba(116,129,166,.55)'};   // 2026-09-11 分層:計劃/驗證線對齊圖例色、明顯;佔多數的一般連結帶透明度保持安靜(全部調亮會亂)
const tc = t => TYPE_COLOR[t] || '#8b93ad';
const byId = {}; DATA.nodes.forEach(n=>byId[n.id]=n);
function baseColor(n){ if(n.status==='stale') return STALE; if(n.inv&&n.inv.length) return GOLD; return tc(n.type); }

// 3d-force-graph 會把 link.source/target 由 id 字串置換成 node 物件參照(= gdata.nodes 的同一物件)
const gdata = {nodes:DATA.nodes, links:DATA.edges.map(e=>({source:e.source,target:e.target,kind:e.kind}))};
const nodeOf = x => (x && x.id!==undefined) ? x : byId[x];

// ---- 高亮狀態(點選 = 只亮鄰域,其餘暗化)----
const hlN=new Set(), hlL=new Set(); let sel=null, hoverN=null;
const types=[...new Set(DATA.nodes.map(n=>n.type))];
const active=new Set(types); let staleOnly=false;
// 擴充狀態:只看合約 / 驗證摺疊(預設開) / 時間軸
let invOnly=false, vFold=true, timeCut=null;
// 合約鏡頭集合:合約節點 + 它們 verify 邊指到的驗證節點(守衛證據一起看)
const contractSet=new Set(DATA.nodes.filter(n=>n.inv&&n.inv.length));
const contractVerif=new Set();
DATA.edges.forEach(e=>{ if(e.kind==='verify'&&byId[e.source]&&contractSet.has(byId[e.source])) contractVerif.add(byId[e.target]); });
// 每節點掛幾筆驗證(摺疊徽章)+ 日期數字(時間軸)
const vout={};
DATA.edges.forEach(e=>{ if(e.kind==='verify'&&byId[e.target]&&byId[e.target].type==='verification') vout[e.source]=(vout[e.source]||0)+1; });
DATA.nodes.forEach(n=>{ n.dnum=n.date?parseInt(n.date.replace(/-/g,''))||0:0; });
// 標籤 LOD 重要度排名:合約>樞紐>系統/索引;驗證葉最後
DATA.nodes.slice().sort((a,b)=>
  ((b.inv&&b.inv.length?10:0)+b.indeg+(b.type==='moc'?6:b.type==='system'?4:0)-(b.type==='verification'?3:0))
 -((a.inv&&a.inv.length?10:0)+a.indeg+(a.type==='moc'?6:a.type==='system'?4:0)-(a.type==='verification'?3:0))
).forEach((n,i)=>n.lrank=i);
function nvisible(n){
  if(!active.has(n.type)) return false;
  if(staleOnly && n.status!=='stale') return false;
  if(invOnly && !(contractSet.has(n)||contractVerif.has(n))) return false;
  if(timeCut!==null && n.dnum>timeCut) return false;
  if(vFold && n.type==='verification' && !hlN.has(n)) return false;  // 摺疊:選中母節點才現形
  return true;
}

function ncolor(n){ if(hlN.size && !hlN.has(n)) return DIMN; if(n===sel) return '#ffffff'; return baseColor(n); }
function lcolor(l){ if(hlL.size && !hlL.has(l)) return DIML; return LINKBASE[l.kind]||'#2d3346'; }
function lwidth(l){ if(hlL.has(l)) return 2.6; return l.kind==='link'?0.35:0.7; }
function lparticles(l){ return (hlL.has(l) || (hlL.size===0 && l.kind==='plan'))?2:0; }
function larrow(l){ if(hlL.size) return hlL.has(l)?4:0; return l.kind==='link'?1.6:2.6; }
function pcolor(l){ return l.kind==='plan'?'#f3e8ff':(l.kind==='verify'?'#dcfff2':'#ffffff'); }   // 粒子用亮色,跟線拉開對比才看得出在流動

const Graph = ForceGraph3D()(document.getElementById('cy'));

// ★ 力場必須在 graphData 之前設定:warmup 在 graphData 當下就用當時的力場把佈局跑完;
//   若事後才改強斥力,模擬已冷卻、救不回 → 永遠擠成「病毒團」。這圖很密(~11 邊/點),
//   link 吸引力會壓過斥力,故大幅加強斥力 + 拉長連線 + 減弱 link 拉力。
Graph.d3Force('charge').strength(-240);
Graph.d3Force('link').distance(l => l.kind==='plan' ? 90 : 65).strength(0.18);
Graph.d3VelocityDecay(0.3);

Graph
  .graphData(gdata)
  .warmupTicks(70)        // 首次繪製前先跑 70 tick(用上面強斥力)→ 一開圖就是攤開的星座,不靠時機
  .cooldownTicks(160)
  .backgroundColor('rgba(0,0,0,0)')
  .showNavInfo(false)
  .nodeRelSize(4)
  .nodeVal(n=>0.8+Math.pow(Math.min(n.indeg,18),1.15)*0.4)
  .nodeColor(ncolor)
  .nodeOpacity(0.9)
  .nodeResolution(18)
  // ★節點名用純白★(2026-09-10 Enzo:原本 #edeff6 在深色底上太淡)。
  // 後面那段型別標註同時提亮一階(#7c8398 → #a8b0c4):它原本淡到幾乎看不見,
  // 而那裡寫的是「這是什麼型別、有沒有過期、幾條合約」——是要看的資訊不是裝飾。
  .nodeLabel(n=>'<div style="font:600 12px Space Grotesk,sans-serif;color:#ffffff;background:rgba(15,18,25,.92);padding:5px 10px;border:1px solid #2a3145;border-radius:8px;box-shadow:0 6px 20px -6px rgba(0,0,0,.7)">'+n.label+'<span style="color:#a8b0c4;font-weight:400"> · '+n.type+(n.status==='stale'?' · stale':'')+(n.inv&&n.inv.length?' · ★'+n.inv.length:'')+'</span></div>')
  .linkColor(lcolor)
  .linkOpacity(0.38)
  .linkWidth(lwidth)
  .linkDirectionalArrowLength(larrow)
  .linkDirectionalArrowRelPos(1)
  .linkDirectionalParticles(lparticles)
  .linkDirectionalParticleWidth(1.9)
  .linkDirectionalParticleSpeed(0.007)
  .linkDirectionalParticleColor(pcolor)
  .nodeVisibility(nvisible)
  .linkVisibility(l=>nvisible(nodeOf(l.source))&&nvisible(nodeOf(l.target)))
  .onNodeClick(focusNode)
  .onNodeHover(n=>{ hoverN=n||null; document.getElementById('cy').style.cursor=n?'pointer':null; })
  .onBackgroundClick(clearSel);

// ---- 點擊容差:微幅拖曳(旋轉手震)吃掉 click 時,用 pointerup 距離判定兜底 ----
let pdown=null, lastFocusTs=0;
const cyEl=document.getElementById('cy');
cyEl.addEventListener('pointerdown',e=>{ pdown=[e.clientX,e.clientY]; },true);
cyEl.addEventListener('pointerup',e=>{
  if(!pdown) return;
  const moved=Math.hypot(e.clientX-pdown[0],e.clientY-pdown[1]); pdown=null;
  if(moved<5 && hoverN && Date.now()-lastFocusTs>250) focusNode(hoverN);
},true);

// 貼合 top bar 下方的容器尺寸(預設會用整個 window 高度,會被頂欄遮 64px)
function sizeGraph(){ Graph.width(window.innerWidth).height(window.innerHeight-64); }
sizeGraph(); window.addEventListener('resize', sizeGraph);

// ---- 常駐節點標籤:HTML 疊層逐幀同步到節點螢幕座標 ----
// 不依賴 three-spritetext(會逼出全域 THREE,風險高、離線臃腫);改用 graph2ScreenCoords 投影,
// 用 Graph.camera() 既有的 Vector3 做前/後剔除(不需自帶 THREE)。
const labLayer=document.getElementById('labels'), labOf=new Map();
DATA.nodes.forEach(n=>{ const d=document.createElement('div'); d.className='nlab';
  d.textContent=n.label+(vout[n.id]?' ✓'+vout[n.id]:'');  // ✓N=掛幾筆驗證(摺疊時的存在感)
  d.style.fontSize=(11+Math.min(n.indeg,16)*0.25)+'px';  // 樞紐字略大,先被看見
  labLayer.appendChild(d); labOf.set(n,d); });
function syncLabels(){
  requestAnimationFrame(syncLabels);
  const cam=Graph.camera(); if(!cam||!cam.position) return;
  const fwd=cam.position.clone(); cam.getWorldDirection(fwd);           // 相機朝向(Vector3,複用內建 THREE)
  const p=cam.position.clone();
  const camDist=cam.position.length()||1;                              // 相機到圖心(力場置中於原點)的距離 → 淡出基準,與縮放無關
  const W=window.innerWidth, H=window.innerHeight-64;
  // 標籤 LOD:拉遠只留重要節點的名字,拉近逐步全開;hover/選中/鄰域永遠顯示
  const budget = camDist>1200?20 : camDist>700?45 : camDist>420?90 : 9999;
  DATA.nodes.forEach(n=>{
    const d=labOf.get(n);
    if(!nvisible(n)){ d.style.opacity=0; return; }                     // type chip / 只看 stale 過濾
    if(n.lrank>=budget && n!==hoverN && n!==sel && !hlN.has(n)){ d.style.opacity=0; return; }  // LOD 淘汰
    p.set(n.x||0,n.y||0,n.z||0);
    const to=p.clone().sub(cam.position);
    if(to.dot(fwd)<=0){ d.style.opacity=0; return; }                   // 在相機背後 → 不畫
    const s=Graph.graph2ScreenCoords(n.x||0,n.y||0,n.z||0);
    if(s.x<-40||s.x>W+40||s.y<-20||s.y>H+20){ d.style.opacity=0; return; }  // 出畫面
    d.style.transform='translate('+(s.x)+'px,'+(s.y-13)+'px) translateX(-50%)';  // 置中、略抬到球頂上方
    const dim = hlN.size && !hlN.has(n);                               // 點選聚焦時,非鄰域更淡
    const far = Math.min(1, (camDist*1.2)/(to.length()||1));           // 相對相機距離淡出(縮放不變)→ 框全圖時仍清楚可見
    d.style.opacity = (dim?0.25:1) * (0.8+0.2*far);                  // 一般標籤全亮,只留一點遠近淡出
  });
}
requestAnimationFrame(syncLabels);

function refresh(){
  Graph.nodeColor(ncolor).linkColor(lcolor).linkWidth(lwidth)
       .linkDirectionalArrowLength(larrow).linkDirectionalParticles(lparticles);
}
function applyVis(){
  Graph.nodeVisibility(nvisible)
       .linkVisibility(l=>nvisible(nodeOf(l.source))&&nvisible(nodeOf(l.target)));
}

// ---- 點選節點:只高亮自己+鄰居+相連邊,飛入聚焦 ----
const navStack=[];
function focusNode(n, fromBack){
  if(sel && sel!==n && !fromBack) navStack.push(sel);
  document.getElementById('back').classList.toggle('show', navStack.length>0);
  lastFocusTs=Date.now();
  document.getElementById('search').value='';   // 點選節點=離開搜尋:清掉搜尋字,免得畫面已是鄰域卻看起來還在篩選(2026-09-11);程式設值不觸發 input,不會把鄰域蓋回搜尋結果
  hlN.clear(); hlL.clear(); sel=n; hlN.add(n);
  gdata.links.forEach(l=>{
    const s=nodeOf(l.source), t=nodeOf(l.target);
    if(s===n){ hlL.add(l); hlN.add(t); }
    else if(t===n){ hlL.add(l); hlN.add(s); }
  });
  refresh(); applyVis();   // 驗證摺疊的現形依賴 hlN → 選中時要重算可見性
  const dist=180, h=Math.hypot(n.x||1,n.y||1,n.z||1)||1, r=1+dist/h;
  Graph.cameraPosition({x:(n.x||0)*r,y:(n.y||0)*r,z:(n.z||0)*r}, n, 1100);
  open(n);
}
