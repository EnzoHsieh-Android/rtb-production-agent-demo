def _fill_help_when(parser, parent=""):
    """遞迴把 HELP_WHEN 灌進每個沒有 description 的子指令,讓 `lumos X --help` 第一行講人話。
    同名二層子指令(cochange check / code-loop check)先查「父 子」鍵再退回單名。"""
    for act in parser._actions:
        if isinstance(act, argparse._SubParsersAction):
            for name, sp in act.choices.items():
                if not sp.description:
                    when = HELP_WHEN.get(f"{parent} {name}".strip()) or HELP_WHEN.get(name)
                    if when:
                        sp.description = "什麼時候用:" + when
                _fill_help_when(sp, name)

def main():
    class _LumosParser(argparse.ArgumentParser):
        """打錯指令時給人話 + 近名候選,不要吐一長串英文。

        出身(2026-09-07 全 repo 審視 #9):打錯一個字母(例如 doctorr),argparse 預設會印
        usage 那行(把 66 個指令名擠成一串)再加一句英文 invalid choice,後面又把 66 個名字
        用引號逐個列一遍——**畫面上出現三次同一份清單,而使用者要的只是「你是不是想打 doctor」**。

        放在 main() 裡面(全檔唯一一個巢狀 class,2026-09-07 代碼審 r1 架構席問過):
        它只有 main() 建 parser 時用得到,而且訊息內容綁著 main() 底下那份三步入口的措辭;
        提到模組層會讓人以為別處也該拿它當一般工具用,反而要多寫一段「只給 main 用」的說明。
        """

        def error(self, message):
            # ★用既有的近名判準,不開第三支★(2026-09-07 代碼審 r1 架構席):
            # 這個 repo 已經有兩支同型工具——_levenshtein_le1(只判差一個字,給開頭欄位鍵用)
            # 與 _el_near_name(剝日期前綴後比相似度,給節點名用)。第一版我又用標準庫
            # 另建了第三支,正好犯了旁邊幾十行就寫著的既有規矩「禁第 N 份同型」。
            # 指令名跟節點名同型(都是「使用者打錯了一個像樣的名字」),所以共用後者。
            # ★候選池從錯誤訊息本身抓,不要自己去猜是哪個參數★
            # (2026-09-07 代碼審 r1 通才席):第一版拿「_actions 裡第一個有 choices 的」
            # 當候選池,於是子命令有兩個以上限定值參數時整個判錯——實測
            # `loop next X --orchestrator cladue` 印成「沒有『cladue』這個指令」
            # (它不是指令,是參數值),還拿另一個參數的選項去比,
            # 連「cladue → claude」這麼明顯的建議都給不出來。
            # argparse 的原句本來就把「哪個參數」與「有哪些選項」都寫進去了,照著讀最準。
            m = re.search(r"invalid choice: '([^']+)'", message or "")
            bad = m.group(1) if m else None
            _am = re.search(r"argument ([^:]+): invalid choice", message or "")
            which = _am.group(1).strip() if _am else None
            _cm = re.search(r"\(choose from ([^)]*)\)", message or "")
            names = [c.strip().strip("'\"") for c in _cm.group(1).split(",")] if _cm else []
            # ★子命令那層的內部名字都以 cmd 結尾★(cmd / lcmd / gcmd / accmd …),
            #   第一版判「開頭是 cmd」,於是 `lumos loop zzz` 被當成「參數值錯」,
            #   印出「lcmd 不接受這個值」——那是內部代號,使用者根本沒看過。
            arg_val = bool(bad and which and not which.endswith("cmd"))
            if arg_val:
                print(f"擋下:{which} 不接受「{bad}」這個值。", file=sys.stderr)
            elif bad:
                print(f"擋下:沒有「{bad}」這個指令。", file=sys.stderr)
            elif "required: cmd" in (message or ""):
                # ★裸打是最常見的第一次接觸★:不要丟一句英文的「缺少必填參數」給人。
                print("擋下:要給一個指令才知道你想做什麼。", file=sys.stderr)
                print("  第一次用的話,照這三步走:", file=sys.stderr)
                print("      lumos search <關鍵字>     先找有沒有人寫過", file=sys.stderr)
                print("      lumos context <節點>      看那一篇在講什麼", file=sys.stderr)
                print("      lumos contracts <節點>    動它之前有什麼不能碰的", file=sys.stderr)
            else:
                # 其他參數錯:argparse 的原句準確指出是哪個參數,那部分照用;
                # 但英文的模板句換成白話——這些也是「第一眼」會看到的畫面。
                _msg = message or ""
                _req = re.search(r"the following arguments are required: (.+)", _msg)
                _int = re.search(r"argument ([^:]+): invalid int value: '([^']*)'", _msg)
                _unk = re.search(r"unrecognized arguments: (.+)", _msg)
                if _req:
                    print(f"擋下:少了必須要給的 {_req.group(1)}。", file=sys.stderr)
                elif _int:
                    print(f"擋下:{_int.group(1)} 要給整數,收到的是「{_int.group(2)}」。",
                          file=sys.stderr)
                elif _unk:
                    print(f"擋下:不認得這幾個參數:{_unk.group(1)}。", file=sys.stderr)
                else:
                    # 認不得的錯法就原樣轉述——原句總比我瞎猜準確
                    print(f"擋下:{_msg}", file=sys.stderr)
            if bad and names:
                near = [n3 for n3 in names if _el_near_name(bad, n3)][:3]
                if near and arg_val:
                    print("  是不是想寫這個:", file=sys.stderr)
                    for n2 in near:
                        print(f"      {which} {n2}", file=sys.stderr)
                elif near:
                    print("  是不是想打這個:", file=sys.stderr)
                    for n2 in near:
                        print(f"      lumos {n2}", file=sys.stderr)
                elif arg_val:
                    print(f"  {which} 只收這幾個:{', '.join(names)}", file=sys.stderr)
                else:
                    print("  沒有名字接近的。看有哪些指令、各自什麼時候用:", file=sys.stderr)
                    # ★指到自己這一層的說明★:子命令的子命令(例如 loop 底下那些)
                    #   出錯時,該看的是 `lumos loop --help` 而不是頂層那份。
                    print(f"      {self.prog} --help", file=sys.stderr)
            else:
                print("  看用法:", file=sys.stderr)
                print(f"      {self.prog} --help", file=sys.stderr)
            self.exit(2)

    ap = _LumosParser(prog="lumos", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--vault", type=Path, default=None,
                    help="vault 路徑 (預設自動找 docs/*-knowledge)")
    ap.add_argument("--version", action=_VersionAction,
                    help="印這支 lumos 的版本與內容指紋(不代表整台機器都是這一版)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("doctor", help="圖譜健康巡檢")
    d.add_argument("--strict", action="store_true", help="有 finding 即 exit 1 (CI 用)")
    d.add_argument("--ci", action="store_true", help="CI 模式 = --strict + 無色彩(+軟提醒全列)")
    d.add_argument("--verbose", action="store_true", help="軟提醒全列(預設每段最多 3 條,硬檢查不受影響)")
    d.add_argument("--suggest", action="store_true",
                   help="orphan Verification 附推薦掛載 Systems(從正文連結/plan_refs/feature 推斷,供人確認)")

    for name, hlp in (("links", "連出的節點"), ("backlinks", "連入的節點")):
        p = sub.add_parser(name, help=hlp)
        p.add_argument("note")

    p = sub.add_parser("context", help="節點+鄰居壓縮索引")
    p.add_argument("note")
    p.add_argument("--brief", action="store_true", help="壓縮版(meta+summary 首兩行+鄰居名單)")
    p.add_argument("--recommend", action="store_true", help="尾列相關節點推薦(圖分×詞彙融合;dormant v1)")
    p.add_argument("--top", type=int, default=8, dest="ctx_top", help="--recommend 輸出上限")
    p.add_argument("--min-score", type=float, default=0.20, dest="ctx_min", help="--recommend 分數底線")
    p.add_argument("--json", action="store_true", dest="ctx_json", help="--recommend JSON 輸出")

    p = sub.add_parser("show", help="節點完整內容(frontmatter+body;--body-only 略 frontmatter)")
    p.add_argument("note")  # 派發組共用 args.note(9656 組硬編碼取用;嚴禁命名 node)
    p.add_argument("--body-only", action="store_true", dest="body_only", help="只印 body(剝離開頭 frontmatter)")

    p = sub.add_parser("contracts", help="合約登記簿 ★INVARIANT★/★DEBT★(全 vault 或單節點)")
    p.add_argument("note", nargs="?")

    p = sub.add_parser("lint", help="單檔快檢:寫完一個節點立刻自驗標籤/格式(比 doctor 快,只看這篇)")
    p.add_argument("note")

    p = sub.add_parser("gov", help="唯讀治理事件帳:時間軸 / 某節點歷來被哪幾道閘攔過")
    p.add_argument("node", nargs="?")
    p.add_argument("--since", type=int, default=90, help="近 N 天(預設 90)")
    p.add_argument("--full", action="store_true", help="關去噪:advisory 逐筆完整列(預設同日同類折疊)")
    p.add_argument("--stats", action="store_true",
                   help="附加唯讀數字報表:每道閘的筆數/nodes/commit/起訖日 + 未出現的閘清單(恆 rc0,不做判定)")
    p.add_argument("--nags", type=int, default=0, metavar="天數", dest="gov_nags",
                   help="只列「同一道閘對同一篇連續提醒 ≥ 天數、而且最近一次體檢還在喊」的空轉清單(有就 rc1;自主迴圈週報用)")

    ac = sub.add_parser("about-code", help="語意「關於」欄位 about_code 的批次操作(計劃:固定席扇出降權)")
    acsub = ac.add_subparsers(dest="accmd", required=True)
    acr = acsub.add_parser("revert", help="整批撤銷某天的預標:stamp 第一段 == batch-<日期> 的節點,拿掉 about_code 與 stamp;人工修正過的(claude/…)不動")
    acr.add_argument("--batch", required=True, metavar="YYYY-MM-DD", help="批次日期")
    acr.add_argument("--dry-run", action="store_true", help="只列不撤")
    acs = acsub.add_parser("restamp", help="核過這篇 about_code 對現在正文仍正確 → stamp 三段全換 <by>/<今天>/<正文雜湊>;沒有批次模式")
    acs.add_argument("node", help="節點路徑(如 Systems/xxx)")
    acs.add_argument("--by", default="claude", help="第一段「誰核的」(預設 claude)")
    acm = acsub.add_parser("migrate-stamp", help="一次性:batch-* 兩段式 stamp 用「標註當時 commit」的正文補第三段雜湊")
    acm.add_argument("--at", required=True, metavar="COMMIT", help="標註當時的 commit(最終寫入 commit 的前一個)")
    acm.add_argument("--repo", dest="acm_repo", default=None, help="repo 根(預設從 vault 往上找)")
    acm.add_argument("--dry-run", action="store_true", help="只列不寫")
    cp = sub.add_parser("canary", help="審計員 canary 留痕(test-the-tester):某輪對抗審計有沒有抓到植入瑕疵")
    csub = cp.add_subparsers(dest="ccmd", required=True)
    cs2 = csub.add_parser("second", help="[oracle品質包 S2] 第二判者覆核留痕(抽樣分權,telemetry-only,不進 gate)")
    cs2.add_argument("--id", dest="sec_ref", required=True, metavar="CANARY-xxx", help="被覆核的原判 token")
    cs2.add_argument("--verdict", dest="sec_verdict", metavar="agree|overturn", help="覆核結論")
    cs2.add_argument("--auditor", dest="sec_auditor", help="第二判者(必填;建議跨家族)")
    cs2.add_argument("--note", dest="sec_note", help="一句理由")
    cr = csub.add_parser("record", help="記一筆 caught|missed|none(none=無植入輪的純處置帳載體,2026-08-14 協議停用後的常態)")
    cr.add_argument("kind", choices=("caught", "missed", "none"))
    cr.add_argument("--auditor", help="審計用的模型(如 sonnet)")
    cr.add_argument("--token", help="canary token(不給則自動鑄 CANARY-<隨機>)")
    cr.add_argument("--note", help="備註")
